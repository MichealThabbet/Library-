    </div></td>
    <td><div align="center">
      <h3><b>محب الرب القديــــــــر</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>كان رمزاً للعـــــــــــــفه</font></b></h3></td>
    <td><h3 align="center"><b> ماســــك الـدفـــــــه</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>و نقاوة من اللفـــــــــــة</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>خادم المســــــــــــــيح</font></b></h3></td>
    <td><h3 align="center"><b>أديب وشاعـر فصيح</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>دائم التسبيـــــــــــــــح</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>حبيب الملاييـــــــــــــن</font></b></h3></td>
    <td><h3 align="center"><b>معطى المساكيــن</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>معزى كل حزيـــــــــــــن</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b> ودايما بيحــــــــــــــــارب</font></b></h3></td>
    <td><h3 align="center"><b>أســـــــــد للتجارب</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بصلاته غالـــــــــــــــــب</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>يتأمل بكلامـــــــــــــــــه</font></b></h3></td>
    <td><h3 align="center"><b>مرشد فى زمانــــه</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>ما أجمل أيامـــــــــــــــه</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>كان أطـــــــــيب إنسـان</font></b></h3></td>
    <td><h3 align="center"><b>كان قلب حـــــــنان</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>كان حكمة سليمـــــان</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>صاحب أحلى إحساس</font></b></h3></td>
    <td><h3 align="center"><b>محب لـــكل الناس</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>أمانه حب وإخــــــــلاص</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>يعزى الحزيــــــــــــــــــن</font></b></h3></td>
    <td><h3 align="center"><b> يعظ كل حيــــــــــن</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>الراعى الأميـــــــــــــن</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>مريح التعابــــــــــــــــــى</font></b></h3></td>
    <td><h3 align="center"><b>أبو الغلابـــــــــــــــه</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>يمحى الكآبــــــــــــــــه</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>حكيم فى إرشـــــــــاده</font></b></h3></td>
    <td><h3 align="center"><b>عظيم فى جهاده </font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بيشفـــــــــــــع لأولاده</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>مليان بالســــــــــــــلام</font></b></h3></td>
    <td><h3 align="center"><b> شمعه فى الظلام</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>يكتب أشجى كــــــلام</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>قد أحببنا حياتــــــــــــك</font></b></h3></td>
    <td><h3 align="center"><b>أكملت جهـــــــادك</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>أذكرنا فى صلواتــــــــك</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>عــــــــــــاش حياه نقيه</font></b></h3></td>
    <td><h3 align="center"><b>رفض الخطـــــــــيه</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بالنعمه الإلهيـــــــــــــه</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>وللرهبنه إختــــــــــــــار</font></b></h3></td>
    <td><h3 align="center"><b>لم يحب الأنظــــار</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>وجد فيها الإستقــــرار</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>عند ربنــــــــــــــــــــــــــا</font></b></h3></td>
    <td><h3 align="center"><b>سافر بطركــــــــنا </font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>وراح السمــــــــــــــــــا</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>موجود وســــــــــــطينا</font></b></h3></td>
    <td><h3 align="center"><b>روحـــــــه حوالينا</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بيشفع لينــــــــــــــــــا</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>مع إلهـــــــــــــنا الجبار</font></b></h3></td>
    <td><h3 align="center"><b>نسى الإنكســــار</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بيرشـــــــــــد المحتار</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>كان قلبه مرفــــــــــــوع</font></b></h3></td>
    <td><h3 align="center"><b> فى وسط الجموع</font></b></h3></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><strong>بينيوت آفا شنوده</strong></h3></td>
    <td><div align="center">
      <h3><b>لربنا يســــــــــــــــــوع</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>كل القديسيين</h3>
    </div></td>
    <td><div align="center">
      <h3>تمجيد أسمك فى أفواه</h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center">البابا شنودة أعنا أجمعين</h3></td>
    <td><h3 align="center">الكل يقولون ياله </h3></td>
  </tr>
</table>
</body>
</html>
PK.�k9H)␀␀H)␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/k1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا صرابامون أبو طرحة</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><span style="font-weight: 700">أمام رب الأنوار بنيوت أفا صرابامون</span></h3></td>
    <td width="50%"><h3 align="center"><span style="font-weight: 700">مع كواكب الأبرار على أعلى منار</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">  ترنيمة الأبكار بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">قائم بكل وقار تنشد لرب الأطهار<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">ببركة ونعمه سكبته بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فقر فاديك عشته والزيت قد بعته<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> من سألك أعطيته بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ومصابحك أنارته بالزيت ملآته</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> حملت معه الصليب بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بالأسم والقلب السكيب قد شاركت الحبيب </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">للمحتاج تسرع وتجيب بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">عشت مثل الغريب خدمت كل غريب<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> جروك كى ما يحاكموك بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بالزنى والقتل اتهموك بالهزء والجلد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">ولقول الحق يقول بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">صرخت با يتول انطقى المقتول </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">تطلب مجدًا لا يزول بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">تركت الجمع مذهول للبرية أسرعت تجول<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">أحببت كل انسان بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بصلاتك طول الزمان فى جبل أب الرهبان<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> للمنوفية ابيسكوبس بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">دعاك أنبا بطرس لتخدم اسم ايسوس</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">بالصفح شابهت القدوس بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بالحب خدمت العروس بالصبر خلصت النفوس<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وغطاء بالجبة عظيم بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">خرجت للأرامل واليتيم فى ظلام الليل تهيم </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">فيعطيه الرب بدعواك بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">سألت من دعاك ايشى حال والدك<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> لعبودية ابليس انهيت بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بقوة ايمان صليت وزهرة هانم شفيت</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">فقط ان تبنى البيت بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">موهبة الله أعطيت وعن مال الوالى عفيت</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> بقوة الله خافوك بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">من السحرة حبوك فأرادوا أن يهلكوك</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">ليعيشوا حياتك بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لا تنسى فى أمجادك ان تنسى أولادك</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> أنبا ....... حبيبنا بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">واحفظ بطركنا راعينا وقدوتنا </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وسائر كهنتنا بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">واذكر اسقفنا أنبا ....... حبيبنا</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">بصلاتك ثبتنا بنيوت أفا صرابامون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">وايضا شمامستنا وسائر بيعتنا<span lang="en-us" xml:lang="en-us"> </span></span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> كل المؤمنين </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">تفسير اسمك فى افواه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> الأسقف العظيم الأنبا صرابامون أعنا أجمعين </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">الكل يقولون يا إله</span></h3></td>
  </tr>
</table>
</body>
</html>
PK��,�␀␀␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/k2.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد الأنبا صرابامون أسقف نيقوس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><span style="font-weight: 700"> فى الأسقف والشهيد الأنبا صرابامون</span></h3></td>
    <td width="50%"><h3 align="center"><span style="font-weight: 700">أنا أبدأ بالتمجيد وأوصف بكل شجون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">  
    وللشيطان قهر بقوة المصلوب</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">من سبط يهوذا ظفر الأسد غير المغلوب</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وأبوه اسمه إبراهيم من سلالة ملوكية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">بلدة هى أورشليم الأرض البهية </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">واشتاق بكل القلب للزمرة المسيحية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فى العتيقة تهذب منذ الطفولية  </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> من قبل رب القوات قال اسمع يا مبرور</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فظهر له من السموات ملاك متلالى بالنور</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وبأقوال نفيسة يعظك فتتقدس</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">امض غلى الكنيسة تجد الأنبا يوأنس</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> ليسوع المتعال وبنعمته أستنار</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فنهض إليه فى الحال وتعلم الأسرار</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">البكر أم يسوع ذات المعونة<br />
    </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">طلب العماد بدموع ظهرت له الحنونة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> ستنال مواهب عظام بالعماد تتجدد</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">وقالت له لك السلام يا ابن الموعد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">معمودية الكمال ويصير يسوع ربك<br />
    </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فى أسكندرية تنال ما تهفو إليه نفسك </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> بأسم أبنى ماسياس فادى البشرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">قم إلى ثأونا يعطيك المعمودية</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وتعمد وصار فى كمال سر النعمة المكنون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فمضى إليه فى الحال الأنبا صرابامون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وفى تواضع كبير صار حصن قوى ومجيد</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">تقدم فى تفسير كتب العهد الجديد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> فنهض رسمه اسقف لمدينة نيقية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">سمع الأنبا بطرس خاتم كل الشهداء</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> لأن الرب اختارك أسقف وشهيد مأمون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">طوباك ثم طوباك يا أنبا صرابامون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وسابيليوس القبيح قطعه بالكلية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">رعى قطيع المسيح بأحسن رعية </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> هدم برابى الأوثان واخزى الشيطان</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">دافع عن الأيمان بحرارة وقلب أمين </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">مرشدا للأيمان بيسوع بين سوتير</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ذاع صيته فى كل مكان كالكوكب المنير</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> كعادته مع الأبرار يحارب رجل الجهاد</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">قام إبليس الغدار واثار الأضطهاد </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> فذهب كأسد زائر ليواجه أريانوس </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فسعى فى طلبه الكافر الملك دقلديانوس</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وبأعتراف حاسم تمسك بالأيمان</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">رفض زينة العالم وطرح كل سلطان</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وهو فى يد الأعداء وجهه كملاك الله</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فتم الشهادة وكل الأساقفة معاه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وبمنظر نعمة فيك آمنت بسببه عباد</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">الرب كان يعافيه ويقيمه بغير فساد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">فنال للشهادة أكليل والمسيح نيح نفسه</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">وبعد جهاد طويل قطعوا بالسيف رأسه </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">يا أسطفانوس الجديد ابن مدينة صهيون</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">السلام لك يا شهيد يا أنبا صرابامون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">شبيه كوكب القدير المهدى المجوسية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">السلام لكوكب منير من أرض اليهودية </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> وتباهت به الأمصار ومدينة نيقية </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">السلام لمن انار الأراضى البحيرية </span></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700">  
        وبين الشهداء ظهر يفرح مع ايسوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">السلام لمن ظفر بنعيم الفردوس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td height="19"><div align="center">
      <h3><span style="font-weight: 700"> الكل يقولون يا إله الشهيد العظيم الأنبا صرابامون الأسقف أعنا أجمعين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">تفسير اسمك فى افواه كل المؤمنين</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�m���#␀␀�#␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/k3.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الأب الراهب أبونا صليب آفامينا</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> نمدح قديس أمين</span></h3></td>
    <td width="50%"><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بنعمة وحب 
	يقين </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا صليب</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اب بجوهر 
ثمين </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">جاء الطفل إميل</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بنذر صادق 
جليل </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">جاء الطفل إميل</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بنذر صادق 
جليل </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بنيوت آفا صليب</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">حياته 
كصموئيل</span></h3></td>
