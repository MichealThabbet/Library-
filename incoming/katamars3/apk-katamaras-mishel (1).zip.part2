  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>وفى الإيمان ثابتين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>خلَّصا من الشيطان</b></h3></td>
