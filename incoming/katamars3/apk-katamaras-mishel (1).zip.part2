<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-طوباك طوباكي يا مريم</h1></td>
  </tr>
  <tr>
    <td><h3 align="center" >يجمح الشهوة 
    والأراده</h3></td>
    <td><h3 align="center" >الصوم هو أصل 
    العباده</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >مريم نالت كل 
    سعاده</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">رأى الرسل مريم 
    بثبات</h3></td>
    <td><h3 align="center">بالصوم النقى 
    والصلوات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">وجسدها صاعدًا 
    للسموات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عن رؤيتك 
    وفهمنا</h3></td>
    <td><h3 align="center">تعالى ياتوما 
    واعلمنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">ولأى سبب نحن 
    صمنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من العذراء 
    مثال الوداعه</h3></td>
    <td><h3 align="center">جميع الأمم 
    ترجو شفاعه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">ويقدسون صومها 
    بالطاعه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتريد رجوع 
    الخاطئين</h3></td>
    <td><h3 align="center">حنونه وشفيعه 
    فى المؤمنين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">وتفرح بكمال 
    الصائمين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >اختارها من بين 
    البنات</h3></td>
    <td><h3 align="center">خالق الكل 
    ومنشئ السموات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >وشرفها بعمل 
    الآيات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">انها قالت بكل 
    كمال</h3></td>
    <td><h3 align="center">دلنا توما 
    البشير وقال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">فلتطوبنى كل 
    الأجيال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">حوَّل الماء 
    خمرًا جزيل</h3></td>
    <td><h3 align="center">ربنا فى عرس 
    قانا الجليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">مع انها طلبت 
    منه قليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مريم ولدت وهى 
    بتول</h3></td>
    <td><h3 align="center">زمانى قصير 
    وماذا أقول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">شئ لم تدركه 
    العقول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عن مدحها وآخر 
    تعبير</h3></td>
    <td><h3 align="center">سعيت ان اعرف 
    كثير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">فوجدت الكل 
    فيهم تقصير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وقريبه وهى فى 
    العلاء</h3></td>
    <td><h3 align="center">شفيعه ومسكنها 
    السماء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">وتسمع لكل 
    الدعاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتعلموا منها 
    العفاف</h3></td>
    <td><h3 align="center">صوموا صومها 
    بكل اعتكاف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">فهى نموذج لكل 
    الأشراف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فهى تخلصكم 
    بيديها</h3></td>
    <td><h3 align="center">ضعوا احمالكم 
    عليها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">وتوبوا وتعالوا 
    اليها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ملأها بالنور 
    والنعمه</h3></td>
    <td><h3 align="center">طويل الروح 
    وكثير الرحمه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center">وجعلها شفيعه 
    يوم الزحمه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وخلصت العالم 
    من الضيقات</h3></td>
    <td><h3 align="center">ظهرت عجائب 
    منها وايات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >وصعدت وجلست فى 
    السموات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >جلست العذراء 
    ام النور</h3></td>
    <td><h3 align="center" >عن يمين يسوع 
    ابنها الغيور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >كما قال داود 
    فى المزمور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >السلام لك ياأم 
    الوحيد</h3></td>
    <td><h3 align="center" >غنوا جميعًا 
    وقولوا بنشيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >نجينا من شر 
    العنيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وقولوا هى محت 
    المكتوب</h3></td>
    <td><h3 align="center" >فاخروا بها بين 
    الشعوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >بولادتها 
    الفادى المرهوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >واطلبوا عطفها 
    ورضاها</h3></td>
    <td><h3 align="center" >قولوا جميعًا 
    طوباها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >وصيحوا اليها 
    فى سماها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >تصوم لها بثقة 
    ونيه</h3></td>
    <td><h3 align="center" >كل الشعوب 
    المسيحية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >لتغفر لهم 
    الخطية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وفى كل ضيقاتنا 
    نناديها</h3></td>
    <td><h3 align="center" >لم نتعشم إلا 
    فيها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >وبين الامم 
    نهتف بها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >من صعدت مثلها 
    فى سماه</h3></td>
    <td><h3 align="center" >من حملت مثلها 
    الإله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >من سكنت مثلها 
    فى علاه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >ان مريم 
    كالمؤمنين</h3></td>
    <td><h3 align="center" >نحن ضد كل 
    القائلين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >او كواحدة من 
    القديسين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >واطهر من كل 
    الأنبياء</h3></td>
    <td><h3 align="center" >هى أعظم من كل 
    الشهداء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >لأنها صارت 
    عرشًا وسماء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >ونالت السعادة 
    والغبطات</h3></td>
    <td><h3 align="center" >والدة الإله 
    صارت بثبات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >واستحقت اعلا 
    الدرجات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >هذه الاقوال 
    ومدحك</h3></td>
    <td><h3 align="center" >لا تنسى من رتب 
    لك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك طوباك 
    يامريم</h3></td>
    <td><h3 align="center" >لإنه واثق بك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >غفران خطايانا 
    بشفاعتك</h3></td>
    <td><h3 align="center" >يا أم النور 
    نرجو منك</h3></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>طوباك طوباك 
        يامريم</h3>
    </div></td>
    <td width="50%"><h3 align="center" >عشية وباكر 
        نسألك    </h3></td>
  </tr>
</table>
</body>
</html>
