  </tr>
  <tr>
    <td><h3 align="center"> مريم ابنة يواقيم</h3></td>
    <td><h3 align="center">ونبذوها بصدود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وزينة كل كنيسة</h3></td>
