  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدان كيرياكوس و يوليطا أمه-اسمك جميل معناه رباني</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700"> كيرياكوس الجميل الطوباني</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700"> اسمك جميل معناه رباني</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا كيرياكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> طفل صغير روحاني</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يا مُنور مثل الشمعة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">  كيرياكوس يا جميل الطلعة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا كيرياكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفعتك يا شهيد قوية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لم يعرف الشهوات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">  عُمره ثلاث سنوات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا كيرياكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> هتفت له السموات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> قهر عمل الشيطان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">  رضع لبن الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا كيرياكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> اسمه على كل لسان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لن أترك مسيحي</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> نطق أنا مسيحي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا كيرياكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">صار له مثل روحي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يا شهيدة يا قديسة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">  شفاعتك يا أمنا يوليطة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا قديسة يوليطة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> صلاتك عنا يا عفيفة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> التي جاهدت بعزيمة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">  أمك يوليطة العظيمة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> شفاعتك يا قديسة يوليطة</span></h3>
    </div></td>
    <td><div align="center">
