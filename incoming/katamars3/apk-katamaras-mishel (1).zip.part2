  <tr>
    <td><div align="center">
      <h3>فى عشية ملائكية</h3>
    </div></td>
    <td><div align="center">
      <h3>جمعت عذارى نقية</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>ومحبة روحانية</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى الليل وطول النهار</h3>
    </div></td>
    <td><div align="center">
      <h3>فى صوم وصلاة ووقار</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>مثل النُّساك الأبرار</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>شابه ماكرينا العروس</h3>
    </div></td>
    <td><div align="center">
      <h3>أخوها القديس باسيليوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>نذر نفسه للقدوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>للمؤمنين كل الأجيال</h3>
    </div></td>
    <td><div align="center">
      <h3>كانت قدوة ومثال </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>كرَّمها الرب المتعال</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حضر غريغوريوس أخوها</h3>
    </div></td>
    <td><div align="center">
      <h3>عند قرب نياحتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>وتعزى بكلامها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومن الموت قرَبها</h3>
    </div></td>
    <td><div align="center">
      <h3>المرض أتعبها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>لكن العلويات نظْرتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ووجهها للشرق بأمر عجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>رشمت نفسها بالصليب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>نامت فى حضن الحبيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لم يجدوا أشياء تملكها</h3>
    </div></td>
    <td><div align="center">
      <h3>عند تكفينها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>سوى ردائها وطرحتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مع إخوتكِ الرؤوس</h3>
    </div></td>
    <td><div align="center">
      <h3>طوباكِ يا حبيبة إيسوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماكرينا القديسة</h3>
    </div></td>
    <td><div align="center">
      <h3>اُذكرينا أمام القدوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كل المؤمنين</h3>
    </div></td>
    <td><div align="center">
      <h3>تسبيح اسمَك فى أفواه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أعنَّا أجمعين</h3>
    </div></td>
    <td><div align="center">
      <h3>الكل يقولون يا إله </h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK����"␀␀�"␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r25.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد ماما</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ونمجد بإخلاص</span></h3></td>
    <td width="50%"><h3 align="center"> <span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  نسبح بإيمان</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الشهيد الصغير ماماس</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و نمدح هذا القديس</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الصوم مع الصلاة</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  كان ثمرة الجهاد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> على اسم يسوع الإله</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و دم الاستشهاد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و كلام الله طعامهم</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و الداه كانا قديسين</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الإيمان و المحبة في قلوبهم</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تركوا الأموال و الجاه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عذبوهم بلا رحمة</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قبض عليهم الأشرار</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الخيرات الفانية</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و وعدوهم بالأرضيات</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في وسط العذابات</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  إيمانهم كان ظاهر</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> رغم الاضطهادات</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و ثابتهم صار وأضح</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و توعدوهم بالعذابات</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رموهم في السجون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> شاكرين رب السموات</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هم في صلاة و سجود</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أن يموت على اسم إيسوس</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  طلب أبوه بحرارة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و يرعى ابنها بي إخريستوس</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و يُحافظ على آمراته</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> طلبت زوجته بحرارة</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  صَعدت روحه للسماء</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أن تكون بسرعة معاه</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و سألت بشوق و لجاجة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وضعت بآلام ودموع</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  جاءتها ساعة الولادة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و سلمت مولودها ليسوع</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و صرخت بمرارة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بسعادة و أفراح روحانية</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  صعدت روحها للسماء</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بدون لقب أو تسمية</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و تركت طفلها المولود</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تأخذ الطفل و تُربيه </span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  الملاك ظهر لقديسة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الكل به يناديه</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هو دايمًا يقول ماما</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فيه الحنان العجيب</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  اسمه ما أحلاه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الفداء و الحب المجيد</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و السهر و الاحتمال</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في إيمان طول الأيام</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  كبر هذا الغلام</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بيسوع مُحب الأنام</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و راح يكرز باحترام</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و ضربوه بكل قسوة</span></h3></td>
    <td><h3 align="center"><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قبض عليه الأشرار</span></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عذبوه بكل شدة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ليسكتوا هذا المُختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الله حفظه بأمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رموه في بحر عميق</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> للشجاعة و الإيمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ليكون مثالًا أكيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و يسوع المسيح يعزيه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و جد نفسه في الصحراء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بدون أن تؤذيه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الوحوش كانت معاه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فأخذ من لبنها بتمام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  جاءته الماعز و الأغنام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عمل منه طعام للأنام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فأكل وشكر الديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> لكل سكان البوادي</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  خرج يُبشر بالفادي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كلام الله الحلو الباقي</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أعطاهم من خبز الحياة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ليتمموا الأسرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قصد يبني كنيسة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و يأكلوا خبز الله بوقار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و يقيموا القداسات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هيج أعوانه الأشرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  هاج الشيطان اللعين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ماماس وسط الأبرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قبضوا على الشهيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هددوه بالوعيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  ضربوه بغير رحمة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أغروه بالمواعيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أظهروا له شفقة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هيجوا عليه الوحوش</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  ألقوه في النيران</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الرب عنه يحوش</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الأشرار بكل كسوف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و خزي كل الجلوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تعب الطغاة فيه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قتلوه على اسم القدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و كتبوا الحكم عليه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و فرح مع الأبكار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أخذا إكليل الشهادة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و صار مع الأطهار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في سن الخامسة عشرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا ماماس يا قديس يا قدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  السلام لك يا شهيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و إيمانك غلب إبليس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ثباتك فخر الشبان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الشجاعة و الوفاء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا مثال البتولية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الإخلاص للآباء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و المحبة المسيحية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أنت و والديك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أطلب من الرب عنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و نكون مُتشبهين بك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ليثبتنا في الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الشهيد ماماس أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
