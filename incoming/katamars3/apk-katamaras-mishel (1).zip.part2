    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3></td>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> وللأرض نابشين</span></b></font></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بكنز هذا الشهيد</span></b></font></font></font></h3></td>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  عاد الوريث الوحيد</span></b></font></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3></td>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> تونية من ليف النخيل</span></b></font></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> قضى عمره الطويل</span></b></font></font></font></h3></td>
    <td><h3 align="center"><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  فى نسك وصبر جميل</span></b></font></font></font></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> حتى مضى بالتهليل</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بلا حكمة بشرية</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  نفذتَ الوصية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> سكنتك الروحانية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> أُم وأب وأخوان</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  مَن يترك هذا الزمان</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> يفرح بيسوع فى كل آن</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> فى حبك العظيم</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  تشبهت بالشاروبيم</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> وقلبك الأمين</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> تسبح رب القوات</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  يا قائم بين الربوات</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> ترتل بالقيثارات</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> كشف سرك بمديح</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  هوذا يسوع المسيح</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> وذُكِرتَ فى التسابيح</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> قد ذابوا لما رأوك</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  حقًا قال مُحبوك</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> تركوا الكل وأتوك</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> ينزع الكسل عنا</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  اطلب من الرب عنا</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> لنعيش كمل يأمرنا</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك فى أفواه</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> الأنبا بولا أعنا أجمعين</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></b></font></font></font></h3>
    </div></td>
  </tr>
</table>
