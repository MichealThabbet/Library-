<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدة دولاجى و أبنائها الأربعة</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b>وامدح فى كل ايامى </b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b>اسبح الرب من 
        اعماقى</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>دولاجى و اولادها </b></h3></td>
    <td><div align="center">
      <h3><b> شهداء اسنا احبابى</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>ولم يخافوا الاضطهاد</b></h3></td>
    <td><div align="center">
      <h3><b>تقدموا الى 
        الجهاد</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> صاروا قدوة للاولاد</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> الام اربعة صبيانى </b></h3></td>
    <td><div align="center">
      <h3><b>قابلهم جيش 
        اريانى</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> صاحوا الكل انا نصرانى </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>بالتعذيب و قطع 
    الروؤس</b></h3></td>
    <td><div align="center">
      <h3><b>امر الوالى 
        اريانوس</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b>تقدم هرمان و سورس </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> الى السياف بكل حماس </b></h3></td>
    <td><div align="center">
      <h3><b>جاء ابانوفا و 
        شنطاس</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> امتلاوا بروح ايلياس</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>و معهم الام الطاهرة </b></h3></td>
    <td><div align="center">
      <h3><b>سالت دماء 
        الاربعة</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> صاروا قدوة و منارة </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> قدم ابنة اسحق بولاء</b></h3></td>
    <td><div align="center">
      <h3><b>ابراهيم اب 
        الاباء</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> و دولاجى قدمت اربعة ابناء</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> يا مثال المحبة و الطهارة  </b></h3></td>
    <td><div align="center">
      <h3><b>طوباك يا شجاعة </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> بنوا باسمك كنيسة و منارة</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> فى كل جيل نمدحها </b></h3></td>
    <td><div align="center">
      <h3><b>فى ستة بشنس 
        عيدها</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> نحن جميعا نطوبها</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>فى كل بيعة نذكرها </b></h3></td>
    <td><div align="center">
      <h3><b>المسيح الهنا 
        يكرمها</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> فى اسنا نمجدها </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> فى الفردوس اذكرينا</b></h3></td>
    <td><div align="center">
      <h3><b>يا قديسة لا 
        تنسينا </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">دولاجى و اولادها </h3></td>
    <td><div align="center">
      <h3><b> عند المسيح اشفعى فينا</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> كل المؤمنين</b></h3></td>
    <td><div align="center">
      <h3><b>تسبيح اسمك فى 
        افواة </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> الام دولاجى و 
    اولادها اعنا اجمعين</b></h3></td>
    <td><div align="center">
      <h3><b> الكل يقولون يا الة</b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKC>��␀␀�␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/f9.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td width="100%" colspan="2"><h1 align="center">القديسان مكسيموس و دوماديوس الروميان</h1></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>أبدأ باسم الله 
        القدوس سيدنا ايسوس بى اخرستوس <br />
        وأمدح فى شرف معنى مكسيموس ودوماديوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>أوجه مد يحى وكلا مى لمريم تى با رثينوس <br />
        وا ياها أقرىء سلا مى اتشيرى انذ يكئوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>أسا لك ان تقوينى وأرجوك باسم ايسوس <br />
        فى مدح الأ خوين ساعد ينى مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>فقد هجرا الرومانية وملك لاوند وس <br />
        وسكنا فى البرية مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>بدأ ا بخلع التاجات والقائهما عن ا لرؤوس <br />
        محبة فى ملك السموات مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وشرفهما قد ازدا ن حين د خلا الفردوس <br />
        وعلى رأسيهما تاجان مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>احبا سكنى الجبال و تانسا بالوحوش <br />
        وزهد الممالك والمال مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>تركا مجد العالم وقهرا ابلس المنجوس <br />
        ونالا الفرح الدائم مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>د لهما قبل الممات أميرهما أنبا أغابيوس <br />
        أن يمضيا لجبل شيهات أسقيط مكاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>ذو القيثارة داود شرح فى ابصالموس <br />
        أولا د الملوك قصدوك يا أنبا مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>منظرهما فى البرية يشبه نى أنجيلوس <br />
        وصارا اهلا للبطريركية مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>زانا صفوف الرهبان رتب فى أسوماتوس <br />
        وساحا فى أقصى الود يان مكسيموس ودوماديوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>سارا بغير سابق د ليل ود لهما نى انجيلوس <br />
        الى سواء السبيل مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>شفيا كل العلا ت باسم الرب القدوس <br />
        فى الشام وجبل شيهات مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>ترنما بتراتيل وأحان حبا فى الرب القدوس <br />
        وصارا من الشجعان مكسيموس ودوماديوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>ضاءت الأ كاليل بلمعان حين وضعت على الرؤوس <br />
        والقفر قد صار فرحان مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>طوباكم فى السموات يا أولا د مقاريوس <br />
        يا كواكب جبل شيهيت ومصابيح دير البرموس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>طوباك ايها البار طوباك يا مقاريوس <br />
        أنت لشيهات فخار مع الآباء الرؤوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>ضاع منى الصبا وا لشباب وأنا فى هموم وبؤوس <br />
        حرسنى ربى شر العذاب بصلا ة تى بارثينوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>عال هو قدرك يا مريم يا رجاء النفوس <br />
        لا تنسينى انا عبد ك وأبعدى عنا العكوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>غلبا روح الشياطين باسم الرب القدوس <br />
        وصارا فى حصن حصين مكسموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>فخر لكل الرهبان ابؤورو لا وند يوس <br />
        ابنا الملك السلطان مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>قال عنهما أبو الرهبان أنبا مقاريوس <br />
        ثوب الرهبن بهما ازدان مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>كتب اسماهما مع الآباء الرؤوس <br />
        فنال النعمة كلا هما مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>لبسا حللا بهية حن دخلا الفردوس <br />
        وأكاليلا نورانية مكسموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>مضيا عريسا ا لمسيح ودخلا جنات الفردوس <br />
        وساحا حقا بالتسابيح مع طغمات نى أنجيلوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>نالا جزيل الا نعام باسم الرب القدوس <br />
        وصارا فى أمن وسلا م مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>هدية مذ خرة عند ربنا القدوس <br />
        وذخيرة مفتخرة مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>لا تنس بطريركنا عند الرب القدوس <br />
        وشريكه اسقفنا أنبا ......ز بى آبيسكوبوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>لا تنس يا سيدنا صفوف نى مونا خوس <br />
        وكل مراتب شعبنا بى أواى بى أواى ان نى اخرستيانوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى للثلا ثة المقارات وكل الآباء والرؤوس <br />
        ا لسكان بجبل شيهت أسقيط مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى لأ نبا يؤانس بى هيغومينوس <br />
        والأب أنبا بيشوى بى رومى انتى ليوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى للأ نبا دانيال والأ نبا ايسيذ وروس <br />
        والمكرم بكل الا كرام الأ نبا أرسانيوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلامى لأنبا بولا والأنبا أنطونيوس <br />
        ومن له فى الشركة اليد الطولى الأنبا باخوميوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى لأ نبا ابرأم وأنبا جاورجيوس <br />
        وللذ ين نالا الأ نعام من فم الله القدوس </b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>ورشمهما حقا بالصلبان بعلا مة بى استافروس <br />
        وصارا خاد مين للديان فى أسقيط مقاريوس<br />
      </b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى للأ نبا مويسيس والأنبا زخاريوس <br />
        وأبينا أنبا يؤانس كاما بى ابريسفتيروس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>يا وادى هبيب شبهوك منذ القد م بالفردوس <br />
        أولا د الملوك سكنوك مكسيموس ودوماد يوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>يا جبلا عظيم الشأن متشبها بالفردوس <br />
        مسكن الأباء الرهبان أسقيط مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>أنت كالبحر الزاخر الغاسل صدأ النفوس <br />
        يا صاحب الأ سم الفاخر أسقيط مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>موضع الصلوات والطلبات لكل الآ باء الرؤوس <br />
        السكان بجبل شيهات أسقيط مكاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>كنت مكمنا للأ شرار وماوى للصوص <br />
        صيرك أبو مقار متشبها بالفردوس </b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>يا شبكة روحانة جمعت من كل الجنوس <br />
        أصلحت بها النفوس الرد ية وصيرتهم آباء ورؤوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>طوباكم يا طغمة الرهبان يا من تطوعتم للقدوس <br />
        وهجرتم ذويكم والأوطان وأضيتم الجسم لراحة النفوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وقد صرتم روحانيين بطاركة وأساقفة وقسوس <br />
        وأصبحتم للتيجان لا بسين يا أولا د البار مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>والتاجات النورانية تتلأ لأ فوق الرؤوس<br />
        والأكاليل الروحانية نالها أولا د مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>طوباك يا أبو مقار طوباك يا مقاريوس <br />
        يا كواكب جبل شيهات ومصابيح أديرة بى بخرستوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>قابل الأ شرار وغاسل صدأ النفوس <br />
        لكل من سكن أو زار أسقيط مقاريوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>طوبكم أيها الأبرار يا زمرة نى مونا خوس <br />
        شاع ذ كراكم فى الأ قطار يا قادة ان نى اخرستيانوس</b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b>وسلا مى الى مريم الشفيعة فى كل الجنوس <br />
        صاحبة الأ سم الأعظم ومفتاح باب الفردوس</b></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�U��6␀␀�6␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/g1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الملاك رافائيل رئيس الملائكة</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>      <font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">    يا رئيس جند السموات</span></font></h3>
</div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">السلام لك يا 
        رفائيل  </span></font></h3>
</div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  دائما فى كل الاوقات</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">القائم امام 
        عمانوئيل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  مفرح قلوب الودعاء</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">مملوء رحمة 
        وعزاء </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  محبوب من الشهداء</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ثالث رتب 
        السماء </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تفسيره شفاء الله</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اسمك 
        رافائيل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تشفع فينا للنجاة</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">القائم فى كل 
        جيل  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">فى طوبيت ذلك الزمان</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا من سالت 
        الله </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تعطيه شفاء و امان</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ارسلك الرب 
        اليه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">فانار عينى طوبيت</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">طلبت من الله 
        الشفيق</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وحل السلام فى البيت</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وعرفت لابنه 
        الطريق</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وبنته المبروكة سارة</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ذهبت ايضا 
        لراعوئيل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">لانها امينة طاهرة</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">شفيتها بفرح و 
        تهليل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وزوجتها لطوبيا بتدبير</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">طردت عنها 
        الشياطين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وعرفتهم الحقيقة و التفسير</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">واعطيتهم اولاد 
        كاملين  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">من آدم اللى اليوم</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">دائما فى كل جيل 
      </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  حصنا لنا على العموم</span></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تجد الملاك 
        رفائيل  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align: center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  مع ديونيسيوس وسؤدوسيوس</span></font></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align: center"><font color="#000000"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">صنعت 
        عجائبا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> واركاديوس وهونوريوس</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">و الانبا 
        تاوفيليس البابا </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  صاحب الاسم الامين</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">السلام لك يا 
        رفائيل </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> يا معونة لكل حزين </span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا شفا لكل 
        عليل   </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> يا ناصر الصديقين</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا مفرح القلوب 
        الامين  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> يا حنون على الخاطئين</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا مرشد 
        القديسين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بطهارة وخوف الله</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">فلنعيد عيدا 
        جليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> فرح وشفاء الله</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">رئيس الملائكة 
        رافائيل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> حين ظهر للرسل الاطهار</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">فى ثالث يوم 
        النسئ </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  كطلب فيلوبوس البار</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بامر يسوع الهنا 
        الحى </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  يم تكريس اول بيعة</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وايضا فى 
        13كيهك </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وظهور عجائب باهرة</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">فى 
        القسطنتينية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">و البائسين و الفقراء</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اعطوا كل 
        المساكين  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تفوزوا برحمة السماء</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">و ساعدوا 
        المحتاجين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">عن كنيستنا ام الشهداء</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اطلب من اله 
        السماء </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يحفظ فيها ايمان الاباء</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ينجيها 
        من مكايد الاعداء  </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">   كل المؤمنين</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تفسير اسمك فى 
        افواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> الملاك رافائيل اعنا اجمعين</span></h3></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">الكل يقولون يا 
        اله </span></h3>
    </div></td>
  </tr>
</table>
<span style="font-size: 18pt; font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا مرشد 
    القديسين</span>
</body>
</html>
PK�y(��3␀␀�3␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/g2.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدة رفقة و أولادها الخمسة</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">فى بلادنا المصرية</span></font></h3>    </td>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سنباط غنية   </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والشهداء اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">برفقة التقية </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ربت بجدارة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ام الشهداء مختارة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">عاشت بطهارة  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  واصولها شريفة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يمامة منفية </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  والخمسة اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة العفيفة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ربت اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة شبت بالتقوى</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> بكاملها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">واحبت الشريعة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> للصليب حملت</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">للعالم بغضت </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والخمسة اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بالفضائل كملت</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  بطرس الفاضل</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">اغاثوا الكامل </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بالشريعه وكمالها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يوحنا العامل</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> نور امونة الباهر</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">امون الطاهر </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">عائلة ما اشرفها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">خمسة اكابر </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> بحواس متفقة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">خمسة بالشفقة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بحسن تعاليمها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">جمعتهم رفقة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> حتى الشبوبية</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">منذ الطفولة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> علمت اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة النقية </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وزعوا اموالهم</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">فى قوس بلدهم </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  رفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">على اسم الههم  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  صار زعلان</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">راهم الوالى</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> رفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">صرخ تعالى  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رجعى اولادك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ما اقسى فؤادك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  خيرات ما اكثرها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">انا ازيدك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">نحن اكابر</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">قالت اصمت يا كافر  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">عطاياك نرفضها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">والهنا قادر </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> اغصان بالحكمة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">نحن بنوا النعمة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ما احد ينزعنا</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ثابتين فى الكرمة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">فى الرب الهنا</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ثابت ايماننا </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> اصنامك نرفضها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">مهما عذبنا</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> باصلنا الامجد</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">اهل قوص تشهد  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> رفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لن تتعبد للاصنام  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وايضا اهانوهم</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كم عذبوهم  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> ما اشنعها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">واذاقوهم ميتات  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">قبلوا فى مرة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كذا فى شبرا </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة مع اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">عذابات مرة  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> كفرة ما اكثرهم</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">امن بسببهم </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة ما اشجعها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لا يحصى عددهم  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ابو قير وديبة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">دير مارمينا </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> شرفت اصقاعها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة العجيبة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بمحافظة الغربية</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سنباط المسمسة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> لرفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">البيعة النورانية </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">عظيمة مقيمة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">اجسادهم هناك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> برفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">14 بالقيمة  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تنبع بالقدرة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">هناك الصخرة  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بركة لزوارها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">مياه عذبة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  السابع بثبوت</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">فى توت اليوم  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> رفقة واولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">قد زفت للملكوت </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> الجوهرة المكنونة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تعالوا للمصونة </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والشهداء اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رفقة الحنونة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  تدر ارزاقكم</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تشفى امراضكم </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والشهداء اولادها</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">برفقة البهية</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كل المؤمنين</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تفسير اسماءكم فى افواه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> القديسة رفقة اعنا اجمعين</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الكل يقولون يا اله </span></font></h3>    </td>
  </tr>
</table>
</body>
</html>
PK�s<�A␀␀A␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/g3.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td width="100%" colspan="2"><h1 align="center">القديس الأنبا رويس-كان عايش فى غربه</h1></td>
  </tr>
  <tr>
    <td><div align="center">
      <div align="center">
        <h3><font style="font-weight: 700">  كان عايش في غربة ماسكا صليب ربه</font></h3>
      </div>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> ايضا شابه يسوع في أين يسند رأسه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  كان زاهد في أكله محتقرا ملبسه</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> غير خائف من شتاء لا صيف و لا حرارة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  الملائكة فوق اخذه الي بيعة سلامية</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و تناول من يد يسوع الأسرار المحيية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  سموه ثيئوفاينوس معناه ناظر الأله</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> حين ظهر الله له و ده لقب الكنيسة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  انكر شخصه للناس و منهم كان مصون</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> سمي نفسه تيجي افليو يعني الكاذب المجنون</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  تيجي لها معني حافظ وصايا الرب</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> بالحقيقة كان مطيعا ليسوع الذي أحب</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  علشان هربت من الناس و فرح بالشتيمة</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> أصبح قديس مشهور بين أباء الكنيسة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  السلام لك يا أبانا يا قديس شجاع و أمين</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> ملكوت السموات لك و الذين بالروح سالكين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  رفضت حياه الناس تاركا أسهل طريقا</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و أخذت طريق ضيق و الجمل لك رفيق</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  لم تطلب العالم و لا كنت من العالم</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> بل شابهت المسيح في إحتمالك للآلآم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  غحتملت عذاب كثير و صمت لشاتميك</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و صبرت لراجميك و باركت لاعنيك</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  ضربوك ثم طردوك بل طرحوا عليك النار</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> حولت لهم خدك حين لطمك الأشرار</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  رحلت من بلدك و جئت الى القاهرة</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> لتعلن إيمانك و عقيدتك الباهرة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  فضلت الطهارة بدلا من الخطية</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و لبثت ثوب العفة و كمان البتولية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  في حياتك كنت أمين تشبهت بالرهبان</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> في أماكن مهجورة تكللت بالأحزان</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  حزين علي خطاياك و انت من الأنقياء</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و احمرت عيناك من كثرة البكاء</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  وديع و متواضع في بشارتك بالأيمان</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و جندي المسيح ثابت في حربك مع الشيطان</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  أطعت الرب يسوع و أوضحت بلا لوم</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> هذا الجنس لا يخلاج إلا بالصلاه و الصوم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  مع ربك إختليت في حياة كلها صلاة</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و سهرت بعيدا عن الناس في ليالي متصلة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  تطهرت بالاصوام مع نسكيان و جوع</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> لكنك كنت شغوفا بطعام الرب يسوع</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  صليت للمأسورين منهم البطريرك</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> خلصته من أسره بصلاتك و شفاعتك</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  رآك البطريرك الانبا مقاؤس</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> تعجب من أعمالك الغريبة عن النفوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  معنا دائما كائن في جسدك نتبارك</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> في كنيستك نذكرك و في بابة نعيد لك</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  اطلب من أجلنا امام الرب القدوس</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> و أذكرنا دائما يا قديس ثيتوفانيوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700">  تفسير اسمك في أفواه كل المؤمنين</font></h3>
    </div>      <div align="center">
        <h3><font style="font-weight: 700"> الكل يقولون يا اله افا تيجي اعنا اجمعين</font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK!��A#␀␀A#␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/g4.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الانبا رويس-أفتح فاي بإسم الله</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> واحد لا رب سواه</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">افتح فاي باسم الله </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وامدح قديس اصطفاه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> امدح هذا الانسان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بدء كلامي يا اخوان </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ذكره علي كل لسان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بالغربية بيقين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مولود في منية يمين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">هذا الرجل الامين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> وامه سارة يا رفاق</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ابوه هو اسحق   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مؤمنين بالرب الخلاق </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فريج ودعياه</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لما ولد اسمياه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وهو ناظر الاله </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> في الفلاحة مع والده</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وكان يعمل من صغره  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> القديس انبا رويس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ويبيع الملح علي جمله</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> يحرك الرأس كثير</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">جمله قاعود صغير </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  القديس انبا رويس</span></font></h3>
