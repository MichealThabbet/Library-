      <h3>مرفوعة كل الاوقات</h3>
    </div></td>
    <td><div align="center">
      <h3>حياتك صلوات</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>كبخور للسموات</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يرفع لنا قداسات</h3>
    </div></td>
    <td><div align="center">
      <h3>فى الفرح او الضيقات</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>مع صوم ومطانيات</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا محب لاولادك</h3>
    </div></td>
    <td><div align="center">
      <h3>يا امين فى خدماتك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>بل ايضا اعدائك </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لشكوى الكل سميع</h3>
    </div></td>
    <td><div align="center">
      <h3>قلب يسع الجميع</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>الان لنا شفيع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على البائس والحيران</h3>
    </div></td>
    <td><div align="center">
      <h3>اب يفيض حنان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>يريح كل انسان </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا عظيم فى ايمانك</h3>
    </div></td>
    <td><div align="center">
      <h3>يا عجيب فى اتضاعك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>وقوة ثباتك </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وثقة وعزاء</h3>
    </div></td>
    <td><div align="center">
      <h3>نفس تفيض رجاء</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>تقوى الضعفاء</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حكيم فى اقوالك</h3>
    </div></td>
    <td><div align="center">
      <h3>يا دقيق فى اعمالك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>من الله ارشادك </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والفرح والبشاشة</h3>
    </div></td>
    <td><div align="center">
      <h3>تحليت بالوداعة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>والزهد والبساطة </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والحب الى التمام</h3>
    </div></td>
    <td><div align="center">
      <h3>قلب ملىء بالسلام </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>يعطيه على الدوام </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى حياة الاتكال</h3>
    </div></td>
    <td><div align="center">
      <h3>ياقدوة ومثال </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>والصمت والاحتمال</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>رحيم بالفقراء</h3>
    </div></td>
    <td><div align="center">
      <h3>يا كريم فى العطاء </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بينوت افا ميخائيل</h3></td>
    <td><div align="center">
      <h3>مضيف للغرباء </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
