<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدة دميانة-بدر ساطع بأنوار بهية</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"> <div align="center">
      <h3>كوكب شارق في الصحبة </h3>
    </div></td>
    <td width="50%"> <div align="center">
      <h3>بدر ساطع بأنوار بهية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>عفيفة كاملة البتولية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا عروسة حرة في الأحرار </h3></td>
    <td> <div align="center">
      <h3>أنشيء فيك مديحًا مختار </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>يا كاملة وزايدة في المقدار </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ظهر فضلها في دير الميما </h3></td>
    <td> <div align="center">
      <h3>بتوليتك يا حكيمة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>نلت الصيغة المستقيمة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وتفتخر الأشجار والأغصان</h3></td>
    <td> <div align="center">
      <h3>تتهلل بقعة السيسبان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> بقدوم العفيفة دميانة</h3></td>
    <td> <div align="center">
      <h3>ويبتهج وادي الزعفران</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أخرجت عروسة ذات حرية </h3></td>
    <td> <div align="center">
      <h3>ثم أن قفار البرية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>طاهرة من العيب ونقية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> على الأفكار والقلب الحزين</h3></td>
    <td> <div align="center">
      <h3>جمال وجهها مبهج بيقين</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>ذكرها هو يشبه كنز ثمين </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وبلغت خمسة عشر عام</h3></td>
    <td> <div align="center">
      <h3>حين كملت لها من الأعوام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> زواح العفيفة دميانة</h3></td>
    <td> <div align="center">
      <h3>أراد أبوها بعزم تام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أن صليت صلاة للمتعال</h3></td>
    <td> <div align="center">
      <h3>خاطبنا الإله من فمه وقال</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فذلك أفضل من الإعلان</h3></td>
    <td> <div align="center">
      <h3>أغلق بابك بأغلاق وأقفال </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لكل من صلي وبابه مردود</h3></td>
    <td> <div align="center">
      <h3>خطاب الحي ليس هو المقصود </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أفكار أبليس الذي أغوانا </h3></td>
    <td> <div align="center">
      <h3>بل يغلق عقله من كل عنود</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ولا أشتهي زوج ولا أهواه </h3></td>
    <td> <div align="center">
      <h3>دائمًاَ أنا تابعة وصاياه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لأكون محفوظة ومصانة </h3></td>
    <td> <div align="center">
      <h3>ولكن أكون خادمة للإله </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ولا أتبع طرق الأنجاس</h3></td>
    <td> <div align="center">
      <h3>ذاتي أنذرتها لماسيسا </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> بل اسمي العفيفة دميانة</h3></td>
    <td> <div align="center">
      <h3>ولا أفسد عفة الأحداث </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> تصنع لي ما قلبي يهواه </h3></td>
    <td> <div align="center">
      <h3>رغبتي فيك يا أباه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأكون في صلاتي سهرانة </h3></td>
    <td> <div align="center">
      <h3>قصرًا عالي واسكن جواه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> في مدة عمري وسنيني </h3></td>
    <td> <div align="center">
      <h3>ربي وإلهي هو يحميني </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وبقوته أنا منصانة </h3></td>
    <td> <div align="center">
      <h3>باسمه يكون إيماني ويقيني </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وتهلل وجهة وأشرق بالنور </h3></td>
    <td> <div align="center">
      <h3>زاد والدها بهجة وسرور </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> من فرحته بأقوال دميانه </h3></td>
    <td> <div align="center">
      <h3>وأغرورقت عيني ذلك المبرور </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أهيئ لك قصرًا يا نسل بري </h3></td>
    <td> <div align="center">
      <h3>سرة قولها وقال ابشري</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أيتها القديسة دميانة </h3></td>
    <td> <div align="center">
      <h3>يا شجرة بالصلاح تثمري</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> هلم وأسرع لما أهواه</h3></td>
    <td> <div align="center">
      <h3>شرفك هنائي يا أبتاه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ليكمل مسألة دميانة</h3></td>
    <td> <div align="center">
      <h3>فقام أبوها وشدد مطاياه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أصحاب مشورات مرتفعة</h3></td>
    <td> <div align="center">
      <h3>صناع بارعين في الصنعة </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ليتمموا رغبة دميانة</h3></td>
    <td> <div align="center">
      <h3>دعاهم مرقس بسرعة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> شيدوا قصرًا عالي الشراع </h3></td>
