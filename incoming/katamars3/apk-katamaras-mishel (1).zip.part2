  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">الشهيد أبانوب النهيسى</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> كامل طاهر حكيم <br />
    </h3></td>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> 
	+ السلام لقديس عظيم<br />
