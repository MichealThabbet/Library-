<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-يا م ر ي م</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">يا ست الأبكار </span></b></h3></td>
    <td width="50%"><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا م ر ي م </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> من نور الأنوار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> قد نلت تعظيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> من عنده قد صار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> ووهبت تعظيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> من ذا لا يحتار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وحملت الخالق</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> للرؤساء أمثال </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  قد صرت أعجوبة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وفي الإنجيل قد قال </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> درة محبوبة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> في كل الأجيال </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يعطونك &quot;الطوبة&quot; </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> قد فقت الشاروبيم </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أبنة يواقيم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أم الرحمة </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  من نال ما نلت </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> مملوءة نعمة </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وأنت قد صرت </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> حجابًا للكلمة </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وللاهوت صرت </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> أرباب التفهيم </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وإحتار فيك </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا مجمرة هارون </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  يا تابوت العهد </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا إبنة صهيون </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا روح المجد </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بك نسعد </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا نور العيون </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا مملوءة نعمة </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> ونحظى بالنعيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> أنت الحصن الحصين </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  يا مملوءة نعمة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا عون المساكين </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> أنت كنز الرحمة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا شفيعة القديسين </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بإبنك زالت النقمة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أم الرحيم </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> شفيعتنا في الزحمة </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا ست الأبكار</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  نقدم لك التعظيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا كرسيًا مختار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أبنة يواقيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> أزال عنا العار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> والمولود منك كريم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> خالق الأدهار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> الإله العظيم </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا قدس الأحبار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  يا زين الأبكار </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا نور الأنوار </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا طهر الأطهار </span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أم الرحمة </span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا كنز النعمة </span></b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> المملوءة أثمار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنت هي الكرمة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قد نلت تعظيم </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يا إبنة يواقيم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ذات المجد والفخار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنت هي أورشليم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا جوهرًا مكنون </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنت هي صهيون </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من يد المكار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فككت المسجون </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الخاطي النادم </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  إبنك خلص آدم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من كل الأضرار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وعتق العالم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لما رأى طهرك </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ربك من صغرك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في كل الأقطار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قد طيب ذكرك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بمحكم الأقوال </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أرسل  لك غبريال </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الله لك إختار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وبشرك إذ قال </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وسكن في أحشائك </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> روح قدسه ملاكي </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في كل الأعصار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا عدرا طوباك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الرب القدوس </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  إن غير المحسوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ونظرته الأبصار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> منك أتى ودعي إيسوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والنار فيه تتأجج </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> موسى رأى العوسج </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ما ضرته النار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأغصانه تتوهج</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ملتهبًا بالنيران </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أن ما رأته العينان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> هي مريم زينة الأبكار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في العوسج والأغصان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الرب القدوس </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والنار هي إيسوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مكتوبًا في الأحجار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> معطينا الناموس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عن هذا التأويل </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  ف أشعياء قد قيل </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الملك الجبار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تلد عمانوئيل </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> دخل فيه رب الأرباب </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> حزقيال رأى باب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عالي المقدار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وختم الباب مهاب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لأن يسوع إبنك </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  عال هو قدرك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تزينت الأمصار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لما ولد منك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تنبأ حيث قال </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أيضًا دانيال </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عالي المقدار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> رأيت الكرسي العال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> شبه إبن الإنسان </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  نظرت فوق الأركان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> على كل الأقطار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وله سلطان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ومن حوله طغمات </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وهو رب القوات </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من عظم ووقار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الوف وربوات </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فقت الكاربيم </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يا إبنة يواقيم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وكل الأباء الأبرار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أيضا السيرافيم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الرب المعبود </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> منك جاء المولود </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بالعشرة أوتار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يمدح فيك داود </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قول ممجد </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  الوتر الأول </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بالملك الجبار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والعدرا تحبل </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> داود بالأغاني </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الوتر الثاني </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مع ضرب القيثار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يرتل بالألحان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنت مؤتمنة </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  التالت ياأبنة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والرب لك إختار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بالنور مشتملة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إصغ يا سامع </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الوتر الرابع </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في كل الاقطار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ذا قولًا شائع </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> حمامة هي تظهر </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  الخامس خبَّر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> على منكبيها صار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بالذهب الأصفر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قولًا ما أخفي </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والسادس أبدي </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأشهره إجهار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لكني أروي </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا جبل الله العال</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  والسابع إذ قال </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بلا شك ولا إنكار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تجسد منك المتعال </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> العدرا مريم </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والتامن رنان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كللها بالفخار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إختارها المعظم </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يظهر حقًا منها </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  والتاسع قال عنها </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والبكورية في حفظ ووقار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الإله وهو إبنها </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الله القادر </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الوتر العاشر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مسكن الأبرار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في صهيون ظاهر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مثلك أيتها البكر</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  لم يوجد في الدهر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عن آدم والعار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لأنك فككت الأسر </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا فخر الإيمان </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا سيدة الأكوان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> غارق في الأوزار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنا عبدك حيران </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لا تتركي عبدك </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  عال هو قدرك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عتقًا من النار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قصدي من إبنك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وللدعا يسمع </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> لأنك خير من يشفع </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ضربات المكار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وعنا يدفع </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والبس ثوب اليقين </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قم إنهض يا مسكين </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فهي تشفع في الحضار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وقول آمين آمين </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مادحها في كل حين </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والناظم المسكين </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> سوى سيدة الأطهار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماله يوم الدين </span></b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK8��mm␀␀mm␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r34.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-يا يمامة جليلة تصيح</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">يا يمامة جليلة تصيح</span></font></font></h3></td>
    <td width="50%"><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام لك يا مريم </span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صوتها مبهج وفريح</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لنا بسر معظم</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عنقودها قد أثمر </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا كرمة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفهم عالي معظم </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رأس ينبوع الحكمة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قبل كون العالمين </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام للأناء المستور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في حضن الأب كل حين</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> المحتوى نور من نور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حامل كل الأسرار</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا كنز خفي</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لسائر الآباء الأبرار</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبك الموعد وفي</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أب الآباء إبراهيم</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا مظلة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أحتار فيها كل فهيم</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حكمة خفية وظاهرة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مروى الزرع المثمر</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لينبوع اسحق</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أشرق في عالم مقفر</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لفجر مشرق</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأصل كل البركات</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لتهليل يعقوب</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبها زالت اللعنات</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وراحة للشعوب</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفي وسطه الجوهر</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لحقل مشهور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويفوق كنوزًا أبهر</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وجده يوسف مبرور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في وسطه خالق لا يري</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا حقلا نقيًا مبرور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> له العظمة والقدرة </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صير المشجوب مبرور</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والنجمة البدرية</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لسفينة نوح</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نوره لكل البرية</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> اشراقك فجر يلوح</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من ذاته بغير تفليح</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا حقلا غير مفلح</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> روحا قدوسا وصريح</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سقاه صار مفلح</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصانعها هو جنينها</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام للمصنوعة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وولد كصبي منها </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهي بيده مبدوعة</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> متعال عجيب ورهيب</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوباك يا من سرك</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بل وعقل كل نجيب </span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> احتار عقلي في أمرك</span></font></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يضئ على أهل الظلمة</span></font></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ما أبهج نورك في ضياه</span></font></font></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صيره من أهل النقمة</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عبدك أبليس أغواه</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فات العمر ولا أدراه</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيا ويلي واأسفاه</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأنا خالي من الأجرة </span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> استأجر الكرام أجراه </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولم اظفر بخلاص</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عبر الشتاء والصيف</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وانا مربوط بقصاص</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قرب الحصاد والهيف</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أم وعرش وعذراء</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا رجاء من خاب رجاه</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا يحسبني من اليسري</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عفو ابنك اترجاه</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فخابت منى التجرة</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تأخرت في المتجر</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> راجي قبض الأجرة</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جئت في الحادي عشر </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وجرحي بك يبرأ </span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طمعان فيك يوم الحشر</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفي الساعة المرة</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقت خروجي حضر</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في حسبك يا عذرا</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جيريني وأنا في الأسر</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأوفيني أجرة بكرة</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> البسيني أكليل الظفر</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أجمع يكونوا بسلام</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مع كافة المسيحيين</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا شفيعة في الآنام</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولشفاعتك طالبين</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> <span style="mso-spacerun:yes"> </span>كل المؤمنين </span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك في أفواه </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مريم أعنا أجمعين</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><font style="font-weight: 700" color="#ffffff"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله </span></font></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
