<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا تكلا هيمانوت الحبشي القس-نبدأ يا مؤمنين</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA">نسبح 
        إلهنا العظيم</span></b></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA"> نبدأ 
        يا مؤمنين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ونرتل بالتهليل</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وابتهجوا فرحين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">  تعالوا يا مؤمنين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فإن اليوم هو عيد</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> أمام الرب القدوس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">  إرتفعت بالحقيقة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> أيها الأب الطاهر</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> الصابغ والشهيد</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> لأنك مثل يوحنا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> طوباك يا إبن الموعد</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> الكاهن والقديس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> طوبي لأبيك سجازآب</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> طوبي لأمك سارة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> في وسط البحيرة صار</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> هرب أبوك من الأشرار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فأتاه ميخائيل طيار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> لكن الملاك نجاه</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ناله كثير الآلام</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> حفظه من أجل ميلاد</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> أن يؤذوا أم البار</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">  أراد الجند الأشرار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> الرب بنجاتها أشار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وتأنست بالوحوش</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> قصدت البرية</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وعشت في روحانية</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> والبدع الشيطانية</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">هدمت 
        الوثنية</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> بالقوة الإلهية</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> قد صنعت بأمانة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">عجائب في 
        كتانا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> بصلوات أبينا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> حين بشرت بالإنجيل</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">أتيت بفرح 
        كثير</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فسموك رسول جليل</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> خلصت الناس من الموت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">في مدينة 
        تدعي داموت</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> حين هلك الإله الممقوت</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> أمام الرب القدوس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">رفعتك 
        صلواتك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فأحبك إلهك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> في حرب روحية عوان</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-EG" xml:lang="AR-EG">  </span> <span style="color: black" lang="AR-SA" xml:lang="AR-SA">واجهت قوة 
        الشياطين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فإنتصرت بقوة الديان</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> في مكان ملآن أشجار</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-EG" xml:lang="AR-EG">  </span> <span style="color: black" lang="AR-SA" xml:lang="AR-SA">ظهرت لك 
        الشياطين</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ليخيفك بقوة النار</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وقوة طهارتك</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">أخزيته 
        بصلاتك</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ففر من أمامك</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> أنقذك الملاك من الضيقة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">ألقوك في 
        بئر عميقة</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فتمجد الله بالحقيقة</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فإلتوت الشجرة في الحال</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">علقوك علي 
        شجرة بحبال</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فإنذهل كل الرجال</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> تفقدت الأقاليم</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">في زيارة 
        لأورشليم</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA">يا 
        محب يسوع المسيح</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وربحت في الوزنات</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">أكملت 
        جهادك بثبات</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b> <span style="color: black" lang="AR-SA" xml:lang="AR-SA">ف</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG">إ</span><span style="color: black" lang="AR-SA" xml:lang="AR-SA">ستحققت 
        الميراث</span><span style="color: black" lang="AR-EG" xml:lang="AR-EG"><br />
        </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ظهر طيب طهارتك</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">أيضا بعد 
        نياحتك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وعطر قداستك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وبيوم عيدك أخبرت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">لأنبا 
        حزقيال ظهرت</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ولحضورك أشرت</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> حول المذبح صلوا</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">فقلت 
        بجسدي طوفوا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> فأضاء قنديل من ذاته</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> الطاهر والمختار</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">طوباك 
        أيها البار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> يا ساكن بين الأبكار</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> ونذكر اسمك العظيم</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">نكرمك في 
        كل حين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> في مجمع القديسين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> يا زاهر بالرهبان</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">  طوباك يا جبل شيهيت</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> سريان وأحباش ورومان</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وننال من بركاتك</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">تسندنا 
        صلواتك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وإحنا بنقبل جسدك</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وشركاءه </span><span style="color: black">أساقفتنا</span><span style="color: black" lang="AR-SA" xml:lang="AR-SA"><br />
      </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">  لا تنسي بطركنا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> وكل كنيستنا</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA">تفسير 
        اسمك في أفواه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> آفا تكلا هيمانوت</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><b><span style="color: black" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></b></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�XD0h␀␀0h␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/c8.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا تكلا هيمانوت الحبشي القس-الذكصولوجية</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG"> لما نزل من السماء</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">  الروح المعزي</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> على الطوباوي</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> لميلاده المبارك</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  في اليوم الثالث</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> واحد هو الآب والإبن والروح القدس</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> صرخ قائلًا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> من الروح القدس</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  ومنذ طفوليته إمتلأ</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> كانت تظلل عليه</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وملائكة السماء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> كائن معه كل حين</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  ميخائيل رئيس السمائيين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> داود في المزمور</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كما قال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وأعطاك سلطان</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  والمسيح ظهر لك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> كمثل رُسُله</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الربط والحل</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> مُختارًا ليسوع المسيح</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  وصرت رسولًا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وأبتً للرهبان</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> رئيس كهنة للأحباش</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> في أفواهنا وأفواه الأحباش</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> صار إسمك حلوٌ</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> تكلا هيمانوت ترأف علينا</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بقولنا يا إله القديس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا رسول الأحباش</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  إطلب من الرب عن</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> ويغفر لنا خطايانا</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> القديس تكلا هيمانوت</span></b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKX�j�D␀␀D␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/c9.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا تكلا هيمانوت الحبشى القس-نسجد لاسم القدوس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">  المحيى كل النفوس</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نسجد لأسم 
        القدوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  سيدنا ايسوس بخرستوس</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">من زمان والى 
        الابد </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="direction: rtl; unicode-bidi: embed" align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> هم فى الحق اسود</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="direction: rtl; unicode-bidi: embed" align="center"><b><span lang="AR-SA" xml:lang="AR-SA">الشهداء الجدود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="direction: rtl; unicode-bidi: embed" align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> الهنا عمانوئيل</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="direction: rtl; unicode-bidi: embed" align="center"><b><span lang="AR-SA" xml:lang="AR-SA">حاميين دين المعبود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-SA" xml:lang="AR-SA">  والشهداء والمعترفين</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-SA" xml:lang="AR-SA">ماحلا سيرة 
        القديسين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> طوباكم يا منتصرين</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-SA" xml:lang="AR-SA">رافعين رايات الدين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">لكى انشط واقوم</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">اعنى يا رب كل يوم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">  افا 
    تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">و امدح قديس مبرور</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> من الشعب محبوبين</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">والديه كانوا مغبوطين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> ابونا 
    سجازاب وامنا سارة</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">للصلاة دائما</span><span lang="AR-SA" xml:lang="AR-SA">ً </span><span lang="AR-EG" xml:lang="AR-EG">قائمين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">  تركوا المال والعبيد</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">زاهدين فى كل شىء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> ابونا سجازاب وامنا سارة</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">لاجل المجد 
        العتيد </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> يوم 12 
    تمام</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">فى كل شهر كان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> على اسم الملاك ميخائيل</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">يقيمون مائدة للفقراء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> ذو البأس العظيم</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">رئيس الملائكة ميخائيل</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> ابونا 
    سجازاب وامنا سارة</span></b> </h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">ساند الأبوين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">   </span><span lang="AR-EG" xml:lang="AR-EG">انقذ 
    ابونا سجازاب</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">رئيس الملائكة الجليل</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">   
    افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">لاجل ميلاد المنير</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">  
    مفسد عفة النفوس</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">والى داموت المنجوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">انقذها بى ارشى انجيلوس</span></b> </h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">لكن الام 
        المختارة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> لسارة المختارة</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b> <span lang="AR-EG" xml:lang="AR-EG">ولد بأشارة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG"> افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3 dir="rtl" style="text-align:center;direction:rtl;unicode-bidi:embed"><b><span lang="AR-EG" xml:lang="AR-EG">سيكون مثال الطهارة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">نظر للسماء</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">فى يوم ميلاده الثالث</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">اسباتير اجيوس,</span> <span lang="AR-EG" xml:lang="AR-EG">اوثيؤس اجيوس</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">و فتح فاه وقال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">وانت فى 
    الحداثة</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">باركت الدقيق والزيت</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يا مثال القداسه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">كالأخوة 
    تمام</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">عاش وزوجته بسلام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">محبة فى الفادى الحنان</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وحفظا البتولية</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">من الأب 
    الحبيب</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">بأشارة الصليب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">الشجرة تمشى وتطيع</span><span lang="AR-SA" xml:lang="AR-SA"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">بكل اطمئنان</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">فى الغابة كان ينام</span><span lang="AR-SA" xml:lang="AR-SA"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">رغم حروب الشيطان</span><span lang="AR-SA" xml:lang="AR-SA"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">كان 
    قديسنا محروس</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">فى كهف وسط الوحوش</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">فالملاك حال حول خائفيه</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مثل النبى دانيال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">لئلا فى يوم 
    تلام</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">شجرة تنحنى يا سلام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">على شنق الكرام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">يفيض مثل 
    الينبوع</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">يا جمال قديس يسوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span> <span lang="AR-EG" xml:lang="AR-EG">مبشرًا بالملكوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">و يجول الربوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">على جبل 
    دامو</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">دير القديس ادجواى</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">يصلون اليه بالحبال</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">عالى فوق الجبال</span><span lang="AR-SA" xml:lang="AR-SA"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">انقطعت الحبال</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">و فى يوم نزول القديس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">فحماه الرب فى الحال</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">على ارتفاع عال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">عليه 
    ستة اجنحة منيرون</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">فى الحال رأى الحاضرون</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">شبيه الملائكة</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">لأنقاذ انبا تكلا</span><span lang="AR-SA" xml:lang="AR-SA"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">ومديح طول 
    اليوم</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">صلاة وصوم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يا قديس طاهر مبرور</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">ومخلص 
    للنفوس</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">صرت اب نى موناخوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">افا تكلا 
    هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يا سليل انبا انطونيوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">قائم 
    للصلوات</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">على مدى الساعات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">طوباك يا انبا تكلا</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">بنفس قوية وثبات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">جسمك 
    قد صار</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ن كثرة النسك والصوم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">طوباك يا انبا تكلا</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">كخشب محروق</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">يا 
    حبيب عريسنا</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">طوباك يا قديسنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يا شفيع فى انفسنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">معاشرة علية 
    القوم</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">رجائى كل يوم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">فى 
    ملكوت السموات</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">مع الأنبا تكلا 
        هيمانوت</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">رجائه 
    واحد بثبات</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">وناظم ذى الأقوال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">عن يمين رب القوات</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ان يكون بعد الممات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">مع 
    القديسين الأبرار</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">يا قائم بكل وقار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">امام عرش النعمة</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">لا تنسى ذكرنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">و شفاعتك 
    تعيننا</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">بركتك تشملنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">   </span><span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يا شفيع كنيستنا</span><span lang="AR-SA" xml:lang="AR-SA">  </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span> <span lang="AR-EG" xml:lang="AR-EG">يا حبيب الرب ايسوس</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">اكسيوس اكسيوس اكسيوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b> <span lang="AR-EG" xml:lang="AR-EG">افا تكلا هيمانوت</span></b></h3></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">حبك لينا ملموس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  </span><span lang="AR-EG" xml:lang="AR-EG">فى افواه 
    كل المؤمنين</span></b></h3></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">تفسير اسمك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Times New Roman" dir="rtl" lang="AR-SA" xml:lang="AR-SA">   </span> <span style="font-family: Times New Roman" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> الأنبا تكلا، اعنا اجمعين</span></b></h3></td>
    <td><div align="center">
      <h3><b><span style="font-family: Times New Roman" dir="rtl" lang="AR-EG" xml:lang="AR-EG">الكل يقولون يا اله </span></b></h3>
    </div></td>
  </tr>
