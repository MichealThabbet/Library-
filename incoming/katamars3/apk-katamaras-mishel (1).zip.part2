<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيدة بربارة والشهيدة يوليانة</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><b><font >ونسبح خالقنا</font></b></h3></td>
    <td width="50%"><h3 align="center"><b><font >نُمجد إلهنا</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >ونمدح أحبابنا</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <b><font >طاهرة ونقية</font></b></h3></td>
    <td><h3 align="center"> <b><font >برباره الصبية</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"> <b><font >من أسرة وثنية</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >أحبها حبا وافر</font></b></h3></td>
    <td><h3 align="center"><b><font >والدها كان كافر</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >بنى لها قصرًا فاخر</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >وللسماء نظرت</font></b></h3></td>
    <td><h3 align="center"><b><font >للشمس تطلعت</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >وللخليقة تأملت</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >والعالم من أنشاه</font></b></h3></td>
    <td><h3 align="center"><b><font >قصرى أبويا بناه</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >دا عظيم وهو الإله</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >معلما حكيما لبرباره</font></b></h3></td>
    <td><h3 align="center"><b><font >أرسل الرب الإله</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >علمها الإيمان بنقاوة</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >والحياة الأبدية</font></b></h3></td>
    <td><h3 align="center"><b><font >علمها المسيحية</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >والدنيا سراب فانية</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >وبتجسد يسوع وحيده</font></b></h3></td>
    <td><h3 align="center"><b><font >آمنت بالله وتعاليمه</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >لخلاص عبيده</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >من مرمر ورخام</font></b></h3></td>
    <td><h3 align="center"><b><font >فى القصر كان حمَّام</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >وفيه طاقتين عظام</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >مثال الثالوث قصدت</font></b></h3></td>
    <td><h3 align="center"><b><font >طاقة ثالثة صنعت</font></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><font >برباره ويوليانه</font></b></h3></td>
    <td><h3 align="center"><b><font >صليب على الحوض وضعت</font></b></h3></td>
  </tr>
  <tr>
