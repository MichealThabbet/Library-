    <td><h3 align="center" >تعاهد وأخرج 
    نوح وبنيه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ودبر للعالم 
    سرًا يفديه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >أن ينزل لخلاص 
    جبلته</h3></td>
    <td><h3 align="center" >ثم اراد بحكمته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ويرتب اسرار 
    بيعته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فارسل الله 
    ابنه مولود</h3></td>
    <td><h3 align="center" >جاءَ ملء 
    الزمان المحدود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >من عذراء طاهرة 
    فى بيت داود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فرحا بها فرحا 
    عظيم</h3></td>
    <td><h3 align="center" >حِنَّه امها 
    وأبوها يواقيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ووهباها لهيكل 
    اورشليم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >على ايدى 
    الكهنة والأحبار</h3></td>
    <td><h3 align="center" >خُطبَت ليوسف 
    النجار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وعاشت معه عيشة 
    الأطهار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لأنها كانت له 
    نذيره</h3></td>
    <td><h3 align="center" >دخلت الهيكل 
    صغيرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >من العائلة 
    والعشيرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >حين كمُلت 
    الثلاثة أعوام</h3></td>
    <td><h3 align="center" >ذهب بها ابواها 
    الكرام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ليقدماها للرب 
    تمام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >ينشدن التسابيح 
    والترانيم</h3></td>
    <td><h3 align="center" >رافقوهما بنات 
    اورشليم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ويصرخن بصوت 
    عظيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لما وصلن هيكل 
    سليمان</h3></td>
    <td><h3 align="center" >زدن فى 
    التسابيح والألحان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >فخرج الكهنة مع 
    الخصيان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لما رأوا عليها 
