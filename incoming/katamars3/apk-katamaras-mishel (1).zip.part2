<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد موريس والكتيبة الطيبية-أمدح طوباوي قديس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">شجاع اسمه موريس</h3></td>
    <td width="50%"><h3 align="center">أمدح طوباوى قديس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">ثابت فى إيمان نفيس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> المدينة المحبوبة</h3></td>
    <td><h3 align="center"> وُلِدَ فى طيبة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center"> بالأقصر معروفة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وفى الحروب قاهر</h3></td>
    <td><h3 align="center">كان جندى ماهر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">وفى محبة المسيح باهر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ستة آلاف وستمية</h3></td>
    <td><h3 align="center">قائدًا للكتيبة الطيبية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">للدفاع عن الجيوش الرومانية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">إلى جنوب غرب سويسرا</h3></td>
    <td><h3 align="center">من جنوب شرق فرنسا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">والله إعطاه نُصرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بالتبخير للأوثان</h3></td>
    <td><h3 align="center">أمر الوالى مكسيميان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">رفض الجنود الشجعان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">قال كل الفرسان</h3></td>
    <td><h3 align="center">نحن عبيد الديان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">موريس وكل الإخوان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">نسى تعب الأبرار</h3></td>
    <td><h3 align="center">مكسيميان الغدار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">وأمر بقتل الأحرار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من طيبة المصرية</h3></td>
    <td><h3 align="center">فيرينا العفيفة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">فى صلاة روحانية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لم ترهب التهديد</h3></td>
    <td><h3 align="center">خدمت بإيمان شديد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">ولا الوعود ولا الوعيد </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وهى تُصلِّى بخشوع</h3></td>
    <td><h3 align="center">حفظها الرب يسوع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">يارب احفظ الجموع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">واحد من كل عشرة</h3></td>
    <td><h3 align="center">قتل الوالى بدون رحمة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">أمام كل الحضرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الذين حضروا من طيبة</h3></td>
    <td><h3 align="center">قتل كل الكتيبة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">نالوا الحياة بالحقيقة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وكنائسهم فى كل مكان</h3></td>
    <td><h3 align="center">الله فرح بالشجعان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">ونشر سيرتهم بالعيان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وكل مكان فى أوروبا</h3></td>
    <td><h3 align="center">فى فرنسا وسوسيرا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">وفى مصر نكرَّمها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تكلَّلوا بالجلال</h3></td>
    <td><h3 align="center">السلام للأبطال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">فى الأرض والسماء بكمال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وارحمنا يا حنان</h3></td>
    <td><h3 align="center">يارب ثبَّتنا فى الإيمان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام للشهيد موريس</h3></td>
    <td><h3 align="center">بصلوات هؤلء الشجعان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كل المؤمنين</h3></td>
    <td><h3 align="center">تسبيح اسمك فى أفواه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">القديس موريس أعنَّا أجمعين</h3></td>
    <td><h3 align="center">الكل يقولون يا إله</h3></td>
  </tr>
</table>
</body>
</html>
