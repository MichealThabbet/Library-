<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td width="100%" colspan="2"><h1 align="center">القديس الأنبا كاراس السائح-بمحبة نارية</h1></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بمحبة نارية نورت البرية بسياحة سمائية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بنيوت أفا كاراس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> 57 سنه لم يرى وجه انسان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> متحداً بالنعمة ومحبة رب الانام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فتش عنك ابنا بموا بين الصخور والتلال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ليسجل جهادك وهو عالى فوق الجبال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فسأل كل من وجد هل يوجد هنا انسان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عظيم فى النعمة ومحبة رب الاحسان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> كنت اخو الملك ثيؤدوسيوس وتركت ملك العالم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لم تبهجك المعالم بنيوت افا كاراس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بمحبة الهية تذوقت العطية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لاله الابدية بنيوت افا كاراس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> قال عنك ابنا القديس سمعان القلاع</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لم يكن العالم مستحقاً وطأة واحدة من قدميك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فتنهد ابنا وقال يوجد قديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عظيم فى جهاده ومحب للمسيح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> به البرية تتبارك والنفس تستريح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> الذى يرى جماله يصرخ بالتسبيح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> قال عنك الانبا بلامون بالحقية من انا اكون ؟</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لست انا المطلوب بل كاراس المحبوب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بالروح الشفافة رأيت رؤية جميلة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> موكبا لنياحة قديسنا افا شنوده</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تحدثت مع انبا بموا بعظائم الله الكثيرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وصرخت فى الطلبة من اجل يوم الدينونه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فقولت الى اين اهرب ومن وجهك كيف اختفى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وحقاً ما أرهب ساعة الانتقال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وصرخت بالدموع كرحمتك يارب وليس كخطاياى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فتعجب انبا بموا من صرخات القديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لانه كان يشعر بعدم الاستحقاق</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وفى اليوم التالى اى الثامن من ابيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> جاء الى المغارة صاحب الحب العجيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يسوع بمجد ابيه كان معتاد ان يأتى اليه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ولكن اليوم جاء اليه لتفرح السما بيه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وتبارك انبا بموا من جسد القديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وعاد الى ديره ليسجل الخبر النفيس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تفسير اسمك فى افواه كل المؤمنين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> الكل يقولون يا اله انبا كاراس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> اعنا اجمعين</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
