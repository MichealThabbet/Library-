    <td><h3 align="center">وكل ما فيها </h3></td>
    <td><div align="center">
      <h3>تركت الأرضيات</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وأحببت أقاصيها</h3></td>
    <td><div align="center">
      <h3>وغويت السماويات</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وأنت كنت صغيرة </h3></td>
    <td><div align="center">
      <h3>أحببت البتولية </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا نجمة منيرة </h3></td>
    <td><div align="center">
      <h3>في سن الطفولية </h3>
