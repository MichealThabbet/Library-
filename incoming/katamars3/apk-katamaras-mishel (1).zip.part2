<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الملاك ميخائيل رئيس الملائكه-السلام لك يا ميخائيل</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">رئيس جند السموات</h3></td>
    <td width="50%"><h3 align="center">السلام لك يا ميخائيل </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">خادم رب القوات</h3></td>
    <td><h3 align="center">ملاك السلام و التهليل </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">شرفك باعلي الدرجات</h3></td>
    <td><h3 align="center">البسك حلة و اكليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تفسيره عظيم القوات</h3></td>
    <td><h3 align="center">و سماك ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و ملاك حكمة ورحمة</h3></td>
    <td><h3 align="center">قلدك بسيف النقمة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> في القيامة و الزحمة</h3></td>
    <td><h3 align="center">أعطاك بوق النعمة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و أعطاك سيفا من نار</h3></td>
    <td><h3 align="center">ملاك الله قدرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> صاحب سطوة و مقدار</h3></td>
    <td><h3 align="center">و وهبك عزم و نصرة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من اعلي مرتبته</h3></td>
    <td><h3 align="center">صرعت سطانائيل </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والي الأرض طرحته</h3></td>
    <td><h3 align="center">أسكنته وطن الويل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> و عساكره قدامه</h3></td>
    <td><h3 align="center">جعلت الجحيم مثواه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و لا تمحي أجرامه</h3></td>
    <td><h3 align="center">و طعامه النار جواه  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عساكرك ملكوها</h3></td>
    <td><h3 align="center">رياسته و مرتبته </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> طغماتك زانوها</h3></td>
    <td><h3 align="center">و جلست علي تخته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يصيرون من اسمك فزعين</h3></td>
    <td><h3 align="center">جميع جند الشياطين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يولون منكسرين</h3></td>
    <td><h3 align="center">حين نقول يا ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يا مدبر كل الجهات</h3></td>
    <td><h3 align="center">سلامي عليك دايما</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يا رئيس كل الطغمات</h3></td>
    <td><h3 align="center">يا ولي سر النعمة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مع البار دروثيؤس</h3></td>
    <td><h3 align="center">صنعت عجائب شتي </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و افوميه و ارسترخس</h3></td>
    <td><h3 align="center">آمراته تاؤبسته </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا من بشفاعتك</h3></td>
    <td><h3 align="center">السلام لك يا ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الراجي طلباتك</h3></td>
    <td><h3 align="center">قد أغنيت المسكين </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تصيح النهار و الليل</h3></td>
    <td><h3 align="center">جميع كل عظامي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أقول يا ميخائيل</h3></td>
    <td><h3 align="center">و أنا بطول أيامي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا صاحب الصيت الفاخر</h3></td>
    <td><h3 align="center">السلام لك يا ميخائيل </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ذو العجب الباهر</h3></td>
    <td><h3 align="center">يا معظم بالتبجيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا معونة للمساكين</h3></td>
    <td><h3 align="center">السلم لك يا ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">شفيع في المخلوقين</h3></td>
    <td><h3 align="center">يا قوة لكل هزيل يا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">صانع كل عجائب</h3></td>
    <td><h3 align="center"> السلام لك يا ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مانع كل مصائب</h3></td>
    <td><h3 align="center">في الشعوب المسيحيين </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا شفيع في المخلوقات</h3></td>
    <td><h3 align="center">السلام لك يا ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و الزراعات و الثمرات</h3></td>
    <td><h3 align="center">الطالب عن مياه النيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> كل المؤمنين</h3></td>
    <td><h3 align="center">تفسير اسمك في أفواه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الملاك ميخائيل أعنا أجمعين</h3></td>
    <td><h3 align="center">الكل يقولون يا اله</h3></td>
