<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">الشهداء يسطس وأبالى وثاؤكليا</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">الأبرار المجاهدين</span></strong></h3></td>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1">  
	+  السلام للقديسين<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فى الفردوس فرحين<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">نوماريوس كان أبوك</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  يسطس ابن الملوك<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> لملك روما دعوك<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وهبه رب الأبرار</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  يسطس الرجل البار <br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> أبالى ابنه المختار<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">كانت امرأة تقية</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  زوجته ثاؤكليا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> أحبت البشرية<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بعد طول الدرب</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  لما عاد من الحرب<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وجد فى القصر كرب<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وملك على تخته</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  دقلديانوس تزوج أخته<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فترك العرش تحته<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">دقلديانوس عبد الأوثان</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  إرتد عن الإيمان<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وجحد الرب الديان<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">المملكة والوجهاء</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  اجتمع كل رؤساء<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ليورثوه ملك الآباء<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">مفضلًا السمائية</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  رفض المملكة الأرضية<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ناظرًا للأبدية<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">معترفًا باسم إيسوس</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  تقدم إلى دقلديانوس<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> قال أنا عبد القدوس<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">لوالى الإسكندرية</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  أرسله بوحشية<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> هو وأبالى وثاؤكليا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وعن عزمهم يثنيهم</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  حاول الوالى يغريهم<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فلم يقدر عليهم<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">ونعبد آخر سواه</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  كيف نترك الإله<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وهو لنا خبز الحياة<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">عن حب جابلنا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  من يقدر يفصلنا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1">وهو النور لسبيلنا<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">ولا تعب فى الطريق</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + لا شدة ولا ضيق<br />
      </h3>
    </div></td>
  </tr>
