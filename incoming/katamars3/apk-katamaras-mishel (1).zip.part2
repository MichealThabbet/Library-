    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">واراد مهادنتها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  مع كل الهته</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">فلعنته فى وجهه</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">فاصدر عليها امره </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> فنالت اكليلها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">بقطع راسها </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">وصعدت لحبيبها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  مطروحا فى مكانها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">قد بقى جسدها </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">لم يقدر احد ان يدفنها </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان يصرخ ويصيح</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">فصار ابنهاالقديس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">الا يوجد قلب حسيس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> يدفن هذه المراة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">يوجد فيه رحمة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">ويوارى جسدها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  وجسدها قد اكرم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">مار بقطر تقدم  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">فامر بنفيه الاظلم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> فنالوا اكليلهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">ثم قطعوا رؤوسهم  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">من عند خالقهم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> بركاتهم ترفعنا</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">صلواتهم تكون معنا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان واخوه دميان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">للرب فيقبلنا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700"> كل المؤمنين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">تفسير اسماءكم فى افواة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">  قزمان ودميان اعنا اجمعين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="FONT-WEIGHT: 700">الكل يقولون يا اله  </span></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
