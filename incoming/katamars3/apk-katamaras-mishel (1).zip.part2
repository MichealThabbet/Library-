<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>شهداء الفيوم</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> وامدح يا اخوتنا</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ابدا باسم الهنا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شهداء كنيستنا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فى مجمع الاطهار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فى كنيسة الابكار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شهداء الفيوم الابرار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بالمجد اكاليل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قد نالوا التهليل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">من عند عمانوئيل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> للرب عابدين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قد كانوا قديسين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فى حياتهم مجاهدين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لهم حب روحانى</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وكانوا يا اخوتى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">و شوقا نورانى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ان ينطلقوا الى السماء</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فاشتاقوا يا احباء </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">مثل رسول الرجاء </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الههم و حبيبهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ليكونوا مع مسيحهم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">من مات و قام عنهم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> للمسيح يسجدون</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قالوا انهم مسيحيون </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">و بالحق يعبدون </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> وتقطيع اجسادهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فامر بحرق اجسادهم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">حتى الاطفال منهم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بقوا براى سديد</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">رغم العذاب الشديد </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لم يرهبوا التهديد</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> يسندهم و يشفيهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كان الرب يقويهم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> شهداء الفيوم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وملاكه يعزيهم  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الوف محبى الديان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وعددهم يا اخوان</span></font></h3>
    </div></td>
  </tr>
  <tr>
