<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس ابونا يسى ميخائيل-مع الـ24 قسيس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> قائم بمقام نفيس</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مع الاربعة 
        والعشرين قسيس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كاهن تقى قديس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> فى وسط جو عجيب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ولد فى كوم غريب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  نشأ فى حب رهيب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وحضور القداسات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  كان محبا للصلوات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  والتناول فى القداسات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وحفظ المزامير</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  تعلم قراءة الأنجيل</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والصلاه بكل تهليل</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وتعلق بالسمائيات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ارتفع فوق الارضيات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كان يحيا فى الايمان بثبات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> لينظر قبر الهنا العظيم</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> سافر إلى اورشليم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عاد بفرح عظيم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> لينال سر الكهنوت</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> اختاره رب الصباؤت</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ويعلمنا طريق الملكوت</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> خدم ابناؤه الطيبين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فى كنيسة رئيس المتوحدين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بمحبه وهدوء عجيبين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وسار الكل معاه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أحبه كل من رآه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فى طريق اله السماء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وايضًا اعطاه البركات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  وهبه الله المعجزات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> واستجاب له الصلوات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center"> 
      <h3><span style="font-weight: 700" lang="ar-sa" xml:lang="ar-sa"> إلى الله الفادي الحبيب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b> <span lang="ar-sa" xml:lang="ar-sa"> انتقل ابنه 
        الوحيد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا يسى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="ar-sa" xml:lang="ar-sa"> وتقبل هذا بسر عجيب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center"> 
      <h3><span style="font-weight: 700" lang="ar-sa" xml:lang="ar-sa"> وشكر إله الآنام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="ar-sa" xml:lang="ar-sa">  احتمل الأسقام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
