<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا تكلا هيمانوت الحبشي القس-السلام لك والاكرام</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG">يا قديس أنبا 
        تكلا</span></b></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> السلام لك 
        والإكرام</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> عندنا وفي إثيوبيا</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> لك مكانة وإحترام</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> معنى إسمه عطية الله</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG">  هيمانوت والده كان كاهن</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> شهرتها مختارة الله</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> والدته إسمها سارة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> الفقراء والمحتاجين</span></b></font></h3>
    </div></td>
    <td><div align="center"><h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> والديه كانوا محبين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> على الصلاة وشكر الله</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> كانوا دايمًا مواظبين</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> وبشفاعة الملاك طلبوا</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG">  بالإيمان صلى والديه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> ويكون على حسب قلبه</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> طلبوا ولد من الله</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> معناه &quot;سند الإيمان&quot;</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> تكلا هيمانوت إسمه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> وإسمه على كل لسان</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> عاش في القرن السابع</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> وأمه للوليمة محتاجة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> كان في البلد مجاعة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> كفّى الفقراء وزيادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> بارك تكلا الطعام</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> حالًا لبّى النداء</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG">  تكلا ربنا ناداه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> وذهب للرهبنة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> ترك كل ماله</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> بإسم إيسوس بخرستوس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> بشر في بلاد كثيرة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> لأجل خلاص النفوس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> وإحتمل كل العذابات</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> كالشاروبيم والسيرافيم</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> ظهرت له ستة أجنحة</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> بعد الخطر الجسيم</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><b><span lang="AR-EG" xml:lang="AR-EG"> هبط للأرض سليم</span></b></font></h3>
    </div></td>
  </tr>
</table>
</body>
