    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مقامه رفيع ونفيس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أبوه كان قسيس</span></h3>
