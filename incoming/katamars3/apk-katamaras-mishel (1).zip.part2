<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-العليقة التي رأها</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">موسى النبي في 
    البرية</span></b></h3></td>
    <td width="50%"><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> العليقة التي 
    رآها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ولم تمسسها بأذية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والنيران تشعل جواها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> حملت جمر اللاهوتية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  مثال أم النور طوباها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وهي عذراء ببكورية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> تسعة أشهر في أحشاها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وانطق بأسرار خفية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أنا أفتح فمي وأتكلم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بكرامة أم النور مريم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أحرارًا بعد العبودية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  بك يا زين العالم صِرنا</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ومن أسر إبليس خلصنا</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والشهادات النبوية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  تمت عنك كل الأقاويل</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بشأن ميلادك عمانوئيل</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بحلول الكلمة الأزلية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  جبرائيل بالبشرى ناداها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وهي عذراء ببكورية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أتى وسكن في أحشاها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وأخذ منك الناسوتية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  حل بروح قدسه في أحشاك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بشري كامل حملته يداك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وأبراه من سم الحية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  خلص آدم وبنيه</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وأسبغ نعمته عليه</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ونطق بشهادات نبوية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  داود أبوك قال عنك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباكِ يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> إله الآلهة صار في حضنك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لأجل خلاص البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  دعيت أمًا لمن أنشاك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وأنت عذراء ببكورية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أتى وسكن في أحشاك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> سماء ثانية جسدانية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  سماك الآباء الأبرار</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> سكن فيها المولى الجبار</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بابا قائمًا في الشرقية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  شهد حزقيال ورآها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والختم في صيانة إلهية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> دخل وخرج فيها مولاها</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لأجل خلاص البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  طأطأ أعلى السموات ونزل</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا زين البشرية</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وهو في حضن أبيه لم يزل</span></b></h3></td>
  </tr>
</table>
