  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> و شرب سم قتال </h3></td>
    <td class="auto-style1"><h3 align="center"> + دخل اتون من نار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
