  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كل يوم يزيد </span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كان حبك لالهك </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  ملا الدنيا افراح</span></font></h3></td>
