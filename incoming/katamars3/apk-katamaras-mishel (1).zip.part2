<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="2"><div align="center">
      <h1>شهداء أخميم-أبدأ باسم إلهنا</h1>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وامدح يا أخوتنا</h3></td>
    <td><h3 align="center">ابدأ بأسم ألهنا</h3></td>
  </tr>

  <tr>
    <td><h3 align="center">السلام لشهداء أخميم</h3></td>
    <td><div align="center">
      <h3>شهداء كنيستنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">هذا الوالى المنجوس<br />
        </h3></td>
    <td><h3 align="center">أمرهم أريانوس<br />
        </h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام لشهداء أخميم</h3>
    </div></td>
    <td><div align="center">
      <h3>أن يجحدوا القدوس<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وللمسيح يسجدون<br />
        </h3></td>
    <td><h3 align="center">فقالوا أنهم مسيحيون<br />
        </h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام لشهداء أخميم</h3>
    </div></td>
    <td><div align="center">
      <h3>وبالحق يعبدون<br />
      </h3>
    </div></td>
  </tr>
  <tr>
