  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">فتخلص بالكلية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الى اباء الاسقيط</h3></td>
    <td><h3 align="center">جاء الىشيهيت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">وبسرعة انتشر الصيت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  بعيدا عن العيون</h3></td>
    <td><h3 align="center">عاش فى هدوء و سكون </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">يناجى الرب الحنون </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  كثيرا ما ندمت</h3></td>
    <td><h3 align="center">قال حين تكلمت </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">لكن بالصمت فرحت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   يختفى عن الناس</h3></td>
    <td><h3 align="center">فى اثناء القداس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">يصلى بكل حواس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    وحديث مع الاله</h3></td>
    <td><h3 align="center">الليل كله صلاة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">ساهرا كالعذارى </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  قال انا الخاطئ</h3></td>
    <td><h3 align="center">اثناء الاغابى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">واللطمة على وجهى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  بكيت طول الحياة</h3></td>
    <td><h3 align="center">قال وقت النياحة  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">لاجل هذه الساعة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بكيت هنا على خطاياك</h3></td>
    <td><h3 align="center">فقالوا له طوباك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">فلن تبكى هناك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  يا عظيم بين الاباء</h3></td>
    <td><h3 align="center">يا معلم الامراء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">اذكرنا فى السماء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> كل المؤمنين</h3></td>
    <td><h3 align="center">تفسير اسمك فى افواة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> انبا ارسانيوس اعنا اجمعين</h3></td>
    <td><h3 align="center">الكل يقولون يا اله</h3></td>
  </tr>
