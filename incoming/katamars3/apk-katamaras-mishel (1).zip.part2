PK"c�e␀␀e␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/a37.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد إستفانوس-السلام لك يا استفانوس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">  يا رئيس الشمامسة</h3></td>
    <td width="50%"><h3 align="center">السلام لك يا اسطفانوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   يا اول الشهداء</h3></td>
    <td><h3 align="center">السلام لك يا اسطفانوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> شمامسة سبعة</h3></td>
    <td><h3 align="center">الرسل اختاروا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  من كل نعمة</h3></td>
    <td><h3 align="center">رجالا مملوئين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تيمون وفيلبس</h3></td>
    <td><h3 align="center">ميكانور وبروخوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  و اولهم اسطفانوس</h3></td>
    <td><h3 align="center">برميناس ونيقولاس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  كان يصنع الايات</h3></td>
    <td><h3 align="center">قديسنا اسطفانوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وليضا معجزات</h3></td>
    <td><h3 align="center">وعجائب عظام </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   وايضا اليهود</h3></td>
    <td><h3 align="center">فحسده الشيطان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> كانوا عنده شهود</h3></td>
    <td><h3 align="center">فحرك ايناسا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   وظهروا مخادعين</h3></td>
    <td><h3 align="center">فى شهادتهم كاذبين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  وعليه قائلين</h3></td>
    <td><h3 align="center">ليتهموا الامين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> هذا الانسان</h3></td>
    <td><h3 align="center">يجدف على الله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وهيكل سليمان</h3></td>
    <td><h3 align="center">وايضا على موسي </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  عن محبة الله</h3></td>
    <td><h3 align="center">فوقف وتكلم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  ما قد جاء فى التوراة</h3></td>
    <td><h3 align="center">ولخص و شرح </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  تبكيت ضمائرهم</h3></td>
    <td><h3 align="center">وختم خطابه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> هم وابائهم</h3></td>
    <td><h3 align="center">على كل ما فعلوه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> اباكم اطاعوا</h3></td>
    <td><h3 align="center">ايا من الانبياء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   قتلتوه و صلبتوه</h3></td>
    <td><h3 align="center">وكذلك يسوع المسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بقلوبهم و اخذوه</h3></td>
    <td><h3 align="center">فغتاظوا و حنقوا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  هناك قد رجموه</h3></td>
    <td><h3 align="center">وفى خارج المدينة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ونظر الى السموات</h3></td>
    <td><h3 align="center">فشخص اسطفانوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  وحوله قوات</h3></td>
    <td><h3 align="center">فراى مجد الله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  السموات مفتوحة</h3></td>
    <td><h3 align="center">فقال ها انا انظر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  عن يمين الله</h3></td>
    <td><h3 align="center">وابن الانسان قائم </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   بنية نقية</h3></td>
    <td><h3 align="center">فصلى للاله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    هذه الخطية</h3></td>
    <td><h3 align="center">يارب لا تقم لهم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    غفر لصالبه</h3></td>
    <td><h3 align="center">يسوع المسيح </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> قد سامح راجميه</h3></td>
    <td><h3 align="center">والقديس اسطفانوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   يا حبيب ايسوس</h3></td>
    <td><h3 align="center">فى يوم واحد طوبة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الى الفردوس</h3></td>
    <td><h3 align="center">يوم انتقالك </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   فى السنة القبطية</h3></td>
    <td><h3 align="center">ويوم 15 توت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  لمدينة القسطنطينية</h3></td>
    <td><h3 align="center">تذكار نقل جسدك </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   اذكرهم فى صلاتك</h3></td>
    <td><h3 align="center">ابنائك الشمامسة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  ويقتدون بصفاتك</h3></td>
    <td><h3 align="center">ليبشروا بالانجيل </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  امام رب القوات</h3></td>
    <td><h3 align="center">اذكرنا كلنا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فى ملكوت السموات</h3></td>
    <td><h3 align="center">لنحظى بوجودنا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    كل المؤمنين</h3></td>
    <td><h3 align="center">تفسير اسمك فى افواه  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  القديس اسطفانوس اعنا اجمعين</h3></td>
    <td><h3 align="center">الكل يقولون يا اله </h3></td>
  </tr>
</table>
