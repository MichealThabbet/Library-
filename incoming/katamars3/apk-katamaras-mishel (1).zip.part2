<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا بولا أول السواح-في حلة نورانية</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"> <b><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">ثياب 
        بر نقية</span></b></font></font></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"> <b> <span lang="AR-SA" xml:lang="AR-SA"> فى حلة نورانية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> فى أورشليم السمائية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> حياة بر نقية</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> ذبيحة حب قوية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> سيرة عطرة حقيقية</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> قد تم سر المزمور</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> داود اليوم مسرور</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> بينيوت أفا بافلى</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> حين قال لابنة صهيون</span></b></font></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> اختارك واحبك</span></b></font></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><font color="#000000"><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA"> قال يا ابنة ربك</span></b></font></font></font></h3>
    </div></td>
  </tr>
