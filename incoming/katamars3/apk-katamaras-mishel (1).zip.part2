<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">الشهيد أبو فام الجندى</h1>
	<h1 align="center">( فى مجمع الأبرار )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> قائم بكل وقار<br />
    </h3></td>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1">  
	+  فى مجمع الأبرار<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> أبو فام الجندى<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> شهيد كريم مختار<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> بقلب طاهر ورحيم<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> + كوكب ظهر فى أوسيم<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> أبو فام الجندى<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فى طقس السيرافيم<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> حبيب الرب إيسوس<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> + هو ابن أنسطاسيوس<br />
    </h3></td>
