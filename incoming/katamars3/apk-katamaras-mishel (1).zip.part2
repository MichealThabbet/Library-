<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الملاك ميخائيل رئيس الملائكه-أضاءت المدن والوديان</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">ولاحت بواعث التهليل</h3></td>
    <td width="50%"><h3 align="center">أضاءت المدن والوديان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بمديح رئيس الملائكة ميخائيل</h3></td>
    <td><h3 align="center">وتبسم ثغر الإنسان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتعطر من الجو نسيمه العليل</h3></td>
    <td><h3 align="center">لبس الكون حلة الصفاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">في اوصاف الملاك الجليل</h3></td>
    <td><h3 align="center">وطلب الحمد وحلا الثناء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وغمره بوافر الأنعام </h3></td>
    <td><h3 align="center"> قربه الإله العزيز إليه </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ورفعه عليهم في المقام </h3></td>
    <td><h3 align="center">جعل الجند السماوي طوع يديه </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كجندي فاعتراه الفزع </h3></td>
    <td><h3 align="center">رآه يشوع ابن نون</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتولاه الخوف ودخله الجزع </h3></td>
    <td><h3 align="center">وقال ما عسي هذا أن يكون</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أ لخزلاني أتيت ام لنصرتي </h3></td>
    <td><h3 align="center">وخاطبه من أنت يا سيدي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ام لقهري وخسارة صفقتي</h3></td>
    <td><h3 align="center">أ أنت معيني ومساعدي </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">إني ناصرك على أعدائك</h3></td>
    <td><h3 align="center">قال إعلم العلم الوثيق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">واملكك أريح ا قبل مسائك </h3></td>
    <td><h3 align="center">أسلمك اليوم عماليق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">إلى أن تم الفوز المبين </h3></td>
    <td><h3 align="center">وأوقفت شمس ذات اليوم </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وملك ناصية المحاربين </h3></td>
    <td><h3 align="center">وتغلب إسرائيل على القوم </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">له في الشدائد أفضال</h3></td>
    <td><h3 align="center">هذا الملك الجليل ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ويشفيهم من المرض العضال</h3></td>
    <td><h3 align="center">يعزي الحزين ويقوى العليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الشهداء وأصحاب العزائم </h3></td>
    <td><h3 align="center">هو الأخذ بيد الأبطال </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">حين تنزل بهم العظائم </h3></td>
    <td><h3 align="center">هو بين الله وبينهم حلقة اتصال </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">صادفهما يوم عيده العسر</h3></td>
    <td><h3 align="center">دروتاؤس وزوجته تاؤبستا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وزال العسر وحل اليسر</h3></td>
    <td><h3 align="center">فظهرت لهم عجائب شتى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وكثيرا غيرهما من الخيرات </h3></td>
    <td><h3 align="center">امتلأ المنزل زيتا وقمحا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بما صنع من الآيات</h3></td>
    <td><h3 align="center">وكان العيد مسرورا وفرحا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ان يبيعا بعض ما امتلكا </h3></td>
    <td><h3 align="center">كان قصدهما عمل التذكار </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">قمحا وخروفا وسمكا </h3></td>
    <td><h3 align="center">لكنهما استدانا من التجار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ثمنها ثلثمائة دينار</h3></td>
    <td><h3 align="center">في السمكة وجد العجب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ببركة ذلك الملاك المختار </h3></td>
    <td><h3 align="center">وهذا كان فيه السبب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">العفيفة الكثيرة الصدقات </h3></td>
    <td><h3 align="center">ميخائيل خلص اوفومية </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وحضر إليها قبيل الممات</h3></td>
    <td><h3 align="center">وصد عنها المكائد الشيطانية </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لما له لديه من رفعة المقام</h3></td>
    <td><h3 align="center">اللهم اقبل شفاعته فينا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">اكرامًا لرئيس ملائكتك المقدام</h3></td>
    <td><h3 align="center">وإذا ناديناك تلبينا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تؤدي لك فيها العبادات</h3></td>
    <td><h3 align="center">وأدم كنائسه معمورة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتوزع انواع الصدقات </h3></td>
    <td><h3 align="center">وتقام الصلوات المبرورة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فتزول عنهم بقدرتك العلل</h3></td>
    <td><h3 align="center">فيها يلجأ سائر المرضي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ويبلغون من لدنك غاية الأمل </h3></td>
    <td><h3 align="center">ويفزون بعفوك والرضا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">احفظ البابا بطركنا هذا الزمان</h3></td>
    <td><h3 align="center">يا ربنا يا محيي النفوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ليعيشوا في راحة وأمان</h3></td>
    <td><h3 align="center">وكل مصاف الأكليروس</h3></td>
  </tr>
</table>
</body>
</html>
