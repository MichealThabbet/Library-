  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">تستر خطايا 
الصغار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى أرض الشقاء </h3></td>
    <td><h3 align="center">أنت عطية السماء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">لتسند 
الضعفاء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى ألمك كنت صابرًا </h3></td>
    <td><h3 align="center">فى مرضك كنت شاكرًا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">مسبحاُ القادر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تركتب عالمنا الفانى </h3></td>
    <td><h3 align="center">فى كيهك فى الثانى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">إلى أحضان 
الفادى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأنبا كيرلس أبينا </h3></td>
