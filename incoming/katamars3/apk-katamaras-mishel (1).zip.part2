<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
.auto-style1 {
	font-size: x-large;
}
.auto-style2 {
	direction: rtl;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style2"><div align="center">
      <h1 dir="rtl" align="center">الشهيد أباكراجون البتانونى</h1>
    </div>
	<div align="center">
        <p dir="rtl" align="center" class="auto-style1">مرد: الشهيد أباكراجون</p>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وأمدح حبيب يسوع</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>بعيون مليانة دموع</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong> + أنا أفتح فاى بخشوع</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ومنهم المصون</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>من بلدة البتانون</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + شهداء وقديسون</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لا يعرف رب الكون</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لص يعبد أبلون</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + كان شهيد البتانون</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وجدوه واقف سهران</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لسرقة أحد الرهبان</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + ذهب ومعاه لصان</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وقفوا يستمعوا إليه</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>والنعمة حالة عليه</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + رأوه رافع إيديه</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>سجدوا وهو يُناديهم</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>والقديس خرج إليهم</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + النعمة عملت فيهم</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>نالوا أول التيجان</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>والقديس بيهم فرحان</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + صاروا للمسيح رُهبان</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>في السماء سوف تعيش</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>بإكليل شهادة نفيس</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + تنبأ له القديس</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>مع كثرة قداسات</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وأصوام وميطانيات</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + أتعب نفسه بصلوات </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ودع أبيه ِبثبات</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ظهرت الإضطهادات</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + بعد ستة سنوات </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أمام الوالى أمونيوس</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>واعترف بالقدوس</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + ذهب إلى نقيوس</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ونظر إلى السموات</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لم يجزع من الآلامات</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + عذبه الوالى عذابات  </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>إيمانه بالمسيحية</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وكتبوا القضية</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + أرسلوه إلى الإسكندرية</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>فصاروا يضربوه</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong> وملاك الله حله</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + فى صارى مركب ربطوه</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أنقذه ملاك ربه</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وفى البحر طرحوه</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + فى جوال جلد رموه</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>إلهك حى موجود</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ولا ترهب أى جنود</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + قال له اذهب لسمنود </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>آمنوا برب القوات</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ابنة الوزير بثبات</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + أقام من الأموات </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لم يرهبه الأبطال</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أمر بقتلهم فى الحال</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + صار الوالى فى ضلال</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أزال الله كل خوف</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وما همّهم السيوف</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + وقف الشهداء صفوف</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>رغم الآلم الشديد</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وكأنه فى فرحة وعيد</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + وصل الإسكندرية الشهيد</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>ونال إكليل فاخر</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>كان المسيح ناظر</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + قطعوا رأس الطاهر </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>قال له خذ جسد البار</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>لقس منوف المختار</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + ظهر الملاك إجهار</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>على جسده المصون</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong> بنوا كنيسة بالبتانون</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + أخذه والمؤمنون</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>بالفرح قلوبنا تطيب</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>تذكار شهادة الحبيب</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + خمسة وعشرون أبيب</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>اظهر لنا جسدك</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>وسعى لبركتك</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + شعب البتانون أحبك  </strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>احفظ البابا شنودة</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أمام رب الجودة</strong></h3>
    </div></td>
    <td width="33%" class="auto-style2"><div align="center">
      <h3><strong> + بشفاعتك المشهودة</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td width="33%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>أنبا بنيامين حبيبك</strong></h3>
    </div></td>
    <td width="34%" class="auto-style2"><div align="center">
      <h3 class="auto-style2"><strong>مَنْ جلسَ في يوم عيدك</strong></h3>
