  <tr>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  المسيح الي ارض مصر</span></font></h3></td>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">في يوم تذكار دخول </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كان يوم استشهاد بتول  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  في طقسه عريف</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قديس عظيم وشريف</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">في السيرة كان عفيف  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وفي الدنيا أسماك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">من البطن دعاك   </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بشنونه قس وملاك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">    تسكن في ديره معاه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ناداك أبو مقار</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فكنت له ابنا بوقار</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كلك جلال وحبور</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كنت كاهن وقور</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">علي ايمانك غيور </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">      انتخبوك للكهنوت</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">سيرتك كانت غالية </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">خدمت الاسرار العالية </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">      فصرت كاهن جليل</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">مشيت بتعاليم الانجيل</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">تعلم في كل جيل</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> في مصر القديمة بالذات</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">في خدمة القداسات </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   بنيوت آفا بشنونه</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">حرقوك وجسدك مات</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">        في أبي سرجة الأمين</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شالوك المؤمنين  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">دفنوك في ذاك الحين  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  عرفت طريق الله</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">يا راهب وناسك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">دايما في ايديه ماسك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   تنكر من مات عنك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">عرضوا الأشرار عليك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">خليته جوه عينيك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  وحياتي من عنده</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">في الارض أنا عايش بيه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">تخلص فاتح لي ايديه </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ونلت هنا اكليلك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">أكملت هنا جهادك  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">      بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">أشفع في أولادك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   كل أيام غربتنا</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">صل لنا نعيش وياه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">    بنيوت آفا بشنونه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">علشان نفرح في سماه </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">      في مارجرجس فم الخليج</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="FONT-WEIGHT: 700">أمير الشهداء ناداك</span></font></h3>    </td>
  </tr>
  <tr>
