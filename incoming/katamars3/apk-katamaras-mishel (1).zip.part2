<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد تادرس الشطبى الأمير-أنا أفتح فاي وأصيح</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">وانده واقول يا تاودروس</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">انا افتح فاى و اصيح</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">نى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">السلام لشهيد المسيح</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">محمى باسم القدوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">مشهور بين الوزراء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">مسيحى بين الامراء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">نى اسؤاب تاوضروس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">اسم ابيه يوانس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">اصله من بيت امراء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">نى اسؤاب تادروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">بلده شطب الحمرا</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"></span><span lang="AR-SA" xml:lang="AR-SA">من القصعة للكربوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">مركوبه سرج ذهب</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"></span><span lang="AR-SA" xml:lang="AR-SA">نى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">وحصانه احمر اشهب</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">من مدينة اوخيتوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">جاءت له امراة تشتكى</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">يا امير تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">وقالت له ارحمنى</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">سالت يا استاذى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">باسم الرب القدوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">يا امير تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">تخلص لى اولادى</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">للتنين المنجوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">اخذوا اولادى منى</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">يا امير تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">اسالك تنقذنى</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">شفق قلبه عليها</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">لما سمعها القديس</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">و خلص ولديها</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">قتل التنين ابليس</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">لدقلديانوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">شكا كل الكهنة</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-SA" xml:lang="AR-SA">قتله تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">وقالوا عظيم الالهة</span><span lang="AR-EG" xml:lang="AR-EG">  </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">فارسل ساعى مخصوص</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">غضب دقلديانوس</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"></span><span lang="AR-SA" xml:lang="AR-SA">بى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">فحضر عنده القديس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">انتى تى ميت مارتيروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">نزل وسط الميدان</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">بى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">واهلك عباد الاوثان</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ودقلديانوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">تلطف به الامراء</span> </b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">فلم يرضى تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">واعطوه شيئا بكثرة</span><span lang="AR-EG" xml:lang="AR-EG">   </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">واعترف باسم القدوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">رما سلاحه فى الحضرة</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">بى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">انا مسيحي يا كفرة</span><span lang="AR-EG" xml:lang="AR-EG"> </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">باسم الرب القدوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">اخيرا اخذوا راسه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">بى اسؤاب تاودروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">وانقهر جلاسه</span><span lang="AR-EG" xml:lang="AR-EG">   </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">باكليل مخصوص</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">يسوع المسيح جاله</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">أكسيوس أكسيوس أكسيوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">والملائكة بتهلل له</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">ابن يوحنا الشطبى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">السلام لتاودروس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"></span><span lang="AR-SA" xml:lang="AR-SA">ابشوشوانى مارتيروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">السلام لتاودروس</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> </span><span lang="AR-SA" xml:lang="AR-SA">كل المؤمنين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">تفسير اسمك فى افواة</span><span lang="AR-EG" xml:lang="AR-EG"></span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"></span><span lang="AR-SA" xml:lang="AR-SA">تاودروس اعنا اجمعين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">الكل يقولون يا اله</span><span lang="AR-EG" xml:lang="AR-EG">  </span></b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK��x�4␀␀4␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/c10.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا توماس السائح</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وأصيح بلسان فصيح</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> أفتح فاى 
        بالتسبيح</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك ياأنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> السلام لك والمديح</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> من قرية شنشيف</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  قديس من بيت شريف</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك ياأنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> ليس لك مثيل</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تركت البشرية</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  بقوه إلهيه</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك ياأنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> وسكنت البريه </b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> الي برية شنشيف</span></h3></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">تركت 
        العالم وجيت</span></b><span lang="AR-EG" xml:lang="AR-EG"><b><br />
        </b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك با أنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> والمجد أشتهيت</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> للصوم والصلاة</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  كنت محبًا للإله</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك يا أنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> بخوفه وبرضاه</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> كنت بالروح مستشير</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  يا كوكب مشرق ومنير</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك يا انبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> سائح ومالكش نظير</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> لاقتدائك الكريم</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  طوباك يا أبن بولا العظيم</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك يا أنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> وعلى طقس مستيقم</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وهزمت بالايمان</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  أمنت بالديان</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك يا أنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> حصون وفخاخ الشيطان</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> ذادك مراد القدوس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  لمحبتك للإله إيسوس</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السلام لك يا أنبا توماس</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> تحيطه نى أنجيليوس</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> الانبا اغاثون اسقفنا</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>  البابا شنوده بطركنا</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> يا رب احفظهم لنا</span></h3></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b> وأساقفنا ورهبانا</b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><h3 class="MsoNormal" dir="rtl" style="text-align:center" align="center"> <b><span lang="AR-EG" xml:lang="AR-EG">بصلاة الانبا توماس</span></b></h3></td>
  </tr>
</table>
</body>
</html>
PK7=T�\␀␀\␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/c2.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد تادرس الشطبى الأمير-أبدأ باسم الديان</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><b> راعى نفوس 
        الحنان</b></h3>    </td>
    <td width="50%"><h3 align="center"><b>أبدأ بأسم الديان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى الأمير تادرس</b></h3>    </td>
    <td><h3 align="center"><b>الآن و كل أوان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>كيما نغلب 
        أبليس </b></h3>    </td>
    <td><h3 align="center"><b>سيرة أبينا القديس</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>سيدى الأمير 
        تادرس </b></h3>    </td>
    <td><h3 align="center"><b>نلقى ابانا القديس</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>مصرى 
        ورومانية</b></h3>    </td>
    <td><h3 align="center"><b>ولد فى آخائية من</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى الأمير 
        تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>يوأنس و أوسانية</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> من أصل غنى 
        مبسوط </b></h3>    </td>
    <td><h3 align="center"><b>من شطب فى أسيوط</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>سيدى 
        الأمير تادرس</b></h3>    </td>
    <td><h3 align="center"><b>يوأنس أبو المغبوط</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>ديانتها 
        ... وثنية</b></h3>    </td>
    <td><h3 align="center"><b>و أوسانية رومانية</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>سيدى الأمير 
        تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>بتعادى المسيحية </b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> خلافاتها 
        نار بتقيد </b></h3>    </td>
    <td><h3 align="center"><b>يوم ورا يوم بتزيد </b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى 
        الأمير تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>إنذار تهديد ووعيد</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> حاول قدر 
        الإمكان</b></h3>    </td>
    <td><h3 align="center"><b>أرشدها للإيمان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى الأمير 
        تادرس </b></h3>    </td>
    <td><h3 align="center"><b>كى تترك الأوثان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> يا عبد 
        شقى مأسور </b></h3>    </td>
    <td><h3 align="center"><b>قاومت بعناد و غرور</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى 
        الأمير تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>هاتعيش و تموت مغمور </b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> تشاركنى 
        إيمانى </b></h3>    </td>
    <td><h3 align="center"><b>لو ترضى بأوثانى</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى الأمير 
        تادرس </b></h3>    </td>
    <td><h3 align="center"><b>أعطيك كل كيانى</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>لم يخضع 
        للشيطان </b></h3>    </td>
    <td><h3 align="center"><b>و لأنه قوى الأيمان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b> سيدى 
        الأمير تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>لأوسانية لا إذعان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>و ملاك 
        مهيب و جليل</b></h3>    </td>
    <td><h3 align="center"><b>شاف رؤيا و حلم جميل</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>سيدى 
        الأمير تادرس  </b></h3>    </td>
    <td><h3 align="center"><b>عزاه بصوت التهليل </b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><b>أترك 
        للرب فتاك </b></h3>    </td>
