<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهديان كيرياكوس و يوليطة أمة-أبدأ باسم الإله القدوس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> مخلصنا محيي النفوس</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ابدا باسم الاله القدوس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">و امدح هذا البطل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">اهدى للبطل سلامى</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ابدا كلامى و نظامى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">واقول بفمى ولسانى  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بالانتصار و اخزى اعدائك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">جاهد فى مجد الهك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الشياطين تدوسهم باقدامك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> وامه يوايطة الاصل النفيس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">حقا نطوب هذا الطفل القديس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ونصيح جميعا بالتطقيس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وساروا بالقدرة الالهية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">خرج مع امه من ايقونة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الى مدينة طرسوس عقدوا النية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ممجدين ليسوع المسيح البار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">دخلوا المدينة باستبشار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام للشهيد كيرياكوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فحسدهم الاعداء الكفار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">سالهم عن معتقداتهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">دهش الوالى لما راهم   </span></font></h3>
