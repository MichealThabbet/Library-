<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهداء يسطس وأبالى وثاؤكليا</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الأبرار المجاهدين<br />
    </span></strong></h3></td>
    <td width="50%"><h3 align="center">  السلام للقديسين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فى الفردوس فرحين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">نوماريوس كان أبوك<br />
    </span></strong></h3></td>
    <td><h3 align="center">  يسطس ابن الملوك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> لملك روما دعوك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وهبه رب الأبرار<br />
    </span></strong></h3></td>
    <td><h3 align="center">  يسطس الرجل البار <br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> أبالى ابنه المختار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كانت امرأة تقية<br />
    </span></strong></h3></td>
    <td><h3 align="center">  زوجته ثاؤكليا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> أحبت البشرية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بعد طول الدرب<br />
    </span></strong></h3></td>
    <td><h3 align="center">  لما عاد من الحرب<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وجد فى القصر كرب<br />
    </h3></td>
  </tr>
  <tr>
