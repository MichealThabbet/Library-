<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد تادرس المشرقى-أبدي باسم الله الغفار</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b>المحيي كل النفوس</b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b>المجد لله القدوس</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><div align="center">
      <h3><b>والمديح لشهيد إيسوس</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <b>من أب وزير مشهور</b></h3></td>
    <td><h3 align="center"> <b>وُلِدَ فى مدينة صور</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"> <b>وأم عفيفة طهور</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>فنشأ فى بيت أمين</b></h3></td>
    <td><h3 align="center"><b>أبواه كانا مسيحيين</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>عرف الإيمان بيقين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>انتظم فى الجندية</b></h3></td>
    <td><h3 align="center"><b>بإرادة وعزم قوية</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>واستحق الترقية</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>ولثوب الشجاعة لابس</b></h3></td>
    <td><h3 align="center"><b>رآه الملك فارس</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>جعله للحدود حارس</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>فأتاك الملاك ميخائيل</b></h3></td>
    <td><h3 align="center"><b>جئت للبيعة يا نبيل</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>أعطاك سيف التهليل</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>للنصرة على كل أعداك</b></h3></td>
    <td><h3 align="center"><b>السيف ربك أعطاك</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>الله قد اختارك</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>كيعقوب الطوبانى</b></h3></td>
    <td><h3 align="center"><b>شاهدت سلم نورانى</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>عليه الابن الوحدانى</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>والرهبة قد حلت</b></h3></td>
    <td><h3 align="center"><b>ضجة عظيمة حدثت</b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام للأمير تادرس</h3>
    </div></td>
    <td><h3 align="center"><b>قوة البربر انحلت</b></h3></td>
  </tr>
  <tr>
