<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا بولا أول السواح-يا أنبا بولا</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> يا اول السواح</span></font></h3>    </td>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا انبا بولا   </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  بتنور كالمصباح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا قديس وبار</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  جيت هنا بسماح </span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سيرتك نقية</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وقلبك بيه ارتاح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">من رب القوات</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  ولا بصيت وراك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سيبت العالم كله  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  بالرب اللى فداك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وقلبك كان مشغول</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  دا يسوع هو اللى هداك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">مين زيك يا حبيب </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  وحدك ولا حد معاك</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تسكن ده المكان</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> مع كل غروب غراب</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رب القدرة يامر</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لا اتاخر يوم ولا غاب</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">معاه نصف خبزة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  تحتار فيه الالباب</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ده امر غريب وعجيب</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لا ده رب الارباب</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طير بيعول انسان </span></font></h3>    </td>
  </tr>
  <tr >
    <td colspan="2" ><h3 align="center" ><font color="red">قرار</font> </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  يا حبيب المسيح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طوباك يا انبا بولا</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وجهك حلو ومريح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا ضياء منير</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> تشفى القلب الجريح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">صلواتك بلسم </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> من كل كلام فصيح</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وصمتك اقوى </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والمال كان عنده كثير</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لما مات ابوه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وقال له انت صغير</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طمع فيه اخوه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ونصيبى انا الكبير</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">نصيبك يبقى قليل </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> اللى لازم تصير</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">هى دى القسمة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> من اللى ظلموه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">حب ينصفوه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> يحكم ما بينه و بينه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">قام راح للقاضى</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">جنازة وناس يبكوه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">قابل فى السكة</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وساب ماله لاخوه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">رجع فى رايه</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">علشان نتمسك بيه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">العالم فيه ايه </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> والعين ما تشبع به</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الكل باطل باطل</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> نفسك طمعانة فيه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">بتجرى ورا ايه  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> تبقى تدوم ليه</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">ان دامت لحد </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  لو ربحت العالم</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">انا ايه ينفعنى</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> واعيش فى خصام</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">واخسر نفسى</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> اغرت ابونا آدم</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الحية زمان</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> ويعيش فى ظلام</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وخليته يقع </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">واهدى سبيلى</span></font></h3>    </td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا رب ارشدنى </span></font></h3>    </td>
  </tr>
  <tr>
