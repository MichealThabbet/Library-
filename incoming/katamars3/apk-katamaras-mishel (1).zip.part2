  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >فاسمعى صلواتهم 
        والدعاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >طالبين فيك 
        نصرة قوية</h3></td>
    <td><h3 align="center" >والشعب وكل 
        الرعية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >على الأعداء 
        ظاهرة وخفية</h3></td>
  </tr>
