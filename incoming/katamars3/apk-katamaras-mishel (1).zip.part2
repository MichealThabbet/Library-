  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">كأليشع فى جيله </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">إلى دير مارمينا </h3></td>
