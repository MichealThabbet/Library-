  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> اناديلك باستمرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> فى كثير من الأخطار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> تخلصنى من الأشرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> بمار جرجس حبيبنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> تتهلل قلوبنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> شفيع كنيستنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ده أصله سره عجيب</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> لكل أمر مجيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> بينتشر مثل الطيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> سيدى الأمير جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  أحب الملك دقلديانوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> أعطاه حصانه النفيس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وبيسحق التنين برجليه</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  الحربة ماسكها بايديه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وحصانه كمان ماشى عليه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وخدنا بنصر أمجادك</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  اسندنا بصلاتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> لنشوف نهاية آلامك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وشهدت لمسيحيتنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  رفعت منارة كنيستنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> مع من خارج ايماننا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> يخلصهم من الأخطار</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> يظهر فى البيعة للحضار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> بنشوفه فى كفر الدوار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> لكنها ذهبية</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  لابس خوذه نحاسية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> مرسوم عليها الأبدية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> برسالة من عمانوئيل</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  جاءه الملاك ميخائيل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ملأ قلبه بالتهليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> بنور قوى يفرّح النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  ظهر له الرب القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" dir="rtl" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس....</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> انا معك للفردوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> رشمت صليبى نجانى يسوع</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  شربونى سما قدام الجموع</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> فصرخ الساحر بدموع</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ففرحت نفسى وكدت أطير</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  البسونى حذاء بالمسامير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وكأنى ماشى على حرير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> نزفت دمائى كالمطر</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  جلدونى بأعصاب البقر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> نجانى الهى من الخطر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> لقيت نفسى جوه الجير</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  نزلونى فى جرن البير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> خلصنى الهى من الشرير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> قالوا اكيد راح ينام</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  تركونى فيه ثلاثة أيام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> لكن الهى رب الأنام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> مكانته كبيرة عند ايسوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> القديس جورجيوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشويس.......</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> أصله بيحب بخرستوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> تفسير اسمك فى أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> الرومانى أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> الكل يقول يإله مارجرجس</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK!���.v␀␀.v␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/s1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد نيقام</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3> و غفرت آثام الشعب</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>  على أرضك يا رب رضيت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> و قبلت توبة نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> ورجعت عن الغضب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> في بيت كله تقديس</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  نشأت يا قديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> لكن ضربك إبليس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> قد أعلنت بإقرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  أمام الناس الأشرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> لدينا الأفكار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> حاول دون توقف</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  و خالك الأسقف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> إرشادك بتعطف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> عنه تحويل قلبك</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  جحدت يسوع ربك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> مُبتعدًا بحبك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> و سيرتك لينا مثال</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  شابهت الابن الضال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> للتوبة و الكمال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> على قلب من مثلك</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  الرب يسوع ربك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يا قديس يا شهيد نيقام</span></h3>
    </div></td>
    <td><div align="center">
      <h3> فندمت على حالك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> آليثوس أنيستي</span></h3>
    </div></td>
    <td><div align="center">
      <h3>  إخريستوس أنيستي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
