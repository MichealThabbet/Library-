<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس البابا كيرلس السادس-في كنيسة القديسين</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> قائم خادم و أمين</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">في 
        كنيسة القديسين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و شفيع في البتوليين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> مارمينا له مؤازر</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">   صغير أسمه عازر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بإيمانه أسد جاسر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يسهر الليل لا ينام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  كبر عازر و كان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يَذكر رب الأنام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> قاصد طريق الملكوت</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رحل يومًا إلى الدير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بصلاة ودموع و سجود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و تراث و إيمان الجدود</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قام بدراسة اللاهوت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> من أجل الرب إيسوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بصلاة دائمة حلوة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و عاش حياة الخلوة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وهبهُ السيد القوة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> رمم ديره ونشاه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أنبا صموئيل دعاه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و إقامة فيه الصلاة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في مصر القديمة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بنى بيعة لمارمينا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عرفنا بأعاجيبه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عاش كسائح غريب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  لم يطلب من العالم شئ </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بمعونة ربه الحبيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كخليفة لمارمرقس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رشحه أنبا أثناسيوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أختاره الروح القدس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و بابا فضل راهب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> راهب أصبح بابا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كان للملكوت طالب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> مارمرقس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رجع جسد الكاروز</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> على الأكتاف مَحمول</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> مكان من الآثار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  لدير العجايبي اختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> صار في الصحراء منار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ظَهرت بصيت مَشهور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في عهده أم النور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وهبت الحزانى سرور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> طَحنه بنفسه في الهون</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أيضًا عمل الميرون</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و استحق أن نقول</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> حَفظها لأولاده</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  كانت التسبحة زاده</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> باركهم بصلواته</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كان يلجأ للقديسين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و كل ضعيف و مريض</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يرجع سعيد و سليم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عمر الإنسان أشبار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و عند نياحته قال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بخار سريع الزوال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قال إنه لا ينساهم</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> دعى أولاده و أوصاهم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و للملكوت سافر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> قد أعطيتنا حياتك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  نحن هنا أولادك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنيوت أفا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فاذكرنا في صلاتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  البابا كيرلس أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3> آكسيوس..آكسيوس..آكسيوس</h3>
    </div>      <div align="center"></div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3><span style="font-weight: 700"> أفا كيرلس بي باتريرشيس</span></h3>
    </div>      <div align="center"></div></td>
  </tr>
</table>
</body>
</html>
PK��3�ID␀␀ID␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/q1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس لعازر حبيب الرب</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>السلام لحبيب مخلصنا</h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>السلام لحبيب إلهنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومريم ومرثا فى بيت عنيا</h3>
    </div></td>
    <td><div align="center">
      <h3>لعازر القديس حبيبنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وبحب يسوع مفتونة</h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لمريم المحبوبة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وبقوة يسوع مصونة</h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لمرثا المبروكة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأيضًا تلاميذ بخرستوس</h3>
    </div></td>
    <td><div align="center">
      <h3> فى بيت عنيا حل إيسوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وخلاص آدم وكل النفوس</h3>
    </div></td>
    <td><div align="center">
      <h3>كلمهم الرب عن الفردوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أرلست أختاه لإسيوس</h3>
    </div></td>
    <td><div align="center">
      <h3> مرض لعازر بذيكاؤوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>تعال إشفيه يا مُحيى النفوس</h3>
    </div></td>
    <td><div align="center">
      <h3>لعازر حبيبك يا قدوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لكن ليتمجد رب الصباؤوت</h3>
    </div></td>
    <td><div align="center">
      <h3> هذا المرض ليس للموت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والرب أحياه بالصوت</h3>
    </div></td>
    <td><div align="center">
      <h3>لعازر مات بثبوت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مكث لعازر المبرور</h3>
    </div></td>
    <td><div align="center">
      <h3> أربعة ايام فى القبور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أمام القبر فى حزن وقور</h3>
    </div></td>
    <td><div align="center">
      <h3>ومرثا ومريم والجمهور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومريم تبكى وتنوح</h3>
    </div></td>
    <td><div align="center">
      <h3> يسوع انزعج بالروح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويسوع يصرخ بصوت مسموع</h3>
    </div></td>
    <td><div align="center">
      <h3>ورائحة الموت تفوح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>خرج الميت قائمًا</h3>
    </div></td>
    <td><div align="center">
      <h3> لعازر هَلُمَّ خارجًا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والكل صار مؤمنًا</h3>
    </div></td>
    <td><div align="center">
      <h3>كأنه إنسانًا مسافرًا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>جاء يسوع بسلام</h3>
    </div></td>
    <td><div align="center">
      <h3> قبل الفصح بستة أيام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويسوع يمدح مريام</h3>
    </div></td>
    <td><div align="center">
      <h3>عند لعازر ومرثا ومريام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومسحت رجلى الحبيب</h3>
    </div></td>
    <td><div align="center">
      <h3> مريم دهنت بالطيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والرب ينظر ويجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>ومرثا تخدم بحب عجيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>دهنت الطيب باهتمام</h3>
    </div></td>
    <td><div align="center">
      <h3> لا تعنفوها يا أقوام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قبل موتى بأيام</h3>
    </div></td>
    <td><div align="center">
      <h3>ليوم تكفينى تمام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومريم ومرثا بالتهليل</h3>
    </div></td>
    <td><div align="center">
      <h3> طوباك يا لعازر يا جليل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نذكرها بكل تبجيل</h3>
    </div></td>
    <td><div align="center">
      <h3>أسماؤكم محفوظة فى الإنجيل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قام حقًا بدون تأويل</h3>
    </div></td>
    <td><div align="center">
      <h3> فى عيد قيامة عمانوئيل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومريم ومرثا بحب جليل</h3>
    </div></td>
    <td><div align="center">
      <h3>نذكر لعازر بتهليل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كل المؤمنين</h3>
    </div></td>
    <td><div align="center">
      <h3>تسبيح اسمك فى أفواه </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لعازر ومريم أعنَّا أجمعين</h3>
    </div></td>
    <td><div align="center">
      <h3>الكل يقولون يا إله</h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�d�7!␀␀!␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/q2.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس لوقا الإنجيلي والرسول</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">الذى لاعين تراه </span></b></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ابدا باسم الاله </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وامدح رسول مولاه </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> هذا الرجل ذو الجود </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فى انطاكية مولود 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">عبد الرب الودود 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بقلبه كل حياته </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">تبع الرب الهه 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">حتى اكمل جهاده </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وبطرس كان صديقه </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بولس هو رفيقه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
