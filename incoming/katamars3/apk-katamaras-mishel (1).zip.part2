    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> قوي ومتين وشفيع</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> عظيمة وقوية</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">شفنالك معجزات</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center"><b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">هبة من رب القوات</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> حياتك سمائية</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">قلبك نقي وطاهر</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> زهدك عظيم وباهر</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">  بصبر وحب شديد</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">ذقت آللآم وتعذيب</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> وأهانة بدون تأنيب</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> كان فكرك في السماء</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">متعبدش بدون تأنيب</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> بصبر وسلام وهناء</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> في منطقة كبيرة</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">إسمك أصبح مشهور</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> فيها صلاة وبخور</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> لجهادك النبيل</span></b></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> أعطيت الاكاليل</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">  بالفرح والتهليل</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> في حياتك ونياحتك</span></b></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> العذراء كانت جنبك</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> دي شفاعتك وحبيبتي</span></b></h3>    </td>
  </tr>
</table>
</body>
