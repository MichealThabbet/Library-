<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس أبونا عبد المسيح المنهري-نياحتك خدتنا يا شيخ كهنتنا</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b>وف الخلد ضمَك عبير الخضار</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b>نياحتك خدتنا يا شيخ كهنتنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> <b>يا ابونا عبد المسيح مقار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3> <b>دف اسكندرية الدموع بللتنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><font size="5"><span lang="AR-SA" xml:lang="AR-SA">يا فرحان بخلدك وناسى البري</span>َّ<span lang="AR-SA" xml:lang="AR-SA">ة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>يا شيخنا الجليل يا حبيب المسيَا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>أفانا ديمتريوس حبيب الديار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>يا عمَ النيافة النبيلة النديَة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>ملاك كنيستنا واسمه بيجول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>واخوه الصغيرَ ف ألمانيا كاهن</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>يا ابونا الموقَر يا أصل الأصول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بيخدم فى مهجر وف قلوبنا ساكن</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وكيل الشريعة وكان له طقوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>وابوك هوَ ابونا مقار فلتاؤوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وعاش ف ابو تيج للصغار والكبار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>ف دير الجنادلة عطانا الدروس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>رحلت لخلودك وح افضل أقول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>يا ابونا الموقر يا صوت الاله</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وتمَ انطلاقك ف ظلَ البتول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>حبيب الكنيسة ناديتله ف سماه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>عجوز بسَ كفَك على الصعب يقدر</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>حياتك قضيتها ف تسعين وأكتر</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وفرحت قلوبنا بخلدك يا بار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>حزننا لرحيلك يا عودنا المخضَر</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>ومنهم كنيسة شهيدنا العظيم</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>خدمت الكنايس وف اسكندريَة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وساحة دروسك ف ديرنا الحميم</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>وديرنا المحرَق ف لكليريكيَة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>تلامذة دروسك وصبحم فلاسفة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>كتير م المطارنة كتير م الأساقفة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>د جالنا بمشيئة صنيع النهار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>وجودك ف ديرنا ما جاش لينا صدفة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وصلى عشانك يا خلَ المسيح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>بابانا شنودة حزن يوم نياحتك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وابونا الباخومى الوكيل الصريح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>ولمَ المطارنة وأساقفة كنيستك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>وكلَ التعازى لكنيسة الودود</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>سلام ليك يا غالى ف ظلَ الخلود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b>ونصبح جيرانك ف دار العمار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b>ياريت نبقى زيَك وننسى الوجود</span></b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK%��␀␀␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/m1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الملاك غبريال رئيس الملائكة-السلام لك يا غبرييل</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">      
      <h3>القائم بكل 
        إجلال أمام رب القوات    </h3>
    </div></td>
    <td width="50%"><div align="center">      
      <h3>السلام لك يا 
        غبرييل يا رئيس جند السموات    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> عظيمة شفاعتك دائمه فى كل الأوقات    </h3>
    </div></td>
    <td><div align="center">      
      <h3> الثانى فى ترتيبك بين رتب السموات    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> قائم أمام عمانوئيل تبشر بإبن الله    </h3>
    </div></td>
    <td><div align="center">      
      <h3> إسمك يا غبرييل تفسيره قوة الله    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> حول خائفيه ينجيهم من الأهوال    </h3>
    </div></td>
    <td><div align="center">      
      <h3> يقول داود بالروح ملاك الله حال    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> و فى 13 بؤونه نعيد لك فرحين    </h3>
    </div></td>
    <td><div align="center">      
      <h3> فى ثلاثين برمهات تذكار ثمين    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> عن مخلص الأجيال تقوى فيه الروح    </h3>
    </div></td>
    <td><div align="center">      
      <h3> ظهرت لدانيال تعلن له بوضوح    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> مفرح بالرؤيا و أليصابات إمرأته    </h3>
    </div></td>
    <td><div align="center">      
      <h3> و أيضًا ذكريا بيوحنا بشرته    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> من رابع شهورنا نعيد مسرورين    </h3>
    </div></td>
    <td><div align="center">      
      <h3> تذكارك فى قلوبنا فى الثانى و العشرين    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> إلى مريم العذراء بميلاد مخلصنا    </h3>
    </div></td>
    <td><div align="center">      
      <h3> حملت البشاره من الرب إلهنا    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> بميلاد إبن الله المخلص الأمين    </h3>
    </div></td>
    <td><div align="center">      
      <h3> بشرت الرعاه بفرح ثمين    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> و بالناس المسره فتبدد السلام    </h3>
    </div></td>
    <td><div align="center">      
      <h3> المجد لله فى الأعالى و على الأرض السلام    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> مع أمه العذراء فى لفافه مقمطاَ    </h3>
    </div></td>
    <td><div align="center">      
      <h3> تجدون طفلًا فى مذود مضطجعًا    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> نشكرك يا ملاكنا فى مثل هذا العيد    </h3>
    </div></td>
    <td><div align="center">      
      <h3> بميلاد مخلصنا ادم أصبح سعيد    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> بتكريس أول بيعه فى جبل النقلون    </h3>
    </div></td>
    <td><div align="center">      
      <h3> السلام لغبريال صاحب بشره مجيده    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> إلى كل الأجيال محبوبه و فريده    </h3>
    </div></td>
    <td><div align="center">      
      <h3> فى 26 بؤونه يعيد لك المؤمنين    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> و يسأل بالصلوات عن كل الأجناس    </h3>
    </div></td>
    <td><div align="center">      
      <h3> قريب فى الضيقات يطلب من أجل الناس    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> صلواتنا و طلبتنا تصعدها بكل سرور    </h3>
    </div></td>
    <td><div align="center">      
      <h3> يا كائن روحانى ملتحفًا بالنور    </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3> الكل يقولون يا ملاك غبريال أعنا أجمعين    </h3>
    </div></td>
    <td><div align="center">      
      <h3> تفسير أسمك فى أفواه كل المؤمنين    </h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�MhO␀␀O␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/m2.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الملاك غبريال رئيس الملائكه-عظيمة كرامتك</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700"> يا ملاك غبريال</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700">عظيمة كرامتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> قائم بكل اجلال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في مجد الله 
        القوي </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تنادي بالتسبيح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">واقف امام 
        الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> السيد المسيح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">قدوس قدوس 
        قدوس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">عظيم هذا العيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">سرورنا 
        تذكارك </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  لكنك لست بعيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في السماء 
        مكانك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تطلب من اجل الناس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">قريب في 
        الضيقات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">عن كل الاجناس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وتسال 
        بالصلوات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> لك محبة عميقة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في قلوبنا 
        المتواضعة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">عن كل الخليقة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تتشفع 
        دائما</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> في الليل والنهار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">امام الله 
        القدوس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">والثمر والانهار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تصلي عن 
        الزروع  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">مع كل السمائيين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تفرح برجوع 
        الخاطي </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بارا غير محتاجين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اكثر من تسعة 
        وتسعين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">من مكائد الشيطان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">للتوبة 
        والخلاص</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بعيد عن الاحزان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">والعودة الي 
        الله </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> ملاك الله حال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ولسان داود 
        يقول </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">لنا وهم من الاهوال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">حول كل 
        خائفيه  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تعلن ارادة الله</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">روحك 
        الخادمة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">عنهم الصلاة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">للمؤمنين 
        وترفع </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> اجنحتك فيها بخور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">يا طائر 
        روحاني </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> تصعدها بلا فتور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">صلواتنا 
        وطلبتنا </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تعلن له بوضوح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ظهرت 
        لدانيال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وتشجع فيه الروح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تشرح له 
        الرؤية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">بيوحنا بشرته</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وزكريا 
        الكاهن </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> ومعه امراته</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ففرح 
        بالرؤية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ببشري خلاصنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ظهرت 
        للرعاه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">ونزوله لارضنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تجسد ابن 
        الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وعلي الارض السلام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في الاعالي مجد 
        الله </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> واختفاء الظلام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بالناس 
        المسرة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">   الي مريم العذراء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وحملت 
        البشارة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">  كما قال الانبياء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بها قد تم 
        الخلاص </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> وبروحه القدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تانس منها 
        الله </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> لخلاص كل النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">قد تم 
        التجسد  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">آدم اصبح سعيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بميلاد 
        المخلص </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في مثل هذا العيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">نذكرك يا 
        مبشر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">في الثامن والعشرين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تذكارك في 
        قلوبنا </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> نعيد مسرورين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">من رابع 
        الشهور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG"> بالبشري كلمنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">اذكرنا امام 
        الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">بالسلام علمنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">وكيف 
        نبشر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-EG" xml:lang="AR-EG">تفسير اسمك في 
        افواه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> الملاك غبريال اعنااجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">الكل 
        يقولون يا اله</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK��2P;␀␀P;␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/m3.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الملاك غبريال رئيس الملائكه-السلام لك يا غبريال</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">يا عظيم جند السموات</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام لك يا غبريال </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خادم رب القوات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ملاك السلام والبهجات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شرفك بأعلي الدرجات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ألبسك حلة وأكليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفسيره حامل البشارات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وسماك غبريال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بميلاد المعمدان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشرت زكريا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يبخر للديان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عندما كان في الهيكل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشرت أم النور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بعد ذلك بشهور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتجسد غير المنظور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بميلاد عمانوئيل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليوسف البار الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جئت لعذراء مخطوبة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من بيت داود العظيم</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عذراء اسمها مريم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بكل وقار وجلال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> اعطيتها التحية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نلت النعمة بكمال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا مريم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا مطوبة من الأجيال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قلت لها لا تخافي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> اسمه ابن المتعال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تلدين ابنا قدير </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشرت العراة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبصوتك الجليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مخلص كل الخطاة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بميلاد عمانوئيل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشرور وبكل حماس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صاحت الملائكة معاك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والسرور لكل الناس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> المجد لله في الأعالي </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> <span style="mso-spacerun:yes"> </span>كل المؤمنين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غبريال أعنا أجمعين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK���~%␀␀~%␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/m4.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس غريغوريوس العجائبي</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> وأمدح من قلبي</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ابدأ باسم الله ربي </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>القديس غريغوريوس</h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">قديسا ليشفع لي  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> من عائلة وثنية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مولود في قيصرية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>القديس غريغوريوس</h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بالغني مسبية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> الحكمة وتسلم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">منذ صغره تعلم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>القديس غريغوريوس</h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الفلسفة والتكلم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   من اترابه هذا الثمين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">حتي فاق كثيرين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>القديس غريغوريوس</h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ومضي الي بيروت بيقين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ومضي بحمية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فدرس اليونانية</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>القديس غريغوريوس</h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الي فلسطين المسمية </span></font></h3>
    </div></td>
  </tr>
