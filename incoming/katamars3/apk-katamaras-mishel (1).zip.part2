  </tr>
  <tr>
    <td><h3 align="center"> <font face="Times New Roman"> <span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تي أجيا حنة</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> من نسل مُكرم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> قوية و روحانية</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أخوة حقيقية</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <font face="Times New Roman"> <span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تي أجيا حنة</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ماريا وصوفيا</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و نقاوة السريرة</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في هدوء السيرة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <font face="Times New Roman"> <span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تي أجيا حنة</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كالشمعة المُنيرة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> مع يوقيم زوجها</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  سارت بخوف الله</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <font face="Times New Roman"> <span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تي أجيا حنة</span></font></h3></td>
    <td><div align="center">
