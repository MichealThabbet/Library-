  <tr>
    
    <td><h3 align="center"><b> قديس عظيم وبــــــــار</font></b></h3></td>
    <td><h3 align="center"><b>فى محفل الأبـــــرار</font></b></h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3><strong>بينيوت آفا شنوده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><b> البابا  شنوده المختار</font></b></h3>
    </div></td>
  </tr>
  <tr>
    
    <td><h3 align="center"><b>وليس لـــــــــــــــه نظير</font></b></h3></td>
    <td><h3 align="center"><b>كان إسمه نظــــــير</font></b></h3></td>
  </tr>
  <tr>
    
