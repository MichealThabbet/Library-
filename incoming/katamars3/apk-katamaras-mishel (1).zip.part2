      <h3><b><span dir="ltr"> </span><span lang="AR-EG" xml:lang="AR-EG">في 
        سماء ربي الحنان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من كرز بالإيمان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> هذا المملوء بالروح </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> معنى إسمه ممدوح</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إسمه علم يلوح </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> هذا الرسول المأنوس </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مولود في طرسوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> حبيب ربي القدوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> هذا الرجل الأمين </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">من سبط بنيامين </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> خادم يسوع المعين </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> شاول بالعبراني </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">إسمه الروحاني </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
