  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">كقديسة مضيئة كالماس</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + نمدح فيك بقياس<br />
      </h3>
    </div></td>
  </tr>
  <tr>
