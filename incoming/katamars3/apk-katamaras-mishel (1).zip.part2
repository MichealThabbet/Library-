<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا بيشوي حامل المسيح-السلام لك يا قديس</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">يا من غلبت أبليس </span> </h3>
    </div></td>
    <td width="50%"><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام لك يا قديس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">بي منريت أفا بيشوي</span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">ونلت أكليل نفيس </span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">كأرميا من بطن أمك </span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">الرب قد اختارك</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">بي منريت أفا بيشوي</span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">فوهبت له قلبك</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقوة إيليا </span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ذهبت للبرية </span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">بي منريت أفا بيشوي</span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومحبة إلهية </span> </h3>
