<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد البابا بطرس خاتم الشهداء-أفتح فاي بالتسبيح</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> لربي يسوع المسيح</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">افتح فاي بالتسبيح</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  القديس أنبا بطرس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وبكل قواي أصيح</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الي حبيب مسيحي</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">أوجه مديحي</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  القديس أنبا بطرس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">من نال التجريح </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  الابرار الانقياء</span></font></h3>
    </div></td>
