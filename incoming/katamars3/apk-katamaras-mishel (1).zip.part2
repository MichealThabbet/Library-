  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">سيرتك تجذب من راق</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + نرفعك باستحقاق<br />
