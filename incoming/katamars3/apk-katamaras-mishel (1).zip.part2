<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدة يوستينا-هناك في أورشليم</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"> <strong>حول العرش العظيم</strong></span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"> <strong> هناك في أورشليم</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>حول يسوع فرحانين</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ملايين القديسين</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>أطلبوها تكون 
        معكم</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> أحدثكم 
        عن واحدة منهم</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>بصلواتها تشملكم</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>في الكنيسة مُستَديمة</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> عذراء شابة جميلة</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> حياتها مستقيمة</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ولم تَتَرجَّى سِواه</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> ذاقَت محبة الله</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>قلبها دائم معاه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>بِجمالِها الباهِر</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> رآها ابن الأكابِر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وقلبها الطاهِر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وفي المال 
        يغرِقها</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> طلب أن 
        يتزوّجها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>والذهب يُلبِسها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وعِبادة أوثانه</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> رفضت أمواله</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فاشتعلت 
        نيرانه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وبالتعذيب يتوعَّدها</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> فأخذ يهددها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فرفعت ليسوع يديها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> من المغرِب كان ماهِر</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> كبريانوس الساحِر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>جاء بسِحره يتفاخَر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>عن الساحر 
        الماهر</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> فسمع ابن 
        الأكابر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>أنه في البلد حاضِر</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وعن حاله اشتكى إليه</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> في الحال ذَهَبَ إليه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> ليميل يوستية إليه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>أن يُبلِغه أمله</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> كبريانوس قد وعده</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ويوستينة تخضع 
        له</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فعادوا خائبين</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> أرسل لها قوة شياطين</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>بالخِزي مُنهَزِمين</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>أمامِك مُنْكَسِرين</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>  جنود الشياطين</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>بصلاتِك كل حين</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>مع الشياطين الأشرار</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> كبريانوس فكَّر 
        واحتار</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وأعطاهم إنذار</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وأمامي تطرحوها</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> إن لم تهزِموها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>سأعبُد 
        فاديها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>أن 
        يقترِب من المكان</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> لم يقدِر الشيطان</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>بصلاتها كل آن</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وعمل شكله زيها</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> لَبِسَ النَّجِس لبسها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ففتح كِبريانوس لها</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ونادىَ باسمها كمان</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> استقبلها 
        وهو فرحان</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فصار الشيطان دخان</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>مجرَّد اسم يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> فصرخ يا للحيرة</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>يجعل 
        إبليس بلا قيمة؟!</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وندم 
        على سِحره</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> فقام وأحرَق كتبه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>وعبد يسوع ربّه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ثوب الرَّهبنة ألبَسه</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> بابا أنطاكية عمَّده</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>شمّاسًا فَقِسًّا رسمه</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فاصطحَب يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> ونال الأسقفية</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>في قِرطاجنّة الإيبارشية</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>حوَّطتهم بالصلوات</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> صارَت أمًا 
        للراهِبات</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>فصار منهنَّ قدّيسا</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ذاقّت معه 
        الموت</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> في 21 توت</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>ودخل 
        كِلاهما الملكوت</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>لكن بحُبِّك لفادنا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> لم تَعِظي يا يوستينة</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>صِرتِ قدوة 
        لينا</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>في صلواتِك اذكرينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong> يوستينة إشفعي فينا</strong></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>تي مِنريت يوستينا</strong></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span class="style7" lang="AR-EG" xml:lang="AR-EG"><strong>الصلاة الدائِمة علينا</strong></span></h3>
    </div></td>
