<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
.auto-style1 {
	direction: rtl;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">القديس أبو فانا</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">على مدى الدهور</span></strong></h3></td>
    <td width="50%" class="auto-style1"><h3 align="center"> <strong>
	<span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> فى مدينة قصر هور</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">قائم شيخ وقور</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">والنساك المجاهدين</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> فى وسط القديسين</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">أب مرتفع أمين</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> غرسٌ<strong><span lang="AR-SA" xml:lang="AR-SA">
    </span><span xml:lang="AR-SA">أ</span><span lang="AR-SA" xml:lang="AR-SA">خضر قد صار</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> كان أبواه أبرار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">نخلة حلوة الأثمار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وبجهاد شديد أضاف</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> عاش الشباب بعفاف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">رصيد أضعاف أضعاف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وأطعم بيده الجوعان</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> كسا كل عريان</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وزار السجين المهان</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">فتش عنه بأتعاب</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> اشتهى الكنز الخلاب</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">فنال القديس وأصاب</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وعلى باب المغارة</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> الوحدة كانت سكناه</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الله أنبع مياه</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">وصلاة بكل اقتدار</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> بعرق ودموع </span><span xml:lang="AR-SA">ا</span><span lang="AR-SA" xml:lang="AR-SA">لبار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وصوم ليل ونهار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">ولبسه من الألياف</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> وكان أكله الكفاف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">فزاد كل الأوصاف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">جذب سائر الأرواح</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> عطر زكى فاح</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">محب كل كفاح</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">فى المكان قد جاء</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> سراج لامع وضَّاء</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وعلى الجبل أضاء</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">حنان على الملهوف</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> قلبه رقيق عطوف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يجبر كل مقصوف</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بآباء أبرار رهبان</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> صار بستان مليان</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسبحون بنغم ألحان</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> <strong><span lang="AR-SA" xml:lang="AR-SA">النوع فيه غالى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"> <strong><span xml:lang="AR-SA"> 
	+
    </span><span lang="AR-SA" xml:lang="AR-SA"> برج حمام عالى</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">يهيمون فى الأعالى</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">حياتهم عاشوا بكمال</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> وصايا وتعاليم بجلال</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">ورفضوا محبة المال</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">للمرضى دون عناء</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> نال مواهب شفاء</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">وأقام ميتًا بجلاء</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">وعلم كل الأسرار</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> عرف كشف الأفكار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">وشهد إفرام إجهار</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بالنسك صار محنى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> جسده شاهد يحكى</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">وبمدحه زاد فرحى</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">واسأل يسوع ربنا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center">+ ا<strong><span lang="AR-SA" xml:lang="AR-SA">طلب عنا يا أبانا</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">لغفران خطايانا</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">الساهر دائمًا عنا</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> ويحفظ لنا أبانا</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">أبنا (……) بطركنا</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">يحفظ أسقفنا المحروس</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span xml:lang="AR-SA"> +
    </span><span lang="AR-SA" xml:lang="AR-SA"> وتسأل عنا القدوس</span></strong></h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">بنيوت آفا فينى</span></strong></h3></td>
    <td class="auto-style1"><h3 align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">الأنبا (…….)</span></strong></h3></td>
  </tr>
