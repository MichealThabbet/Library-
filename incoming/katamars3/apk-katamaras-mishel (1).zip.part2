<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الملاك ميخائيل رئيس الملائكه-جندي رئيس الطغمات</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> مشهور في الفردوس</h3></td>
    <td width="50%"><h3 align="center"> جندى رئيس الطغمات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> في بلاط الملك القدوس</h3></td>
    <td><h3 align="center"> مملوء بر وتقي </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> في إزالة كل عكوس</h3></td>
    <td><h3 align="center"> صديق كل الأصدقاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> من فخاخ اللعين المنجوس</h3></td>
    <td><h3 align="center"> شفيع في العتقاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> داخله من الرب القدوس</h3></td>
    <td><h3 align="center"> ومراحمة منبثقة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأكليله غير محسوس</h3></td>
    <td><h3 align="center"> مشتملا بمنطقة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس كل الطقوس</h3></td>
    <td><h3 align="center"> ملتحف بلباس النور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الرب الإله القدوس</h3></td>
    <td><h3 align="center"> وزير الضابط غير المنظور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> التوبة والغفران</h3></td>
    <td><h3 align="center"> أكليله عليه مكتوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> متضرعًا في كل إنسان</h3></td>
    <td><h3 align="center"> شفيعًا عند المرهوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا خالق يا ديان</h3></td>
    <td><h3 align="center"> يصرخ بغير غضوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> جنس آدم المهان</h3></td>
    <td><h3 align="center"> تحنن على المشجوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> منك وإليك راجعين</h3></td>
    <td><h3 align="center"> هم صورتك ومثالك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> عليم أجمعين</h3></td>
    <td><h3 align="center"> تحنن بجلالك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ساجدًا ثلاثة أيام</h3></td>
    <td><h3 align="center"> على ركبتيه للآب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> خاضعًا للثالوث بدوام</h3></td>
    <td><h3 align="center"> ووجهه غير معاب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أن الآب جسدًا محسوس</h3></td>
    <td><h3 align="center"> لا تتيقن يا سامع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ذا نور علوي قدوس</h3></td>
    <td><h3 align="center"> كسجمنا الضائع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ومجلسه لهيب من نار</h3></td>
    <td><h3 align="center"> ركبتيه غير محسوستين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> مقترب للأسرار</h3></td>
    <td><h3 align="center"> وميخائيل هو بيقين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ورماه في جحيم الموت</h3></td>
    <td><h3 align="center"> طرح أبليس اللعين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> من طعمه في اللاهوت</h3></td>
    <td><h3 align="center"> وأزال كبرياءه بيقين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فهو دايما شفيع</h3></td>
    <td><h3 align="center"> وأما ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ممتلئ رحمة ووديع</h3></td>
    <td><h3 align="center"> أمام عمانوئيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الجندي الاسفهسلار</h3></td>
    <td><h3 align="center"> السلام للمتحلي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> للإله الأزلي الجبار</h3></td>
    <td><h3 align="center"> السلام للمتجند</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> لابس حلة بهية</h3></td>
    <td><h3 align="center"> السلام للنسر الغيور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> صاحب نجدة قوية</h3></td>
    <td><h3 align="center"> وأجنحته مملوءه نور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> على جلب الرأفات</h3></td>
    <td><h3 align="center"> السلام لك يا غيرو</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أمام رب القوات</h3></td>
    <td><h3 align="center"> يا صدرا عظيما مشهور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> إلى حده ويزيد</h3></td>
    <td><h3 align="center"> ونهر جيحون يصعد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> للإله الأزلي المجيد</h3></td>
    <td><h3 align="center"> بشفاعة المتجند</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تصعد كحدودها </h3></td>
    <td><h3 align="center"> وأثمار كل الأشجار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بشفاعاتك في وجودها</h3></td>
    <td><h3 align="center"> وتنبت الأثمار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وزوجته أوفومية</h3></td>
    <td><h3 align="center"> وأرسطرخوس البار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وعظايم علوية </h3></td>
    <td><h3 align="center"> ظهرت لهما الأبرار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بشفاعتك قد فازوا</h3></td>
    <td><h3 align="center"> والرسل في البشري</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وللأكليل حازوا</h3></td>
    <td><h3 align="center"> وردوا كل الأسري </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <span style="mso-spacerun:yes"> وصبروا على الجهادات</h3></td>
    <td><h3 align="center"> والشهداء نالوا الأكاليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فازوا بأجل التاجات</h3></td>
    <td><h3 align="center"> بشفاعة ميخائيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> جاهدوا ونالوا الصحة</h3></td>
    <td><h3 align="center"> وأيضًا لباس الصليب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بشرتهم بالفرحة </h3></td>
    <td><h3 align="center"> والنسوة حاملات الطيب </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أشرقت بجلال النور</h3></td>
    <td><h3 align="center"> في خيم الإسرائيليين </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ألقيت الظلام والجور</h3></td>
    <td><h3 align="center"> وفي خيم المرائيين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ألقيت بشري السلام</h3></td>
    <td><h3 align="center"> وأيضًا عند النسوة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ألقيت الانتقام </h3></td>
    <td><h3 align="center"> وعلى عديمي التقوي</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> في حروب عماليق</h3></td>
    <td><h3 align="center"> يشوع بن نون رآك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأعطيته عهدا وثيق</h3></td>
    <td><h3 align="center"> وبشرته من فيك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> كل المؤمنين</h3></td>
    <td><h3 align="center"> تفسير أسمك في أفواه</h3></td>
  </tr>
  <tr>
    <td height="26"><h3 align="center"> ميخائيل أعنا أجمعين</h3></td>
    <td><h3 align="center"> الكل يقولون يا إله </h3></td>
  </tr>
</table>
</body>
</html>
