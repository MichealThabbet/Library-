<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-اشفعي فينا يا مريم 1</h1></td>
  </tr>
  <tr>
    <td><h3 align="center" >وأنشى ترتيلا 
    مع مديح</h3></td>
    <td><h3 align="center" >أبدأ كلامى 
    بالتسبيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >على مريم أم 
    المسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وولدته وهى 
    فتاه</h3></td>
    <td><h3 align="center" >بكر بتول حملت 
    الإله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >تاهت الملائكة 
    عن معناه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >أن يأخذ اليه 
    جسدها</h3></td>
    <td><h3 align="center" >تجسد منها ووعدها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >وأنجز وعده 
    ومجدها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لما كان فى 
    بلاد الهند يجول</h3></td>
    <td><h3 align="center" >ثارت عواطف توما 
    الرسول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >رأى جسدًا 
    نورانى محمول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وقال هذا جسد 
    أم يسوع</h3></td>
    <td><h3 align="center" >جزع وخاف وصار 
    مفزوع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >واليوم هو 
    للسماء مرفوع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >تأنو يا خدام 
    رب الصباؤوت</h3></td>
    <td><h3 align="center" >حقق الرؤيا فنادى 
    بالصوت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >كى أنظر مسكن 
    اللاهوت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لما دنى منه 
    وزاد تأكيد</h3></td>
    <td><h3 align="center" >خضع وسجد وأعطى 
    تمجيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >ثَبُتَ ايمانه 
    وصار وطيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >أذهب الى 
    تلاميذ المتعال</h3></td>
    <td><h3 align="center" >دبَّر توما فى 
    نفسه وقال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >واعلمهم عن هذا 
    الحال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فوجدهم كلهم 
    مجتمعين</h3></td>
    <td><h3 align="center" >ذهب توما 
    للحواريين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >فقال اسمعوا لى 
    ياطاهرين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >جسدًا نورانى 
    تحمله جنود</h3></td>
    <td><h3 align="center" >رأيت وأنا فى 
    بلاد الهنود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >صاعدين به لعرش 
    المعبود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فتقدمتُ لأفهم 
    معناه</h3></td>
    <td><h3 align="center" >زهلنى المنظر 
    فى رؤياه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >فإذا هو جسد أم 
    الإله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وفرحتُ لمنظرهِ 
    فى جلال</h3></td>
    <td><h3 align="center" >سجَدت لرؤيته 
    فى الحال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >وجئت لاخبركم 
    يارجال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >هل رايتَ جسدها 
    عيانا</h3></td>
    <td><h3 align="center" >سألوه قائلين 
    زدنا بيانًا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >أم تريد إعلاها 
    شانا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >هيا بنا لقبرها 
    فى الحال</h3></td>
    <td><h3 align="center" >شقَّ ذلك على 
    توما وقال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >لنرى هل جسدها 
    لا يزال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >انه ظهر لىَ 
    بالعانى</h3></td>
    <td><h3 align="center" >صدِّقوا وآمنوا 
    يا إخونى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >وانتم تعلمون 
    بإمانى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وقلت لا أومن 
    ما لم أراه</h3></td>
    <td><h3 align="center" >ضل فكرى فى 
    قيامة ابن الله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >فأتانى وأرانى 
    اياه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فقال توما هذا 
    معقول</h3></td>
    <td><h3 align="center" >طلبوا التوجه 
    لقبر البتول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إشفعى فينا   				يامريم</h3></td>
    <td><h3 align="center" >ذهبوا الجميع 
    وهم فى ذهول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فكشفوا القبر 
    بكل آمال</h3></td>
