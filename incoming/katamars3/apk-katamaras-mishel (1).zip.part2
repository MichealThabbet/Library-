    <td><h3 align="center"><span style="font-weight: 700">عاش حياته بالتدقيق</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت أفا متاؤس</h3></td>
    <td><h3 align="center"><span style="font-weight: 700">والمسكنة له طريق</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> تفيضان بالدموع</span></h3></td>
