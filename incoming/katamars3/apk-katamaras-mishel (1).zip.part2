  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">أمام عرش إلهك<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> أذكرنا فى صلاتك<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">ليكون لنا كميراثك<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">من احتفلوا بهذا التذكار<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> أذكر يارب جميع الحُضار<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بشفاعة قديسك المختار<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الملايكة ترتل لك<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> يا مرشد النفوس<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span dir="ltr">axioc axioc axioc</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كل المؤمنين<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك فى أفواه<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الأنبا باخوميوس أعنا أجمعين</span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الكل يقولون يا إلـه</span></strong></h3></td>
  </tr>
</table>
</body>
</html>
PK^��z�x␀␀�x␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/b5.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد يوليان والقديسة باسيليس</h1></td>
  </tr>
  <tr>
    <td width="50%"> <div align="center">
      <h3><b><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">إليك 
        أُرنم بمسرة</span></b></h3>
    </div></td>
    <td width="50%"> <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  لك التمجيد مع القدرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يوليان وباسيليس الطاهرة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لأمدح من نالوا النصرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عبدوه بتقوى رسولية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أحبوا الله بالكلية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بمحبة وخدمة إلهية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى عفاف وحياة بتولية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بخوف الله وحفظ الطقوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أكمل يوليان وصايا إيسوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فقدم لـه نفسه كعروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وأحب العشرة مع القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أن يزوجاه بأبهى عروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أراد والدا هذا المحروس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وطاع المشورة وصار مأنوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> صام وصلى وسأل القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حياتها صلاة مع تقديس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  وجدا عروسًا هى باسيليس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بروائح شذاها عطر تفيح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> باركت السماء عُرس القديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> طالبين مشورة التقى يوليان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تقدم آلاف الشبان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جذبتنا طهارتك مع الإيمان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ارشدنا فنحيا معك فى أمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عينينا لنحيا فى طهارة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  باسيليس أحاطتها العذارى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نخضع لإرشادك يا مختارة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نسير خلفك فأنت منارة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باسيليس زهرة ويوليان مصباح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عبير طهارتهم حقًا فاح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> واسم الله عالى بنجاح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وشباب كثير عاشوا فى صلاح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نشر الغيوم وباد الأمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قام بحقده وغيظه الشيطان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> الكل يسجد للأوثان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أصدر منشور بعثه السلطان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ونصلى لنثبت فى الإيمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  لنصوم يا أخوة قال يوليان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حتى يصلوا إليك بأمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> احفظ قطيعك يا ديان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ستحظى قريبًا بالملكوت</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  باسيليس فى رؤيا سمعت صوت</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ويوليان أمامه جهاد ممدود</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بناتك عرائس لمن لا يموت</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وملكن مع الختن الجليل</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  نالت العذارى الإكليل</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لك النعيم مع التهليل</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نادت باسيليس عمانوئيل</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أن يأتوا بيوليان المختار</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أمر الحاكم جنوده الأشرار</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ويشعلوا فى بيته النار</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ويربطوا يديه بأوتار</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لكى يثني عزمه ويخور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  صار يتملقه المغرور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أطلق سراحك على الفور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> قدم الآن للآلهة بخور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وسجنك هو غرضى ومُناى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قيودك هى زينة يداى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يسوع الذى يسكن جواىّ</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> حريتى هى من مولاى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فقأ السوط عين أحد الجند</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قبل القديس آلام الجلد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خرج الجندى وقال أبصرت</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> تهشمت الآلهة بصوت كالرعد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أعبده بروحى ويقبلنى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  إله يوليان رد بصرى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أؤمن بـه وأوفى نذرى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ولـه أسجد فهو فخرى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> هيا اسحلوه فى الشوارع</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ساحر قالوا فهو خادع</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما رأى يوليان بمجد لامع</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> سلسيوس ابن الوالى كان راجع</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خلقين قار بناره لم يثنيه</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عبثًا حاول أبوه يغريه</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ومركيانيلا آمنت بـه</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لا أثر للنار فلم يؤذيه</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يوليان حطمها بأعجوبة</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أوثان مركيانوس مقلوبة</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> كانوا ينجون منها كل نوبة</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> عذابات الشهداء المرهوبة</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عزاء عبيره يسبى النفوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى السجن نظروا نور الفردوس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مع جمع يشددوا يوليانوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> باسيليس ببهاء تضوى كعروس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بفرح تشيدوا وتيجان لابسين</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  غدًا ستوافونا أجمعين</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حول إلهنا لـه المجد آمين</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى حياة أبدية نعيش فرحين</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خزى الوالى لما لاحظهم</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  وحوش كاسرة لم تغلبهم</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لا مناص إلا بقطع رؤوسهم</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> آمن بيسوع من ينظرهم</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لعبيد الله القوى المصلوب</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عزاء روحانى ملك القلوب</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وإبليس يخرى ويصير مغلوب</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">هيا نصلى لنرى المحبوب<br />
      </span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باقة شهداء وصلوا هدية</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  طوباكم يا يوليان وباسيليس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تهدى بضياها البشرية</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا كواكب ساطعة فى الأبدية</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا من تلألأتم بشعاع النور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  نطلب فتنجدونا على الفور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تشع فينا بهجة وسرور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> صلواتكم عنا سحابة بخور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما نمدحكم بالنشيد</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  حقًا لله يليق التمجيد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لباسيليس ويوليان الشهيد</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نرفع أصواتنا فى العيد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> للغالب الشهيد والعروس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ونقول بحلاوة أكسيوس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باسيليس العذراء ويوليانوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ومعهم باقة من النفوس</span> </h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKl0V'P␀␀'P␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/b6.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيدة بربارة</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font color="#ffffff"> <span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أقدم لجلاله التسبيح</span></font></h3></td>
    <td width="50%"><h3 align="center"><font color="#ffffff"> <span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أمجد إلهي بلسان فصيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أمدح الشهيدة عروس المسيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أخبركم عن هذه الصبية</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بمعونة العناية الإلهية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ولدتِ من عائلة وثانية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كان يحبها حبًا وافر</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  ديوسقورس والدها الكافر</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بنا لها قصرًا فاخر</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و صنع حوض وسط الحمام</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أتم القصر بأحسن نظام</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> من أفخر مرمر و رخام</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> حسب رسم المُهندسين</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و في الحمام صنع طاقتين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فكان تحفة الصانعين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و معها يوليانة والأمارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في القصر دخلت بربارة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فزاد قلبها فرحًا و استنارة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الشمس والقمر ما أجمل نورها</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تأملت في السماء وجمالها</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فقالت من الذي أبدعها</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بقلبها الطاهر يا سامعين</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  لقد علمت علم اليقين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3></td>
    <td><h3 align="center"><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بوجود مُبدعًا للعالمين</span></font></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قالت يا خالق المُوجودات</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رفع قلبها إلى السموات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عرفني طريقك قبل الممات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أرسل العلامة أوريجانوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بتدبير الرب القدوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> دخل القصر لزيارة العروس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> من بدء خلقة الإنسان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  شرح لها أصول الإيمان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> إلي تجسد الفادي الديان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بأسم يسوع الرب المُتعال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أمنت بربارة في الحال</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أنه أنقذها من الضلال</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> على مثال الثالوث</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  طاقة ثالثة في الحمام صَنعت</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و على الحوض صليب رُفعت</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فنظر ما صنعت بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  دخل والدها لزيارة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فقال لها ما أصل العبارة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الثلاث طاقات كثلاث أقانيم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قالت له بصوت عظيم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> لإله واحد بغير تقسيم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> علامة يسوع رب الأنام</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أما يا أبي الصليب المُقام</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  إذا بدمُه وهبني السلام</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> حجارة صناعة الشيطان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  ألهتك يا أبي كاذبين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فتب و أرجع في الحين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> والدها السالك في الضلال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  سمع منها هذه الأقوال</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فتحول كالوحش في الحال</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قد ملأه الشيطان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  جرد سيفه ديوسقورس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أرد أن يقتل العروس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فصادفها صخرة يا سامعين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  هربت الحرة منه في الحين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بالقدرة انقسمت لها قسمين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و بقدرة الله عليها انضمت</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في الصخرة العروس دخلت</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هي تصلي داخل المغارة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وهجم عليها بكل جسارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بحث عن الحرة المُختارة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هي تصلي داخل المغارة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و لمركيانوس الوالي سلمها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  مثل الوحش وثب عليها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فلاطفها الوالي ثم هددها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قلبها للسماء مرفُوع</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أذاقها العذاب بكل نوع</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و لم تترك عريسها يسوع</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و قالت اقبلني يا رب السماء</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رفعت نظرها إلى العلا</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وكمل جهادي يا ابن الله</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أن تقطع رأسها في الحال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بيد أبيها أمر الوالي</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و هي صابرة لا تُبالي</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> إلى الجبل بشدة وتعنيف</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أخذها والدها غير الشريف</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و بقوة قطع رأسها بالسيف</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و نالت الأكاليل مع الشهيدات</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  صعدت روحها إلى السموات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و دخلت العرس مع الحكيمات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في الثامن من كيهك المَشهور</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  نالت الشهادة بفرح و سرور</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و فازت بمساكن النور</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> السلام للعفيفة الحرة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  السلام لبربارة الدرة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> التي نبتت بين الأشواك المرة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> التي جاهدت بأمانة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> السلام للشهيدة يوليانة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> صاحبة الشهيدة المُعانة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> تشفع في جميع الحضار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  و السلام لمريم طهر الأطهار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عروس المسيح بربارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#ffffff"><span style="color: black; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> من حضروا واحتفلوا بتذكار</span></font></h3>
