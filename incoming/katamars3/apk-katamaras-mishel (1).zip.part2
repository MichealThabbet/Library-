    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وللملكوت نرث 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> نقول لك اكسيوس </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">يا مرشد النفوس </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">اكسيوس اكسيوس </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> كل المؤمنين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">تفسير اسمك فى افواه </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> مار لوقا اعنا اجمعين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">الكل يقولون يا اله </span></b></font></h3>
    </div></td>
