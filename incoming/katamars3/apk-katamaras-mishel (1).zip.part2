<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا شنودة رئيس المتوحدين-المجد والتقديس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> لمن طبعه الجودة</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">التمجيد والتقديس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">العظيم الانبا شنودة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">الذى اختار القديس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">بقرية من اخميم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">نشا هذا القديس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">البسه اسكيم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ويسوع رب التقديس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ودعته ام الاله</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اختاره منذ صباه  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> تفسيره ابن الله</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">شينوتى ما احلاه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> فكر وبدا يقول</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">والده المبارك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> من الانبا بيجول</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">نذهب نتبارك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> تنبا باعلان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">انبا بيجول خاله</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">انه اب للرهبان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ونطق بافضاله </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> رئيس المتوحدين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام لانبا شنودة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> قاهر الشياطين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام لانبا شنودة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">الذى حضر المجمع</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام للغيور</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">عسى ان يرجع</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">وبكت نسطور </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> واضع الناموس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام لموسي الجديد</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> للرب القدوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">بك يليق التمجيد </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> المحامى عن الايمان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام لانبا شنودة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  معلم الرهبان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام للانبا شنودة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> بكنيسة الابكار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام لمن تملى</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">وكشف له الاسرار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">والمسيح له تجلى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> الملتحف بالنور</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام للمبرور </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> نعمة وبهجة وسرور</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">منه يفوح بخور </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> بالفضائل المسيحية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السلام للمتحلى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ينير فى البرية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ونوره يتلالى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  يا سراج الرهبان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اشفع فى الحاضرين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  فى نعمة الايمان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">واجعلهم ثابتين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> يا مرشد النفوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">طوباك ثم طوباك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اكسيوس اكسيوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">الملائكة ترتل لك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> كل المؤمنين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">تفسير اسمك فى افواة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> انبا شنودة اعنا اجمعين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">الكل يقولون يت اله</span></font></h3>
    </div></td>
  </tr>
</table>
