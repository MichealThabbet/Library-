  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">صرت شفيعا 
لنيا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> شفاعتك ترفعنا </h3></td>
    <td><h3 align="center">صلاتك تكون معنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا مينا </h3></td>
    <td><h3 align="center">للرب فيقبلنا </h3></td>
  </tr>
