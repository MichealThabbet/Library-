␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/v21.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس يوسف النجار</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">خطيب العذراء المختار</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">السلام ليوسف النجار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  ذو الشيبة والوقار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">المشهود له انه بار </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">من عشيرة داود المختار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">هو من نسل الابرار  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وخصه بكرامة ووقار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">عينه الرب باقتدار </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> يكون خطيبا لامه</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">عينه الرب وائتمنه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">طارت شبه حمامة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">عصاته اظهرت علامة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   البتول الطاهرة النقية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فاخذ مريم الصبية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    لتتميم المشيئة الالهية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الي بيته بكل حنية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  وهي مشتهية البتولية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ظنوها زوجة عادية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> في الناصرة واليهودية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ففاضت نعمة سماوية  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  طوبي لبيتك المختار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">طوباك ايها البار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بميلاد فادي البشرية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فيه اتت البشري الهنية   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  بشارة ميلاد ربها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الصبية حفظت في قلبها </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> تحير ولم يقل لها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ويوسف رأي بطنها </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">كما شهدت عنه الاسفار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">حقيقي هو البار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> فلم يتركه أب الانوار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لكن الامر جعله يحتار </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  لذا ارسل ملاك نوراني</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الامر يخص الفادي</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> فصاح ده مش استحقاقي</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يطمئنه بالحبل الالهي </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> الذي يسبي العقل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ها قد اقتنيت الحقل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  يسوع غالي القيمة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">به الجوهرة الثمينة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  وسهرك وترحالك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">السماء لن تنسي اتعابك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  وشهامتك وكمالك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وبذلك في خدماتك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بل اخذت اللقب الصريح</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لم تكن أبا للمسيح</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بل تكريما لشخصك الخديم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لا علي سبيل المديح </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بحمل الكلمة الازلية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">سمعان حظا لحيظة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يالهذه النعم السنية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وحملته انت كم مرة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> وعظمك الرب بقوة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">نلت كرامة الابوة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مصر تكون ملجاك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وارسل ملاكه يعلنك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> لذا جاك الملاك مرسول</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">واصبحت الشخص المسئول </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> والي مصر قم علي طول</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">خذ الطفل وام النور </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فطافوها معك يا مقدام</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لم يعين في مصر مكان </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بالزيارة الفريدة المنال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وتبارك وادينا وجبل قسقام  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بالطفل يسوع لما جاك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مصر يا بختك يا هناك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> هي العذراء الام العفيفة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">راكبا سحابة خفيفة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ويعول الصبية وابنها البار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يوسف ظل يعمل نجار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> واتاه الملاك لثالث مرة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">حتي جاء الوحي بالعودة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> من مصر دعوت ابني المحبوب</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">هكذا تم المكتوب </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> والخطر مضي وزال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فالوقت في مصر قد طال</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">واسرح دابته وقال</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">اطاع يوسف في الحال </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> ارافق الاله وامه القديسة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يالهذه الاتعاب اللطيفة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  الي الناصرة بسلام</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ورجع مع العذراء والغلام </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> ممتلئ نعمة وحكمة تامة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">والصبي ينمو في القامة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ونسال توبة وغفران</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">لذا نطوبك بالالحان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> الذى تجسد وصار انسان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">من لدن الرب الديان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> السالكات بالبر والطهارة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وتطوبك كل العذارى</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">تضىء لجميع السهارى</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يا من صرت منارة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  كل المؤمنين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">تفسير اسمك فى افواه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> يوسف النجار اعنا اجمعين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الكل يقولون يا اله </span></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK憫p�F␀␀�F␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/v22.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد يوليان والقديسة باسيليس</h1></td>
  </tr>
  <tr>
    <td width="50%"> <div align="center">
      <h3><b><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">إليك 
        أُرنم بمسرة</span></b></h3>
    </div></td>
    <td width="50%"> <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  لك التمجيد مع القدرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يوليان وباسيليس الطاهرة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لأمدح من نالوا النصرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عبدوه بتقوى رسولية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أحبوا الله بالكلية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بمحبة وخدمة إلهية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى عفاف وحياة بتولية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بخوف الله وحفظ الطقوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أكمل يوليان وصايا إيسوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فقدم لـه نفسه كعروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وأحب العشرة مع القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أن يزوجاه بأبهى عروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أراد والدا هذا المحروس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وطاع المشورة وصار مأنوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> صام وصلى وسأل القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حياتها صلاة مع تقديس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  وجدا عروسًا هى باسيليس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بروائح شذاها عطر تفيح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> باركت السماء عُرس القديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> طالبين مشورة التقى يوليان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تقدم آلاف الشبان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جذبتنا طهارتك مع الإيمان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ارشدنا فنحيا معك فى أمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عينينا لنحيا فى طهارة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  باسيليس أحاطتها العذارى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نخضع لإرشادك يا مختارة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نسير خلفك فأنت منارة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باسيليس زهرة ويوليان مصباح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عبير طهارتهم حقًا فاح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> واسم الله عالى بنجاح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وشباب كثير عاشوا فى صلاح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نشر الغيوم وباد الأمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قام بحقده وغيظه الشيطان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> الكل يسجد للأوثان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أصدر منشور بعثه السلطان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ونصلى لنثبت فى الإيمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  لنصوم يا أخوة قال يوليان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حتى يصلوا إليك بأمان</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> احفظ قطيعك يا ديان</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ستحظى قريبًا بالملكوت</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  باسيليس فى رؤيا سمعت صوت</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ويوليان أمامه جهاد ممدود</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بناتك عرائس لمن لا يموت</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وملكن مع الختن الجليل</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  نالت العذارى الإكليل</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لك النعيم مع التهليل</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نادت باسيليس عمانوئيل</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أن يأتوا بيوليان المختار</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أمر الحاكم جنوده الأشرار</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ويشعلوا فى بيته النار</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ويربطوا يديه بأوتار</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لكى يثني عزمه ويخور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  صار يتملقه المغرور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أطلق سراحك على الفور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> قدم الآن للآلهة بخور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وسجنك هو غرضى ومُناى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قيودك هى زينة يداى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يسوع الذى يسكن جواىّ</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> حريتى هى من مولاى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فقأ السوط عين أحد الجند</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  قبل القديس آلام الجلد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خرج الجندى وقال أبصرت</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> تهشمت الآلهة بصوت كالرعد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أعبده بروحى ويقبلنى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  إله يوليان رد بصرى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أؤمن بـه وأوفى نذرى</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ولـه أسجد فهو فخرى</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> هيا اسحلوه فى الشوارع</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ساحر قالوا فهو خادع</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما رأى يوليان بمجد لامع</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> سلسيوس ابن الوالى كان راجع</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خلقين قار بناره لم يثنيه</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عبثًا حاول أبوه يغريه</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ومركيانيلا آمنت بـه</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لا أثر للنار فلم يؤذيه</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يوليان حطمها بأعجوبة</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أوثان مركيانوس مقلوبة</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> كانوا ينجون منها كل نوبة</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> عذابات الشهداء المرهوبة</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عزاء عبيره يسبى النفوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى السجن نظروا نور الفردوس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مع جمع يشددوا يوليانوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> باسيليس ببهاء تضوى كعروس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بفرح تشيدوا وتيجان لابسين</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  غدًا ستوافونا أجمعين</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حول إلهنا لـه المجد آمين</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى حياة أبدية نعيش فرحين</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خزى الوالى لما لاحظهم</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  وحوش كاسرة لم تغلبهم</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لا مناص إلا بقطع رؤوسهم</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> آمن بيسوع من ينظرهم</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لعبيد الله القوى المصلوب</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عزاء روحانى ملك القلوب</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وإبليس يخرى ويصير مغلوب</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">هيا نصلى لنرى المحبوب<br />
      </span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باقة شهداء وصلوا هدية</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  طوباكم يا يوليان وباسيليس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تهدى بضياها البشرية</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا كواكب ساطعة فى الأبدية</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا من تلألأتم بشعاع النور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  نطلب فتنجدونا على الفور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تشع فينا بهجة وسرور</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> صلواتكم عنا سحابة بخور</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما نمدحكم بالنشيد</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  حقًا لله يليق التمجيد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لباسيليس ويوليان الشهيد</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نرفع أصواتنا فى العيد</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> للغالب الشهيد والعروس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ونقول بحلاوة أكسيوس</span> </h3>
    </div></td>
  </tr>
  <tr>
    <td>      <div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> باسيليس العذراء ويوليانوس</span></b> </h3>
    </div></td>
    <td>      <div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ومعهم باقة من النفوس</span> </h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKl0V'P␀␀'P␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/v23.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
