  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> طاهر ورجل قديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> من إله كل عطية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  طلب كزكريا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أن يرزقه ذرية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بكت بدموع غزار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أمه نسل الأبرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى عيد الرسل الأطهار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> من بشرها بغلام</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  رأت فى رؤيا المنام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بطرس وبولس الكرام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA">وكان فصيح وقدير</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  رزقت بهذا النذير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى العلم والتبشير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فى رتبة الشماس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  رسمه البابا ثاؤناس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فكاهن لقدس الأقداس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مدبرًا فرئيس آباء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  اختارته السماء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> هو خاتم الشهداء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حصّن شعبه تحصين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  راعى صالح وأمين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> من بدع المبتدعين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ميليتوس مربوط</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  منهم أسقف أسيوط</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بمجمع جمعه المغبوط</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عن آريوس قد نهاه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ويسوع فى رؤياه ناداه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> من أنكر ابن الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تقبل أريوس قسيس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  إياك يا قديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ده فيه روح إبليس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وجمع مجمع آباء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فأطاع لصوت السماء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فنَّدوا كل الآراء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مع حزب الشيطان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  حرموا آريوس حرمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وحفظوا لنا الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> على كرسى مارمرقس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  رأيت قوة إيسوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فأبيت الجلوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أن تحقن الدماء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  طلبت من إله السماء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وأكون آخر الشهداء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ومضيت إلى ربك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أعطيت سؤل قلبك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> اختارك وأحبك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا راعى شعب إيسوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  السلام لك يا أفا بيتروس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وموصلهم إلى الفردوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا ابن القسيس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  السلام لك يا قديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا حبر ونفيس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا رئيس الأحبار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  السلام لك يا مختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا مؤتمن على الأسرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أكسيوس أكسيوس أكسيوس</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  طوباك ثم طوباك</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا من أكملت مسعاك</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لنكمل مسعانا</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أذكرنا يا أبانا</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ونحظى برجانا</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك فى أفواه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> البابا بطرس أعنا آجمعين</span></b></h3></td>
    <td><h3 align="center"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></h3></td>
  </tr>
</table>
