    <td><h3 align="center">  فى بلاد الرومية</h3></td>
    <td><h3 align="center">نشا فى اسرة تقية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">نال احسن تربية </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وعلمه وقداسته</h3></td>
    <td><h3 align="center">سمع الملك بحكمته </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
    <td><h3 align="center">اخذه الى خاصته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   لك هما خاضعان</h3></td>
    <td><h3 align="center">ها ابناى الاميران</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">    بنيوت آفا ارسانيوس</h3></td>
