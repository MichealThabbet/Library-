<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدان قزمان ودميان-السلام للمختارين</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b>وإخوتهم القدَّيسين</b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b>السلام للمُختارين</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><div align="center">
      <h3><b>وثيؤدوتى أمهم أجمعين</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> <b>معناها عطية الله</b></h3></td>
    <td><h3 align="center"> <b>ثيؤدوتى جبيبة الله</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"> <b>علمتهُم خوف الله</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>وأخوهم إبرابيوس</b></h3></td>
    <td><h3 align="center"><b>أنتيموس ولاوندوس</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>عاشوا فى حُب إيسوس</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>فى الطب بارعان</b></h3></td>
    <td><h3 align="center"><b>قزمان ودميان</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>تَمجد الله الحنَّان</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>والمرضى مُتساويين</b></h3></td>
    <td><h3 align="center"><b>للمال كانا مُحتقرين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>وفى الإيمان ثابتين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>خلَّصا من الشيطان</b></h3></td>
    <td><h3 align="center"><b>فتحا أعيُن العُميان</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>بقوة الله الديان</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>وبالمسيح فرحوا</b></h3></td>
    <td><h3 align="center"><b>الوثنيون آمنوا</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>وللإيمان نشروا</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>عذَّب عبيد الفادى</b></h3></td>
    <td><h3 align="center"><b>سمع بهم الوالى</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>سفك دمهُم الغالى</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>صَلَّوا أصبح سالم</b></h3></td>
    <td><h3 align="center"><b>مرض الوالى الظالم</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>لكن حقده دائم</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>ومار بقطر بحث عنهم</b></h3></td>
    <td><h3 align="center"><b>قطع رأس أمهم</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>ودفنها ونال بركتهم</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>وهم يصرخون مُسبَّحين</b></h3></td>
    <td><h3 align="center"><b>سفك دم الباقين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>يا إلهنا ثبَّت المسيحيين</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>أصبح عيدهم مشهور</b></h3></td>
    <td><h3 align="center"><b>فى شهر هاتور</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>نُعَّيد لهُم بسرور</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>أصبح لهم كنيسة أعجوبة</b></h3></td>
    <td><h3 align="center"><b>فى شهر بؤونة</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>بالمعجزات مشهورة</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام لكم يا أبرار</b></h3></td>
    <td><h3 align="center"><b>طُوباكم يا أطهار</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>أكاليلكم ذهب مُختار</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>للمسيح نصير بنون</b></h3></td>
    <td><h3 align="center"><b>أطلبوا عنَّا يا قديسون</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>السلام للشهداء</b></h3></td>
    <td><h3 align="center"><b>وفى الملكوت نكون</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>كل المؤمنين</b></h3></td>
    <td><h3 align="center"><b>تسبيح اسمك فى أفواه</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b>قزمان ودميان اعنَّا أجمعين</b></h3></td>
    <td><h3 align="center"><b>الكل يقولون يا إله</b></h3></td>
  </tr>
</table>
</body>
</html>
PK�$$�␀␀␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/o3.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدان قزمان ودميان-السلام للقديسين</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>الأم وثلاث رهبان وأيضا طبيبين</h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>السلام 
        للقديسين هولاء المباركين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أحبت أولادها واستضافت الغرباء</h3>
    </div></td>
    <td><div align="center">
      <h3>أمهم 
        ثيئودتي معناها عطية الله</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>
        <o> </o>
        خدموا الرب يسوع واحتملوا المحن</span></h3>
    </div></td>
    <td><div align="center">
      <h3>في نهاية 
        ثالث قرن عاش الأخوة معا
        <o></o>
        </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> قزمان ودميان وأيضا أمهم</span></h3>
    </div></td>
    <td><div align="center">
      <h3>انتيموس 
        ولونديوس وأبرابيوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لم يفترقا أبدا فتعلم يا إنسان</span></h3>
    </div></td>
    <td><div align="center">
      <h3>اثنان منهم 
        توأم هما قزمان ودميان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فتجد أسم الله في حياتهما كل حين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>اختيارهم 
        كان عظيم في الطب كانا بارعين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وصنعا الأشفية بأيمانهما الوفير</span></h3>
    </div></td>
    <td><div align="center">
      <h3>اشتهرا في 
        كل مكان بالعلم الغزير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فالمرض متساوون أغنياء مع فقراء</span></h3>
    </div></td>
    <td><div align="center">
      <h3>للمال كانا 
        محتقرين فاكتنزا في السماء</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يصليان لله في حرارة متألمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>مع المرضي 
        في أوجاعهم كانا مشاركين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> ويشفي كل مريض بحب متجدد</span></h3>
    </div></td>
    <td><div align="center">
      <h3>الله كان 
        يستجيب بمعونته يتمجد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكانا لوصايا الله مطيعين وحافظين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>فتحا أعين 
        عميان وأخرجا شياطين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأصبحوا وارثين لملكوت السموات</span></h3>
    </div></td>
    <td><div align="center">
      <h3>الوثنيون 
        أمنوا من كثرة المعجزات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قوامهما الصلاة والصوم والرحمة 
        والإحسان</h3>
    </div></td>
    <td><div align="center">
      <h3>حياتهما 
        نقية ممتلئة بالأيمان</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> فسأل عنهما فوجدهما بارين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>سمع الوالي 
        عن هذين القديسين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأمر بتعذيبهما فما هي الشكوى</span></h3>
    </div></td>
    <td><div align="center">
      <h3>لم  يسكت 
        الوالي وقبض علي الأخوة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>  فيستوجبوا العذاب والضرب والتجريح</span></h3>
    </div></td>
    <td><div align="center">
      <h3>أنهم 
        مسيحيون يؤمنون بالمسيح </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من شتائم وإهانات إلى وخر بالحراب</span></h3>
    </div></td>
    <td><div align="center">
      <h3>احتقروا 
        أجسادهم واحتملوا أشد عذاب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نجاهم إلههم ورجعوا منتصرين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>طرحوهم في 
        البحر وكانوا موثوقين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأنتشر هذا الحدث بين جميع إفراد الشعب</span></h3>
    </div></td>
    <td><div align="center">
      <h3>رآهم الجنود 
        فأمنوا باسم الرب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لم ينكروا المسيح وكانوا له شهود</span></h3>
    </div></td>
    <td><div align="center">
      <h3>أغراهم 
        الوالي بكثرة الوعود </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فشفي بأعجوبة وتنكر بإصرار</span></h3>
    </div></td>
    <td><div align="center">
      <h3>مرض الوالي 
        الظالم وصلي له الأبرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ودفنها ابن رومانوس مار بقطر الجليل</span></h3>
    </div></td>
    <td><div align="center">
      <h3>الأم قطعت 
        رأسها ونالت الإكليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يصلون من أجلنا وللرب مسبحين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>وأخيرا 
        قطعوا رؤوسهم وأصبحوا قديسين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>في اليوم الثاني والعشرين من شهر هاتور</span></h3>
    </div></td>
    <td><div align="center">
      <h3>استشهد 
        الأخوة في ثالث الشهور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من شهر بؤونه فاصبح لهم عيدين</span></h3>
    </div></td>
    <td><div align="center">
      <h3>كرست 
        كنيستهم في الثاني والعشرين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>دائما لا تنسونا وامنحونا المعونة</span></h3>
    </div></td>
    <td><div align="center">
      <h3>صلوا لنا في 
        هاتور واذكرونا في بؤونه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> الكل يقولون يا اله هولاء القديسين أعنا أجمعين</h3>
    </div></td>
    <td><div align="center">
      <h3>تفسير أسمك 
        في أفواه كل المؤمنين </h3>
