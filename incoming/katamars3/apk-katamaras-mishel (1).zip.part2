  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> زى ما عال شعبه زمان</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الرب يعولك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> كاملة و محتجبة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الثالثة محبة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  كبرت حبة بحبة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">كانت الاول حبة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> عيشة بين الجبال</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الرابعة احتمال</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  ده من المحال</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">مين بس اللى قال  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  حيوان ابدا و خشيت</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الخامسة ما رايت</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  نلت نعمة و قويت</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لكنك صليت</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> على الطبيعة كمان</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">السادسة سلطان </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">     بحب الهك شبعان</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا بتول طاهر</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وصايا الرب و خاضع</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">السابعة سامع </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  جسدك كله خاشع</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وايدك رافع</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وللذات سالب</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الثامنة هارب</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">على كل التجارب </span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وبيسوع غالب</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> تركت لاجل الملك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">التاسعة ممالك  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  وعلى قلبك مالك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">فى طريقه سالك  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> ما حلاكى يا وحدة </span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">الوزنة العاشرة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">   لذيذة وطعمة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">والثمرة الحلوة </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> العيشة فى حاله</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">من ذاقك تحلى له  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  ويرتاح باله</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">تتحسن احواله </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  فى السما ويا الهك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طوباك طوباك طوباك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> فرحان مع سيدك</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">نلت النعيم هناك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  اولادك محتاجين</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">انبا بولا يا امين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">   تحرسهم كل حين</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">صلواتك عنهم </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">     يا ساكن المغارة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طوباك با انبا بولا </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  بقيت لينا منارة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">صارت سماء ثانية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  سيرتك نقية</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سيرتك شهية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">لينا منورة</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">سيرتك تقية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  يا حبيب المسيح</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">طوباك يا انبا بولا</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700"> وجهك حلو ومريح</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">يا ضياء منير </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  تشفى القلب الجريح</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">صلواتك بلسم </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">  من كل كلام فصيح</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700">وصمتك اقوى</span></font></h3></td>
  </tr>
</table>
