<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس البابا كيرلس عمود الدين-السلام لعمود الدين</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>وحامى الأرثوذكسيين</h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>السلام 
        لعامود الدين  </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كيرلس الأمين</h3>
    </div></td>
    <td><div align="center">
      <h3>رئيس 
        المؤمنين   </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى بيت طاهر محروس</h3>
    </div></td>
    <td><div align="center">
      <h3>ولد أبينا 
        كيرلس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من ربنا ايسوس</h3>
    </div></td>
    <td><div align="center">
      <h3>ذاك الغصن 
        المغروس </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> حظيت بحب كثير  </h3>
    </div></td>
    <td><div align="center">
      <h3>كنت فتى 
        صغير </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنبا سرابيون الشهير</h3>
    </div></td>
    <td><div align="center">
      <h3>من القلب 
        الكبير  </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>خالك البابا ثيئوفيلوس</h3>
    </div></td>
    <td><div align="center">
      <h3>يا بابا 
        كيرلس  </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لتحافظ على الطقوس</h3>
    </div></td>
    <td><div align="center">
      <h3>رسمك شماس 
        لايسوس </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>باسم الفادى الحبيب</h3>
    </div></td>
    <td><div align="center">
      <h3> رسمك قسا يا 
        مهيب </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا صاحب القول العجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>فحملت نير 
        الصليب </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى كنيسة رب القوات</h3>
    </div></td>
    <td><div align="center">
      <h3>صرت رئيس 
        الطغمات </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وآلاف من الأقباط</h3>
    </div></td>
    <td><div align="center">
      <h3>بطرك 
        لربوات</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>محب للخطاه والمساكين</h3>
    </div></td>
    <td><div align="center">
      <h3>راعى صالح 
        وأمين </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> للحزانى والمتعبين</h3>
    </div></td>
    <td><div align="center">
      <h3>صدرا مملوء 
        حنين </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>عذبوك بكل هوان</h3>
    </div></td>
    <td><div align="center">
      <h3>يا مدافع عن 
        الايمان </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لتثبيت قانون الايمان</h3>
    </div></td>
    <td><div align="center">
      <h3>وعشت فى 
        الاحزان </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الظلم والهوان</h3>
    </div></td>
    <td><div align="center">
      <h3>نسج الشيطان 
        خيطان </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> الذل والطغيان</h3>
    </div></td>
    <td><div align="center">
      <h3>سلط عليك 
        نيران </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لرفضك للانكار</h3>
    </div></td>
    <td><div align="center">
      <h3>سجنوك يا 
        رئيس الاحبار </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنا عبد الله الجبار</h3>
    </div></td>
    <td><div align="center">
