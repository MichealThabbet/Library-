<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهداء يسطس وأبالى وثاؤكليا</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الأبرار المجاهدين<br />
    </span></strong></h3></td>
    <td width="50%"><h3 align="center">  السلام للقديسين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فى الفردوس فرحين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">نوماريوس كان أبوك<br />
    </span></strong></h3></td>
    <td><h3 align="center">  يسطس ابن الملوك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> لملك روما دعوك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وهبه رب الأبرار<br />
    </span></strong></h3></td>
    <td><h3 align="center">  يسطس الرجل البار <br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> أبالى ابنه المختار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كانت امرأة تقية<br />
    </span></strong></h3></td>
    <td><h3 align="center">  زوجته ثاؤكليا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> أحبت البشرية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بعد طول الدرب<br />
    </span></strong></h3></td>
    <td><h3 align="center">  لما عاد من الحرب<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وجد فى القصر كرب<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وملك على تخته<br />
    </span></strong></h3></td>
    <td><h3 align="center">  دقلديانوس تزوج أخته<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فترك العرش تحته<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">دقلديانوس عبد الأوثان<br />
    </span></strong></h3></td>
    <td><h3 align="center">  إرتد عن الإيمان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وجحد الرب الديان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">المملكة والوجهاء<br />
    </span></strong></h3></td>
    <td><h3 align="center">  اجتمع كل رؤساء<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> ليورثوه ملك الآباء<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">مفضلًا السمائية<br />
    </span></strong></h3></td>
    <td><h3 align="center">  رفض المملكة الأرضية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> ناظرًا للأبدية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">معترفًا باسم إيسوس<br />
    </span></strong></h3></td>
    <td><h3 align="center">  تقدم إلى دقلديانوس<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> قال أنا عبد القدوس<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">لوالى الإسكندرية<br />
    </span></strong></h3></td>
    <td><h3 align="center">  أرسله بوحشية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> هو وأبالى وثاؤكليا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وعن عزمهم يثنيهم<br />
    </span></strong></h3></td>
    <td><h3 align="center">  حاول الوالى يغريهم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فلم يقدر عليهم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">ونعبد آخر سواه<br />
    </span></strong></h3></td>
    <td><h3 align="center">  كيف نترك الإله<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وهو لنا خبز الحياة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">عن حب جابلنا<br />
    </span></strong></h3></td>
    <td><h3 align="center">  من يقدر يفصلنا<br />
    </h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>وهو النور لسبيلنا<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">ولا تعب فى الطريق<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> لا شدة ولا ضيق<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>لا خطر ولا حريق<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">وقرر أن يفرقهم<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> واغتاظ الوالى منهم<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>عن بعضهم ليؤلمهم<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">فلم يهتم أو يُبالى<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> لبسطه أرسل أبالى<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>قال على الرب اتكالى<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">فقال محبة ربنا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> أرسل يسطس لأنصنا<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>ثابتة فى قلبنا<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">فقالت مهما فعلوا بىَّ<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> لصا الحجر أرسل ثاؤكليا<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">تى أجيا ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>أنا متمسكة بفادىّ<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">والرب لهم صديق<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> مضى كل فى طريق<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يسطس نيم أبالى نيم ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>وهو نعم الرفيق<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بالحرق والضرب الكثير<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> عذبوا أبالى الأمير<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا أبالى<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>فاحتمل بصبر وفير<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">من جراحاته يشفيه<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> كان الرب يعزيه<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا أبالى<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>ومن الشر ينجيه<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">نُلت إكليل نفيس<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> فى أول مسرى يا قديس<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا أبالى<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>انتصرت على إبليس<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">يا من تركت أمك وأباك<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> طوباك ثم طوباك<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا أبالى<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>محبة فى مولاك<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">عذبوه كثير الكفار<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> أما يسطس البار<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا يسطس<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>فلم ينكر بإصرار<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بعد العذاب المرير<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> وفى 10 أمشير<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا يسطس<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا يسطس<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بفرح وسعادة<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> أخذت الشهادة<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">بى منريت آفا يسطس<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3>أكملت سعيك بزيادة<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">البارة ثاؤكليا<br />
      </span></strong></h3>
    </div></td>
    <td> <div align="center">
      <h3> والعفيفة النقية<br />
      </h3>
    </div></td>
  </tr>
