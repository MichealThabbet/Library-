<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا باخوميوس أب الشركة-أفتح فاي بالأفراح</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong>و امدح في باخوميوس</strong></h3></td>
    <td width="50%"><h3 align="center"> <strong>أفتح فاي بالأفراح</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>ني اثؤواب باخوميوس</strong></h3></td>
    <td><h3 align="center"> <strong>السلام لأب الشركة</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>ولد هذا الأمين</strong></h3></td>
    <td><h3 align="center"> <strong>أواخر القرن الثالث</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>من أبوين وثنيين</strong></h3></td>
    <td><h3 align="center"> <strong>في إقليم طيبة بمصر</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>ازدري بالرذائل</strong></h3></td>
    <td><h3 align="center"> <strong>لكنه منذ صباه</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>و أحب الفضائل</strong></h3></td>
    <td><h3 align="center"> <strong>و كل عبادة وثنية</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>يعرفه عن ذاته</strong></h3></td>
    <td><h3 align="center"> <strong>طلب إله السماء</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>و يعرفه صفاته</strong></h3></td>
    <td><h3 align="center"> <strong>و يكشف له حقيقته</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>الأنبا سرابيون</strong></h3></td>
    <td><h3 align="center"> <strong>عمده أسقف دندره</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>رؤيا ما سيكون</strong></h3></td>
    <td><h3 align="center"> <strong>و رأي في ليلتها</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>و اشتهي حياة الرهبنة</strong></h3></td>
    <td><h3 align="center"> <strong>اشتهر في الفضيلة</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>العظيم المقدام</strong></h3></td>
    <td><h3 align="center"> <strong>تتلمذ للناسك بلامون</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>و أعطاه وصايا و بركة</strong></h3></td>
    <td><h3 align="center"> <strong>ظهر له ملاك الرب</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>دير بنظام الشركة</strong></h3></td>
    <td><h3 align="center"> <strong>و طلب منه يبني</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>عام له في الرهبنه</strong></h3></td>
    <td><h3 align="center"> <strong>و بعد تسعة و ثلاثين</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong>فأهتم برهبانه</strong></h3></td>
    <td><h3 align="center"> <strong>إنتشر مرض الطاعون</strong></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>للرئاسة بعده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>و رشح أنبا بطرونيوس</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>و أقام معه عهده</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>و أوصي تلميذه تادرس</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>بعيد و غير معلوم</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>يدفن جسده بمكان</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>من كافة الغيوم</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>و يحفظ رهبانه</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>و في سن الستين</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>و في 14 بشنس</strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong>في حضور السمائيين</strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong>روحه الطاهرة صعدت</strong></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
