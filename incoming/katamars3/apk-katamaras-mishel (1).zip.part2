  </tr>
  <tr>
    <td><div align="center">
      <h3>معزيًا لأمه دفوع</h3>
    </div></td>
    <td><div align="center">
      <h3>وبمثل هذا كان يسوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأعلا صوته من بكاه</h3>
    </div></td>
    <td><div align="center">
      <h3>حتى بكوا كل الجموع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>للموت رعبة وانزعاج</h3>
    </div></td>
    <td><div align="center">
      <h3>فاجابته كيف العلاج</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أخاف أغرق فى مياه</h3></td>
    <td><div align="center">
      <h3>حر ناره فى وهاج</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">هذا الطريق المملوء شوك</h3></td>
    <td><h3 align="center">ويلاه ما أصعب سلوك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وماذا تكون هذه الامرآه</h3></td>
    <td><h3 align="center">طريق تخاف منها الملوك</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لخروج الروح من الجسد</h3>
    </div></td>
    <td><div align="center">
      <h3>الويل لى مالى جلد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يميت ويحى من يشاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وكيف اموت ولى ولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى الموت فعنى يرتفع</h3>
    </div></td>
    <td><div align="center">
      <h3>ويقدر أنه يفتزع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كيف العمل وايش المناه</h3>
    </div></td>
    <td><div align="center">
      <h3>الويل لى أخذنى الفزع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والروح يعالج فى الطلوع</h3>
    </div></td>
    <td><div align="center">
      <h3>كيف العمل يا ابنى يسوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وينفذ الحكم قضاه</h3>
    </div></td>
    <td><div align="center">
      <h3>والعين ترغرغ بالدموع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أحر من نار الجحيم</h3>
    </div></td>
    <td><div align="center">
      <h3>ياابنى طلوع الروح عظيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>إذ القضا ما أصعب قضاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وفيه عذابًا أليم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اذرفوا الدموع مثل المطر</h3>
    </div></td>
    <td><div align="center">
      <h3>ابكوا معى يا من حضر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لأخذ روح أم الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>وانظروا الموت انه حضر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكل العذارى اخوتى</h3>
    </div></td>
    <td><div align="center">
      <h3>ابكو معى يا رفقتى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لتتميم الموت منتهاه</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنى بكيت من حنتى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وفى الموت رأيت الكبر</h3>
    </div></td>
    <td><div align="center">
      <h3>نميت فى حال الصغر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كالهم قلبى النقاء</h3>
    </div></td>
    <td><div align="center">
      <h3>والآن ها الموت حضر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والأرض أيضًا والحجر</h3>
    </div></td>
    <td><div align="center">
      <h3>الشمس تبكى والقمر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لفقد مريم ومعناه</h3>
    </div></td>
    <td><div align="center">
      <h3>والسحاب يسيل منه المطر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يبكوا على مريم دوام</h3>
    </div></td>
    <td><div align="center">
      <h3>والوحش والطير والهوام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فيتخذون منه عطاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وابنها يعطى الطعام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهو يهدى نفسها</h3>
    </div></td>
    <td><div align="center">
      <h3>وأن المخلص قال لها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وينشفه لها بأصبعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>ويمسح بيده دموعها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مقام هنا حتى أمهلك</h3>
    </div></td>
    <td><div align="center">
      <h3>الآن يا أمى لم يبق لك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حكمى نفذ لم فيه قضاه</h3>
    </div></td>
    <td><div align="center">
      <h3>أليس انى قلت لك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الحاضرين هنا من البشر</h3>
    </div></td>
    <td><div align="center">
      <h3>فودعى من قد حضر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وباركيهم ببركتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>قبل انصرافك للسفر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اليوم أنا داعيكى</h3>
    </div></td>
    <td><div align="center">
      <h3>وارشميهم بيديكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من ذا ولا يقبل فداه</h3>
    </div></td>
    <td><div align="center">
      <h3>فليس شئ يفيدكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنا أسألك قبل الموت</h3>
    </div></td>
    <td><div align="center">
      <h3>فاجبته قضاك عادل لا يفوت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قطيع شعبك والرعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>فى أنك تحرس بثبوت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>شعب النصارى المعتمد</h3>
    </div></td>
    <td><div align="center">
      <h3>أرع بنعمتك يا سيد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قرن الأمانة وثبتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وارفع بعزك إلى الأبد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأبطل مشورات البدع</h3>
    </div></td>
    <td><div align="center">
      <h3>ثبت أساسات البيع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>دعاء عبيدك فى الصلاه</h3>
    </div></td>
    <td><div align="center">
      <h3>من الكنائس واستمع</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">كنيستى أوجاب ستور</h3></td>
    <td><div align="center">
      <h3>من قصد يا أبنى عبور</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أو سمع كتب القراه</h3></td>
    <td><h3 align="center">ورفع قربانًا أو بخور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بأنك توهب لى نصيب</h3></td>
    <td><h3 align="center">أنا أسألك يا أبنى الحبيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى كل يوم ينجاه</h3></td>
    <td><h3 align="center">وأرسل ملاكًا مجيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فاغفر له مثل الصفاه</h3></td>
    <td><h3 align="center">وإن كان أخطأ وهفا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وخزفت عنه خطاه</h3></td>
    <td><h3 align="center">لأن عفوك قد عفى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">واصنع بأمك ما اشتهيت</h3></td>
    <td><h3 align="center">إفعل بحكمتك ما قضيت</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا قبلت منى فداه</h3>
    </div></td>
    <td><div align="center">
      <h3>هانذا يا ابنى قد رجيت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأعط لها صبرًا وجلد</h3>
    </div></td>
    <td><div align="center">
      <h3>ألحق بأمك ياسيد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهون على أمك لقاه</h3>
    </div></td>
    <td><div align="center">
      <h3>على فرقة الروح للجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فيه أقصدك يا سيدى</h3>
    </div></td>
    <td><div align="center">
      <h3>هذا هو الوقت الذى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لكى لا يخفونى البلاه</h3>
    </div></td>
    <td><div align="center">
      <h3>انك تجى تمسك يدى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يدها وباركت الجموع</h3>
    </div></td>
    <td><div align="center">
      <h3>فاخرج مخلصنا يسوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أودعكم لأبنى الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>ورشمت ثلاثة دفوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>له الواديع ويستجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>أودعكم لمن لا تخيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وينعم على من دعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>لمن دعا باسمه قريب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأسلمت له نفسها</h3>
    </div></td>
    <td><div align="center">
      <h3>حينئذ فتحت فمها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والجموع تتعجب حين رآه</h3>
    </div></td>
    <td><div align="center">
      <h3>الطوبانية فى يد ابنها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>عينى أمه حين مضت</h3>
    </div></td>
    <td><div align="center">
      <h3>ووضع يدها وغمضت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>دين عليها اليوم وفاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وصاح أن مريم قد مضت</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يذرف دموع مثل المطر</h3></td>
    <td><div align="center">
      <h3>ومن كان قلبه حجر</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">قد غمض أمه بيداه</h3></td>
    <td><h3 align="center">وهى ترى رب البشر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">جميع الأبرار لها سجدت</h3></td>
    <td><h3 align="center">نفس البتول قد أخرجت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والروح صعدت إلى الاله</h3></td>
    <td><h3 align="center">وجسدها بالكفن أدرجت</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وجعل يقبلها قبول</h3></td>
    <td><h3 align="center">والابن أخذ يد البتول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تجلس عليه طول المداه</h3></td>
    <td><h3 align="center">وجاب لها كرسى مهول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وجاب لها حلة حرير</h3></td>
    <td><h3 align="center">وبأ يعزيها كثبر</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وصعد بها لأعلا سماه</h3>
    </div></td>
    <td><div align="center">
      <h3>ولفها بمجد كثير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أخذوا جسدها محتمل</h3>
    </div></td>
    <td><div align="center">
      <h3>بعد هذا قاموا الرسل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى أرض المقدس وضعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>فوق الرؤوس حتى جبل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الجسمانية ستة شهور</h3>
    </div></td>
    <td><div align="center">
      <h3>ومكث جسدها قبور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ودفن تحت شجرة الحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>وفى شهر مسرى صعد بنور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ينجينا من نار الجحيم</h3>
    </div></td>
    <td><div align="center">
      <h3>ونسأل الرب الرحيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويجعلنا من اصفياه</h3>
    </div></td>
    <td><div align="center">
      <h3>ويدخلنا فردوس النعيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومصيرنا جميعًا اليه</h3>
    </div></td>
    <td><div align="center">
      <h3>كل الأرواح بين يديه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومن توكل به كفاه</h3>
    </div></td>
    <td><div align="center">
      <h3>والاتكال دايم عليه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وان يزكى بركم</h3>
    </div></td>
    <td><div align="center">
      <h3>وأنه يهدى سركم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نصيبًا فى فردوس الحياه</h3>
    </div></td>
    <td><div align="center">
      <h3>وأن يجعلكم كلكم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نيل مصر هذه السنة</h3>
    </div></td>
    <td><div align="center">
      <h3>ونسأله يصعد لنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى البهائم والغلاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وفى كل عام ويبارك لنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويجعل الدنيا ملا</h3>
    </div></td>
    <td><div align="center">
      <h3>ويرفع الموت والغلا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لا تخيب من رجاه</h3>
    </div></td>
    <td><div align="center">
      <h3>خيرات وارزاق لنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فى من كتب هذا المديح</h3></td>
    <td><h3 align="center">اشفعى يا أم المسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يوم تقف الناس عراه</h3></td>
    <td><h3 align="center">واذكريه وقت أن يصيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فلسانه أعرج لا فصيح</h3></td>
    <td><h3 align="center">وإن كان غلط فى دا المديح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فسامحيه بما أتاه</h3></td>
    <td><h3 align="center">وانه عاجز كسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أبو السعد يتلو ألف</h3></td>
    <td><h3 align="center">وبدو اسمى هو الف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أن تعطى لى رجاه</h3></td>
    <td><h3 align="center">رجائى منكى يوم أقف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أنت الذى غفور رحيم</h3></td>
    <td><h3 align="center">أسألك يامن هو عليهم</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>جميع ذنوبه والخطاه</h3>
    </div></td>
    <td><div align="center">
      <h3>اغفر لعبدك جاد الكريم</h3>
