    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كل نسطور مكار</h3>
    </div></td>
    <td><div align="center">
      <h3>يا من شأنك 
        احتار </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واخزى عنا ابليس</h3>
    </div></td>
    <td><div align="center">
