<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة إيلارية-أبدأ باسم الله الحنان</h1></td>
  </tr>
  <tr>
    <td width="50%"> <h3 align="center">اتكلم عن إيلاريه<br />    
    </h3></td>
    <td width="50%"> <h3 align="center"> أبدأ باسم الله الحنان<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">ملك القسطنطينية<br />    
    </h3></td>
    <td> <h3 align="center">ابنة الملك زينون<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">ثاؤبستا وإيلاريه<br />    
    </h3></td>
    <td> <h3 align="center"> رزق بابنتين<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">والعلوم المسيحية<br />    
    </h3></td>
    <td> <h3 align="center">درستا العهدين<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">تميل للبتولية<br />    
    </h3></td>
    <td> <h3 align="center"> نشأت إيلاريه<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">للرهبنة فى البرية<br />    
    </h3></td>
    <td> <h3 align="center">ورغبتها قوية<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">كى يظهر لها الدليل<br />    
    </h3></td>
    <td> <h3 align="center"> لجأت للإله<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">ويبارك فى القليل<br />    
    </h3></td>
    <td> <h3 align="center">ويختار لها الحياة<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">اسمعها يسوع القول<br />    
    </h3></td>
    <td> <h3 align="center"> دخلت البيعة بحبور<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">وأيضًا فى الإنجيل<br />    
    </h3></td>
    <td> <h3 align="center">فى الرسائل والمزمور<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">تزيت بزى رجال<br />    
    </h3></td>
    <td> <h3 align="center"> عادت وفى الصبحية<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">فى سفينة رحلت فى الحال<br />    
    </h3></td>
    <td> <h3 align="center">قصدت اسكندرية<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">وبلوغ الاسقيط<br />    
    </h3></td>
    <td> <h3 align="center"> عزمت على الجهاد<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">أن تسكن جبل شيهيت<br />    
    </h3></td>
    <td> <h3 align="center">طلبت باجتهاد<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">اختبر فيها عزم أكيد<br />    
    </h3></td>
    <td> <h3 align="center"> رآها أنبا بموا<br />    
    </h3></td>
  </tr>
  <tr>
    <td> <h3 align="center">الحياة بقلب حديد<br />    
    </h3></td>
    <td> <h3 align="center">ورغبة قوية<br />    
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أنها أميرة بنت ملوك<br />
    </h3>    </td>
    <td><h3 align="center"> أخفت عنه القول<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">طلبت ملك الملوك<br />
    </h3>    </td>
    <td><h3 align="center">تركت مجدًا يزول<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">ودعاها إيلارى<br />
    </h3>    </td>
    <td><h3 align="center"> ألبسها الاسكيم<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">عاشت فى جهاد ضارى<br />
    </h3>    </td>
    <td><h3 align="center">سلكت حياة التسليم<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">عليك يا إيلاريه<br />
    </h3>    </td>
    <td><h3 align="center"> سبع سنوات مرت<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">وتوبة حقيقية<br />
    </h3>    </td>
    <td><h3 align="center">فى صلاة وسهر ودموع<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">من هى تكون<br />
    </h3>    </td>
    <td><h3 align="center"> كشف الله لـه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">هى ابنة زينون<br />
    </h3>    </td>
    <td><h3 align="center">هذا الراهب المجهول<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">اخبرها بالإيمان<br />
    </h3>    </td>
    <td><h3 align="center"> ذهب لها القديس<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">أن لا تعلم إنسان<br />
    </h3>    </td>
    <td><h3 align="center">كلمها وأوصاها<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">أن تعرف سيرتها<br />
    </h3>    </td>
    <td><h3 align="center"> ولما أراد الله<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">بأمراض عذبتها<br />
    </h3>    </td>
    <td><h3 align="center">مرضت اختها<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">الملك زينون البار<br />
    </h3>    </td>
    <td><h3 align="center"> أرسلها أبوها<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">برية أبو مقار<br />
    </h3>    </td>
    <td><h3 align="center">بجنود أحضروها<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">فى الحال رفعت صلوات<br />
    </h3>    </td>
    <td><h3 align="center"> رأتها القديسة<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">سجدت طالبة البركات<br />
    </h3>    </td>
    <td><h3 align="center">بدموع فى الكنيسة<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">طوقت المسكينة<br />
    </h3>    </td>
    <td><h3 align="center"> بالأحضان والقبلات<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">طلبت عنها حزينة<br />
    </h3>    </td>
    <td><h3 align="center">بأصوام وميطانيات<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">م الزمان عدة أيام <br />
    </h3>    </td>
    <td><h3 align="center"> ظلت على ذى الحال<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">عن اختها الآلام<br />
    </h3>    </td>
    <td><h3 align="center">تحنن يسوع وأزال<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">فرحة لأبيها<br />
    </h3>    </td>
    <td><h3 align="center"> وعادت ثاؤبستا<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">ومجد باريها<br />
    </h3>    </td>
    <td><h3 align="center">فعلم بقصتها<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">شغلتنى أفكارى<br />
    </h3>    </td>
    <td><h3 align="center"> وفكر فى قلبه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">فعل ما فعل إيلاريا<br />
    </h3>    </td>
    <td><h3 align="center">لم أسمع عن راهب<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">يستوضح أمره<br />
    </h3>    </td>
    <td><h3 align="center"> أرسل فى طلبه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">ولم يعلم أنها ابنته<br />
    </h3>    </td>
    <td><h3 align="center">حضرت أمامه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">ابنتك إيلاريه<br />
    </h3>    </td>
    <td><h3 align="center"> أفصحت لأبيها إنى<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">واقتنيت الأبدية<br />
    </h3>    </td>
    <td><h3 align="center">تركت ذهب أرضى<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">عاشت فى قصر أبيها<br />
    </h3>    </td>
    <td><h3 align="center"> وبعد ثلاثة شهور<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">لتسبح باريها<br />
    </h3>    </td>
    <td><h3 align="center">عادت للبرية<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">تجاهد نهار وليل<br />
    </h3>    </td>
    <td><h3 align="center"> خمس سنوات ظلت<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">وألبسها الإكليل<br />
    </h3>    </td>
    <td><h3 align="center">فافتقدها الله<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">تركت أكاليل أرضية<br />
    </h3>    </td>
    <td><h3 align="center"> السلام لإيلاريه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">فضلت السمائية<br />
    </h3>    </td>
    <td><h3 align="center">وهناك فى البرية<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">توسدت الأديم<br />
    </h3></td>
    <td> <h3 align="center"> هجرت سكنى القصور<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وارتضت بثوب قديم<br />
    </h3>    </td>
    <td><h3 align="center">خلعت عنها الحرير<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">يا قوية فى جهادك<br />
    </h3>    </td>
    <td><h3 align="center"> طوباكِ يا إيلاريه<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">بصبرك وإيمانك<br />
    </h3>    </td>
    <td><h3 align="center">نلت الأبدية<br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">كل المؤمنين<br />
    </h3>    </td>
    <td><h3 align="center"> تفسير اسمك فى أفواه <br />
    </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">القديسة إيلاريه أعنا آجمعين    </h3>    </td>
    <td><h3 align="center">الكل يقولون يا إله    </h3>    </td>
