<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد تادرس المشرقى-أبدي باسم الله الغفار</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> الحي الازلي القوي الجبار</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ابدي باسم الله الغفار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وامدح تاؤدوروس الاسفهسلار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   اخبركم عن تادرس الامير</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بمعونة رب قدير </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">اصل ابوه كان وزير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  نمجد ربنا في كل حين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">تعالوا يا جميع المؤمنين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ونصرخ جميعا قائلين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> وكلمة الايمان بها ناديت</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ثوب النعمة به تحليت  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وعن العظمة والجاة تخليت </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">من نسل سداريخوس الوزير</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">جئت كالبدر يا امير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وكنت للروم احسن نصير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">اتاك الملاك الجليل ميخائيل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">حين اتيت للبيعة يا نبيل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">واعطاك بيده سيف التهليل </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الغلبة والنصرة علي اعداءك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">خذ هذا السيف ربك اعطاك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الله اختارك واصطفاك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> علي الرومان فاشتد الكرب</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">دبر ملك الفرس الحرب</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وقالوا هذا الجندي ارسله الرب</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  لما سمع باسمك يا مختار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ذهل الملك حقا واحتار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ان القوي في الحرب جبار </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فجعلت علي الحدود حارس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">رآك ملك الروم انك فارس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لانك لثوب الشجاعة لابس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  وفى الحرب شجاع صنديد</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ذاع صيتك لانك للدين عنيد </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ولحب الاستشهاد ترغب و تريد  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> لما سمعوا بصيتك يا محروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">سميت عند البربر بثيئودوروس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فصار منهم قوم على اسم ايسوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الذي رآه يعقوب الطوباوي</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">شاهدت السلم النوراني </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">عليه جالس الابن الوحداني</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> اتي تاودروس ليهلكه</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">صوت في البربر افزعه</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فخافوا وبطلت حركتهم</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">علي رجال البربر قد حلت</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ضجة عظيمة قد حصلت</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وانهزمت قواهم وبطلت </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">والسيف في يدك يلمع</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">طلعت امامهم تتوعد  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">والملاك يناديك تشجع </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ولم يقفوا امامك يا مختار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">طاروا جميعا كالغبار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لان بيدك سيفا من نار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ان تسجد وتبخر للاوثان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">طلب منك الملك الجبان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فقلت انا عبد للديان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> وكلامك هذا كلام مجنون</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ظنك فاسد ايها الملعون</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وانت واصنامك تهلكون  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">عند ملك الروم ايها الفارس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">علي قدرك يا امير تادرس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">الذي كان علي المملكة جالس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وفي الحال استدعي الصناع</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">غلب عليه ابليس الخداع </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">صنعوا له صنم من ذهب لماع</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  لجميع الشعب لكي ياتون</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فاصدر امره هذا الملعون</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">للاله الصنم ويسجدون </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">نحن نصاري مسيحيون</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قال جميع المؤمنين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">والقوا باجسادهم في الاتون</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فنالوا الشهادة مع الابرار</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كلهم القوا نفوسهم في النار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">والملائكة تناديهم باستبشار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> قال له تاتي يا امير</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لما سمع الملك المكير </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ان اطعتني اجعلك وزير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> للشهيد تادرس بدون شفقة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">مدوا اياديهم الكفرة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">   السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وصلبوه فوق الشجرة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  يجري علي الارض يا ايهاالمبرور</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">مثل الماء دمك نهور</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وكيف علي هذا كله صبور</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  وقال افرح وتقوي يا امير</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">نفخ في وجهك الرب القدير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قد اعد لك مسكنا منير  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> لقدومك وصاحوا بنغمات</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">هتفت اجناد السموات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">مستحق الطوبي والغبطات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> ان تثنت دين الأرثوذكسية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">اسالك يا رب البرية</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاودروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وترفع عنا كل بلية   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  يا ربنا يسوع المسيح</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">يجب لك السجود والتسبيح </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  السلام لك يا تاوضروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ونصرخ جميعا ونصيح  </span></font></h3>
    </div></td>
  </tr>
