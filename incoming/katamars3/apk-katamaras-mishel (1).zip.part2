  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">قتلهم يوليانوس فى ساعة</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وصوفية من عذارى الرهه</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بطلنا نقم لهم فى الساحة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">كما خاصت الاب باسيليوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">نجنا من شر بذيافولوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">وقتلت الجاحد يوليانوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">راسه مائلة اجابه منظورة </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فارس حصانه ادهم فى الصورة</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">سيفاه صليب فوقه مرقورة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">علمنا كيف نرضى الله</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">لا تهملنا نحن الخطاة  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">نحبه فنتمثل بك يا فتاه</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">  شدد سواعد الكسلان </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ثبتنا يارب على الايمان  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">نغلب فقد فاز ببيان   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> واعمل معنا كاعاجيبك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">يا رب انصرنا بصليبك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">فيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">بشفاعة الشهيد حبيبك   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> فى مدح صفيك اثلوفوروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ساعدنا يا الهنا القدوس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700"> لفيلوباتير مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="FONT-WEIGHT: 700">ونقول جميعا اكسيوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3>اكسيوس . . . اكسيوس . . . اكسيوس</h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3>فيلوباتير مرقوريوس</h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�Dٹ=z␀␀=z␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/n7.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد فيلوباتير مرقوريوس ابوسيفين-أمدح فيكي يا ماريام</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">يا بكر نقية بتول عروس</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">أمدح فيك يا ماريام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أمام من أختار باى مارتيروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والتمس شفاعتك على الدوام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأخبركم عن بطل مأنوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أنظم مديحي يا حضار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيلوباتير مارقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ذلك الشجاع المختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أرسل لنا هذا المحروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بإرادة الإله العلوية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في عهد القيصر ديسيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فولد بمدينة تدعي رومية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويطلب نعيم الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بدأ برفض مجد العالم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتعالى قدره عند النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتفاخر اسمه وتعاظم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واخذ سيف من بي أنجيلوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تمنطق بسمة الشجعان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصار يكرز ويبشر بالثالوث</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتحلى بقوة الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فخاف وتقهقر ديسيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ثم صار الحرب على رومية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقتل كثير من النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأن الحرب كانت قوية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بالترس والخوذة مع القوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جاء القديس وأسرع</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فألحق بالقوم أشر العكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وسيفين في يديه أيضًا تلمع</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وألبسهم الخزي والعبوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حين رأوه ولوا مهزومين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في صومعة الوغي وضيق النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتركوا أكثرهم مطروحين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وشاع ذكره امام ديسيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خرج صيته في كل مكان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهابته السلاطين والرؤوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وانتشر اسمه في سائر البلدان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والسجود للحجر الملموس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> دعاه الملك لعبادة الأوثان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> انا عبد لسيدى إيسوس بي أخرستوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فقال حاشا لي ان اعبد الشيطان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الحي العالي القدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ذلك الإله القوى المعبود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في أتشوب خا أوأخرونوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الملك الأزلي غير المحدود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قادر يبيدك يا داكيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رؤوف رحيم حاكم ديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الذي طغاهم بي ذيافلوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويهلك جميع عباد الأوثان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عند ما سمع قول المحروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> زاد الملك في الغيظ وتكدر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأمر بعذاب مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأومأ إلى جنوده تحضر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهو يقول آجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سيوفهم مدوها لقتله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوباه طوباه أكسيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والملائكة تتهلل لأجله </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شجاعة وحكمة مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شاهدوا جميع الحاضرين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكل من كان بالحضرة جلوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقد خزى الأعداء والسلاطين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نحن نؤمن بإله مارقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صرخوا أكثر الحاضرين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وله تسجد كل القطوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الذي خلقنا أجمعين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واقسم بالألهة ذاك المنجوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صاح الملك بأعلي صوت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتؤخذ رأسه مع مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أن من يؤمن بالإله يموت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صلاة طاهرة للقدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صلوا الشهداء يا سامعين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأرثنا نعيم الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قائلين يا رب أقبلنا أجمعين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومعهم أيضًا هذا المبرور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ضرب رؤوسهم السياف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في 25 من شهر هاتور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونالوا الشهادة بكمال وعفاف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وترك مجد بي كوزموس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوبي لمن آمن واستشهد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصار يتنعم في الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> للحياة طلب فوجد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومن رأس القديس مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ظهرت عجائب من الأجساد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيشفوا باسم القدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكانت تأتي ذوى الأمراض</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتنتعش من ذكرك النفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ظهر مجدك في كل الأقطار<span style="mso-spacerun:yes">  </span></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيلوباتير مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أيها الشجاع المختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونسألك باسم مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عليك يا رب توكلنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واخزي عنا بي ذيافلوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أن تغفر لنا كل آثامنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحلو في أفواه ان ني بسطوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غالي هو مدحك يا مغبوط</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يدخلنا في الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أسال عنا رب البصاؤوت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحظيت بنعيم الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فقت سائر الشجعان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونلت ني مارتيروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وسفكت دمك عن الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا من اخترت باى مارتيروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قدوس هو أسمك يا معين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بسلام وطمأنينة للنفوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بلغنا لمثل هذه السنين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والصبر والتقوى يا قدوس </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كمل فينا المحبة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاة ذو السيفين مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونجينا من ضربة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويجب لك العظمة يا قدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لك يحق التسبيح والسجود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاة مريم ني بارثينوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تحنن علينا يا رب وجود </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومنقذا من كل عكوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مالنا رجاء سواك </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونجينا من ضيق الحبوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جود علينا برضاك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونسألك باسم مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نحن الكل نصيح إليك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتجعلنا حول بيك أثرونوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ان تسامحنا وتقبلنا إليك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبارك شعبك وأجعله محروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> هب لنا توبة يا ديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاة الشهيد مرقوريوس<span style="mso-spacerun:yes">      </span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وخلص من كان في أحزان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونجيهم من شر بي كوزموس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأحفظ يا رب جميع الحضار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيلوباتير مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشفاعة شهيدك المختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شمامسة وقمامصة وقسوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا تنس رتب بيعتنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خدام اسرارك يا قدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واساقفة أيضًا ومطارنة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بوصاياك وحافظ الناموس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأب الآباء الحبر العامل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> اجعله بطول المدي محروس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومكمل كل الفضائل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أنبا (</span><span dir="ltr" style="mso-bidi-font-family:&quot;Times New Roman&quot;; font-weight:700">…</span><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">) تاج الرؤوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بطركنا أسمه ما أحلاه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ثبته هيجين بيف أثرونوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الساهر عنا بالصوم والصلاة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأفتح لنا باب الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا رب اسمعنا وارحمنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاة محب الآب مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكن معنا وساعدنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> اترجي عفوك يا قدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأنا الناظم عبد ضعيف </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من قرية تدعي برهمنوش</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عبد الحضار سعد يوسف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> القائل تعالوا إلى الفردوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا تحرمنا من الصوت اللطيف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وخطايانا ثقيلة فوق الرؤوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأن تيرك هين وحملك خفيف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ملتمسًا منك ياباشويس ايسوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأختم مديحي وأقوالي</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاة ذو السفين مرقوريوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ان تساعدني في جميع أحوالي</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKS��+�␀␀+�␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/n8.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد فيلوثاؤس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>ونمجده فى علو سماه</h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>نسبح الإله</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قبل التوبة والحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>لا يشاء موت الخطاة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> ترك المعبود الحقير</h3>
    </div></td>
    <td><div align="center">
      <h3>فيلوثيؤس الصغير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> يعرفه الحقيقة والتفسير</h3>
    </div></td>
    <td><div align="center">
      <h3> وبحث عن إله قدير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكلمه بكلام مسموع</h3>
    </div></td>
    <td><div align="center">
      <h3>ظهر له الرب يسوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وطلب منه بدموع</h3>
    </div></td>
    <td><div align="center">
      <h3>سجد له بخشوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>معناه محب الإله</h3>
    </div></td>
    <td><div align="center">
      <h3>فيلوثيؤس ما أحلاه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقدم حياته لرضاه</h3>
    </div></td>
    <td><div align="center">
      <h3>أحبه وسمع نداه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقتل العجل المنجوس</h3>
    </div></td>
    <td><div align="center">
      <h3>صلى فيلوثيؤس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ربنا إيسوس بخرستوس</h3>
    </div></td>
    <td><div align="center">
      <h3>أقام أبواه باسم القدوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وعبدوا الرب القدوس</h3>
    </div></td>
    <td><div align="center">
      <h3>اعتمدوا بإسم الثالوث</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واستحقوا السماء الفردوس</h3>
    </div></td>
    <td><div align="center">
      <h3>مُحيي كل النفوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وحسد عبيد إيسوس</h3>
    </div></td>
    <td><div align="center">
      <h3>ثار الشيطان المنجوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بكل أصناف وجنوس</h3>
    </div></td>
    <td><div align="center">
      <h3>عذبهم دقلديانوس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومضوا للسماء بتهليل</h3>
    </div></td>
    <td><div align="center">
      <h3>نالوا الأكاليل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كرمهم بمجد جليل</h3>
    </div></td>
    <td><div align="center">
      <h3>ويسوع عمانوئيل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ووبَّخ دقلديانوس</h3>
    </div></td>
    <td><div align="center">
      <h3>ثار فيلوثيؤس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يشرب السم بالكئوس</h3>
    </div></td>
    <td><div align="center">
      <h3>أمر بعذاب مدروس</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والسم منه شرب</h3>
    </div></td>
    <td><div align="center">
      <h3>رشم الصليب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وفرح كل قريب</h3>
    </div></td>
    <td><div align="center">
      <h3>ونجا بأمر عجيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>عذبوه بكل وسيلة</h3>
    </div></td>
    <td><div align="center">
      <h3>الجنود العنيفة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وعده بأكاليل نفيسة</h3>
    </div></td>
    <td><div align="center">
      <h3>والملاك رافائيل بالحقيقة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مسح له الدموع</h3>
    </div></td>
    <td><div align="center">
      <h3>ظهر الرب يسوع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>جهادك صار مرفوع</h3>
    </div></td>
    <td><div align="center">
      <h3>ووعده بالصوت المسموع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأكمل استشهاده</h3>
    </div></td>
    <td><div align="center">
      <h3>تمم جهاده</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى حياته وبعد مماته</h3>
    </div></td>
    <td><div align="center">
      <h3>وظهرت معجزاته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>سيرتك روائح طيب</h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لك يا عجيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مع يسوع إلهنا الحبيب</h3>
    </div></td>
    <td><div align="center">
      <h3>اطلب لنا نصيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كل المؤمنين</h3>
    </div></td>
    <td><div align="center">
      <h3>تسبيح اسمك فى أفواه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>
        الشهيد فيلوثيؤس أعناأجمعين
      </h3>
    </div></td>
    <td><div align="center">
      <h3>الكُل يقولون يا إله</h3>
    </div></td>
  </tr>
</table>
</body>
</html>
