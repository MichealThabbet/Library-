  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><font face="Times New Roman"><span style="font-weight: 700">بنيوت افا كيرلس</span></font></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000" face="Times New Roman"><span style="font-weight: 700">الى ديرهم مسرعين</span></font></h3>
