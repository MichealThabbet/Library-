<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمرقس الرسول-السلام لك يا مار مرقس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA"> يا ابن أرسطوبولس</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA"> السلام لك يامارمرقس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA"> يا</span> <span lang="AR-SA" xml:lang="AR-SA"> كاروز باسم إيسوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> اسمك فى كل مكان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مولود فى القيروان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خالد كل الأزمان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فى أرض القديسين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> من ليبيا لفلسطين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جيتم لها هاربين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> شربت ماء الينبوع</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تبعت الرب يسوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وبشرت فى الربوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أسد ولبؤة يسيران</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مرقس مع أبيك تجدان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> صليت فمات الوحشان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جعلت بيتها كنيسة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مريم أمك قديسة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> خدمت خدمة نفيسة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أرسل إليكم يريد</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ويسوع فى مكان بعيد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> صنع الفصح العتيد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تمم السر الخطير</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> صنع الفصح الأخير</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وتأنى على الشرير</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أمسك بك الشبان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تبعت يسوع إلى البستان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> هربت منهم عريان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> الله القوى الجبار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وفى حياتك أسرار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بها خلاص الأبرار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حل الروح المعين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وفى بيتك يوم الخمسين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> على كل المجتمعين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فى وضح النهار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مثل ألسنة نار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مستقرًاعلى لأطهار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جميع أهل الجهات</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فتكلمتم بلغات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تصحبكم الآيات</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> إليكم بكل خضوع</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ثم جاءت الجموع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> آمنوا بالرب يسوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> سلكوا بتوجيه وإشراف</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> اعتمدوا ثلاثة آلاف</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وعاشوا بالعفاف</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> ذهبتم مبشرين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بعد يوم الخمسين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لكل العالمين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يا محبًا أتانا</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مارمرقس يا أبانا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> للإيمان هدانا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يصرخ إيسئوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما سمعت أنيانوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عرفته طريق بخرستوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> رسمت إنيانوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لخدمة النفوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أسقفًا مع قسوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> للعلوم اللاهوتية</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أسست كلية</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أول إكليريكية</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بطاركة وعلماء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> منها ظهر الآباء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> حفظوا الإيمان بدماء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بكتابةإنجيلك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بالروح أوحى لك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> محفوظ لك تبشيرك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> وجميع بنى الإنسان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> كتبت للرومان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عن الملك الديان</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بدم الإستشهاد</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> قد كملت الجهاد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لما جاء الميعاد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> جرك عوعاء وعبيد</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يوم إحتفال العيد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> والنار لهيبها يزيد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> والسحاب يحمل مياه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> يامن ذهب لسماء</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تطفئ نار الأثمة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> صار لنا عادة</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> فى آخر برمودة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> لذكرى الشهادة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> الذى لاعين تراه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> من مثلك ناظر الإله</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> نسجد ونمجد إياه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> للحق على الحدود</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> مارمرقس ياعامود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> أسد خارج ليسود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك فى أفواه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b> <span lang="AR-SA" xml:lang="AR-SA">ماركوس بى أبسطولوس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> الكل يقولون ياإله مارمرقس</span></b></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKbz���J␀␀�J␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r14.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<font color="#000000"><span style="font-size: 18pt; font-weight: 700"> لخلاص البشريين أرسل مرقس بشير</span></font>
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمرقس الإنجيلي-الرب الإله العظيم</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> عرفهم سر الثالوث حتى أمنوا بالتبشير</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">الرب الإله العظيم دبر لنا تدبير</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> كم شفى من مرضى وكم اقام اموات</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">صاروا من اهل الملكوت بعجائب شتى وأيات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">كسر جيش الشيطان وهزم كل قواه</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">وكم فتح عميان وابطل عبادة الأوثان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> بعد ان كانت ظلام بالأيمان انارها</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">نور حقيقى اشرق فى مصر وتخومها</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">  
        اسكندرية ادعى اصحابك وتلقيه بالتهليل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">مصر زينى ابوابك لكاروز عمانوئيل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">وجبال افريقيا والبلاد النوبية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">تفرح مدينة نيقية والمدن الغربية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">تقول السلام للوكيل الأمين من اتاهم بالأنجيل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">يفرح كل المصريين والحبشة متهللين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">مرقس ناظر الإله كاروز الديار المصرية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام للمبشر بالحياه الأبدية</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> السلام لتلميذ الديان مداوى كل سقيم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام لكاروز الأيمان المبشر العظيم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام لمن قد كان راحة للمتعبين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام لرسول السلام معزى المؤمنين</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> مبشر العهد الجديد لخلاص كل الأنفس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام للشهيد القديس مار مرقس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> السلام لك يا مجدد لنا شريعة الأيمان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام لك يا مبدد عبادة الأوثان </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> السلام للبطل الظاهر صاحب القول المجلى</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام للقديس الطاهر مرقس الأنجيلى </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> السلام للمثبت الأمانة الأرثوذكسية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">السلام لمؤسس رتبة البطريركية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> يثبتنا فى الأيمان الأن وكل أوان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">أطلب من الديان صاحب الجود والأحسان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> ليخلصنا من كل دنس </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">اشفع فينا يا مرقس أمام الحضرة الإلهية</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700"> الكل يقولون يا إله مار مرقس أعنا أجمعين </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><span style="font-weight: 700">تفسير اسمك فى افواه كل المؤمنين </span></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
