<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا ساويرس البطريرك الأنطاكي</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b> <span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> أسبحه فى غدواتى</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  الرب قد أعطانى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وانشد كل أوقاتى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> نسبح إلهنا المعين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  لنبدأ يا مؤمنين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ونرتل له فرحين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وابتهجوا مرنمين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  هلموا يا حاضرين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فإنه اليوم يوم عيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> والعلوم الكنسية</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  بالحكمة الروحية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> صار معلم الأرثوذكسية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> ليكون راعى الرعاة</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  اختارته عناية الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لشعب إنطاكية دعاه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> ليقود بها شعبه</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  حكمة وهبت له</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وليحفظ أسراره</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> شفى المعتدين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  باسم الله الأمين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وأخرج الشياطين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA">  وعلى المنابر جاهر</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى المجامع حاضر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وللعقائد فسر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وأعطاه النعمة</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  الرب خلد اسمه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فاستحق الدعوة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> الولاه ويوسطينوس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  حرك الشيطان الإبليس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أنه يحيد عن إيسوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> من عدم إذعانه لرأيه</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  غضب الملك منه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وأمر بقتله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وفى السجن طرحوه</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  بالأحجار رموه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وحكموا أن ينفوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> ليهرب من قتله</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تاؤدوره أوعزت له</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ليحقق ما قصده</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> جنودًا من عنده</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أرسل الملك خلفه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فمن نظره حجبه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> فى الثانى من بابه الشهر</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  جاء إلى أرض مصر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ليهرب من الأسر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وحارب الخلقدونية</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  سهر على الرعية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لئلا تدمر الأرثوذكسية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> رسائل ومقالات</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  كتب فى منفاه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أرسلها لأحباه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> فجلس بين الناس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  اشتاق للقداس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى زى &quot;موناخوس&quot;</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وفى البيعة أظهره</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  ملاك الرب أحاطه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بأعجوبة لتطويبه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وجد اختفاء القرابين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  عند رفع الابروسفرين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">فحدد الملاك تعيين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> فوجد القربان</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أدخل الهيكل بالألحان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> فى موضع الغفران</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وتيقنوا عقائد الأبرار</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  آمن الجميع بالأسرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وقوة سر الأسرار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> أرخن محب لآلهه</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى مدينة سخا استضافه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> إلى يوم نياحته</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> آتاه صوت البشير</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى الرابع عشر من أمشير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ليضمه للمفديين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> وفى دير الزجاج طوبوه</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  فى العاشر من كيهك نقلوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا ساويرس</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> وبين القديسين وضعوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك فى أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span style="font-family: Arabic Transparent" lang="AR-SA" xml:lang="AR-SA">  الأنبا ساويرس أعنا آجمعين</span></b></h3></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله </span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK��T1RN␀␀RN␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/i3.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>السبعون رسول</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> من له العظمة  
        والسلطان</font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> أبدأ باسم الله 
        القدوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> منشئ الكون خالق الإنسان</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> مخلصنا إيسوس بخرستوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> الساكن في نور من نور</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> الجالس فوق الشاروبيم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> مسجود له مدى الدهور</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> الممجد من السيرافيم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وتأنس من العذراء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> أضاء علينا نور علاه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وتمم لنا الفداء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وحل فينا ورأيناه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بشروا لكل الآنام</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> اختار أثني عشر رسول</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> لمحو الخطايا والآثام</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> كرزوا ببشارة الإنجيل</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ردوا الأمم إلى الحياة</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> اختار سبعين آخرين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ببشرى الخلاص والنجاة</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> جالوا في العالم مبشرين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> مرقس الرسول ناظر الإله</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> كاروز الديار المصرية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> نبع الرب وحفظ وصاياه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> من الخمس مدن الغربية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وفي لبنان وفي أنطاكية</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بدأ يبشر في اليهودية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ثم جاء إلى أفريقيا</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> مع بولس بشر في رومية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بشر بقوة واجتهاد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> في الخمس مدن الغربية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> كرز ونال الاستشهاد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وأخيرًا في الإسكندرية</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> باع أملاكه بغير تقصير</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> برنابا كبير القلب كريم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> في أول رحلات التبشير</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بشر مع بولس الحكيم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> رجموه بقسوة وعناد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> قبض عليه الشهود ضربوه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ونال إكليل الاستشهاد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وبغير شفقة أحرقوه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وثني لا يعرف رب السماء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> لوقا الرسول كان طبيب</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> يبرئ المرض بغير دواء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> آمن حين رأى الحبيب</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> معه في الأتعاب والترحال</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> كان لبولس نعم الرفيق</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ثم كتب سفر الأعمال</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> كتب إنجيله بالتدقيق</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بغير خوف أو إهمال</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> في رومية أكمل التبشير</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> قال له أنت ساحر دجال</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> قبض عليه نيرون الشرير</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> أنا عبد ليسوع البار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> أجابه لوقا الحكيم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وألقى جسده في النار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> قطع رأسه بحقد عظيم</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> اختاره الرب وسار معه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> متياس واحد من السبعين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> عينه الروح عوضًا عنه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وبعد هلاك يهوذا الخائن</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وصنع آيات ومعجزات</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بشر آكلي لحوم الإنسان</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وآمنوا برب السموات</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> فتاب عبّاد الأوثان</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> على حديد محمي بالنار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> في دمشق كرز فوضعوه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> يضيء كالشمس بالنهار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وآمنوا حين رأوه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> مملوء من الروح القدوس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> إسطفانوس معناه إكليل</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ليكون للشمامسة رئيس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> اختاره الاثنى عشر رسول</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> لم يقدروا أن يقاوموه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بقوة وبخ اليهود</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> كذب وفي المجمع حاكموه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وأقاموا عليه شهود</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وهو ناظر إلى السماء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> خارج المدينة رجموه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وصار أول الشهداء</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> طلب الغفران لمن قتلوه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بشر السامرة بكل نجاح</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> فيلبس الشماس من السبعين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ورقد في الرب بنياح</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> عمد الخصي ورد الكثيرين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> رجل صالح مملوء أثمار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> أسقف دمشق حنانيا الرسول</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> فهو لي إناء مختار</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> قال له الرب عمد شاول</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بشر اليهود والأمميين</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> صنع آيات عظيمة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> رجموه وفرح مع المتنصرين</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> ونال عذابات أليمة</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وكان من بيت عنيا</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> لعازر الرسول حبيب يسوع</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وأقامه من الموت حيًا</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بكى عليه الرب بدموع</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> رعى خراف رب الآنام</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> صار لقبرص راعيًا أمين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ورقد في الرب بسلام</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بشر ورد الكثيرين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> هو سيلا أو سلوانس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> رسول جليل نبي وبار</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وأيضًا خدم مع بطرس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> مع بولس في سجن وأسفار</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> خدم التلاميذ بشر كثيرين</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وأولمباس أحد السبعين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> من بطرس وبولس الرسولين</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وحمل رسائل للمؤمنين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> صلب منكس على الصليب</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> مثل بطرس معلمه</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> في الخامس من شهر أبيب</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وفي كال عام تذكاره </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وكريت هي مسقط رأسه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> تيطس الرسول وديع صديق</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وصار أسقفًا على شعبه</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> صار لبولس معين ورفيق</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> نبي وكارز باجتهاد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> رسول محبوب اسمه أغابوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> رجم وفاز بالاستشهاد</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> تنبأ بالقبض على بولس </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وكرز في القسطنطينية</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> سمعان الدباغ أضاف بطرس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> بشر كولوسي ولاودكية</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وأبفراس خدم مع بولس </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> خدما في كولوسي خدمة نفيسة</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> فليمون وابنه أرخبس </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وبينهما كان كنيسة</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وكانا من رفقاء بولس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> في سجن روما خدم بولس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> والقديس أنسيفوروس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وعذبه واليها أوريانوس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بشر في مدينة أفسس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> مضيف بولس في كورنثوس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> ولا ننسى القديس غايس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> قام بخدمة عظيمة مع بولس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> وأيضًا فرتوناتوس</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> صار أسقفًا على طرسوس</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> والرسول القديس ياسون</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> وفي السجن علم اللصوص</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> بشر وعمد الكثيرين</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> يا من أنرتم عيوننا</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> لكم التكريم أيها السبعون</font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"> ليغفر الرب خطايانا</font></h3></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"> أطلبوا عنا أيها القديسون</font></h3>
    </div></td>
  </tr>
</table>
</body>
