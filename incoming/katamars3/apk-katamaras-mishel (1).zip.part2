<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيدة إيريني</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> المتعالى فى سماه<br />
    </h3></td>
    <td width="50%"><h3 align="center">  لأمجد الإله<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> وامدح عذراء فتاة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أبوها هو الوالى<br />
    </h3></td>
    <td><h3 align="center">  أصلها عريق عالى<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> وجمالها متلالى<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> لأبويها معزية<br />
    </h3></td>
    <td><h3 align="center">  أميرة مقدونية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> وحيدة ونقية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأسرعوا وبنوا لها<br />
    </h3></td>
    <td><h3 align="center">  أحبها أبواها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> برج حصين يحميها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> لك متع المسكونة<br />
    </h3></td>
    <td><h3 align="center">  هنا عيشى مصونة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> وفتيات للمعونة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فخر لعلماء الجيل<br />
    </h3></td>
    <td><h3 align="center">  ومعلم لك أصيل<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> إكرميه واعطيه تبجيل<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تهافتت عليها الرؤوس<br />
    </h3></td>
    <td><h3 align="center"> كبرت تلك العروس<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> قصدها أبوها ليكيتيوس<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أولئك كبار بلدان<br />
    </h3></td>
    <td><h3 align="center">  هؤلاء أمراء حسان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> فاختارى زين الشبان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأعلم من أختار<br />
    </h3></td>
    <td><h3 align="center">  يكفى أسبوع أتدبر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> لأعيش فى سعادة أوفر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> والعالم من أنشاه<br />
    </h3></td>
    <td><h3 align="center">  قصرى أبويا بناه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> دا عظيم هو الإله<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> إذا وقع ينكسر<br />
    </h3></td>
    <td><h3 align="center">  لا يكون أبدًا حجر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> من يعبده يتعثر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> برؤية تفسر بحساب<br />
    </h3></td>
    <td><h3 align="center">  أجابها خالق الألباب<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> حمامة ونسر وغراب<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ستعرفى القدير<br />
    </h3></td>
    <td><h3 align="center">  فسرها لها الخبير<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> ورسوله لك ينير<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأعطاها مناها<br />
    </h3></td>
    <td><h3 align="center">  ملاك الله عزاها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> تى أجيا أيرينى<br />
    </h3></td>
    <td><h3 align="center"> رسول يسوع يلقاها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وقف أمامها يبوح<br />
    </h3></td>
