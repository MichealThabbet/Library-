<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">القديس أبو مقار الكبير</h1>
	<h1 align="center">( أبدى باسم إله قدير )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center"> دائم باقى بغير تغيير </h3></td>
    <td width="50%" class="auto-style1"><h3 align="center"> + أبدى باسم إله قدير </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وأمدح هذا الكوكب المنير  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وإرادة الله العلوية </h3></td>
    <td class="auto-style1"><h3 align="center"> + بتدبير العناية الإلهية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> ولد القديس بقرية المنوفية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  نمجد الرب فى كل حين </h3></td>
    <td class="auto-style1"><h3 align="center"> + تعالوا يا جميع المؤمنين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> ونصيح جميعًا مطوِّبين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وبصوت المحبة قد ناديت </h3></td>
    <td class="auto-style1"><h3 align="center"> + ثوب النعمة به إلتحفت</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> و لثمرة الفضيلة قد إشتهيت </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  كى يصطادك بشباكه </h3></td>
    <td class="auto-style1"><h3 align="center"> + جه إبليس بفخاخه </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> والرب عنك قد أزاحه </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وأحببت سُكنى الفنار </h3></td>
    <td class="auto-style1"><h3 align="center"> + حين تركت الديار  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> لتصلى ليل ونهار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   وبالإسكيم تمنطقتَ </h3></td>
    <td class="auto-style1"><h3 align="center"> + خوذة الخلاص لبستَ </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وبالمحبة توشحتَ </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   ولم تدافع عن هذه البلية </h3></td>
    <td class="auto-style1"><h3 align="center"> + دبروا لك فعل الخطية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وتمسكت بالعفة والبتولية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   فجعلتَه بساتين وزهور </h3></td>
    <td class="auto-style1"><h3 align="center"> + ذهبتَ لوادى النطرون  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> والرب ألبسك حلة من نور  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  ولمحبة المسيح صنديد </h3></td>
    <td class="auto-style1"><h3 align="center"> + راسخ فى الإيمان وعنيد </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> ولكنوز المال لا تريد </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وفاح عطرك كالطيب </h3></td>
    <td class="auto-style1"><h3 align="center"> + زينتَ وادى هبيب </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> فصرت ملجأ وطبيب </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  تنور الطريق كالمصباح </h3></td>
    <td class="auto-style1"><h3 align="center"> + سيرتك عطرها فاح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> قارئها قلبه يرتاح  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  ووادى النطرون عمَّرته </h3></td>
    <td class="auto-style1"><h3 align="center"> + شعب شبشير تركته </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وزرعت أرضه وشجَّرته </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  ونلت كرامات سمائية </h3></td>
    <td class="auto-style1"><h3 align="center"> + صبرتَ بمحبة إلهية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وصرت منار للرهبانية  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  دون ذنب بل بإفتراء </h3></td>
    <td class="auto-style1"><h3 align="center"> + ضربوك الأردياء </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> كل هذا ولم تستاء </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   يا من حاربتَ إبليس </h3></td>
    <td class="auto-style1"><h3 align="center"> + طوبى لك يا قديس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وفزتَ بإكليل نفيس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   مع طغمات السمائيين </h3></td>
    <td class="auto-style1"><h3 align="center"> + ظهر لك الكاروبيم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وأعطوك السلام قائلين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وأحببتَ سكنى الملكوت </h3></td>
    <td class="auto-style1"><h3 align="center"> + عبرتَ وادى ظل الموت </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> طوباك طوباك جى بنيوت </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بالسهر والاستعداد </h3></td>
    <td class="auto-style1"><h3 align="center"> + غلبتَ كل حيل المضاد </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> والصلاة الدائمة والجهاد </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   واتَّهمت مقارة بسؤ نية </h3></td>
    <td class="auto-style1"><h3 align="center"> + فتاة سقطت فى الخطية  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> فاحتمل العار والأذية  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   وندمَتْ على كذبتها </h3></td>
    <td class="auto-style1"><h3 align="center"> + قامتْ وفكرتْ فى فعلتها </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> واعترفتْ بخطيتها  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  لأن فكرته لم تدوم </h3></td>
    <td class="auto-style1"><h3 align="center"> + كان الشيطان مهزوم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> فتراجع بالخزى والهموم  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وقابل القديس أنطونيوس </h3></td>
    <td class="auto-style1"><h3 align="center"> + لما هدأت النفوس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> وتكلم عن جميع الطقوس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">    يا صاحب الرحمة والغفران </h3></td>
    <td class="auto-style1"><h3 align="center"> + منك نسأل يا ديان   </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> أن تُديم علينا الإيمان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  أن تكون معنا فى الدينونة </h3></td>
    <td class="auto-style1"><h3 align="center"> + نسأل من الأم الحنونة  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> نطلب شفاعتها والمعونة  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  واكسر عنا فخ الشيطان </h3></td>
    <td class="auto-style1"><h3 align="center"> + هَب لقلوبنا الإيمان  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> بشفاعة أم الديان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   نسجد ونمجد قائلين </h3></td>
    <td class="auto-style1"><h3 align="center"> + ونحن الشعوب المسيحيين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> ارحمنا يا رب يا معين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  فرج عبدك وطالب غفران </h3></td>
    <td class="auto-style1"><h3 align="center"> + لا تنسى الناظم يا رحمان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت إثؤواب آفا مكاريوس </h3></td>
    <td class="auto-style1"><h3 align="center"> بشفاعة مريم ست الأكوان </h3></td>
  </tr>
  <tr>
