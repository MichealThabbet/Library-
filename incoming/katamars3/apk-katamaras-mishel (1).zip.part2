<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد إستفانوس-أنا أفتح فمي بحمد الله</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> الآب والابن والروح القدس<br />
    </h3></td>
    <td width="50%"><h3 align="center">  أنا أفتح فمى بحمد الله<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وأمدح أول الشهداء<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> اختار الرب القدوس<br />
    </h3></td>
    <td><h3 align="center">  بتدبير العناية الإلهية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> سبعة رجال بسيرة تقية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فحل عليهم بروحه القدوس<br />
    </h3></td>
    <td><h3 align="center">  تم وضع اليد عليهم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وأرشدهم بأن رئيس<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> محب لخلاص النفوس<br />
    </h3></td>
    <td><h3 align="center">  ثابت فى الإيمان والنعمة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> مملوء من الروح والحكمة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وكان كلامه من النصوص<br />
    </h3></td>
    <td><h3 align="center">  جاهر بلسانه الفصيح<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> أن الإيمان بالمسيح هو الصحيح<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> من الكتب والناموس<br />
    </h3></td>
    <td><h3 align="center">  حاوره اليهود وحاورهم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وبحكمته قد افحمهم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> عن ماهو منصوص<br />
    </h3></td>
    <td><h3 align="center">  خاطبهم من العتيقة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وأرشدهم إلى الحقيقة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أنه قد خالف الناموس<br />
    </h3></td>
    <td><h3 align="center">  دسوا الكلام عليه وقالوا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فلم يقدروا ولم ينالوا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أن المسيح حيى النفوس<br />
    </h3></td>
    <td><h3 align="center">  ذلك الشهيد قال بثبات<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وصنع عجائب وآيات<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ونظر إليه جميع الجلوس<br />
    </h3></td>
    <td><h3 align="center">  رتبوا له تدابير الهلاك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فرأوا وجهه كوجه ملاك<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> عن الكتاب الله القدوس<br />
    </h3></td>
    <td><h3 align="center">  زاد فى الشرح والتوضيح<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وأفحم اليهود بكلامه الصريح<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وهو يكلمهم من الناموس<br />
    </h3></td>
    <td><h3 align="center">  سمعه شعب اليهود العنيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فغضبوا وقبضوا على الشهيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وهو يسبح القدوس<br />
    </h3></td>
    <td><h3 align="center">  وعندما قبضوا عليه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> رافع إلى السماء عينيه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ها أنا أنظر عرش القدوس<br />
    </h3></td>
    <td><h3 align="center">  صرخ الشهيد بملء فيه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center">  والمسيح جالس عن يمين أبيه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وهو يرتل قائلًا قدوس<br />
    </h3></td>
    <td><h3 align="center">  ضربوه رجمًا بالحجارة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وازداد قوة واستنارة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وقال أيها الرب القدوس<br />
    </h3></td>
    <td><h3 align="center">  طلب من العزة الإلهية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> لا تقم لهم هذه الخطية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> حين تشبه بالقدوس<br />
    </h3></td>
    <td><h3 align="center">  ظهرت عظم محبته<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فسامح أعداءه بإرادته<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> حين أسلم روحه للقدوس<br />
    </h3></td>
    <td><h3 align="center">  عليه الحجارة قد انهالت<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> ففرحت الملائكة وقالت<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأعطاه الإله إكليل مخصوص<br />
    </h3></td>
    <td><h3 align="center">  غلب الأعداء المكابرين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> واليهود لا زالوا معاندين<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وصاحوا قائلين أكسيوس<br />
    </h3></td>
    <td><h3 align="center">  فرحت الأجناد السمائية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> مستحق الحياة الأبدية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وحملوا جسد استيفانوس<br />
    </h3></td>
    <td><h3 align="center">  قام الرجال الأتقياء<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وصارت مناحة واستياء<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وفاز بنعيم الفردوس<br />
    </h3></td>
    <td><h3 align="center">  كمَّل جهاده المجيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فدعته الكنيسة أول شهيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وخدم الرب القدوس<br />
    </h3></td>
    <td><h3 align="center">  لبس ثوب الفضيلة والوقار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فى مذبح كنيسة الأبكار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> إكليل يوضع فوق الرؤوس<br />
    </h3></td>
    <td><h3 align="center">  تفسير اسمك ما أحلاه<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> فاطلب عنا أمام الإله<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا من اخترت باى مارتيروس<br />
    </h3></td>
    <td><h3 align="center">  نطلب إليك يا ذا الجلال<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> لا تحرمنا الفوز والإقبال<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وانعم لنا بنعيم الفردوس<br />
    </h3></td>
    <td><h3 align="center">  هب لنا توبة وغفران<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> بشفاعة شهيد الإيمان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وكذلك الشمامسة والقسوس<br />
    </h3></td>
    <td><h3 align="center">  لا تنس بطريرك هذا الزمان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> وثبت شعب البيعة فى الإيمان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وامنحنا ملكوتك يا قدوس<br />
    </h3></td>
    <td><h3 align="center">  يارب اغفر لنا خطايانا<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> رئيس الشمامسة استيفانوس<br />
    </h3></td>
    <td><h3 align="center"> بشفاعة من خدمك بأمانة </h3></td>
  </tr>
