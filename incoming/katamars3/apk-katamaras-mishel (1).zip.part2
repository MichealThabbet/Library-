  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا ابراكسية</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1">قصدت أقدس سيرة<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">وقدوة للراهبات</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + يا فخر وزينة البنات<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">تى 
	  آجيا أبراكسيا</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1">معينة فى الضيقات<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">أدمعت طالبة فاديها</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + والكسيح فى إيديها<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">تى 
	  آجيا أبراكسيا</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1">فجرى شاهدًا لِها<br />
