      <h3><font face="Times New Roman"><span style="font-weight: 700">سكنت هناك فى النور  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> من كيهك نتذكر</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فى اليوم السادس عشر </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بى اسؤواب آفا ياكوبوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">تدشين البيعة بفخر</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> لنقاوة اعمالك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">اطلب من اجلنا  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> بى اسؤواب آفا ياكوبوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">واستنارة عقولنا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  كل المؤمنين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">تفسير اسمك فى افواة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   القديس يعقوب اعنا اجمعين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الكل يقولون يا اله  </span></font></h3>
    </div></td>
  </tr>
</table>
