  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">أبواه كان مسيحيين</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ولد فى الاقصرين</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت أفا متاؤس</h3></td>
    <td><h3 align="center"><span style="font-weight: 700">للرب عابدين</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">من القلب يترجاه</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">طلب الرب فى صباه </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت أفا متاؤس</h3></td>
    <td><h3 align="center"><span style="font-weight: 700"> دايما يبغى رضاه </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وهدوء البرية </span></h3></td>
