  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أضطهد المسيحيين </span></b></h3>
