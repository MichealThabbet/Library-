<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا بيشوي حامل المسيح-في كنيسة الغالبين</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">الأبرار 
        البتوليين</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في كنيسة 
        الغالبين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مثال للكاملين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يضيء وجهك كملاك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  في مجمع النساك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يقولون طوباك طوباك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> زينة وادي هبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الإسكيم والصليب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> منك يفيح الطيب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الرب ودعالك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  إختارك منذ صباك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأشار عليك الملاك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في طريق الكمال</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  صرت لشيهات مثال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إلى مدى الأجيال</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا حبيب إبن الله</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  طوباك يا أنبا بيشوي</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> زارك مثل صديق</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وغسلت له قدماه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يداك أخذت مياه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وعشت في رضاه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وتباركت أقوالك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  فأضاءت أعمالك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وصرت لكمالك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والسهر في معناه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  الجهاد في الصلاة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> منك تعلمناه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مثل أوتار العود</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  الحبل كان مشدود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تقول مزامير داود</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بعيون لا تنام</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  وديعًا كالحمام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ولا تخطئ في الكلام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في سجود وركوع</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  في صلاة بخضوع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في توبة ودموع</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> على منكبيك بوقا</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  حملت يسوع البار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> صرت كرسي المختار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بقلب فرح أمين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  حملته كمسكين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وهو فادي العالمين</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأضاءت الجروح</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  فتجلى لك بوضوح</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فصرخت بفرح الروح</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تواضعك ما أحلاه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يا ممجد في سماه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بينيوت آفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنا أول الخطاة</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> والأرض موطئ قدميك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  السماء هي كرسيك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأنا صنعة يديك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأنت رب الأمجاد</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أنا تراب ورماد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إلى أبد الآباد</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> المملوء تعظيم</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  مركبة الشاروبيم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تحملك يا كريم</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنت هو حسبي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  وأنا خاطي يا ربي</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تغاضى عن ذنبي</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يا بيشوي لك السلام</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  فقال رب الأنام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مغفورة لك الآثام</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> أمرت إلى الآباد</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  أنا رب الأمجاد</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> لا يرى جسدك فساد</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يضيء وجهه بحبور</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  فنهض فرحًا مسرورًا</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت افا بيشوى</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> ويرنم المزمور</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا أيها الينبوع</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  أمجدك يا يسوع</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> إليك أعطش وأجوع</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> لأنك إحتضنتني</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  أعظمك يا ربي</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> ولم تشمت بي عدوّي</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> وتبتهج بك روحي</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  تعظمك نفسي</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا الله مخلصي</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG"> يا ضياء ميزان القلوب</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-EG" xml:lang="AR-EG">  إسمك في شيهات محبوب</span></b></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> علمني كيف أتوب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأطلب من الآب عنا</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أذكر نقائصنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وبصلاتك أعِنّا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وقدوم رئيس الأحبار</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  بعيدك أيها البار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنبا شنوده المختار</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بيد بابا قدير</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  ومشروع التعمير</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> حكيمًا في التدبير</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> برجًا عاليًا بحصون</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  والأنبا صرابامون</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوى</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> به نحن فرحون</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بالأبهات ورهباننا</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يا فرحة كنيستنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بصلواتهم ثبِّتنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وشركاؤه أساقفتنا</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  يا رب إحفظ بطركنا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وكهنتنا ورهباننا</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> سائر كل الأحباب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  وإحفظ يا رب الأرباب</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت أفا بيشوي</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الحضار والغياب</span></b></h3>
    </div></td>
  </tr>
</table>
