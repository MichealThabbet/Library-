    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قطعوا رأس الشهيد
        </p>
        </font></h3>
    </div></td>
    <td><div align="center">
      <h3>الوالي وإفعاريت
        </p>
        </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الشهيد جيؤرجيوس</h3>
    </div></td>
    <td><div align="center">
      <h3>ولم يعطوه التمجيد
        </p>
        </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بقوة وإمتثال
        </p>
        </font></h3>
    </div></td>
    <td><div align="center">
      <h3>ودم الشهيد سال
        </p>
        </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الشهيد جيؤرجيوس</h3>
    </div></td>
    <td><div align="center">
      <h3>ليس لها مثال
        </p>
        </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>البلدة المحمية
        </p>
        </font></h3>
    </div></td>
    <td><div align="center">
      <h3>حملوه إلى كبادوكية
        </p>
        </font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الشهيد جيؤرجيوس</h3>
    </div></td>
    <td><div align="center">
      <h3>لبناء &quot;تي إكليسيا&quot;</p>
        </font></h3>
    </div></td>
  </tr>
</table>
