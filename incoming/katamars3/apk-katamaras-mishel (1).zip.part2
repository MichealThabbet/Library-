  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بشر بالمسيحيه </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فى نواحى روميه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بغيرة وحمية </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> مع اليهود الخوان </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فاتفق عابدو الاوثان 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وذهبوا باتقان </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">نيرون الطاغى المجنون </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">الى الملك الملعون </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ووشوا له بفنون </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> رد بسحره العظيم </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بانه ساحر لئيم </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">قوما بفعل التعليم </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">اعطى كتبه يا اخوان </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">اما القديس فكان </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">لرجل صياد منصان </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وبدا بسؤاله </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فامر باحضاره </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">عن سحره وضلاله 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">انا لست عبد لابليس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فاجابه 
        القديس </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بل رسول نفيس </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> ابن الله بالصحيح </span></b></font></h3>
    </div></td>
