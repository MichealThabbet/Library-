<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد البابا بطرس خاتم الشهداء-أفتح فاي بالتمجيد</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">واذكر 
        للتخليد</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أفتح فاى بالتمجيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> بنيوت آفا بيتروس</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> رئيس الكهنة الشهيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-SA" xml:lang="AR-SA"> عن بطرس خاتم الشهداء</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  أخبركم يا أحباء</span></h3>
