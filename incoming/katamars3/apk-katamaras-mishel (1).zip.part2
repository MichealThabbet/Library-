<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد سرابيون</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>فى أحضان القديسين</b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>فى كنيسة المنتصرين</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا سرابيون</b></h3></td>
    <td><div align="center">
      <h3>شهيد إلهنا الأمين</b></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> قلبه عامر بالتسبيح</b></h3></td>
    <td><h3 align="center"> كان محبا للمسيح</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا سرابيون</b></h3></td>
    <td><h3 align="center"> سيرته عبيرها يفيح</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أعطى الكل بسخاء</b></h3></td>
    <td><h3 align="center">وزع ماله على الفقراء</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت آفا سرابيون</b></h3></td>
    <td><h3 align="center">غير ناظر للوراء</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يشفق على كل إنسان</b></h3></td>
    <td><h3 align="center">كان ذا قلب حنان</b></h3></td>
  </tr>
