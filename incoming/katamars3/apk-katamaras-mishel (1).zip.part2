<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الأنبا شنودة الثالث - من أفاضل الأباء</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">والـرعــــاة الــرؤســــــــاء</h3></td>
    <td width="50%"><h3 align="center"> من أفـــاضــل الأبـــــــاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الـبابـا شـــنـودة المـعطــاء
     
    </h3></td>
    <td><h3 align="center">زادوا الكــرســــى إرتــــقــاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">اخــــتـاره ربّ الــعـــــــلاء</b>
    </h3></td>
    <td><h3 align="center">كبولس الرسول والإناء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ويـــزداد للملـكــوت أبــنـــاء</b></h3></td>
    <td><h3 align="center">للمسـكونة كـوكـب وضـــيـاء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كـاسـقـف لـلـديــر ومـــنـار</b></h3></td>
    <td><h3 align="center">أنـبـا ثـاؤفـيلـس باقـتدار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كــابـــــن لـــــه و بـــــَــــــار</b></h3></td>
    <td><h3 align="center">رهــبــنـه بـكـــل وقـــــــــــار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مـن ديــرنــا الســـــــريــان</b></h3></td>
    <td><h3 align="center" ><b> من أفـاضـــل الرهـبـــان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" >فـــضــــــائـــل الـبـســــتـــان</b></h3></td>
    <td><h3 align="center"><b>عــلّــم الـرهـــــبان بـحـــنـان</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">و وجـهـه يُشـــيــع ســـرور</h3></td>
    <td><h3 align="center">كـكـاهـن شـخصه وقــور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >كـقــــدوة لـــكـــل الـديـــــور</b></h3></td>
    <td><h3 align="center"><b>بإفـــــــراز يـمـنع شـــــــرور</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">لـيــس عــنــده تــفــضــيــل</b></h3></td>
    <td><h3 align="center">أب اعــــتـراف جـــلـيـل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ويشــعـرهـــم بـحـب جــزيـل</b></h3></td>
    <td><h3 align="center">يـقـابـل الـكــل بـتــهـــــلــيــل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كــــان يُــصـلـى بـحـــرارة</b></h3></td>
    <td><h3 align="center" ><b> سـكـن فـــترة بمغــارة</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">ليـقــود شـــعــبـه كـــمـنــارة</b></h3></td>
    <td><h3 align="center">لـكــن الـــربّ اخــــــــتـــــاره</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عـمـل وصـايــاه بخــضــوع</b></h3></td>
    <td><h3 align="center"> أحـب الــــربّ يــســـوع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يــرويــنـا و مـعــنـا جــمـوع</b></h3></td>
    <td><h3 align="center">فـصـــــــيـره لـنــا يــــنـبــوع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لـنـشــر الإيـمــان القــــويـم</b></h3></td>
    <td><h3 align="center">رســم اســقـفـاً للتعـلـيم</b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الأنبا كـــيـرلــس الـحـكــــيـم</b></h3></td>
    <td><h3 align="center">بـيـــد الــبابــا الـعـــظـــــــيــم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والـمعـــاهــــد الــــديـنــــيـة</b></h3></td>
    <td><h3 align="center"> كـمـديـر للإكــلـيركـيـة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـالـكــــــرازة الـشــــنـوديــة</b></h3></td>
    <td><h3 align="center">فـصـبـغـهـا بـدمــغـة قــــويـة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مـثـل حـبيب جـرجـس رائـد</b></h3></td>
    <td><h3 align="center">لمدارس الأحــد قــائـد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أعــطــاهــا إهتــــمــام زائــد</b></h3></td>
    <td><h3 align="center">و رغـــــم مـــــرور شـــدائـد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">اخــتارتــه لـلبـطـــريـركــية</b></h3></td>
    <td><h3 align="center"> العـــنـايــة الإلـهـــيــة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" ><b>والـــقرعـــة الهــــيكـــــلـــية</b></h3></td>
    <td><h3 align="center" >تــــزكــــيــة الــرعـــــــيـة</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">يُــصـلـى عـنـا كـشــــفـــيـع</b></h3></td>
    <td><h3 align="center">أصبح راعـياً للقـطـيـع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـمـواعــظ صـــوتـه الـبـديـع</b></h3></td>
    <td><h3 align="center">و يُـغـــذيـه بـمـا يـسـتـطـــيـع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مُـخـــــتـار مـن الــســـــماء</b></h3></td>
    <td><h3 align="center">كـراعـــى لـلـرُعـــــــاه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـى نـــــــــور مـــا أبـــهـــاه</b></h3></td>
    <td><h3 align="center">ظــهــرت والــــــدة الإلـــــــه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى كـنائـس فى بحـر سـنين</b></h3></td>
    <td><h3 align="center">تجـلـت أم السـمائـيـين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى عـهـــد البـابـا الأمـــــيـن</b></h3></td>
    <td><h3 align="center">و ظـهرت أعـضــاء لقديسين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كـمارمـرقـس عـبد إيـسوس</b></h3></td>
    <td><h3 align="center">نفـذ مـشـيئة الـقـدوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و أسـاقـفة لـرعـاية النفـوس</b></h3></td>
    <td><h3 align="center">فــرســم مـــئـات قـــســــوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـى أمــاكــــن جــــــديـــــدة</b></h3></td>
    <td><h3 align="center" ><b>  بنيت كنائــس عــدــيد</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" ><b><span style="font-family: " dir="rtl" lang="AR-SA" xml:lang="AR-SA"><font face="Times New Roman">بـحـكــمــتــة الـــرشـــــــيــدة</b></h3></td>
    <td><h3 align="center">وإيـــبـاروشـــيـات مـــزيـــدة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عـــــمّـــــر ديــــــــــــــارات</b></h3></td>
    <td><h3 align="center">علـى مـدى ســـنوات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فــى جـــمـــيـــع الـــقـــارات</b></h3></td>
    <td><h3 align="center">بـكـنـائــــس لـهـا مـــنـــارات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أرسـل أسـاقــفــة لــديـــوره</b></h3></td>
    <td><h3 align="center"> فـى أنحاء الـمعــمورة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـتـمـجّــــد الــــربّ بــنـــوره</b></h3></td>
    <td><h3 align="center">كـرائحـة المـسـيح و بـخـوره</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـــكـــر بــابــانــا الـمـبـرور</b></h3></td>
    <td><h3 align="center">لأديرة إندثرت لعصور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والـجـديـدة أحـاطـها بـســور</b></h3></td>
    <td><h3 align="center">فعـّـمـرهـا وخـرجـت لـلـنــور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـكــتــب كـــتـب و أشـعـــار</b></h3></td>
    <td><h3 align="center">لعقـله المسـيـح أنـــار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و تــعــالــيــم كــالأنـــــهـــار</b></h3></td>
    <td><h3 align="center">وعـــظـــات كـــالأبـــــــــرار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لـيـفــتـقـد فــيـها العِـــــبــاد</b></h3></td>
    <td><h3 align="center">زار الأقــطـار و الـبـلاد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فحُـسـب لــه إكــلـيل وجـهـاد</b></h3></td>
    <td><h3 align="center">
        رغـــم أمـــراضــه ك<span style="font-family: ; mso-ascii-font-family: calibri; mso-hansi-font-family: calibri; mso-bidi-language: ar-eg" dir="rtl" lang="AR-EG" xml:lang="AR-EG">ا<span style="font-family: ; mso-ascii-font-family: calibri; mso-hansi-font-family: calibri" dir="rtl" lang="AR-SA" xml:lang="AR-SA">لأجــــداد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـحـكــمـة وقـــلـب مــُـريــح</b></h3></td>
    <td><h3 align="center"> يرعـى قطـيع المسـيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">اســـتـحــق كــل مــــديـــــح</b></h3></td>
    <td><h3 align="center">و بـلـســـان فـمـه الفــصــيـح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـقـــلــــب لــــه صـــــبـــور</b></h3></td>
    <td><h3 align="center"> عـلى الإيـمـان غـيـور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـــدون جــــرح<span style="mso-spacerun: yes">  الـشــعـــور</b></h3></td>
    <td><h3 align="center">يُـظـهـر الحـقــيــقــة كـالـنور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و كــداود بـمـــقــــلاعـــــــه</b></h3></td>
    <td><h3 align="center"> كأسـد فـى الشـجاعـة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و يحـطـم الشــوك بأنـواعـــه</b></h3></td>
    <td><h3 align="center">يجـمـع الأســاقـفة بإجتماعـه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـحـكــمـة و عــقـل نـفــيس</b></h3></td>
    <td><h3 align="center">يـهـزم حــيـل إبـلـيـس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يعـطـى الإنجـــيـل الـتـقـديـس</b></h3></td>
    <td><h3 align="center">و كـأب لـلكنـيـسـة و رئـيـس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و الـمـلائــكـة بــه تـحـــيــط</b></h3></td>
    <td><h3 align="center">شـفيع لشعبه كوسـيط</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كــراهـــب مـن الإســــقــــيـط</b></h3></td>
    <td><h3 align="center">طــــعـامـه دائـــمـاً بـســـــيـط</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـى نــفـــوس عِـــــطــــاش</b></h3></td>
    <td><h3 align="center"> وعـظـه قـــد عـــــاش</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يسـمعـه الــكُــل بانــدهــــاش</b></h3></td>
    <td><h3 align="center">كــمُـعــلــــم غــيـر غـــــــاش</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">رأيــه دائــــمـاً مـطـــــلــوب</b></h3></td>
    <td><h3 align="center">معروف لكل الشـعـوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مـن الآخـــــريـــن مـحــبـوب</b></h3></td>
    <td><h3 align="center">يـمــــلـــك عــلى الــقــلــــوب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لــلـكــهــنــة أب حــبــــيـــب</b></h3></td>
    <td><h3 align="center">للأســاقـفة دائماً قريب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لـلشـــعـــب راعـــى رقــــيـب</b></h3></td>
    <td><h3 align="center">للشمامسـة قـلـــب رحـــيـــب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">إحــتـضـــن الــمـنـــبـوذيــن</b></h3></td>
    <td><h3 align="center">فــــك الـمـأســـــوريـن</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ردّ الـــــضـــــــــــالـــــــيــــن</b></h3></td>
    <td><h3 align="center">خـــلــــــّص الــخــــاطــــئـيـن</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لـكــل فـــقــيــر ويــتــــيــــم</b></h3></td>
    <td><h3 align="center"> عـطـف بقلـب رحـــيـم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لـلـمـريــض كـأخ كـــــريـــــم</b></h3></td>
    <td><h3 align="center">كـصـــديــق لـهـــم قــــديـــــم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـى زواج الـــــبـــــنـــــــات</b></h3></td>
    <td><h3 align="center">أزال الـعـــقــــــــبـــات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فـإســتـحـق لــهـذا دعــــوات</b></h3></td>
    <td><h3 align="center">بحـــــــل الـمــــشـــكـــــــلات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يـدبـر مـعـيـشـتها الحـقـيـرة</b></h3></td>
    <td><h3 align="center"> يعول الأســر الفـقـيرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بـمـشــروعــاتـه الصـــغـيـرة</b></h3></td>
    <td><h3 align="center">بـرحـــمـة قـلــبـه الـكـــبـيـرة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و النـعـمة على قـلبه تحـوز</b></h3></td>
    <td><h3 align="center">الضيقة بصلاته تجـوز</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تُـسـجّــل لـلـتـاريـخ كــرمـوز</b></h3></td>
    <td><h3 align="center">و الـكنيســة بحكـمــته تـفـوز</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وعِــلــو الــروحــــــــيــــات</b></h3></td>
    <td><h3 align="center"> جــمــع مـن الـقـامـات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و مــقـــاومـــة الهرطـــقــات</b></h3></td>
    <td><h3 align="center">الــتــوحّــــــــد والــعــــظــات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و شـــــهـادات إمـــــتــيـازه</b></h3></td>
    <td><h3 align="center">و البــركـة و الـكـرازة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">و ســــــــمـــو طِــــــــــــرازه</b></h3></td>
    <td><h3 align="center">فــضـــلاً عــن إفــــــــــــرازه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وسُــتـر مـن الإنــجـــــازات</b></h3></td>
    <td><h3 align="center"> ما خُفى من المعجزات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لــظـــــهــــوره أوقـــــــــــات</b></h3></td>
    <td><h3 align="center">وســــمــو الــروحــــــــيـــات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">نذكره بأجمل نشيد </b></h3></td>
    <td><h3 align="center" > لعـهــــده الـفـــــريــــد</b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">كـبـابـا لـلـكـــرازة مـجــــــيـد</b></h3></td>
    <td><h3 align="center">و نـمـدحــه دائـــماً بـتمجيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بالحقيقة قــولـــوا آمـــــيـن</b></h3></td>
    <td><h3 align="center"> نياحاً للبابا الأمين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بصـلواتـه عـــنـا أجـمـعـــيـن</b></h3></td>
    <td><h3 align="center">و يــنــفـعـنـا كــل حـــــــيـــن</b></h3></td>
  </tr>
  <tr>
    <td colspan="2"><h3 align="center"> الكل يقولون يا اله البابا شتودة اعنا اجمعين</b></h3></td>
  </tr>
  <tr>
    <td colspan="2"><h3 align="center" >خين إفران إم إفيوت نيم إبشيرى نيم بى ابنفما إثؤاواب تى إترياس إثؤواب إن أومو أو سيوس</b></h3></td>
  </tr>
  <tr>
    <td colspan="2"><h3 align="center" >أكسيا أكسيا أكسيا تى أجيا ماريا تى بارثينوس </b></h3></td>
  </tr>
  <tr>
    <td colspan="2"><h3 align="center" >أكسيوس أكسيوس أكسيوس أفا شينوتى بى أرشى أرفس</b></h3></td>
  </tr>
</table>
