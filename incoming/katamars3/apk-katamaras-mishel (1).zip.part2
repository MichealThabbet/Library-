  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">فى البير عانك أحبابك</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3 class="auto-style1"> + يا شجيعة ما أصابك<br />
      </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3 class="auto-style1"><strong><span lang="AR-SA" xml:lang="AR-SA">تى 
	  آجيا أبراكسيا</span></strong></h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
