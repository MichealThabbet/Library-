    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">باسم الرب المصون 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وزوجته بتدبير </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وامن الوزير </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">   القديس لوقا الطبيب </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">مع جمع كبير </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> وستة سبعين باتقان </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">عددهم مائتان 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">قد اعلنوا الايمان </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> وامر باخذ رؤوسهم </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">علم الملك بقضيتهم 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فتمت شهادتهم 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> موضوع فى داخل كيس </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وجعل جسد القديس 
