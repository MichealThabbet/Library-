<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الانبا رويس-السلام للأنبا فريج</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">الشهير بالأنبا رويس</span></font></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام للأنبا فريج </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا قديس</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام لك يا مختار</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في حياته يشبهنا </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">كان رجلًا علمانيًا</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لكنه بركتنا </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا كاهن ولا راهب</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مختصرًا ملبسه </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كان زاهد في أكله</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولا الصيف ولا حره </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غير خائف من الشتاء </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إلى بيعة سمائية </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الملائكة فوق أخذوه </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الأسرار المحيية </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تناول من يد يسوع</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> معناه ناظر الإله </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سموه ثيؤفانيوس </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبه لقب الكنيسة </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حين ظهر له الله</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومنهم كان مصون </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أنكر شخصه للناس</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يعني الكاذب المجنون </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سمي نفسه تيجي أفليو </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حافظ وصايا الرب</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تيجي لها معني</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليسوع الذي أحب </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بالحقيقة كان مطية </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا قديس شجاع وأمين </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا أبانا</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والذين بالروح مساكين </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ملكوت السموات لك</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تاركا أسهل طريق </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رفضت حياة الناس</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والجمل لك رفيق </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واخترت طريقًا ضيقًا </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولا كنت من العالم</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لم تطلب العالم </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في احتمالك للآلام </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بل شابهت المسيح </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بل طرحوا عليك النار</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ضربوك ثم طردوك </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حين لطمك الأشرار </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حولت لهم خدك </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بدلا من الخطية </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فضلت الطهارة </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكمال البتولية </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولبست ثوب العفة </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وشابهت الرهبان </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في حياتك كنت أمين<span style="mso-spacerun:yes">  </span></span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تكللت بالأحزان </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في أماكن مهجورة </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في بشارتك بالإيمان </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وديع ومتواضع </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في حربك مع الشيطان </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جندي للمسيح ثابت </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مع نسكيات وجوع </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تطهرت بالأصوام </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بطعام الرب يسوع</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لكنك كنت شغوفًا</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> منهم البطريرك </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صليت للمأسورين </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بصلاتك وشفاعتك </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خلصته من أسره</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الأنبا متاؤس </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رآك البطريرك </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الغريبة عن النفوس </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تعجب من أعمالك</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من جسدك نتبارك </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> معنا دائما كائن </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفي بابه نعيد لك </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في كنيستك نذكرك </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أمام الرب القدوس</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أطلب من أجلنا </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا قديس ثيئوفانيوس</span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأذكرنا دائمًا</span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفسير أسمك في أفواه </span></font></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تيجي أعنا أجمعين </span></font></font></h3></td>
    <td><div align="center">
      <h3><font color="#000000"><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله </span></font></font></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PKΥ���]␀␀�]␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/h1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td width="100%" colspan="2"><h1 align="center">القديس الانبا زخارياس</h1></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> السلام لك يا زخارياس الأسقف والقديس<br />
        حبيب ماسياس آفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> السلام للحبر الجليل خادم عمانوئيل<br />
        يا مَنْ نال الإكليل آفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> قسًا كان أباك في مخافة الله ربّاك<br />
        طريق الخلاص أراك آفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لما صِرت شاب عُيِّنت ككاتِب<br />
        في أعلى المناصب آفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لكنك في العالم زهدت خيراته رفضت <br />
        سكني البرية أخترت أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> طريق الرهبنة أخترت وعلى الجهاد نويت <br />
        للبرية سعيت أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> والي سخا أبلاتوس وصديقك المخلص<br />
        مثلك نفسه كرس أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تعاهدتما للنفس الأخير على الذهاب للدير<br />
        دير يحنس القصير أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عرف الوالي عزمكما بالقوة منعكما<br />
        إذ كان يحبكما أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> في رؤيا سمعتما صوتًا يسألكما<br />
        أين نذركما أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> خرجتما في الحال خفية في الطريق للبرية <br />
        وحياة البتولية أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لبست ثوب الرهبان جاهدت جهاد الشجعان <br />
        أمام حروب الشيطان أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عشت في نسك شديد بثبات وعزم أكيد <br />
        لأجل ميراث المواعيد أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بالأصوام والصلوات وكثير من الميطانيات<br />
        والصدقات والقراءات أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> كنور على منارة كأنغام قيثارة <br />
        كزهرة عطارة أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> سرتك ملت الأقاليم كمثال حياة التسليم <br />
        وحفظ الإيمان قويم أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أهل سخا رشحوك للأسقفية زكوك <br />
        بالقوة رسموك أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وفي يوم الرسامة ظهرت علامة <br />
        زادتك كرامة أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عند وضع اليد عليك نور أضار حوليك <br />
        كنجم صار وجهك أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بالنعمة رعيت شعبك وأعطيتته قلبك <br />
        أحببته وأحبك أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> داومت على التعليم والإرشاد والتسليم <br />
        وايضًا التقويم أفا زخارياس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ثلاثين سنة بتمام خدمت فيها بإهتمام<br />
        وتنيحت بسلام أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> السلام لراعي أمين شدد المؤمنين <br />
        وبحث عن الضالين أفا زخارياس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تفسير أسمك في أفواه كل المؤمنين <br />
        الكل يقولون يا إله الأنبا زخارياس أعنا أجمعين</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�S��␀␀�␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀3␀␀␀apk-katamaras-mishel/content/المدائح/i1.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
h2 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الأم سارة رئيسة دير الأنبا بضابا</h1>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> كوكب جديد منير</h3></td>
    <td><h3 align="center">فى سماء المنتصرين</h3></td>
  </tr>

  <tr>
    
    <td><h3 align="center">طوباكى يا امنا ساره</h3></td>
    <td><div align="center">
      <h3>انتقل 
        للسمائيين</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ولدت قديستنا الباره </h3></td>
    <td><h3 align="center">فى عام تسعة وتلاتين </h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>من 
        ابوين تقيين</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> حفظوها التعاليم</h3></td>
    <td><h3 align="center">ربوها على الانجيل</h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td> <div align="center">
      <h3>والتسابيح والتراتيل</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">منذ 
        حداثتها </h3></td>
    <td><h3 align="center">عملت بكلام الانجيل </h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>نفذت وصاياه 
        بتهليل</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وقلبها 
        بيسوع مليان</h3></td>
    <td><h3 align="center">كبرت مع الايام </h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>حتى جابت 
        15 عام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فى 
        قلبها كان يزداد </h3></td>
    <td><h3 align="center">حبها لملك السلام </h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td> <div align="center">
      <h3>فأرادت 
        تعيش معه على الدوام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فقصدت دير انبا بضابا </h3></td>
    <td><h3 align="center">اشتهت حياة الرهبنه</h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td> <div align="center">
      <h3>وفيه عاشت امنا الحنونه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وهى لازالت صغيره</h3></td>
    <td><h3 align="center">لم تطلب فى حياتها معونه</h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td> <div align="center">
      <h3>غير 
        من خالق المسكونه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">  فى 
        جهادها الروحى</h3></td>
    <td><h3 align="center">عاشت حياة النسكية</h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>فى 
        حياتها الرهبانية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">مقصر 
        او خاطى </h3></td>
    <td><h3 align="center">فى حياتها لم تلوم </h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>بل عنه تصلى 
        وتصوم</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لكل من 
        أتاها</h3></td>
    <td><h3 align="center">كانت مرشد امين</h3></td>
  </tr>
  <tr>
    
    <td><div align="center">
      <h3>طوباكى يا امنا ساره</h3>
    </div></td>
    <td><div align="center">
      <h3>طالبا نصحًا ثمين</h3>
    </div></td>
  </tr>
