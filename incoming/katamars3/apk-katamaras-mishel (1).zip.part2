�b␀␀�b␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r16.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمرقس الإنجيلي-أبدأ باسم الذات العلية</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">واستمطر الغيوث الربانية </span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">ابدأ باسم الذات العلية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لي ولكل من والاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واستوهبه خير عطية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> باشراق الآيات اللاهوتية </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بدت الأنوار الناسوتية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فعرف الخلق حقيقة مولاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من أفق الكمالات الإلهية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحل في احشاء النقية </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تعطف الكلمة الأزلية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فنال به الخلق فداه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وظهر بطبيعة بشرية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبلبل الأسعاد ترنم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ثغر المحامد قد تبسم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> علينا بجميل رضاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومفيض الخير تكرم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليمنح الخلاص ويبديه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جسد قد تجلي فيه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويدخل من شاء حماه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويرشد الكل ويهديه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتحقق ليتم الموعود</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حاول صلبه اليهود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليخلص كل من اتقاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأراده الرب المعبود</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ثم قام وصعد إلى السموات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خالق الأكوان دفن كالأموات </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومنهم مارمرقس مصطفاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأرسل رسله بالبينات </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأرسل هذا الهمام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> دبر الإله لإبادة الأصنام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فيا سعادة من لباه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لاظهار الحقيقة للانام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لما راوا الدين الصحيح </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ذهبت أعمال عبادها كالريح </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> زال عنهم كل اشتباه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبرسول السيد المسيح </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وورثه فردوس النعيم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رضي عنه المولي الرحيم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأبتهجت النفوس بثناه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وخصه بالشرف والتكريم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأشرق فيها شمس اليقين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> زين مصر بنور الدين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وزال عن الجاهل عماه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأبصرت أعين الجاحدين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ترافقه العناية واليسر</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سعي مكللا بالنصر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولم يؤخره تهديد العصاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وجد ليغنم الأجر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واعتراهم الخزي والعار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شبت في احشاهم النار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بدعوات الإنجيلي ومسعاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصارت أصنامهم في بوار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وعم تعليمه وانتشر</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصر على كل الضرر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأثر في القلوب نداه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتلفظ بغالي الدرر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وعم القري والبلدان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ضوء ارشاده بان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتلألأت بنور هداه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفازت بلاد مصر بالإيمان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصارت هدايته في الأقطار </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طابت بالإنجيلي الأفكار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتكلل بالفوز مسعاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فآمن المنكر به واستنار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقتلوه في بعض الأيام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ظلمه عباد الأصنام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لرفض عبادتهم في انتباه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لما راوا الأنام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فلم يؤثر فيهم التعليم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عموا عن الدين القويم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبلغوا في الكفر منتهاه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واغضبوا الخالق الرحيم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فحرموا من نور العناية </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غلقوا باب الهدايا </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إلى جحد الدين واخفاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقادهم الكفر والغواية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واغتالوه بلا ارتياب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتحوا على القديس الباب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فمات شهيد هداه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصبغوا بدمه التراب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وارتكبوا المنكر والضلال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قبلوا الخيبة والوبال </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في وقت عبادته وتقواه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقتل القديس المفضال </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الذي أعده لهم أبليس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كان ذلك في عيد سيرابيس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويختص به أبناء الله </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليحرمهم مزية التقديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وآمن به الاسكافي المتلاهي </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لقد أبطل الملاهي </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لما آلمه المخرز واضناه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إذ قال أمامه يا إلهي </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شفاه الله من غير طبيب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من وضع الطين ورسم الصليب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ورسمه اسقفا وولاه<span style="mso-spacerun:yes">  </span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصار المقرب منه الحبيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من قبل دعوة الرسول </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نال الشفاعة والمأمول </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واتبع الحق وتوخاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتعمد باخلاص وقبول</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشفاعة الشهيد مارمرقس </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا رب يا خالق الأنفس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شعبك وبلغه مناه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تعطف علينا واحرس</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK�&y �_␀␀�_␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r17.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمينا العجائبي-أفتح فاي بالأفراح</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>السلام لمارمينا شهيد يسوع المسيح </span></h3>    
      </h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>افتح فاي بالافراح وارتل بالتسبيح</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اصله كان جندي بطل قوي وغيور</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>بإرادة الله ابدي اخبركم عن هذا المبرور</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وامه تدعي افومية وابوه اودوكسيس</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>اصله من بيت امراء هذا الجسد النفيس</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طلبت من النقية العذراء ام القادر </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>امه اوفومية كانت امراة عاقر</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فرزقت بولد هو مارمينا الامين </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>اجابت لها طلبها وقالت لها امين</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكان عالم ماهر في العلوم المسيحية </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>كبر هذا الطاهر وتقدم في الجندية</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مداوم الصوم والصلاة ملتحفًا بالوداعة</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>كان محبًا للاله موصوفًا بالشجاعة</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فاعترف باجهار انا عبد الديان </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>دعي هذا المختار لعبادة الاوثان</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وطلبت السمائيات محبة في باريها </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>تركت الارضيات وكل ما فيها</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا من قهرت الاشرار اولاد ابليس اللعين</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>طوباك يا مختار يا ابن اودكسيس</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام لك يا بطل يا مزيل كل الاحزان </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لك يا بطل يا رئيس كل الشجعان</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ذكرك ملا الاقطار والبلاد وكل البقاع  </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لك ليل ونهار ايها البطل الشجاع</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام لمارمينا مانع كل مصائب </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>السلام لمارمينا صانع كل عجائب</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اسالك تشفع لي يوم نصب الميزان </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>مشهور بالعجائبي دون سائر الشجعان</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لايحصي عددًا يا شهيد الرب القدوس</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>عجائبك كثيرة جدًا ايها البطل المحروس</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وايضًا راعي الاغنام اعترف بعجائبك </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>صنعت عجائب عظام مع كل من قصدك</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>السلام 
        للبطل القوي افع في المؤمنيين </span> </h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>السلام 
        للعجائبي مارمينا الامين</span> </h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بفرح وتهليل ايها البطل المحروس</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>نلت ثلاثة اكاليل من الرب القدوس</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اما الثالث لأجل انفرادك في البرية </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>واحد للشهادة وواحد للبتولية</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الملائكة ترتل لك اكسيوس اكسيوس </span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>طوباك ثم طوباك ايها الحبر المأنوس</span></h3>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الكل يقولون يااله مارمينا اعنا اجمعين</span></h3>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>تفسير اسمك في افواه كل المؤمنيين</span></h3>    
      </h3>
    </div></td>
  </tr>
</table>
</body>
</html>
PK��O␀␀O␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r18.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
h2 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمينا العجايبي-السلام لك يا مار مينا</h1>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h2><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا مار مينا</span></h2>
    </div>      <div align="center"></div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا شهيد يسوع المسيح</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا ابن أودكسيس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بصلوات أمك أوفومية</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا مَوعود من العذراء النقية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا ثابت في إيمان صحيح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا تلميذ يسوع المسيح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا ماهر في كل العلوم المَسيحية</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا أمير في الجندية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا كامل الصفات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا قاهر الشهوات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا مُزيل كل الأحزان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا رئيس كل الشجعان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا مَانع كل مَصائب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا صانع كل عجائب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أيضًا مع راعي الأغنام</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا صانع عجائب عظام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و شفيت الأميرة كَمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا شافي الخروف الجربان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> في مَدينة رُخامية</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بُنيت لك كاتدرائية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا حبيب البابا كيرلس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  سرت في طريق ما مارقس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أعاد ليها جَسدك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بنى لك كنيستك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا ميناء خلاص للتعبان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا لامع بأجلى بيان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا بتول و سائح و شهيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  يا من نلت ثلاث أكاليل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> قائلين آكسيوس (3)</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  الملائكة ترتل لك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين الكل يقولون </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تفسير أسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3> يا إله مار مينا أعنا أجمعين</h3>
    </div>      <div align="center"></div></td>
  </tr>
</table>
</body>
</html>
PK�J���␀␀�␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r19.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمينا العجايبي-كوكب ظهر في المسيحية</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">بأنوار ساطعة بهية</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">كوكب ظهر في المسيحية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> هو مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأنار الديار المصرية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يتمجد الله في قديسيه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رسول الأمم قال بملء فيه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويتعجب منه في بنيه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبالهمم والشجاعة موصوف</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كان الشهيد قائد الألوف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبين أقرانه معروف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وعن طريق الحق قد ولت</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لما رأي الناس قد ضلت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفي عبادة الأوثان قد زلت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وطلب
        من القوى المتعال</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ضاقت نفسه من هذا الحال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ان ينقذه من ذاك الضلال<span style="mso-spacerun:yes">  </span></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> مفضلا السيرة الملائكية </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولوقته ترك الجندية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عن المراكز العالمية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وتحلي بالعفة والطهارة </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتجمل بالنسك والبرارة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فعكف علي الصلاة بحرارة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وحفظ وصايا الرب الإله</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فداوم على الصوم والصلاة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حتى بلغ قصده ومناه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> بكل قلبه وفكره وقواه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتفاني في عبادة الله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليكون من ضمن اصفياه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> في الغيرة وتوبيخ الأشرار </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتشبه بايليا البار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إما باللين أو الانتهار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وفعل الخيرات والمبرات</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واشتهر بصنع العجائب والآيات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكان يشفي من كان به عاهات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وظلت مستأنسة حواليه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحوش البرية خضعت لديه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأنه بعطفه جذبها إليه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> إلا وشاع ذكر الشهيد الأمين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولم يمر وقت من السنين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فنال الثناء من العالمين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وغمره بفرط رحمته</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فشد أذره الرب بقدرته</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وسيج حوله بوافر نعمته</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وتخلص من تلك الآلام</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولما أكمل جهاده بسلام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حذا حذو الشهداء الكرام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> في وسط المحفل المخيف</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فجاهر بمبدأه الصحيح المنيف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أمام الملك العاتي العنيف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> قال: مينا الذي كان عندك</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سأله الملك ما اسمك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهو أحد قواد جندك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> بحقي أجرعك كأس النكال</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فصرخ الملك غضبًا وقال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأوقع بك أشد الأهوال </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> ولا ثني عزمه التهديد</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فلم يرهب العذاب الشديد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولا الوعد ولا الوعيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وبين اسطوانتين عصروه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقسوة وحشية اهانوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهو بالحمد والشكر يفوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> قواه الله الرؤوف الرحيم</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وإذ صلي الشهيد العظيم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واعاد جسده كما كان سليم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> تأثروا وصرخوا قائلين</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكثيرون من الحاضرين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إنا من الآن صرنا مؤمنين </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> ان يفتكوا بأولئك الشجعان </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فامر الملك الأعوان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فنالوا الأكاليل من الديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وقال ايها الساحر الخبير</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> <span style="mso-spacerun:yes"> </span>فاندهش الملك الشرير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قل ماهو رأيك الأخير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> قصدي أهديك إلى الصواب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتشجع الشهيد وأجاب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لنعيد رب الأرباب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وتبيدها من كل مكان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتقلع عن عبادة الأوثان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتدعو الشعب إلى الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> ازلي من بدء الأزمان </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأن الله منشيء الأكوان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهو الذي خلق الإنسان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وتعبد صنما مثله كثير</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فكيف تترك الواحد القدير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نصحتك مع أنك بصير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> فتهلل الشهيد لعتقه</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأمر الملك بقطع عنقه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> |من هذا العالم ورقه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وانتشر اسمه في كل الوديان</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فنال الأكليل من الديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وذاعت عجائبه في كل مكان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> وبلغ غاية المأمول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحظي من مولاه بالقبول</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فليس لبدره الزاهي أقول </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span style="mso-bidi-font-family:&quot;Times New Roman&quot;" lang="AR-SA" xml:lang="AR-SA"> من صلاته تدفع المصائب </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فسلام لصانع العجائب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مارمينا الأمين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونخلص من التجارب</span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
