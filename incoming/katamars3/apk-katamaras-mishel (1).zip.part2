  <tr>
    <td><h3 align="center"><span style="font-weight: 700">مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">وأمدح بتفانى</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مولودة فى الأسكندرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">هذه النقية</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">من عائلة مسيحية</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> إثنى عشر عام</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لما بلغت بسلام </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">خدعها العدو الملام </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> نفوس كثيرة يا أخوان</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فأصطاد بها الشيطان </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">وصارت فى مجون</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">على هذا الحال</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ومكثت بإرتجال</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">سبعة عشر عام </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> محبة خالقها</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">إلى ان ادركتها </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">فرأت يوم بعينها </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> للقدس مسافرين</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">قوما كانوا ذاهبين </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ذهبت معهم بيقين </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> أجرة سفرها</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">إذا لم يكن معها</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">قد أسلمت ذاتها</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> بنفس لعينة</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لمن فى السفينة </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">ووصلت للميناء </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> الكنيسة بقبول</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لما أرادت دخول</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">شعرت بيد المهول </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">فشعرت يا أحباء</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">تجذبها للوراء</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> مريم المصرية</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">إن هذا لأفعالها جزاء</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">وشدة 
    نجاستها</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لعدم طهارتها</span></h3></td>
