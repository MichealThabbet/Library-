  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">به احيا واستريح 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> فاخذها بقوة ربه </span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فامر بقطع يده </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">والصقها فى كتفه</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> واخذها والصقها</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ثم عاد ففصلها 
      </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> القديس لوقا الطبيب</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فصارت كطبيعتها </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وصاروا مؤمنون </span></b></font></h3>
