  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بشجاعة هجم عليهم<span style="mso-spacerun:yes">  </span></span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جائهم بحصان أدهم </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يدور ويلاقيهم</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كل ما يولون لقدام </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والبرق ساطع فيهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رأوه البربر بسيفين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يضرب بهما فيهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فوق رأسه مرفوعين </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصرخ صرخة دهاهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قبض على السيف واستله </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصاروا في قناهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لما نظروه ولوا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبادت قوتهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سريعًا انحلوا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وانقرضت فرقتهم </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وإلى بلادهم رحلوا </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> معروف بأبي السيفين </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شاع اسمه عند البربر </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يخضعون له منكسرين</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولو كان من غير عسكر </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من كل بلاد وأجناس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شاع ذكره عند الناس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> محب الآب مرقوريوس </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بالقوة وشدة البأس </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وطلب السمائيات</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> استيقظ من الدنياويات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أموالًا وعقارات </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ورفض كل المقتنيات</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومضي إلى داكيوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شكر الله على انعامه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واعترف بأسم القدوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وألقي سلاحه قدامه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> المسمي داكيوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غضب الملك الخوان </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لعذاب مرقوريوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصاح على الأخوان </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وضربوه ضربًا بكثرة </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رموه وسط الحضرة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بين الأمراء والوزراء</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونال عذابات مرة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إلى السجن محبوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عند المساء سحبوه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وجسده سليم محروس </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقت الصباح وجدوه </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وخزي داكيوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> افتضحت الكفرة<span style="mso-spacerun:yes">  </span></span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأيضًا كل الجلوس </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتشاوروا الوزراء </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تؤخذ رأسه بالسيف </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وكتبوا له قضية </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نال أكليلًا شريف </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خمسة وعشرين هاتور </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> انتيه تي ميت مارتيروس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لبس أكليلًا غير مضمحل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أكسيوس أكسيوس أكسيوس </span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والملائكة تتهلل </span></font></h3>
    </div></td>
  </tr>
</table>
