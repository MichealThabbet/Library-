  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ليكون الله معنا</span></font></h3></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أذكرينا يا </span></font></h3>
