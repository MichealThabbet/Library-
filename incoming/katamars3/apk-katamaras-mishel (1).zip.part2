    <td><h3 align="center"><span style="font-weight: 700">كان فى الفخار يعمل</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت أفا متاؤس</h3></td>
    <td><h3 align="center"><span style="font-weight: 700">لم يصبه الملل</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> ليعبد بحرارة</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">صار للوحدة منارة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت أفا متاؤس</h3></td>
    <td><h3 align="center"><span style="font-weight: 700"> صنع لنفسه مغارة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700"> أتت الوحوش اليه </span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">مثل آدم أبيه</span></h3></td>
  </tr>
  <tr>
