<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيدة دميانة-أشرقت شمس الغفران</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"> <div align="center">
      <h3>بأشعة العفاف والإيمان</h3>
    </div></td>
    <td width="50%"> <div align="center">
      <h3>أشرقت شمس الغفران </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> بأنوار اليقين والثبات </h3></td>
    <td> <div align="center">
      <h3>فازالت ظلام البهتان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وكملها بالتقي واصطفاها </h3></td>
    <td><div align="center">
      <h3>أبدأ بحمد من انشأها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وظهر مجدها في سائر الجهات</h3></td>
    <td><div align="center">
      <h3>فتلألأ نورها وثناها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وقطعت عنق الكفر ولسانه </h3></td>
    <td><div align="center">
      <h3>بلغت من الكمال عنانه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">ذات الطهارة والمبراث</h3></td>
    <td><div align="center">
      <h3>وهي العفيفة النقية دميانة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فبرعت في الأسرار الألهية </h3></td>
    <td><div align="center">
      <h3>تولعت بمطالعة الكتب الدينية </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">لتتفرغ للصلاة والعبادات </h3></td>
    <td><div align="center">
      <h3>وقصدت العزلة عن البرية</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">إلى النسك لعبادة مولاها </h3></td>
    <td><div align="center">
      <h3>ثم تاقت نفسها في صباها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وعقدت على قصدها النيات</h3></td>
    <td><div align="center">
      <h3>فأعجب ذلك مرقس أباها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بحسن تربية أبوها العظيم </h3></td>
    <td><div align="center">
      <h3>جنت ثمرات التعليم</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">شريفًا حسن الصفات </h3></td>
    <td><div align="center">
      <h3>وكان ذا جاه وتكريم </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">ولم يرزق بغير دميانة </h3></td>
    <td><div align="center">
      <h3>حكم واليا على الزعفرانة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">الممتازة بالفضل والكرامات</h3></td>
    <td><div align="center">
      <h3>ذات الصدق والعفة والأمانة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أن يزوجها بامير صنديد </h3></td>
    <td><div align="center">
      <h3>خطر لأبيها السعيد</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وقالت وهي تسكب العبرات</h3></td>
    <td><div align="center">
      <h3>فتأسفت الأسف الشديد </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فليس رغبتي في العالم الفاني </h3></td>
    <td><div align="center">
      <h3>دع هذا إن كنت تهواني</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">الإله منشئ المخلوقات</h3></td>
    <td><div align="center">
      <h3>بل في الذي صورني وأنشأني</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">مع قصر لي تبتنيه </h3></td>
    <td><div align="center">
      <h3>ذلك الذي منك أبتغيه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لعبادة خالق السموات</h3></td>
    <td><div align="center">
      <h3>أنفرد مع العذارى فيه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ففرح كثيرًا بامنيتها</h3></td>
    <td> <div align="center">
      <h3>رأي أبوها حسن رغبتها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأحضر الصناع من الجهات</h3></td>
    <td> <div align="center">
      <h3>وبادر لإنجاز حاجتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> حتى أتوه بلا أهمال </h3></td>
    <td> <div align="center">
      <h3>راح معهم في الحال</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> حلاوة بانواع المفروشات</h3></td>
    <td> <div align="center">
      <h3>ولما بلغ بنيابة الكمال </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وسكحنت مع أربعين من الأبكار</h3></td>
    <td> <div align="center">
      <h3>زخرفة بما يدهش الأبصار</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لأداء الصوم والصلوات</h3></td>
    <td> <div align="center">
      <h3>وأقامت بكل عفة ووقار </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> في سائر القري والبلدان</h3></td>
    <td> <div align="center">
      <h3>سرت عبادة الأوثان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فسجد لها الألوف والمئات</h3></td>
    <td> <div align="center">
      <h3>بأمر دقليانوس السلطان </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">خوفًا من جور الملك الخوان</h3></td>
    <td><div align="center">
      <h3>سجد معهم ابوها للأوثان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فوقعت دميانة في الحسرات</h3></td>
    <td><div align="center">
      <h3>وترك عبادة الديان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">على الفرما وبلغه مناه</h3></td>
    <td><div align="center">
      <h3>سر الملك منه فولاه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">بالغا منه أحسن الدرجات</h3></td>
    <td><div align="center">
      <h3>وصار عنده من أعظم الولاة</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وتوجهت لأبيها في الحال </h3></td>
    <td> <div align="center">
      <h3>شرعت في المسير له بلا إهمال</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فدخلت عليه بدون تحيات</h3></td>
    <td> <div align="center">
      <h3>وهي في كيد وملال </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وقالت طاوعت اللعين </h3></td>
    <td> <div align="center">
      <h3>صاحت بصوت حزين </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> الذي له الآيات الباهرات </h3></td>
    <td> <div align="center">
      <h3>وكفرت برب العالمين</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وتركت عبادة خالق السموات</h3></td>
    <td> <div align="center">
      <h3>ضللت بهذه الخرافات </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> المسبح بكل الألسن واللعنات</h3></td>
    <td> <div align="center">
      <h3>موجد جميع الموجودات</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أن يعترف بلسانه ويصيح</h3></td>
    <td> <div align="center">
      <h3>طاب له من كلامها الفصيح </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فسار بقوة وعزم وثبات</h3></td>
    <td> <div align="center">
      <h3>أمام الملك بالرب المسيح </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">واعترف بالرب عز وجل</h3></td>
    <td><div align="center">
      <h3>طلب الأذن وعليه دخل</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وتأثر من تلك الكلمات</h3></td>
    <td><div align="center">
      <h3>فغضب الملك وانذهل </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأبدي الملك بأسه </h3></td>
    <td><div align="center">
      <h3>طهر باعترافه نفسه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فقطعت في الحال ومات</h3></td>
    <td><div align="center">
      <h3>وقال اقطعوا رأسه </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أن دميانة هي السبب </h3></td>
    <td> <div align="center">
      <h3>ظهر للملك بعد الغضب </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وأرسل قائده لتلك الجهات</h3></td>
    <td> <div align="center">
      <h3>فاندهش لذلك واضطرب </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وطلب منها عبادة الأوثان</h3></td>
    <td><div align="center">
      <h3>عاملها باللين والاحسان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ورفضت جميع الطلبات</h3></td>
    <td><h3 align="center"> فثبتت على نور الإيمان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> ملعون الرسول ومن أرسله</h3></td>
    <td> <div align="center">
      <h3>غضبت وقالت له </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أظهر لها فعل الأساآت</h3></td>
    <td> <div align="center">
      <h3>ولما خاب ما امله </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> القادر يا عبدة الأوثان </h3></td>
    <td> <div align="center">
      <h3>فقالت له بأفصح لسان </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ويظهر لكم عظيم الآيات</h3></td>
    <td> <div align="center">
      <h3>سيسقيكم كأس الهوان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> والعذارى بجانبها في انتحاب</h3></td>
    <td> <div align="center">
      <h3>قادها الرسول للعذاب</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ومضت للسجن في تضرعات</h3></td>
    <td> <div align="center">
      <h3>فشجعتهن على هذا المصاب</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">ملاك الرب وإليها وصل</h3></td>
    <td> <div align="center">
      <h3>كالبرق عليها نزل </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فنالت من الله الكرامات</h3></td>
    <td> <div align="center">
      <h3>وشفي جسمها من العلل</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> انذهل فأنكر افعالها</h3></td>
    <td> <div align="center">
      <h3>لما رأي الرسول حالها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أنواع العذاب والعقوبات </h3></td>
    <td> <div align="center">
      <h3>وهيأ في الحال لها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فصلت وقبل الله دعاها</h3></td>
    <td> <div align="center">
      <h3>من لحمها جردها ورماها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> من كل الآلام والجراحات</h3></td>
    <td> <div align="center">
      <h3>فنزل الملك وشفاها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> من حديد ووضعها على النيران</h3></td>
    <td> <div align="center">
      <h3>نوى على ضربها بقضبان </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> والعذاري حولها باكيات</h3></td>
    <td> <div align="center">
      <h3>ففعل ذلك في الآن </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأحست بالبرودة في أعضاها </h3></td>
    <td> <div align="center">
      <h3>هتفت بالدعاء لمولاها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> من كل هذه المهلكات</h3></td>
    <td> <div align="center">
      <h3>ونشلها الله ونجاها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ولم يترك عقابًا إلا فعله </h3></td>
    <td> <div align="center">
      <h3>هاله أمر العذراء وأذهله </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ولكن تداركها رب القوات</h3></td>
    <td> <div align="center">
      <h3>وإلى جسمها الشريف أوصله </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وسجنها ومن معها من العذاري</h3></td>
    <td> <div align="center">
      <h3>وتمادي قسوة واستكبارًا</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> لتطيعه في عبادة المصنوعات</h3></td>
    <td> <div align="center">
      <h3>في محل مظلم جهارًا</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> ورماها للوحوش وأقصاها </h3></td>
    <td> <div align="center">
      <h3>وبعد أن قطع أعضاها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فقامت سالمة من المضرات</h3></td>
    <td> <div align="center">
      <h3>تعطف الإله وأبراها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> المجد لله وعلى الأرض  السلام</h3></td>
    <td> <div align="center">
      <h3>وقالت في مجلس الأحكام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وقبلت مالهم من السيئات</h3></td>
    <td><div align="center">
      <h3>وباركت اسم رب الآنام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">اعلم الملك بخبرها</h3></td>
    <td><div align="center">
      <h3>ولما تحير القائد في امرها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وإعدامها ومن معها من العفيفات</h3></td>
    <td><div align="center">
      <h3>فأمر باخراجها من قصرها </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أعدم الجميع الحياة</h3></td>
    <td><div align="center">
      <h3>وامتثالًا لأمر مولاه</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> فأعد لهن نعيم الجنات</h3></td>
    <td> <div align="center">
      <h3>واستشهدن حبًا في الإله </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أدم بطريرك هذا الزمان</h3></td>
    <td> <div align="center">
      <h3>يا رب يا مانح الإحسان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> وبلغه ما يرجو من الخيرات</h3></td>
    <td> <div align="center">
      <h3>واجعل أيامه في اطمئنان </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center"> أسقفنا ذو المناقب السنية </h3></td>
    <td> <div align="center">
      <h3>وشريكه في الخدمة الرسولية</h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>أحفظه من كل الآفات</h3>
    </div></td>
    <td> <div align="center">
      <h3>متعه بالنعم الإلهية </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>وكذا الشمامسة والخدام </h3>
    </div></td>
    <td> <div align="center">
      <h3>والأباء الكهنة الكرام</h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>وزينهم جميعًا بالكمالات</h3>
    </div></td>
    <td> <div align="center">
      <h3>صنهم يا رب مدى الأيام </h3>
    </div></td>
  </tr>
</table>
</body>
