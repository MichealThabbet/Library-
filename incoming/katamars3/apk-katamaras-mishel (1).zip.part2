      <h3>يا له من فخر </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> بقرب استشهادك</h3>
    </div></td>
    <td><div align="center">
      <h3>ووعدت والدك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا قديسة مهرائيل</h3></td>
