    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> دعيت حبيب يسوع </span> </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">بي منريت أفا بيشوي</span> </h3>
    </div></td>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصلاتك بدموع </span> </h3>
