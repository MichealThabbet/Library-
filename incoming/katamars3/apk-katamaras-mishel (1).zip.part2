  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس أبونا يسطس الأنطوني</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">محب الرب ايسوس</span></font></h3>    </td>
    <td width="50%"><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">في كواكب الفردوس</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">خادم الرب القدوس </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">وعمل تدبيره غريب</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">سر حياته عجيب </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">طوبي لك يا حبيب </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  حبيتنا وحبيناك</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">بيعوننا نظرناك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">واشتقنا لرؤياك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> وغالية هي اقوالك</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">قليل هو كلامك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اذكرنا في صلاتك   </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">بنيوت آفا يسطس</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">جلسنا حواليك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ولو لم ينطق فمك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> بنيوت آفا يسطس</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">علمتنا بدون كلام </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">تركت دار الآلام  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">محبته لفاديه</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">قلايته تشهد له  </span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">رذل العالم وما فيه </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> مخلص كل النفوس</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اختارك الرب القدوس </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">نقاك الي الفردوس </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> انبا انطونيوس الحكيم</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">من جبل ابونا العظيم  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">مضيت الي النعيم </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  وروحه لم تكن معنا</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">بالحب كان معنا</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">وكانه لا يسمعنا  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">يا ابونا يسطس العفيف</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">صمتك حلو لطيف  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">عبرت مثل الطيف </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> ويشتهي الهوان</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">من يبغض نفسه الآن </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">السما تصير له مكان </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  بسرعة حبيناك</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ابونا يسطس طوباك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">يا ريتنا نكون معاك   </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700"> يا حكيم في كلمتك</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">يا عظيم في محبتك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">يا عالي في حكمتك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">فارتعب كل الجنود</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">نورك اضاء الحدود</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">قد صرت بلا قيود </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  وفرح قلبنا بك</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">جلسنا تحت قدميك</span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">رجاءنا نلتقي بك </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">   سيرتك بتعزينا</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اسمك مفرح لنا </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">صلاتك تشفع فينا </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">  وسرت وراءه بخشوع</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">حبيت يسوع بخضوع </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">ده سره فيك موضوع </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">يجعل حبه حياتنا</span></font></h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">اطلب من الرب عنا  </span></font></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت آفا يسطس</h3>    </td>
    <td><h3 align="center"><font color="#000000" face="Times New Roman"><span style="font-weight: 700">واسمه لا يفارق بالنا</span></font></h3>    </td>
