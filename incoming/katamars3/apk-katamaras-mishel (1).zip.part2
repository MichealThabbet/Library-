      <h3>منتصرة على اللعين </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لن يهز لك ايمان</h3>
    </div></td>
    <td><div align="center">
      <h3>هو ابليس الشيطان</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا قديسة مهرائيل</h3></td>
    <td><div align="center">
      <h3>انت قدوة لكل انسان </h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وانت شابة صغيرة</h3>
    </div></td>
    <td><div align="center">
      <h3>عجائبك كثيرة </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا قديسة مهرائيل</h3></td>
    <td><div align="center">
      <h3>بالذكر هى جديرة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> قد صارت فى شدة</h3>
    </div></td>
    <td><div align="center">
      <h3>امراة فى ولادة </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا قديسة مهرائيل</h3></td>
    <td><div align="center">
      <h3>صليت بجدة  </h3>
    </div></td>
  </tr>
  <tr>
