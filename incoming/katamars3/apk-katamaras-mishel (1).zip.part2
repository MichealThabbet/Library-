    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك فى أفواه</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-SA" xml:lang="AR-SA">  البابا كيرلس أعنا آجمعين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله </span></font></h3>
