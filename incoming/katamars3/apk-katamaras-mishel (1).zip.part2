<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد الأنبا أمونيوس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> بقدرته أبذل جهدى<br />
    </h3></td>
    <td width="50%"><h3 align="center">  أبدى باسم الله ربى<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت اثؤواب آفا أمونيوس<br />
    </h3></td>
    <td><h3 align="center"> وابرم نظمًا من عندى<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا صاغى لقولى أفهم<br />
    </h3></td>
    <td><h3 align="center">  بقوة الله اتكلم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت اثؤواب آفا أمونيوس<br />
    </h3></td>
    <td><h3 align="center"> عن هذا الأب المكرم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> الآباء الشهداء الأبرار<br />
    </h3></td>
    <td><h3 align="center">  تلألأ بدر الأطهار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت اثؤواب آفا أمونيوس<br />
    </h3></td>
    <td><h3 align="center"> ثم نجوم زاهية الأظهار<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> أيها الشعب المبرور<br />
    </h3></td>
    <td><h3 align="center">  ثم أخبركم عن هذه الأمور<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> بنيوت اثؤواب آفا أمونيوس<br />
    </h3></td>
    <td><h3 align="center"> نالوا الشهادة والنور<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> عبدوا الخلائق المصنوعات<br />
    </h3></td>
    <td><h3 align="center">  جاء زمن الاضهاد<br />
    </h3></td>
