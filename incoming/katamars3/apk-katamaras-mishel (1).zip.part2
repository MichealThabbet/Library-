<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس البابا أثناسيوس-أثناسيوس يا رسول</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">حبنا لك على طول</h3></td>
    <td width="50%"><h3 align="center">اثناسيوس يا رسول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   السلام لك يا اثناسيوس</h3></td>
    <td><h3 align="center">كلنا باجمعنا نقول </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا كاشف حيل ابليس</h3></td>
    <td><h3 align="center">اثناسيوس ياقديس </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  السلام لك يا اثناسيوس</h3></td>
    <td><h3 align="center">يا ناقد بدعة اريوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> كزهرة فى بستان</h3></td>
    <td><h3 align="center">يا مشرف الرهبان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لك يا اثناسيوس</h3></td>
    <td><h3 align="center">تروى كل عطشان  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> يا حبيب ابن الانسان</h3></td>
    <td><h3 align="center">حامى حمى الايمان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لك يا اثناسيوس</h3></td>
    <td><h3 align="center">اعطاك قوة وسلطان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> واستهنت بالالامات</h3></td>
    <td><h3 align="center">نفيت خمس مرات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لك يا اثناسيوس</h3></td>
    <td><h3 align="center">وربحت الوزنات</h3></td>
