      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> البابا (....) المختار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أحفظ أسقفنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يا شهيد إيسوس بى إخرستوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> يؤانس بريم هرقليه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> الساهر لخلاصنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> احفظ القمامصة والقسوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  يا شهيد الرب القدوس</span></h3>
    </div></td>
