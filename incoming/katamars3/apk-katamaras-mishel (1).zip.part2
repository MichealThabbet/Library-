<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-السلام لأم الله مريم</h1></td>
  </tr>
  <tr>
    <td><h3 align="center">عالم الأسرار والخفايا</h3></td>
    <td><h3 align="center">المجد لرب البرايا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لأم الله مريم</h3></td>
    <td><h3 align="center">مجَّد أمَّه بدير صيدنايا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مواظبة الصوم والصلوات</h3></td>
    <td><h3 align="center">كانت مارينا احدى الراهبات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لأم الله مريم</h3></td>
    <td><h3 align="center">فى 
    دير صيدنايا بتقوى ونشاط</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">محبه لكل الاتقياء</h3></td>
    <td><h3 align="center">كانت مضيفه للغرباء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> السلام لأم الله مريم</h3></td>
    <td><h3 align="center">شغوفه بسِير الابرياء</h3></td>
  </tr>
