<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس مينا الصموئيلي</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">فى صفوف القديسين</h3></td>
    <td width="50%"><h3 align="center">فى كنيسة 
    المنتصرين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">فخر المجاهدين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مخلص النفوس</h3></td>
    <td><h3 align="center">أحببت اسم أيسوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">سرت فى طريق القدوس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى مدح هذا 
    الإنسان</h3></td>
    <td><h3 align="center">عجز الفم واللسان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">محب الملك الديان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بتحفظ المزامير</h3></td>
    <td><h3 align="center">كنت طفل صغير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">وتسبح للرب القدير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عشت حياة طاهرة نقية</h3></td>
    <td><h3 align="center">فضلت البتولية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">حسب التعليم بالوصية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">اقتادك بمهارة</h3></td>
    <td><h3 align="center">ملاك كل طهارة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">لطريق الطاحونة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ليرشدك للطريق</h3></td>
    <td><h3 align="center">أتى بك رفيق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">لتتبع البابا الحبيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">للحياة النسكية</h3></td>
    <td><h3 align="center">قصدت البرية </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">لتعبد رب البشرية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بالدروس العملية</h3></td>
    <td><h3 align="center">هزمت الخطية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">فى حياتك الروحية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ناكرا لذاتك</h3></td>
    <td><h3 align="center">طوباك يا مختار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">عشت حياة الأبرار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ناكرًا لذاتك </h3></td>
    <td><h3 align="center">قديس متواضع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">مملؤ 
    نعمة وتدبير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تسأل عن التعبان</h3></td>
    <td><h3 align="center">بركاتك فى كل مكان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">والفقراء والأيتام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">قدام الرب الفادى</h3></td>
    <td><h3 align="center">أمام 
    العرش العالى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آفا مينا الصموئيلى</h3></td>
    <td><h3 align="center">اذكرنا يا غالى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">افواة المؤمنين</h3></td>
    <td><h3 align="center">تفسير اسمك فى</h3></td>
  </tr>
