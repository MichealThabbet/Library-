  <tr>
    <td colspan="3"><h1 align="center">الشهيد بولس الرسول</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يعيش هذا 
        الإنسان </span></b></h3>
    </div></td>
