<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-السلام لك يا مريم كنز الآب المرهوب</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">كنز الآب المرهوب</span></h3></td>
    <td width="50%"><h3 align="center"> <span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">السلام لك يا مريم</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> راحة لمن كان معتوب</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لدواء ومرهم</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولدت من نيره حلو</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لاخف الأحمال</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وصعد جنسنا للعلو</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بك أنصلحت الأحوال </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من كرم قديم مبذور</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوباك يا حبة </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وشجرة وحصنا مشهور</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قد صارت منتخبة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لم يسقيها بشر</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لكرم تكرم</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نورها جليل القدر</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وبها بلغنا المرام</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حامل رب القوات</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لمركب غالي</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بروقا مع أصوات</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يخرج منه يلالي</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> متجسم وأصله جسيم</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لحجر غالي</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يحتار فيه كل فهيم</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قطع منه حجر غالي</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فائق كل العنبر</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لعتر شهير</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مدحك لي متجر </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوباك يا طريق ومسير</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صاح في الأرض القفرة</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام ليمام وحمام</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأطلق كل الأسري </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جاء بشرنا بالسلام</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في مراحل إسرائيل </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا يمامة </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حاملة عمانوئيل</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا يمامة </span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في يد الآب هارون</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طوباك يا شورة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وداخلها إله مكنون</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> هذه قبة مشهورة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حاوية أسرار اللاهوت</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> السلام لك يا خزانة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> باب وطريق للملكوت</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مريم فخر رجانا</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> محمول على ساعديك </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> دانيال رأي ابن بشر</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يسوع ابنك منشيك</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> هو الأزلي المنتظر</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في بيت اليصابات</span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أقدامك عجلات نار</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كرسي حاملاه حيوانات </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ومنكبيك قد صار</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأنا تايه في غفلات </span></h3></td>
    <td><h3 align="center"><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عمري ولي مني </span></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مرتكب كل الزلات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولا ضامن يضمني</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفسير اسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مريم أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله </span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
