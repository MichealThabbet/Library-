<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيدتان أدروسيس و يوأنة</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">  شهيدات الطهارة </h3></td>
    <td width="50%"><h3 align="center"> السلام للعذارى </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   نلن كل كرامة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  ابنه الملك ادريانوس </h3></td>
    <td><h3 align="center"> ادروسيس العروس  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  فاقت كل جنوس </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   قد صنع لأجلها </h3></td>
    <td><h3 align="center"> ابوها احبها  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   قصرا ليخبئها </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  هذا العالم والمال </h3></td>
    <td><h3 align="center"> فكرت فى زوال </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   طلبت من رب الكمال </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   الى الطريق الصحيح  </h3></td>
    <td><h3 align="center"> ان يهديها بالصريح </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  رأت رؤيا تصيح  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   هى تعلمك بصفاء </h3></td>
    <td><h3 align="center"> استحضري يوأنا العذراء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  طريق رب السماء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  وشعرت بداخلها </h3></td>
    <td><h3 align="center"> قامت من نومها </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  ابتهاج فى قلبها </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  تدعى يوأنا للحضور </h3></td>
    <td><h3 align="center">  ارسلت بسرور </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  فذهبت بلا فتور  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  تجسد من خلصها  </h3></td>
    <td><h3 align="center">  أخذت تقص عليها  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center"> ومات لاجل فدائها </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   كالشهد فى فهما </h3></td>
    <td><h3 align="center">  كان كلامها  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   فآمنت بإلهها  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  ليلا ونهار للديان </h3></td>
    <td><h3 align="center">  كانتا تتعبدان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  بصوم مع ايمان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  رأت الرب الغالي </h3></td>
    <td><h3 align="center">  فى احدى الليالى </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  بمجده المتلالى </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  مريم العذراء </h3></td>
    <td><h3 align="center">  وأمه يا أحباء </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  مفتاح باب السماء  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  باركها من السموات </h3></td>
    <td><h3 align="center">  يسوع رب القوات </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  ووعدها بالبركات </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  مضى فى هذه الايام </h3></td>
    <td><h3 align="center">  أبوها عايش فى ظلام </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center"> الى حروب عظام  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أجابتهم بثبات </h3></td>
    <td><h3 align="center"> خطبوها فى هذه الاوقات </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   انا عبده رب القوات </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  فسأل باهتمام </h3></td>
    <td><h3 align="center"> أبوها سمع الكلام </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  من غيرها عن الاصنام  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أفسدتها عن طريقنا </h3></td>
    <td><h3 align="center">  فقالوا له يوأنا </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  وعباده الهتنا  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  الاثنين يا رفاق </h3></td>
    <td><h3 align="center">  فأمر أبوها بإحراق </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">  مع الحلى باتفاق </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> وقفتا بكل وقار </h3></td>
    <td><h3 align="center">  رموهما فى اتون النار </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   أدروسيس ويوأنا </h3></td>
    <td><h3 align="center">   تسبحان رب الأبرار </h3></td>
  </tr>
