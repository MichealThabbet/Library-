<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="2" class="auto-style1"><div align="center">
      <h1>القديس أبونا إبراهيم البسيط</h1>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> واقف بكل وقار </h3></td>
    <td class="auto-style1"><h3 align="center"> + مع الكهنة الأبرار </h3></td>
  </tr>

  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><h3 align="center">  كاهن بسيط مختار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  فى جو بسيط خالص </h3></td>
    <td class="auto-style1"><h3 align="center"> + مولود فى بنى صامت </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><h3 align="center">  نشأ فى هدوء عجيب </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ميراث الله رسمه </h3></td>
    <td class="auto-style1"><h3 align="center"> + كان إسكندر اسمه </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>زيت النعمة رسمه </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وأصبح صباغ نفوس </h3></td>
    <td class="auto-style1"><h3 align="center"> + كان صباغ هدوم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>وفاز بالملكوت </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لمذبح رب الصباوؤت </h3></td>
    <td class="auto-style1"><h3 align="center"> + دُعى للكهنوت </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط</h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>الحى الذى لا يموت </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وملا كل الأركان </h3></td>
    <td class="auto-style1"><h3 align="center"> + ذاع صيته فى كل مكان  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>أعطاه الله سلطان </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وهبه كل البركات </h3></td>
    <td class="auto-style1"><h3 align="center"> + أعطاه الله معجزات </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>وإستجابة الصلوات </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  بسرعة ربنا عفاه </h3></td>
    <td class="auto-style1"><h3 align="center"> + صلى للمريض بفاه </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>ووضحت له رؤياه </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وعمق الروحانية </h3></td>
    <td class="auto-style1"><h3 align="center"> + امتاز بالشفافية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>عرف أمور آتية </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> قابله بغير خوف </h3></td>
    <td class="auto-style1"><h3 align="center"> + وفى نياحه المعروف </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>فى الشاروبيم صفوف </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بعد جهاد جبار </h3></td>
    <td class="auto-style1"><h3 align="center"> + ودفن بوقار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>لينال نور الأنوار </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ليلتقى بالقدوس </h3></td>
    <td class="auto-style1"><h3 align="center"> + مضى إلى الفردوس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"><div align="center">
      <h3>ليسبح الثالوث </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ترك أرض الغرباء </h3></td>
    <td class="auto-style1"><h3 align="center"> + مع أفراح السماء </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط</h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>واستوطن السماء </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أمام رب الأنوار </h3></td>
    <td class="auto-style1"><h3 align="center"> + شفيع عظيم جبار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>كان وقور همام </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  إلى مدى الأيام  </h3></td>
    <td class="auto-style1"><h3 align="center"> + اذكرنا على الدوام </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>أمام العرش المقام </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> خادم كل الأسرار </h3></td>
    <td class="auto-style1"><h3 align="center"> + اذكر رئيس الأحبار </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>بطريركنا المختار </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وسائر كهنتا </h3></td>
    <td class="auto-style1"><h3 align="center"> + وشركاؤه أساقفتنا </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><div align="center">
      <h3>أبونا إبراهيم البسيط </h3>
    </div></td>
    <td class="auto-style1"> <div align="center">
      <h3>وكل شمامستنا </h3>
    </div></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> عندما نصرخ قائلين </h3></td>
    <td class="auto-style1"><h3 align="center"> + اذكرنا أجمعين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">أعنا أجمعين</h3></td>
    <td class="auto-style1"><h3 align="center">&nbsp;أبونا إبراهيم البسيط</h3></td>
  </tr>
 
