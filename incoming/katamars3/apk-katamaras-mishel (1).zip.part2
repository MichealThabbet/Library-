  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> يساعده و يقويه</h3></td>
    <td class="auto-style1"><h3 align="center"> + ظهر له الملاك ميخائيل </h3></td>
  </tr>
  <tr>
