<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا بسادة</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أقول باسم المسيح</span></b></font></h3></td>
    <td width="50%"><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فى بداية كل 
    مديح   </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">واجب 
    التسبيح   </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">معجزة هذا الجيل</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أشرح ولربى 
    التبجيل  </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فى دير أنبا 
    صموئيل </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> فى عالم كله نار</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> يا طاهر بين 
    أشرار</span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أصبحت من 
    الأبرار </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وحبك كان ملموس</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أحببت الرب 
    إيسوس </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فصرت له 
    عروس </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> إهرب لحياتك</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">قرأت فى 
    كتابك </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">للجبل لئلا 
    تهلك  </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> أرشدك رب الكون</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">فى التاسع من 
    القرون </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">إلى جبل 
    القلمون </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وأهوائك واحبابك</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> وتركت كل 
    مالك  </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">سلمت للرب 
    حياتك </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">  فى عمل وصايا الإنجيل</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وبعد جهاد 
    طويل   </span></b></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3></td>
    <td><h3 align="center"><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وصلاة لا تعرف 
    ليل</span></b></font></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">لبست الإكليل</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وبفرح 
        وتهليل  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">من يد 
        عمانوئيل  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> أحبك الديان</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">يا ناسك بين 
        الرهبان</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وأعطاك وعد 
        أمان  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">لا يرى فساد جسدك</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> وعد المزمور 
        كان لك </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وفزت 
        بأمجادك   </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">آخر ستة وسبعين</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وفى القرن 
        العشرين  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> فى دير أنبا صموئيل</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ظهر جسدك 
        الثمين </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> ظهر وكأنه مصون</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">كان فى 
        التراب مدفون </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ليتمجد رب 
        الكون</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">إرتفع جسدك وقام</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بصلاة خين 
        افران </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">رفعوه 
        باهتمام </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">حدثت فى اليوم ذات</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وكثير من 
        المعجزات </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">لما ظهر 
        الجسد  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> من جسدك الدم سال</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وبعد شهور 
        قلال </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">  بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">يمجد الرب 
        المتعال </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بوعد بى إخرستوس</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">يا ساكن 
        الفردوس </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">جسدك هنا 
        محروس</span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">  أمام عرش الإله</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أذكرنا فى 
        الصلاة </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ليرحمنا نحن 
        الخطاة </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">أمام شمس الأنوار</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">صلى عنا يا 
        بار </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بنيوت آفا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">بشفاعة أم 
        الأطهار   </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">وشركاؤه أساقفتنا</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">إحفظ يارب 
        بطركنا  </span></b></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG"> بصلاة أنبا بسادة</span></b></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font style="font-weight: 700" color="#000000"><b><span lang="AR-EG" xml:lang="AR-EG">ورهبانا 
        وكهنتنا </span></b></font></h3>
    </div></td>
  </tr>
</table>
