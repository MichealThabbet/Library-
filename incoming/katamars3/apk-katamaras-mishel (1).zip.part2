<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد يوحنا المعمدان-لما آن الأوان</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700">  أرسل الآب 
        الحنَّان</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700">لما آن الأوان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700">يوحنا 
        المعمدان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">ملاك ونبي إنسان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لطريق 
        ابنه المحبوب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">ليهيئ القلوب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يوحنا المعمدان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">صارخًا للشعوب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> الكاهن الوقور </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">لما أصاب زكريا الدور </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يوحنا المعمدان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">على مذبح البخور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700">ملاك 
        الرب أتاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">وأثناء الصلاة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يوحنا المعمدان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700">فخاف لما رآه</span></h3>
    </div></td>
  </tr>
  <tr>
