<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الانبا مرقس الأنطوني</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> على اعلى منار</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فى مدينة الانوار </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   بنيوت افا مرقس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">يضىء بين الابرار</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">سلك منذ صباه</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بنسك وصوم وصلاة </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
