  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >حاملًا لنا سر 
        الفداء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لكى يامملؤة 
        نعمة وانعام</h3></td>
    <td><h3 align="center" >فدخل على مريم 
        وقال السلام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ستحبلين بفادى 
