<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-السلام لك يا أم الإله</h1></td>
  </tr>
  <tr>
    <td><h3 align="center" >اختارها وسكن 
    فيها الإله</h3></td>
    <td><h3 align="center" >أنا أفتح فمى بمدح 
    فتاه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >السلام لك يا 
    أم الإله</h3></td>
    <td><h3 align="center" >ونقلها الى 
    عرشه وسماه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >كانت البتول 
    ملازمة الصلوات</h3></td>
    <td><h3 align="center" >بعد صعود رب 
    السموات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام لك يا 
    أم الإله</h3></td>
    <td><h3 align="center" >فى بيت يوحنا 
    صاحب الرؤيات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وارادوا 
    معاملتها بجحود</h3></td>
    <td><h3 align="center" >تشاور عليها 
    اليهود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام لك يا 
    أم الإله</h3></td>
    <td><h3 align="center" >وقالوا إبنها 
    غير موجود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فأعلمها الروح 
    القدس بثبات</h3></td>
    <td><h3 align="center" >ثابرت على 
    الصوم والصلوات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">السلام لك يا 
    أم الإله</h3></td>
    <td><h3 align="center" >عن يوم نياحتها 
    والممات</h3></td>
  </tr>
  <tr>
