<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td width="100%" colspan="2"><h1 align="center">الأم إيرينى (تماف ايريني)-السلام للمختارة</h1></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>السلام للمختارة الحبيبية البارة<br />
   ام العذراى الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>تعلمت الصلوات ودرب المطانيات <br />وطاعه رب القوات الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>ظهرلك فيلوباتير وقال لك قومى على الدير<br />لتسبح القدير الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>تركت الارضيات واحببتى السمائيات<br />ياشفيعه فى الضيقات الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>البابا يوم رسامتك تنبأ وقال لك<br />اما تكونى لشعبك الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>ايرينى كان اسمك وسلام كان عملك<br />مع كل من سألك الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>علمت الراهبات الطاعة والصلوات<br />ومحبه رب الصباؤوت الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>احببت ابى سفين وفى ديرة خدمتى سنين<br />بالامانه فى كل حين الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>الناس لما شافوكى طلبوكى ونادوكى<br />وشفيعه اخذوكى الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>ربنا مسك ايديك وعمر دير شفيعك<br />ابى سفين حبيبك الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>وعمرتى دير كرير لحبيبك فلوباتير<br />شاهد الله القدير الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>اخذت المرض صليب محبه فى الحبيب<br />ليكون لك نصيب الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>وطول فترة مرضك دايما شاكرة ربك<br />وشكرك من كل قلبك الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>العذراء وابى سيفين حبوكى هما الاتنين<br />لطالبتك متسجبين الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>الخاطى سامحتيه والحيران هاديتيه<br />والمكسور قومتيه الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>اما انت وحكيمه يا عذراء وقديسه<br />يا طاهرة وعفيفه الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>طوباكى بالحقيقه يا ام الحبيبيه <br />شفيعتنا فى الضيقه الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
      <h3>طوباكى ثم طوباكى يا حبيبه مولاكى<br />المسيح الى فداكى الام ايرينى<br />
        </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">      
