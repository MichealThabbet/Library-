<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارجرجس السكندري</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700">سطع نور بهي</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="font-weight: 700"> في مقادس العلى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مارجرجس السكندرى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لكوكب نورانى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أرمانيوس المتعالى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> خاله كان هو الوالى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> منارة المسيحية </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> على الأسكندرية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> من عبدة الأوثان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أبوه أيضًا قد كان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بالإله صانع الإنسان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لكنه غير قنعان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ظروفًا نيرات </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> إذا دبر صانع الخيرات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يسوعنا رب القوات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بها يدرك ملك السموات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فكانت له خسارة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> سافر الشام للتجارة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> للبطل الرومانى</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> إذا اتفق عيد روحانى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تقيم يوم ذاك حفلها </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مدينة اللد بأسرها</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مارجرجس حبيبها</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لتكرم شهيدها</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> سأل عن صاحب العيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ذهله الحفل العجيب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ليؤمن بإله الشهيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ففتح الرب قلبه البعيد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ينذر نذره النفيس </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> وقف في بيعة القديس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أسميه جرجس كأسمك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> إن رزقت بذرية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و البهجة تملأ قلبه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عاد بعدها إلى بلده</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بما ربحت وزنته</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و بشر زوجته</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> الأسقف الجليل </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مضى بدون تردد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> باسم الثالوث المجيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> طالبا منه التعميد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فأنجبا ولدهما</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> استجاب الرب طلبهما </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> جرجس السكندري</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> اسمياه كالرومانى </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و بره صار ظاهر </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> كبر هذا الطاهر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و للشياطين قاهر</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> في الصلوات كان ساهر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أمام بيت عذارى </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مرت بن خاله مرة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> انجذبت بالمرة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> سمعت ألحان حارة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عما سمعته يقال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> سألت جرجس في الحال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> إله كل الأجيال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تلك أنغام المتعال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بخالق كل الأكوان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و بسرعة فرحت و آمنت </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> عن حقائق الإيمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و منه استدلت</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> كيف ترفض يإصرار </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> علم أبوها و احتار</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> آلهته الزميمة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ابنته الوحيدة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و نفذ هذا الضال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> طلب شنقها ذاك الضال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ترك الإله المتعال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لقولها من المحال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مزق ثيابه و أضطرب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ندم بعدها و اكتأب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> لكل هذه النكب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و أخبروه جرجس السبب </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> كي يشفى غليله</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أمر بتعذيبه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بعد ضربه و تقطيعه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> فمضى جرجس لحبيبه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> في مدينة أنصنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و بذا نال كل المنى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> بانطلاقه للسماء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> حيث تم له الهنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ذاك اليوم المشهور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و لبس حلة من نور </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و عبر للسماء بحبور </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أي سبعة كم هاتور </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> للرومانى الشهيد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> هذا اليوم أصله عيد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> و بذا التقى الشهيدان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تكريس بيعته بالشام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أمام عرش القدوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> أذكرنا يا جورجيوس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> مع مريم أم أيسوس </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> ليمتعنا بالفردوس </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> في أفواه كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> تفسير اسمك </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-weight: 700"> يا إله مارجرجس السكندري أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-weight: 700"> الكل يقولون </span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
