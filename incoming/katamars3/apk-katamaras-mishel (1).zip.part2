<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-أمدح في البتول</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">وأشرح 
    فيها وأقول</span></b></h3></td>
    <td width="50%"><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أمدح 
    في البتول</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا جوهر مكنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا أصل الأصول</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> خلاص جنسنا</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  بإبنك يا ستنا</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وبك نحن فرحون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وبلغنا المُنى</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> من ست البنات</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  تجسد الابن بثبات</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> عند الأقرانيون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> صلب عنا ومات</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا إبنه صهيون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  ثمرة عربوني</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وكم عني يقولون؟</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> عزالي لاموني</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ببشائر وأقوال</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  جاك غبريال</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> سر خفي مكنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وقبلت ما قال</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وشرح قدرته</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  حل بكلمته</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا إبنه صهيون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> صرت كسمائه</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بعد أن كان نادم</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  خلص آدم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ونحن بك فرحون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وعتق العالم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وعاهد تلاميذه</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  دائم تمجيده</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> من كيد الأركون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يخلص عبيده</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> الملك إشتهى حسنك</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  داود قال عنك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> رب العرش المكنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وتجسد منك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> حول العرش وقوف</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ربوات ربوات وألوف</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وشهداء متصلون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وطغمات وصفوف</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وصرنا في إطمئنان</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  زالت عنا الأحزان</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا فخر البشريين</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بك يا مريم</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> إن العذراء ولدت</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  سالومي شهدت</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بالسر المكنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> آمنت واعترفت</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> صار ينشد بفنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  سليمان أبوك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> سلم سره مكنون</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ويعقوب رآك</span></b></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا كرمة مغروسة</span></b></h3></td>
    <td><h3 align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  شهد عنك الرؤساء</span></b></h3></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> كما عنك يتنبأون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا بكرة وعروسة</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بأن يسوع ظهر</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  صوفونيوس خبَّر</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والختم حصن مصون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> شبه ندى ومطر</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وصار يبكي نادم</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  ضللت حواء آدم</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لولاك ما رجعون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> خرج عريان عام</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> حيرت العلماء</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  طوباك طوباك</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> في وصفك يكلون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> فلاسفة مع حكماء</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> العالي في سماه</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  ظهر منك الإله</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> كسائر المخلوقين</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ورضع لبنك غذاه</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وعظيم هو مجدك</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  عال هو قدرك</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا شورية هرون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والله شرَّف ذكرك</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا بدء الأفراح</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  غلب فيك المداح</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> كل ذليل محزون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بمدحك يرتاح</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا مريم طلبي</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  فيك رضا قلبي</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بقوته أكون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يسوع ابنك حسبي</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> صلب عنا وتألم</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  قديم أزلي دائم</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> والتلاميذ يكرزون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> استيقظ كالنائم</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> الرسل الأبرار</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  كرزوا في الأقطار</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> الآباء الإنجيليون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ونادوا بإستبشار</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا إبنه يواقيم</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  لك كل التعظيم</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ووضعت المكنون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> حملت السر العظيم</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> ضربوا عنك أمثال</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  موسى ودانيال</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بسر خفي مكنون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وقبلت ما قال</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> يا فخر الإيمان</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  نورت الأكوان</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> كل الخلائق يعتقون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لولا إبنك ما كان</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> أتوا بها الأعيان</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  هدايا بإيمان</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> بها المجوس حاضرون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> مرًا وذهبًا ولبنان</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> الرب المعبود</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  وسجدوا للمولود</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وجنده محتارون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وهيرودس صار مرعوب</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> عبدًا خاطئ مسكين</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  لا تنسى في ذلك الحين</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لشعب إبنك أجمعون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> شفاعتك يوم الدين</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> جرحي بك يبرا</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  يا ستي يا عذراء</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> القوة والعون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> طالب من رب القدرة</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> وتوبة مع إيمان</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA">  ونسأل من جوده الغفران</span></b></div></td>
  </tr>
  <tr>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> نحن المؤمنون</span></b></div></td>
    <td><div align="center"><b><span lang="AR-SA" xml:lang="AR-SA"> لنصير في إطمئنان</span></b></div></td>
  </tr>
</table>
</body>
</html>
