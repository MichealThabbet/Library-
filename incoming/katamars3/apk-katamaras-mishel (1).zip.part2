  </tr>
  <tr>
    <td><h3 align="center" >هذا كلام ليس 
        معقول</h3></td>
    <td><h3 align="center" >قالت الصبية 
        بخوف وذهول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >أعذراء تحبل 
        وهى بتول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وأحمله على يدى 
        وأراه</h3></td>
    <td><h3 align="center" >كيف أحبل وألِد 
        إله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وأكون له أما 
        وأين أباه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >سوى يوسف ألوصى 
        علىَّ</h3></td>
    <td><h3 align="center" >لم أعرف رجال 
        بالكلية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وهو لم يقرب 
        الىَّ</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >سيحل عليكِ روح 
        المتعال</h3></td>
    <td><h3 align="center" >ملاك الرب 
        أجابها وقال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >فلا تهتمى بهذه 
        الأحوال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >حبلى مع ان 
        أوانها فات</h3></td>
    <td><h3 align="center" >نسيبتك العاقر 
        اليصابات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ولها ستة أشهر 
        بثبات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >قالت العذراء 
        أم الوحيد</h3></td>
    <td><h3 align="center" >هو السيد ونحن 
        العبيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >يفعل بى ما 
        يشاء ويريد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وترك الطاهرة 
        فى حجرتها</h3></td>
    <td><h3 align="center" >ومضى الملاك من 
        حضرتها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >تشكر الرب فى 
        طلبتها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >المغرم بتأليف 
        التسابيح</h3></td>
    <td><h3 align="center" >لا تنسى ناظم 
        هذا المديح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >يسألك شفاعة 
        أمام المسيح</h3></td>
  </tr>
  <tr>
