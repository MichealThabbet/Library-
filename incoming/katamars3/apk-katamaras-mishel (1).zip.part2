      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وأشكر الهى الرب ايسوس</span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  أبدأ باسم الله القدوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وأرسل مديحى إلى الفردوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> والنفوس به محمية</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  اكبر قديس له شعبية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ينجى من كل بلية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وشربه حقيقة المسيحية</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  سلمه ابوه شهادة حية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> فاشتاق لتلك اللحظة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> هى خلاصى ونجدتى</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  طهارتى ومحبتى</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ودى سر قوتى </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> حولها الهى لقديسة</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> جابوا لى واحدة شريرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> وطلبت تكون شهيدة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> ومعجزاتك فى كل زمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG">  معروفة مكانتك فى كل مكان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3 class="MsoNormal" style="text-align:center" align="center"> <span style="font-weight: 700" dir="rtl" lang="AR-EG" xml:lang="AR-EG"> باشيوس ابؤورو جورجيوس</span></h3>
