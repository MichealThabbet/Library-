    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"> وقد أقام لنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">حسب غنى رضاه</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> من فضله رعاه</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">أحدهم يا أخوة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">الإثنى عشر النفيس</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> وهو أحد التلاميذ</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">عبد الرب القديس</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">أن يمضى إلى الواحات</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> خرجت قرعته بثبات</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">ليبشر برب القوات</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> بكرازة ربها</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">  فبشر أهلها</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> إلهها من أحبها</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> باهرة ومعجزات</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">  وأظهر لهم آيات</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> تذهل العقول بثبات</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> ذو النفس الحصينة</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">  ودخل المدينة</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> إذ باعه أبينا</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> وصار يعمل ذو المجد</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700">   بطرس الرسول كعبد</span></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3></td>
    <td><h3 align="center"><span style="font-family: Arabic Transparent; font-weight: 700"> فى كرم غنى بجد</span></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> ابن شيخ البلد</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  وحدث أنه مات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> فأقامه من الأموات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> بكرازة ربهم</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  فآمنوا كلهم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> وأمره إلههم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> إلى بلاد البربر</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  أن يمضى هذا الأكرم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> وخصص لـه الأبهر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> لمساعدته بالخصوص</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  القديس أندراوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> فرد هذا المأنوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> وبنى كنائس وكرس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  أهل بلاد البربر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> كهنة لخدمة الأقداس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> الملك الشرير</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  فسمع بـه أغرباس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> فصنع لـه تدبير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> فى كيس شعر ويملاؤه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  وأمر أن يضعوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> رملًا ويطرحوه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> بـه فأكمل سعيه</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  فى البحر ففعلوا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> وجهاده لربه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> شفاعته تسندنا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  صلواته تكون معنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> من الزلل تمنعنا</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> من كل الدسائس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  وتكون لنا حارس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> وللملكوت نرث</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> نقول لك أكسيوس</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  يا مرشد النفوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> أكسيوس أكسيوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> كل المؤمنين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700">  تفسير اسمك فى أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> برثلماوس الرسول أعنا آجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="font-family: Arabic Transparent; font-weight: 700"> الكل يقولون يا إله </span></h3>
    </div></td>
  </tr>
