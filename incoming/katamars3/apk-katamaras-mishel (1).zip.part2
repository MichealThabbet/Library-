<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">الشهيد أبو قسطور 
	البردنوهى</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1"> من جاد بالحبور<br />
    </h3></td>
    <td width="50%" class="auto-style1"><h3 align="center" class="auto-style1">  
	+  أبدأ باسم إله النور<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وأخزى الشيطان المغرور<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وجاد بفداءنا<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  من جاء لأرضنا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ونجانا من أسرنا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهداء وكرموه<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  فلهذا أحبوه<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ودماءهم قد سفكوا<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهداء يا أحباء<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  من أحد هؤلاء<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الذين أرضوا السماء<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> أخزى العدو المغرور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> + قديس طاهر مبرور<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ونال إكليل النور<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> هذا الرجل الودود<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  فى بردنوها مولود<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> محب بلا جحود<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فى إيمانهما ثابتين<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> + من أبوين مسيحيين<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> للرب عايشين<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> والتقوى أرضعاه<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  على الفضيلة ربياه<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> فلازم خدمة البيعة<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> ليخدم الأقداس<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  + وقد سيم 
	شماس<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> الشهيد آبـا قسطور<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> بحب واحتراس<br />
    </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center" class="auto-style1"> وقسًا لربه رسموه<br />
    </h3></td>
    <td class="auto-style1"><h3 align="center" class="auto-style1">  +  وبعد ذلك زوّجوه<br />
    </h3></td>
