  <tr>
    <td colspan="3"><h1 align="center">القديسة مريم المصرية</h1></td>
  </tr>
  <tr>
    <td><h3 align="center"><span style="font-weight: 700">أحرك لسانى</span></h3></td>
    <td><h3 align="center"><span style="font-weight: 700">أبدأ يا إخوانى</span></h3></td>
