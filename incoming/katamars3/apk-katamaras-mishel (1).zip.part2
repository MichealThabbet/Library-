<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد بستافروس الجديد</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    بستافروس الجديد</span></font></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">السلام للبطل الشهيد</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  وسار وراء الحبيب</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">الذى حمل الصليب </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  سحق قوة الشيطان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بستافروس فخر الشجعان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> من الرب الديان</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ونال اكاليل وتيجان</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">بدون اى مزاج</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ارغمت على الزواج</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    العيشة البتولية</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فنذرتما سوية    </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   وظل حولكما</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ميخائيل حفظكما</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">  بحب عريسكما</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">حتى التهب قلبكما</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> لتخدم عمانوئيل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">عزمت على الرحيل</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    بقوة ولهيب</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">كرزت باسم الحبيب</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   وسعيت له باجتهاد</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">اشتهيت الاستشهاد</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">كسيدك ويميتوك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">تمنيت لو يصلبوك </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   بالحديد كبلوك</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">والداك قيدوك</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    وظهرت دلائل</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">فانحلت السلاسل   </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   محصى شعر الرؤوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">ان الرب محيى النفوس</span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">   وحلك من كل حبوس</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">مديمينه القدوس  </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">    فظهرت لك على طول</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">طلبت امك البتول </span></font></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700"> ان صمدت صمود</span></font></h3>
    </div></td>
    <td><div align="center">
      <h3><font face="Times New Roman"><span style="font-weight: 700">وعدتك بوعود</span></font></h3>
