<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="2" class="auto-style1"><h1 align="center">القديس الأنبا مرقس الأنطونى</h1>
	<h1 align="center">( فى مدينة الأنوار )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center"> على أعلى منار</h3></td>
    <td width="50%" class="auto-style1"><h3 align="center">+ فى مدينة الأنوار</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">يضىء بين الأبرار</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  سلك منذ صباه</h3></td>
    <td class="auto-style1"><h3 align="center">+ بنسك وصوم وصلاة</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">فجذب قلب الإله</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  القديسة التقية</h3></td>
    <td class="auto-style1"><h3 align="center">+ أرشد أمه أودكسية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">بحب وحكمة إلهية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">ترك زاده للرعاة</h3></td>
    <td class="auto-style1"><h3 align="center">+ فضل خبز الحياة</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">أحبه كل من رآه </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  ليدخل بيعة الأطهار</h3></td>
    <td class="auto-style1"><h3 align="center">+ بإيمان ربط الحمار</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">وينال سر الأسرار</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> للبرية خرج فرحان</h3></td>
    <td class="auto-style1"><h3 align="center">+ زهد لهو الصبيان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">بنسكه فاق الرهبان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> يشكو ضعف الرهبان</h3></td>
    <td class="auto-style1"><h3 align="center">+ لأمه عاد غضبان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">ردته بقوة إيمان  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  سكن محب الديان</h3></td>
    <td class="auto-style1"><h3 align="center">+ فى دير أب الرهبان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">فأعاد مجد الزمان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> والليالى للصلاة قائم</h3></td>
    <td class="auto-style1"><h3 align="center">+ طوى الأيام صائم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">والعمر ببكاء دائم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لإشارة استجاب</h3></td>
    <td class="auto-style1"><h3 align="center">+ ايسيذوروس بإعجاب </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا مرقس</h3></td>
    <td class="auto-style1"><h3 align="center">فصام مع الدواب </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   لزم ديره الحبيب</h3></td>
    <td class="auto-style1"><h3 align="center">+ بصبر وثبات عجيب </h3></td>
  </tr>
  <tr>
