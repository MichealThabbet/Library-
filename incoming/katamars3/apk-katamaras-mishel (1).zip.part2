<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا باخوميوس أب الشركة-السلام لك يا قديس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">  يا انبا باخوميوس</h3></td>
    <td width="50%"><h3 align="center">السلام لك يا قديس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   اجيوس اجيوس اجيوس</h3></td>
    <td><h3 align="center">اخذت اكليل نفيس </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  نسر يحلق ويطير</h3></td>
    <td><h3 align="center">اسمك معناه جميل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  وانتصرت على الشرير</h3></td>
    <td><h3 align="center">جهادك كان طويل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   من عائلة وثنية</h3></td>
    <td><h3 align="center">نشات فى طيبة </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> من الجيوش الرومانية</h3></td>
    <td><h3 align="center">وخرجت محاربا  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  جذبك للمسيحية</h3></td>
    <td><h3 align="center">لقاؤك في اسنا  </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  لمست التضحية</h3></td>
    <td><h3 align="center">في معاملة اهلها   </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  بيد انبا سرابيون</h3></td>
    <td><h3 align="center">اعتمدت واخذت الميرون</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   بيد انبا بلامون</h3></td>
    <td><h3 align="center">واسكيم الرهبان </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وامرك ببناء الدير</h3></td>
    <td><h3 align="center">ظهر لك ملاك الله</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  وقد اعطاك تدبير</h3></td>
    <td><h3 align="center">للشركة الرهبانية </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   لارشاد الرهبان</h3></td>
    <td><h3 align="center">علي لوح من نحاس </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">   كثيرا من الشبان</h3></td>
    <td><h3 align="center">بفضائلك قد جمعت </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  انتشر في كل مكان</h3></td>
    <td><h3 align="center">نظام الشركة الباخومية</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  موجود حتي الآن</h3></td>
    <td><h3 align="center">للرهبان والراهبات </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  بدون أي رياء</h3>    </td>
    <td><h3 align="center">قيادتك حكيمة</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   احببت الضعفاء</h3>    </td>
    <td><h3 align="center">بأبوة عظيمة</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    امام كل اولادك</h3>    </td>
    <td><h3 align="center">قدوة ومثال واضح  </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  فهموا ارشادك</h3>    </td>
    <td><h3 align="center">بطول الاناة </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">     في طاعة وخضوع</h3>    </td>
    <td><h3 align="center">تادرس كان تلميذك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    وخدم الرب يسوع</h3>    </td>
    <td><h3 align="center">اتعلم فضائلك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  في كل حياتك</h3>    </td>
    <td><h3 align="center">طلبت ارادة الله</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   بلجاحة في صلاتك</h3>    </td>
    <td><h3 align="center">وطلبت للرهبان النسك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   الله قد ظهر لك</h3>    </td>
    <td><h3 align="center">في رؤي كثيرة </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  قد مدح اعمالك</h3>    </td>
    <td><h3 align="center">بمحبة كبيرة  </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  الكهنوتية</h3>    </td>
    <td><h3 align="center">هربت من الرتب </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   لحياة البرية</h3>    </td>
    <td><h3 align="center">ونصحت اولادك  </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    في منظر امراة</h3>    </td>
    <td><h3 align="center">ظهر لك الشيطان </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> قاومته بجراءة</h3>    </td>
    <td><h3 align="center">بقوة المسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">  انه ضعيف جدا</h3>    </td>
    <td><h3 align="center">اعترف لك الشيطان   </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    المملوءة مجدا</h3>    </td>
    <td><h3 align="center">امام قوة يسوع </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   بالصوم مع الصلاة</h3>    </td>
    <td><h3 align="center">فنصحت الرهبان</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    والاتكال علي الله</h3>    </td>
    <td><h3 align="center">والسهر الدائم</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">    هي توبة الخطاة</h3>    </td>
    <td><h3 align="center">اعظم معجزة عندك </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   ليفوزوا بالنجاة</h3>    </td>
    <td><h3 align="center">ورجوعهم لالهك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  انتشر مرض الطاعون</h3>    </td>
    <td><h3 align="center">في بعض الاديرة </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  وطلبت لهم العون</h3>    </td>
    <td><h3 align="center">شجعت اولادك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> فاصابك الوباء</h3>    </td>
    <td><h3 align="center">خدمت المرضي باتضاعك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  فاخبرت الآباء</h3>    </td>
    <td><h3 align="center">وعلمت بانتقالك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> هو يوم نياحتك</h3>    </td>
    <td><h3 align="center">اربعة عشر بشنس</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   وكثيرة عجائبك</h3>    </td>
    <td><h3 align="center">قوية شفاعتك </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   حتي نغلب ابليس</h3>    </td>
    <td><h3 align="center">وصل لنا كل حين</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   والعبادة والتقدير</h3>    </td>
    <td><h3 align="center">وننمو في المحبة </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  امام عرش الهك</h3>    </td>
    <td><h3 align="center">اذكرنا نحن اولادك </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> كتادرس تلميذك</h3>    </td>
    <td><h3 align="center">فنتمثل بجهادك</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">  وشركاءه اساقفتنا</h3>    </td>
    <td><h3 align="center">يا رب اذكر بطريركنا</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   ورهباننا وشمامستنا</h3>    </td>
    <td><h3 align="center">وسائر كهنتنا   </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> احفظهم في الايمان ثابتين</h3>    </td>
    <td><h3 align="center">وكل الشعوب المسيحيين</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   انفوز بالايمان آمين</h3>    </td>
    <td><h3 align="center">كن لنا معين </h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center">   كل المؤمنين</h3>    </td>
    <td><h3 align="center">تفسير اسمك في افواه</h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"> انبا باخوميوس اعنا اجمعين</h3>    </td>
    <td><h3 align="center">الكل يقولون يا اله</h3>    </td>
  </tr>
</table>
</body>
</html>
