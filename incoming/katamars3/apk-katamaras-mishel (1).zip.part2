    <td><h3 align="center" >سجدوا فى الحال 
    بفرح وسرور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >ومجدوا الإله 
    الغير منظور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >هذه الصبية 
    للمتعال</h3></td>
    <td><h3 align="center" >شكر يواقيم 
    الرب وقال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >تخدمه بهيبة 
    وجلال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >فى قدس الأقداس 
    وف القبه</h3></td>
    <td><h3 align="center" >صارت الصبية 
    تتربى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >حتى كبرت وصارت 
        شابه</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لرجل بار 
        ويزوجوها</h3>
    </div></td>
    <td><h3 align="center" >ضمر الكهنة ان 
        يعطوها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وعن خدمة 
		الهيكل منعوها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >وضمنهم يوسف 
        النجار</h3></td>
    <td><h3 align="center" >طلبوا جمع 
        الرجال الأبرار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وعملوا القرعة 
        على الحضار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >إن يوسف رجل 
        أمين</h3></td>
    <td><h3 align="center" >ظهرت الرؤية 
        للمقترعين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >فأعطوه مريم 
        بثقة ويقين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >لم تعرف للخطية 
        طريق</h3></td>
    <td><h3 align="center" >عاشت فى بيت 
        يوسف الصديق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">طوباك يا إبنة   				يواقيم</h3></td>
    <td><h3 align="center" >وبتوليتها بدون 
        تمزيق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" >ببشارة وفخر من 
