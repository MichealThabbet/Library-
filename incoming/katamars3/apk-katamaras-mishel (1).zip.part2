<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الأنبا صموئيل المعترف</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">فخر 
    المجاهدين </span></font></h3></td>
    <td width="50%"><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">في صفوف المعترفين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">  
    نجم بين القديسين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">قصدت 
    البرية </span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بدعوة الهية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">في 
    محبة نارية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">إقتادك 
    بمهارة </span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"><span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ملاك 
    كله طهارة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    لإسقات انبا مقار</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ناسكًا 
    كل الزمان </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> لشيخ 
    بين الرهبان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    قهر 
    العدو الشيطان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">والمحبة 
    النقية</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> نصحك 
    بالبتولية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    والتواضع بوصية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ضعفين 
    من روحه</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> أعطيت بنعمته</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    عند 
    نياحته</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">وقهرت 
    لذاتك</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">زدت 
    من اتعابك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    وحبك لالهك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">محبة 
    مقاريومس </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">نلت 
    ابوة انطونيوس</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    وايمان ديسقوروس</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">وعشرتك 
    الالهية</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">برائحتك الذكية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    ملأت البرية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">والحياة 
    النسكية </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> علمتهم الرهبانية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    وتعاليم الارثوذكسية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">مكتوب 
    من الشيطان </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ارسل 
    القوقس بيان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    الي الاباء الرهبان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">وغير 
    متحدين </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">يقول 
    بطبيعتين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    للرب الفادي الامين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">من 
    يعترف بالابن الحويد</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">هدد 
    بقتل ووعيد</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    ويتبع باباه الحبيب</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">الاشرار 
    الاقوياء</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">هجم 
    علي الصحراء</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    ورفضت بشمم وابادة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">اعتراف 
    صادق صريح</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> اعترف بالمسيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    ومزقت التصريح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">لاهوتية 
    وناسوتية </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> طبيعة نقية واحدة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    متحدة بالكلية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">الإله 
    صار معنا </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> الكلمة صار جسدًا</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    وراينا مجده مجدًا</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">جلدوك 
    في وحشية </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ضربوك بايدي قوية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">    
    الايمان وديعة غالية</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">بيسوع 
    برجك الحصين</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> اعترف بايمان ويقين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    قلعوا عينك اليمين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ليحفظوا 
    الايمان </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> اوصيت اربعة رهبان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    اتخذوا القلمون مكان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ودموعك 
    ومطانياتك </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> قدسته بصلاتك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    وصلبك لذاتك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">كسر نزر 
    البتولية </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">حاول 
    البربر المتجبرين</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    صرخت ليسوع المسيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">بقلب 
    جريح كئيب</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">مر 
    بك كسيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    شفيته بقوة المسيح</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">لكل مرض 
    وداء</span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">صرت 
    ينبوع شفاء</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    حتى البربر والاعداء</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">سألك 
    ايها البار </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">قائد 
    البربر الجبار</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    زوجتي عاقر محتار</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">بايمان 
    غير مرتاب </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">طلبت 
    من الله الاب</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    فوهبهما الانجاب</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> ليتعلموا جهادك </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">عدت 
    لأولادك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    وفزت بامجادك</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">امام 
    عرش الإله </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> اذكرنا في الصلاة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بنيوت افا صموئيل</h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">     
    ليرحمنا نحن الخطاة</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">يثبتنا 
    في الايمان </span></font></h3></td>
    <td><h3 align="center" class="MsoNormal" dir="rtl"> <font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">صلي 
    عنا للديان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA"> بنيوت 
    افا صموئيل</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">الي اخر 
    الازمان</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">وشركاؤه 
    اساقفنا</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">احفظ 
    يا رب بطركنا</span></font></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">بصلاة 
    الانبا صموئيل</span></font></h3></td>
    <td><h3 align="center"><font face="Times New Roman"> <span style="font-weight: 700" lang="AR-SA" xml:lang="AR-SA">ورهبانا 
    وكهنتنا</span></font></h3></td>
  </tr>
</table>
