<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيدة أغاثي</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">لـه العظمة والتمجيد<br />
    </span></strong></h3></td>
    <td width="50%"><h3 align="center">  باسم الثالوث الوحيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> نمدح عروس النشيد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الفتاة النقية<br />
    </span></strong></h3></td>
    <td><h3 align="center">  كملّت الوصية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فى باليرم وصقلية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">للعاقر والدتها<br />
    </span></strong></h3></td>
    <td><h3 align="center"> جات بشرى بميلادها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> ورثت غنى أسرتها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">قصدها ذووا التيجان<br />
    </span></strong></h3></td>
    <td><h3 align="center"> جمالها فاق الأقران<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> رفضت عُباد الأوثان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الوثنى الظالم<br />
    </span></strong></h3></td>
    <td><h3 align="center">  سمع عنها الحاكم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> لخطوبتك أنا قادم<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">ليسوع ولـه محبوبة<br />
    </span></strong></h3></td>
    <td><h3 align="center">  مهلًا أنا مخطوبة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وعروسة أنا محسوبة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بوعود يستعطفها<br />
    </span></strong></h3></td>
    <td><h3 align="center">  حاول يلاطفها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> وتارة يُعنفها<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تسودى على البلدان<br />
    </span></strong></h3></td>
    <td><h3 align="center">  ضحى للأوثان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> لئلا تذوقى الهوان<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">والهتك ملعونة<br />
    </span></strong></h3></td>
    <td><h3 align="center">  أنا حرة ومصونة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> بإلهى المعونة<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وضعوا الصبية<br />
    </span></strong></h3></td>
    <td><h3 align="center"> فى بيت للخطية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> 30يوم متوالية<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">داست قوى الشر<br />
    </span></strong></h3></td>
    <td><h3 align="center">  فى عامها الثالث عشر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> هزمت الحاكم الغر<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">والإغراء والوعيد<br />
    </span></strong></h3></td>
    <td><h3 align="center">  رغم كل التهديد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> إرادتها كالحديد<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">عريسى هـو يسوع<br />
    </span></strong></h3></td>
    <td><h3 align="center">  صرخت بصوت مسموع<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">تى آجيا أغاثى<br />
    </span></strong></h3></td>
    <td><h3 align="center"> يليق لـه الخشوع<br />
    </h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">غناه ومباهجه تؤول<br />
    </span></strong></h3></td>
    <td><h3 align="center">  مجد العالم يزول<br />
    </h3></td>
  </tr>
  <tr>
