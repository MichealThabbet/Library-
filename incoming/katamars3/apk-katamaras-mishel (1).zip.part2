<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-طوباك يا عذرى وبتول</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center" dir="rtl">للذى حل بجبل 
    قسقام</h3></td>
    <td width="50%"><h3 align="center" dir="rtl">المجد والعظمة 
    والإكرام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">طوباك يا عذرى   				وبتول</h3></td>
    <td><h3 align="center" dir="rtl">مع أمه نسل 
        الكرام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">سيملك بدله على 
        اليهود</h3></td>
    <td><h3 align="center" dir="rtl">ظن هيرودس أن 
        المولود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">طوباك يا عذرى   				وبتول</h3></td>
    <td><h3 align="center" dir="rtl">ولم يعلم انه 
        المعبود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">حتى يكون 
        مستريح البال</h3></td>
    <td><h3 align="center" dir="rtl">زعم ان يقتل كل 
        الأطفال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">طوباك يا عذرى   				وبتول</h3></td>
    <td><h3 align="center" dir="rtl">فظهر الملاك 
        ليوسف فى الحال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">وخذ الصبى وأمه 
        بأمان</h3></td>
    <td><h3 align="center" dir="rtl">قائلا اهرب الى 
        مصر الآن</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">لأن هيرودس 
        ملاه الطغيان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">وساروا فى 
        الأودية والجبال</h3></td>
    <td><h3 align="center" dir="rtl">فنهضوا للسفر 
        فى الحال</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">ورأوا كثيرًا 
        من الأهوال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">ولم يرَّحب بهم 
        إنسان</h3></td>
    <td><h3 align="center" dir="rtl">لم يجدوا راحة 
        فى أى مكان</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">إذ كانت عبادة 
        الأوثان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">فوجدوا هناك 
        راحة وسلام</h3></td>
    <td><h3 align="center" dir="rtl">الى أن وصلوا 
        لجبل قسقام</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">فقضوا به أسعد 
        أيام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">وقال الصبى حىٌ 
        للآن</h3></td>
    <td><h3 align="center" dir="rtl">ظهر لهيرودس 
        الشيطان</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">هو وأمه فى مصر 
        هربان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">فإرسل أجنادك 
        والخدام</h3></td>
    <td><h3 align="center" dir="rtl">والآن موجود 
        بجبل قسقام</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">للقبض عليه ولا 
        تنام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">وقال إمضوا 
        لمصر بقيود</h3></td>
    <td><h3 align="center" dir="rtl">فدعا هيرودس 
        عشرة جنود</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">فى جبل قسقام 
        تجدوا المولود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">وعلى الرزايا 
        متفقين</h3></td>
    <td><h3 align="center" dir="rtl">فذهب الجند 
        مسرعين</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">وهيرودس وشعبه 
        كانوا فرحين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">نبى إسمه يوسى 
        باورشليم</h3></td>
    <td><h3 align="center" dir="rtl">سمع هذا الأمر 
        الأليم</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">فأسرع لجبل 
        قسقام يهيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">فأستقبله شيطان 
        عنيد</h3></td>
    <td><h3 align="center" dir="rtl">وصل الجبل 
        بعناء شديد</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">وقال يا يوسى 
        تعبك لا يفيد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">هو ومن معه من 
        القيام</h3></td>
    <td><h3 align="center" dir="rtl">سبقك الجند 
        وأخذوا الغلام</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طوباك يا عذرى   				وبتول</h3>
    </div></td>
    <td><h3 align="center" dir="rtl">فإرجع وصدق هذا 
        الكلام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center" dir="rtl">معروف بالكذب 
        والبهتان</h3></td>
    <td><h3 align="center" dir="rtl">قال له النبى 
        أنت الشيطان</h3></td>
  </tr>
  <tr>
