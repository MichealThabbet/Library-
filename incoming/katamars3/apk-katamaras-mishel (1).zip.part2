<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس الأنبا باخوميوس أب الشركة-السلام لك يا أنبا باخوميوس</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">يا خادم الإله القدوس<br />
    </span></strong></h3></td>
    <td width="50%"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> السلام لك يا أنبا باخوميوس<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">حبيب الر ب إيسوس<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بإقليم طيبة ولدوه<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> وثنى كان أبوه<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> وباخوم قد أسموك<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">لـه معنى وتفسير<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> اسمك حلو وجميل<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">نسر يحلق ويطير<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">صرخ الكاهن وقام<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> لما زرت معبد الأصنام<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كأنما أصابته سهام<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">ابعدوه عن هيكلنا<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> هذا عدو إلهنا<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">وانفوه عن معبدنا<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كيف تنعم بالبركات<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> دبر لك صانع الخيرات<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">لتعرف المكنونات<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">كيف يكون حب أخاك<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> أدخلك الجيش وأراك<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">اسنا خرجت للقاك<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">بضمائر وصفاء نية<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> قدموا لكم معونة<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">فأحببت المسيحية<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">لو الرب أعطاك نصرًا<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> نذرت فى قلبك نذرًا<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">لا تنسى يسوع أبدًا<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">فأبطل الجيش الضربة<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> فى أنصنا أتى خبر الغلبة<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">وعاد إسنا بفرحة<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">وسكنت كنيسة الضيعة<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> قصدت كاهن البيعة<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">تشبع نفسك الجائعة<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">رأيت فى منامك<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> فى ليلة عمادك<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span dir="ltr">بينيوت افا باخوميوس</span><span lang="AR-SA" xml:lang="AR-SA"><br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">ندى كقرص عسل فى عينيك<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA">من يد أنبا سرابيون<br />
      </span></strong></h3>
    </div></td>
    <td><div align="center">
      <h3><strong><span lang="AR-SA" xml:lang="AR-SA"> اعتمدت وأخذت الميرون<br />
      </span></strong></h3>
    </div></td>
  </tr>
  <tr>
