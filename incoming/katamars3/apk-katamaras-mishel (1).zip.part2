    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تحت أقدام الحبيب </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وحدك عند الصليب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> علامة حبك العجيب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> على العدرا في حياتك </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">إئتمنك إلهك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وقال هوذا أمك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وجه لأمه كلامه </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وفي وسط آلامه </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وقال هوذا إبنك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قصد القبر الخالي </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بعد قيامة الفادي </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كان أول من آمن</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> شفى الأعرج المقعود </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وبعد الصعود </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مع بطرس الرسول </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وكل ربوع آسيا </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">بشر في أفسس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ونفي إلى بطمس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إنجيله وسفر الرؤيا </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">كتب أسفار خمسة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ورسائل ثلاثة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> كنت توعظ أولادك </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وفي آخر أيامك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بمحبة إلهك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> المحبة في أعمالك </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">المحبة هي حياتك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وفي كل كلامك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يثبتنا على الإيمان </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">صلى أمام الديان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إلى آخر الأزمان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بنعيد لأبونا </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">في 4 طوبة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عيد نياحة مهيبة </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> طلباته ترفعنا </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">صلواته تكون معنا </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> للرب فيقبلنا </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> محبة نارية </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">أعطينا يا مسيا </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ماريوحنا الحبيب</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  كما كانت لحبيبنا </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أيها الحبر المأنوس </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">طوباك ثم طوباك </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  أكسيوس أكسيوس أكسيوس </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> الملايكة ترتل لك</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3> كل المؤمنين </h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> تفسير إسمك في أفواه </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  مار يوحنا أعنا أجمعين </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3> الكل يقولون يا إله </h3>
    </div></td>
  </tr>
