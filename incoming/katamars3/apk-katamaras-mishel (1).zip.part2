<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارجرجس الروماني-أبدأ باسم خالق الأكوان</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">الذي له التصريف في الوجود </span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">أبدأ باسم خالق الأكوان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الإله ذو العظمة المعبود </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من له الأقدار والسلطان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> على الكفرة أعداء الدين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بعونه قد انتصر الشجعان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفتحوا للوري أبواب اليقين </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فشيدوا بجهادهم الإيمان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لابادة جيوش الضلال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تمادوا على حب الجهاد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إلى طريق الرب ذى الجلال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأرشدوا من كان في فساد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بباهر الآيات وفصيح الكلام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ثابروا على الجهاد والإيمان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مقدمهم مارجرجس الهمام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الذي برهن على الديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وانه الممجد منشئ الآنام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> جاهر بالدعوة لدين المسيح</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا يثنيه ارهاب ولا إيهام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقلب ثابت وإيمان صحيح<span style="mso-spacerun:yes">  </span></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> من غير ملل ولا تعب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حارب سبع سنين الأعداء </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأخذ الكافرين العجب </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وداوي بمرهم ثباته الداء </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> في عبادة الأصنام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> خاطبه ملك ملوك الفرس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ورشقه بسهام الملام </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأظهر له شهامة النفس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فلم تنجح فيه المكيدة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> دبر لهلاكه التدابير<span style="mso-spacerun:yes">  </span></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأحسن شكره وتمجيده </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونجاه من شره القدير</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صاحب الإوصاف الحسنة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ذلك جرجس المقدام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وهو ابن عشرين سنة </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> الذي مات أبوه الوزير الهمام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فسافر إلى مقر السلطان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> رغب أن يكون محل أبيه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فوجده يعبد الأوثان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليجعله بدل والده ويوليه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ورجع إلى من معه من الغلمان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> زاد غضبه واشتد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> للملك من الهدايا الحسان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقسم بينهم ما كان أعد </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إلى بلادهم والأوطان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سألهم بعد ذلك السفر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأمة أو أحد الأخوان </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأن لا يذيعوا هذا الخبر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> علامة الصليب وقال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> شاهد الملك وأمامه رسم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مأوي شياطين الضلال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> آلهتكم من الجمر الأصم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقال أطعني أيها الأمير </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صعب على الملك الكلام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأجعلك أجل وزير</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لأعطيم نصف ملكي بالتمام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وقال مهما كان من ملكك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ضاق صدر القديس من كلامه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فلا اغتر بزخرف قولك </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فإنه من فضل ربي واكرامه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> إذ قال اقطع جيشكم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طار عقله من قول البار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وأبدد بالمسيح شملكم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقوة الملك الجبار </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أن يعروه ويكسروا اعضاء </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ظهر غضب الملك فأمر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأقامه الرب يسوع وشفاه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ففعلوا كل ذلك واشتهر </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وامر بسجنه وضربه بالسياط</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عاينه الملك فازداد غضبه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأقامه حيا بعد الممات </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولكن تداركه بالألطاف ربه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فقال أنا جرجس سحار </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غلب الكفر على الملك واعماه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ليذيقه الهلاك والبوار</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فاحضر أحد السحرة العتاة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فشربه القديس من غير ضرر </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فناوله كأسا في سم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فخاب صنع من كفر </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتعطف عليه الإله وتكرم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فامر الملك بقطع رأسه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> قبل الساحر الإيمان واعتراف </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ولم يخف من بطشه وبأسه </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فقطعت ونال الشهادة والشرف</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> غريق في بحار ضلاله </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> كل هذا والملك غفلان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ويعاقبه الله على افعاله </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> حتى يحل به الذل والهوان </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> طلب تحويل الكراسي أشجارا </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لجبره وعظيم كفره </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فاورقت وحملت أثمارا </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فتضرع القديس لخالقه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مع صنع كل هذه الآيات </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> مازال الكافر في طغيانه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفعل المنكر والسيئات</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وتمادي في قسوته وعصيانه </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وحظي بنعيم الجنات </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> نال القديس الشهادة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وورثه ملكوت السموات<span style="mso-spacerun:yes">     </span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واعطاه الله السعادة </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فنال قاصدها كل غرض</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> هل على بيعته القبول </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وشفاه الله من كل مرض</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفاز بغاية المأمول</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا إله الخلق يا قدير </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لا تحرمنا من بركاته </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فأمك الرؤوف النصير </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> ونجنا بعظيم شفاعاته </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا من منحته السبعة أكاليل </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> يا ربنا يا واسع الكرم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> لنديم لك المجد والتهليل </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> تفضل علينا بالنعم </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وشريكه أسقفنا المفضال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> واحفظ البابا بطريركنا الهمام </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بلغهم كل فضل وكمال </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> والكهنة والشمامسة والخدام </span></h3>
    </div></td>
  </tr>
</table>
</body>
</html>
