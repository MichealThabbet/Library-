<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديس أبو مقار الكبير-طوباك يا أبو مقار</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center"> <strong><span dir="ltr"> </span><span lang="AR-SA" xml:lang="AR-SA">يالابس الروح<br />
    </span></strong></h3></td>
    <td width="50%"><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> طوباك يا أبو مقار<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">ومن الله ممدوح<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">يا محاطا بالأنوار<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">رأى منظر عظيم<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> والده الأب ابراهيم<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الطوباوى مكاريوس<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">ابنًا يعطى لـه وكريم<br />
    </span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">رزقت أمه سارة<br />
    </span></strong></h3></td>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA"> وبعد قليل بمسرة<br />
    </span></strong></h3></td>
  </tr>
