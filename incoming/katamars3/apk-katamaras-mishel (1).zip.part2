<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
.auto-style1 {
	direction: rtl;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3" class="auto-style1"><h1 align="center">القديسان الشهيدان أباكير ويوحنا</h1>
	<h1 align="center">( أبدي باسم الآب خالقنا )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center">والابن فادينا والروح مقدسنا</h3></td>
    <td width="50%" class="auto-style1"><h3 align="center">+ أبدى باسم الآب خالقنا</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وأمدح شهداء إلهنا</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">أشرح سيرة الشهداء الشجعان</h3></td>
    <td class="auto-style1"><h3 align="center">+ بدء نظامى يا أخوان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">عبيد يسوع الرب الديان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">فى قلوب أولاد اسكندرية</h3></td>
    <td class="auto-style1"><h3 align="center">+ تحركت النعمة الإلهية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">فمضوا إلى القسطنطينية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">فطافوا القرى والبلدان</h3></td>
    <td class="auto-style1"><h3 align="center">+ ثبت عزائم الشجعان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">واعترفوا وكرزوا بالإيمان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> معترفين أمام الجموع</h3></td>
    <td class="auto-style1"><h3 align="center">+ جالوا مبشرين باسم يسوع</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وبحثوا على التوبة والرجوع</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  قلب الملك دقلديانوس</h3></td>
    <td class="auto-style1"><h3 align="center">+ حرك الشيطان المنجوس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">فبحث عن عبيد ايسوس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   نحن نؤمن بيسوع المعين</h3></td>
    <td class="auto-style1"><h3 align="center">+ خاطبه القديسين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">    أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وأمامك جهرًا معترفين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">    وأن يكفروا بالرب الديان</h3></td>
    <td class="auto-style1"><h3 align="center">+ دعاهم لعبادة الأوثان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">ووعدهم بعطايا ذهب وألوان</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  لا نعبد إلا الرب المتعال</h3></td>
    <td class="auto-style1"><h3 align="center">+ ذلك الكلام من المحال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">ذهبك وملكك خيال وزوال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">وملأهم من حكمة السماء</h3></td>
    <td class="auto-style1"><h3 align="center">+ رب البرايا قوى الشهداء</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">حتى انتصروا على الأعداء</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  نحن نصارى مسيحيين</h3></td>
    <td class="auto-style1"><h3 align="center">+ زادوا فى الصراخ قائلين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">بيسوع المسيح معترفين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">من فم الشهداء الأبطال</h3></td>
    <td class="auto-style1"><h3 align="center">+ سمع الملك هذه الأقوال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">فأمر بعذابهم فى الحال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> عذاب الشهداء القديسين</h3></td>
    <td class="auto-style1"><h3 align="center">+ شاهدوا جميع الحاضرين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وهم محتملين وصابرين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> امضوا بهم إلى الأسكندرية</h3></td>
    <td class="auto-style1"><h3 align="center">+ صاح الملك بصوته علانية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">لينالوا عذابات قوية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">بأمشاط حديدية مسنونين</h3></td>
    <td class="auto-style1"><h3 align="center">+ ضرب الجنود أجسام القديسين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وهم بسرور محتملين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> فأخذ رأس يوحنا وأباكير</h3></td>
    <td class="auto-style1"><h3 align="center">+ طار عقل الوالى من التفكير</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">فى اليوم السادس من أمشير</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">تسبح وترتل لرب السما</h3></td>
    <td class="auto-style1"><h3 align="center">+ ظهرت ملائكة فى العلا</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وأخذت نفوس الشهداء</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">نظروها جميع الحاضرين</h3></td>
    <td class="auto-style1"><h3 align="center">+ عجائب كثيرة ظهرت بيقين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">فصاحوا نؤمن بإله القديسين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وهنأت الشهداء بالفردوس</h3></td>
    <td class="auto-style1"><h3 align="center">+ غنت طغمات نى أنجيلوس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وهتفت أكسيوس أكسيوس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  ولبسوا أكاليل نورانية</h3></td>
    <td class="auto-style1"><h3 align="center">+ فازوا بالحياة الأبدية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"> <h3 align="center">أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وسكنوا أورشليم السمائية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> نظروا عذاب الشهداء بيقين</h3></td>
    <td class="auto-style1"><h3 align="center">+ قبل الإيمان جميع الذين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">وقالوا نؤمن بإله القديسين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> إن لم ترجعوا عن ذا الضلال</h3></td>
    <td class="auto-style1"><h3 align="center">+ كلمهم الملك المحتال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">    أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">أقطع رؤوسكم كالأبطال </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وقالوا اقطع رؤوسنا فى الحين</h3></td>
    <td class="auto-style1"><h3 align="center">+ لم يطيعوا أمره المؤمنين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أباكير واخيه يوحنا</h3></td>
    <td class="auto-style1"><h3 align="center">لنفوز بما فاز به القديسين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  كل المؤمنين</h3></td>
    <td class="auto-style1"><h3 align="center">+ تفسير اسمكما فى أفواه</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  أباكبر ويوحنا أعنا أجمعين</h3></td>
    <td class="auto-style1"><h3 align="center">الكل يقولون يا إله</h3></td>
  </tr>
</table>
</body>
</html>
