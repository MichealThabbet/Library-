<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارجرجس الروماني-السلام لك يا مار جرجس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3>ذو الاسم العجيب</h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3>السلام لك يا مارجرجس</h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>ذاع ذكرك في الاقاليم
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>أختارك 
        الرب القدوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>الي دقلديانوس
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>تقدمت 
        ايها المختار
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>بعلامة بستفروس
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>واخزيت 
        كل الكفار
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>وعلي جهك النعمة
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>راك 
        قلديانوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>تضئ مثل النجمة
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>جميلًا 
        في شخصك
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>انت من أي مكان
        </p>    
      </h3>
    </div></td>
    <td><div align="center">
      <h3>فقال يا 
        مختار
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>ما رايت مثلك انسان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>انا لي ثلاث اعوام
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>حتي اتيت الان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فما حاجتك عندي
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>انت من أي مكان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>تعالو اغبرني
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>تخبرني يا انسان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>بحق يسوع ربك
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>كان زير او سلطان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>عن بيك وجدك
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>انا ابن اسطاسيوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فقال له جاورجيوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>ايسوس بخرستوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>وانا عبد لربي
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>نسبتنافي فلسطين              
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>كبادوكيا بلادنا
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>منها مقيمين
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فيها مربانا
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>تعال اعبد الاوثان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فقال له دقلديانوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>وانا اكتب لك فرمان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>وبخر يا محروس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>انا نسل الكرام         
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فقال له جاورجيوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>ان اعبد الاوثان            
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>كيف تامرني يا منجوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>عذاب القديس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>فامر دقلديانوس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>وضربوه بالدبابيس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>والاضداد قد عروه
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>يقاسي في الاتعاب
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>سبع سنوات عدة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>في محبة رب الارباب
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>واحتمل كل شدة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>علي اسمه القدوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>ثلاث ميتات قد مات
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>المحيي كل النفوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>وحبًا في رب القوات
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>مضي بالتهليل
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>وفي رابع موتة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>ونال سبعة اكاليل
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>واخذ الشهادة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>من عند الرب القدوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>ظفر بالنعمة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>باشويس ابؤروجاورجيوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>ونال اكليل الشهادة
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>يا قائد كل الفرسان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>السلام لك يا بطل
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>خزي عبد الاوثان
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>يا من اجلك
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>يا بن انسطاسيس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>السلام لك يا قديس
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>يا عبد بخرستوس
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>يا جسدًا نقيًا
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>كل المؤمنين
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>تفسير اسمك في افواه
        </p>    
      </h3>
    </div></td>
  </tr>
  <tr>
    <td> <div align="center">
      <h3>مارجرجس اعنا اجمعين
        </p>    
      </h3>
    </div></td>
    <td> <div align="center">
      <h3>الكل يقولون يا اله
        </p>    
      </h3>
    </div></td>
  </tr>
</table>
