<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>القديس الانبا رويس-السلام للأنبا رويس</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> شفيعنا وقديسنا</span></b></h3>    </td>
    <td width="50%"><h3 align="center"  dir="rtl"><b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG">السلام للانبا رويس</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><font face="Times New Roman"> نهديك السلام وتقديس</font></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center" class="MsoNormal" dir="rtl"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> محبة وروحانية</span></b></h3></td>
    <td><h3 align="center"  dir="rtl"> <b><span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> حبيت ربك بلهيب</span></b></h3>    </td>
  </tr>
  <tr>
    <td><h3 align="center"><span class="MsoNormal"><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> طوباك يا انبا رويس</span></b></span></h3></td>
    <td><h3 align="center" ><b> <span style="font-family: Times New Roman" lang="AR-EG" xml:lang="AR-EG"> كنت لنا مثل عجيب</span></b></h3>    </td>
  </tr>
  <tr>
