  </tr>
  <tr>
    <td><div align="center">      
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> أباء رهبان أطهار </span> </h3>
