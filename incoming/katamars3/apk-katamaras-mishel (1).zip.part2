<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد ماربقطر-السلام لك يا ماربقطر</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700">  <span lang="AR-SA" xml:lang="AR-SA">يا تاج الشهداء</span></span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  السلام لك يا مار بقطر</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عظيمًا في السماء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كالشهد اسمك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> صلتِ للحنونة</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أمك مرثا الأميرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أمام الأيقونة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بدموع غزيرة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> بشرتها بميلادك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أجبتها أم النور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عظيم في جهادك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أسمتك المَنصور  </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> مُنير بالنعمة</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بارع في جمالك </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> مليئًا بالحكمة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وجهك كملاك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> من مرثا القديسة</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  رضت الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> عشقت الكنيسة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أحببت الديان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> و أصوام نقية</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بصلوات نارية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> صرت جنة روحية</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و صلوات بهية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> رفعت للسما عقلك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  منذ حداثتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أسلمت يسوع قلبك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> رفضا العالم</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> الثالث في الإمبراطورية</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في منزلتك الأرضية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> سائح في البرية</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و حياتك البطنية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> مَشهور في كل زمان</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا أشجع الأبطال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> للقديس قزمان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> لم ترض الإذلال</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> القديسة ثيؤدورة</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  كفنت جسد أمك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> جعلتها مستورة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> دفنتها بالإكرام</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> عذبك بمرارة</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أبيك الوزير رومانيوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> وبخته بجسارة</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أسلمك لدقلديانوس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> تجرعت الآلام</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  أمام أربع مجالس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> لا يخاله إنسان</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بعذاب شرس</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> بلجام في فمك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  نفوك إلي الإسكندرية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بسلاسل في عنقك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بهيئة زرية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> وحيدًا في الجبال</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  نفوك لقصر مهجور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فأغتاظ المُحتال</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> حولته لسماء نور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> بمكر و دهاء</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قاتلتك الشياطين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و زلازل و أصداء</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كجيوش و تنانين</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> و صبرك و ودعتك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قهرتهم بالإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و ثباتك و شجاعتك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> احترقوا بصلواتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> زارك يسوع الحبيب</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في هيئه غريبة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و أضافته بالترحيب</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فعانقته بحب</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> من يسألني باسمك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  بنعة وعدك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> استجيب بشفاعتك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بإيمان في كنيستك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> في كل العُصور</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  لا تحصى آياتك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا بطلًا مبرور</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> لا توصف عجايبك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> بسيرتك و عجايبك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  علم أحد القواد</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أمر بتعذيبك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> حاصرك بالقوات</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> و قطعوا لسانك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  قلعوا عيناك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> سلخوا جلدك </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> كسروا يديك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> صرت كطير ذبيح</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  برعونة قطعوا عنقك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> يا مُستحق المَديح</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> فاكملك عبدك</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> نُلت أعظم إكليل</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في 27 برمودة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> بتسبيح و تهليل</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> و الأمجاد المنشودة</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> كرسوا كنيستك</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  في 27 هاتور</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> أعطنا بركتك</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> اذكرنا يا بطل</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span dir="rtl" style="color: white; font-weight: 700"><span lang="AR-SA" xml:lang="AR-SA"> كل المؤمنين</span></span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA">  تفسير اسمك في أفواه</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> ما بقطر أعنا أجمعين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="color: white; font-weight: 700" dir="rtl" lang="AR-SA" xml:lang="AR-SA"> الكل يقولون يا إله</span></h3>
    </div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3><span style="font-weight: 700"> آكسيوس..آكسيوس..آكسيوس</span></h3>
    </div>      <div align="center"></div></td>
  </tr>
  <tr>
    <td colspan="2"><div align="center">
      <h3><span style="font-weight: 700"> بي مارتيروس أفا فيكتور</span></h3>
    </div>      <div align="center"></div></td>
  </tr>
</table>
</body>
</html>
PK`�CP1P␀␀1P␀␀PK␀␀␀�k^]␀␀␀␀␀␀␀␀␀␀␀␀4␀␀␀apk-katamaras-mishel/content/المدائح/r20.html<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
#1 {
	color: #F00;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><div align="center">
      <h1>الشهيد مارمينا العجايبي-كوكب شارق في الصبحية</h1>
    </div></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">وشعاع زاه في البرية </span></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA">كوكب شارق في الصبحية </span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> سيدي الشهيد أبا مينا</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> صاحب عزم ونجده قوية</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> على الكفرة أعداء الدين</span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> بقوة الإله فازت الشجعان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> وفتحوا للوري أبواب النعيم </span></h3>
    </div></td>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> فشيدوا بجهادهم الإيمان</span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><span style="mso-bidi-font-family: &quot;Times New Roman&quot;; font-weight:700" lang="AR-SA" xml:lang="AR-SA"> عن شهيد الله المفضال</span></h3>
    </div></td>
    <td><div align="center">
