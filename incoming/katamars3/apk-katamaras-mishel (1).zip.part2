<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد اسحق الدفراوي</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 dir="rtl" align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">كرامتك يا عظيم</span></strong></h3></td>
    <td width="50%"><h3 align="center" dir="rtl"><strong><span lang="AR-SA" xml:lang="AR-SA"> لنتهلل بتقديم</span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بي اثؤواب أفا إساك</h3></td>
    <td><h3 dir="rtl" align="center"><strong><span lang="AR-SA" xml:lang="AR-SA"> في السماء والنعيم</span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">قوي و شجاع</span></strong></h3></td>
    <td><h3 align="center" dir="rtl"><strong><span lang="AR-SA" xml:lang="AR-SA"> لك سيرة كالشعاع</span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بي اثؤواب أفا إساك<br />
    </h3></td>
    <td><h3 dir="rtl" align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">بصمود في الدفاع</span></strong></h3></td>
  </tr>
  <tr>
    <td><h3 dir="rtl" align="center"><strong><span lang="AR-SA" xml:lang="AR-SA">أمام عباد الأوثان</span></strong></h3></td>
    <td><h3 align="center" dir="rtl"><strong><span lang="AR-SA" xml:lang="AR-SA"> بوضوح في الأيمان </span></strong></h3></td>
  </tr>
