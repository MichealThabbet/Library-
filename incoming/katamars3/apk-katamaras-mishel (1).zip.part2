<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">القديسة السيدة العذراء مريم-أبدي باسم الله العظيم</h1></td>
  </tr>
  <tr>
    <td width="50%"><h3 align="center">الآب والإبن الرحيم</h3></td>
    <td width="50%"><h3 align="center">أبدى باسم الله العظيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ثالوث ولم نعبد سواه</h3></td>
    <td><h3 align="center">وروح قدسه يا فهيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">جوهر واحد بالذات</h3></td>
    <td><h3 align="center">ثالوث مثلث الصفات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عالى ولا عين تراه</h3></td>
    <td><h3 align="center">خالق جميع الكائنات</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">هو مالى الأرض والسماء</h3></td>
    <td><h3 align="center">نشكر الاله دايمًا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الشفيعة فى كل الخطاة</h3></td>
    <td><h3 align="center">نسأل أمه مريم ستنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأشرح القول الصحيح</h3></td>
    <td><h3 align="center">أمجد من له التسابيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الطاهرة أم الحياة</h3></td>
    <td><h3 align="center">فى مديح البتول أم المسيح</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ينبهنى على هذا الكلام</h3></td>
    <td><h3 align="center">لأن فكرى فى كل عام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لكن إذا أراد الإله</h3></td>
    <td><h3 align="center">لابد من قول النظام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من مدحها شيئًا يسير</h3></td>
    <td><h3 align="center">فاشرح لكم أنا الحقير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لا أستطيع أفهم معناه</h3></td>
    <td><h3 align="center">لأن مجدها كثير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عجزوا وما بلغوا المنى</h3></td>
    <td><h3 align="center">لأن كل الألسنة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الطاهرة أم الحياة</h3></td>
    <td><h3 align="center">فى مديح مريم ستنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يوحنا سبق فسر وجد</h3></td>
    <td><h3 align="center">وقد شرح لكم ابن الرعد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كيرلص البطرك ورآه</h3></td>
    <td><h3 align="center">وقد قال على جرو الأسد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فضايل الروح القدس</h3></td>
    <td><h3 align="center">البطريرك لما لبس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى يوم نياحتها وجاه</h3></td>
    <td><h3 align="center">قال هذا الكلام لما جلس</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عيد الصليب ويسجدوا</h3></td>
    <td><h3 align="center">خلق كتير جوا بقصدوا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عيد عظيم لأم الاله</h3></td>
    <td><h3 align="center">فى كل عام ويعيدوا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">جاء يوم نياحتها العجيب</h3></td>
    <td><h3 align="center">فصادف أن عيد الصليب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">رئيسهم راعى الرعاة</h3></td>
    <td><h3 align="center">فاسرعوا نحو الطبيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">سؤالهم قبل أن يقول</h3></td>
    <td><h3 align="center">وتضرعوا له فى قبول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لكى يقرأوا الأوشياء</h3></td>
    <td><h3 align="center">عن نياحة العذراء البتول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أن يجلسوا صفوف صفوف</h3></td>
    <td><h3 align="center">فأمر الجمع الوقوف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من كثر علمه اللى حواه</h3></td>
    <td><h3 align="center">لأنهم جاءوا بخوف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">روح قدسه وأفهمه</h3></td>
    <td><h3 align="center">لما نطق به وأعلمه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كمثل ينبوع الحياة</h3></td>
    <td><h3 align="center">وكان ينطق من فمه </h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>هذا الكلام شرحه يطول</h3>
    </div></td>
    <td><h3 align="center">قال اسمعوا ياأهل العقول</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الطاهرة أم الحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>فى مديح مريم البتول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>منها الإله أتى فى شكلنا</h3>
    </div></td>
    <td><div align="center">
      <h3>هذا الذى شرح لنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">تشبه بالبشر وهو الإله</h3></td>
    <td><h3 align="center">للموت قبل من أجلنا</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأعطوا هدوًا للكلام</h3>
    </div></td>
    <td><div align="center">
      <h3>قال انصتوا لى باهتمام</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">نقل البتول لأرض الحياة</h3></td>
    <td><h3 align="center">واسمعوا لى بالتمام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">هؤلاء قليلى العقول</h3></td>
    <td><h3 align="center">لعل بعض الناس يقول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">تموت وهى أم الإله</h3></td>
    <td><h3 align="center">كيف أن مريم البتول</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كما أصعد الأنبياء</h3></td>
    <td><h3 align="center">ولم لا يعرفها بالحياة</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الذين رفعهما بالحياة</h3></td>
    <td><h3 align="center">كمثل أخنوخ وايليا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كلام لذهنك هو قريب</h3></td>
    <td><h3 align="center">اسمع أقول لك يا حبيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">سهمًا نفذ لم يرجع ورآه</h3></td>
    <td><h3 align="center">فميزه بعقلك تصيب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">على أحد من الديون</h3></td>
    <td><h3 align="center">وهل يورينا أن يكون</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ولا يقاتل أحد من وفاه</h3></td>
    <td><h3 align="center">من العالم المملوء غبون</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مع أبونا آدم لما جهل</h3></td>
    <td><h3 align="center">أما رأيت ابليس وما فعل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">دخل إلى الفردوس معاه</h3></td>
    <td><h3 align="center">وكيف أخطأ بالحيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لما خلق بأمره العظيم</h3></td>
    <td><h3 align="center">أما تسمع أن الله الكريم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وفيه نفخ روح الحياة</h3></td>
    <td><h3 align="center">آدم وأسكنه النعيم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والقاه فى أعلا الرتب</h3></td>
    <td><h3 align="center">وقد جبله كما يجب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بالنور والنعمة كساه</h3></td>
    <td><h3 align="center">وكل الأنعام له وهب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آدم أول البشر</h3></td>
    <td><h3 align="center">وأن الإله لما نظر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فباركه وقد اصطفاه</h3></td>
    <td><h3 align="center">ورآه حسن لكل نظر</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مد الاله يده وأخذ</h3>
    </div></td>
    <td><div align="center">
      <h3>جلب عليه النور رقد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>منه خلق الامرأة</h3>
    </div></td>
    <td><div align="center">
      <h3>ضلعًا من أضلاعه أخد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أن يأكلا ما طاب لهما</h3>
    </div></td>
    <td><div align="center">
      <h3>وأن الاله أوحى لهما</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وقال كلا ما تشتهاه</h3></td>
    <td><h3 align="center">من تلك الأشجار كلهًا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لا تأكلا ولا تصلا لها</h3></td>
    <td><h3 align="center">وذى الحذر من أكلها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتحسبا مع الخطاه</h3></td>
    <td><h3 align="center">موتًا تموتا من أجلها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لما سقط من العلاء</h3></td>
    <td><h3 align="center">غار ابليس وامتلأ</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فوق الرتب وهو رماه</h3></td>
    <td><h3 align="center">ونظر أن آدم قد علا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يدبر إلى آدم حيل</h3></td>
    <td><h3 align="center">فجاء إلى الفردوس دخل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">منها يصير شبه الاله</h3></td>
    <td><h3 align="center">فقال لحوء من أكل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وجاءت لآدم وأطغته</h3></td>
    <td><h3 align="center">وأن حواء أطاعته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من الذى عنها نهاه</h3></td>
    <td><h3 align="center">منها أكلت وأعطته</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من خالق الأرض والسماء</h3></td>
    <td><h3 align="center">فجاءها الصوت بانتباه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وخالفتما قول الاله</h3></td>
    <td><h3 align="center">كيف عصيتما ياخطاه</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">حواء وزاد به البكاء</h3></td>
    <td><h3 align="center">وإن آدم اشتكا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">هذا كله من الامرأة</h3></td>
    <td><h3 align="center">وقال ليس منى أنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مناديًا تحت السحاب</h3></td>
    <td><h3 align="center">رد له صوت مهاب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وسوف تعود له وتراة</h3></td>
    <td><h3 align="center">إنى خلقتك من تراب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لأكثرن أحزانكم</h3></td>
    <td><h3 align="center">إذ لم تسمعوا بآذانكم</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويلبس جسدًا من إمرأه</h3>
    </div></td>
    <td><div align="center">
      <h3>حتى يجى ابنى من أجلكم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من أجلكما على الصليب</h3>
    </div></td>
    <td><div align="center">
      <h3>إذا لم يمت ابنى الحبيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ونسلكما يهلك رجاه</h3>
    </div></td>
    <td><div align="center">
      <h3>فليس تنجوا من اللهيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنه على آدم حكم</h3>
    </div></td>
    <td><div align="center">
      <h3>وبجبرووته قد أقسم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يوفى حكمه من وراه</h3>
    </div></td>
    <td><div align="center">
      <h3>وعده نسله وكم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وطرحه من بين يديه</h3>
    </div></td>
    <td><div align="center">
      <h3>حين حكم بالموت عليه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وشر فعله كان جزاء</h3>
    </div></td>
    <td><div align="center">
      <h3>لما أساء منه اليه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأسلبه من نعمته</h3>
    </div></td>
    <td><div align="center">
      <h3>وأخرجه من جنته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقد أطاع من كان غواه</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنه ترك وصيته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وفى التراب قد اندفن</h3>
    </div></td>
    <td><div align="center">
      <h3>زمات آدم بالحزن</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بحكم عادل قضاه</h3>
    </div></td>
    <td><div align="center">
      <h3>نزل إلى الجحيم سكن</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على نسل آدم أجمعين</h3>
    </div></td>
    <td><div align="center">
      <h3>وجاز ذلك بيقين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فرحان بموت آدم فجاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وكان ابليس اللعين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على نسل آدم الجميع</h3>
    </div></td>
    <td><div align="center">
      <h3>وتسلط الموت الشنيع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يفعل بحكمة ما يشاء</h3>
    </div></td>
    <td><div align="center">
      <h3>وهذا حكم الله السميع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومات وراح الجحيم</h3>
    </div></td>
    <td><div align="center">
      <h3>وطاع ابليس اللعين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقضى الرب الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>إذ كان غلق باب النعيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أشرق من مريم عبدته</h3>
    </div></td>
    <td><div align="center">
      <h3>ولما اشتهى بارادته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وعتقه ممن سباه</h3>
    </div></td>
    <td><div align="center">
      <h3>وخلص جميع جبلته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>رفع ضياءكى إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>طوباكى يا مريم لقد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واشتملتى بنور ضياه</h3>
    </div></td>
    <td><div align="center">
      <h3>والغير مدروك صار جسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والشاروبيم من حواليه</h3>
    </div></td>
    <td><div align="center">
      <h3>ومن على الريح منكبيه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من البتول لأجل الخطاة</h3>
    </div></td>
    <td><div align="center">
      <h3>لبس جسدًا واحتجب فيه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>المذهل لأرباب العقول</h3>
    </div></td>
    <td><div align="center">
      <h3>يا لهذا السر المهول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>جالس على حجر امَرأة</h3>
    </div></td>
    <td><div align="center">
      <h3>دا عجبًا شرحه يطول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهو الرازق إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>يرضع لبن شبه الولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>طعامه حيث يشاء</h3>
    </div></td>
    <td><div align="center">
      <h3>وهو المعطى لكل جسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نعمته يا أهل النظر</h3>
    </div></td>
    <td><div align="center">
      <h3>ومن يعول كل البشر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لأجل خلقة يداه</h3>
    </div></td>
    <td><div align="center">
      <h3>فى بطن عذراء استتر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومن تحت رجليه الضباب</h3>
    </div></td>
    <td><div align="center">
      <h3>الذى من تحته السحاب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حتى كل مؤمن رآه</h3>
    </div></td>
    <td><div align="center">
      <h3>قد صار بطنك له حجاب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قوايم العرش العظيم</h3>
    </div></td>
    <td><div align="center">
      <h3>ركب مريم ابنة يواقيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كأنه جالس فى سماه</h3>
    </div></td>
    <td><div align="center">
      <h3>عليهما الأزلى القديم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>للقيامة والطريق</h3>
    </div></td>
    <td><div align="center">
      <h3>شخص مريم قد يليق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الذى لا عين تراه</h3>
    </div></td>
    <td><div align="center">
      <h3>على سواعدها حقيق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اللى لعرشه يحملوه</h3>
    </div></td>
    <td><div align="center">
      <h3>وأيضًا الأربع وجوه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لئلا يحرقهم نور ضياه</h3>
    </div></td>
    <td><div align="center">
      <h3>لا يستطيعوا ينظروه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى بطنك تسعة شهور</h3>
    </div></td>
    <td><div align="center">
      <h3>وأنت حملتى نار ونور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>محجوب ولا عين تراه</h3>
    </div></td>
    <td><div align="center">
      <h3>مولود من قبل الدهور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والأرض قاسها بالكمال</h3>
    </div></td>
    <td><div align="center">
      <h3>وهو الذى وزن الجبال</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>البحر مع كل المياه</h3>
    </div></td>
    <td><div align="center">
      <h3>بالشبر وبالكيل قد كان</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ربوات ثم صفوف صفوف</h3>
    </div></td>
    <td><div align="center">
      <h3>والملايكة ألوف ألوف</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>منكسين الرؤوس حداه</h3>
    </div></td>
    <td><div align="center">
      <h3>من حول كرسيه هم وقوف</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وجوههم لا ينظروا</h3>
    </div></td>
    <td><div align="center">
      <h3>لهم أجنحة بها يسترون</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>المرهوب تجلى فى علاه</h3>
    </div></td>
    <td><div align="center">
      <h3>كله خوف من منظره</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>قد صار فى أحشا مريما</h3>
    </div></td>
    <td><div align="center">
      <h3>وسع كرسيه السماء</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكل نسله من وراه</h3>
    </div></td>
    <td><div align="center">
      <h3>حين عتق أبانا آدما</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكان آدم فى القصاص</h3>
    </div></td>
    <td><div align="center">
      <h3>لولا البتول ما كان خلاص</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويفرح عدوه اللى غواه</h3>
    </div></td>
    <td><div align="center">
      <h3>لليوم حزين ما له خلاص</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقبل الآلام من أجلنا</h3>
    </div></td>
    <td><div align="center">
      <h3>لولا تجسد ربنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا كان لنا حياة</h3>
    </div></td>
    <td><div align="center">
      <h3>لكنا هلكنا كلنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بأن مريم مثلنا</h3>
    </div></td>
    <td><div align="center">
      <h3>هذا الكلام قد دلنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومن نسل الأنبياء</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنها من قبلنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أم الاله وعبدته</h3>
    </div></td>
    <td><div align="center">
      <h3>مخلوقة من جبلة يداه</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا قدرت على فداه</h3>
    </div></td>
    <td><div align="center">
      <h3>لما جاها الموت ما فرقته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا أهل النظر كمثلها</h3>
    </div></td>
    <td><div align="center">
      <h3>لكن لما حضر الموت لها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهذا الكأس تشرباه</h3>
    </div></td>
    <td><div align="center">
      <h3>كساير البشر أراد لها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأسلمت له نفسها</h3>
    </div></td>
    <td><div align="center">
      <h3>فاحنت لشربه رأسها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لأنها أم الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>ما أمكنه يمسها</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">حنة ويواقيم الحسن المطيع</h3></td>
    <td><h3 align="center">لأنها زرعًا طاهرًا وديع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من أب وأم أتقياء</h3></td>
    <td><h3 align="center">كسائر الناس الجميع</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأعطوا مسامع عقولكم</h3></td>
    <td><h3 align="center">وانصتوا لى كلكم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كما قد كشف لى الإله</h3></td>
    <td><h3 align="center">اسمعوا لأبشر لكم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">قصدى أزور فى سفرتى</h3></td>
    <td><h3 align="center">قد كان منى يا اخوتى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأبكى على قبر الإله</h3></td>
    <td><h3 align="center">القدس وأكتب عبرتى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أم الرسول اللى داعى</h3></td>
    <td><h3 align="center">دخلت بيت مريم ساعى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فتشت فى كتب القراه</h3></td>
    <td><h3 align="center">ومرقس تلميذى معى</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكان قلبى مستكب</h3>
    </div></td>
    <td><div align="center">
      <h3>فتحت صندوق الكتب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>شرحًا عظيمًا مملوء عزاه</h3>
    </div></td>
    <td><div align="center">
      <h3>فوجدت جزءا من عجب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ونياحة العذراء العجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>مكتوب فيه سرًا غريب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأبوه وروح قدسه معاه</h3>
    </div></td>
    <td><div align="center">
      <h3>مجدًا لابنها الحبيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من بين الأموات بالجسد</h3>
    </div></td>
    <td><div align="center">
      <h3>وكان من بعد أن صعد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وارتفع إلى علو سماه</h3>
    </div></td>
    <td><div align="center">
      <h3>الذى كان به اتحد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لعمر مريم ستنا</h3>
    </div></td>
    <td><div align="center">
      <h3>وكان كمال ستين سنة</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حيث أنها فى نور ضياه</h3>
    </div></td>
    <td><div align="center">
      <h3>انتقلت إلى دار الهنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى الأرض وآخر عمرها</h3>
    </div></td>
    <td><div align="center">
      <h3>بعد أن أكملت تدبيرها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بنقلها لدار الحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>سر الذى اختارها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لا تستطيع أن تحيد</h3>
    </div></td>
    <td><div align="center">
      <h3>وكيف أن أم الوحيد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>شديد ولا قدرة على الفداء</h3>
    </div></td>
    <td><div align="center">
      <h3>عن شرب ذا الكأس ال</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فقد أتاها المنتهاه</h3>
    </div></td>
    <td><div align="center">
      <h3>ولما أن كمل وقتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقد بدت هى فى الصلاة</h3>
    </div></td>
    <td><div align="center">
      <h3>مرضت بمرض موتها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>انك دايم فى السماء</h3>
    </div></td>
    <td><div align="center">
      <h3>تقول يا ابنى يسوع كما</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا سامع لمن دعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>اسمع لأمك مريما</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولم يزال حاضر سميع</h3>
    </div></td>
    <td><div align="center">
      <h3>يامن هو أمره مطيع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حبيبك يوحنا كى أراه</h3>
    </div></td>
    <td><div align="center">
      <h3>أسألك تحضر لى سريع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا أعود له إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>قبل أن أفارق هذا الجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقد أدركنى الوفاه</h3>
    </div></td>
    <td><div align="center">
      <h3>لأن حكمك قد نفذ</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>تحضر لى يوحنا صفوتك</h3>
    </div></td>
    <td><div align="center">
      <h3>أنا أسألك برحمتك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من مات ومن فى الحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>مع كل رسلك اخوتك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>تخرج من العالم كما</h3>
    </div></td>
    <td><div align="center">
      <h3>يعزوا أمك قبل ما</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حين خالفك وكان جزاه</h3>
    </div></td>
    <td><div align="center">
      <h3>جلب علينا آدما</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>جلب علينا الموت الطويل</h3>
    </div></td>
    <td><div align="center">
      <h3>خالف وصاياك أنه رزبل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ماتوا الجميع راحوا وراه</h3>
    </div></td>
    <td><div align="center">
      <h3>ولا ينسانا جيلا بعد جيل</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">لحق أمك مثلهم</h3></td>
    <td><div align="center">
      <h3>واللى لحقهم كلهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حقًا من نسل الأنبياه</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنها من نسلهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من توكل عليك قد نجا</h3>
    </div></td>
    <td><div align="center">
      <h3>فلا تخيب لى رجا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يقرع بابك وخاب رجاه</h3>
    </div></td>
    <td><h3 align="center">ما رأيت أحدًا قط جا</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وكل شى لك يعود</h3>
    </div></td>
    <td><div align="center">
      <h3>أنت هو الذى فى الوجود</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنك الأول والمنتهاه</h3>
    </div></td>
    <td><div align="center">
      <h3>يرجع اليك كل الوجود</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والجو منه قد امتلأ</h3>
    </div></td>
    <td><div align="center">
      <h3>يا من نزل من العلا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهو لم يفارق أباه</h3>
    </div></td>
    <td><div align="center">
      <h3>وحملته على يدى أنا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأبوك مع روح عزتك</h3>
    </div></td>
    <td><div align="center">
      <h3>مجدًا لقوة قدرتك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فهما يكون من القضاه</h3></td>
    <td><div align="center">
      <h3>من فم مريم عبدتك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">صلاتها واتكئت</h3></td>
    <td><div align="center">
      <h3>لما البتول قد أكملت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مع صوت يزعق فى العلاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وإذا بسحابة نورت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يدعى يوحنا من بعيد</h3>
    </div></td>
    <td><div align="center">
      <h3>يزعق كما الرعد الشديد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مجيئك اليها بالغداه</h3>
    </div></td>
    <td><div align="center">
      <h3>والدتى اليك تريد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ما دامت أمى بالجسد</h3>
    </div></td>
    <td><div align="center">
      <h3>قم يا يوحنا واجتهد</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">روح لها وكلها شفاه</h3></td>
    <td><div align="center">
      <h3>لأنك سميت لها ولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">كمثل ساير من مضى</h3></td>
    <td><h3 align="center">الآن عمرها انقضى</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كان آدم أول مبتداه</h3></td>
    <td><h3 align="center">لا حيلة فى هذا القضا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">نهض وهو مهموم ذليل</h3></td>
    <td><h3 align="center">وشاهد الحق الجليل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والدمع من عينه رواه</h3></td>
    <td><h3 align="center">وقف بكى وقتًا طويل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وعاد يبكى باحتراق</h3></td>
    <td><h3 align="center">وفاض دمعه بانطلاق</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>تلك البتول أم الأله</h3>
    </div></td>
    <td><h3 align="center">من ذا الذى يطيق افتراق</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا ترى أصل لأعزيها</h3>
    </div></td>
    <td><div align="center">
      <h3>الويل لنا من بعدها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والجميع يبكوا معاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وصار يبكى لفقدها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا فاحص جميع الكلا</h3>
    </div></td>
    <td><div align="center">
      <h3>ويقول يارب العلا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أمك وأراها بالحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>أسألك توصلنى إلى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واختارها لدعوته</h3>
    </div></td>
    <td><div align="center">
      <h3>ويا من نزل برحمته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ورسله مع أنبياه</h3>
    </div></td>
    <td><div align="center">
      <h3>وقد دعانا اخوته</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على السحاب فى الريح وصار</h3>
    </div></td>
    <td><div align="center">
      <h3>وأما الرسول خطف وطار</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقف فوق أبواب البناء</h3>
    </div></td>
    <td><div align="center">
      <h3>حتى نزل بقرب الدار</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بداير البيت أشرقت</h3>
    </div></td>
    <td><div align="center">
      <h3>وإذا بأنوار أحدقت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مثل العنبر فى زكاه</h3>
    </div></td>
    <td><div align="center">
      <h3>ورائحة عطر حدثت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>دخلت إلى عند البتول</h3>
    </div></td>
    <td><div align="center">
      <h3>أنا أتيت قال الرسول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كلام يبكى من قراه</h3>
    </div></td>
    <td><div align="center">
      <h3>وسمعتها وهى تقول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لانك سمعت لى فى الحين</h3>
    </div></td>
    <td><div align="center">
      <h3>أنا اشكرك يا ابنى الحنين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا من يخلص من اتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>ولم تخيب لى يقين</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وبرحمتك ازدتنى</h3>
    </div></td>
    <td><div align="center">
      <h3>بتحننك سمعت لى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يعزى أمك كى تراه</h3>
    </div></td>
    <td><div align="center">
      <h3>وبحضور يوحنا افرحتنى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لا حيلة لى قضاك</h3>
    </div></td>
    <td><div align="center">
      <h3>أن كان موتى هو رضاك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لا موت له لكن حياه</h3>
    </div></td>
    <td><div align="center">
      <h3>طوبى لمن كان فى رضاك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حتى وصلت إلى السرير</h3>
    </div></td>
    <td><div align="center">
      <h3>جعلت اتقدم يسير يسير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كالبرق أقبل فى ضياه</h3>
    </div></td>
    <td><div align="center">
      <h3>فنظرت أنوار كثير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يأتوا اليها ويسجدوا</h3>
    </div></td>
    <td><div align="center">
      <h3>وملائكته لها يهتدوا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والنور كثير فى البيت ملاه</h3>
    </div></td>
    <td><div align="center">
      <h3>قدامها ويصعدوا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهم يقولون فى ندم</h3>
    </div></td>
    <td><div align="center">
      <h3>والكل يبكوا فى ألم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على أمه إلى سماه</h3>
    </div></td>
    <td><div align="center">
      <h3>سبحانه بالموت حكم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وإذ بصوت يصرخ بارتفاع</h3>
    </div></td>
    <td><div align="center">
      <h3>فيما أنا ناصت للسماع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>هذا هو انتقال أم الإله</h3>
    </div></td>
    <td><div align="center">
      <h3>من السماء ملاء البقاع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اليوم وداع أم المسيح</h3>
    </div></td>
    <td><div align="center">
      <h3>فسمعته وهو يسبح</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فى ملكى الدايم بقاه</h3></td>
    <td><h3 align="center">اجى أخدها تستريح</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فراح إلى العذرا البتول</h3>
    </div></td>
    <td><div align="center">
      <h3>الملاك ميخائيل بالدخول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مسكن النور والحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>دخل إلى شمس الحلول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>على السرير وارتاحت</h3>
    </div></td>
    <td><div align="center">
      <h3>ثم بعد أن اهتدت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بدموع تجرى كالمياه</h3>
    </div></td>
    <td><div align="center">
      <h3>لما رأتنى هى بكت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من المزامير بافهام</h3>
    </div></td>
    <td><div align="center">
      <h3>وسمعتها تتلى كلام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>الرب هو موت أتقياه</h3>
    </div></td>
    <td><div align="center">
      <h3>وهى تقول كريم أمام</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>سجدت أنا قدامها</h3>
    </div></td>
    <td><div align="center">
      <h3>وفى تمام كلامها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>باركينى يا أم الإله</h3>
    </div></td>
    <td><div align="center">
      <h3>سجودًا تحت أقدامها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>متضرعًا لقدسها</h3>
    </div></td>
    <td><div align="center">
      <h3>وبديت أقبل رأسها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يباركك ابنى بفاه</h3>
    </div></td>
    <td><div align="center">
      <h3>فجاوبتنى بنفسها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وإذا دعيتى يسمعك</h3>
    </div></td>
    <td><div align="center">
      <h3>ابنك يسوع يكون معاك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويصير أمامك كالمياه</h3>
    </div></td>
    <td><div align="center">
      <h3>فلا يقدر الموت يفزعك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا يثبت بين يديكى</h3>
    </div></td>
    <td><div align="center">
      <h3>ولا سلطان له عليكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويهد عزمه مع قواه</h3>
    </div></td>
    <td><div align="center">
      <h3>لكنه يقبل قدميكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا ابنى يوحنا إذًا</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنه فى صباح غدًا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يكون موتى بالغداه</h3>
    </div></td>
    <td><div align="center">
      <h3>أشرق النور واهتدى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وتتركه إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>والنفس تخرج من الجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>كقول ابنى لك بفاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وأنت يا يوحنا لى ولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>انصبت الظلمة يا حبيب</h3>
    </div></td>
    <td><div align="center">
      <h3>لما رفع على الصليب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حين كنت أنا واياك حداه</h3>
    </div></td>
    <td><div align="center">
      <h3>ما كان من الأمر العجيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مصطفى بتولا وكريم</h3>
    </div></td>
    <td><div align="center">
      <h3>وقال يا أمى هذا عظيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ها أنا أودعتكى إياه</h3>
    </div></td>
    <td><div align="center">
      <h3>وهو وديع ومستقيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والموت إذا جاء لا يعاق</h3>
    </div></td>
    <td><div align="center">
      <h3>واليوم قد حان الفراق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لا يقدر أحد على فداه</h3>
    </div></td>
    <td><div align="center">
      <h3>وكأسه مر المذاق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>من العذاب والافتضاح</h3>
    </div></td>
    <td><div align="center">
      <h3>طوبى لمن عاش فى نياح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولا يخاف من الشقاء</h3>
    </div></td>
    <td><div align="center">
      <h3>هكذا ينال الاقتراح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واحذر تخاف وترتعد</h3>
    </div></td>
    <td><div align="center">
      <h3>يا يوحنا تقوى وكن جلد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى وقت موتى بالغداه</h3>
    </div></td>
    <td><div align="center">
      <h3>لكى تكون لى سند</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أن يأتى صباح الأحد</h3>
    </div></td>
    <td><div align="center">
      <h3>فان المعلم لى وعد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مع كل رسله وأنبياه</h3>
    </div></td>
    <td><div align="center">
      <h3>قبل أن أفارق الجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأنا أتأنس برؤياتهم</h3>
    </div></td>
    <td><div align="center">
      <h3>لكى يعزوا ستهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يرفعوا لها العزاه</h3>
    </div></td>
    <td><div align="center">
      <h3>إذ أتوا مع ربهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>صلى وارفع البخور</h3>
    </div></td>
    <td><div align="center">
      <h3>لكن قوم بلا فتور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا يوحنا قوم للصلاة</h3>
    </div></td>
    <td><div align="center">
      <h3>قبل أن تكون هذه الامور</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يكون لنا سامع مجيب</h3>
    </div></td>
    <td><div align="center">
      <h3>لعل ابنى الحبيب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا يوحنا لكى أراه</h3>
    </div></td>
    <td><div align="center">
      <h3>ويحضر لنا حالا قريب</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يودعوا فيما بينهم</h3>
    </div></td>
    <td><div align="center">
      <h3>لأن اليهود قصدهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويحرقوه ياحصرتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>يأخذوا جسدى بيدهم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>عملوا على صلب الولد</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنهم لأجل الجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">من بغضهم لأم الاله</h3></td>
    <td><h3 align="center">وأنا أخرجونى من البلد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وهو الذى قد اصطفاك</h3></td>
    <td><h3 align="center">فقلت أن الإله رجاك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الموت دا حكم الإله</h3></td>
    <td><h3 align="center">لا يحزنك إذا أتاك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من اليهود إلى الأبد</h3></td>
    <td><h3 align="center">ولا سلطان لأحد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لأنك أم الإله</h3></td>
    <td><h3 align="center">أن يقربوا إلى الجسد</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">كما أمرتنى ستنا</h3></td>
    <td><h3 align="center">وقمت للوقت أنا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">متضرعًا نحو الإله</h3></td>
    <td><h3 align="center">رفعت وجهى للسماء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والنار فى أحشاى تلتهب</h3></td>
    <td><h3 align="center">وأهملت دمعًا منسكب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وسمر عنا يداه</h3></td>
    <td><h3 align="center">وقلت يا من قد صلب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وعد أبوانا آدم</h3></td>
    <td><h3 align="center">وقد طعن فى جنبه كما</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">لأجل آدم اعتقاه</h3></td>
    <td><h3 align="center">حتى نزل دم وماء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">صيد اللعين ابن الهلاك</h3></td>
    <td><h3 align="center">وقد خلصنا من شباك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">واسمع لأمك يا إله</h3></td>
    <td><h3 align="center">أنظر لنا من فوق علاك</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">واستجيب لسؤالها</h3></td>
    <td><h3 align="center">وأظهر عجائبك لها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فأنت صانع ما تشاء</h3></td>
    <td><h3 align="center">وإن شئت انتقالها</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">دائم على طول السنين</h3></td>
    <td><h3 align="center">والمجد لك فى كل حين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">آمين على طول المداه</h3></td>
    <td><h3 align="center">وإلى دهر الداهرين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">بقولى آمين والسلام</h3></td>
    <td><h3 align="center">لما ختمت هذا الكلام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى منتهى ختم الصلاة</h3></td>
    <td><h3 align="center">جلست أبكى باغتمام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من الهموم والافتكار</h3></td>
    <td><h3 align="center">وكنت غارق فى بحار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">حكم على أمه بالوفاه</h3></td>
    <td><h3 align="center">كيف خالق الليل والنهار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وإذا السما أضاء بالنور</h3></td>
    <td><h3 align="center">وحين أكملت البخور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والليل مضى والنور غشاه</h3></td>
    <td><h3 align="center">وارتحت لها كل الستور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى السما وانغلق</h3></td>
    <td><h3 align="center">وكأن باب قد انطرق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">منه خرج صوت الإله</h3></td>
    <td><h3 align="center">وانفتح بلا غلق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">من يسمعه يكاد يعود</h3></td>
    <td><h3 align="center">صوت زعق شبه الرعود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">والميت يقيمه من بلاه</h3></td>
    <td><h3 align="center">وأهل القبور وهم رقود</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وروح القدس نحوى نطق</h3></td>
    <td><h3 align="center">وزاد الصياح وانطلق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأنت لا تعرف نداه</h3></td>
    <td><h3 align="center"><strong>وقال هذا صوت زعق</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>هذا صوت ابن الله قد نزل</strong></h3></td>
    <td><h3 align="center"><strong>ثبت قدمك لا تنزهل</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>من كل أقطار الفلاه</strong></h3></td>
    <td><h3 align="center"><strong>يدعى اخوتك الرسل</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>مع الرؤساء والبطاركة</strong></h3></td>
    <td><h3 align="center"><strong>وتحضر الملائكة</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>فى النساء أم الإله</strong></h3></td>
    <td><h3 align="center"><strong>يعزوا أمك المباركة</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>جميعهم وينصروا</strong></h3></td>
    <td><h3 align="center"><strong>والأنبياء سوف يحضروا</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center"><strong>لشربها كأس الماء</strong></h3></td>
    <td><h3 align="center"><strong>لموتها وينظروا</strong></h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يفوق على كل العطور</h3></td>
    <td><h3 align="center">وإذا برائحة البخور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أضاء كالنهار وكان مساه</h3></td>
    <td><h3 align="center">ووجه البتول أشرق بنور</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وبرق البرق المهاب</h3></td>
    <td><h3 align="center">قامت رعود مع ضباب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">على الرياح كاجنحاء</h3></td>
    <td><h3 align="center">والرسل جاءوا على السحاب</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">قد أمر الريح جابهم</h3></td>
    <td><h3 align="center">باذن المخلص ربهم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">نحو البتول أتوا مشاه</h3></td>
    <td><h3 align="center">فوق السحاب وأنزلهم</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">صفوت الرب الكرام</h3></td>
    <td><h3 align="center">وإذا الرسولان العظام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يجروا كما تجرى السعاه</h3></td>
    <td><h3 align="center">بطرس وبولس جوا قوام</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>باتفاق لوقا البشير</h3>
    </div></td>
    <td><h3 align="center">متى ومرقص أصحاب الانجيل</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يعقوب ابن زبدى جاء معاه</h3></td>
    <td><h3 align="center">حضروا كما البرق المسير</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أنه صادفهم فى الطريق</h3></td>
    <td><h3 align="center">ابن حلفا وفيلبس حقيق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وتداوس جاء من وراه</h3></td>
    <td><h3 align="center">وسمعان الغيور لهم رفيق</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">أتوا مع رفقتهم من زمان</h3></td>
    <td><h3 align="center">برتلماؤس ومتياس الآن</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">انعاق لما يرضى الإله</h3></td>
    <td><h3 align="center">ما عدا توما ما كان</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فوق السحاب على التمام</h3></td>
    <td><h3 align="center">أتوا رسل ربنا الكرام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى القبور حضروا بالحياة</h3></td>
    <td><h3 align="center">وبعضهم كانوا عظام</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">موسى واخنوخ وإيليا</h3></td>
    <td><h3 align="center">وهكذا حضر من الأنبياء</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وزكريا جاء من وراه</h3></td>
    <td><h3 align="center">داود واشعيا وأرميا</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وأيضًا معه دانيال</h3></td>
    <td><h3 align="center">ومن بعدهم جاء حزقيال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">مسكوا السرير وقبلاه</h3></td>
    <td><h3 align="center">نحو البتول أتوا قبال</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">خروا لمريم ساجدين</h3></td>
    <td><h3 align="center">وجميعهم أتوا قاصدين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">عليكى قد تنبئناه</h3></td>
    <td><h3 align="center">وقالوا لها نحن أجمعين</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">فى وسطهم واعترف</h3></td>
    <td><h3 align="center">داود قام منصرف</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">ومزموره قد قراه</h3></td>
    <td><h3 align="center">بنبوته لهم كشف </h3></td>
  </tr>
  <tr>
    <td><h3 align="center">الرب من صهيون ظهر</h3></td>
    <td><h3 align="center">ضرب الأرغن والقيثار</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">يعنى نزوله من سماه</h3></td>
    <td><h3 align="center">ونزل على الصوف كالمطر</h3></td>
  </tr>
  <tr>
    <td><h3 align="center">وانسى شعبك واعلمى</h3></td>
    <td><h3 align="center">يا ابنة اصغى وافهمى</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ولحسنك قد اشتهاه</h3>
    </div></td>
    <td><h3 align="center">أن الملك منكى نمى</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>للحاضرين وهم سكوت</h3>
    </div></td>
    <td><div align="center">
      <h3>وعاد إلى القول بثبوت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أعيش وأربح بالحياه</h3>
    </div></td>
    <td><div align="center">
      <h3>وقال اننى لست أموت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أنا رأيت نار تشتعل</h3>
    </div></td>
    <td><div align="center">
      <h3>موسى كليم الله قد قال</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أحد منكم يفهم معناه</h3>
    </div></td>
    <td><div align="center">
      <h3>فى وسط عليقه فهل</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأغصانها لا تحترق</h3>
    </div></td>
    <td><div align="center">
      <h3>والنار منها لا تفترق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فهى البتول افهم معناه</h3>
    </div></td>
    <td><div align="center">
      <h3>ولا ذبل لها ورق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نطق بما تنبأ وقال</h3>
    </div></td>
    <td><div align="center">
      <h3>وقال بعده حزقيال</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">فى الشرق باب ما أعرف بناه</h3></td>
    <td><h3 align="center">أنا الذى رأيت مثال</h3></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>رب السموات والعلا</h3>
    </div></td>
    <td><div align="center">
      <h3>ولم يدخل أحد ما خلا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ختمه مختوم لا سواه</h3>
    </div></td>
    <td><div align="center">
      <h3>لأنه خرج وهو على</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقال أنا الذى شهد</h3>
    </div></td>
    <td><div align="center">
      <h3>قام أشعياء مجتهد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ابنًا وهذا هو أسماه</h3>
    </div></td>
    <td><div align="center">
      <h3>ها هو ذا العذراء تلد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>والآن تفسيره إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>عمانوئيل يدعى ولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وملاك المشورة دعاه</h3>
    </div></td>
    <td><div align="center">
      <h3>الله معنا ظهر بالجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نبوته على البتول</h3>
    </div></td>
    <td><div align="center">
      <h3>وكل واحد منهم يقول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وبعضهم ذكر إياه</h3>
    </div></td>
    <td><div align="center">
      <h3>بأمثال تسلب العقول</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>هبطوا من فوق السطوح</h3>
    </div></td>
    <td><div align="center">
      <h3>وإذا أبونا آدم ونوح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ومسكوا السرير وقبلاه</h3>
    </div></td>
    <td><div align="center">
      <h3>برائحة عطرة تفوح</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>بك عتقنا من الجحيم</h3>
    </div></td>
    <td><div align="center">
      <h3>آدم صرخ بصوت عظيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لولاك ما نلنا نجاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وعدنا لفردوس النعيم</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>نحو البتول وانحنت</h3>
    </div></td>
    <td><div align="center">
      <h3>وإذا أمنا حوى أتت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى وجهها الوجنتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>سجدت لها وقبلت</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لك السلام من ربكى</h3>
    </div></td>
    <td><div align="center">
      <h3>وهى تصيح يا ابنتى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>تمت وبك نلت الحياه</h3>
    </div></td>
    <td><div align="center">
      <h3>أنت التى بك فرحتى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ويعقوب وملشيصاداق</h3>
    </div></td>
    <td><div align="center">
      <h3>وإذا أبونا ابراهيم واسحق</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>مباركة أنت يا أم الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>جاؤا وسجدوا قائلين طوباك</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>يا من صرت أمًا لمولاكى</h3>
    </div></td>
    <td><div align="center">
      <h3>نعظمك كل الأوقات</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>لم ينفتح باب الحياة</h3>
    </div></td>
    <td><div align="center">
      <h3>بالحقيقة أنه لولاكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى أقل من لمح البصر</h3>
    </div></td>
    <td><div align="center">
      <h3>وأن يواقيم قد حضر</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وأمها جاءت من وراه</h3>
    </div></td>
    <td><div align="center">
      <h3>كما سمعنا فى السير</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>فى حضنه مع أمها</h3>
    </div></td>
    <td><div align="center">
      <h3>وأن أبوها ضمها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وهى تصيح تصيح يا أبنتاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وبدت تقبل فمها</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>علمت أنا انكى</h3>
    </div></td>
    <td><div align="center">
      <h3>لان من يوم ولدتكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>اللى نزل من فوق سماه</h3>
    </div></td>
    <td><div align="center">
      <h3>مباركة عند ابنكى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>واتحد به إلى الأبد</h3>
    </div></td>
    <td><div align="center">
      <h3>وقد لبس منك الجسد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حتى خلص من رجاه</h3>
    </div></td>
    <td><div align="center">
      <h3>وقد صارت الكلمة ولد</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>ما دام صباح مع مسا</h3>
    </div></td>
    <td><div align="center">
      <h3>مباركة أنت فى النسا</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أفوز برحمته يوم اللقاه</h3>
    </div></td>
    <td><div align="center">
      <h3>دعينى أقبلك عسى</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>أتوا جميعهم مسابقون</h3>
    </div></td>
    <td><div align="center">
      <h3>وكل الأنبياء والصديقون</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>حضروا تمجيد أم الاله</h3>
    </div></td>
    <td><div align="center">
      <h3>وكل الطقوس السمائيون</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>وقبلوا الوجه البديع</h3>
    </div></td>
    <td><div align="center">
      <h3>وهكذا حضروا الجميع</h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3>النظر لها من نور ضياه</h3>
    </div></td>
    <td><div align="center">
      <h3>من ذا الذى يستطيع</h3>
    </div></td>
  </tr>
  <tr>
