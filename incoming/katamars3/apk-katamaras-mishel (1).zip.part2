  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وحفظ العبرية </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">أجاد اليهودية </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بغيرة نارية </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ثياب راجمي إستفانوس</span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وحرس هذا المأنوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> شهيد الرب إيسوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أخذ رسائل الطغيان </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وحدث أنه كان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ضد عبيد الديان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من دمشق أبرق </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وعندما إقترب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> حوله نور فسقط </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> شاول يا شاول </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وسمع صوت يقول </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنا ربك المهول </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> أنا ومن يتبعني </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">لماذا تضطهدني </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> فسأله إخبرني </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ياربي وجابلني </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ماذا تريد مني</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قال أذهب إلى إبني </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إلى حنانيا القديس </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ذهب هذا النفيس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> عمده بالتغطيس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وسقط من عينه </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">فملأه روح فاديه </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> قشورا لينقيه </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في الصحراء بثبات </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مضى ثلاث سنوات </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> ينال من البركات </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> يكرز بين الشعوب </span></b></h3>
    </div></td>
    <td><div align="center"> 
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">جال بولس المحبوب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بولس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> بإسم يسوع المصلوب </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> في أصوام  وأسهار </span></b></h3>
    </div></td>
    <td><div align="center"> 
