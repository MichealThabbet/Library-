<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="3"><h1 align="center">الشهيد بطرس الرسول</h1></td>
  </tr>
  <tr>
    <td width="50%"><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">واحد لا رب سواه</span></b></h3>
    </div></td>
    <td width="50%"><div align="center">
      <h3><b><span dir="ltr"> </span><span lang="AR-EG" xml:lang="AR-EG">أبدأ 
        بإسم الإله </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> مار بطرس الرسول </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> وأمدح رسول مولاه</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> من الروح ملآم</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">  </span><span lang="AR-EG" xml:lang="AR-EG">إسمه الأول سمعان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مار بطرس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG"> إسمه على كل لسان </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ونفسه متضعة </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">مولود في بيت</span></b><span lang="AR-EG" xml:lang="AR-EG"><b> صيدا </b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مار بطرس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><span lang="AR-EG" xml:lang="AR-EG"><b>لإلهنا شاهدة </b></span></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">يسوع رب القوات </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وذلك قبل الميلاد </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مار بطرس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">بخمس سنوات </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">والرب قد شغله</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">صيد السمك عمله</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مار بطرس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ترك الصيد وتبعه </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">عن الرب القدوس </span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b> <span lang="AR-EG" xml:lang="AR-EG">أخبره أندراوس </span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">مار بطرس الرسول</span></b></h3>
    </div></td>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">وإصطحبه إلى إيسوس</span></b></h3>
    </div></td>
  </tr>
  <tr>
    <td><div align="center">
      <h3><b><span lang="AR-EG" xml:lang="AR-EG">ليصطاد النفوس </span></b></h3>
    </div></td>
    <td><div align="center">
