<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Untitled Document</title>
<style type="text/css">
.auto-style1 {
	direction: rtl;
}
</style>
</head>

<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="2" class="auto-style1"><h1 align="center">الشهيد أبو فام الجندى</h1>
	<h1 align="center">( السلام لك يا آبا فام )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center"> يا حبيب كل الأنام</h3></td>
    <td width="50%" class="auto-style1"><h3 align="center">+ السلام لك يا ابا فام</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> من الرب الأعظم</h3></td>
    <td class="auto-style1"><h3 align="center">السلام لك يا مكرَّم</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لأنسطاسيوس أبوك</h3></td>
    <td class="auto-style1"><h3 align="center">+ السلام لأوسيم بلدك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لطما دى فيها جسدك</h3></td>
    <td class="auto-style1"><h3 align="center">لسوسنة أمك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  قد نلت إكليل نفيس</h3></td>
    <td class="auto-style1"><h3 align="center">+ السلام لك يا قديس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  له أنت أنيس</h3></td>
    <td class="auto-style1"><h3 align="center">وكل مريض تعيس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  يا قائد كل الشجعان</h3></td>
    <td class="auto-style1"><h3 align="center">+ السلام لك يا أبو حصان  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ذاع صيتك فى كل مكان</h3></td>
    <td class="auto-style1"><h3 align="center">اختارك الرب الديان </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  صلاتك لا تعرف ليل</h3></td>
    <td class="auto-style1"><h3 align="center">+ السلام لك يا جليل</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   يا صديق لميخائيل</h3></td>
    <td class="auto-style1"><h3 align="center">يا حبيب عمانوئيل</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   ركبت حصانك</h3></td>
    <td class="auto-style1"><h3 align="center">+ فى يوم تعذيبك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  لتلاقى حبيبك</h3></td>
    <td class="auto-style1"><h3 align="center">ولبست ثياب عرسك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">    قلت له لا سلام</h3></td>
    <td class="auto-style1"><h3 align="center">+ قال لك الوالى سلام</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  للأشرار لا كلام</h3></td>
    <td class="auto-style1"><h3 align="center">قال الرب الأعظم</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   وأمر بضربك</h3></td>
    <td class="auto-style1"><h3 align="center">+ فاغتاظ الوالى منك  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وابتدأتْ أوجاعك</h3></td>
    <td class="auto-style1"><h3 align="center">ففرحتَ من قلبك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> جرجروك مسرعين</h3></td>
    <td class="auto-style1"><h3 align="center">+ ربطوك فى حصان متين</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">وسلاح قوى عظيم</h3></td>
    <td class="auto-style1"><h3 align="center">كان لك الرب معين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ومعها عبيدك</h3></td>
    <td class="auto-style1"><h3 align="center">+ وبسرعة قامت أمك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   واستشهدوا قدامك</h3></td>
    <td class="auto-style1"><h3 align="center">اعترفوا بإلهك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  للملك الطاغية</h3></td>
    <td class="auto-style1"><h3 align="center">+ جروك لأنطاكية</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> عبادتكم كلها واهية</h3></td>
    <td class="auto-style1"><h3 align="center">صرخت بحجة قوية </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لم نر لك مثال</h3></td>
    <td class="auto-style1"><h3 align="center">+ صاح الملك وقال </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> خضوعك لنا محال</h3></td>
    <td class="auto-style1"><h3 align="center">على مر الأجيال</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وأخرجك القدوس</h3></td>
    <td class="auto-style1"><h3 align="center">+ رموك فى البحر المتعوس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أنقذك الرب ايسوس</h3></td>
    <td class="auto-style1"><h3 align="center">زى ما أنقذ بطرس</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  يا برج عال حصين</h3></td>
    <td class="auto-style1"><h3 align="center">+ وضعوك فى الهنبازين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بصلاتك كل حين</h3></td>
    <td class="auto-style1"><h3 align="center">ياللى هزمت الشيطان  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وحذاء قد ألبسوك</h3></td>
    <td class="auto-style1"><h3 align="center">+ بسلاسل قيدوك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  أن تمشى ليذلوك</h3></td>
    <td class="auto-style1"><h3 align="center">به مسامير وأمروك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> صلبوك زى المسيح</h3></td>
    <td class="auto-style1"><h3 align="center">+ اعترفت بإيمان صريح</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  فى أفواهنا والتسابيح</h3></td>
    <td class="auto-style1"><h3 align="center">لذا يحلو المديح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   يا حبيب ارفع نظرك</h3></td>
    <td class="auto-style1"><h3 align="center">+ ظهر لك ايسوس ونداك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وسجدتَ لمن دعاك</h3></td>
    <td class="auto-style1"><h3 align="center">وفك كل قيودك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> سيصير اسمك مشهور</h3></td>
    <td class="auto-style1"><h3 align="center">+ قال لك يا ابنى المبرور</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  بيعتك بسرور</h3></td>
    <td class="auto-style1"><h3 align="center">والكل يجى يزور</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ستكون قوتى هناك</h3></td>
    <td class="auto-style1"><h3 align="center">+ وفى موضع جسدك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> استجيب له بصلاتك</h3></td>
    <td class="auto-style1"><h3 align="center">وكل من طلبك </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   بأمر الملك</h3></td>
    <td class="auto-style1"><h3 align="center">+ لأخميم ساروا بك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> عند طما يا صديق</h3></td>
    <td class="auto-style1"><h3 align="center">المركب وقفت بك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  وكمان جابوا سحرة</h3></td>
    <td class="auto-style1"><h3 align="center">+ حاولوا بكل قوة</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> فشلت كل محاولة</h3></td>
    <td class="auto-style1"><h3 align="center">ليحركوها خطوة</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  فى طما بلدنا</h3></td>
    <td class="auto-style1"><h3 align="center">+ فقطعوا رأسك هنا </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   نظرتَ لمذلتنا</h3></td>
    <td class="auto-style1"><h3 align="center">نشكرك يا إلهنا</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  زى ما قالك ميخائيل</h3></td>
    <td class="auto-style1"><h3 align="center">+ فذاع صيتك يا جليل</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   للحيران أنت دليل</h3></td>
    <td class="auto-style1"><h3 align="center">هناك التهليل</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لما يطلب المسيح</h3></td>
    <td class="auto-style1"><h3 align="center">+ وكل كئيب جريح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> ويخرج بالتفاريح</h3></td>
    <td class="auto-style1"><h3 align="center">فى كنيستك يستريح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> اذكر بطريركنا</h3></td>
    <td class="auto-style1"><h3 align="center">+ فى صلواتك يا شهيدنا  </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> وسائر ملتنا</h3></td>
    <td class="auto-style1"><h3 align="center">وشركاؤه أساقفتنا</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  هذه السيرة</h3></td>
    <td class="auto-style1"><h3 align="center">+ وكاتب لك</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  اعطهم حسن السيرة</h3></td>
    <td class="auto-style1"><h3 align="center">وكل قاريها</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">   كل المؤمنين</h3></td>
    <td class="auto-style1"><h3 align="center">+ تفسير اسمك فى أفواه</h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center">  أبو فام أعنا أجمعين</h3></td>
    <td class="auto-style1"><h3 align="center">الكل يقولون يا إله</h3></td>
  </tr>
</table>
</body>
</html>
