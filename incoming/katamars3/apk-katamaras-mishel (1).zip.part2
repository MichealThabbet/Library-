    <td><div align="center">
      <h3>وتحليت بالكمال </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وسكنت نواحيها </h3></td>
    <td><div align="center">
      <h3>أحببت البراري </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">أسطع نورك فيها </h3></td>
    <td><div align="center">
      <h3>وأيضًا الرب الباري</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">برجا منفردا</h3></td>
    <td><div align="center">
      <h3>طلبت من أبيك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وتركت العالم أجمع </h3></td>
    <td><div align="center">
      <h3>لتعبدي باريك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">وبني لك قصرا جميل </h3></td>
    <td><div align="center">
      <h3>فأجاب لك طلبك</h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">للتسابيح والتراتيل </h3></td>
    <td><div align="center">
      <h3>حسب سؤال قلبك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">موصوفات بالطهارة </h3></td>
    <td><div align="center">
      <h3>اخترت أربعين عذراء </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">ونطقتن بمهارة</h3></td>
    <td><div align="center">
      <h3>وظفرتن بالنعمة </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">من أفعالكن مخزية </h3></td>
    <td><div align="center">
      <h3>حتى جعلتن جنود </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا بكر ونقية </h3></td>
    <td><div align="center">
      <h3>لما تبعتن المعبود </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">لما تبع الكافر </h3></td>
    <td><div align="center">
      <h3>وأيضًا مرقس أبيك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">ولفظك الباهر </h3></td>
    <td><div align="center">
      <h3>رديته بمعانيك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا من تعاليت </h3></td>
    <td><div align="center">
      <h3>طوباك طوباك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">لأنك قويت</h3></td>
    <td><div align="center">
      <h3>أنيريني بضيائك </h3>
    </div></td>
  </tr>
  <tr>
    <td><h3 align="center">يا من قد انتصرت </h3></td>
