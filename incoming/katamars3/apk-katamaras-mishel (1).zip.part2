  <tr>
    <td><h3 align="center"> <strong><span lang="AR-SA" xml:lang="AR-SA">الشهيد اسطفانوس<br />
    </span></strong></h3></td>
    <td><h3 align="center"> رئيسهم المختار<br />
    </h3></td>
  </tr>
  <tr>
