<body background="file:///android_asset/bg3.png">
<table width="100%" border="0" cellspacing="10" cellpadding="0">
  <tr>
    <td colspan="2" class="auto-style1"><h1 dir="rtl" align="center">الشهيد أباسخيرون القلينى</h1>
	<h1 dir="rtl" align="center">( السلام لقديس عظيم )</h1></td>
  </tr>
  <tr>
    <td width="50%" class="auto-style1"><h3 align="center"> حبيب يسوع المسيح  </h3></td>
    <td width="50%" class="auto-style1"><h3 align="center"> + السلام لقديس عظيم </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> حياته كلها تسبيح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> من أبوين طاهرين </h3></td>
    <td class="auto-style1"><h3 align="center"> + ولد هذا القديس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> فى كفر الشيخ بلقين </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> مع يوليانوس وأرمانيوس </h3></td>
    <td class="auto-style1"><h3 align="center"> + أرسل دقلديانوس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> منشوره الخبيث </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> يتضمن عدة شرور </h3></td>
    <td class="auto-style1"><h3 align="center"> + كان هذا المنشور </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> ضد أبناء النور </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> إلهى الرب يسوع </h3></td>
    <td class="auto-style1"><h3 align="center"> + قال البطل الشجاع </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> سجد أمامه بخشوع </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بمناصب كبيرة  </h3></td>
    <td class="auto-style1"><h3 align="center"> + أغراه دقلديانوس </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> وأموال كثيرة </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> أعلن له الاختيار </h3></td>
    <td class="auto-style1"><h3 align="center"> + دقلديانوس الشرير </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> بنيوت آفا أباسخيرون</h3></td>
    <td class="auto-style1"><h3 align="center"> الموت أو الإيمان بيسوع المسيح </h3></td>
  </tr>
  <tr>
    <td class="auto-style1"><h3 align="center"> لأوامر دقلديانوس</h3></td>
    <td class="auto-style1"><h3 align="center"> + لم ينصت القديس </h3></td>
  </tr>
  <tr>
