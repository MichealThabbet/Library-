.header {
  overflow: hidden;
  padding: 0px;
  background: lightgrey;
  text-align: center;
  font-size: 16px;
  font-family: 'headfont';
  color: crimson;
  height:70px;
  width: 100%;
  margin: 0px;
  position: fixed;
  text-shadow:1px 1px 1px white;
  border-bottom: 1px solid darkgrey;
  top:0;
  }
  
