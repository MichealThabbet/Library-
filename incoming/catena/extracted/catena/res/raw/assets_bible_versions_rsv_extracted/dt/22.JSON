{
    "chapter_num": 22,
    "verses_count": 30,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not see your brother’s ox or his sheep go astray, and withhold your help"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb hide yourself"
                        },
                        {
                            "style": "NONE",
                            "text": " from them; you shall take them back to your brother. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if he is not near you, or if you do not know him, you shall bring it home to your house, and it shall be with you until your brother seeks it; then you shall restore it to him. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And so you shall do with his ass; so you shall do with his garment; so you shall do with any lost thing of your brother’s, which he loses and you find; you may not withhold your help. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not see your brother’s ass or his ox fallen down by the way, and withhold your help"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb hide yourself"
                        },
                        {
                            "style": "NONE",
                            "text": " from them; you shall help him to lift them up again."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A woman shall not wear anything that pertains to a man, nor shall a man put on a woman’s garment; for whoever does these things is an abomination to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you chance to come upon a bird’s nest, in any tree or on the ground, with young ones or eggs and the mother sitting upon the young or upon the eggs, you shall not take the mother with the young; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall let the mother go, but the young you may take to yourself; that it may go well with you, and that you may live long."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When you build a new house, you shall make a parapet for your roof, that you may not bring the guilt of blood upon your house, if any one fall from it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not sow your vineyard with two kinds of seed, lest the whole yield be forfeited to the sanctuary,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb become holy"
                        },
                        {
                            "style": "NONE",
                            "text": " the crop which you have sown and the yield of the vineyard. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not plow with an ox and an ass together. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not wear a mingled stuff, wool and linen together."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make yourself tassels on the four corners of your cloak with which you cover yourself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Laws concerning Sexual Relations"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If any man takes a wife, and goes in to her, and then spurns her, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and charges her with shameful conduct, and brings an evil name upon her, saying, ‘I took this woman, and when I came near her, I did not find in her the tokens of virginity,’ "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the father of the young woman and her mother shall take and bring out the tokens of her virginity to the elders of the city in the gate; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the father of the young woman shall say to the elders, ‘I gave my daughter to this man to wife, and he spurns her; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and lo, he has made shameful charges against her, saying, “I did not find in your daughter the tokens of virginity.” And yet these are the tokens of my daughter’s virginity.’ And they shall spread the garment before the elders of the city. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the elders of that city shall take the man and whip him; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they shall fine him a hundred shekels of silver, and give them to the father of the young woman, because he has brought an evil name upon a virgin of Israel; and she shall be his wife; he may not put her away all his days. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the thing is true, that the tokens of virginity were not found in the young woman, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then they shall bring out the young woman to the door of her father’s house, and the men of her city shall stone her to death with stones, because she has wrought folly in Israel by playing the harlot in her father’s house; so you shall purge the evil from the midst of you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man is found lying with the wife of another man, both of them shall die, the man who lay with the woman, and the woman; so you shall purge the evil from Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If there is a betrothed virgin, and a man meets her in the city and lies with her, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall bring them both out to the gate of that city, and you shall stone them to death with stones, the young woman because she did not cry for help though she was in the city, and the man because he violated his neighbor’s wife; so you shall purge the evil from the midst of you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if in the open country a man meets a young woman who is betrothed, and the man seizes her and lies with her, then only the man who lay with her shall die. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But to the young woman you shall do nothing; in the young woman there is no offense punishable by death, for this case is like that of a man attacking and murdering his neighbor; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because he came upon her in the open country, and though the betrothed young woman cried for help there was no one to rescue her."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man meets a virgin who is not betrothed, and seizes her and lies with her, and they are found, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the man who lay with her shall give to the father of the young woman fifty shekels of silver, and she shall be his wife, because he has violated her; he may not put her away all his days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 23.1 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": " “A man shall not take his father’s wife, nor shall he uncover her who is his father’s."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb uncover his father’s skirt"
                        }
                    ]
                }
            ]
        }
    ]
}