{
    "chapter_num": 19,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Ceremony of the Red Heifer"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses and to Aaron, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This is the statute of the law which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has commanded: Tell the people of Israel to bring you a red heifer without defect, in which there is no blemish, and upon which a yoke has never come. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall give her to Elea′zar the priest, and she shall be taken outside the camp and slaughtered before him; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Elea′zar the priest shall take some of her blood with his finger, and sprinkle some of her blood toward the front of the tent of meeting seven times. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the heifer shall be burned in his sight; her skin, her flesh, and her blood, with her dung, shall be burned; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the priest shall take cedarwood and hyssop and scarlet stuff, and cast them into the midst of the burning of the heifer. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall wash his clothes and bathe his body in water, and afterwards he shall come into the camp; and the priest shall be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who burns the heifer shall wash his clothes in water and bathe his body in water, and shall be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And a man who is clean shall gather up the ashes of the heifer, and deposit them outside the camp in a clean place; and they shall be kept for the congregation of the people of Israel for the water for impurity, for the removal of sin. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he who gathers the ashes of the heifer shall wash his clothes, and be unclean until evening. And this shall be to the people of Israel, and to the stranger who sojourns among them, a perpetual statute."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“He who touches the dead body of any person shall be unclean seven days; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he shall cleanse himself with the water on the third day and on the seventh day, and so be clean; but if he does not cleanse himself on the third day and on the seventh day, he will not become clean. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever touches a dead person, the body of any man who has died, and does not cleanse himself, defiles the tabernacle of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and that person shall be cut off from Israel; because the water for impurity was not thrown upon him, he shall be unclean; his uncleanness is still on him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This is the law when a man dies in a tent: every one who comes into the tent, and every one who is in the tent, shall be unclean seven days. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And every open vessel, which has no cover fastened upon it, is unclean. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever in the open field touches one who is slain with a sword, or a dead body, or a bone of a man, or a grave, shall be unclean seven days. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the unclean they shall take some ashes of the burnt sin offering, and running water shall be added in a vessel; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then a clean person shall take hyssop, and dip it in the water, and sprinkle it upon the tent, and upon all the furnishings, and upon the persons who were there, and upon him who touched the bone, or the slain, or the dead, or the grave; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the clean person shall sprinkle upon the unclean on the third day and on the seventh day; thus on the seventh day he shall cleanse him, and he shall wash his clothes and bathe himself in water, and at evening he shall be clean."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But the man who is unclean and does not cleanse himself, that person shall be cut off from the midst of the assembly, since he has defiled the sanctuary of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; because the water for impurity has not been thrown upon him, he is unclean. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be a perpetual statute for them. He who sprinkles the water for impurity shall wash his clothes; and he who touches the water for impurity shall be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whatever the unclean person touches shall be unclean; and any one who touches it shall be unclean until evening.”"
                        }
                    ]
                }
            ]
        }
    ]
}