{
    "chapter_num": 18,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Responsibility of Priests and Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Aaron, “You and your sons and your fathers’ house with you shall bear iniquity in connection with the sanctuary; and you and your sons with you shall bear iniquity in connection with your priesthood. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And with you bring your brethren also, the tribe of Levi, the tribe of your father, that they may join you, and minister to you while you and your sons with you are before the tent of the testimony. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall attend you and attend to all duties of the tent; but shall not come near to the vessels of the sanctuary or to the altar, lest they, and you, die. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall join you, and attend to the tent of meeting, for all the service of the tent; and no one else shall come near you. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall attend to the duties of the sanctuary and the duties of the altar, that there be wrath no more upon the people of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, I have taken your brethren the Levites from among the people of Israel; they are a gift to you, given to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to do the service of the tent of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you and your sons with you shall attend to your priesthood for all that concerns the altar and that is within the veil; and you shall serve. I give your priesthood as a gift,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb service of gift"
                        },
                        {
                            "style": "NONE",
                            "text": " and any one else who comes near shall be put to death.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Priests’ Portion"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Aaron, “And behold, I have given you whatever is kept of the offerings made to me, all the consecrated things of the people of Israel; I have given them to you as a portion, and to your sons as a perpetual due. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This shall be yours of the most holy things, reserved from the fire; every offering of theirs, every cereal offering of theirs and every sin offering of theirs and every guilt offering of theirs, which they render to me, shall be most holy to you and to your sons. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In a most holy place shall you eat of it; every male may eat of it; it is holy to you. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This also is yours, the offering of their gift, all the wave offerings of the people of Israel; I have given them to you, and to your sons and daughters with you, as a perpetual due; every one who is clean in your house may eat of it. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the best of the oil, and all the best of the wine and of the grain, the first fruits of what they give to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", I give to you. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The first ripe fruits of all that is in their land, which they bring to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", shall be yours; every one who is clean in your house may eat of it. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every devoted thing in Israel shall be yours. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Everything that opens the womb of all flesh, whether man or beast, which they offer to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", shall be yours; nevertheless the first-born of man you shall redeem, and the firstling of unclean beasts you shall redeem. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their redemption price (at a month old you shall redeem them) you shall fix at five shekels in silver, according to the shekel of the sanctuary, which is twenty gerahs. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the firstling of a cow, or the firstling of a sheep, or the firstling of a goat, you shall not redeem; they are holy. You shall sprinkle their blood upon the altar, and shall burn their fat as an offering by fire, a pleasing odor to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but their flesh shall be yours, as the breast that is waved and as the right thigh are yours. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the holy offerings which the people of Israel present to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " I give to you, and to your sons and daughters with you, as a perpetual due; it is a covenant of salt for ever before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " for you and for your offspring with you.” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Aaron, “You shall have no inheritance in their land, neither shall you have any portion among them; I am your portion and your inheritance among the people of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“To the Levites I have given every tithe in Israel for an inheritance, in return for their service which they serve, their service in the tent of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And henceforth the people of Israel shall not come near the tent of meeting, lest they bear sin and die. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the Levites shall do the service of the tent of meeting, and they shall bear their iniquity; it shall be a perpetual statute throughout your generations; and among the people of Israel they shall have no inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the tithe of the people of Israel, which they present as an offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", I have given to the Levites for an inheritance; therefore I have said of them that they shall have no inheritance among the people of Israel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Moreover you shall say to the Levites, ‘When you take from the people of Israel the tithe which I have given you from them for your inheritance, then you shall present an offering from it to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", a tithe of the tithe. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And your offering shall be reckoned to you as though it were the grain of the threshing floor, and as the fulness of the wine press. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So shall you also present an offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " from all your tithes, which you receive from the people of Israel; and from it you shall give the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s offering to Aaron the priest. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Out of all the gifts to you, you shall present every offering due to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", from all the best of them, giving the hallowed part from them.’ "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you shall say to them, ‘When you have offered from it the best of it, then the rest shall be reckoned to the Levites as produce of the threshing floor, and as produce of the wine press; "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you may eat it in any place, you and your households; for it is your reward in return for your service in the tent of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall bear no sin by reason of it, when you have offered the best of it. And you shall not profane the holy things of the people of Israel, lest you die.’”"
                        }
                    ]
                }
            ]
        }
    ]
}