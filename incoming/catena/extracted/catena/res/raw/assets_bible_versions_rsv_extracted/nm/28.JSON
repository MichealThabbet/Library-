{
    "chapter_num": 28,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Daily Offerings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Command the people of Israel, and say to them, ‘My offering, my food for my offerings by fire, my pleasing odor, you shall take heed to offer to me in its due season.’ "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall say to them, This is the offering by fire which you shall offer to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": two male lambs a year old without blemish, day by day, as a continual offering. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The one lamb you shall offer in the morning, and the other lamb you shall offer in the evening; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also a tenth of an ephah of fine flour for a cereal offering, mixed with a fourth of a hin of beaten oil. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It is a continual burnt offering, which was ordained at Mount Sinai for a pleasing odor, an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Its drink offering shall be a fourth of a hin for each lamb; in the holy place you shall pour out a drink offering of strong drink to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The other lamb you shall offer in the evening; like the cereal offering of the morning, and like its drink offering, you shall offer it as an offering by fire, a pleasing odor to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sabbath Offerings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the sabbath day two male lambs a year old without blemish, and two tenths of an ephah of fine flour for a cereal offering, mixed with oil, and its drink offering: "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "this is the burnt offering of every sabbath, besides the continual burnt offering and its drink offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Monthly Offerings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“At the beginnings of your months you shall offer a burnt offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": two young bulls, one ram, seven male lambs a year old without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also three tenths of an ephah of fine flour for a cereal offering, mixed with oil, for each bull; and two tenths of fine flour for a cereal offering, mixed with oil, for the one ram; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and a tenth of fine flour mixed with oil as a cereal offering for every lamb; for a burnt offering of pleasing odor, an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their drink offerings shall be half a hin of wine for a bull, a third of a hin for a ram, and a fourth of a hin for a lamb; this is the burnt offering of each month throughout the months of the year. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also one male goat for a sin offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; it shall be offered besides the continual burnt offering and its drink offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Offerings at Passover"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the fourteenth day of the first month is the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s passover. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the fifteenth day of this month is a feast; seven days shall unleavened bread be eaten. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the first day there shall be a holy convocation: you shall do no laborious work, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but offer an offering by fire, a burnt offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": two young bulls, one ram, and seven male lambs a year old; see that they are without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also their cereal offering of fine flour mixed with oil; three tenths of an ephah shall you offer for a bull, and two tenths for a ram; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a tenth shall you offer for each of the seven lambs; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also one male goat for a sin offering, to make atonement for you. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall offer these besides the burnt offering of the morning, which is for a continual burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the same way you shall offer daily, for seven days, the food of an offering by fire, a pleasing odor to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; it shall be offered besides the continual burnt offering and its drink offering. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the seventh day you shall have a holy convocation; you shall do no laborious work."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Offerings at the Festival of Weeks"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the day of the first fruits, when you offer a cereal offering of new grain to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " at your feast of weeks, you shall have a holy convocation; you shall do no laborious work, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but offer a burnt offering, a pleasing odor to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": two young bulls, one ram, seven male lambs a year old; "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also their cereal offering of fine flour mixed with oil, three tenths of an ephah for each bull, two tenths for one ram, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a tenth for each of the seven lambs; "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with one male goat, to make atonement for you. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Besides the continual burnt offering and its cereal offering, you shall offer them and their drink offering. See that they are without blemish."
                        }
                    ]
                }
            ]
        }
    ]
}