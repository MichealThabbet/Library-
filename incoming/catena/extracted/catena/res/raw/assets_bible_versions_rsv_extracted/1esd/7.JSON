{
    "chapter_num": 7,
    "verses_count": 15,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Temple Is Dedicated"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Sisinnes the governor of Coelesyria and Phoenic′ia, and Sathrabuzanes, and their associates, following the orders of King Darius, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "supervised the holy work with very great care, assisting the elders of the Jews and the chief officers of the temple. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the holy work prospered, while the prophets Haggai and Zechari′ah prophesied; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they completed it by the command of the Lord God of Israel. So with the consent of Cyrus and Darius and Artaxerxes, kings of the Persians, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the holy house was finished by the twenty-third day of the month of Adar, in the sixth year of King Darius. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the people of Israel, the priests, the Levites, and the rest of those from the captivity who joined them, did according to what was written in the book of Moses. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They offered at the dedication of the temple of the Lord one hundred bulls, two hundred rams, four hundred lambs, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and twelve he-goats for the sin of all Israel, according to the number of the twelve leaders of the tribes of Israel; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the priests and the Levites stood arrayed in their garments, according to kindred, for the services of the Lord God of Israel in accordance with the book of Moses; and the gatekeepers were at each gate."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Passover"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The people of Israel who came from the captivity kept the passover on the fourteenth day of the first month, after the priests and the Levites were purified together. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Not all of the returned captives were purified, but the Levites were all purified together,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Greek text of this verse is uncertain"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they sacrificed the passover lamb for all the returned captives and for their brethren the priests and for themselves. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the people of Israel who came from the captivity ate it, all those who had separated themselves from the abominations of the peoples of the land and sought the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they kept the feast of unleavened bread seven days, rejoicing before the Lord, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because he had changed the will of the king of the Assyrians concerning them, to strengthen their hands for the service of the Lord God of Israel."
                        }
                    ]
                }
            ]
        }
    ]
}