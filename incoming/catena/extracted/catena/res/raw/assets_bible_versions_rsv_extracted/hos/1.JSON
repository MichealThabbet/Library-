{
    "chapter_num": 1,
    "verses_count": 11,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " that came to Hose′a the son of Be-e′ri, in the days of Uzzi′ah, Jotham, Ahaz, and Hezeki′ah, kings of Judah, and in the days of Jerobo′am the son of Jo′ash, king of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Hosea"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " first spoke through Hose′a, the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Hose′a, “Go, take to yourself a wife of harlotry and have children of harlotry, for the land commits great harlotry by forsaking the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So he went and took Gomer the daughter of Dibla′im, and she conceived and bore him a son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to him, “Call his name Jezreel; for yet a little while, and I will punish the house of Jehu for the blood of Jezreel, and I will put an end to the kingdom of the house of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on that day, I will break the bow of Israel in the valley of Jezreel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "She conceived again and bore a daughter. And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to him, “Call her name Not pitied, for I will no more have pity on the house of Israel, to forgive them at all. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I will have pity on the house of Judah, and I will deliver them by the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God; I will not deliver them by bow, nor by sword, nor by war, nor by horses, nor by horsemen.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When she had weaned Not pitied, she conceived and bore a son. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said, “Call his name Not my people, for you are not my people and I am not your God.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb I am not yours"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Restoration of Israel"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 2.1 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": " Yet the number of the people of Israel shall be like the sand of the sea, which can be neither measured nor numbered; and in the place where it was said to them, “You are not my people,” it shall be said to them, “Sons of the living God.” "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the people of Judah and the people of Israel shall be gathered together, and they shall appoint for themselves one head; and they shall go up from the land, for great shall be the day of Jezreel."
                        }
                    ]
                }
            ]
        }
    ]
}