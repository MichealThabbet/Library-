{
    "chapter_num": 5,
    "verses_count": 48,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Beatitudes"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Seeing the crowds, he went up on the mountain, and when he sat down his disciples came to him. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he opened his mouth and taught them, saying:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are the poor in spirit, for theirs is the kingdom of heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are those who mourn, for they shall be comforted."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are the meek, for they shall inherit the earth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are those who hunger and thirst for righteousness, for they shall be satisfied."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are the merciful, for they shall obtain mercy."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are the pure in heart, for they shall see God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are the peacemakers, for they shall be called sons of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are those who are persecuted for righteousness’ sake, for theirs is the kingdom of heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Blessed are you when men revile you and persecute you and utter all kinds of evil against you falsely on my account. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Rejoice and be glad, for your reward is great in heaven, for so men persecuted the prophets who were before you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Salt and Light"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You are the salt of the earth; but if salt has lost its taste, how shall its saltness be restored? It is no longer good for anything except to be thrown out and trodden under foot by men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You are the light of the world. A city set on a hill cannot be hid. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nor do men light a lamp and put it under a bushel, but on a stand, and it gives light to all in the house. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let your light so shine before men, that they may see your good works and give glory to your Father who is in heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law and the Prophets"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Think not that I have come to abolish the law and the prophets; I have come not to abolish them but to fulfil them. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For truly, I say to you, till heaven and earth pass away, not an iota, not a dot, will pass from the law until all is accomplished. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever then relaxes one of the least of these commandments and teaches men so, shall be called least in the kingdom of heaven; but he who does them and teaches them shall be called great in the kingdom of heaven. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I tell you, unless your righteousness exceeds that of the scribes and Pharisees, you will never enter the kingdom of heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concerning Anger"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You have heard that it was said to the men of old, ‘You shall not kill; and whoever kills shall be liable to judgment.’ "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you that every one who is angry with his brother"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities insert without cause"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be liable to judgment; whoever insults"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek says Raca to (an obscure term of abuse)"
                        },
                        {
                            "style": "NONE",
                            "text": " his brother shall be liable to the council, and whoever says, ‘You fool!’ shall be liable to the hell"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek Gehenna"
                        },
                        {
                            "style": "NONE",
                            "text": " of fire. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So if you are offering your gift at the altar, and there remember that your brother has something against you, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "leave your gift there before the altar and go; first be reconciled to your brother, and then come and offer your gift. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Make friends quickly with your accuser, while you are going with him to court, lest your accuser hand you over to the judge, and the judge to the guard, and you be put in prison; "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "truly, I say to you, you will never get out till you have paid the last penny."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concerning Adultery"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You have heard that it was said, ‘You shall not commit adultery.’ "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you that every one who looks at a woman lustfully has already committed adultery with her in his heart. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If your right eye causes you to sin, pluck it out and throw it away; it is better that you lose one of your members than that your whole body be thrown into hell."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek Gehenna"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if your right hand causes you to sin, cut it off and throw it away; it is better that you lose one of your members than that your whole body go into hell."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek Gehenna"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concerning Divorce"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“It was also said, ‘Whoever divorces his wife, let him give her a certificate of divorce.’ "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you that every one who divorces his wife, except on the ground of unchastity, makes her an adulteress; and whoever marries a divorced woman commits adultery."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concerning Oaths"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Again you have heard that it was said to the men of old, ‘You shall not swear falsely, but shall perform to the Lord what you have sworn.’ "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you, Do not swear at all, either by heaven, for it is the throne of God, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or by the earth, for it is his footstool, or by Jerusalem, for it is the city of the great King. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And do not swear by your head, for you cannot make one hair white or black. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let what you say be simply ‘Yes’ or ‘No’; anything more than this comes from evil."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or the evil one"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concerning Retaliation"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You have heard that it was said, ‘An eye for an eye and a tooth for a tooth.’ "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you, Do not resist one who is evil. But if any one strikes you on the right cheek, turn to him the other also; "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and if any one would sue you and take your coat, let him have your cloak as well; "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and if any one forces you to go one mile, go with him two miles. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Give to him who begs from you, and do not refuse him who would borrow from you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Love for Enemies"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You have heard that it was said, ‘You shall love your neighbor and hate your enemy.’ "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I say to you, Love your enemies and pray for those who persecute you, "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that you may be sons of your Father who is in heaven; for he makes his sun rise on the evil and on the good, and sends rain on the just and on the unjust. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For if you love those who love you, what reward have you? Do not even the tax collectors do the same? "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if you salute only your brethren, what more are you doing than others? Do not even the Gentiles do the same? "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You, therefore, must be perfect, as your heavenly Father is perfect."
                        }
                    ]
                }
            ]
        }
    ]
}