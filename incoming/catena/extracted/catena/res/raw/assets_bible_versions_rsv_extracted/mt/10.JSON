{
    "chapter_num": 10,
    "verses_count": 42,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Twelve Apostles"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he called to him his twelve disciples and gave them authority over unclean spirits, to cast them out, and to heal every disease and every infirmity. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The names of the twelve apostles are these: first, Simon, who is called Peter, and Andrew his brother; James the son of Zeb′edee, and John his brother; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Philip and Bartholomew; Thomas and Matthew the tax collector; James the son of Alphaeus, and Thaddaeus;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read Lebbaeus or Lebbaeus called Thaddaeus"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Simon the Cananaean, and Judas Iscariot, who betrayed him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Mission of the Twelve"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These twelve Jesus sent out, charging them, “Go nowhere among the Gentiles, and enter no town of the Samaritans, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but go rather to the lost sheep of the house of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And preach as you go, saying, ‘The kingdom of heaven is at hand.’ "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Heal the sick, raise the dead, cleanse lepers, cast out demons. You received without paying, give without pay. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Take no gold, nor silver, nor copper in your belts, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "no bag for your journey, nor two tunics, nor sandals, nor a staff; for the laborer deserves his food. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whatever town or village you enter, find out who is worthy in it, and stay with him until you depart. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As you enter the house, salute it. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if the house is worthy, let your peace come upon it; but if it is not worthy, let your peace return to you. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if any one will not receive you or listen to your words, shake off the dust from your feet as you leave that house or town. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Truly, I say to you, it shall be more tolerable on the day of judgment for the land of Sodom and Gomor′rah than for that town."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Coming Persecutions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Behold, I send you out as sheep in the midst of wolves; so be wise as serpents and innocent as doves. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beware of men; for they will deliver you up to councils, and flog you in their synagogues, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you will be dragged before governors and kings for my sake, to bear testimony before them and the Gentiles. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they deliver you up, do not be anxious how you are to speak or what you are to say; for what you are to say will be given to you in that hour; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for it is not you who speak, but the Spirit of your Father speaking through you. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Brother will deliver up brother to death, and the father his child, and children will rise against parents and have them put to death; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you will be hated by all for my name’s sake. But he who endures to the end will be saved. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they persecute you in one town, flee to the next; for truly, I say to you, you will not have gone through all the towns of Israel, before the Son of man comes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A disciple is not above his teacher, nor a servant"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or slave"
                        },
                        {
                            "style": "NONE",
                            "text": " above his master; "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "it is enough for the disciple to be like his teacher, and the servant"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or slave"
                        },
                        {
                            "style": "NONE",
                            "text": " like his master. If they have called the master of the house Be-el′zebul, how much more will they malign those of his household."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Whom to Fear"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“So have no fear of them; for nothing is covered that will not be revealed, or hidden that will not be known. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What I tell you in the dark, utter in the light; and what you hear whispered, proclaim upon the housetops. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And do not fear those who kill the body but cannot kill the soul; rather fear him who can destroy both soul and body in hell."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek Gehenna"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Are not two sparrows sold for a penny? And not one of them will fall to the ground without your Father’s will. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But even the hairs of your head are all numbered. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Fear not, therefore; you are of more value than many sparrows. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So every one who acknowledges me before men, I also will acknowledge before my Father who is in heaven; "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but whoever denies me before men, I also will deny before my Father who is in heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Not Peace, but a Sword"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Do not think that I have come to bring peace on earth; I have not come to bring peace, but a sword. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I have come to set a man against his father, and a daughter against her mother, and a daughter-in-law against her mother-in-law; "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and a man’s foes will be those of his own household. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who loves father or mother more than me is not worthy of me; and he who loves son or daughter more than me is not worthy of me; "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he who does not take his cross and follow me is not worthy of me. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who finds his life will lose it, and he who loses his life for my sake will find it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Rewards"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“He who receives you receives me, and he who receives me receives him who sent me. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who receives a prophet because he is a prophet shall receive a prophet’s reward, and he who receives a righteous man because he is a righteous man shall receive a righteous man’s reward. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever gives to one of these little ones even a cup of cold water because he is a disciple, truly, I say to you, he shall not lose his reward.”"
                        }
                    ]
                }
            ]
        }
    ]
}