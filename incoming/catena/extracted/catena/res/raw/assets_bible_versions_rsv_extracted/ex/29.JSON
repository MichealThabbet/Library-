{
    "chapter_num": 29,
    "verses_count": 46,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Ordination of the Priests"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now this is what you shall do to them to consecrate them, that they may serve me as priests. Take one young bull and two rams without blemish, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and unleavened bread, unleavened cakes mixed with oil, and unleavened wafers spread with oil. You shall make them of fine wheat flour. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put them in one basket and bring them in the basket, and bring the bull and the two rams. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall bring Aaron and his sons to the door of the tent of meeting, and wash them with water. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take the garments, and put on Aaron the coat and the robe of the ephod, and the ephod, and the breastpiece, and gird him with the skilfully woven band of the ephod; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall set the turban on his head, and put the holy crown upon the turban. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take the anointing oil, and pour it on his head and anoint him. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall bring his sons, and put coats on them, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall gird them with girdles"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb girdles, Aaron and his sons"
                        },
                        {
                            "style": "NONE",
                            "text": " and bind caps on them; and the priesthood shall be theirs by a perpetual statute. Thus you shall ordain Aaron and his sons."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then you shall bring the bull before the tent of meeting. Aaron and his sons shall lay their hands upon the head of the bull, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall kill the bull before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", at the door of the tent of meeting, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and shall take part of the blood of the bull and put it upon the horns of the altar with your finger, and the rest of"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb all"
                        },
                        {
                            "style": "NONE",
                            "text": " the blood you shall pour out at the base of the altar. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take all the fat that covers the entrails, and the appendage of the liver, and the two kidneys with the fat that is on them, and burn them upon the altar. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the flesh of the bull, and its skin, and its dung, you shall burn with fire outside the camp; it is a sin offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then you shall take one of the rams, and Aaron and his sons shall lay their hands upon the head of the ram, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall slaughter the ram, and shall take its blood and throw it against the altar round about. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall cut the ram into pieces, and wash its entrails and its legs, and put them with its pieces and its head, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and burn the whole ram upon the altar; it is a burnt offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; it is a pleasing odor, an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall take the other ram; and Aaron and his sons shall lay their hands upon the head of the ram, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall kill the ram, and take part of its blood and put it upon the tip of the right ear of Aaron and upon the tips of the right ears of his sons, and upon the thumbs of their right hands, and upon the great toes of their right feet, and throw the rest of the blood against the altar round about. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall take part of the blood that is on the altar, and of the anointing oil, and sprinkle it upon Aaron and his garments, and upon his sons and his sons’ garments with him; and he and his garments shall be holy, and his sons and his sons’ garments with him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also take the fat of the ram, and the fat tail, and the fat that covers the entrails, and the appendage of the liver, and the two kidneys with the fat that is on them, and the right thigh (for it is a ram of ordination), "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and one loaf of bread, and one cake of bread with oil, and one wafer, out of the basket of unleavened bread that is before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall put all these in the hands of Aaron and in the hands of his sons, and wave them for a wave offering before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall take them from their hands, and burn them on the altar in addition to the burnt offering, as a pleasing odor before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; it is an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall take the breast of the ram of Aaron’s ordination and wave if for a wave offering before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and it shall be your portion. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall consecrate the breast of the wave offering, and the thigh of the priests’ portion, which is waved, and which is offered from the ram of ordination, since it is for Aaron and for his sons. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be for Aaron and his sons as a perpetual due from the people of Israel, for it is the priests’ portion to be offered by the people of Israel from their peace offerings; it is their offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The holy garments of Aaron shall be for his sons after him, to be anointed in them and ordained in them. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son who is priest in his place shall wear them seven days, when he comes into the tent of meeting to minister in the holy place."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall take the ram of ordination, and boil its flesh in a holy place; "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Aaron and his sons shall eat the flesh of the ram and the bread that is in the basket, at the door of the tent of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall eat those things with which atonement was made, to ordain and consecrate them, but an outsider shall not eat of them, because they are holy. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if any of the flesh for the ordination, or of the bread, remain until the morning, then you shall burn the remainder with fire; it shall not be eaten, because it is holy."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus you shall do to Aaron and to his sons, according to all that I have commanded you; through seven days shall you ordain them, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and every day you shall offer a bull as a sin offering for atonement. Also you shall offer a sin offering for the altar, when you make atonement for it, and shall anoint it, to consecrate it. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Seven days you shall make atonement for the altar, and consecrate it, and the altar shall be most holy; whatever touches the altar shall become holy."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Daily Offerings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now this is what you shall offer upon the altar: two lambs a year old day by day continually. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "One lamb you shall offer in the morning, and the other lamb you shall offer in the evening; "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and with the first lamb a tenth measure of fine flour mingled with a fourth of a hin of beaten oil, and a fourth of a hin of wine for a libation. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the other lamb you shall offer in the evening, and shall offer with it a cereal offering and its libation, as in the morning, for a pleasing odor, an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be a continual burnt offering throughout your generations at the door of the tent of meeting before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", where I will meet with you, to speak there to you. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There I will meet with the people of Israel, and it shall be sanctified by my glory; "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will consecrate the tent of meeting and the altar; Aaron also and his sons I will consecrate, to serve me as priests. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will dwell among the people of Israel, and will be their God. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they shall know that I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God, who brought them forth out of the land of Egypt that I might dwell among them; I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God."
                        }
                    ]
                }
            ]
        }
    ]
}