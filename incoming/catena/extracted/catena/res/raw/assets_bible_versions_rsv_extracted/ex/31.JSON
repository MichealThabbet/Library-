{
    "chapter_num": 31,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Bezalel and Oholiab"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“See, I have called by name Bez′alel the son of Uri, son of Hur, of the tribe of Judah: "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and I have filled him with the Spirit of God, with ability and intelligence, with knowledge and all craftsmanship, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to devise artistic designs, to work in gold, silver, and bronze, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in cutting stones for setting, and in carving wood, for work in every craft. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, I have appointed with him Oho′liab, the son of Ahis′amach, of the tribe of Dan; and I have given to all able men ability, that they may make all that I have commanded you: "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the tent of meeting, and the ark of the testimony, and the mercy seat that is thereon, and all the furnishings of the tent, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the table and its utensils, and the pure lampstand with all its utensils, and the altar of incense, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the altar of burnt offering with all its utensils, and the laver and its base, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the finely worked garments, the holy garments for Aaron the priest and the garments of his sons, for their service as priest, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the anointing oil and the fragrant incense for the holy place. According to all that I have commanded you they shall do.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Sabbath Law"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Say to the people of Israel, ‘You shall keep my sabbaths, for this is a sign between me and you throughout your generations, that you may know that I, the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", sanctify you. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep the sabbath, because it is holy for you; every one who profanes it shall be put to death; whoever does any work on it, that soul shall be cut off from among his people. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Six days shall work be done, but the seventh day is a sabbath of solemn rest, holy to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; whoever does any work on the sabbath day shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore the people of Israel shall keep the sabbath, observing the sabbath throughout their generations, as a perpetual covenant. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It is a sign for ever between me and the people of Israel that in six days the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made heaven and earth, and on the seventh day he rested, and was refreshed.’”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Two Tablets of the Covenant"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he gave to Moses, when he had made an end of speaking with him upon Mount Sinai, the two tables of the testimony, tables of stone, written with the finger of God."
                        }
                    ]
                }
            ]
        }
    ]
}