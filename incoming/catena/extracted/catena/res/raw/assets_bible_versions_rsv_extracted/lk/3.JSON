{
    "chapter_num": 3,
    "verses_count": 38,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Proclamation of John the Baptist"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the fifteenth year of the reign of Tibe′ri-us Caesar, Pontius Pilate being governor of Judea, and Herod being tetrarch of Galilee, and his brother Philip tetrarch of the region of Iturae′a and Trachoni′tis, and Lysa′ni-as tetrarch of Abile′ne, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in the high-priesthood of Annas and Ca′iaphas, the word of God came to John the son of Zechari′ah in the wilderness; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he went into all the region about the Jordan, preaching a baptism of repentance for the forgiveness of sins. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As it is written in the book of the words of Isaiah the prophet,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“The voice of one crying in the wilderness:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Prepare the way of the Lord,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "make his paths straight."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every valley shall be filled,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and every mountain and hill shall be brought low,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and the crooked shall be made straight,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and the rough ways shall be made smooth;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and all flesh shall see the salvation of God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said therefore to the multitudes that came out to be baptized by him, “You brood of vipers! Who warned you to flee from the wrath to come? "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bear fruits that befit repentance, and do not begin to say to yourselves, ‘We have Abraham as our father’; for I tell you, God is able from these stones to raise up children to Abraham. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Even now the axe is laid to the root of the trees; every tree therefore that does not bear good fruit is cut down and thrown into the fire.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the multitudes asked him, “What then shall we do?” "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he answered them, “He who has two coats, let him share with him who has none; and he who has food, let him do likewise.” "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Tax collectors also came to be baptized, and said to him, “Teacher, what shall we do?” "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “Collect no more than is appointed you.” "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Soldiers also asked him, “And we, what shall we do?” And he said to them, “Rob no one by violence or by false accusation, and be content with your wages.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As the people were in expectation, and all men questioned in their hearts concerning John, whether perhaps he were the Christ, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John answered them all, “I baptize you with water; but he who is mightier than I is coming, the thong of whose sandals I am not worthy to untie; he will baptize you with the Holy Spirit and with fire. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His winnowing fork is in his hand, to clear his threshing floor, and to gather the wheat into his granary, but the chaff he will burn with unquenchable fire.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So, with many other exhortations, he preached good news to the people. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Herod the tetrarch, who had been reproved by him for Hero′di-as, his brother’s wife, and for all the evil things that Herod had done, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "added this to them all, that he shut up John in prison."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Baptism of Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when all the people were baptized, and when Jesus also had been baptized and was praying, the heaven was opened, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Holy Spirit descended upon him in bodily form, as a dove, and a voice came from heaven, “Thou art my beloved Son;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or my Son, my (or the) Beloved"
                        },
                        {
                            "style": "NONE",
                            "text": " with thee I am well pleased.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read today I have begotten thee"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ancestors of Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus, when he began his ministry, was about thirty years of age, being the son (as was supposed) of Joseph, the son of Heli, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Matthat, the son of Levi, the son of Melchi, the son of Jan′na-i, the son of Joseph, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Mattathi′as, the son of Amos, the son of Nahum, the son of Esli, the son of Nag′ga-i, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Ma′ath, the son of Mattathi′as, the son of Sem′e-in, the son of Josech, the son of Joda, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Jo-an′an, the son of Rhesa, the son of Zerub′babel, the son of She-al′ti-el,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek Salathiel"
                        },
                        {
                            "style": "NONE",
                            "text": " the son of Neri, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Melchi, the son of Addi, the son of Cosam, the son of Elma′dam, the son of Er, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Joshua, the son of Elie′zer, the son of Jorim, the son of Matthat, the son of Levi, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Simeon, the son of Judah, the son of Joseph, the son of Jonam, the son of Eli′akim, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Me′le-a, the son of Menna, the son of Mat′tatha, the son of Nathan, the son of David, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Jesse, the son of Obed, the son of Bo′az, the son of Sala, the son of Nahshon, "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Ammin′adab, the son of Admin, the son of Arni, the son of Hezron, the son of Perez, the son of Judah, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Jacob, the son of Isaac, the son of Abraham, the son of Terah, the son of Nahor, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Serug, the son of Re′u, the son of Peleg, the son of Eber, the son of Shelah, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Ca-i′nan, the son of Arphax′ad, the son of Shem, the son of Noah, the son of Lamech, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Methu′selah, the son of Enoch, the son of Jared, the son of Maha′lale-el, the son of Ca-i′nan, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Enos, the son of Seth, the son of Adam, the son of God."
                        }
                    ]
                }
            ]
        }
    ]
}