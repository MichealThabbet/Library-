{
    "chapter_num": 4,
    "verses_count": 44,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Temptation of Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus, full of the Holy Spirit, returned from the Jordan, and was led by the Spirit "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for forty days in the wilderness, tempted by the devil. And he ate nothing in those days; and when they were ended, he was hungry. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The devil said to him, “If you are the Son of God, command this stone to become bread.” "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus answered him, “It is written, ‘Man shall not live by bread alone.’” "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the devil took him up, and showed him all the kingdoms of the world in a moment of time, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said to him, “To you I will give all this authority and their glory; for it has been delivered to me, and I give it to whom I will. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you, then, will worship me, it shall all be yours.” "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus answered him, “It is written,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "‘You shall worship the Lord your God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and him only shall you serve.’”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he took him to Jerusalem, and set him on the pinnacle of the temple, and said to him, “If you are the Son of God, throw yourself down from here; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for it is written,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "‘He will give his angels charge of you, to guard you,’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "‘On their hands they will bear you up,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "lest you strike your foot against a stone.’”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus answered him, “It is said, ‘You shall not tempt the Lord your God.’” "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when the devil had ended every temptation, he departed from him until an opportune time."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Beginning of the Galilean Ministry"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus returned in the power of the Spirit into Galilee, and a report concerning him went out through all the surrounding country. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he taught in their synagogues, being glorified by all."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Rejection of Jesus at Nazareth"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he came to Nazareth, where he had been brought up; and he went to the synagogue, as his custom was, on the sabbath day. And he stood up to read; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and there was given to him the book of the prophet Isaiah. He opened the book and found the place where it was written,"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The Spirit of the Lord is upon me,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "because he has anointed me to preach good news to the poor."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He has sent me to proclaim release to the captives"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and recovering of sight to the blind,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "to set at liberty those who are oppressed,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to proclaim the acceptable year of the Lord.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he closed the book, and gave it back to the attendant, and sat down; and the eyes of all in the synagogue were fixed on him. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he began to say to them, “Today this scripture has been fulfilled in your hearing.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all spoke well of him, and wondered at the gracious words which proceeded out of his mouth; and they said, “Is not this Joseph’s son?” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “Doubtless you will quote to me this proverb, ‘Physician, heal yourself; what we have heard you did at Caper′na-um, do here also in your own country.’” "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said, “Truly, I say to you, no prophet is acceptable in his own country. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But in truth, I tell you, there were many widows in Israel in the days of Eli′jah, when the heaven was shut up three years and six months, when there came a great famine over all the land; "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Eli′jah was sent to none of them but only to Zar′ephath, in the land of Sidon, to a woman who was a widow. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there were many lepers in Israel in the time of the prophet Eli′sha; and none of them was cleansed, but only Na′aman the Syrian.” "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they heard this, all in the synagogue were filled with wrath. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they rose up and put him out of the city, and led him to the brow of the hill on which their city was built, that they might throw him down headlong. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But passing through the midst of them he went away."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Man with an Unclean Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he went down to Caper′na-um, a city of Galilee. And he was teaching them on the sabbath; "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they were astonished at his teaching, for his word was with authority. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in the synagogue there was a man who had the spirit of an unclean demon; and he cried out with a loud voice, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Ah!"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Let us alone"
                        },
                        {
                            "style": "NONE",
                            "text": " What have you to do with us, Jesus of Nazareth? Have you come to destroy us? I know who you are, the Holy One of God.” "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus rebuked him, saying, “Be silent, and come out of him!” And when the demon had thrown him down in the midst, he came out of him, having done him no harm. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were all amazed and said to one another, “What is this word? For with authority and power he commands the unclean spirits, and they come out.” "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And reports of him went out into every place in the surrounding region."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Healings at Simon’s House"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he arose and left the synagogue, and entered Simon’s house. Now Simon’s mother-in-law was ill with a high fever, and they besought him for her. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he stood over her and rebuked the fever, and it left her; and immediately she rose and served them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when the sun was setting, all those who had any that were sick with various diseases brought them to him; and he laid his hands on every one of them and healed them. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And demons also came out of many, crying, “You are the Son of God!” But he rebuked them, and would not allow them to speak, because they knew that he was the Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Preaches in the Synagogues"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when it was day he departed and went into a lonely place. And the people sought him and came to him, and would have kept him from leaving them; "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but he said to them, “I must preach the good news of the kingdom of God to the other cities also; for I was sent for this purpose.” "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he was preaching in the synagogues of Judea."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read Galilee"
                        }
                    ]
                }
            ]
        }
    ]
}