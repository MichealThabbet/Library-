{
    "chapter_num": 16,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“I have said all this to you to keep you from falling away. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They will put you out of the synagogues; indeed, the hour is coming when whoever kills you will think he is offering service to God. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they will do this because they have not known the Father, nor me. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I have said these things to you, that when their hour comes you may remember that I told you of them."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“I did not say these things to you from the beginning, because I was with you. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Work of the Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now I am going to him who sent me; yet none of you asks me, ‘Where are you going?’ "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But because I have said these things to you, sorrow has filled your hearts. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless I tell you the truth: it is to your advantage that I go away, for if I do not go away, the Counselor will not come to you; but if I go, I will send him to you. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when he comes, he will convince"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or convict"
                        },
                        {
                            "style": "NONE",
                            "text": " the world concerning sin and righteousness and judgment: "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "concerning sin, because they do not believe in me; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "concerning righteousness, because I go to the Father, and you will see me no more; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "concerning judgment, because the ruler of this world is judged."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“I have yet many things to say to you, but you cannot bear them now. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the Spirit of truth comes, he will guide you into all the truth; for he will not speak on his own authority, but whatever he hears he will speak, and he will declare to you the things that are to come. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He will glorify me, for he will take what is mine and declare it to you. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All that the Father has is mine; therefore I said that he will take what is mine and declare it to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sorrow Will Turn into Joy"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A little while, and you will see me no more; again a little while, and you will see me.” "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Some of his disciples said to one another, “What is this that he says to us, ‘A little while, and you will not see me, and again a little while, and you will see me’; and, ‘because I go to the Father’?” "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said, “What does he mean by ‘a little while’? We do not know what he means.” "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus knew that they wanted to ask him; so he said to them, “Is this what you are asking yourselves, what I meant by saying, ‘A little while, and you will not see me, and again a little while, and you will see me’? "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Truly, truly, I say to you, you will weep and lament, but the world will rejoice; you will be sorrowful, but your sorrow will turn into joy. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When a woman is in travail she has sorrow, because her hour has come; but when she is delivered of the child, she no longer remembers the anguish, for joy that a child"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek a human being"
                        },
                        {
                            "style": "NONE",
                            "text": " is born into the world. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So you have sorrow now, but I will see you again and your hearts will rejoice, and no one will take your joy from you. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In that day you will ask nothing of me. Truly, truly, I say to you, if you ask anything of the Father, he will give it to you in my name. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hitherto you have asked nothing in my name; ask, and you will receive, that your joy may be full."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Peace for the Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“I have said this to you in figures; the hour is coming when I shall no longer speak to you in figures but tell you plainly of the Father. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In that day you will ask in my name; and I do not say to you that I shall pray the Father for you; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for the Father himself loves you, because you have loved me and have believed that I came from the Father. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I came from the Father and have come into the world; again, I am leaving the world and going to the Father.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His disciples said, “Ah, now you are speaking plainly, not in any figure! "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now we know that you know all things, and need none to question you; by this we believe that you came from God.” "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered them, “Do you now believe? "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hour is coming, indeed it has come, when you will be scattered, every man to his home, and will leave me alone; yet I am not alone, for the Father is with me. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have said this to you, that in me you may have peace. In the world you have tribulation; but be of good cheer, I have overcome the world.”"
                        }
                    ]
                }
            ]
        }
    ]
}