{
    "chapter_num": 48,
    "verses_count": 35,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Tribal Portions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“These are the names of the tribes: Beginning at the northern border, from the sea by way"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Compare 47.15: Heb by the side of the way"
                        },
                        {
                            "style": "NONE",
                            "text": " of Hethlon to the entrance of Hamath, as far as Hazar-e′non (which is on the northern border of Damascus over against Hamath), and"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Cn: Heb and they shall be his"
                        },
                        {
                            "style": "NONE",
                            "text": " extending from the east side to the west,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Compare Verses 2–8: Heb the east side the west"
                        },
                        {
                            "style": "NONE",
                            "text": " Dan, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Dan, from the east side to the west, Asher, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Asher, from the east side to the west, Naph′tali, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Naph′tali, from the east side to the west, Manas′seh, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Manas′seh, from the east side to the west, E′phraim, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of E′phraim, from the east side to the west, Reuben, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Reuben, from the east side to the west, Judah, one portion."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Adjoining the territory of Judah, from the east side to the west, shall be the portion which you shall set apart, twenty-five thousand cubits in breadth, and in length equal to one of the tribal portions, from the east side to the west, with the sanctuary in the midst of it. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The portion which you shall set apart for the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be twenty-five thousand cubits in length, and twenty"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Compare 45.1: Heb ten"
                        },
                        {
                            "style": "NONE",
                            "text": " thousand in breadth. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These shall be the allotments of the holy portion: the priests shall have an allotment measuring twenty-five thousand cubits on the northern side, ten thousand cubits in breadth on the western side, ten thousand in breadth on the eastern side, and twenty-five thousand in length on the southern side, with the sanctuary of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " in the midst of it. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This shall be for the consecrated priests, the sons"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "One Ms Gk: Heb of the sons"
                        },
                        {
                            "style": "NONE",
                            "text": " of Zadok, who kept my charge, who did not go astray when the people of Israel went astray, as the Levites did. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall belong to them as a special portion from the holy portion of the land, a most holy place, adjoining the territory of the Levites. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And alongside the territory of the priests, the Levites shall have an allotment twenty-five thousand cubits in length and ten thousand in breadth. The whole length shall be twenty-five thousand cubits and the breadth twenty"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb ten"
                        },
                        {
                            "style": "NONE",
                            "text": " thousand. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall not sell or exchange any of it; they shall not alienate this choice portion of the land, for it is holy to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The remainder, five thousand cubits in breadth and twenty-five thousand in length, shall be for ordinary use for the city, for dwellings and for open country. In the midst of it shall be the city; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and these shall be its dimensions: the north side four thousand five hundred cubits, the south side four thousand five hundred, the east side four thousand five hundred, and the west side four thousand five hundred. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the city shall have open land: on the north two hundred and fifty cubits, on the south two hundred and fifty, on the east two hundred and fifty, and on the west two hundred and fifty. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The remainder of the length alongside the holy portion shall be ten thousand cubits to the east, and ten thousand to the west, and it shall be alongside the holy portion. Its produce shall be food for the workers of the city. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the workers of the city, from all the tribes of Israel, shall till it. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The whole portion which you shall set apart shall be twenty-five thousand cubits square, that is, the holy portion together with the property of the city."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“What remains on both sides of the holy portion and of the property of the city shall belong to the prince. Extending from the twenty-five thousand cubits of the holy portion to the east border, and westward from the twenty-five thousand cubits to the west border, parallel to the tribal portions, it shall belong to the prince. The holy portion with the sanctuary of the temple in its midst, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the property of the Levites and the property of the city,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Cn: Heb and from the property of the Levites and from the property of the city"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be in the midst of that which belongs to the prince. The portion of the prince shall lie between the territory of Judah and the territory of Benjamin."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“As for the rest of the tribes: from the east side to the west, Benjamin, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Benjamin, from the east side to the west, Simeon, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Simeon, from the east side to the west, Is′sachar, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Is′sachar, from the east side to the west, Zeb′ulun, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adjoining the territory of Zeb′ulun, from the east side to the west, Gad, one portion. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And adjoining the territory of Gad to the south, the boundary shall run from Tamar to the waters of Meribath-ka′desh, thence along the Brook of Egypt to the Great Sea. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is the land which you shall allot as an inheritance among the tribes of Israel, and these are their several portions, says the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“These shall be the exits of the city: On the north side, which is to be four thousand five hundred cubits by measure, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "three gates, the gate of Reuben, the gate of Judah, and the gate of Levi, the gates of the city being named after the tribes of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the east side, which is to be four thousand five hundred cubits, three gates, the gate of Joseph, the gate of Benjamin, and the gate of Dan. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the south side, which is to be four thousand five hundred cubits by measure, three gates, the gate of Simeon, the gate of Is′sachar, and the gate of Zeb′ulun. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the west side, which is to be four thousand five hundred cubits, three gates,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "One Ms Gk Syr: Heb their gates three"
                        },
                        {
                            "style": "NONE",
                            "text": " the gate of Gad, the gate of Asher, and the gate of Naph′tali. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The circumference of the city shall be eighteen thousand cubits. And the name of the city henceforth shall be, The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " is there.”"
                        }
                    ]
                }
            ]
        }
    ]
}