{
    "chapter_num": 4,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Masters, treat your slaves justly and fairly, knowing that you also have a Master in heaven."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Further Instructions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Continue steadfastly in prayer, being watchful in it with thanksgiving; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and pray for us also, that God may open to us a door for the word, to declare the mystery of Christ, on account of which I am in prison, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that I may make it clear, as I ought to speak."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Conduct yourselves wisely toward outsiders, making the most of the time. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let your speech always be gracious, seasoned with salt, so that you may know how you ought to answer every one."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Final Greetings and Benediction"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Tych′icus will tell you all about my affairs; he is a beloved brother and faithful minister and fellow servant in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have sent him to you for this very purpose, that you may know how we are and that he may encourage your hearts, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and with him Ones′imus, the faithful and beloved brother, who is one of yourselves. They will tell you of everything that has taken place here."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Aristar′chus my fellow prisoner greets you, and Mark the cousin of Barnabas (concerning whom you have received instructions—if he comes to you, receive him), "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Jesus who is called Justus. These are the only men of the circumcision among my fellow workers for the kingdom of God, and they have been a comfort to me. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ep′aphras, who is one of yourselves, a servant"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or slave"
                        },
                        {
                            "style": "NONE",
                            "text": " of Christ Jesus, greets you, always remembering you earnestly in his prayers, that you may stand mature and fully assured in all the will of God. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I bear him witness that he has worked hard for you and for those in La-odice′a and in Hi-erap′olis. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Luke the beloved physician and Demas greet you. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Give my greetings to the brethren at La-odice′a, and to Nympha and the church in her house. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when this letter has been read among you, have it read also in the church of the La-odice′ans; and see that you read also the letter from La-odice′a. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And say to Archip′pus, “See that you fulfil the ministry which you have received in the Lord.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I, Paul, write this greeting with my own hand. Remember my fetters. Grace be with you."
                        }
                    ]
                }
            ]
        }
    ]
}