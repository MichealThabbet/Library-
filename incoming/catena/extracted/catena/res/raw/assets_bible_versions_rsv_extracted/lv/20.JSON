{
    "chapter_num": 20,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Penalties for Violations of Holiness"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Say to the people of Israel, Any man of the people of Israel, or of the strangers that sojourn in Israel, who gives any of his children to Molech shall be put to death; the people of the land shall stone him with stones. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I myself will set my face against that man, and will cut him off from among his people, because he has given one of his children to Molech, defiling my sanctuary and profaning my holy name. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if the people of the land do at all hide their eyes from that man, when he gives one of his children to Molech, and do not put him to death, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I will set my face against that man and against his family, and will cut them off from among their people, him and all who follow him in playing the harlot after Molech."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a person turns to mediums and wizards, playing the harlot after them, I will set my face against that person, and will cut him off from among his people. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Consecrate yourselves therefore, and be holy; for I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Keep my statutes, and do them; I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " who sanctify you. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For every one who curses his father or his mother shall be put to death; he has cursed his father or his mother, his blood is upon him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man commits adultery with the wife of"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb repeats if a man commits adultery with the wife of"
                        },
                        {
                            "style": "NONE",
                            "text": " his neighbor, both the adulterer and the adulteress shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The man who lies with his father’s wife has uncovered his father’s nakedness; both of them shall be put to death, their blood is upon them. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with his daughter-in-law, both of them shall be put to death; they have committed incest, their blood is upon them. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with a male as with a woman, both of them have committed an abomination; they shall be put to death, their blood is upon them. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man takes a wife and her mother also, it is wickedness; they shall be burned with fire, both he and they, that there may be no wickedness among you. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with a beast, he shall be put to death; and you shall kill the beast. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a woman approaches any beast and lies with it, you shall kill the woman and the beast; they shall be put to death, their blood is upon them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man takes his sister, a daughter of his father or a daughter of his mother, and sees her nakedness, and she sees his nakedness, it is a shameful thing, and they shall be cut off in the sight of the children of their people; he has uncovered his sister’s nakedness, he shall bear his iniquity. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with a woman having her sickness, and uncovers her nakedness, he has made naked her fountain, and she has uncovered the fountain of her blood; both of them shall be cut off from among their people. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not uncover the nakedness of your mother’s sister or of your father’s sister, for that is to make naked one’s near kin; they shall bear their iniquity. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with his uncle’s wife, he has uncovered his uncle’s nakedness; they shall bear their sin, they shall die childless. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man takes his brother’s wife, it is impurity; he has uncovered his brother’s nakedness, they shall be childless."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall therefore keep all my statutes and all my ordinances, and do them; that the land where I am bringing you to dwell may not vomit you out. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall not walk in the customs of the nation which I am casting out before you; for they did all these things, and therefore I abhorred them. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I have said to you, ‘You shall inherit their land, and I will give it to you to possess, a land flowing with milk and honey.’ I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, who have separated you from the peoples. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall therefore make a distinction between the clean beast and the unclean, and between the unclean bird and the clean; you shall not make yourselves abominable by beast or by bird or by anything with which the ground teems, which I have set apart for you to hold unclean. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall be holy to me; for I the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " am holy, and have separated you from the peoples, that you should be mine."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A man or a woman who is a medium or a wizard shall be put to death; they shall be stoned with stones, their blood shall be upon them.”"
                        }
                    ]
                }
            ]
        }
    ]
}