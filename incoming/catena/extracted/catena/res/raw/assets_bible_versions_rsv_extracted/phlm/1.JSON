{
    "chapter_num": 1,
    "verses_count": 25,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Salutation"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, a prisoner for Christ Jesus, and Timothy our brother,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To Phile′mon our beloved fellow worker "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Ap′phia our sister and Archip′pus our fellow soldier, and the church in your house:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Philemon’s Love and Faith"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I thank my God always when I remember you in my prayers, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because I hear of your love and of the faith which you have toward the Lord Jesus and all the saints, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and I pray that the sharing of your faith may promote the knowledge of all the good that is ours in Christ. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I have derived much joy and comfort from your love, my brother, because the hearts of the saints have been refreshed through you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul’s Plea for Onesimus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Accordingly, though I am bold enough in Christ to command you to do what is required, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "yet for love’s sake I prefer to appeal to you—I, Paul, an ambassador"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or an old man"
                        },
                        {
                            "style": "NONE",
                            "text": " and now a prisoner also for Christ Jesus— "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I appeal to you for my child, Ones′imus, whose father I have become in my imprisonment. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(Formerly he was useless to you, but now he is indeed useful"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The name Onesimus means useful or (compare verse 20) beneficial"
                        },
                        {
                            "style": "NONE",
                            "text": " to you and to me.) "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I am sending him back to you, sending my very heart. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I would have been glad to keep him with me, in order that he might serve me on your behalf during my imprisonment for the gospel; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but I preferred to do nothing without your consent in order that your goodness might not be by compulsion but of your own free will."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Perhaps this is why he was parted from you for a while, that you might have him back for ever, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "no longer as a slave but more than a slave, as a beloved brother, especially to me but how much more to you, both in the flesh and in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So if you consider me your partner, receive him as you would receive me. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he has wronged you at all, or owes you anything, charge that to my account. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I, Paul, write this with my own hand, I will repay it—to say nothing of your owing me even your own self. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yes, brother, I want some benefit from you in the Lord. Refresh my heart in Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Confident of your obedience, I write to you, knowing that you will do even more than I say. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At the same time, prepare a guest room for me, for I am hoping through your prayers to be granted to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Final Greetings and Benediction"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ep′aphras, my fellow prisoner in Christ Jesus, sends greetings to you, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and so do Mark, Aristar′chus, Demas, and Luke, my fellow workers."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The grace of the Lord Jesus Christ be with your spirit."
                        }
                    ]
                }
            ]
        }
    ]
}