{
    "chapter_num": 16,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Jesus Warns and Comforts His Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“These things I have spoken to you, that you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "should not be made to stumble."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "They will put you out of the synagogues; yes, the time is coming"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "that whoever kills you will think that he offers God service."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "these things they will do"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit to you"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "to you because they have not known the Father nor Me."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But these things I have told you, that when"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU their"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the time comes, you may remember that I told you of them."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And these things I did not say to you at the beginning, because I was with you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Work of the Holy Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“But now I"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "go away to Him who sent Me, and none of you asks Me, ‘Where are You going?’"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But because I have said these things to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "sorrow has filled your heart."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Nevertheless I tell you the truth. It is to your advantage that I go away; for if I do not go away, the Helper will not come to you; but"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "if I depart, I will send Him to you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And when He has"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "come, He will convict the world of sin, and of righteousness, and of judgment:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "of sin, because they do not believe in Me;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "of righteousness,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "because I go to My Father and you see Me no more;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "of judgment, because"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the ruler of this world is judged."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I still have many things to say to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "but you cannot bear them now."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "However, when He,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Spirit of truth, has come,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He will guide you into all truth; for He will not speak on His own authority, but whatever He hears He will speak; and He will tell you things to come."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He will glorify Me, for He will take of what is Mine and declare it to you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "All things that the Father has are Mine. Therefore I said that He"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M takes of Mine and will declare"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "will take of Mine and declare it to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sorrow Will Turn to Joy"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“A"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "little while, and you will not see Me; and again a little while, and you will see Me,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "because I go to the Father.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of His disciples said among themselves, “What is this that He says to us, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘A little while, and you will not see Me; and again a little while, and you will see Me’"
                        },
                        {
                            "style": "NONE",
                            "text": "; and, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘because I go to the Father’"
                        },
                        {
                            "style": "NONE",
                            "text": "?” "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said therefore, “What is this that He says, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘A little while’"
                        },
                        {
                            "style": "NONE",
                            "text": "? We do not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "understand"
                        },
                        {
                            "style": "NONE",
                            "text": "know what He is saying.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Jesus knew that they desired to ask Him, and He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Are you inquiring among yourselves about what I said, ‘A little while, and you will not see Me; and again a little while, and you will see Me’?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Most assuredly, I say to you that you will weep and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "lament, but the world will rejoice; and you will be sorrowful, but your sorrow will be turned into"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "joy."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "A woman, when she is in labor, has sorrow because her hour has come; but as soon as she has given birth to the child, she no longer remembers the anguish, for joy that a human being has been born into the world."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore you now have sorrow; but I will see you again and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "your heart will rejoice, and your joy no one will take from you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And in that day you will ask Me nothing."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Most assuredly, I say to you, whatever you ask the Father in My name He will give you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Until now you have asked nothing in My name. Ask, and you will receive,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "that your joy may be"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "full."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Christ Has Overcome the World"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“These things I have spoken to you in figurative language; but the time is coming when I will no longer speak to you in figurative language, but I will tell you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "plainly about the Father."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "In that day you will ask in My name, and I do not say to you that I shall pray the Father for you;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "for the Father Himself loves you, because you have loved Me, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "have believed that I came forth from God."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I came forth from the Father and have come into the world. Again, I leave the world and go to the Father.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His disciples said to Him, “See, now You are speaking plainly, and using no figure of speech! "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now we are sure that You know all things, and have no need that anyone should question You. By this we believe that You came forth from God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Do you now believe?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Indeed the hour is coming, yes, has now come, that you will be scattered,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "each to his"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "own things or place"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "own, and will leave Me alone. And"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "yet I am not alone, because the Father is with Me."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "These things I have spoken to you, that"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "in Me you may have peace."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "In the world you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit will"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "will have tribulation; but be of good cheer,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I have overcome the world.”"
                        }
                    ]
                }
            ]
        }
    ]
}