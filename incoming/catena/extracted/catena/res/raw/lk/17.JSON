{
    "chapter_num": 17,
    "verses_count": 37,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Jesus Warns of Offenses"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He said to the disciples, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“It is impossible that no"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "stumbling blocks"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "offenses should come, but"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "woe to him through whom they do come!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "It would be better for him if a millstone were hung around his neck, and he were thrown into the sea, than that he should"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "cause one of these little ones to stumble"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "offend one of these little ones."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Take heed to yourselves."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If your brother sins"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits against you"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "against you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "rebuke him; and if he repents, forgive him."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And if he sins against you seven times in a day, and seven times in a day returns"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M omits to you"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "to you, saying, ‘I repent,’ you shall forgive him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Faith and Duty"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the apostles said to the Lord, “Increase our faith.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the Lord said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“If you have faith as a mustard seed, you can say to this mulberry tree, ‘Be pulled up by the roots and be planted in the sea,’ and it would obey you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And which of you, having a servant plowing or tending sheep, will say to him when he has come in from the field, ‘Come at once and sit down to eat’?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But will he not rather say to him, ‘Prepare something for my supper, and gird yourself"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "and serve me till I have eaten and drunk, and afterward you will eat and drink’?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Does he thank that servant because he did the things that were commanded"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the rest of v. 9; M omits him"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "him? I think not."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "So likewise you, when you have done all those things which you are commanded, say, ‘We are"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "unprofitable servants. We have done what was our duty to do.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Ten Lepers Cleansed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it happened as He went to Jerusalem that He passed through the midst of Samaria and Galilee. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then as He entered a certain village, there met Him ten men who were lepers, who stood afar off. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they lifted up "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " voices and said, “Jesus, Master, have mercy on us!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So when He saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them,"
                        },
                        {
                            "style": "NONE",
                            "text": " He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Go, show yourselves to the priests.”"
                        },
                        {
                            "style": "NONE",
                            "text": " And so it was that as they went, they were cleansed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And one of them, when he saw that he was healed, returned, and with a loud voice glorified God, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and fell down on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " face at His feet, giving Him thanks. And he was a Samaritan."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus answered and said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Were there not ten cleansed? But where are the nine?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Were there not any found who returned to give glory to God except this foreigner?”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Arise, go your way. Your faith has made you well.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Coming of the Kingdom"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when He was asked by the Pharisees when the kingdom of God would come, He answered them and said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“The kingdom of God does not come with observation;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "nor will they say,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU reverses here and there"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘See here!’ or ‘See there!’ For indeed,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the kingdom of God is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "in your midst"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "within you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He said to the disciples, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“The days will come when you will desire to see one of the days of the Son of Man, and you will not see it."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And they will say to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU reverses here and there"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘Look here!’ or ‘Look there!’ Do not go after them or follow them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For as the lightning that flashes out of one part under heaven shines to the other part under heaven, so also the Son of Man will be in His day."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But first He must suffer many things and be"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "rejected by this generation."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And as it"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "was in the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "days of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Noah, so it will be also in the days of the Son of Man:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "They ate, they drank, they married wives, they were given in marriage, until the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "day that Noah entered the ark, and the flood came and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "destroyed them all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Likewise as it was also in the days of Lot: They ate, they drank, they bought, they sold, they planted, they built;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "but on"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the day that Lot went out of Sodom it rained fire and brimstone from heaven and destroyed them all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Even so will it be in the day when the Son of Man"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "is revealed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“In that day, he"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "who is on the housetop, and his"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "possessions"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "goods are in the house, let him not come down to take them away. And likewise the one who is in the field, let him not turn back."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Remember Lot’s wife."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Whoever seeks to save his life will lose it, and whoever loses his life will preserve it."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I tell you, in that night there will be two"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or people"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "men in one bed: the one will be taken and the other will be left."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Two women will be grinding together: the one will be taken and the other left."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit v. 36."
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Two men will be in the field: the one will be taken and the other left.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they answered and said to Him, “Where, Lord?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Wherever the body is, there the eagles will be gathered together.”"
                        }
                    ]
                }
            ]
        }
    ]
}