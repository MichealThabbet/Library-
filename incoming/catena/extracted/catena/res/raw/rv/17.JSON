{
    "chapter_num": 17,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Scarlet Woman and the Scarlet Beast"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then one of the seven angels who had the seven bowls came and talked with me, saying "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit to me"
                        },
                        {
                            "style": "NONE",
                            "text": "to me, “Come, I will show you the judgment of the great harlot who sits on many waters, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with whom the kings of the earth committed fornication, and the inhabitants of the earth were made drunk with the wine of her fornication.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So he carried me away in the Spirit into the wilderness. And I saw a woman sitting on a scarlet beast "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which was"
                        },
                        {
                            "style": "NONE",
                            "text": " full of names of blasphemy, having seven heads and ten horns. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The woman was arrayed in purple and scarlet, and adorned with gold and precious stones and pearls, having in her hand a golden cup full of abominations and the filthiness of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M the fornication of the earth"
                        },
                        {
                            "style": "NONE",
                            "text": "her fornication. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on her forehead a name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "MYSTERY, BABYLON THE GREAT,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "THE MOTHER OF HARLOTS"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "AND OF THE ABOMINATIONS"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "OF THE EARTH."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I saw the woman, drunk with the blood of the saints and with the blood of the martyrs of Jesus. And when I saw her, I marveled with great amazement."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Meaning of the Woman and the Beast"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the angel said to me, “Why did you marvel? I will tell you the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "hidden truth"
                        },
                        {
                            "style": "NONE",
                            "text": "mystery of the woman and of the beast that carries her, which has the seven heads and the ten horns. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The beast that you saw was, and is not, and will ascend out of the bottomless pit and go to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "destruction"
                        },
                        {
                            "style": "NONE",
                            "text": "perdition. And those who dwell on the earth will marvel, whose names are not written in the Book of Life from the foundation of the world, when they see the beast that was, and is not, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M shall be present"
                        },
                        {
                            "style": "NONE",
                            "text": "yet is."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Here "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the mind which has wisdom: The seven heads are seven mountains on which the woman sits. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There are also seven kings. Five have fallen, one is, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the other has not yet come. And when he comes, he must continue a short time. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The beast that was, and is not, is himself also the eighth, and is of the seven, and is going to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "destruction"
                        },
                        {
                            "style": "NONE",
                            "text": "perdition."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The ten horns which you saw are ten kings who have received no kingdom as yet, but they receive authority for one hour as kings with the beast. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are of one mind, and they will give their power and authority to the beast. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These will make war with the Lamb, and the Lamb will overcome them, for He is Lord of lords and King of kings; and those "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who are"
                        },
                        {
                            "style": "NONE",
                            "text": " with Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " called, chosen, and faithful.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to me, “The waters which you saw, where the harlot sits, are peoples, multitudes, nations, and tongues. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the ten horns which you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M saw, and the beast"
                        },
                        {
                            "style": "NONE",
                            "text": "saw on the beast, these will hate the harlot, make her desolate and naked, eat her flesh and burn her with fire. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For God has put it into their hearts to fulfill His purpose, to be of one mind, and to give their kingdom to the beast, until the words of God are fulfilled. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the woman whom you saw is that great city which reigns over the kings of the earth.”"
                        }
                    ]
                }
            ]
        }
    ]
}