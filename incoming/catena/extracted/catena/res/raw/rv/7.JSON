        {
            "type": "section_header",
            "text": "A Multitude from the Great Tribulation"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After these things I looked, and behold, a great multitude which no one could number, of all nations, tribes, peoples, and tongues, standing before the throne and before the Lamb, clothed with white robes, with palm branches in their hands, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and crying out with a loud voice, saying, “Salvation "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belongs"
                        },
                        {
                            "style": "NONE",
                            "text": " to our God who sits on the throne, and to the Lamb!” "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the angels stood around the throne and the elders and the four living creatures, and fell on their faces before the throne and worshiped God, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Amen! Blessing and glory and wisdom,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Thanksgiving and honor and power and might,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Be"
                        },
                        {
                            "style": "NONE",
                            "text": " to our God forever and ever."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Amen.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then one of the elders answered, saying to me, “Who are these arrayed in white robes, and where did they come from?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I said to him, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M My lord"
                        },
                        {
                            "style": "NONE",
                            "text": "“Sir, you know.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So he said to me, “These are the ones who come out of the great tribulation, and washed their robes and made them white in the blood of the Lamb. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore they are before the throne of God, and serve Him day and night in His temple. And He who sits on the throne will dwell among them. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall neither hunger anymore nor thirst anymore; the sun shall not strike them, nor any heat; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for the Lamb who is in the midst of the throne will shepherd them and lead them to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M fountains of the waters of life"
                        },
                        {
                            "style": "NONE",
                            "text": "living fountains of waters. And God will wipe away every tear from their eyes.”"
                        }
                    ]
                }
            ]
        }
    ]
