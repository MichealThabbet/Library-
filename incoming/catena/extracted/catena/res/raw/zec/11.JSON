{
    "chapter_num": 11,
    "verses_count": 17,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Desolation of Israel"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Open your doors, O Lebanon,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "That fire may devour your cedars."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Wail, O cypress, for the cedar has fallen,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Because the mighty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "trees"
                        },
                        {
                            "style": "NONE",
                            "text": " are ruined."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Wail, O oaks of Bashan,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For the thick forest has come down."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There is"
                        },
                        {
                            "style": "NONE",
                            "text": " the sound of wailing shepherds!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For their glory is in ruins."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "ITALIC",
                            "text": "There is"
                        },
                        {
                            "style": "NONE",
                            "text": " the sound of roaring lions!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or floodplain, thicket"
                        },
                        {
                            "style": "NONE",
                            "text": "pride of the Jordan is in ruins."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Prophecy of the Shepherds"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God, “Feed the flock for slaughter, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whose owners slaughter them and feel no guilt; those who sell them say, ‘Blessed be the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", for I am rich’; and their shepherds do not pity them. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I will no longer pity the inhabitants of the land,” says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". “But indeed I will give everyone into his neighbor’s hand and into the hand of his king. They shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. strike"
                        },
                        {
                            "style": "NONE",
                            "text": "attack the land, and I will not deliver "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " from their hand.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So I fed the flock for slaughter, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX for the Canaanites"
                        },
                        {
                            "style": "NONE",
                            "text": "in particular the poor of the flock. I took for myself two staffs: the one I called "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Grace"
                        },
                        {
                            "style": "NONE",
                            "text": "Beauty, and the other I called "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Unity"
                        },
                        {
                            "style": "NONE",
                            "text": "Bonds; and I fed the flock. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or destroyed, lit. cut off"
                        },
                        {
                            "style": "NONE",
                            "text": "dismissed the three shepherds in one month. My soul loathed them, and their soul also abhorred me. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I said, “I will not feed you. Let what is dying die, and what is perishing perish. Let those that are left eat each other’s flesh.” "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I took my staff, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Grace"
                        },
                        {
                            "style": "NONE",
                            "text": "Beauty, and cut it in two, that I might break the covenant which I had made with all the peoples. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it was broken on that day. Thus the"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX the Canaanites"
                        },
                        {
                            "style": "NONE",
                            "text": " poor of the flock, who were watching me, knew that it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I said to them, “If it is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "good in your sight"
                        },
                        {
                            "style": "NONE",
                            "text": "agreeable to you, give "
                        },
                        {
                            "style": "ITALIC",
                            "text": "me"
                        },
                        {
                            "style": "NONE",
                            "text": " my wages; and if not, refrain.” So they weighed out for my wages thirty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "pieces"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to me, “Throw it to the potter”—that princely price they set on me. So I took the thirty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "pieces"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver and threw them into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " for the potter. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I cut in two my other staff, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Unity"
                        },
                        {
                            "style": "NONE",
                            "text": "Bonds, that I might break the brotherhood between Judah and Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to me, “Next, take for yourself the implements of a foolish shepherd. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For indeed I will raise up a shepherd in the land "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " will not care for those who are cut off, nor seek the young, nor heal those that are broken, nor feed those that still stand. But he will eat the flesh of the fat and tear their hooves in pieces."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Woe to the worthless shepherd,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Who leaves the flock!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "A sword "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " against his arm"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And against his right eye;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "His arm shall completely wither,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And his right eye shall be totally blinded.”"
                        }
                    ]
                }
            ]
        }
    ]
}