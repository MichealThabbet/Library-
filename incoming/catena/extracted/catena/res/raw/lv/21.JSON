{
    "chapter_num": 21,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Regulations for Conduct of Priests"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Speak to the priests, the sons of Aaron, and say to them: ‘None shall defile himself for the dead among his people, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "except for his relatives who are nearest to him: his mother, his father, his son, his daughter, and his brother; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also his virgin sister who is near to him, who has had no husband, for her he may defile himself. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Otherwise"
                        },
                        {
                            "style": "NONE",
                            "text": " he shall not defile himself, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "being"
                        },
                        {
                            "style": "NONE",
                            "text": " a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. master or husband"
                        },
                        {
                            "style": "NONE",
                            "text": "chief man among his people, to profane himself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘They shall not make any bald "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": " on their heads, nor shall they shave the edges of their beards nor make any cuttings in their flesh. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be holy to their God and not profane the name of their God, for they offer the offerings of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made by fire, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the bread of their God; therefore they shall be holy. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall not take a wife "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " a harlot or a defiled woman, nor shall they take a woman divorced from her husband; for "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. he"
                        },
                        {
                            "style": "ITALIC",
                            "text": "the priest"
                        },
                        {
                            "style": "NONE",
                            "text": " is holy to his God. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set him apart"
                        },
                        {
                            "style": "NONE",
                            "text": "consecrate him, for he offers the bread of your God. He shall be holy to you, for I the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", who sanctify you, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " holy. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The daughter of any priest, if she profanes herself by playing the harlot, she profanes her father. She shall be burned with fire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘"
                        },
                        {
                            "style": "ITALIC",
                            "text": "He who is"
                        },
                        {
                            "style": "NONE",
                            "text": " the high priest among his brethren, on whose head the anointing oil was poured and who is consecrated to wear the garments, shall not uncover"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "In mourning"
                        },
                        {
                            "style": "NONE",
                            "text": " his head nor tear his clothes; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor shall he go near any dead body, nor defile himself for his father or his mother; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor shall he go out of the sanctuary, nor profane the sanctuary of his God; for the consecration of the anointing oil of his God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " upon him: I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall take a wife in her virginity. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A widow or a divorced woman or a defiled woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or"
                        },
                        {
                            "style": "NONE",
                            "text": " a harlot—these he shall not marry; but he shall take a virgin of his own people as wife. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nor shall he profane his posterity among his people, for I the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " sanctify him.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to Aaron, saying: ‘No man of your descendants in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "succeeding"
                        },
                        {
                            "style": "NONE",
                            "text": " generations, who has "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " defect, may approach to offer the bread of his God. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For any man who has a defect shall not approach: a man blind or lame, who has a marred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "face"
                        },
                        {
                            "style": "NONE",
                            "text": " or any "
                        },
                        {
                            "style": "ITALIC",
                            "text": "limb"
                        },
                        {
                            "style": "NONE",
                            "text": " too long, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a man who has a broken foot or broken hand, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or is a hunchback or a dwarf, or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a man"
                        },
                        {
                            "style": "NONE",
                            "text": " who has a defect in his eye, or eczema or scab, or is a eunuch. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No man of the descendants of Aaron the priest, who has a defect, shall come near to offer the offerings made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". He has a defect; he shall not come near to offer the bread of his God. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He may eat the bread of his God, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "both"
                        },
                        {
                            "style": "NONE",
                            "text": " the most holy and the holy; "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "only he shall not go near the veil or approach the altar, because he has a defect, lest he profane My sanctuaries; for I the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " sanctify them.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Moses told "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to Aaron and his sons, and to all the children of Israel."
                        }
                    ]
                }
            ]
        }
    ]
}