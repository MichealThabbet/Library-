{
    "chapter_num": 7,
    "verses_count": 38,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Law of the Trespass Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Likewise this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law of the trespass offering (it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy): "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the place where they kill the burnt offering they shall kill the trespass offering. And its blood he shall sprinkle all around on the altar. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall offer from it all its fat. The fat tail and the fat that covers the entrails, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the two kidneys and the fat that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on them by the flanks, and the fatty lobe "
                        },
                        {
                            "style": "ITALIC",
                            "text": "attached"
                        },
                        {
                            "style": "NONE",
                            "text": " to the liver above the kidneys, he shall remove; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the priest shall burn them on the altar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " an offering made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a trespass offering. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every male among the priests may eat it. It shall be eaten in a holy place. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The trespass offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " like the sin offering; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " one law for them both: the priest who makes atonement with it shall have "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the priest who offers anyone’s burnt offering, that priest shall have for himself the skin of the burnt offering which he has offered. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also every grain offering that is baked in the oven and all that is prepared in the covered pan, or "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "on a griddle"
                        },
                        {
                            "style": "NONE",
                            "text": "in a pan, shall be the priest’s who offers it. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every grain offering, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whether"
                        },
                        {
                            "style": "NONE",
                            "text": " mixed with oil or dry, shall belong to all the sons of Aaron, to one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as much"
                        },
                        {
                            "style": "NONE",
                            "text": " as the other."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law of Peace Offerings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law of the sacrifice of peace offerings which he shall offer to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he offers it for a thanksgiving, then he shall offer, with the sacrifice of thanksgiving, unleavened cakes mixed with oil, unleavened wafers anointed with oil, or cakes of blended flour mixed with oil. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Besides the cakes, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " his offering he shall offer leavened bread with the sacrifice of thanksgiving of his peace offering. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And from it he shall offer one cake from each offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a heave offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". It shall belong to the priest who sprinkles the blood of the peace offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘The flesh of the sacrifice of his peace offering for thanksgiving shall be eaten the same day it is offered. He shall not leave any of it until morning. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the sacrifice of his offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a vow or a voluntary offering, it shall be eaten the same day that he offers his sacrifice; but on the next day the remainder of it also may be eaten; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the remainder of the flesh of the sacrifice on the third day must be burned with fire. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " of the flesh of the sacrifice of his peace offering is eaten at all on the third day, it shall not be accepted, nor shall it be imputed to him; it shall be an abomination "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " him who offers it, and the person who eats of it shall bear "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "his iniquity"
                        },
                        {
                            "style": "NONE",
                            "text": "guilt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘The flesh that touches any unclean thing shall not be eaten. It shall be burned with fire. And as for the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "clean"
                        },
                        {
                            "style": "NONE",
                            "text": " flesh, all who are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "pure"
                        },
                        {
                            "style": "NONE",
                            "text": "clean may eat of it. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the person who eats the flesh of the sacrifice of the peace offering that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belongs"
                        },
                        {
                            "style": "NONE",
                            "text": " to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", while he is unclean, that person shall be cut off from his people. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover the person who touches any unclean thing, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "such as"
                        },
                        {
                            "style": "NONE",
                            "text": " human uncleanness, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "an"
                        },
                        {
                            "style": "NONE",
                            "text": " unclean animal, or any abominable"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, LXX, Vg.; Sam., Syr., Tg. swarming thing (cf. 5:2)"
                        },
                        {
                            "style": "NONE",
                            "text": " unclean thing, and who eats the flesh of the sacrifice of the peace offering that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belongs"
                        },
                        {
                            "style": "NONE",
                            "text": " to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", that person shall be cut off from his people.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Fat and Blood May Not Be Eaten"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, saying: ‘You shall not eat any fat, of ox or sheep or goat. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the fat of an animal that dies "
                        },
                        {
                            "style": "ITALIC",
                            "text": "naturally"
                        },
                        {
                            "style": "NONE",
                            "text": ", and the fat of what is torn by wild beasts, may be used in any other way; but you shall by no means eat it. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For whoever eats the fat of the animal of which men offer an offering made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the person who eats "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be cut off from his people. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover you shall not eat any blood in any of your dwellings, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whether"
                        },
                        {
                            "style": "NONE",
                            "text": " of bird or beast. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever eats any blood, that person shall be cut off from his people.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Portion of Aaron and His Sons"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, saying: ‘He who offers the sacrifice of his peace offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall bring his offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " from the sacrifice of his peace offering. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His own hands shall bring the offerings made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". The fat with the breast he shall bring, that the breast may be waved "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a wave offering before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the priest shall burn the fat on the altar, but the breast shall be Aaron’s and his sons’. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also the right thigh you shall give to the priest "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a heave offering from the sacrifices of your peace offerings. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He among the sons of Aaron, who offers the blood of the peace offering and the fat, shall have the right thigh for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " part. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the breast of the wave offering and the thigh of the heave offering I have taken from the children of Israel, from the sacrifices of their peace offerings, and I have given them to Aaron the priest and to his sons from the children of Israel by a statute forever.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the consecrated portion for Aaron and his sons, from the offerings made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", on the day when "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Moses"
                        },
                        {
                            "style": "NONE",
                            "text": " presented them to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "serve"
                        },
                        {
                            "style": "NONE",
                            "text": "minister to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " as priests. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded this to be given to them by the children of Israel, on the day that He anointed them, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "by"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever throughout their generations."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law of the burnt offering, the grain offering, the sin offering, the trespass offering, the consecrations, and the sacrifice of the peace offering, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses on Mount Sinai, on the day when He commanded the children of Israel to offer their offerings to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " in the Wilderness of Sinai."
                        }
                    ]
                }
            ]
        }
    ]
}