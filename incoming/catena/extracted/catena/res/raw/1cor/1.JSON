{
    "chapter_num": 1,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, called "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " an apostle of Jesus Christ through the will of God, and Sosthenes "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " brother,"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the church of God which is at Corinth, to those who are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctified in Christ Jesus, called "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " saints, with all who in every place call on the name of Jesus Christ our Lord, both theirs and ours:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Spiritual Gifts at Corinth"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I thank my God always concerning you for the grace of God which was given to you by Christ Jesus, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that you were enriched in everything by Him in all "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "speech"
                        },
                        {
                            "style": "NONE",
                            "text": "utterance and all knowledge, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "even as the testimony of Christ was confirmed "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or among"
                        },
                        {
                            "style": "NONE",
                            "text": "in you, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that you come short in no gift, eagerly waiting for the revelation of our Lord Jesus Christ, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who will also confirm you to the end, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that you may be"
                        },
                        {
                            "style": "NONE",
                            "text": " blameless in the day of our Lord Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " faithful, by whom you were called into the fellowship of His Son, Jesus Christ our Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sectarianism Is Sin"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I plead with you, brethren, by the name of our Lord Jesus Christ, that you all "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Have a uniform testimony"
                        },
                        {
                            "style": "NONE",
                            "text": "speak the same thing, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " there be no "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "schisms or dissensions"
                        },
                        {
                            "style": "NONE",
                            "text": "divisions among you, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " you be perfectly joined together in the same mind and in the same judgment. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For it has been declared to me concerning you, my brethren, by those of Chloe’s "
                        },
                        {
                            "style": "ITALIC",
                            "text": "household,"
                        },
                        {
                            "style": "NONE",
                            "text": " that there are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "quarrels"
                        },
                        {
                            "style": "NONE",
                            "text": "contentions among you. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I say this, that each of you says, “I am of Paul,” or “I am of Apollos,” or “I am of Cephas,” or “I am of Christ.” "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Is Christ divided? Was Paul crucified for you? Or were you baptized in the name of Paul?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I thank God that I baptized none of you except Crispus and Gaius, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest anyone should say that I had baptized in my own name. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yes, I also baptized the household of Stephanas. Besides, I do not know whether I baptized any other. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Christ did not send me to baptize, but to preach the gospel, not with wisdom of words, lest the cross of Christ should be made of no effect."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Christ the Power and Wisdom of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. word"
                        },
                        {
                            "style": "NONE",
                            "text": "message of the cross is foolishness to those who are perishing, but to us who are being saved it is the power of God. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For it is written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“I will destroy the wisdom of the wise,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And bring to nothing the understanding of the prudent.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the wise? Where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the scribe? Where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "debater"
                        },
                        {
                            "style": "NONE",
                            "text": "disputer of this age? Has not God made foolish the wisdom of this world? "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For since, in the wisdom of God, the world through wisdom did not know God, it pleased God through the foolishness of the message preached to save those who believe. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Jews request a sign, and Greeks seek after wisdom; "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but we preach Christ crucified, to the Jews a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gr. skandalon, offense"
                        },
                        {
                            "style": "NONE",
                            "text": "stumbling block and to the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Gentiles"
                        },
                        {
                            "style": "NONE",
                            "text": "Greeks foolishness, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but to those who are called, both Jews and Greeks, Christ the power of God and the wisdom of God. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because the foolishness of God is wiser than men, and the weakness of God is stronger than men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Glory Only in the Lord"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consider"
                        },
                        {
                            "style": "NONE",
                            "text": "you see your calling, brethren, that not many wise according to the flesh, not many mighty, not many "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "well-born"
                        },
                        {
                            "style": "NONE",
                            "text": "noble, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are called."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But God has chosen the foolish things of the world to put to shame the wise, and God has chosen the weak things of the world to put to shame the things which are mighty; "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "insignificant or lowly"
                        },
                        {
                            "style": "NONE",
                            "text": "base things of the world and the things which are despised God has chosen, and the things which are not, to bring to nothing the things that are, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that no flesh should glory in His presence. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But of Him you are in Christ Jesus, who became for us wisdom from God—and righteousness and sanctification and redemption— "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that, as it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“He who glories, let him glory in the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": ".”"
                        }
                    ]
                }
            ]
        }
    ]
}