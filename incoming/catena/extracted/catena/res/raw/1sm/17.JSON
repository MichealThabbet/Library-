                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then, as David returned from the slaughter of the Philistine, Abner took him and brought him before Saul with the head of the Philistine in his hand. "
                        }
                    ]
