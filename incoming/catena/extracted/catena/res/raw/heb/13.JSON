{
    "chapter_num": 13,
    "verses_count": 25,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Concluding Moral Directions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let brotherly love continue. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not forget to entertain strangers, for by so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "doing"
                        },
                        {
                            "style": "NONE",
                            "text": " some have unwittingly entertained angels. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Remember the prisoners as if chained with them—those who are mistreated—since you yourselves are in the body also."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Marriage "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " honorable among all, and the bed undefiled; but fornicators and adulterers God will judge."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Let your"
                        },
                        {
                            "style": "NONE",
                            "text": " conduct "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " without covetousness; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " content with such things as you have. For He Himself has said, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“I will never leave you nor forsake you.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So we may boldly say:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“The"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "my helper;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "I will not fear."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "What can man do to me?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Concluding Religious Directions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Remember those who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "lead"
                        },
                        {
                            "style": "NONE",
                            "text": "rule over you, who have spoken the word of God to you, whose faith follow, considering the outcome of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " conduct. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the same yesterday, today, and forever. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not be carried "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M away"
                        },
                        {
                            "style": "NONE",
                            "text": "about with various and strange doctrines. For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " good that the heart be established by grace, not with foods which have not profited those who have been occupied with them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We have an altar from which those who serve the tabernacle have no right to eat. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the bodies of those animals, whose blood is brought into the sanctuary by the high priest for sin, are burned outside the camp. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore Jesus also, that He might "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctify the people with His own blood, suffered outside the gate. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore let us go forth to Him, outside the camp, bearing His reproach. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For here we have no continuing city, but we seek the one to come. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore by Him let us continually offer the sacrifice of praise to God, that is, the fruit of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " lips, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. confessing"
                        },
                        {
                            "style": "NONE",
                            "text": "giving thanks to His name. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But do not forget to do good and to share, for with such sacrifices God is well pleased."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Obey those who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "lead"
                        },
                        {
                            "style": "NONE",
                            "text": "rule over you, and be submissive, for they watch out for your souls, as those who must give account. Let them do so with joy and not with grief, for that would be unprofitable for you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Prayer Requested"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Pray for us; for we are confident that we have a good conscience, in all things desiring to live honorably. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I especially urge "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " to do this, that I may be restored to you the sooner."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Benediction, Final Exhortation, Farewell"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now may the God of peace who brought up our Lord Jesus from the dead, that great Shepherd of the sheep, through the blood of the everlasting covenant, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "make you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perfect"
                        },
                        {
                            "style": "NONE",
                            "text": "complete in every good work to do His will, working in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M us"
                        },
                        {
                            "style": "NONE",
                            "text": "you what is well pleasing in His sight, through Jesus Christ, to whom "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " glory forever and ever. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I appeal to you, brethren, bear with the word of exhortation, for I have written to you in few words. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Know that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " brother Timothy has been set free, with whom I shall see you if he comes shortly."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet all those who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "lead"
                        },
                        {
                            "style": "NONE",
                            "text": "rule over you, and all the saints. Those from Italy greet you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you all. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}