{
    "chapter_num": 11,
    "verses_count": 54,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Model Prayer"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it came to pass, as He was praying in a certain place, when He ceased, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " one of His disciples said to Him, “Lord, teach us to pray, as John also taught his disciples.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“When you pray, say:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Our"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits Our"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Father"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits in heaven"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "in heaven,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Hallowed be Your name."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Your kingdom come."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the rest of v. 2."
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Your will be done"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "On earth as it is in heaven."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Give us day by day our daily bread."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "forgive us our sins,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For we also forgive everyone who is indebted to us."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And do not lead us into temptation,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits But deliver us from the evil one"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But deliver us from the evil one.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Friend Comes at Midnight"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Which of you shall have a friend, and go to him at midnight and say to him, ‘Friend, lend me three loaves;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "for a friend of mine has come to me on his journey, and I have nothing to set before him’;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "and he will answer from within and say, ‘Do not trouble me; the door is now shut, and my children are with me in bed; I cannot rise and give to you’?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I say to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "though he will not rise and give to him because he is his friend, yet because of his persistence he will rise and give him as many as he needs."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Keep Asking, Seeking, Knocking"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“So I say to you, ask, and it will be given to you;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "seek, and you will find; knock, and it will be opened to you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For everyone who asks receives, and he who seeks finds, and to him who knocks it will be opened."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If a son asks for"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits bread from any father among you, will he give him a stone? Or if he asks for"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "bread from any father among you, will he give him a stone? Or if he asks for a fish, will he give him a serpent instead of a fish?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Or if he asks for an egg, will he offer him a scorpion?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If you then, being evil, know how to give"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "good gifts to your children, how much more will your heavenly Father give the Holy Spirit to those who ask Him!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A House Divided Cannot Stand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He was casting out a demon, and it was mute. So it was, when the demon had gone out, that the mute spoke; and the multitudes marveled. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But some of them said, “He casts out demons by "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M Beelzebul"
                        },
                        {
                            "style": "NONE",
                            "text": "Beelzebub, the ruler of the demons.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Others, testing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him,"
                        },
                        {
                            "style": "NONE",
                            "text": " sought from Him a sign from heaven. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But He, knowing their thoughts, said to them: "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Every kingdom divided against itself is brought to desolation, and a house divided against a house falls."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If Satan also is divided against himself, how will his kingdom stand? Because you say I cast out demons by Beelzebub."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And if I cast out demons by Beelzebub, by whom do your sons cast them out? Therefore they will be your judges."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But if I cast out demons"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "with the finger of God, surely the kingdom of God has come upon you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "When a strong man, fully armed, guards his own palace, his goods are in peace."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "when a stronger than he comes upon him and overcomes him, he takes from him all his armor in which he trusted, and divides his"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "plunder"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "spoils."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who is not with Me is against Me, and he who does not gather with Me scatters."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "An Unclean Spirit Returns"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“When an unclean spirit goes out of a man, he goes through dry places, seeking rest; and finding none, he says, ‘I will return to my house from which I came.’"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And when he comes, he finds it swept and put in order."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Then he goes and takes with him seven other spirits more wicked than himself, and they enter and dwell there; and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the last state of that man is worse than the first.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Keeping the Word"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it happened, as He spoke these things, that a certain woman from the crowd raised her voice and said to Him, “Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the womb that bore You, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " breasts which nursed You!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But He said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“More than that, blessed are those who hear the word of God and keep it!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Seeking a Sign"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And while the crowds were thickly gathered together, He began to say, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“This is an evil generation. It seeks a"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "sign, and no sign will be given to it except the sign of Jonah"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the prophet"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the prophet."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For as"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Jonah became a sign to the Ninevites, so also the Son of Man will be to this generation."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "The queen of the South will rise up in the judgment with the men of this generation and condemn them, for she came from the ends of the earth to hear the wisdom of Solomon; and indeed a"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "greater than Solomon is here."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "The men of Nineveh will rise up in the judgment with this generation and condemn it, for"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "they repented at the preaching of Jonah; and indeed a greater than Jonah is here."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Lamp of the Body"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“No one, when he has lit a lamp, puts it in a secret place or under a"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "basket, but on a lampstand, that those who come in may see the light."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "The lamp of the body is the eye. Therefore, when your eye is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Clear, or healthy"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "good, your whole body also is full of light. But when your eye is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Evil, or unhealthy"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "bad, your body also is full of darkness."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore take heed that the light which is in you is not darkness."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If then your whole body is full of light, having no part dark, the whole body will be full of light, as when the bright shining of a lamp gives you light.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Woe to the Pharisees and Lawyers"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as He spoke, a certain Pharisee asked Him to dine with him. So He went in and sat down to eat. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the Pharisee saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " he marveled that He had not first washed before dinner."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the Lord said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Now you Pharisees make the outside of the cup and dish clean, but"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "your inward part is full of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. eager grasping or robbery"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "greed and wickedness."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Foolish ones! Did not"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who made the outside make the inside also?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But rather give alms of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or what is inside"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "such things as you have; then indeed all things are clean to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“But woe to you Pharisees! For you tithe mint and rue and all manner of herbs, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "pass by justice and the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "love of God. These you ought to have done, without leaving the others undone."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Woe to you Pharisees! For you love the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or places of honor"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "best seats in the synagogues and greetings in the marketplaces."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Woe to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits scribes and Pharisees, hypocrites"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "scribes and Pharisees, hypocrites!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For you are like graves which are not seen, and the men who walk over them are not aware of them.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then one of the lawyers answered and said to Him, “Teacher, by saying these things You reproach us also.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Woe to you also, lawyers!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For you load men with burdens hard to bear, and you yourselves do not touch the burdens with one of your fingers."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Woe to you! For you build the tombs of the prophets, and your fathers killed them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "In fact, you bear witness that you approve the deeds of your fathers; for they indeed killed them, and you build their tombs."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore the wisdom of God also said,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘I will send them prophets and apostles, and some of them they will kill and persecute,’"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "that the blood of all the prophets which was shed from the foundation of the world may be required of this generation,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "from the blood of Abel to"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the blood of Zechariah who perished between the altar and the temple. Yes, I say to you, it shall be required of this generation."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Woe to you lawyers! For you have taken away the key of knowledge. You did not enter in yourselves, and those who were entering in you hindered.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU And when He left there"
                        },
                        {
                            "style": "NONE",
                            "text": "And as He said these things to them, the scribes and the Pharisees began to assail "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " vehemently, and to cross-examine Him about many things, "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lying in wait for Him, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits and seeking"
                        },
                        {
                            "style": "NONE",
                            "text": "and seeking to catch Him in something He might say, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits that they might accuse Him"
                        },
                        {
                            "style": "NONE",
                            "text": "that they might accuse Him."
                        }
                    ]
                }
            ]
        }
    ]
}