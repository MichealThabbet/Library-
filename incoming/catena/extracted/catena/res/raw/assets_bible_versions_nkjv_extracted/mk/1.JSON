{
    "chapter_num": 1,
    "verses_count": 45,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "John the Baptist Prepares the Way"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The beginning of the gospel of Jesus Christ, the Son of God. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As it is written in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Isaiah the prophet"
                        },
                        {
                            "style": "NONE",
                            "text": "the Prophets:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Behold, I send My messenger before Your face,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Who will prepare Your way before You.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“The"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "voice of one crying in the wilderness:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "‘Prepare the way of the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": ";"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Make His paths straight.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John came baptizing in the wilderness and preaching a baptism of repentance "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or because of forgiveness"
                        },
                        {
                            "style": "NONE",
                            "text": "for the remission of sins. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then all the land of Judea, and those from Jerusalem, went out to him and were all baptized by him in the Jordan River, confessing their sins."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now John was clothed with camel’s hair and with a leather belt around his waist, and he ate locusts and wild honey. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he preached, saying, “There comes One after me who is mightier than I, whose sandal strap I am not worthy to stoop down and loose. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I indeed baptized you with water, but He will baptize you with the Holy Spirit.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "John Baptizes Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It came to pass in those days "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " Jesus came from Nazareth of Galilee, and was baptized by John in the Jordan. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately, coming up "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU out of"
                        },
                        {
                            "style": "NONE",
                            "text": "from the water, He saw the heavens "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "torn open"
                        },
                        {
                            "style": "NONE",
                            "text": "parting and the Spirit descending upon Him like a dove. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then a voice came from heaven, “You are My beloved Son, in whom I am well pleased.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Satan Tempts Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Immediately the Spirit "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sent Him out"
                        },
                        {
                            "style": "NONE",
                            "text": "drove Him into the wilderness. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He was there in the wilderness forty days, tempted by Satan, and was with the wild beasts; and the angels ministered to Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Begins His Galilean Ministry"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now after John was put in prison, Jesus came to Galilee, preaching the gospel "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits of the kingdom"
                        },
                        {
                            "style": "NONE",
                            "text": "of the kingdom of God, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and saying, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“The time is fulfilled, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the kingdom of God"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "has drawn near"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "is at hand. Repent, and believe in the gospel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Four Fishermen Called as Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as He walked by the Sea of Galilee, He saw Simon and Andrew his brother casting a net into the sea; for they were fishermen. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Follow Me, and I will make you become"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "fishers of men.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They immediately left their nets and followed Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When He had gone a little farther from there, He saw James the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "son"
                        },
                        {
                            "style": "NONE",
                            "text": " of Zebedee, and John his brother, who also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the boat mending their nets. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately He called them, and they left their father Zebedee in the boat with the hired servants, and went after Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Casts Out an Unclean Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they went into Capernaum, and immediately on the Sabbath He entered the synagogue and taught. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were astonished at His teaching, for He taught them as one having authority, and not as the scribes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now there was a man in their synagogue with an unclean spirit. And he cried out, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "saying, “Let "
                        },
                        {
                            "style": "ITALIC",
                            "text": "us"
                        },
                        {
                            "style": "NONE",
                            "text": " alone! What have we to do with You, Jesus of Nazareth? Did You come to destroy us? I know who You are—the Holy One of God!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus rebuked him, saying, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Be muzzled"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Be quiet, and come out of him!”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when the unclean spirit had convulsed him and cried out with a loud voice, he came out of him. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they were all amazed, so that they questioned among themselves, saying, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU What is this? A new doctrine with authority! He"
                        },
                        {
                            "style": "NONE",
                            "text": "“What is this? What new "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "teaching"
                        },
                        {
                            "style": "NONE",
                            "text": "doctrine "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " this? For with authority He commands even the unclean spirits, and they obey Him.” "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately His fame spread throughout all the region around Galilee."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Peter’s Mother-in-Law Healed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now as soon as they had come out of the synagogue, they entered the house of Simon and Andrew, with James and John. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Simon’s wife’s mother lay sick with a fever, and they told Him about her at once. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He came and took her by the hand and lifted her up, and immediately the fever left her. And she served them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Many Healed After Sabbath Sunset"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At evening, when the sun had set, they brought to Him all who were sick and those who were demon-possessed. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the whole city was gathered together at the door. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He healed many who were sick with various diseases, and cast out many demons; and He did not allow the demons to speak, because they knew Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Preaching in Galilee"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in the morning, having risen a long while before daylight, He went out and departed to a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "deserted"
                        },
                        {
                            "style": "NONE",
                            "text": "solitary place; and there He prayed. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Simon and those "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who were"
                        },
                        {
                            "style": "NONE",
                            "text": " with Him searched for Him. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they found Him, they said to Him, “Everyone is looking for You.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Let us go into the next towns, that I may preach there also, because"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "for this purpose I have come forth.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He was preaching in their synagogues throughout all Galilee, and casting out demons."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Cleanses a Leper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now a leper came to Him, imploring Him, kneeling down to Him and saying to Him, “If You are willing, You can make me clean.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus, moved with compassion, stretched out "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " hand and touched him, and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I am willing; be cleansed.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As soon as He had spoken, immediately the leprosy left him, and he was cleansed. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He strictly warned him and sent him away at once, "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“See that you say nothing to anyone; but go your way, show yourself to the priest, and offer for your cleansing those things"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "which Moses commanded, as a testimony to them.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "However, he went out and began to proclaim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " freely, and to spread the matter, so that Jesus could no longer openly enter the city, but was outside in deserted places; and they came to Him from every direction."
                        }
                    ]
                }
            ]
        }
    ]
}