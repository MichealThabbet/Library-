{
    "chapter_num": 1,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, a bondservant of Jesus Christ, called "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " an apostle, separated to the gospel of God "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which He promised before through His prophets in the Holy Scriptures, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "concerning His Son Jesus Christ our Lord, who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "came"
                        },
                        {
                            "style": "NONE",
                            "text": "was born of the seed of David according to the flesh, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " declared "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " the Son of God with power according to the Spirit of holiness, by the resurrection from the dead. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Through Him we have received grace and apostleship for obedience to the faith among all nations for His name, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "among whom you also are the called of Jesus Christ;"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To all who are in Rome, beloved of God, called "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " saints:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Desire to Visit Rome"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "First, I thank my God through Jesus Christ for you all, that your faith is spoken of throughout the whole world. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For God is my witness, whom I serve "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or in"
                        },
                        {
                            "style": "NONE",
                            "text": "with my spirit in the gospel of His Son, that without ceasing I make mention of you always in my prayers, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "making request if, by some means, now at last I may find a way in the will of God to come to you. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I long to see you, that I may impart to you some spiritual gift, so that you may be established— "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that is, that I may be encouraged together with you by the mutual faith both of you and me."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I do not want you to be unaware, brethren, that I often planned to come to you (but was hindered until now), that I might have some fruit among you also, just as among the other Gentiles. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I am a debtor both to Greeks and to barbarians, both to wise and to unwise. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So, as much as is in me, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "I am"
                        },
                        {
                            "style": "NONE",
                            "text": " ready to preach the gospel to you who are in Rome also."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Just Live by Faith"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I am not ashamed of the gospel "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits of Christ"
                        },
                        {
                            "style": "NONE",
                            "text": "of Christ, for it is the power of God to salvation for everyone who believes, for the Jew first and also for the Greek. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in it the righteousness of God is revealed from faith to faith; as it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“The just shall live by faith.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "God’s Wrath on Unrighteousness"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the wrath of God is revealed from heaven against all ungodliness and unrighteousness of men, who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "hold down"
                        },
                        {
                            "style": "NONE",
                            "text": "suppress the truth in unrighteousness, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because what may be known of God is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "evident"
                        },
                        {
                            "style": "NONE",
                            "text": "manifest "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "among"
                        },
                        {
                            "style": "NONE",
                            "text": "in them, for God has shown "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to them. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For since the creation of the world His invisible "
                        },
                        {
                            "style": "ITALIC",
                            "text": "attributes"
                        },
                        {
                            "style": "NONE",
                            "text": " are clearly seen, being understood by the things that are made, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "even"
                        },
                        {
                            "style": "NONE",
                            "text": " His eternal power and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "divine nature, deity"
                        },
                        {
                            "style": "NONE",
                            "text": "Godhead, so that they are without excuse, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because, although they knew God, they did not glorify "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " as God, nor were thankful, but became futile in their thoughts, and their foolish hearts were darkened. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Professing to be wise, they became fools, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and changed the glory of the incorruptible God into an image made like "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perishable"
                        },
                        {
                            "style": "NONE",
                            "text": "corruptible man—and birds and four-footed animals and creeping things."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore God also gave them up to uncleanness, in the lusts of their hearts, to dishonor their bodies among themselves, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who exchanged the truth of God for the lie, and worshiped and served the creature rather than the Creator, who is blessed forever. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason God gave them up to vile passions. For even their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. females"
                        },
                        {
                            "style": "NONE",
                            "text": "women exchanged the natural use for what is against nature. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise also the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. males"
                        },
                        {
                            "style": "NONE",
                            "text": "men, leaving the natural use of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. female"
                        },
                        {
                            "style": "NONE",
                            "text": "woman, burned in their lust for one another, men with men committing what is shameful, and receiving in themselves the penalty of their error which was due."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And even as they did not like to retain God in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " knowledge, God gave them over to a debased mind, to do those things which are not fitting; "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "being filled with all unrighteousness, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits sexual immorality"
                        },
                        {
                            "style": "NONE",
                            "text": "sexual immorality, wickedness, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "greed"
                        },
                        {
                            "style": "NONE",
                            "text": "covetousness, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "malice"
                        },
                        {
                            "style": "NONE",
                            "text": "maliciousness; full of envy, murder, strife, deceit, evil-mindedness; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they are"
                        },
                        {
                            "style": "NONE",
                            "text": " whisperers, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "backbiters, haters of God, violent, proud, boasters, inventors of evil things, disobedient to parents, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "without understanding"
                        },
                        {
                            "style": "NONE",
                            "text": "undiscerning, untrustworthy, unloving, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits unforgiving"
                        },
                        {
                            "style": "NONE",
                            "text": "unforgiving, unmerciful; "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who, knowing the righteous judgment of God, that those who practice such things are deserving of death, not only do the same but also approve of those who practice them."
                        }
                    ]
                }
            ]
        }
    ]
}