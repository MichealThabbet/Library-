{
    "chapter_num": 14,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Law of Liberty"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Receive one who is weak in the faith, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "but"
                        },
                        {
                            "style": "NONE",
                            "text": " not to disputes over doubtful things. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For one believes he may eat all things, but he who is weak eats "
                        },
                        {
                            "style": "ITALIC",
                            "text": "only"
                        },
                        {
                            "style": "NONE",
                            "text": " vegetables. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let not him who eats despise him who does not eat, and let not him who does not eat judge him who eats; for God has received him. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Who are you to judge another’s servant? To his own master he stands or falls. Indeed, he will be made to stand, for God is able to make him stand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "One person esteems "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " day above another; another esteems every day "
                        },
                        {
                            "style": "ITALIC",
                            "text": "alike."
                        },
                        {
                            "style": "NONE",
                            "text": " Let each be fully convinced in his own mind. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who observes the day, observes "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to the Lord; "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the rest of this sentence."
                        },
                        {
                            "style": "NONE",
                            "text": "and he who does not observe the day, to the Lord he does not observe "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        },
                        {
                            "style": "NONE",
                            "text": " He who eats, eats to the Lord, for he gives God thanks; and he who does not eat, to the Lord he does not eat, and gives God thanks. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For none of us lives to himself, and no one dies to himself. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For if we live, we live to the Lord; and if we die, we die to the Lord. Therefore, whether we live or die, we are the Lord’s. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For to this end Christ died "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits and rose"
                        },
                        {
                            "style": "NONE",
                            "text": "and rose and lived again, that He might be Lord of both the dead and the living. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But why do you judge your brother? Or why do you show contempt for your brother? For we shall all stand before the judgment seat of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU God"
                        },
                        {
                            "style": "NONE",
                            "text": "Christ. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For it is written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "As"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "I live, says the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": ","
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Every knee shall bow to Me,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And every tongue shall confess to God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So then each of us shall give account of himself to God. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore let us not judge one another "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "any longer"
                        },
                        {
                            "style": "NONE",
                            "text": "anymore, but rather resolve this, not to put a stumbling block or a cause to fall in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " brother’s way."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law of Love"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I know and am convinced by the Lord Jesus that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " nothing unclean of itself; but to him who considers anything to be unclean, to him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " unclean. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet if your brother is grieved because of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " food, you are no longer walking in love. Do not destroy with your food the one for whom Christ died. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore do not let your good be spoken of as evil; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for the kingdom of God is not eating and drinking, but righteousness and peace and joy in the Holy Spirit. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For he who serves Christ in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU this thing"
                        },
                        {
                            "style": "NONE",
                            "text": "these things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " acceptable to God and approved by men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore let us pursue the things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which make"
                        },
                        {
                            "style": "NONE",
                            "text": " for peace and the things by which one may "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "build up"
                        },
                        {
                            "style": "NONE",
                            "text": "edify another. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not destroy the work of God for the sake of food. All things indeed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " pure, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " evil for the man who eats with "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "A feeling of giving offense"
                        },
                        {
                            "style": "NONE",
                            "text": "offense. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "It is"
                        },
                        {
                            "style": "NONE",
                            "text": " good neither to eat meat nor drink wine nor "
                        },
                        {
                            "style": "ITALIC",
                            "text": "do anything"
                        },
                        {
                            "style": "NONE",
                            "text": " by which your brother stumbles "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the rest of v. 21."
                        },
                        {
                            "style": "NONE",
                            "text": "or is offended or is made weak. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU The faith which you have—have"
                        },
                        {
                            "style": "NONE",
                            "text": "Do you have faith? Have "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to yourself before God. Happy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " he who does not condemn himself in what he approves. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he who doubts is condemned if he eats, because "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he does"
                        },
                        {
                            "style": "NONE",
                            "text": " not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "eat"
                        },
                        {
                            "style": "NONE",
                            "text": " from faith; for whatever "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not from faith is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M puts Rom. 16:25–27 here."
                        },
                        {
                            "style": "NONE",
                            "text": "sin."
                        }
                    ]
                }
            ]
        }
    ]
}