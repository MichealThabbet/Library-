                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, the noise of the report has come,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And a great commotion out of the north country,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To make the cities of Judah desolate, a den of jackals."
