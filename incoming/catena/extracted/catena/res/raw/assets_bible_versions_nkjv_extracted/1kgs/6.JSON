{
    "chapter_num": 6,
    "verses_count": 38,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Solomon Builds the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it came to pass in the four hundred and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX fortieth"
                        },
                        {
                            "style": "NONE",
                            "text": "eightieth year after the children of Israel had come out of the land of Egypt, in the fourth year of Solomon’s reign over Israel, in the month of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Ayyar, April or May"
                        },
                        {
                            "style": "NONE",
                            "text": "Ziv, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the second month, that he began to build the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the house which King Solomon built for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", its length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " sixty cubits, its width twenty, and its height thirty cubits. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The vestibule in front of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. heykal; here the main room of the temple; elsewhere called the holy place, Ex. 26:33; Ezek. 41:1"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctuary of the house "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "About 30 feet"
                        },
                        {
                            "style": "NONE",
                            "text": "twenty cubits long across the width of the house, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the width of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. it"
                        },
                        {
                            "style": "ITALIC",
                            "text": "the vestibule extended"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "About 15 feet"
                        },
                        {
                            "style": "NONE",
                            "text": "ten cubits from the front of the house. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made for the house windows with beveled frames."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Against the wall of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple he built chambers all around, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "against"
                        },
                        {
                            "style": "NONE",
                            "text": " the walls of the temple, all around the sanctuary and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. debir; here the inner room of the temple; elsewhere called the Most Holy Place, v. 16"
                        },
                        {
                            "style": "NONE",
                            "text": "inner sanctuary. Thus he made side chambers all around it. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The lowest chamber "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits wide, the middle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " six cubits wide, and the third "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " seven cubits wide; for he made narrow ledges around the outside of the temple, so that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the support beams"
                        },
                        {
                            "style": "NONE",
                            "text": " would not be fastened into the walls of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the temple, when it was being built, was built with stone finished at the quarry, so that no hammer or chisel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or"
                        },
                        {
                            "style": "NONE",
                            "text": " any iron tool was heard in the temple while it was being built. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The doorway for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Vg.; LXX upper story; Tg. ground story"
                        },
                        {
                            "style": "NONE",
                            "text": "middle story "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on the right side of the temple. They went up by stairs to the middle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "story,"
                        },
                        {
                            "style": "NONE",
                            "text": " and from the middle to the third."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So he built the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple and finished it, and he paneled the temple with beams and boards of cedar. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he built side chambers against the entire temple, each five cubits high; they were attached to the temple with cedar beams."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to Solomon, saying: "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Concerning"
                        },
                        {
                            "style": "NONE",
                            "text": " this "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple which you are building, if you walk in My statutes, execute My judgments, keep all My commandments, and walk in them, then I will perform My "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "promise"
                        },
                        {
                            "style": "NONE",
                            "text": "word with you, which I spoke to your father David. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will dwell among the children of Israel, and will not forsake My people Israel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Solomon built the temple and finished it. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he built the inside walls of the temple with cedar boards; from the floor of the temple to the ceiling he paneled the inside with wood; and he covered the floor of the temple with planks of cypress. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he built the twenty-cubit room at the rear of the temple, from floor to ceiling, with cedar boards; he built "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " inside as the inner sanctuary, as the Most Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in front of it the temple sanctuary was forty cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "long."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The inside of the temple was cedar, carved with ornamental buds and open flowers. All "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " cedar; there was no stone "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " seen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he prepared the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Most Holy Place"
                        },
                        {
                            "style": "NONE",
                            "text": "inner sanctuary inside the temple, to set the ark of the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " there. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The inner sanctuary "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty cubits long, twenty cubits wide, and twenty cubits high. He overlaid it with pure gold, and overlaid the altar of cedar. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Solomon overlaid the inside of the temple with pure gold. He stretched gold chains across the front of the inner sanctuary, and overlaid it with gold. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The whole temple he overlaid with gold, until he had finished all the temple; also he overlaid with gold the entire altar that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " by the inner sanctuary."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Inside the inner sanctuary he made two cherubim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " olive wood, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "each"
                        },
                        {
                            "style": "NONE",
                            "text": " ten cubits high. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "One wing of the cherub "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits, and the other wing of the cherub five cubits: ten cubits from the tip of one wing to the tip of the other. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the other cherub "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " ten cubits; both cherubim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " of the same size and shape. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The height of one cherub "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " ten cubits, and so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the other cherub. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he set the cherubim inside the inner "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "room; and they stretched out the wings of the cherubim so that the wing of the one touched "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " wall, and the wing of the other cherub touched the other wall. And their wings touched each other in the middle of the room. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also he overlaid the cherubim with gold."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he carved all the walls of the temple all around, both the inner and outer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sanctuaries,"
                        },
                        {
                            "style": "NONE",
                            "text": " with carved figures of cherubim, palm trees, and open flowers. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the floor of the temple he overlaid with gold, both the inner and outer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sanctuaries."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the entrance of the inner sanctuary he made doors "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " olive wood; the lintel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " doorposts "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or five-sided"
                        },
                        {
                            "style": "NONE",
                            "text": "one-fifth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the wall."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The two doors "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were of"
                        },
                        {
                            "style": "NONE",
                            "text": " olive wood; and he carved on them figures of cherubim, palm trees, and open flowers, and overlaid "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " with gold; and he spread gold on the cherubim and on the palm trees. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So for the door of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "temple"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctuary he also made doorposts "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " olive wood, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or four-sided"
                        },
                        {
                            "style": "NONE",
                            "text": "one-fourth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the wall."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the two doors "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were of"
                        },
                        {
                            "style": "NONE",
                            "text": " cypress wood; two panels "
                        },
                        {
                            "style": "ITALIC",
                            "text": "comprised"
                        },
                        {
                            "style": "NONE",
                            "text": " one folding door, and two panels "
                        },
                        {
                            "style": "ITALIC",
                            "text": "comprised"
                        },
                        {
                            "style": "NONE",
                            "text": " the other folding door. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he carved cherubim, palm trees, and open flowers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "on them,"
                        },
                        {
                            "style": "NONE",
                            "text": " and overlaid "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " with gold applied evenly on the carved work."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he built the inner court with three rows of hewn stone and a row of cedar beams."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the fourth year the foundation of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was laid, in the month of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Ayyar, April or May"
                        },
                        {
                            "style": "NONE",
                            "text": "Ziv. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in the eleventh year, in the month of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Heshvan, October or November"
                        },
                        {
                            "style": "NONE",
                            "text": "Bul, which is the eighth month, the house was finished in all its details and according to all its plans. So he was seven years in building it."
                        }
                    ]
                }
            ]
        }
    ]
}