{
    "chapter_num": 5,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Solomon Prepares to Build the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Hiram king of Tyre sent his servants to Solomon, because he heard that they had anointed him king in place of his father, for Hiram had always loved David. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon sent to Hiram, saying:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You know how my father David could not build a house for the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God because of the wars which were fought against him on every side, until the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " put "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. them"
                        },
                        {
                            "style": "ITALIC",
                            "text": "his foes"
                        },
                        {
                            "style": "NONE",
                            "text": " under the soles of his feet."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God has given me rest"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "peace"
                        },
                        {
                            "style": "NONE",
                            "text": " on every side; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " neither adversary nor "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "misfortune"
                        },
                        {
                            "style": "NONE",
                            "text": "evil occurrence."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. I am saying"
                        },
                        {
                            "style": "NONE",
                            "text": "I propose to build a house for the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to my father David, saying, “Your son, whom I will set on your throne in your place, he shall build the house for My name.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now therefore, command that they cut down cedars for me from Lebanon; and my servants will be with your servants, and I will pay you wages for your servants according to whatever you say. For you know "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " none among us who has skill to cut timber like the Sidonians."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it was, when Hiram heard the words of Solomon, that he rejoiced greatly and said,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " this day, for He has given David a wise son over this great people!"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Hiram sent to Solomon, saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "I have considered "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the message"
                        },
                        {
                            "style": "NONE",
                            "text": " which you sent me, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " I will do all you desire concerning the cedar and cypress logs."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "My servants shall bring "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " down from Lebanon to the sea; I will float them in rafts by sea to the place you indicate to me, and will have them broken apart there; then you can take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " away. And you shall fulfill my desire by giving food for my household."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Hiram gave Solomon cedar and cypress logs "
                        },
                        {
                            "style": "ITALIC",
                            "text": "according to"
                        },
                        {
                            "style": "NONE",
                            "text": " all his desire. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon gave Hiram twenty thousand "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Each about 5 bushels"
                        },
                        {
                            "style": "NONE",
                            "text": "kors of wheat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " food for his household, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX, Syr. twenty thousand kors"
                        },
                        {
                            "style": "NONE",
                            "text": "twenty kors of pressed oil. Thus Solomon gave to Hiram year by year."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " gave Solomon wisdom, as He had promised him; and there was peace between Hiram and Solomon, and the two of them made a treaty together."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then King Solomon raised up a labor force out of all Israel; and the labor force was thirty thousand men. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he sent them to Lebanon, ten thousand a month in shifts: they were one month in Lebanon "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " two months at home; Adoniram "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in charge of the labor force. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Solomon had seventy thousand who carried burdens, and eighty thousand who quarried "
                        },
                        {
                            "style": "ITALIC",
                            "text": "stone"
                        },
                        {
                            "style": "NONE",
                            "text": " in the mountains, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "besides three thousand "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX six hundred"
                        },
                        {
                            "style": "NONE",
                            "text": "three hundred from the chiefs of Solomon’s deputies, who supervised the people who labored in the work. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king commanded them to quarry large stones, costly stones, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " hewn stones, to lay the foundation of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Solomon’s builders, Hiram’s builders, and the Gebalites quarried "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them;"
                        },
                        {
                            "style": "NONE",
                            "text": " and they prepared timber and stones to build the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple."
                        }
                    ]
                }
            ]
        }
    ]
}