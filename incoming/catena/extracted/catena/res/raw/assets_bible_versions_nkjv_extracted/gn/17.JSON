{
    "chapter_num": 17,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Sign of the Covenant"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Abram was ninety-nine years old, the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " appeared to Abram and said to him, “I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. El Shaddai"
                        },
                        {
                            "style": "NONE",
                            "text": "Almighty God; walk before Me and be blameless. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will make My covenant between Me and you, and will multiply you exceedingly.” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Abram fell on his face, and God talked with him, saying: "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“As for Me, behold, My covenant is with you, and you shall be a father of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. a multitude of nations"
                        },
                        {
                            "style": "NONE",
                            "text": "many nations. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No longer shall your name be called "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Exalted Father"
                        },
                        {
                            "style": "NONE",
                            "text": "Abram, but your name shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Father of a Multitude"
                        },
                        {
                            "style": "NONE",
                            "text": "Abraham; for I have made you a father of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "a multitude of"
                        },
                        {
                            "style": "NONE",
                            "text": "many nations. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will make you exceedingly fruitful; and I will make nations of you, and kings shall come from you. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will establish My covenant between Me and you and your descendants after you in their generations, for an everlasting covenant, to be God to you and your descendants after you. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also I give to you and your descendants after you the land in"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. of your sojournings"
                        },
                        {
                            "style": "NONE",
                            "text": " which you are a stranger, all the land of Canaan, as an everlasting possession; and I will be their God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And God said to Abraham: “As for you, you shall keep My covenant, you and your descendants after you throughout their generations. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " My covenant which you shall keep, between Me and you and your descendants after you: Every male child among you shall be circumcised; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall be circumcised in the flesh of your foreskins, and it shall be a sign of the covenant between Me and you. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who is eight days old among you shall be circumcised, every male child in your generations, he who is born in your house or bought with money from any foreigner who is not your descendant. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who is born in your house and he who is bought with your money must be circumcised, and My covenant shall be in your flesh for an everlasting covenant. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the uncircumcised male child, who is not circumcised in the flesh of his foreskin, that person shall be cut off from his people; he has broken My covenant.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then God said to Abraham, “As for Sarai your wife, you shall not call her name Sarai, but "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Princess"
                        },
                        {
                            "style": "NONE",
                            "text": "Sarah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " her name. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will bless her and also give you a son by her; then I will bless her, and she shall be "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a mother"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " nations; kings of peoples shall be from her.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Abraham fell on his face and laughed, and said in his heart, “Shall "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a child"
                        },
                        {
                            "style": "NONE",
                            "text": " be born to a man who is one hundred years old? And shall Sarah, who is ninety years old, bear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a child?"
                        },
                        {
                            "style": "NONE",
                            "text": "” "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Abraham said to God, “Oh, that Ishmael might live before You!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then God said: “No, Sarah your wife shall bear you a son, and you shall call his name Isaac; I will establish My covenant with him for an everlasting covenant, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " with his descendants after him. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as for Ishmael, I have heard you. Behold, I have blessed him, and will make him fruitful, and will multiply him exceedingly. He shall beget twelve princes, and I will make him a great nation. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But My covenant I will establish with Isaac, whom Sarah shall bear to you at this set time next year.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He finished talking with him, and God went up from Abraham."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Abraham took Ishmael his son, all who were born in his house and all who were bought with his money, every male among the men of Abraham’s house, and circumcised the flesh of their foreskins that very same day, as God had said to him. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abraham "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " ninety-nine years old when he was circumcised in the flesh of his foreskin. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Ishmael his son "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " thirteen years old when he was circumcised in the flesh of his foreskin. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That very same day Abraham was circumcised, and his son Ishmael; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and all the men of his house, born in the house or bought with money from a foreigner, were circumcised with him."
                        }
                    ]
                }
            ]
        }
    ]
}