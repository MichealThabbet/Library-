{
    "chapter_num": 12,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Kings Conquered by Moses"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the kings of the land whom the children of Israel defeated, and whose land they possessed on the other side of the Jordan toward the rising of the sun, from the River Arnon to Mount Hermon, and all the eastern Jordan plain: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "One king was"
                        },
                        {
                            "style": "NONE",
                            "text": " Sihon king of the Amorites, who dwelt in Heshbon "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " ruled half of Gilead, from Aroer, which is on the bank of the River Arnon, from the middle of that river, even as far as the River Jabbok, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which is"
                        },
                        {
                            "style": "NONE",
                            "text": " the border of the Ammonites, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the eastern Jordan plain from the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Sea of Galilee"
                        },
                        {
                            "style": "NONE",
                            "text": "Sea of Chinneroth as far as the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Sea of the Plain, the Dead Sea"
                        },
                        {
                            "style": "NONE",
                            "text": "Sea of the Arabah (the Salt Sea), the road to Beth Jeshimoth, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Teman"
                        },
                        {
                            "style": "NONE",
                            "text": "southward below the"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Ashdoth Pisgah"
                        },
                        {
                            "style": "NONE",
                            "text": " slopes of Pisgah. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "The other king was"
                        },
                        {
                            "style": "NONE",
                            "text": " Og king of Bashan and his territory, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who was"
                        },
                        {
                            "style": "NONE",
                            "text": " of the remnant of the giants, who dwelt at Ashtaroth and at Edrei, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and reigned over Mount Hermon, over Salcah, over all Bashan, as far as the border of the Geshurites and the Maachathites, and over half of Gilead "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the border of Sihon king of Heshbon."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These Moses the servant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and the children of Israel had conquered; and Moses the servant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had given it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a possession to the Reubenites, the Gadites, and half the tribe of Manasseh."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Kings Conquered by Joshua"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the kings of the country which Joshua and the children of Israel conquered on this side of the Jordan, on the west, from Baal Gad in the Valley of Lebanon as far as "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. The Bald Mountain"
                        },
                        {
                            "style": "NONE",
                            "text": "Mount Halak and the ascent to Seir, which Joshua gave to the tribes of Israel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a possession according to their divisions, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in the mountain country, in the lowlands, in the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Jordan"
                        },
                        {
                            "style": "NONE",
                            "text": " plain, in the slopes, in the wilderness, and in the South—the Hittites, the Amorites, the Canaanites, the Perizzites, the Hivites, and the Jebusites: "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Jericho, one; the king of Ai, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " beside Bethel, one; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Jerusalem, one; the king of Hebron, one; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Jarmuth, one; the king of Lachish, one; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Eglon, one; the king of Gezer, one; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Debir, one; the king of Geder, one; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Hormah, one; the king of Arad, one; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Libnah, one; the king of Adullam, one; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Makkedah, one; the king of Bethel, one; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Tappuah, one; the king of Hepher, one; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Aphek, one; the king of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Sharon"
                        },
                        {
                            "style": "NONE",
                            "text": "Lasharon, one; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Madon, one; the king of Hazor, one; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Shimron Meron, one; the king of Achshaph, one; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Taanach, one; the king of Megiddo, one; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Kedesh, one; the king of Jokneam in Carmel, one; "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Dor in the heights of Dor, one; the king of the people of Gilgal, one; "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the king of Tirzah, one—all the kings, thirty-one."
                        }
                    ]
                }
            ]
        }
    ]
}