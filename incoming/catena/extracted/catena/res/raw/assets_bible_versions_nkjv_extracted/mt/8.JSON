{
    "chapter_num": 8,
    "verses_count": 34,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Jesus Cleanses a Leper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When He had come down from the mountain, great multitudes followed Him. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, a leper came and worshiped Him, saying, “Lord, if You are willing, You can make me clean.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus put out "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " hand and touched him, saying, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I am willing; be cleansed.”"
                        },
                        {
                            "style": "NONE",
                            "text": " Immediately his leprosy was cleansed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“See that you tell no one; but go your way, show yourself to the priest, and offer the gift that"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Moses"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "commanded, as a testimony to them.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Heals a Centurion’s Servant"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when Jesus had entered Capernaum, a centurion came to Him, pleading with Him, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "saying, “Lord, my servant is lying at home paralyzed, dreadfully tormented.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I will come and heal him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The centurion answered and said, “Lord, I am not worthy that You should come under my roof. But only speak a word, and my servant will be healed. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I also am a man under authority, having soldiers under me. And I say to this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one,"
                        },
                        {
                            "style": "NONE",
                            "text": " ‘Go,’ and he goes; and to another, ‘Come,’ and he comes; and to my servant, ‘Do this,’ and he does "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        },
                        {
                            "style": "NONE",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Jesus heard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " He marveled, and said to those who followed, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Assuredly, I say to you, I have not found such great faith, not even in Israel!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And I say to you that"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "many will come from east and west, and sit down with Abraham, Isaac, and Jacob in the kingdom of heaven."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the sons of the kingdom"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "will be cast out into outer darkness. There will be weeping and gnashing of teeth.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus said to the centurion, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Go your way; and as you have believed, so let it be done for you.”"
                        },
                        {
                            "style": "NONE",
                            "text": " And his servant was healed that same hour."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Peter’s Mother-in-Law Healed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when Jesus had come into Peter’s house, He saw his wife’s mother lying sick with a fever. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He touched her hand, and the fever left her. And she arose and served "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M Him"
                        },
                        {
                            "style": "NONE",
                            "text": "them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Many Healed in the Evening"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When evening had come, they brought to Him many who were demon-possessed. And He cast out the spirits with a word, and healed all who were sick, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that it might be fulfilled which was spoken by Isaiah the prophet, saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "He Himself took our infirmities"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And bore"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "sicknesses.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Cost of Discipleship"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Jesus saw great multitudes about Him, He gave a command to depart to the other side. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then a certain scribe came and said to Him, “Teacher, I will follow You wherever You go.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Foxes have holes and birds of the air have nests, but the Son of Man has nowhere to lay His head.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then another of His disciples said to Him, “Lord, let me first go and bury my father.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Follow Me, and let the dead bury their own dead.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Wind and Wave Obey Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when He got into a boat, His disciples followed Him. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And suddenly a great tempest arose on the sea, so that the boat was covered with the waves. But He was asleep. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then His disciples came to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " and awoke Him, saying, “Lord, save us! We are perishing!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Why are you fearful, O you of little faith?”"
                        },
                        {
                            "style": "NONE",
                            "text": " Then He arose and rebuked the winds and the sea, and there was a great calm. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the men marveled, saying, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. What sort of man is this"
                        },
                        {
                            "style": "NONE",
                            "text": "“Who can this be, that even the winds and the sea obey Him?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Two Demon-Possessed Men Healed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When He had come to the other side, to the country of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Gadarenes"
                        },
                        {
                            "style": "NONE",
                            "text": "Gergesenes, there met Him two demon-possessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "men,"
                        },
                        {
                            "style": "NONE",
                            "text": " coming out of the tombs, exceedingly fierce, so that no one could pass that way. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And suddenly they cried out, saying, “What have we to do with You, Jesus, You Son of God? Have You come here to torment us before the time?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now a good way off from them there was a herd of many swine feeding. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the demons begged Him, saying, “If You cast us out, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU send us into"
                        },
                        {
                            "style": "NONE",
                            "text": "permit us to go away into the herd of swine.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Go.”"
                        },
                        {
                            "style": "NONE",
                            "text": " So when they had come out, they went into the herd of swine. And suddenly the whole herd of swine ran violently down the steep place into the sea, and perished in the water."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then those who kept "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " fled; and they went away into the city and told everything, including what "
                        },
                        {
                            "style": "ITALIC",
                            "text": "had happened"
                        },
                        {
                            "style": "NONE",
                            "text": " to the demon-possessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "men."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, the whole city came out to meet Jesus. And when they saw Him, they begged "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " to depart from their region."
                        }
                    ]
                }
            ]
        }
    ]
}