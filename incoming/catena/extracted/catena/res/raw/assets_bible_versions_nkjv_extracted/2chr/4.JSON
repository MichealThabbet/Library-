{
    "chapter_num": 4,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Furnishings of the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover he made a bronze altar: twenty cubits was its length, twenty cubits its width, and ten cubits its height."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he made the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Great laver or basin"
                        },
                        {
                            "style": "NONE",
                            "text": "Sea of cast "
                        },
                        {
                            "style": "ITALIC",
                            "text": "bronze,"
                        },
                        {
                            "style": "NONE",
                            "text": " ten cubits from one brim to the other; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it was"
                        },
                        {
                            "style": "NONE",
                            "text": " completely round. Its height "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits, and a line of thirty cubits measured its circumference. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And under it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the likeness of oxen encircling it all around, ten to a cubit, all the way around the Sea. The oxen "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " cast in two rows, when it was cast. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It stood on twelve oxen: three looking toward the north, three looking toward the west, three looking toward the south, and three looking toward the east; the Sea "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was set"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them, and all their back parts "
                        },
                        {
                            "style": "ITALIC",
                            "text": "pointed"
                        },
                        {
                            "style": "NONE",
                            "text": " inward. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a handbreadth thick; and its brim was shaped like the brim of a cup, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " a lily blossom. It contained "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "About 8,000 gallons; two thousand, 1 Kin. 7:26"
                        },
                        {
                            "style": "NONE",
                            "text": "three thousand baths."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made ten lavers, and put five on the right side and five on the left, to wash in them; such things as they offered for the burnt offering they would wash in them, but the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Great basin"
                        },
                        {
                            "style": "NONE",
                            "text": "Sea "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " for the priests to wash in. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made ten lampstands of gold according to their design, and set "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " in the temple, five on the right side and five on the left. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made ten tables, and placed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " in the temple, five on the right side and five on the left. And he made one hundred bowls of gold."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Furthermore he made the court of the priests, and the great court and doors for the court; and he overlaid these doors with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He set the Sea on the right side, toward the southeast."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Huram made the pots and the shovels and the bowls. So Huram finished doing the work that he was to do for King Solomon for the house of God: "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the two pillars and the bowl-shaped capitals "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that were"
                        },
                        {
                            "style": "NONE",
                            "text": " on top of the two pillars; the two networks covering the two bowl-shaped capitals which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " on top of the pillars; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "four hundred pomegranates for the two networks (two rows of pomegranates for each network, to cover the two bowl-shaped capitals that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " on the pillars); "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he also made carts and the lavers on the carts; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one Sea and twelve oxen under it; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also the pots, the shovels, the forks—and all their articles Huram his "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. father"
                        },
                        {
                            "style": "NONE",
                            "text": "master "
                        },
                        {
                            "style": "ITALIC",
                            "text": "craftsman"
                        },
                        {
                            "style": "NONE",
                            "text": " made of burnished bronze for King Solomon for the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the plain of Jordan the king had them cast in clay molds, between Succoth and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Zaretan, 1 Kin. 7:46"
                        },
                        {
                            "style": "NONE",
                            "text": "Zeredah. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon had all these articles made in such great abundance that the weight of the bronze was not determined."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus Solomon had all the furnishings made for the house of God: the altar of gold and the tables on which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the showbread; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the lampstands with their lamps of pure gold, to burn in the prescribed manner in front of the inner sanctuary, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with the flowers and the lamps and the wick-trimmers of gold, of purest gold; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the trimmers, the bowls, the ladles, and the censers of pure gold. As for the entry of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctuary, its inner doors to the Most Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place,"
                        },
                        {
                            "style": "NONE",
                            "text": " and the doors of the main hall of the temple, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " gold."
                        }
                    ]
                }
            ]
        }
    ]
}