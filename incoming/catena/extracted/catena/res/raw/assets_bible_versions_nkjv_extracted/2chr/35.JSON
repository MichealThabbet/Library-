{
    "chapter_num": 35,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Josiah Keeps the Passover"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Josiah kept a Passover to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " in Jerusalem, and they slaughtered the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lambs"
                        },
                        {
                            "style": "NONE",
                            "text": " on the fourteenth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the first month. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he set the priests in their duties and encouraged them for the service of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to the Levites who taught all Israel, who were holy to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": “Put the holy ark in the house which Solomon the son of David, king of Israel, built. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It shall"
                        },
                        {
                            "style": "NONE",
                            "text": " no longer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " a burden on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " shoulders. Now serve the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God and His people Israel. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Prepare "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yourselves"
                        },
                        {
                            "style": "NONE",
                            "text": " according to your fathers’ "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "households"
                        },
                        {
                            "style": "NONE",
                            "text": "houses, according to your divisions, following the written instruction of David king of Israel and the written instruction of Solomon his son. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And stand in the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": " according to the divisions of the fathers’ houses of your brethren the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lay"
                        },
                        {
                            "style": "NONE",
                            "text": " people, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "according to"
                        },
                        {
                            "style": "NONE",
                            "text": " the division of the father’s house of the Levites. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So slaughter the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings,"
                        },
                        {
                            "style": "NONE",
                            "text": " consecrate yourselves, and prepare "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " for your brethren, that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they"
                        },
                        {
                            "style": "NONE",
                            "text": " may do according to the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " by the hand of Moses.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Josiah gave the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lay"
                        },
                        {
                            "style": "NONE",
                            "text": " people lambs and young goats from the flock, all for Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings"
                        },
                        {
                            "style": "NONE",
                            "text": " for all who were present, to the number of thirty thousand, as well as three thousand cattle; these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " from the king’s possessions. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And his leaders gave willingly to the people, to the priests, and to the Levites. Hilkiah, Zechariah, and Jehiel, rulers of the house of God, gave to the priests for the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings"
                        },
                        {
                            "style": "NONE",
                            "text": " two thousand six hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from the flock,"
                        },
                        {
                            "style": "NONE",
                            "text": " and three hundred cattle. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also Conaniah, his brothers Shemaiah and Nethanel, and Hashabiah and Jeiel and Jozabad, chief of the Levites, gave to the Levites for Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings"
                        },
                        {
                            "style": "NONE",
                            "text": " five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from the flock"
                        },
                        {
                            "style": "NONE",
                            "text": " and five hundred cattle."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the service was prepared, and the priests stood in their places, and the Levites in their divisions, according to the king’s command. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they slaughtered the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings;"
                        },
                        {
                            "style": "NONE",
                            "text": " and the priests sprinkled "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the blood"
                        },
                        {
                            "style": "NONE",
                            "text": " with their hands, while the Levites skinned "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the animals."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they removed the burnt offerings that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they"
                        },
                        {
                            "style": "NONE",
                            "text": " might give them to the divisions of the fathers’ houses of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lay"
                        },
                        {
                            "style": "NONE",
                            "text": " people, to offer to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the Book of Moses. And so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they did"
                        },
                        {
                            "style": "NONE",
                            "text": " with the cattle. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also they roasted the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings"
                        },
                        {
                            "style": "NONE",
                            "text": " with fire according to the ordinance; but the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offerings"
                        },
                        {
                            "style": "NONE",
                            "text": " they boiled in pots, in caldrons, and in pans, and divided "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " quickly among all the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lay"
                        },
                        {
                            "style": "NONE",
                            "text": " people. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then afterward they prepared portions for themselves and for the priests, because the priests, the sons of Aaron, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were busy"
                        },
                        {
                            "style": "NONE",
                            "text": " in offering burnt offerings and fat until night; therefore the Levites prepared portions for themselves and for the priests, the sons of Aaron. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the singers, the sons of Asaph, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in their places, according to the command of David, Asaph, Heman, and Jeduthun the king’s seer. Also the gatekeepers were at each gate; they did not have to leave their position, because their brethren the Levites prepared portions for them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all the service of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was prepared the same day, to keep the Passover and to offer burnt offerings on the altar of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", according to the command of King Josiah. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the children of Israel who were present kept the Passover at that time, and the Feast of Unleavened Bread for seven days. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There had been no Passover kept in Israel like that since the days of Samuel the prophet; and none of the kings of Israel had kept such a Passover as Josiah kept, with the priests and the Levites, all Judah and Israel who were present, and the inhabitants of Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the eighteenth year of the reign of Josiah this Passover was kept."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Josiah Dies in Battle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After all this, when Josiah had prepared the temple, Necho king of Egypt came up to fight against Carchemish by the Euphrates; and Josiah went out against him. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he sent messengers to him, saying, “What have I to do with you, king of Judah? "
                        },
                        {
                            "style": "ITALIC",
                            "text": "I have"
                        },
                        {
                            "style": "NONE",
                            "text": " not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "come"
                        },
                        {
                            "style": "NONE",
                            "text": " against you this day, but against the house with which I have war; for God commanded me to make haste. Refrain "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from meddling with"
                        },
                        {
                            "style": "NONE",
                            "text": " God, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " with me, lest He destroy you.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless Josiah would not turn his face from him, but disguised himself so that he might fight with him, and did not heed the words of Necho from the mouth of God. So he came to fight in the Valley of Megiddo."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the archers shot King Josiah; and the king said to his servants, “Take me away, for I am severely wounded.” "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His servants therefore took him out of that chariot and put him in the second chariot that he had, and they brought him to Jerusalem. So he died, and was buried in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one of"
                        },
                        {
                            "style": "NONE",
                            "text": " the tombs of his fathers. And all Judah and Jerusalem mourned for Josiah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jeremiah also lamented for Josiah. And to this day all the singing men and the singing women speak of Josiah in their lamentations. They made it a custom in Israel; and indeed they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the Laments."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the rest of the acts of Josiah and his goodness, according to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "what was"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the Law of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and his deeds from first to last, indeed they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the book of the kings of Israel and Judah."
                        }
                    ]
                }
            ]
        }
    ]
}