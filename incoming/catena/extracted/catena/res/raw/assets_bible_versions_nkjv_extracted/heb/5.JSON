{
    "chapter_num": 5,
    "verses_count": 14,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Qualifications for High Priesthood"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For every high priest taken from among men is appointed for men in things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "pertaining"
                        },
                        {
                            "style": "NONE",
                            "text": " to God, that he may offer both gifts and sacrifices for sins. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He can "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "deal gently with"
                        },
                        {
                            "style": "NONE",
                            "text": "have compassion on those who are ignorant and going astray, since he himself is also subject to weakness. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because of this he is required as for the people, so also for himself, to offer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sacrifices"
                        },
                        {
                            "style": "NONE",
                            "text": " for sins. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And no man takes this honor to himself, but he who is called by God, just as Aaron "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Priest Forever"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So also Christ did not glorify Himself to become High Priest, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it was"
                        },
                        {
                            "style": "NONE",
                            "text": " He who said to Him:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“You are My Son,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Today I have begotten You.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As "
                        },
                        {
                            "style": "ITALIC",
                            "text": "He"
                        },
                        {
                            "style": "NONE",
                            "text": " also says in another "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“You"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "a priest forever"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "According to the order of Melchizedek”"
                        },
                        {
                            "style": "NONE",
                            "text": ";"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who, in the days of His flesh, when He had offered up prayers and supplications, with vehement cries and tears to Him who was able to save Him from death, and was heard because of His godly fear, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "though He was a Son, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yet"
                        },
                        {
                            "style": "NONE",
                            "text": " He learned obedience by the things which He suffered. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And having been perfected, He became the author of eternal salvation to all who obey Him, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "called by God as High Priest "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“according to the order of Melchizedek,”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of whom we have much to say, and hard to explain, since you have become dull of hearing."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Spiritual Immaturity"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For though by this time you ought to be teachers, you need "
                        },
                        {
                            "style": "ITALIC",
                            "text": "someone"
                        },
                        {
                            "style": "NONE",
                            "text": " to teach you again the first principles of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sayings, Scriptures"
                        },
                        {
                            "style": "NONE",
                            "text": "oracles of God; and you have come to need milk and not solid food. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For everyone who partakes "
                        },
                        {
                            "style": "ITALIC",
                            "text": "only"
                        },
                        {
                            "style": "NONE",
                            "text": " of milk "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " unskilled in the word of righteousness, for he is a babe. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But solid food belongs to those who are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "mature"
                        },
                        {
                            "style": "NONE",
                            "text": "of full age, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " those who by reason of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "practice"
                        },
                        {
                            "style": "NONE",
                            "text": "use have their senses exercised to discern both good and evil."
                        }
                    ]
                }
            ]
        }
    ]
}