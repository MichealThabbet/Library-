            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the servants of David had come to Abigail at Carmel, they spoke to her saying, “David sent us to you, to ask you to become his wife.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
