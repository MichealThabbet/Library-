{
    "chapter_num": 27,
    "verses_count": 34,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Military Divisions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the children of Israel, according to their number, the heads of fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " the captains of thousands and hundreds and their officers, served the king in every matter of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "military"
                        },
                        {
                            "style": "NONE",
                            "text": " divisions. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "These divisions"
                        },
                        {
                            "style": "NONE",
                            "text": " came in and went out month by month throughout all the months of the year, each division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "having"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Over the first division for the first month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Jashobeam the son of Zabdiel, and in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "he was"
                        },
                        {
                            "style": "NONE",
                            "text": " of the children of Perez, and the chief of all the captains of the army for the first month. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Over the division of the second month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Dodai, usually spelled Dodo, 2 Sam. 23:9"
                        },
                        {
                            "style": "NONE",
                            "text": "Dodai an Ahohite, and of his division Mikloth also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the leader; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The third captain of the army for the third month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Benaiah, the son of Jehoiada the priest, who was chief; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This was the Benaiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who was"
                        },
                        {
                            "style": "NONE",
                            "text": " mighty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "among"
                        },
                        {
                            "style": "NONE",
                            "text": " the thirty, and was over the thirty; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Ammizabad his son. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fourth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the fourth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Asahel the brother of Joab, and Zebadiah his son after him; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fifth captain for the fifth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shammah, 2 Sam. 23:11, or Shammoth, 1 Chr. 11:27"
                        },
                        {
                            "style": "NONE",
                            "text": "Shamhuth the Izrahite; in his division were twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sixth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the sixth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Ira the son of Ikkesh the Tekoite; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The seventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the seventh month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Helez the Pelonite, of the children of Ephraim; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The eighth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the eighth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Sibbechai the Hushathite, of the Zarhites; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The ninth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the ninth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Abiezer the Anathothite, of the Benjamites; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The tenth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the tenth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Maharai the Netophathite, of the Zarhites; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The eleventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the eleventh month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Benaiah the Pirathonite, of the children of Ephraim; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The twelfth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "captain"
                        },
                        {
                            "style": "NONE",
                            "text": " for the twelfth month "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heleb, 2 Sam. 23:29, or Heled, 1 Chr. 11:30"
                        },
                        {
                            "style": "NONE",
                            "text": "Heldai the Netophathite, of Othniel; in his division "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thousand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Leaders of Tribes"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Furthermore, over the tribes of Israel: the officer over the Reubenites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Eliezer the son of Zichri; over the Simeonites, Shephatiah the son of Maachah; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " the Levites, Hashabiah the son of Kemuel; over the Aaronites, Zadok; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Judah, Elihu, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " of David’s brothers; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Issachar, Omri the son of Michael; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Zebulun, Ishmaiah the son of Obadiah; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Naphtali, Jerimoth the son of Azriel; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " the children of Ephraim, Hoshea the son of Azaziah; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " the half-tribe of Manasseh, Joel the son of Pedaiah; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " the half-"
                        },
                        {
                            "style": "ITALIC",
                            "text": "tribe"
                        },
                        {
                            "style": "NONE",
                            "text": " of Manasseh in Gilead, Iddo the son of Zechariah; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Benjamin, Jaasiel the son of Abner; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "over"
                        },
                        {
                            "style": "NONE",
                            "text": " Dan, Azarel the son of Jeroham. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the leaders of the tribes of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But David did not take the number of those twenty years old and under, because the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had said He would multiply Israel like the stars of the heavens. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joab the son of Zeruiah began a census, but he did not finish, for wrath came upon Israel because of this census; nor was the number recorded in the account of the chronicles of King David."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Other State Officials"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Azmaveth the son of Adiel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the king’s treasuries; and Jehonathan the son of Uzziah was over the storehouses in the field, in the cities, in the villages, and in the fortresses. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ezri the son of Chelub was over those who did the work of the field for tilling the ground. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Shimei the Ramathite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the vineyards, and Zabdi the Shiphmite was over the produce of the vineyards for the supply of wine. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Baal-Hanan the Gederite was over the olive trees and the sycamore trees that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the lowlands, and Joash "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the store of oil. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Shitrai the Sharonite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the herds that fed in Sharon, and Shaphat the son of Adlai was over the herds "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the valleys. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Obil the Ishmaelite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the camels, Jehdeiah the Meronothite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the donkeys, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Jaziz the Hagrite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the flocks. All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the officials over King David’s property."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also Jehonathan, David’s uncle, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a counselor, a wise man, and a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "secretary"
                        },
                        {
                            "style": "NONE",
                            "text": "scribe; and Jehiel the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Hachmonite"
                        },
                        {
                            "style": "NONE",
                            "text": "son of Hachmoni "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " with the king’s sons. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahithophel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the king’s counselor, and Hushai the Archite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the king’s companion. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After Ahithophel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Jehoiada the son of Benaiah, then Abiathar. And the general of the king’s army "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Joab."
                        }
                    ]
                }
            ]
        }
    ]
}