{
    "chapter_num": 18,
    "verses_count": 17,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "David’s Further Conquests"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After this it came to pass that David "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. struck"
                        },
                        {
                            "style": "NONE",
                            "text": "attacked the Philistines, subdued them, and took Gath and its towns from the hand of the Philistines. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. struck"
                        },
                        {
                            "style": "NONE",
                            "text": "defeated Moab, and the Moabites became David’s servants, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " brought tribute."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. struck"
                        },
                        {
                            "style": "NONE",
                            "text": "defeated "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Hadarezer"
                        },
                        {
                            "style": "NONE",
                            "text": "Hadadezer king of Zobah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as far as"
                        },
                        {
                            "style": "NONE",
                            "text": " Hamath, as he went to establish his power by the River Euphrates. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David took from him one thousand chariots, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "seven hundred, 2 Sam. 8:4"
                        },
                        {
                            "style": "NONE",
                            "text": "seven thousand horsemen, and twenty thousand foot soldiers. Also David "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "crippled"
                        },
                        {
                            "style": "NONE",
                            "text": "hamstrung all the chariot "
                        },
                        {
                            "style": "ITALIC",
                            "text": "horses,"
                        },
                        {
                            "style": "NONE",
                            "text": " except that he spared enough of them for one hundred chariots."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the Syrians of Damascus came to help Hadadezer king of Zobah, David killed twenty-two thousand of the Syrians. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then David put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "garrisons"
                        },
                        {
                            "style": "NONE",
                            "text": " in Syria of Damascus; and the Syrians became David’s servants, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " brought tribute. So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " preserved David wherever he went. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David took the shields of gold that were on the servants of Hadadezer, and brought them to Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also from "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Betah, 2 Sam. 8:8"
                        },
                        {
                            "style": "NONE",
                            "text": "Tibhath and from "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Berothai, 2 Sam. 8:8"
                        },
                        {
                            "style": "NONE",
                            "text": "Chun, cities of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Hadarezer"
                        },
                        {
                            "style": "NONE",
                            "text": "Hadadezer, David brought a large amount of bronze, with which Solomon made the bronze "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Great laver or basin"
                        },
                        {
                            "style": "NONE",
                            "text": "Sea, the pillars, and the articles of bronze."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Toi, 2 Sam. 8:9, 10"
                        },
                        {
                            "style": "NONE",
                            "text": "Tou king of Hamath heard that David had "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. struck"
                        },
                        {
                            "style": "NONE",
                            "text": "defeated all the army of Hadadezer king of Zobah, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he sent "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Joram, 2 Sam. 8:10"
                        },
                        {
                            "style": "NONE",
                            "text": "Hadoram his son to King David, to greet him and bless him, because he had fought against Hadadezer and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. struck"
                        },
                        {
                            "style": "NONE",
                            "text": "defeated him (for Hadadezer had been at war with Tou); and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Hadoram brought with him"
                        },
                        {
                            "style": "NONE",
                            "text": " all kinds of articles of gold, silver, and bronze. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "King David also dedicated these to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", along with the silver and gold that he had brought from all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " nations—from Edom, from Moab, from the people of Ammon, from the Philistines, and from Amalek."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover Abishai the son of Zeruiah killed eighteen thousand "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Syrians, 2 Sam. 8:13"
                        },
                        {
                            "style": "NONE",
                            "text": "Edomites in the Valley of Salt. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also put garrisons in Edom, and all the Edomites became David’s servants. And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " preserved David wherever he went."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "David’s Administration"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So David reigned over all Israel, and administered judgment and justice to all his people. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joab the son of Zeruiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the army; Jehoshaphat the son of Ahilud "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " recorder; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zadok the son of Ahitub and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ahimelech, 2 Sam. 8:17"
                        },
                        {
                            "style": "NONE",
                            "text": "Abimelech the son of Abiathar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the priests; "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Seraiah, 2 Sam. 8:17, or Shisha, 1 Kin. 4:3"
                        },
                        {
                            "style": "NONE",
                            "text": "Shavsha "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the scribe; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Benaiah the son of Jehoiada "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the Cherethites and the Pelethites; and David’s sons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. at the hand of the king"
                        },
                        {
                            "style": "NONE",
                            "text": "chief ministers at the king’s side."
                        }
                    ]
                }
            ]
        }
    ]
}