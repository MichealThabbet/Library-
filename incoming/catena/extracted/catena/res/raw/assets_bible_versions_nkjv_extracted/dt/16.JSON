{
    "chapter_num": 16,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Passover Reviewed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Observe the month of Abib, and keep the Passover to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, for in the month of Abib the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God brought you out of Egypt by night. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you shall sacrifice the Passover to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, from the flock and the herd, in the place where the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " chooses to put His name. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall eat no leavened bread with it; seven days you shall eat unleavened bread with it, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " the bread of affliction (for you came out of the land of Egypt in haste), that you may remember the day in which you came out of the land of Egypt all the days of your life. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And no leaven shall be seen among you in all your territory for seven days, nor shall "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " of the meat which you sacrifice the first day at twilight remain overnight until morning."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You may not sacrifice the Passover within any of your gates which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but at the place where the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chooses to make His name abide, there you shall sacrifice the Passover at twilight, at the going down of the sun, at the time you came out of Egypt. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall roast and eat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " in the place which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chooses, and in the morning you shall turn and go to your tents. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Six days you shall eat unleavened bread, and on the seventh day there "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. restraint"
                        },
                        {
                            "style": "NONE",
                            "text": "sacred assembly to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. You shall do no work "
                        },
                        {
                            "style": "ITALIC",
                            "text": "on it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Feast of Weeks Reviewed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall count seven weeks for yourself; begin to count the seven weeks from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the time"
                        },
                        {
                            "style": "NONE",
                            "text": " you begin "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to put"
                        },
                        {
                            "style": "NONE",
                            "text": " the sickle to the grain. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall keep the Feast of Weeks to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God with the tribute of a freewill offering from your hand, which you shall give as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God blesses you. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall rejoice before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, you and your son and your daughter, your male servant and your female servant, the Levite who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " within your gates, the stranger and the fatherless and the widow who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " among you, at the place where the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chooses to make His name abide. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall remember that you were a slave in Egypt, and you shall be careful to observe these statutes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Feast of Tabernacles Reviewed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall observe the Feast of Tabernacles seven days, when you have gathered from your threshing floor and from your winepress. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall rejoice in your feast, you and your son and your daughter, your male servant and your female servant and the Levite, the stranger and the fatherless and the widow, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " within your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "towns"
                        },
                        {
                            "style": "NONE",
                            "text": "gates. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Seven days you shall keep a sacred feast to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God in the place which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " chooses, because the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will bless you in all your produce and in all the work of your hands, so that you surely rejoice."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Three times a year all your males shall appear before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God in the place which He chooses: at the Feast of Unleavened Bread, at the Feast of Weeks, and at the Feast of Tabernacles; and they shall not appear before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " empty-handed. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall give"
                        },
                        {
                            "style": "NONE",
                            "text": " as he is able, according to the blessing of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God which He has given you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Justice Must Be Administered"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall appoint judges and officers in all your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "towns"
                        },
                        {
                            "style": "NONE",
                            "text": "gates, which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you, according to your tribes, and they shall judge the people with just judgment. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not pervert justice; you shall not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. regard faces"
                        },
                        {
                            "style": "NONE",
                            "text": "show partiality, nor take a bribe, for a bribe blinds the eyes of the wise and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perverts"
                        },
                        {
                            "style": "NONE",
                            "text": "twists the words of the righteous. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall follow what is altogether just, that you may live and inherit the land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not plant for yourself any tree, as a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Asherah"
                        },
                        {
                            "style": "NONE",
                            "text": "wooden image, near the altar which you build for yourself to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not set up a "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": " pillar, which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God hates."
                        }
                    ]
                }
            ]
        }
    ]
}