{
    "chapter_num": 4,
    "verses_count": 49,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Moses Commands Obedience"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now, O Israel, listen to the statutes and the judgments which I teach you to observe, that you may live, and go in and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "take possession of"
                        },
                        {
                            "style": "NONE",
                            "text": "possess the land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of your fathers is giving you. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not add to the word which I command you, nor take from it, that you may keep the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God which I command you. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your eyes have seen what the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " did at Baal Peor; for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has destroyed from among you all the men who followed Baal of Peor. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But you who held fast to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " alive today, every one of you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Surely I have taught you statutes and judgments, just as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God commanded me, that you should act according "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to them"
                        },
                        {
                            "style": "NONE",
                            "text": " in the land which you go to possess. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore be careful to observe "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them;"
                        },
                        {
                            "style": "NONE",
                            "text": " for this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " your wisdom and your understanding in the sight of the peoples who will hear all these statutes, and say, ‘Surely this great nation "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a wise and understanding people.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For what great nation "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is there"
                        },
                        {
                            "style": "NONE",
                            "text": " that has God"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or a god"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "so"
                        },
                        {
                            "style": "NONE",
                            "text": " near to it, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " to us, for whatever "
                        },
                        {
                            "style": "ITALIC",
                            "text": "reason"
                        },
                        {
                            "style": "NONE",
                            "text": " we may call upon Him? "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And what great nation "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is there"
                        },
                        {
                            "style": "NONE",
                            "text": " that has "
                        },
                        {
                            "style": "ITALIC",
                            "text": "such"
                        },
                        {
                            "style": "NONE",
                            "text": " statutes and righteous judgments as are in all this law which I set before you this day? "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Only take heed to yourself, and diligently keep yourself, lest you forget the things your eyes have seen, and lest they depart from your heart all the days of your life. And teach them to your children and your grandchildren, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "especially concerning"
                        },
                        {
                            "style": "NONE",
                            "text": " the day you stood before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God in Horeb, when the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to me, ‘Gather the people to Me, and I will let them hear My words, that they may learn to fear Me all the days they live on the earth, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " they may teach their children.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then you came near and stood at the foot of the mountain, and the mountain burned with fire to the midst of heaven, with darkness, cloud, and thick darkness. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to you out of the midst of the fire. You heard the sound of the words, but saw no "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "similitude"
                        },
                        {
                            "style": "NONE",
                            "text": "form; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " only "
                        },
                        {
                            "style": "ITALIC",
                            "text": "heard"
                        },
                        {
                            "style": "NONE",
                            "text": " a voice. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He declared to you His covenant which He commanded you to perform, the Ten Commandments; and He wrote them on two tablets of stone. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded me at that time to teach you statutes and judgments, that you might "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "do or perform"
                        },
                        {
                            "style": "NONE",
                            "text": "observe them in the land which you cross over to possess."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Beware of Idolatry"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Take careful heed to yourselves, for you saw no form when the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to you at Horeb out of the midst of the fire, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest you act corruptly and make for yourselves a carved image in the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "similitude"
                        },
                        {
                            "style": "NONE",
                            "text": "form of any figure: the likeness of male or female, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the likeness of any animal that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the earth or the likeness of any winged bird that flies in the air, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the likeness of anything that creeps on the ground or the likeness of any fish that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in the water beneath the earth. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "take heed,"
                        },
                        {
                            "style": "NONE",
                            "text": " lest you lift your eyes to heaven, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "when"
                        },
                        {
                            "style": "NONE",
                            "text": " you see the sun, the moon, and the stars, all the host of heaven, you feel driven to worship them and serve them, which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "divided"
                        },
                        {
                            "style": "NONE",
                            "text": "given to all the peoples under the whole heaven as a heritage. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has taken you and brought you out of the iron furnace, out of Egypt, to be His people, an inheritance, as you are this day. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Furthermore the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was angry with me for your sakes, and swore that I would not cross over the Jordan, and that I would not enter the good land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you as an inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I must die in this land, I must not cross over the Jordan; but you shall cross over and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "take possession of"
                        },
                        {
                            "style": "NONE",
                            "text": "possess that good land. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Take heed to yourselves, lest you forget the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God which He made with you, and make for yourselves a carved image in the form of anything which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has forbidden you. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a consuming fire, a jealous God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When you beget children and grandchildren and have grown old in the land, and act corruptly and make a carved image in the form of anything, and do evil in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God to provoke Him to anger, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I call heaven and earth to witness against you this day, that you will soon utterly perish from the land which you cross over the Jordan to possess; you will not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "live long on it"
                        },
                        {
                            "style": "NONE",
                            "text": "prolong "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " days in it, but will be utterly destroyed. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " will scatter you among the peoples, and you will be left few in number among the nations where the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " will drive you. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there you will serve gods, the work of men’s hands, wood and stone, which neither see nor hear nor eat nor smell. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But from there you will seek the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, and you will find "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " if you seek Him with all your heart and with all your soul. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When you are in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "tribulation"
                        },
                        {
                            "style": "NONE",
                            "text": "distress, and all these things come upon you in the latter days, when you turn to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God and obey His voice "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a merciful God), He will not forsake you nor destroy you, nor forget the covenant of your fathers which He swore to them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For ask now concerning the days that are past, which were before you, since the day that God created man on the earth, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ask"
                        },
                        {
                            "style": "NONE",
                            "text": " from one end of heaven to the other, whether "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " great "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thing"
                        },
                        {
                            "style": "NONE",
                            "text": " like this has happened, or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "anything"
                        },
                        {
                            "style": "NONE",
                            "text": " like it has been heard. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Did "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " people "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ever"
                        },
                        {
                            "style": "NONE",
                            "text": " hear the voice of God speaking out of the midst of the fire, as you have heard, and live? "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Or did God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ever"
                        },
                        {
                            "style": "NONE",
                            "text": " try to go "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " take for Himself a nation from the midst of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "another"
                        },
                        {
                            "style": "NONE",
                            "text": " nation, by trials, by signs, by wonders, by war, by a mighty hand and an outstretched arm, and by great "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "calamities"
                        },
                        {
                            "style": "NONE",
                            "text": "terrors, according to all that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God did for you in Egypt before your eyes? "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To you it was shown, that you might know that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " Himself "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " God; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " none other besides Him. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Out of heaven He let you hear His voice, that He might instruct you; on earth He showed you His great fire, and you heard His words out of the midst of the fire. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And because He loved your fathers, therefore He chose their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. seed"
                        },
                        {
                            "style": "NONE",
                            "text": "descendants after them; and He brought you out of Egypt with His Presence, with His mighty power, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "driving out from before you nations greater and mightier than you, to bring you in, to give you their land "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " an inheritance, as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " this day. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore know this day, and consider "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " in your heart, that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " Himself "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " God in heaven above and on the earth beneath; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " no other. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall therefore keep His statutes and His commandments which I command you today, that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "you may prosper"
                        },
                        {
                            "style": "NONE",
                            "text": "it may go well with you and with your children after you, and that you may "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "live long"
                        },
                        {
                            "style": "NONE",
                            "text": "prolong "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " days in the land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you for all time.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Cities of Refuge East of the Jordan"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses set apart three cities on this side of the Jordan, toward the rising of the sun, "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that the manslayer might flee there, who kills his neighbor unintentionally, without having hated him in time past, and that by fleeing to one of these cities he might live: "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bezer in the wilderness on the plateau for the Reubenites, Ramoth in Gilead for the Gadites, and Golan in Bashan for the Manassites."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Introduction to God’s Law"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law which Moses set before the children of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the testimonies, the statutes, and the judgments which Moses spoke to the children of Israel after they came out of Egypt, "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "on this side of the Jordan, in the valley opposite Beth Peor, in the land of Sihon king of the Amorites, who dwelt at Heshbon, whom Moses and the children of Israel defeated"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "struck"
                        },
                        {
                            "style": "NONE",
                            "text": " after they came out of Egypt. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they took possession of his land and the land of Og king of Bashan, two kings of the Amorites, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " on this side of the Jordan, toward the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "east"
                        },
                        {
                            "style": "NONE",
                            "text": "rising of the sun, "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from Aroer, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the bank of the River Arnon, even to Mount "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Syr. Sirion"
                        },
                        {
                            "style": "NONE",
                            "text": "Sion (that is, Hermon), "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and all the plain on the east side of the Jordan as far as the Sea of the Arabah, below the slopes of Pisgah."
                        }
                    ]
                }
            ]
        }
    ]
}