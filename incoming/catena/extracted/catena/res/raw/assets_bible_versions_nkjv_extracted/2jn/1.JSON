{
    "chapter_num": 1,
    "verses_count": 13,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting the Elect Lady"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Elder,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "chosen"
                        },
                        {
                            "style": "NONE",
                            "text": "elect lady and her children, whom I love in truth, and not only I, but also all those who have known the truth, "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because of the truth which abides in us and will be with us forever:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace, mercy, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " peace will be with "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M us"
                        },
                        {
                            "style": "NONE",
                            "text": "you from God the Father and from the Lord Jesus Christ, the Son of the Father, in truth and love."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Walk in Christ’s Commandments"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I rejoiced greatly that I have found "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of your children walking in truth, as we received commandment from the Father. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And now I plead with you, lady, not as though I wrote a new commandment to you, but that which we have had from the beginning: that we love one another. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is love, that we walk according to His commandments. This is the commandment, that as you have heard from the beginning, you should walk in it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Beware of Antichrist Deceivers"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For many deceivers have gone out into the world who do not confess Jesus Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " coming in the flesh. This is a deceiver and an antichrist. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Look to yourselves, that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU you"
                        },
                        {
                            "style": "NONE",
                            "text": "we do not lose those things we worked for, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " we may receive a full reward."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU goes ahead"
                        },
                        {
                            "style": "NONE",
                            "text": "transgresses and does not abide in the doctrine of Christ does not have God. He who abides in the doctrine of Christ has both the Father and the Son. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If anyone comes to you and does not bring this doctrine, do not receive him into your house nor greet him; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for he who greets him shares in his evil deeds."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "John’s Farewell Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Having many things to write to you, I did not wish "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to do so"
                        },
                        {
                            "style": "NONE",
                            "text": " with paper and ink; but I hope to come to you and speak face to face, that our joy may be full."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The children of your elect sister greet you. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}