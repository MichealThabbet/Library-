{
    "chapter_num": 20,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Empty Tomb"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the week Mary Magdalene went to the tomb early, while it was still dark, and saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " the stone had been taken away from the tomb. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then she ran and came to Simon Peter, and to the other disciple, whom Jesus loved, and said to them, “They have taken away the Lord out of the tomb, and we do not know where they have laid Him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Peter therefore went out, and the other disciple, and were going to the tomb. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they both ran together, and the other disciple outran Peter and came to the tomb first. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he, stooping down and looking in, saw the linen cloths lying "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there;"
                        },
                        {
                            "style": "NONE",
                            "text": " yet he did not go in. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Simon Peter came, following him, and went into the tomb; and he saw the linen cloths lying "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "face cloth"
                        },
                        {
                            "style": "NONE",
                            "text": "handkerchief that had been around His head, not lying with the linen cloths, but folded together in a place by itself. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the other disciple, who came to the tomb first, went in also; and he saw and believed. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as yet they did not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "understand"
                        },
                        {
                            "style": "NONE",
                            "text": "know the Scripture, that He must rise again from the dead. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the disciples went away again to their own homes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Mary Magdalene Sees the Risen Lord"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Mary stood outside by the tomb weeping, and as she wept she stooped down "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and looked"
                        },
                        {
                            "style": "NONE",
                            "text": " into the tomb. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And she saw two angels in white sitting, one at the head and the other at the feet, where the body of Jesus had lain. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they said to her, “Woman, why are you weeping?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "She said to them, “Because they have taken away my Lord, and I do not know where they have laid Him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when she had said this, she turned around and saw Jesus standing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there,"
                        },
                        {
                            "style": "NONE",
                            "text": " and did not know that it was Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to her, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Woman, why are you weeping? Whom are you seeking?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "She, supposing Him to be the gardener, said to Him, “Sir, if You have carried Him away, tell me where You have laid Him, and I will take Him away.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to her, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Mary!”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "She turned and said to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU adds in Hebrew"
                        },
                        {
                            "style": "NONE",
                            "text": "Him, “Rabboni!” (which is to say, Teacher)."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to her, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Do not cling to Me, for I have not yet"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "ascended to My Father; but go to"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "My brethren and say to them,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘I am ascending to My Father and your Father, and to"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "My God and your God.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Mary Magdalene came and told the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU disciples, “I have seen the Lord,”"
                        },
                        {
                            "style": "NONE",
                            "text": "disciples that she had seen the Lord, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " He had spoken these things to her."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Apostles Commissioned"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then, the same day at evening, being the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the week, when the doors were shut where the disciples were "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits assembled"
                        },
                        {
                            "style": "NONE",
                            "text": "assembled, for fear of the Jews, Jesus came and stood in the midst, and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Peace be with you.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When He had said this, He showed them "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " hands and His side. Then the disciples were glad when they saw the Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus said to them again, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Peace to you!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "As the Father has sent Me, I also send you.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when He had said this, He breathed on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them,"
                        },
                        {
                            "style": "NONE",
                            "text": " and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Receive the Holy Spirit."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If you forgive the sins of any, they are forgiven them; if you retain the sins of any, they are retained.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Seeing and Believing"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Thomas, called the Twin, one of the twelve, was not with them when Jesus came. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The other disciples therefore said to him, “We have seen the Lord.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So he said to them, “Unless I see in His hands the print of the nails, and put my finger into the print of the nails, and put my hand into His side, I will not believe.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And after eight days His disciples were again inside, and Thomas with them. Jesus came, the doors being shut, and stood in the midst, and said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Peace to you!”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He said to Thomas, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Reach your finger here, and look at My hands; and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "reach your hand here, and put it into My side. Do not be"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "unbelieving, but believing.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Thomas answered and said to Him, “My Lord and my God!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to him, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit Thomas"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Thomas, because you have seen Me, you have believed."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Blessed are those who have not seen and yet have believed.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "That You May Believe"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And truly Jesus did many other signs in the presence of His disciples, which are not written in this book; "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but these are written that you may believe that Jesus is the Christ, the Son of God, and that believing you may have life in His name."
                        }
                    ]
                }
            ]
        }
    ]
}