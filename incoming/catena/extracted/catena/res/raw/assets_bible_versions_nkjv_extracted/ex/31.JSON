{
    "chapter_num": 31,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Artisans for Building the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“See, I have called by name Bezalel the son of Uri, the son of Hur, of the tribe of Judah. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I have filled him with the Spirit of God, in wisdom, in understanding, in knowledge, and in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "manner of"
                        },
                        {
                            "style": "NONE",
                            "text": " workmanship, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to design artistic works, to work in gold, in silver, in bronze, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in cutting jewels for setting, in carving wood, and to work in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "manner of"
                        },
                        {
                            "style": "NONE",
                            "text": " workmanship."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And I, indeed I, have appointed with him Aholiab the son of Ahisamach, of the tribe of Dan; and I have put wisdom in the hearts of all the gifted artisans, that they may make all that I have commanded you: "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the tabernacle of meeting, the ark of the Testimony and the mercy seat that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on it, and all the furniture of the tabernacle— "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the table and its utensils, the pure "
                        },
                        {
                            "style": "ITALIC",
                            "text": "gold"
                        },
                        {
                            "style": "NONE",
                            "text": " lampstand with all its utensils, the altar of incense, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the altar of burnt offering with all its utensils, and the laver and its base— "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or woven garments"
                        },
                        {
                            "style": "NONE",
                            "text": "garments of ministry, the holy garments for Aaron the priest and the garments of his sons, to minister as priests, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the anointing oil and sweet incense for the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place."
                        },
                        {
                            "style": "NONE",
                            "text": " According to all that I have commanded you they shall do.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Sabbath Law"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak also to the children of Israel, saying: ‘Surely My Sabbaths you shall keep, for it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a sign between Me and you throughout your generations, that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " may know that I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " who sanctifies"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrates"
                        },
                        {
                            "style": "NONE",
                            "text": " you. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep the Sabbath, therefore, for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " holy to you. Everyone who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "defiles"
                        },
                        {
                            "style": "NONE",
                            "text": "profanes it shall surely be put to death; for whoever does "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " work on it, that person shall be cut off from among his people. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Work shall be done for six days, but the seventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the Sabbath of rest, holy to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Whoever does "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " work on the Sabbath day, he shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore the children of Israel shall keep the Sabbath, to observe the Sabbath throughout their generations "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a perpetual covenant. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a sign between Me and the children of Israel forever; for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " six days the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made the heavens and the earth, and on the seventh day He rested and was refreshed.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when He had made an end of speaking with him on Mount Sinai, He gave Moses two tablets of the Testimony, tablets of stone, written with the finger of God."
                        }
                    ]
                }
            ]
        }
    ]
}