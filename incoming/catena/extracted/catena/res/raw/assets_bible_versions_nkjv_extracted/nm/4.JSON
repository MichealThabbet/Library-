{
    "chapter_num": 4,
    "verses_count": 49,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Duties of the Sons of Kohath"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses and Aaron, saying: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Take a census of the sons of Kohath from among the children of Levi, by their families, by their fathers’ house, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from thirty years old and above, even to fifty years old, all who enter the service to do the work in the tabernacle of meeting."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the service of the sons of Kohath in the tabernacle of meeting, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "relating to"
                        },
                        {
                            "style": "NONE",
                            "text": " the most holy things: "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the camp prepares to journey, Aaron and his sons shall come, and they shall take down the covering veil and cover the ark of the Testimony with it. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they shall put on it a covering of badger skins, and spread over "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " a cloth entirely of blue; and they shall insert its poles."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the table of showbread they shall spread a blue cloth, and put on it the dishes, the pans, the bowls, and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "jars for the drink offering"
                        },
                        {
                            "style": "NONE",
                            "text": "pitchers for pouring; and the showbread"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. continual bread"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be on it. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall spread over them a scarlet cloth, and cover the same with a covering of badger skins; and they shall insert its poles. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they shall take a blue cloth and cover the lampstand of the light, with its lamps, its wick-trimmers, its trays, and all its oil vessels, with which they service it. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they shall put it with all its utensils in a covering of badger skins, and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on a carrying beam."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Over the golden altar they shall spread a blue cloth, and cover it with a covering of badger skins; and they shall insert its poles. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they shall take all the utensils of service with which they minister in the sanctuary, put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " in a blue cloth, cover them with a covering of badger skins, and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " on a carrying beam. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also they shall take away the ashes from the altar, and spread a purple cloth over it. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall put on it all its implements with which they minister there—the firepans, the forks, the shovels, the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "bowls"
                        },
                        {
                            "style": "NONE",
                            "text": "basins, and all the utensils of the altar—and they shall spread on it a covering of badger skins, and insert its poles. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Aaron and his sons have finished covering the sanctuary and all the furnishings of the sanctuary, when the camp is set to go, then the sons of Kohath shall come to carry "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them;"
                        },
                        {
                            "style": "NONE",
                            "text": " but they shall not touch any holy thing, lest they die."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the things in the tabernacle of meeting which the sons of Kohath are to carry."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The appointed duty of Eleazar the son of Aaron the priest "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the oil for the light, the sweet incense, the daily grain offering, the anointing oil, the oversight of all the tabernacle, of all that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in it, with the sanctuary and its furnishings.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses and Aaron, saying: "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Do not cut off the tribe of the families of the Kohathites from among the Levites; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but do this in regard to them, that they may live and not die when they approach the most holy things: Aaron and his sons shall go in and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "assign"
                        },
                        {
                            "style": "NONE",
                            "text": "appoint each of them to his service and his task. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they shall not go in to watch while the holy things are being covered, lest they die.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Duties of the Sons of Gershon"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Also take a census of the sons of Gershon, by their fathers’ house, by their families. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "From thirty years old and above, even to fifty years old, you shall number them, all who enter to perform the service, to do the work in the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the service of the families of the Gershonites, in serving and carrying: "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall carry the curtains of the tabernacle and the tabernacle of meeting "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " its covering, the covering of badger skins that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on it, the screen for the door of the tabernacle of meeting, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the screen for the door of the gate of the court, the hangings of the court which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " around the tabernacle and altar, and their cords, all the furnishings for their service and all that is made for these things: so shall they serve."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Aaron and his sons shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "command"
                        },
                        {
                            "style": "NONE",
                            "text": "assign all the service of the sons of the Gershonites, all their tasks and all their service. And you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "assign"
                        },
                        {
                            "style": "NONE",
                            "text": "appoint to them all their tasks as their duty. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the service of the families of the sons of Gershon in the tabernacle of meeting. And their duties "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " under the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. hand"
                        },
                        {
                            "style": "NONE",
                            "text": "authority of Ithamar the son of Aaron the priest."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Duties of the Sons of Merari"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "As for"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Merari, you shall number them by their families and by their fathers’ house. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "From thirty years old and above, even to fifty years old, you shall number them, everyone who enters the service to do the work of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " what they must carry as all their service for the tabernacle of meeting: the boards of the tabernacle, its bars, its pillars, its sockets, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the pillars around the court with their sockets, pegs, and cords, with all their furnishings and all their service; and you shall assign "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to each man"
                        },
                        {
                            "style": "NONE",
                            "text": " by name the items he must carry. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the service of the families of the sons of Merari, as all their service for the tabernacle of meeting, under the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. hand"
                        },
                        {
                            "style": "NONE",
                            "text": "authority of Ithamar the son of Aaron the priest.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Census of the Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Moses, Aaron, and the leaders of the congregation numbered the sons of the Kohathites by their families and by their fathers’ house, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from thirty years old and above, even to fifty years old, everyone who entered the service for work in the tabernacle of meeting; "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and those who were numbered by their families were two thousand seven hundred and fifty. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the ones who were numbered of the families of the Kohathites, all who might serve in the tabernacle of meeting, whom Moses and Aaron numbered according to the commandment of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " by the hand of Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those who were numbered of the sons of Gershon, by their families and by their fathers’ house, "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from thirty years old and above, even to fifty years old, everyone who entered the service for work in the tabernacle of meeting— "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "those who were numbered by their families, by their fathers’ house, were two thousand six hundred and thirty. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the ones who were numbered of the families of the sons of Gershon, of all who might serve in the tabernacle of meeting, whom Moses and Aaron numbered according to the commandment of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Those of the families of the sons of Merari who were numbered, by their families, by their fathers’ "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "household"
                        },
                        {
                            "style": "NONE",
                            "text": "house, "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from thirty years old and above, even to fifty years old, everyone who entered the service for work in the tabernacle of meeting— "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "those who were numbered by their families were three thousand two hundred. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the ones who were numbered of the families of the sons of Merari, whom Moses and Aaron numbered according to the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " by the hand of Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All who were numbered of the Levites, whom Moses, Aaron, and the leaders of Israel numbered, by their families and by their fathers’ houses, "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from thirty years old and above, even to fifty years old, everyone who came to do the work of service and the work of bearing burdens in the tabernacle of meeting— "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "those who were numbered were eight thousand five hundred and eighty."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "According to the commandment of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " they were numbered by the hand of Moses, each according to his service and according to his task; thus were they numbered by him, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses."
                        }
                    ]
                }
            ]
        }
    ]
}