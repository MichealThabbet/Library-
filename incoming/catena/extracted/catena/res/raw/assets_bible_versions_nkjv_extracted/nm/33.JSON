{
    "chapter_num": 33,
    "verses_count": 56,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Israel’s Journey from Egypt Reviewed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the journeys of the children of Israel, who went out of the land of Egypt by their armies under the hand of Moses and Aaron. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Moses wrote down the starting points of their journeys at the command of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". And these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " their journeys according to their starting points:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Rameses in the first month, on the fifteenth day of the first month; on the day after the Passover the children of Israel went out with boldness in the sight of all the Egyptians. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the Egyptians were burying all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " firstborn, whom the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had killed among them. Also on their gods the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had executed judgments."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the children of Israel moved from Rameses and camped at Succoth. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Succoth and camped at Etham, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the edge of the wilderness. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Etham and turned back to Pi Hahiroth, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " east of Baal Zephon; and they camped near Migdol. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Many Heb. mss., Sam., Syr., Tg., Vg. from Pi Hahiroth; cf. Num. 33:7"
                        },
                        {
                            "style": "NONE",
                            "text": "from before Hahiroth and passed through the midst of the sea into the wilderness, went three days’ journey in the Wilderness of Etham, and camped at Marah. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Marah and came to Elim. At Elim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twelve springs of water and seventy palm trees; so they camped there."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Elim and camped by the Red Sea. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from the Red Sea and camped in the Wilderness of Sin. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They journeyed from the Wilderness of Sin and camped at Dophkah. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Dophkah and camped at Alush. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Alush and camped at Rephidim, where there was no water for the people to drink."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Rephidim and camped in the Wilderness of Sinai. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from the Wilderness of Sinai and camped at "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Graves of Craving"
                        },
                        {
                            "style": "NONE",
                            "text": "Kibroth Hattaavah. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Kibroth Hattaavah and camped at Hazeroth. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Hazeroth and camped at Rithmah. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Rithmah and camped at Rimmon Perez. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Rimmon Perez and camped at Libnah. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Libnah and camped at Rissah. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They journeyed from Rissah and camped at Kehelathah. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They went from Kehelathah and camped at Mount Shepher. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Mount Shepher and camped at Haradah. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Haradah and camped at Makheloth. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Makheloth and camped at Tahath. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Tahath and camped at Terah. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Terah and camped at Mithkah. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They went from Mithkah and camped at Hashmonah. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Hashmonah and camped at Moseroth. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Moseroth and camped at Bene Jaakan. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Bene Jaakan and camped at Hor Hagidgad. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They went from Hor Hagidgad and camped at Jotbathah. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Jotbathah and camped at Abronah. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Abronah and camped at Ezion Geber. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Ezion Geber and camped in the Wilderness of Zin, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Kadesh. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Kadesh and camped at Mount Hor, on the boundary of the land of Edom."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Aaron the priest went up to Mount Hor at the command of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and died there in the fortieth year after the children of Israel had come out of the land of Egypt, on the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the fifth month. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Aaron "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred and twenty-three years old when he died on Mount Hor."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the king of Arad, the Canaanite, who dwelt in the South in the land of Canaan, heard of the coming of the children of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they departed from Mount Hor and camped at Zalmonah. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Zalmonah and camped at Punon. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Punon and camped at Oboth. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from Oboth and camped at Ije Abarim, at the border of Moab. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Same as Ije Abarim, v. 44"
                        },
                        {
                            "style": "NONE",
                            "text": "Ijim and camped at Dibon Gad. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Dibon Gad and camped at Almon Diblathaim. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They moved from Almon Diblathaim and camped in the mountains of Abarim, before Nebo. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They departed from the mountains of Abarim and camped in the plains of Moab by the Jordan, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "across from"
                        },
                        {
                            "style": "NONE",
                            "text": " Jericho. "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They camped by the Jordan, from Beth Jesimoth as far as the Abel Acacia Grove"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Abel Shittim"
                        },
                        {
                            "style": "NONE",
                            "text": " in the plains of Moab."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Instructions for the Conquest of Canaan"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses in the plains of Moab by the Jordan, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "across from"
                        },
                        {
                            "style": "NONE",
                            "text": " Jericho, saying, "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, and say to them: ‘When you have crossed the Jordan into the land of Canaan, "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall drive out all the inhabitants of the land from before you, destroy all their engraved stones, destroy all their molded images, and demolish all their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Places for pagan worship"
                        },
                        {
                            "style": "NONE",
                            "text": "high places; "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall dispossess "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the inhabitants of"
                        },
                        {
                            "style": "NONE",
                            "text": " the land and dwell in it, for I have given you the land to possess. "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall divide the land by lot as an inheritance among your families; to the larger you shall give a larger inheritance, and to the smaller you shall give a smaller inheritance; there everyone’s "
                        },
                        {
                            "style": "ITALIC",
                            "text": "inheritance"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be whatever falls to him by lot. You shall inherit according to the tribes of your fathers. "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if you do not drive out the inhabitants of the land from before you, then it shall be that those whom you let remain "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " irritants in your eyes and thorns in your sides, and they shall harass you in the land where you dwell. "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover it shall be "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " I will do to you as I thought to do to them.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}