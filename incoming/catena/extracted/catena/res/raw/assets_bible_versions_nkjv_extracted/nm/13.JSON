{
    "chapter_num": 13,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Spies Sent into Canaan"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Send men to spy out the land of Canaan, which I am giving to the children of Israel; from each tribe of their fathers you shall send a man, every one a leader among them.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Moses sent them from the Wilderness of Paran according to the command of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", all of them men who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " heads of the children of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " their names: from the tribe of Reuben, Shammua the son of Zaccur; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Simeon, Shaphat the son of Hori; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Judah, Caleb the son of Jephunneh; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Issachar, Igal the son of Joseph; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Ephraim, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "LXX, Vg. Oshea"
                        },
                        {
                            "style": "NONE",
                            "text": "Hoshea the son of Nun; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Benjamin, Palti the son of Raphu; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Zebulun, Gaddiel the son of Sodi; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Joseph, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " from the tribe of Manasseh, Gaddi the son of Susi; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Dan, Ammiel the son of Gemalli; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Asher, Sethur the son of Michael; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Naphtali, Nahbi the son of Vophsi; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the tribe of Gad, Geuel the son of Machi."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the names of the men whom Moses sent to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "secretly search"
                        },
                        {
                            "style": "NONE",
                            "text": "spy out the land. And Moses called Hoshea"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "LXX, Vg. Oshea"
                        },
                        {
                            "style": "NONE",
                            "text": " the son of Nun, Joshua."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses sent them to spy out the land of Canaan, and said to them, “Go up this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "way"
                        },
                        {
                            "style": "NONE",
                            "text": " into the South, and go up to the mountains, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and see what the land is like: whether the people who dwell in it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " strong or weak, few or many; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whether the land they dwell in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " good or bad; whether the cities they inhabit "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " like camps or strongholds; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whether the land "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "fertile or barren"
                        },
                        {
                            "style": "NONE",
                            "text": "rich or poor; and whether there are forests there or not. Be of good courage. And bring some of the fruit of the land.” Now the time "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the season of the first ripe grapes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they went up and spied out the land from the Wilderness of Zin as far as Rehob, near the entrance of Hamath. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they went up through the South and came to Hebron; Ahiman, Sheshai, and Talmai, the descendants of Anak, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " there. (Now Hebron was built seven years before Zoan in Egypt.) "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they came to the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Wadi"
                        },
                        {
                            "style": "NONE",
                            "text": "Valley of Eshcol, and there cut down a branch with one cluster of grapes; they carried it between two of them on a pole. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "They"
                        },
                        {
                            "style": "NONE",
                            "text": " also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "brought"
                        },
                        {
                            "style": "NONE",
                            "text": " some of the pomegranates and figs. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The place was called the Valley of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Cluster"
                        },
                        {
                            "style": "NONE",
                            "text": "Eshcol, because of the cluster which the men of Israel cut down there. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they returned from spying out the land after forty days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now they departed and came back to Moses and Aaron and all the congregation of the children of Israel in the Wilderness of Paran, at Kadesh; they brought back word to them and to all the congregation, and showed them the fruit of the land. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they told him, and said: “We went to the land where you sent us. It truly "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Has an abundance of food"
                        },
                        {
                            "style": "NONE",
                            "text": "flows with milk and honey, and this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " its fruit. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless the people who dwell in the land "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " strong; the cities "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " fortified "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " very large; moreover we saw the descendants of Anak there. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Amalekites dwell in the land of the South; the Hittites, the Jebusites, and the Amorites dwell in the mountains; and the Canaanites dwell by the sea and along the banks of the Jordan.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Caleb quieted the people before Moses, and said, “Let us go up at once and take possession, for we are well able to overcome it.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the men who had gone up with him said, “We are not able to go up against the people, for they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " stronger than we.” "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they gave the children of Israel a bad report of the land which they had spied out, saying, “The land through which we have gone as spies "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a land that devours its inhabitants, and all the people whom we saw in it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " men of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "great"
                        },
                        {
                            "style": "NONE",
                            "text": " stature. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There we saw the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. nephilim"
                        },
                        {
                            "style": "NONE",
                            "text": "giants (the descendants of Anak came from the giants); and we were like"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "As mere insects"
                        },
                        {
                            "style": "NONE",
                            "text": " grasshoppers in our own sight, and so we were in their sight.”"
                        }
                    ]
                }
            ]
        }
    ]
}