{
    "chapter_num": 48,
    "verses_count": 35,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Division of the Land"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the names of the tribes: From the northern border along the road to Hethlon at the entrance of Hamath, to Hazar Enan, the border of Damascus northward, in the direction of Hamath, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Dan from its east to its west side; "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Dan, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Asher; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Asher, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Naphtali; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Naphtali, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Manasseh; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Manasseh, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Ephraim; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Ephraim, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Reuben; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Reuben, from the east side to the west, one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section for"
                        },
                        {
                            "style": "NONE",
                            "text": " Judah; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Judah, from the east side to the west, shall be the district which you shall set apart, twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " in width, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " length the same as one of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " portions, from the east side to the west, with the sanctuary in the center."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The district that you shall set apart for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " in length and ten thousand in width. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To these—to the priests—the holy district shall belong: on the north twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits in length,"
                        },
                        {
                            "style": "NONE",
                            "text": " on the west ten thousand in width, on the east ten thousand in width, and on the south twenty-five thousand in length. The sanctuary of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be in the center. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "It shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " for the priests of the sons of Zadok, who are sanctified, who have kept My charge, who did not go astray when the children of Israel went astray, as the Levites went astray. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this"
                        },
                        {
                            "style": "NONE",
                            "text": " district of land that is set apart shall be to them a thing most holy by the border of the Levites."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Opposite the border of the priests, the Levites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have an area"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " in length and ten thousand in width; its entire length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand and its width ten thousand. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they shall not sell or exchange any of it; they may not alienate this best "
                        },
                        {
                            "style": "ITALIC",
                            "text": "part"
                        },
                        {
                            "style": "NONE",
                            "text": " of the land, for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " holy to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " in width that remain, along the edge of the twenty-five thousand, shall be for general use by the city, for dwellings and common-land; and the city shall be in the center. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its measurements: the north side four thousand five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " the south side four thousand five hundred, the east side four thousand five hundred, and the west side four thousand five hundred. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The common-land of the city shall be: to the north two hundred and fifty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " to the south two hundred and fifty, to the east two hundred and fifty, and to the west two hundred and fifty. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rest of the length, alongside the district of the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section, shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " ten thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " to the east and ten thousand to the west. It shall be adjacent to the district of the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section,"
                        },
                        {
                            "style": "NONE",
                            "text": " and its produce shall be food for the workers of the city. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The workers of the city, from all the tribes of Israel, shall cultivate it. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The entire district "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " by twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " foursquare. You shall set apart the holy district with the property of the city."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The rest "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall belong"
                        },
                        {
                            "style": "NONE",
                            "text": " to the prince, on one side and on the other of the holy district and of the city’s property, next to the twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "holy"
                        },
                        {
                            "style": "NONE",
                            "text": " district as far as the eastern border, and westward next to the twenty-five thousand as far as the western border, adjacent to the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "tribal"
                        },
                        {
                            "style": "NONE",
                            "text": " portions; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it shall belong"
                        },
                        {
                            "style": "NONE",
                            "text": " to the prince. It shall be the holy district, and the sanctuary of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " in the center. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover, apart from the possession of the Levites and the possession of the city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which are"
                        },
                        {
                            "style": "NONE",
                            "text": " in the midst of what "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belongs"
                        },
                        {
                            "style": "NONE",
                            "text": " to the prince, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the area"
                        },
                        {
                            "style": "NONE",
                            "text": " between the border of Judah and the border of Benjamin shall belong to the prince."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“As for the rest of the tribes, from the east side to the west, Benjamin "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Benjamin, from the east side to the west, Simeon "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Simeon, from the east side to the west, Issachar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Issachar, from the east side to the west, Zebulun "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Zebulun, from the east side to the west, Gad "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the border of Gad, on the south side, toward the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Negev"
                        },
                        {
                            "style": "NONE",
                            "text": "South, the border shall be from Tamar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the waters of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Strife"
                        },
                        {
                            "style": "NONE",
                            "text": "Meribah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "by"
                        },
                        {
                            "style": "NONE",
                            "text": " Kadesh, along the brook to the Great Sea. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the land which you shall divide by lot as an inheritance among the tribes of Israel, and these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " their portions,” says the Lord "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Gates of the City and Its Name"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the exits of the city. On the north side, measuring four thousand five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(the gates of the city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " named after the tribes of Israel), the three gates northward: one gate for Reuben, one gate for Judah, and one gate for Levi; "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "on the east side, four thousand five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " three gates: one gate for Joseph, one gate for Benjamin, and one gate for Dan; "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "on the south side, measuring four thousand five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " three gates: one gate for Simeon, one gate for Issachar, and one gate for Zebulun; "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "on the west side, four thousand five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " with their three gates: one gate for Gad, one gate for Asher, and one gate for Naphtali. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the way around "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " eighteen thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits;"
                        },
                        {
                            "style": "NONE",
                            "text": " and the name of the city from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " day "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be:"
                        },
                        {
                            "style": "NONE",
                            "text": " THE"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. YHWH Shammah"
                        },
                        {
                            "style": "NONE",
                            "text": " LORD "
                        },
                        {
                            "style": "ITALIC",
                            "text": "IS"
                        },
                        {
                            "style": "NONE",
                            "text": " THERE.”"
                        }
                    ]
                }
            ]
        }
    ]
