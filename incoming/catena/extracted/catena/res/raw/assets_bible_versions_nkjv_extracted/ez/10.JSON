{
    "chapter_num": 10,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Glory Departs from the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I looked, and there in the firmament"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "expanse"
                        },
                        {
                            "style": "NONE",
                            "text": " that was above the head of the cherubim, there appeared something like a sapphire stone, having the appearance of the likeness of a throne. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He spoke to the man clothed with linen, and said, “Go in among the wheels, under the cherub, fill your hands with coals of fire from among the cherubim, and scatter "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " over the city.” And he went in as I watched."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the cherubim were standing on the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. right"
                        },
                        {
                            "style": "NONE",
                            "text": "south side of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple when the man went in, and the cloud filled the inner court. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the glory of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " went up from the cherub, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and paused"
                        },
                        {
                            "style": "NONE",
                            "text": " over the threshold of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple; and the house was filled with the cloud, and the court was full of the brightness of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s glory. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sound of the wings of the cherubim was heard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "even"
                        },
                        {
                            "style": "NONE",
                            "text": " in the outer court, like the voice of Almighty God when He speaks."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then it happened, when He commanded the man clothed in linen, saying, “Take fire from among the wheels, from among the cherubim,” that he went in and stood beside the wheels. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the cherub stretched out his hand from among the cherubim to the fire that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " among the cherubim, and took "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some of it"
                        },
                        {
                            "style": "NONE",
                            "text": " and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " into the hands of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "man"
                        },
                        {
                            "style": "NONE",
                            "text": " clothed with linen, who took "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " and went out. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The cherubim appeared to have the form of a man’s hand under their wings."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when I looked, there were four wheels by the cherubim, one wheel by one cherub and another wheel by each other cherub; the wheels appeared "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to have"
                        },
                        {
                            "style": "NONE",
                            "text": " the color of a beryl stone. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "As for"
                        },
                        {
                            "style": "NONE",
                            "text": " their appearance, all four looked alike—as it were, a wheel in the middle of a wheel. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they went, they went toward "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any of"
                        },
                        {
                            "style": "NONE",
                            "text": " their four directions; they did not turn aside when they went, but followed in the direction the head was facing. They did not turn aside when they went. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their whole body, with their back, their hands, their wings, and the wheels that the four had, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " full of eyes all around. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the wheels, they were called in my "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. ears"
                        },
                        {
                            "style": "NONE",
                            "text": "hearing, “Wheel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Each one had four faces: the first face "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the face of a cherub, the second face the face of a man, the third the face of a lion, and the fourth the face of an eagle. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the cherubim were lifted up. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the living creature I saw by the River Chebar. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the cherubim went, the wheels went beside them; and when the cherubim lifted their wings to mount up from the earth, the same wheels also did not turn from beside them. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. they"
                        },
                        {
                            "style": "ITALIC",
                            "text": "the cherubim"
                        },
                        {
                            "style": "NONE",
                            "text": " stood still, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the wheels"
                        },
                        {
                            "style": "NONE",
                            "text": " stood still, and when "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. they were"
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " was lifted up, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. they lifted them"
                        },
                        {
                            "style": "ITALIC",
                            "text": "the other"
                        },
                        {
                            "style": "NONE",
                            "text": " lifted itself up, for the spirit of the living creature "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the glory of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " departed from the threshold of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple and stood over the cherubim. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the cherubim lifted their wings and mounted up from the earth in my sight. When they went out, the wheels "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " beside them; and they stood at the door of the east gate of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s house, and the glory of the God of Israel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " above them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the living creature I saw under the God of Israel by the River Chebar, and I knew they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " cherubim. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Each one had four faces and each one four wings, and the likeness of the hands of a man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " under their wings. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the likeness of their faces "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the same "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " the faces which I had seen by the River Chebar, their appearance and their persons. They each went straight forward."
                        }
                    ]
                }
            ]
        }
    ]
}