{
    "chapter_num": 6,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Children and Parents"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Children, obey your parents in the Lord, for this is right. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“Honor your father and mother,”"
                        },
                        {
                            "style": "NONE",
                            "text": " which is the first commandment with promise: "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“that it may be well with you and you may live long on the earth.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, fathers, do not provoke your children to wrath, but bring them up in the training and admonition of the Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Bondservants and Masters"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bondservants, be obedient to those who are your masters according to the flesh, with fear and trembling, in sincerity of heart, as to Christ; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not with eyeservice, as men-pleasers, but as bondservants of Christ, doing the will of God from the heart, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with goodwill doing service, as to the Lord, and not to men, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "knowing that whatever good anyone does, he will receive the same from the Lord, whether "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he is"
                        },
                        {
                            "style": "NONE",
                            "text": " a slave or free."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, masters, do the same things to them, giving up threatening, knowing that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU He who is both their Master and yours is"
                        },
                        {
                            "style": "NONE",
                            "text": "your own Master also is in heaven, and there is no partiality with Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Whole Armor of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Finally, my brethren, be strong in the Lord and in the power of His might. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Put on the whole armor of God, that you may be able to stand against the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "schemings"
                        },
                        {
                            "style": "NONE",
                            "text": "wiles of the devil. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we do not wrestle against flesh and blood, but against principalities, against powers, against the rulers of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU this darkness,"
                        },
                        {
                            "style": "NONE",
                            "text": "the darkness of this age, against spiritual "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hosts"
                        },
                        {
                            "style": "NONE",
                            "text": " of wickedness in the heavenly "
                        },
                        {
                            "style": "ITALIC",
                            "text": "places."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore take up the whole armor of God, that you may be able to withstand in the evil day, and having done all, to stand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Stand therefore, having girded your waist with truth, having put on the breastplate of righteousness, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and having shod your feet with the preparation of the gospel of peace; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "above all, taking the shield of faith with which you will be able to quench all the fiery darts of the wicked one. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And take the helmet of salvation, and the sword of the Spirit, which is the word of God; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "praying always with all prayer and supplication in the Spirit, being watchful to this end with all perseverance and supplication for all the saints— "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and for me, that utterance may be given to me, that I may open my mouth boldly to make known the mystery of the gospel, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for which I am an ambassador in chains; that in it I may speak boldly, as I ought to speak."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Gracious Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But that you also may know my affairs "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " how I am doing, Tychicus, a beloved brother and faithful minister in the Lord, will make all things known to you; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whom I have sent to you for this very purpose, that you may know our affairs, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " he may comfort your hearts."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Peace to the brethren, and love with faith, from God the Father and the Lord Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with all those who love our Lord Jesus Christ in sincerity. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}