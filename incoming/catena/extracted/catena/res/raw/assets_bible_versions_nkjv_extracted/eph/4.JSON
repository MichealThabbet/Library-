{
    "chapter_num": 4,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Walk in Unity"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I, therefore, the prisoner "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. in"
                        },
                        {
                            "style": "NONE",
                            "text": "of the Lord, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "exhort, encourage"
                        },
                        {
                            "style": "NONE",
                            "text": "beseech you to walk worthy of the calling with which you were called, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with all lowliness and gentleness, with longsuffering, bearing with one another in love, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "endeavoring to keep the unity of the Spirit in the bond of peace. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There is"
                        },
                        {
                            "style": "NONE",
                            "text": " one body and one Spirit, just as you were called in one hope of your calling; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one Lord, one faith, one baptism; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one God and Father of all, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " above all, and through all, and in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits you; M us"
                        },
                        {
                            "style": "NONE",
                            "text": "you all."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Spiritual Gifts"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But to each one of us grace was given according to the measure of Christ’s gift. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore He says:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“When He ascended on high,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "He led captivity captive,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And gave gifts to men.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(Now this, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“He ascended”"
                        },
                        {
                            "style": "NONE",
                            "text": "—what does it mean but that He also "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits first"
                        },
                        {
                            "style": "NONE",
                            "text": "first descended into the lower parts of the earth? "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who descended is also the One who ascended far above all the heavens, that He might fill all things.)"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He Himself gave some "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " apostles, some prophets, some evangelists, and some pastors and teachers, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for the equipping of the saints for the work of ministry, for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "building up"
                        },
                        {
                            "style": "NONE",
                            "text": "edifying of the body of Christ, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "till we all come to the unity of the faith and of the knowledge of the Son of God, to a perfect man, to the measure of the stature of the fullness of Christ; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that we should no longer be children, tossed to and fro and carried about with every wind of doctrine, by the trickery of men, in the cunning craftiness of deceitful plotting, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but, speaking the truth in love, may grow up in all things into Him who is the head—Christ— "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from whom the whole body, joined and knit together by what every joint supplies, according to the effective working by which every part does its share, causes growth of the body for the edifying of itself in love."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The New Man"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This I say, therefore, and testify in the Lord, that you should no longer walk as "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the rest of"
                        },
                        {
                            "style": "NONE",
                            "text": "the rest of the Gentiles walk, in the futility of their mind, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having their understanding darkened, being alienated from the life of God, because of the ignorance that is in them, because of the blindness of their heart; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who, being past feeling, have given themselves over to lewdness, to work all uncleanness with greediness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But you have not so learned Christ, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "if indeed you have heard Him and have been taught by Him, as the truth is in Jesus: "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that you put off, concerning your former conduct, the old man which grows corrupt according to the deceitful lusts, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and be renewed in the spirit of your mind, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and that you put on the new man which was created according to God, in true righteousness and holiness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Do Not Grieve the Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore, putting away lying, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Let"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "each one"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "speak truth with his neighbor,”"
                        },
                        {
                            "style": "NONE",
                            "text": " for we are members of one another. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“Be angry, and do not sin”"
                        },
                        {
                            "style": "NONE",
                            "text": ": do not let the sun go down on your wrath, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor give "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "an opportunity"
                        },
                        {
                            "style": "NONE",
                            "text": "place to the devil. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let him who stole steal no longer, but rather let him labor, working with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " hands what is good, that he may have something to give him who has need. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let no corrupt word proceed out of your mouth, but what is good for necessary "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "building up"
                        },
                        {
                            "style": "NONE",
                            "text": "edification, that it may impart grace to the hearers. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And do not grieve the Holy Spirit of God, by whom you were sealed for the day of redemption. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let all bitterness, wrath, anger, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "loud quarreling"
                        },
                        {
                            "style": "NONE",
                            "text": "clamor, and evil speaking be put away from you, with all malice. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And be kind to one another, tenderhearted, forgiving one another, even as God in Christ forgave you."
                        }
                    ]
                }
            ]
        }
    ]
}