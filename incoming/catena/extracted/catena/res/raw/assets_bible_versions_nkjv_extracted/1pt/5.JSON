{
    "chapter_num": 5,
    "verses_count": 14,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Shepherd the Flock"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The elders who are among you I exhort, I who am a fellow elder and a witness of the sufferings of Christ, and also a partaker of the glory that will be revealed: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shepherd the flock of God which is among you, serving as overseers, not by compulsion but "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU adds according to God"
                        },
                        {
                            "style": "NONE",
                            "text": "willingly, not for dishonest gain but eagerly; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor as being "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "masters"
                        },
                        {
                            "style": "NONE",
                            "text": "lords over those entrusted to you, but being examples to the flock; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and when the Chief Shepherd appears, you will receive the crown of glory that does not fade away."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Submit to God, Resist the Devil"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise you younger people, submit yourselves to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " elders. Yes, all of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " be submissive to one another, and be clothed with humility, for"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“God resists the proud,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "But"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "gives grace to the humble.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore humble yourselves under the mighty hand of God, that He may exalt you in due time, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "casting all your care upon Him, for He cares for you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "self-controlled"
                        },
                        {
                            "style": "NONE",
                            "text": "sober, be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "watchful"
                        },
                        {
                            "style": "NONE",
                            "text": "vigilant; "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit because"
                        },
                        {
                            "style": "NONE",
                            "text": "because your adversary the devil walks about like a roaring lion, seeking whom he may devour. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Resist him, steadfast in the faith, knowing that the same sufferings are experienced by your brotherhood in the world. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU the God of all grace,"
                        },
                        {
                            "style": "NONE",
                            "text": "may the God of all grace, who called "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M you"
                        },
                        {
                            "style": "NONE",
                            "text": "us to His eternal glory by Christ Jesus, after you have suffered a while, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU will perfect"
                        },
                        {
                            "style": "NONE",
                            "text": "perfect, establish, strengthen, and settle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the glory and the dominion forever and ever. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Farewell and Peace"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "By Silvanus, our faithful brother as I consider him, I have written to you briefly, exhorting and testifying that this is the true grace of God in which you stand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "She who is in Babylon, elect together with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you,"
                        },
                        {
                            "style": "NONE",
                            "text": " greets you; and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "so does"
                        },
                        {
                            "style": "NONE",
                            "text": " Mark my son. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet one another with a kiss of love."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Peace to you all who are in Christ Jesus. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}