{
    "chapter_num": 8,
    "verses_count": 36,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Heads of Families Who Returned with Ezra"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the heads of their fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this is"
                        },
                        {
                            "style": "NONE",
                            "text": " the genealogy of those who went up with me from Babylon, in the reign of King Artaxerxes: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Phinehas, Gershom; of the sons of Ithamar, Daniel; of the sons of David, Hattush; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Shecaniah, of the sons of Parosh, Zechariah; and registered with him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred and fifty males; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Pahath-Moab, Eliehoenai the son of Zerahiah, and with him two hundred males; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Vg.; LXX the sons of Zatho, Shechaniah"
                        },
                        {
                            "style": "NONE",
                            "text": "the sons of Shechaniah, Ben-Jahaziel, and with him three hundred males; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Adin, Ebed the son of Jonathan, and with him fifty males; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Elam, Jeshaiah the son of Athaliah, and with him seventy males; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Shephatiah, Zebadiah the son of Michael, and with him eighty males; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Joab, Obadiah the son of Jehiel, and with him two hundred and eighteen males; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Vg.; LXX the sons of Banni, Shelomith"
                        },
                        {
                            "style": "NONE",
                            "text": "the sons of Shelomith, Ben-Josiphiah, and with him one hundred and sixty males; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Bebai, Zechariah the son of Bebai, and with him twenty-eight males; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Azgad, Johanan "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or the youngest son,"
                        },
                        {
                            "style": "NONE",
                            "text": "the son of Hakkatan, and with him one hundred and ten males; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the last sons of Adonikam, whose names "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " these—Eliphelet, Jeiel, and Shemaiah—and with them sixty males; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also of the sons of Bigvai, Uthai and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Zakkur"
                        },
                        {
                            "style": "NONE",
                            "text": "Zabbud, and with them seventy males."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Servants for the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I gathered them by the river that flows to Ahava, and we camped there three days. And I looked among the people and the priests, and found none of the sons of Levi there. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I sent for Eliezer, Ariel, Shemaiah, Elnathan, Jarib, Elnathan, Nathan, Zechariah, and Meshullam, leaders; also for Joiarib and Elnathan, men of understanding. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I gave them a command for Iddo the chief man at the place Casiphia, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. I put words in their mouths to say"
                        },
                        {
                            "style": "NONE",
                            "text": "I told them what they should say to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with Vg.; MT to Iddo his brother; LXX to their brethren"
                        },
                        {
                            "style": "NONE",
                            "text": "Iddo "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " his brethren the Nethinim at the place Casiphia—that they should bring us servants for the house of our God. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then, by the good hand of our God upon us, they brought us a man of understanding, of the sons of Mahli the son of Levi, the son of Israel, namely Sherebiah, with his sons and brothers, eighteen men; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Hashabiah, and with him Jeshaiah of the sons of Merari, his brothers and their sons, twenty men; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also of the Nethinim, whom David and the leaders had appointed for the service of the Levites, two hundred and twenty Nethinim. All of them were designated by name."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Fasting and Prayer for Protection"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I proclaimed a fast there at the river of Ahava, that we might humble ourselves before our God, to seek from Him the right way for us and our little ones and all our possessions. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I was ashamed to request of the king an escort of soldiers and horsemen to help us against the enemy on the road, because we had spoken to the king, saying, “The hand of our God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " upon all those for good who seek Him, but His power and His wrath "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " against all those who forsake Him.” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So we fasted and entreated our God for this, and He answered our prayer."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Gifts for the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I separated twelve of the leaders of the priests—Sherebiah, Hashabiah, and ten of their brethren with them— "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and weighed out to them the silver, the gold, and the articles, the offering for the house of our God which the king and his counselors and his princes, and all Israel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who were"
                        },
                        {
                            "style": "NONE",
                            "text": " present, had offered. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I weighed into their hand six hundred and fifty talents of silver, silver articles "
                        },
                        {
                            "style": "ITALIC",
                            "text": "weighing"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred talents, one hundred talents of gold, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "twenty gold basins "
                        },
                        {
                            "style": "ITALIC",
                            "text": "worth"
                        },
                        {
                            "style": "NONE",
                            "text": " a thousand drachmas, and two vessels of fine polished bronze, precious as gold. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I said to them, “You "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": " to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; the articles "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy also; and the silver and the gold "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " a freewill offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of your fathers. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Watch and keep "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " until you weigh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " before the leaders of the priests and the Levites and heads of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses"
                        },
                        {
                            "style": "NONE",
                            "text": " of Israel in Jerusalem, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " the chambers of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".” "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the priests and the Levites received the silver and the gold and the articles by weight, to bring "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to Jerusalem to the house of our God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Return to Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then we departed from the river of Ahava on the twelfth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the first month, to go to Jerusalem. And the hand of our God was upon us, and He delivered us from the hand of the enemy and from ambush along the road. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So we came to Jerusalem, and stayed there three days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now on the fourth day the silver and the gold and the articles were weighed in the house of our God by the hand of Meremoth the son of Uriah the priest, and with him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Eleazar the son of Phinehas; with them "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the Levites, Jozabad the son of Jeshua and Noadiah the son of Binnui, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with the number "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " weight of everything. All the weight was written down at that time."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The children of those who had been carried away captive, who had come from the captivity, offered burnt offerings to the God of Israel: twelve bulls for all Israel, ninety-six rams, seventy-seven lambs, and twelve male goats "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering. All "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this was"
                        },
                        {
                            "style": "NONE",
                            "text": " a burnt offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they delivered the king’s orders to the king’s satraps and the governors "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in the region"
                        },
                        {
                            "style": "NONE",
                            "text": " beyond "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Euphrates"
                        },
                        {
                            "style": "NONE",
                            "text": "the River. So they gave support to the people and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Temple"
                        },
                        {
                            "style": "NONE",
                            "text": "house of God."
                        }
                    ]
                }
            ]
        }
    ]
}