{
    "chapter_num": 1,
    "verses_count": 10,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "What Was Heard, Seen, and Touched"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That which was from the beginning, which we have heard, which we have seen with our eyes, which we have looked upon, and our hands have handled, concerning the Word of life— "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the life was manifested, and we have seen, and bear witness, and declare to you that eternal life which was with the Father and was manifested to us— "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that which we have seen and heard we declare to you, that you also may have fellowship with us; and truly our fellowship "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " with the Father and with His Son Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these things we write to you that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M our"
                        },
                        {
                            "style": "NONE",
                            "text": "your joy may be full."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Fellowship with Him and One Another"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is the message which we have heard from Him and declare to you, that God is light and in Him is no darkness at all. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we say that we have fellowship with Him, and walk in darkness, we lie and do not practice the truth. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if we walk in the light as He is in the light, we have fellowship with one another, and the blood of Jesus Christ His Son cleanses us from all sin."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we say that we have no sin, we deceive ourselves, and the truth is not in us. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we confess our sins, He is faithful and just to forgive us "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " sins and to cleanse us from all unrighteousness. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we say that we have not sinned, we make Him a liar, and His word is not in us."
                        }
                    ]
                }
            ]
        }
    ]
}