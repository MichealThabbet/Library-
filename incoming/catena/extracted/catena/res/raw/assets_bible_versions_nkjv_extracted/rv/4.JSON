    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Throne Room of Heaven"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After these things I looked, and behold, a door "
                        },
                        {
                            "style": "ITALIC",
                            "text": "standing"
                        },
                        {
                            "style": "NONE",
                            "text": " open in heaven. And the first voice which I heard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like a trumpet speaking with me, saying, “Come up here, and I will show you things which must take place after this.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Immediately I was in the Spirit; and behold, a throne set in heaven, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "One"
                        },
                        {
                            "style": "NONE",
                            "text": " sat on the throne. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "M omits And He who sat there was, making the following a description of the throne."
                        },
                        {
                            "style": "NONE",
                            "text": "And He who sat there was like a jasper and a sardius stone in appearance; and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " a rainbow around the throne, in appearance like an emerald. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Around the throne "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-four thrones, and on the thrones I saw twenty-four elders sitting, clothed in white "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M robes, with crowns"
                        },
                        {
                            "style": "NONE",
                            "text": "robes; and they had crowns of gold on their heads. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And from the throne proceeded lightnings, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M voices, and thunderings."
                        },
                        {
                            "style": "NONE",
                            "text": "thunderings, and voices. Seven lamps of fire "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " burning before the throne, which are the"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M omits the"
                        },
                        {
                            "style": "NONE",
                            "text": " seven Spirits of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Before the throne "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M add something like"
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a sea of glass, like crystal. And in the midst of the throne, and around the throne, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " four living creatures full of eyes in front and in back. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The first living creature "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like a lion, the second living creature like a calf, the third living creature had a face like a man, and the fourth living creature "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like a flying eagle. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "The"
                        },
                        {
                            "style": "NONE",
                            "text": " four living creatures, each having six wings, were full of eyes around and within. And they do not rest day or night, saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Holy,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M has holy nine times."
                        },
                        {
                            "style": "NONE",
                            "text": " holy, holy,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Lord God Almighty,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Who was and is and is to come!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whenever the living creatures give glory and honor and thanks to Him who sits on the throne, who lives forever and ever, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the twenty-four elders fall down before Him who sits on the throne and worship Him who lives forever and ever, and cast their crowns before the throne, saying:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You are worthy, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M our Lord and God"
                        },
                        {
                            "style": "NONE",
                            "text": "O Lord,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To receive glory and honor and power;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For You created all things,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And by Your will they "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M existed"
                        },
                        {
                            "style": "NONE",
                            "text": "exist and were created.”"
                        }
                    ]
                }
            ]
        }
    ]
}