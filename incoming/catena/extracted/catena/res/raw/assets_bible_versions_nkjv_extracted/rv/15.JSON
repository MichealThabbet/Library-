{
    "chapter_num": 15,
    "verses_count": 8,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Prelude to the Bowl Judgments"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I saw another sign in heaven, great and marvelous: seven angels having the seven last plagues, for in them the wrath of God is complete."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "something"
                        },
                        {
                            "style": "NONE",
                            "text": " like a sea of glass mingled with fire, and those who have the victory over the beast, over his image and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit over his mark"
                        },
                        {
                            "style": "NONE",
                            "text": "over his mark "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " over the number of his name, standing on the sea of glass, having harps of God. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They sing the song of Moses, the servant of God, and the song of the Lamb, saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Great and marvelous "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " Your works,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Lord God Almighty!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Just and true "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " Your ways,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "O King of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M nations"
                        },
                        {
                            "style": "NONE",
                            "text": "saints!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Who shall not fear You, O Lord, and glorify Your name?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "You"
                        },
                        {
                            "style": "NONE",
                            "text": " alone "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For all nations shall come and worship before You,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For Your judgments have been manifested.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After these things I looked, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit behold"
                        },
                        {
                            "style": "NONE",
                            "text": "behold, the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sanctuary, the inner shrine"
                        },
                        {
                            "style": "NONE",
                            "text": "temple of the tabernacle of the testimony in heaven was opened. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And out of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sanctuary, the inner shrine"
                        },
                        {
                            "style": "NONE",
                            "text": "temple came the seven angels having the seven plagues, clothed in pure bright linen, and having their chests girded with golden bands. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then one of the four living creatures gave to the seven angels seven golden bowls full of the wrath of God who lives forever and ever. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The temple was filled with smoke from the glory of God and from His power, and no one was able to enter the temple till the seven plagues of the seven angels were completed."
                        }
                    ]
                }
            ]
        }
    ]
}