{
    "chapter_num": 15,
    "verses_count": 63,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Land of Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this"
                        },
                        {
                            "style": "NONE",
                            "text": " was the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "allotment"
                        },
                        {
                            "style": "NONE",
                            "text": "lot of the tribe of the children of Judah according to their families:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The border of Edom at the Wilderness of Zin southward "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the extreme southern boundary. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their southern border began at the shore of the Salt Sea, from the bay that faces southward. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then it went out to the southern side of the Ascent of Akrabbim, passed along to Zin, ascended on the south side of Kadesh Barnea, passed along to Hezron, went up to Adar, and went around to Karkaa. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "From there"
                        },
                        {
                            "style": "NONE",
                            "text": " it passed toward Azmon and went out to the Brook of Egypt; and the border ended at the sea. This shall be your southern border."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The east border "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the Salt Sea as far as the mouth of the Jordan."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And the border on the northern quarter "
                        },
                        {
                            "style": "ITALIC",
                            "text": "began"
                        },
                        {
                            "style": "NONE",
                            "text": " at the bay of the sea at the mouth of the Jordan. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The border went up to Beth Hoglah and passed north of Beth Arabah; and the border went up to the stone of Bohan the son of Reuben. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the border went up toward Debir from the Valley of Achor, and it turned northward toward Gilgal, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the Ascent of Adummim, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the south side of the valley. The border continued toward the waters of En Shemesh and ended at En Rogel. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border went up by the Valley of the Son of Hinnom to the southern slope of the Jebusite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "city"
                        },
                        {
                            "style": "NONE",
                            "text": " (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Jerusalem). The border went up to the top of the mountain that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lies"
                        },
                        {
                            "style": "NONE",
                            "text": " before the Valley of Hinnom westward, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " at the end of the Valley of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Giants"
                        },
                        {
                            "style": "NONE",
                            "text": "Rephaim northward. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the border went around from the top of the hill to the fountain of the water of Nephtoah, and extended to the cities of Mount Ephron. And the border went around to Baalah (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Kirjath Jearim). "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the border "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "turned around"
                        },
                        {
                            "style": "NONE",
                            "text": "turned westward from Baalah to Mount Seir, passed along to the side of Mount Jearim on the north (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Chesalon), went down to Beth Shemesh, and passed on to Timnah. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border went out to the side of Ekron northward. Then the border went around to Shicron, passed along to Mount Baalah, and extended to Jabneel; and the border ended at the sea."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The west border "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the coastline of the Great Sea. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the boundary of the children of Judah all around according to their families."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Caleb Occupies Hebron and Debir"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now to Caleb the son of Jephunneh he gave a share among the children of Judah, according to the commandment of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to Joshua, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "namely,"
                        },
                        {
                            "style": "NONE",
                            "text": " Kirjath Arba, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Hebron ("
                        },
                        {
                            "style": "ITALIC",
                            "text": "Arba was"
                        },
                        {
                            "style": "NONE",
                            "text": " the father of Anak). "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Caleb drove out the three sons of Anak from there: Sheshai, Ahiman, and Talmai, the children of Anak. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he went up from there to the inhabitants of Debir (formerly the name of Debir "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Kirjath Sepher)."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Caleb said, “He who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. strikes"
                        },
                        {
                            "style": "NONE",
                            "text": "attacks Kirjath Sepher and takes it, to him I will give Achsah my daughter as wife.” "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Othniel the son of Kenaz, the brother of Caleb, took it; and he gave him Achsah his daughter as wife. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it was so, when she came "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to him,"
                        },
                        {
                            "style": "NONE",
                            "text": " that she persuaded him to ask her father for a field. So she dismounted from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " donkey, and Caleb said to her, “What do you wish?” "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "She answered, “Give me a blessing; since you have given me land in the South, give me also springs of water.” So he gave her the upper springs and the lower springs."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Cities of Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Judah according to their families:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The cities at the limits of the tribe of the children of Judah, toward the border of Edom in the South, were Kabzeel, Eder, Jagur, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kinah, Dimonah, Adadah, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kedesh, Hazor, Ithnan, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ziph, Telem, Bealoth, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hazor, Hadattah, Kerioth, Hezron (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Hazor), "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Amam, Shema, Moladah, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hazar Gaddah, Heshmon, Beth Pelet, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hazar Shual, Beersheba, Bizjothjah, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Baalah, Ijim, Ezem, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eltolad, Chesil, Hormah, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ziklag, Madmannah, Sansannah, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Lebaoth, Shilhim, Ain, and Rimmon: all the cities "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-nine, with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the lowland: Eshtaol, Zorah, Ashnah, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zanoah, En Gannim, Tappuah, Enam, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jarmuth, Adullam, Socoh, Azekah, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Sharaim, Adithaim, Gederah, and Gederothaim: fourteen cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zenan, Hadashah, Migdal Gad, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Dilean, Mizpah, Joktheel, "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Lachish, Bozkath, Eglon, "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Cabbon, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Lahmam"
                        },
                        {
                            "style": "NONE",
                            "text": "Lahmas, Kithlish, "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Gederoth, Beth Dagon, Naamah, and Makkedah: sixteen cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Libnah, Ether, Ashan, "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jiphtah, Ashnah, Nezib, "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Keilah, Achzib, and Mareshah: nine cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ekron, with its towns and villages; "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from Ekron to the sea, all that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lay"
                        },
                        {
                            "style": "NONE",
                            "text": " near Ashdod, with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ashdod with its towns and villages, Gaza with its towns and villages—as far as the Brook of Egypt and the Great Sea with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "its"
                        },
                        {
                            "style": "NONE",
                            "text": " coastline."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in the mountain country: Shamir, Jattir, Sochoh, "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Dannah, Kirjath Sannah (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Debir), "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Anab, Eshtemoh, Anim, "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Goshen, Holon, and Giloh: eleven cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Arab, Dumah, Eshean, "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Janum, Beth Tappuah, Aphekah, "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Humtah, Kirjath Arba (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Hebron), and Zior: nine cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Maon, Carmel, Ziph, Juttah, "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jezreel, Jokdeam, Zanoah, "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kain, Gibeah, and Timnah: ten cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Halhul, Beth Zur, Gedor, "
                        }
                    ]
                },
                {
                    "num_int": 59,
                    "num_str": "59",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Maarath, Beth Anoth, and Eltekon: six cities with their villages; "
                        }
                    ]
                },
                {
                    "num_int": 60,
                    "num_str": "60",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kirjath Baal (which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Kirjath Jearim) and Rabbah: two cities with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 61,
                    "num_str": "61",
                    "verse_parts": [
                        {
                            "style": "NONE",
