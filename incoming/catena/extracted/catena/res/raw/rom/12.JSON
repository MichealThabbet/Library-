{
    "chapter_num": 12,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Living Sacrifices to God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I beseech"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "urge"
                        },
                        {
                            "style": "NONE",
                            "text": " you therefore, brethren, by the mercies of God, that you present your bodies a living sacrifice, holy, acceptable to God, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which is"
                        },
                        {
                            "style": "NONE",
                            "text": " your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "rational"
                        },
                        {
                            "style": "NONE",
                            "text": "reasonable service. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And do not be conformed to this world, but be transformed by the renewing of your mind, that you may prove what "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " that good and acceptable and perfect will of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Serve God with Spiritual Gifts"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I say, through the grace given to me, to everyone who is among you, not to think "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of himself"
                        },
                        {
                            "style": "NONE",
                            "text": " more highly than he ought to think, but to think soberly, as God has dealt to each one a measure of faith. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as we have many members in one body, but all the members do not have the same function, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so we, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "being"
                        },
                        {
                            "style": "NONE",
                            "text": " many, are one body in Christ, and individually members of one another. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Having then gifts differing according to the grace that is given to us, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "let us use them:"
                        },
                        {
                            "style": "NONE",
                            "text": " if prophecy, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "let us"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "prophesy"
                        },
                        {
                            "style": "NONE",
                            "text": " in proportion to our faith; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or ministry, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "let us use it"
                        },
                        {
                            "style": "NONE",
                            "text": " in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " ministering; he who teaches, in teaching; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he who exhorts, in exhortation; he who gives, with liberality; he who leads, with diligence; he who shows mercy, with cheerfulness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Behave Like a Christian"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Let"
                        },
                        {
                            "style": "NONE",
                            "text": " love "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " without hypocrisy. Abhor what is evil. Cling to what is good. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Be"
                        },
                        {
                            "style": "NONE",
                            "text": " kindly affectionate to one another with brotherly love, in honor giving preference to one another; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not lagging in diligence, fervent in spirit, serving the Lord; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "rejoicing in hope, patient"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "persevering"
                        },
                        {
                            "style": "NONE",
                            "text": " in tribulation, continuing steadfastly in prayer; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "distributing to the needs of the saints, given"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. pursuing"
                        },
                        {
                            "style": "NONE",
                            "text": " to hospitality."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bless those who persecute you; bless and do not curse. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Rejoice with those who rejoice, and weep with those who weep. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Be of the same mind toward one another. Do not set your mind on high things, but associate with the humble. Do not be wise in your own opinion."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Repay no one evil for evil. Have"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Provide good"
                        },
                        {
                            "style": "NONE",
                            "text": " regard for good things in the sight of all men. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If it is possible, as much as depends on you, live peaceably with all men. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beloved, do not avenge yourselves, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "rather"
                        },
                        {
                            "style": "NONE",
                            "text": " give place to wrath; for it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Vengeance"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Mine, I will repay,”"
                        },
                        {
                            "style": "NONE",
                            "text": " says the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“If your enemy is hungry, feed him;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "If he is thirsty, give him a drink;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "For in so doing you will heap coals of fire on his head.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not be overcome by evil, but overcome evil with good."
                        }
                    ]
                }
            ]
        }
    ]
}