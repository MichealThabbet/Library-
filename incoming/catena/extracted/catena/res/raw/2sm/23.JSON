{
    "chapter_num": 23,
    "verses_count": 39,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "David’s Last Words"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the last words of David."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Thus"
                        },
                        {
                            "style": "NONE",
                            "text": " says David the son of Jesse;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Thus"
                        },
                        {
                            "style": "NONE",
                            "text": " says the man raised up on high,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The anointed of the God of Jacob,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And the sweet psalmist of Israel:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The Spirit of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke by me,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And His word "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on my tongue."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The God of Israel said,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The Rock of Israel spoke to me:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "‘He who rules over men "
                        },
                        {
                            "style": "ITALIC",
                            "text": "must be"
                        },
                        {
                            "style": "NONE",
                            "text": " just,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Ruling in the fear of God."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " like the light of the morning "
                        },
                        {
                            "style": "ITALIC",
                            "text": "when"
                        },
                        {
                            "style": "NONE",
                            "text": " the sun rises,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "A morning without clouds,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Like"
                        },
                        {
                            "style": "NONE",
                            "text": " the tender grass "
                        },
                        {
                            "style": "ITALIC",
                            "text": "springing"
                        },
                        {
                            "style": "NONE",
                            "text": " out of the earth,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "By clear shining after rain.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Although my house "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not so with God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Yet He has made with me an everlasting covenant,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Ordered in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " and secure."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this is"
                        },
                        {
                            "style": "NONE",
                            "text": " all my salvation and all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "my"
                        },
                        {
                            "style": "NONE",
                            "text": " desire;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Will He not make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " increase?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the sons"
                        },
                        {
                            "style": "NONE",
                            "text": " of rebellion "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall"
                        },
                        {
                            "style": "NONE",
                            "text": " all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " as thorns thrust away,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Because they cannot be taken with hands."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " touches them"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Must be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. filled"
                        },
                        {
                            "style": "NONE",
                            "text": "armed with iron and the shaft of a spear,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And they shall be utterly burned with fire in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " place.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "David’s Mighty Men"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the names of the mighty men whom David had: "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. One Who Sits in the Seat (1 Chr. 11:11)"
                        },
                        {
                            "style": "NONE",
                            "text": "Josheb-Basshebeth the Tachmonite, chief among "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg.; LXX, Vg. the three"
                        },
                        {
                            "style": "NONE",
                            "text": "the captains. He was called Adino the Eznite, because he had killed eight hundred men at one time. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And after him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Eleazar the son of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Dodai, 1 Chr. 27:4"
                        },
                        {
                            "style": "NONE",
                            "text": "Dodo, the Ahohite, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " of the three mighty men with David when they defied the Philistines "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " were gathered there for battle, and the men of Israel had retreated. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He arose and attacked the Philistines until his hand was weary, and his hand stuck to the sword. The "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " brought about a great victory that day; and the people returned after him only to plunder. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And after him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Shammah the son of Agee the Hararite. The Philistines had gathered together into a troop where there was a piece of ground full of lentils. So the people fled from the Philistines. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he stationed himself in the middle of the field, defended it, and killed the Philistines. So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " brought about a great victory."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then three of the thirty chief men went down at harvest time and came to David at the cave of Adullam. And the troop of Philistines encamped in the Valley of Rephaim. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " then in the stronghold, and the garrison of the Philistines "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " then "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " Bethlehem. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David said with longing, “Oh, that someone would give me a drink of the water from the well of Bethlehem, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " by the gate!” "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the three mighty men broke through the camp of the Philistines, drew water from the well of Bethlehem that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " by the gate, and took it and brought "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to David. Nevertheless he would not drink it, but poured it out to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said, “Far be it from me, O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", that I should do this! Is "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this not"
                        },
                        {
                            "style": "NONE",
                            "text": " the blood of the men who went in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "jeopardy of"
                        },
                        {
                            "style": "NONE",
                            "text": " their lives?” Therefore he would not drink it."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "These things were done by the three mighty men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Abishai the brother of Joab, the son of Zeruiah, was chief of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, LXX, Vg.; some Heb. mss., Syr. thirty; Tg. the mighty men"
                        },
                        {
                            "style": "ITALIC",
                            "text": "another"
                        },
                        {
                            "style": "NONE",
                            "text": " three. He lifted his spear against three hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "men,"
                        },
                        {
                            "style": "NONE",
                            "text": " killed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them,"
                        },
                        {
                            "style": "NONE",
                            "text": " and won a name among "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " three. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Was he not the most honored of three? Therefore he became their captain. However, he did not attain to the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "first"
                        },
                        {
                            "style": "NONE",
                            "text": " three."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Benaiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the son of Jehoiada, the son of a valiant man from Kabzeel, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. great of acts"
                        },
                        {
                            "style": "NONE",
                            "text": "who had done many deeds. He had killed two lion-like heroes of Moab. He also had gone down and killed a lion in the midst of a pit on a snowy day. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he killed an Egyptian, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. a man of appearance"
                        },
                        {
                            "style": "NONE",
                            "text": "a spectacular man. The Egyptian "
                        },
                        {
                            "style": "ITALIC",
                            "text": "had"
                        },
                        {
                            "style": "NONE",
                            "text": " a spear in his hand; so he went down to him with a staff, wrested the spear out of the Egyptian’s hand, and killed him with his own spear. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " Benaiah the son of Jehoiada did, and won a name among three mighty men. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was more honored than the thirty, but he did not attain to the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "first"
                        },
                        {
                            "style": "NONE",
                            "text": " three. And David appointed him over his guard."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Asahel the brother of Joab "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one of the thirty; Elhanan the son of Dodo of Bethlehem, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shammah the Harodite, Elika the Harodite, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Helez the Paltite, Ira the son of Ikkesh the Tekoite, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abiezer the Anathothite, Mebunnai the Hushathite, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zalmon the Ahohite, Maharai the Netophathite, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Heleb the son of Baanah (the Netophathite), Ittai the son of Ribai from Gibeah of the children of Benjamin, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Benaiah a Pirathonite, Hiddai from the brooks of Gaash, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abi-Albon the Arbathite, Azmaveth the Barhumite, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eliahba the Shaalbonite (of the sons of Jashen), Jonathan, "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shammah the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Ararite"
                        },
                        {
                            "style": "NONE",
                            "text": "Hararite, Ahiam the son of Sharar the Hararite, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eliphelet the son of Ahasbai, the son of the Maachathite, Eliam the son of Ahithophel the Gilonite, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Hezro, 1 Chr. 11:37"
                        },
                        {
                            "style": "NONE",
                            "text": "Hezrai the Carmelite, Paarai the Arbite, "
                        }
                    ]
                },
                {
