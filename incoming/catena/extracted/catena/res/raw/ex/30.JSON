{
    "chapter_num": 30,
    "verses_count": 38,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Altar of Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make an altar to burn incense on; you shall make it of acacia wood. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A cubit "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its length and a cubit its width—it shall be square—and two cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its height. Its horns "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " of one piece with it. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall overlay its top, its sides all around, and its horns with pure gold; and you shall make for it a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "border"
                        },
                        {
                            "style": "NONE",
                            "text": "molding of gold all around. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Two gold rings you shall make for it, under the molding on both its sides. You shall place "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " on its two sides, and they will be holders for the poles with which to bear it. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make the poles of acacia wood, and overlay them with gold. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put it before the veil that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the ark of the Testimony, before the mercy seat that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " over the Testimony, where I will meet with you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Aaron shall burn on it sweet incense every morning; when he tends the lamps, he shall burn incense on it. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Aaron lights the lamps "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. between the two evenings"
                        },
                        {
                            "style": "NONE",
                            "text": "at twilight, he shall burn incense on it, a perpetual incense before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " throughout your generations. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not offer strange incense on it, or a burnt offering, or a grain offering; nor shall you pour a drink offering on it. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Aaron shall make atonement upon its horns once a year with the blood of the sin offering of atonement; once a year he shall make atonement upon it throughout your generations. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ransom Money"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When you take the census of the children of Israel for their number, then every man shall give a"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "the price of a life"
                        },
                        {
                            "style": "NONE",
                            "text": " ransom for himself to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", when you number them, that there may be no plague among them when "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " number them. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is what everyone among those who are numbered shall give: half a shekel according to the shekel of the sanctuary (a shekel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty gerahs). The half-shekel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " an offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Everyone included among those who are numbered, from twenty years old and above, shall give an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "contribution"
                        },
                        {
                            "style": "NONE",
                            "text": "offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rich shall not give more and the poor shall not give less than half a shekel, when "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " give an offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to make atonement for yourselves. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take the atonement money of the children of Israel, and shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "give"
                        },
                        {
                            "style": "NONE",
                            "text": "appoint it for the service of the tabernacle of meeting, that it may be a memorial for the children of Israel before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to make atonement for yourselves.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Bronze Laver"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "basin"
                        },
                        {
                            "style": "NONE",
                            "text": "laver of bronze, with its base also of bronze, for washing. You shall put it between the tabernacle of meeting and the altar. And you shall put water in it, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for Aaron and his sons shall wash their hands and their feet in water from it. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they go into the tabernacle of meeting, or when they come near the altar to minister, to burn an offering made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", they shall wash with water, lest they die. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they shall wash their hands and their feet, lest they die. And it shall be a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "requirement"
                        },
                        {
                            "style": "NONE",
                            "text": "statute forever to them—to him and his descendants throughout their generations.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Holy Anointing Oil"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Also take for yourself quality spices—five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of liquid myrrh, half as much sweet-smelling cinnamon (two hundred and fifty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": "), two hundred and fifty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of sweet-smelling cane, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of cassia, according to the shekel of the sanctuary, and a hin of olive oil. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make from these a holy anointing oil, an ointment compounded according to the art of the perfumer. It shall be a holy anointing oil. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "With it you shall anoint the tabernacle of meeting and the ark of the Testimony; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the table and all its utensils, the lampstand and its utensils, and the altar of incense; "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the altar of burnt offering with all its utensils, and the laver and its base. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall consecrate them, that they may be most holy; whatever touches them must be holy. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall anoint Aaron and his sons, and consecrate them, that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they"
                        },
                        {
                            "style": "NONE",
                            "text": " may minister to Me as priests."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall speak to the children of Israel, saying: ‘This shall be a holy anointing oil to Me throughout your generations. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall not be poured on man’s flesh; nor shall you make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any other"
                        },
                        {
                            "style": "NONE",
                            "text": " like it, according to its composition. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " holy, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " it shall be holy to you. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "mixes"
                        },
                        {
                            "style": "NONE",
                            "text": "compounds "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " like it, or whoever puts "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " of it on an outsider, shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Put to death"
                        },
                        {
                            "style": "NONE",
                            "text": "cut off from his people.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses: “Take sweet spices, stacte and onycha and galbanum, and pure frankincense with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " sweet spices; there shall be equal amounts of each. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make of these an incense, a compound according to the art of the perfumer, salted, pure, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " holy. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall beat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of it very fine, and put some of it before the Testimony in the tabernacle of meeting where I will meet with you. It shall be most holy to you. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as for"
                        },
                        {
                            "style": "NONE",
                            "text": " the incense which you shall make, you shall not make any for yourselves, according to its "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. proportion"
                        },
                        {
                            "style": "NONE",
                            "text": "composition. It shall be to you holy for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever makes "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " like it, to smell it, he shall be cut off from his people.”"
                        }
                    ]
                }
            ]
        }
    ]
}