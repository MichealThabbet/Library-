{
    "chapter_num": 33,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Command to Leave Sinai"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Depart "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " go up from here, you and the people whom you have brought out of the land of Egypt, to the land of which I swore to Abraham, Isaac, and Jacob, saying, ‘To your descendants I will give it.’ "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will send "
                        },
                        {
                            "style": "ITALIC",
                            "text": "My"
                        },
                        {
                            "style": "NONE",
                            "text": " Angel before you, and I will drive out the Canaanite and the Amorite and the Hittite and the Perizzite and the Hivite and the Jebusite. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Go up"
                        },
                        {
                            "style": "NONE",
                            "text": " to a land flowing with milk and honey; for I will not go up in your midst, lest I "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "destroy"
                        },
                        {
                            "style": "NONE",
                            "text": "consume you on the way, for you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " a stiff-necked"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "stubborn"
                        },
                        {
                            "style": "NONE",
                            "text": " people.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when the people heard this bad news, they mourned, and no one put on his ornaments. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had said to Moses, “Say to the children of Israel, ‘You "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " a stiff-necked people. I could come up into your midst in one moment and consume you. Now therefore, take off your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "jewelry"
                        },
                        {
                            "style": "NONE",
                            "text": "ornaments, that I may know what to do to you.’ ” "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the children of Israel stripped themselves of their ornaments by Mount Horeb."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Moses Meets with the Lord"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moses took his tent and pitched it outside the camp, far from the camp, and called it the tabernacle of meeting. And it came to pass "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " everyone who sought the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " went out to the tabernacle of meeting which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " outside the camp. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it was, whenever Moses went out to the tabernacle, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " all the people rose, and each man stood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "at"
                        },
                        {
                            "style": "NONE",
                            "text": " his tent door and watched Moses until he had gone into the tabernacle. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it came to pass, when Moses entered the tabernacle, that the pillar of cloud descended and stood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "at"
                        },
                        {
                            "style": "NONE",
                            "text": " the door of the tabernacle, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " talked with Moses. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the people saw the pillar of cloud standing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "at"
                        },
                        {
                            "style": "NONE",
                            "text": " the tabernacle door, and all the people rose and worshiped, each man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " his tent door. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses face to face, as a man speaks to his friend. And he would return to the camp, but his servant Joshua the son of Nun, a young man, did not depart from the tabernacle."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Promise of God’s Presence"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses said to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", “See, You say to me, ‘Bring up this people.’ But You have not let me know whom You will send with me. Yet You have said, ‘I know you by name, and you have also found grace in My sight.’ "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now therefore, I pray, if I have found grace in Your sight, show me now Your way, that I may know You and that I may find grace in Your sight. And consider that this nation "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Your people.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said, “My Presence will go "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with you,"
                        },
                        {
                            "style": "NONE",
                            "text": " and I will give you rest.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to Him, “If Your Presence does not go "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with us,"
                        },
                        {
                            "style": "NONE",
                            "text": " do not bring us up from here. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For how then will it be known that Your people and I have found grace in Your sight, except You go with us? So we shall be separate, Your people and I, from all the people who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " upon the face of the earth.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “I will also do this thing that you have spoken; for you have found grace in My sight, and I know you by name.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said, “Please, show me Your glory.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He said, “I will make all My goodness pass before you, and I will proclaim the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " before you. I will be gracious to whom I will be gracious, and I will have compassion on whom I will have compassion.” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But He said, “You cannot see My face; for no man shall see Me, and live.” "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said, “Here is a place by Me, and you shall stand on the rock. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it shall be, while My glory passes by, that I will put you in the cleft of the rock, and will cover you with My hand while I pass by. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I will take away My hand, and you shall see My back; but My face shall not be seen.”"
                        }
                    ]
                }
            ]
        }
    ]
}