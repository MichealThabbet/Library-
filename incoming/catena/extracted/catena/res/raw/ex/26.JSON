{
    "chapter_num": 26,
    "verses_count": 37,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Moreover you shall make the tabernacle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " ten curtains "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine woven linen and blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread;"
                        },
                        {
                            "style": "NONE",
                            "text": " with artistic designs of cherubim you shall weave them. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The length of each curtain "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-eight cubits, and the width of each curtain four cubits. And every one of the curtains shall have "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. one measure"
                        },
                        {
                            "style": "NONE",
                            "text": "the same measurements. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Five curtains shall be coupled to one another, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the other"
                        },
                        {
                            "style": "NONE",
                            "text": " five curtains "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " coupled to one another. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make loops of blue "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yarn"
                        },
                        {
                            "style": "NONE",
                            "text": " on the edge of the curtain on the selvedge of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " set, and likewise you shall do on the outer edge of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the other"
                        },
                        {
                            "style": "NONE",
                            "text": " curtain of the second set. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Fifty loops you shall make in the one curtain, and fifty loops you shall make on the edge of the curtain that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the end of the second set, that the loops may be clasped to one another. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make fifty clasps of gold, and couple the curtains together with the clasps, so that it may be one tabernacle."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make curtains of goats’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hair,"
                        },
                        {
                            "style": "NONE",
                            "text": " to be a tent over the tabernacle. You shall make eleven curtains. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The length of each curtain "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " thirty cubits, and the width of each curtain four cubits; and the eleven curtains shall all have the same measurements. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall couple five curtains by themselves and six curtains by themselves, and you shall double over the sixth curtain at the forefront of the tent. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make fifty loops on the edge of the curtain that is outermost in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " set, and fifty loops on the edge of the curtain of the second set. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make fifty bronze clasps, put the clasps into the loops, and couple the tent together, that it may be one. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The remnant that remains of the curtains of the tent, the half curtain that remains, shall hang over the back of the tabernacle. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And a cubit on one side and a cubit on the other side, of what remains of the length of the curtains of the tent, shall hang over the sides of the tabernacle, on this side and on that side, to cover it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make a covering of ram skins dyed red for the tent, and a covering of badger skins above that."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And for the tabernacle you shall make the boards of acacia wood, standing upright. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ten cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " the length of a board, and a cubit and a half "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " the width of each board. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Two "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Projections for joining, lit. hands"
                        },
                        {
                            "style": "NONE",
                            "text": "tenons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " in each board for binding one to another. Thus you shall make for all the boards of the tabernacle. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make the boards for the tabernacle, twenty boards for the south side. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make forty sockets of silver under the twenty boards: two sockets under each of the boards for its two tenons. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And for the second side of the tabernacle, the north side, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty boards "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and their forty sockets of silver: two sockets under each of the boards. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the far side of the tabernacle, westward, you shall make six boards. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall also make two boards for the two back corners of the tabernacle. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. doubled"
                        },
                        {
                            "style": "NONE",
                            "text": "coupled together at the bottom and they shall be coupled together at the top by one ring. Thus it shall be for both of them. They shall be for the two corners. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So there shall be eight boards with their sockets of silver—sixteen sockets—two sockets under each of the boards."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall make bars of acacia wood: five for the boards on one side of the tabernacle, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "five bars for the boards on the other side of the tabernacle, and five bars for the boards of the side of the tabernacle, for the far side westward. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The middle bar shall pass through the midst of the boards from end to end. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall overlay the boards with gold, make their rings of gold "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " holders for the bars, and overlay the bars with gold. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall raise up the tabernacle according to its pattern which you were shown on the mountain."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make a veil woven of blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen. It shall be woven with an artistic design of cherubim. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall hang it upon the four pillars of acacia "
                        },
                        {
                            "style": "ITALIC",
                            "text": "wood"
                        },
                        {
                            "style": "NONE",
                            "text": " overlaid with gold. Their hooks "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " gold, upon four sockets of silver. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall hang the veil from the clasps. Then you shall bring the ark of the Testimony in there, behind the veil. The veil shall be a divider for you between the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": " and the Most Holy. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall put the mercy seat upon the ark of the Testimony in the Most Holy. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall set the table outside the veil, and the lampstand across from the table on the side of the tabernacle toward the south; and you shall put the table on the north side."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make a screen for the door of the tabernacle, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "woven of"
                        },
                        {
                            "style": "NONE",
                            "text": " blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen, made by a weaver. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make for the screen five pillars of acacia "
                        },
                        {
                            "style": "ITALIC",
                            "text": "wood,"
                        },
                        {
                            "style": "NONE",
                            "text": " and overlay them with gold; their hooks "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " gold, and you shall cast five sockets of bronze for them."
                        }
                    ]
                }
            ]
        }
    ]
}