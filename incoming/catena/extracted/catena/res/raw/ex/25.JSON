{
    "chapter_num": 25,
    "verses_count": 40,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Offerings for the Sanctuary"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, that they bring Me an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "heave offering"
                        },
                        {
                            "style": "NONE",
                            "text": "offering. From everyone who gives it willingly with his heart you shall take My offering. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the offering which you shall take from them: gold, silver, and bronze; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " fine linen, and goats’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hair;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "ram skins dyed red, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or dolphin"
                        },
                        {
                            "style": "NONE",
                            "text": "badger skins, and acacia wood; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "oil for the light, and spices for the anointing oil and for the sweet incense; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "onyx stones, and stones to be set in the ephod and in the breastplate. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And let them make Me a sanctuary,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sacred place"
                        },
                        {
                            "style": "NONE",
                            "text": " that I may dwell among them. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "According to all that I show you, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " the pattern of the tabernacle and the pattern of all its furnishings, just so you shall make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ark of the Testimony"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And they shall make an ark of acacia wood; two and a half cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its length, a cubit and a half its width, and a cubit and a half its height. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall overlay it with pure gold, inside and out you shall overlay it, and shall make on it a molding of gold all around. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall cast four rings of gold for it, and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " in its four corners; two rings "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " on one side, and two rings on the other side. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make poles "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " acacia wood, and overlay them with gold. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall put the poles into the rings on the sides of the ark, that the ark may be carried by them. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The poles shall be in the rings of the ark; they shall not be taken from it. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put into the ark the Testimony which I will give you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make a mercy seat of pure gold; two and a half cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its length and a cubit and a half its width. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make two cherubim of gold; of hammered work you shall make them at the two ends of the mercy seat. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Make one cherub at one end, and the other cherub at the other end; you shall make the cherubim at the two ends of it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of one piece"
                        },
                        {
                            "style": "NONE",
                            "text": " with the mercy seat. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the cherubim shall stretch out "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " wings above, covering the mercy seat with their wings, and they shall face one another; the faces of the cherubim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " toward the mercy seat. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall put the mercy seat on top of the ark, and in the ark you shall put the Testimony that I will give you. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there I will meet with you, and I will speak with you from above the mercy seat, from between the two cherubim which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " on the ark of the Testimony, about everything which I will give you in commandment to the children of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Table for the Showbread"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make a table of acacia wood; two cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its length, a cubit its width, and a cubit and a half its height. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall overlay it with pure gold, and make a molding of gold all around. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make for it a frame of a handbreadth all around, and you shall make a gold molding for the frame all around. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make for it four rings of gold, and put the rings on the four corners that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " at its four legs. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rings shall be close to the frame, as holders for the poles to bear the table. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make the poles of acacia wood, and overlay them with gold, that the table may be carried with them. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make its dishes, its pans, its pitchers, and its bowls for pouring. You shall make them of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall set the showbread on the table before Me always."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Gold Lampstand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make a lampstand of pure gold; the lampstand shall be of hammered work. Its shaft, its branches, its bowls, its "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knobs, and flowers shall be "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of one piece."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And six branches shall come out of its sides: three branches of the lampstand out of one side, and three branches of the lampstand out of the other side. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Three bowls "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms"
                        },
                        {
                            "style": "NONE",
                            "text": " on one branch, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " an "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and a flower, and three bowls made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms"
                        },
                        {
                            "style": "NONE",
                            "text": " on the other branch, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " an "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and a flower—and so for the six branches that come out of the lampstand. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the lampstand itself four bowls "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms, each with"
                        },
                        {
                            "style": "NONE",
                            "text": " its "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and flower. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "first"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "second"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, and a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "third"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, according to the six branches that extend from the lampstand. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their knobs and their branches "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be of one piece;"
                        },
                        {
                            "style": "NONE",
                            "text": " all of it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " one hammered piece of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make seven lamps for it, and they shall arrange its lamps so that they give light in front of it. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And its wick-trimmers and their trays "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be made of a talent of pure gold, with all these utensils. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And see to it that you make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " according to the pattern which was shown you on the mountain."
                        }
                    ]
                }
            ]
        }
    ]
}