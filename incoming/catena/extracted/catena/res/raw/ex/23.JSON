{
    "chapter_num": 23,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Justice for All"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not circulate a false report. Do not put your hand with the wicked to be an unrighteous witness. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not follow a crowd to do evil; nor shall you testify in a dispute so as to turn aside after many to pervert "
                        },
                        {
                            "style": "ITALIC",
                            "text": "justice."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not show partiality to a poor man in his dispute."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you meet your enemy’s ox or his donkey going astray, you shall surely bring it back to him again. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you see the donkey of one who hates you lying under its burden, and you would refrain from helping it, you shall surely help him with it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not pervert the judgment of your poor in his dispute. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Keep yourself far from a false matter; do not kill the innocent and righteous. For I will not justify the wicked. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take no bribe, for a bribe blinds the discerning and perverts the words of the righteous."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Also you shall not oppress a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sojourner"
                        },
                        {
                            "style": "NONE",
                            "text": "stranger, for you know the heart of a stranger, because you were strangers in the land of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law of Sabbaths"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Six years you shall sow your land and gather in its produce, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but the seventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "year"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall let it rest and lie fallow, that the poor of your people may eat; and what they leave, the beasts of the field may eat. In like manner you shall do with your vineyard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "olive yards"
                        },
                        {
                            "style": "NONE",
                            "text": "olive grove. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Six days you shall do your work, and on the seventh day you shall rest, that your ox and your donkey may rest, and the son of your female servant and the stranger may be refreshed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And in all that I have said to you, be circumspect and make no mention of the name of other gods, nor let it be heard from your mouth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Three Annual Feasts"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Three times you shall keep a feast to Me in the year: "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep the Feast of Unleavened Bread (you shall eat unleavened bread seven days, as I commanded you, at the time appointed in the month of Abib, for in it you came out of Egypt; none shall appear before Me empty); "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Feast of Harvest, the firstfruits of your labors which you have sown in the field; and the Feast of Ingathering at the end of the year, when you have gathered in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the fruit of"
                        },
                        {
                            "style": "NONE",
                            "text": " your labors from the field."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Three times in the year all your males shall appear before the Lord "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. YHWH, usually translated Lord"
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not offer the blood of My sacrifice with leavened bread; nor shall the fat of My "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "feast"
                        },
                        {
                            "style": "NONE",
                            "text": "sacrifice remain until morning. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The first of the firstfruits of your land you shall bring into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. You shall not boil a young goat in its mother’s milk."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Angel and the Promises"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Behold, I send an Angel before you to keep you in the way and to bring you into the place which I have prepared. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beware of Him and obey His voice; do not provoke Him, for He will not pardon your transgressions; for My name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in Him. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if you indeed obey His voice and do all that I speak, then I will be an enemy to your enemies and an adversary to your adversaries. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For My Angel will go before you and bring you in to the Amorites and the Hittites and the Perizzites and the Canaanites and the Hivites and the Jebusites; and I will "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "annihilate them"
                        },
                        {
                            "style": "NONE",
                            "text": "cut them off. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not bow down to their gods, nor serve them, nor do according to their works; but you shall utterly overthrow them and completely break down their "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": " pillars."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“So you shall serve the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, and He will bless your bread and your water. And I will take sickness away from the midst of you. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No one shall suffer miscarriage or be barren in your land; I will fulfill the number of your days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“I will send My fear before you, I will cause confusion among all the people to whom you come, and will make all your enemies turn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " backs to you. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will send hornets before you, which shall drive out the Hivite, the Canaanite, and the Hittite from before you. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will not drive them out from before you in one year, lest the land become desolate and the beasts of the field become too numerous for you. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Little by little I will drive them out from before you, until you have increased, and you inherit the land. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will set your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "boundaries"
                        },
                        {
                            "style": "NONE",
                            "text": "bounds from the Red Sea to the sea, Philistia, and from the desert to the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Nahar, the Euphrates"
                        },
                        {
                            "style": "NONE",
                            "text": "River. For I will deliver the inhabitants of the land into your hand, and you shall drive them out before you. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make no "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "treaty"
                        },
                        {
                            "style": "NONE",
                            "text": "covenant with them, nor with their gods. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall not dwell in your land, lest they make you sin against Me. For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if"
                        },
                        {
                            "style": "NONE",
                            "text": " you serve their gods, it will surely be a snare to you.”"
                        }
                    ]
                }
            ]
        }
    ]
}