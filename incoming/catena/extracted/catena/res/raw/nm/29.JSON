                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine flour mixed with oil: three-tenths "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of an ephah"
                        },
                        {
                            "style": "NONE",
                            "text": " for each of the thirteen bulls, two-tenths for each of the two rams, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and one-tenth for each of the fourteen lambs; "
