{
    "chapter_num": 18,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Duties of Priests and Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Aaron: “You and your sons and your father’s house with you shall bear the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "guilt"
                        },
                        {
                            "style": "NONE",
                            "text": "iniquity "
                        },
                        {
                            "style": "ITALIC",
                            "text": "related to"
                        },
                        {
                            "style": "NONE",
                            "text": " the sanctuary, and you and your sons with you shall bear the iniquity "
                        },
                        {
                            "style": "ITALIC",
                            "text": "associated with"
                        },
                        {
                            "style": "NONE",
                            "text": " your priesthood. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also bring with you your brethren of the tribe of Levi, the tribe of your father, that they may be joined with you and serve you while you and your sons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " with you before the tabernacle of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "testimony"
                        },
                        {
                            "style": "NONE",
                            "text": "witness. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall attend to your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "service"
                        },
                        {
                            "style": "NONE",
                            "text": "needs and all the needs of the tabernacle; but they shall not come near the articles of the sanctuary and the altar, lest they die—they and you also. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be joined with you and attend to the needs of the tabernacle of meeting, for all the work of the tabernacle; but an outsider shall not come near you. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall attend to the duties of the sanctuary and the duties of the altar, that there "
                        },
                        {
                            "style": "ITALIC",
                            "text": "may"
                        },
                        {
                            "style": "NONE",
                            "text": " be no more wrath on the children of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, I Myself have taken your brethren the Levites from among the children of Israel; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they are"
                        },
                        {
                            "style": "NONE",
                            "text": " a gift to you, given by the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to do the work of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you and your sons with you shall attend to your priesthood for everything at the altar and behind the veil; and you shall serve. I give your priesthood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to you"
                        },
                        {
                            "style": "NONE",
                            "text": " as a gift for service, but the outsider who comes near shall be put to death.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Offerings for Support of the Priests"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Aaron: “Here, I Myself have also given you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "custody"
                        },
                        {
                            "style": "NONE",
                            "text": "charge of My heave offerings, all the holy gifts of the children of Israel; I have given them as a portion to you and your sons, as an ordinance forever. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This shall be yours of the most holy things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "reserved"
                        },
                        {
                            "style": "NONE",
                            "text": " from the fire: every offering of theirs, every grain offering and every sin offering and every trespass offering which they render to Me, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy for you and your sons. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In a most holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall eat it; every male shall eat it. It shall be holy to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " yours: the heave offering of their gift, with all the wave offerings of the children of Israel; I have given them to you, and your sons and daughters with you, as an ordinance forever. Everyone who is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "purified"
                        },
                        {
                            "style": "NONE",
                            "text": "clean in your house may eat it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“All the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. fat"
                        },
                        {
                            "style": "NONE",
                            "text": "best of the oil, all the best of the new wine and the grain, their firstfruits which they offer to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", I have given them to you. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whatever first ripe fruit is in their land, which they bring to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", shall be yours. Everyone who is clean in your house may eat it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Every "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": "devoted thing in Israel shall be yours."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Everything that first opens the womb of all flesh, which they bring to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", whether man or beast, shall be yours; nevertheless the firstborn of man you shall surely redeem, and the firstborn of unclean animals you shall redeem. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those redeemed of the devoted things you shall redeem when one month old, according to your valuation, for five shekels of silver, according to the shekel of the sanctuary, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty gerahs. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the firstborn of a cow, the firstborn of a sheep, or the firstborn of a goat you shall not redeem; they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy. You shall sprinkle their blood on the altar, and burn their fat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " an offering made by fire for a sweet aroma to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their flesh shall be yours, just as the wave"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "breast of the wave offering"
                        },
                        {
                            "style": "NONE",
                            "text": " breast and the right thigh are yours."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“All the heave offerings of the holy things, which the children of Israel offer to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", I have given to you and your sons and daughters with you as an ordinance forever; it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a covenant of salt forever before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " with you and your descendants with you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Aaron: “You shall have no inheritance in their land, nor shall you have any portion among them; I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " your portion and your inheritance among the children of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Tithes for Support of the Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Behold, I have given the children of Levi all the tithes in Israel as "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "a possession"
                        },
                        {
                            "style": "NONE",
                            "text": "an inheritance in return for the work which they perform, the work of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hereafter the children of Israel shall not come near the tabernacle of meeting, lest they bear sin and die. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the Levites shall perform the work of the tabernacle of meeting, and they shall bear their iniquity; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever, throughout your generations, that among the children of Israel they shall have no inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the tithes of the children of Israel, which they offer up "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a heave offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", I have given to the Levites "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "for a possession"
                        },
                        {
                            "style": "NONE",
                            "text": "as an inheritance; therefore I have said to them, ‘Among the children of Israel they shall have no inheritance.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Tithe of the Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak thus to the Levites, and say to them: ‘When you take from the children of Israel the tithes which I have given you from them as your inheritance, then you shall offer up a heave offering of it to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", a tenth of the tithe. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And your heave offering shall be reckoned to you as though "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it were"
                        },
                        {
                            "style": "NONE",
                            "text": " the grain of the threshing floor and as the fullness of the winepress. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus you shall also offer a heave offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " from all your tithes which you receive from the children of Israel, and you shall give the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s heave offering from it to Aaron the priest. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of all your gifts you shall offer up every heave offering due to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", from all the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. fat"
                        },
                        {
                            "style": "NONE",
                            "text": "best of them, the consecrated part of them.’ "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you shall say to them: ‘When you have lifted up the best of it, then "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the rest"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be accounted to the Levites as the produce of the threshing floor and as the produce of the winepress. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You may eat it in any place, you and your households, for it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "wages"
                        },
                        {
                            "style": "NONE",
                            "text": "reward for your work in the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall bear no sin because of it, when you have lifted up the best of it. But you shall not profane the holy gifts of the children of Israel, lest you die.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}