{
    "chapter_num": 2,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Solomon Prepares to Build the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon determined to build a temple for the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and a royal house for himself. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Solomon selected seventy thousand men to bear burdens, eighty thousand to quarry "
                        },
                        {
                            "style": "ITALIC",
                            "text": "stone"
                        },
                        {
                            "style": "NONE",
                            "text": " in the mountains, and three thousand six hundred to oversee them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon sent to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Huram; cf. 1 Kin. 5:1"
                        },
                        {
                            "style": "NONE",
                            "text": "Hiram king of Tyre, saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "As you have dealt with David my father, and sent him cedars to build himself a house to dwell in, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "so deal with me."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, I am building a temple for the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God, to dedicate "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to Him, to burn before Him "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. incense of spices"
                        },
                        {
                            "style": "NONE",
                            "text": "sweet incense, for the continual showbread, for the burnt offerings morning and evening, on the Sabbaths, on the New Moons, and on the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "appointed"
                        },
                        {
                            "style": "NONE",
                            "text": "set feasts of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is an ordinance"
                        },
                        {
                            "style": "NONE",
                            "text": " forever to Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the temple which I build "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be"
                        },
                        {
                            "style": "NONE",
                            "text": " great, for our God is greater than all gods. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But who is able to build Him a temple, since heaven and the heaven of heavens cannot contain Him? Who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " I then, that I should build Him a temple, except to burn sacrifice before Him?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore send me at once a man skillful to work in gold and silver, in bronze and iron, in purple and crimson and blue, who has skill to engrave with the skillful men who are with me in Judah and Jerusalem, whom David my father provided. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also send me cedar and cypress and algum logs from Lebanon, for I know that your servants have skill to cut timber in Lebanon; and indeed my servants "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be"
                        },
                        {
                            "style": "NONE",
                            "text": " with your servants, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to prepare timber for me in abundance, for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple which I am about to build "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " great and wonderful."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And indeed I will give to your servants, the woodsmen who cut timber, twenty thousand kors of ground wheat, twenty thousand kors of barley, twenty thousand baths of wine, and twenty thousand baths of oil."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Hiram king of Tyre answered in writing, which he sent to Solomon:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Because the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " loves His people, He has made you king over them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Huram; cf. 1 Kin. 5:1"
                        },
                        {
                            "style": "NONE",
                            "text": "Hiram also said:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel, who made heaven and earth, for He has given King David a wise son, endowed with prudence and understanding, who will build a temple for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and a royal house for himself!"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And now I have sent a skillful man, endowed with understanding, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Hiram, 1 Kin. 7:13"
                        },
                        {
                            "style": "NONE",
                            "text": "Huram my "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. father, 1 Kin. 7:13, 14"
                        },
                        {
                            "style": "NONE",
                            "text": "master "
                        },
                        {
                            "style": "ITALIC",
                            "text": "craftsman"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(the son of a woman of the daughters of Dan, and his father was a man of Tyre), skilled to work in gold and silver, bronze and iron, stone and wood, purple and blue, fine linen and crimson, and to make any engraving and to accomplish any plan which may be given to him, with your skillful men and with the skillful men of my lord David your father."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now therefore, the wheat, the barley, the oil, and the wine which my lord has spoken of, let him send to his servants. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And we will cut wood from Lebanon, as much as you need; we will bring it to you in rafts by sea to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Japho"
                        },
                        {
                            "style": "NONE",
                            "text": "Joppa, and you will carry it up to Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon numbered all the aliens who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the land of Israel, after the census in which David his father had numbered them; and there were found to be one hundred and fifty-three thousand six hundred. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made seventy thousand of them bearers of burdens, eighty thousand stonecutters in the mountain, and three thousand six hundred overseers to make the people work."
                        }
                    ]
                }
            ]
        }
    ]
}