{
    "chapter_num": 5,
    "verses_count": 14,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Ark Brought into the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all the work that Solomon had done for the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was finished; and Solomon brought in the things which his father David had dedicated: the silver and the gold and all the furnishings. And he put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " in the treasuries of the house of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ark Brought into the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Solomon assembled the elders of Israel and all the heads of the tribes, the chief fathers of the children of Israel, in Jerusalem, that they might bring the ark of the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " up from the City of David, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Zion. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore all the men of Israel assembled with the king at the feast, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in the seventh month. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all the elders of Israel came, and the Levites took up the ark. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they brought up the ark, the tabernacle of meeting, and all the holy furnishings that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the tabernacle. The priests and the Levites brought them up. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also King Solomon, and all the congregation of Israel who were assembled with him before the ark, were sacrificing sheep and oxen that could not be counted or numbered for multitude. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priests brought in the ark of the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to its place, into the inner sanctuary of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple, to the Most Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place,"
                        },
                        {
                            "style": "NONE",
                            "text": " under the wings of the cherubim. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the cherubim spread "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " wings over the place of the ark, and the cherubim overshadowed the ark and its poles. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The poles extended so that the ends of the poles of the ark could be seen from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the holy place,"
                        },
                        {
                            "style": "NONE",
                            "text": " in front of the inner sanctuary; but they could not be seen from outside. And "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. it is"
                        },
                        {
                            "style": "NONE",
                            "text": "they are there to this day. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nothing was in the ark except the two tablets which Moses put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there"
                        },
                        {
                            "style": "NONE",
                            "text": " at Horeb, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or where"
                        },
                        {
                            "style": "NONE",
                            "text": "when the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a covenant"
                        },
                        {
                            "style": "NONE",
                            "text": " with the children of Israel, when they had come out of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it came to pass when the priests came out of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Most"
                        },
                        {
                            "style": "NONE",
                            "text": " Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": " (for all the priests who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " present had "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctified themselves, without keeping to their divisions), "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Levites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who were"
                        },
                        {
                            "style": "NONE",
                            "text": " the singers, all those of Asaph and Heman and Jeduthun, with their sons and their brethren, stood at the east end of the altar, clothed in white linen, having cymbals, stringed instruments and harps, and with them one hundred and twenty priests sounding with trumpets— "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "indeed it came to pass, when the trumpeters and singers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " as one, to make one sound to be heard in praising and thanking the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and when they lifted up their voice with the trumpets and cymbals and instruments of music, and praised the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        },
                        {
                            "style": "ITALIC",
                            "text": "saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "For He is"
                        },
                        {
                            "style": "NONE",
                            "text": " good,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For His mercy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "endures"
                        },
                        {
                            "style": "NONE",
                            "text": " forever,”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "that the house, the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", was filled with a cloud, "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that the priests could not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. stand to minister"
                        },
                        {
                            "style": "NONE",
                            "text": "continue ministering because of the cloud; for the glory of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " filled the house of God."
                        }
                    ]
                }
            ]
        }
    ]
}