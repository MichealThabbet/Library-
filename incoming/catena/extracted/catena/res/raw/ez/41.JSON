{
    "chapter_num": 41,
    "verses_count": 26,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Dimensions of the Sanctuary"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he brought me into the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. heykal; the main room in the temple, the holy place, Ex. 26:33"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctuary and measured the doorposts, six cubits wide on one side and six cubits wide on the other side—the width of the tabernacle. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The width of the entryway "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " ten cubits, and the side walls of the entrance "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits on this side and five cubits on the other side; and he measured its length, forty cubits, and its width, twenty cubits."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also he went inside and measured the doorposts, two cubits; and the entrance, six cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "high;"
                        },
                        {
                            "style": "NONE",
                            "text": " and the width of the entrance, seven cubits. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured the length, twenty cubits; and the width, twenty cubits, beyond the sanctuary; and he said to me, “This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the Most Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place."
                        },
                        {
                            "style": "NONE",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Side Chambers on the Wall"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Next, he measured the wall of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple, six cubits. The width of each side chamber all around the temple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " four cubits on every side. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The side chambers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in three stories, one above the other, thirty chambers in each story; they rested on "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the wall"
                        },
                        {
                            "style": "NONE",
                            "text": "ledges which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " for the side chambers all around, that they might be supported, but not fastened to the wall of the temple. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As one went up from story to story, the side chambers became wider all around, because their supporting ledges in the wall of the temple ascended like steps; therefore the width of the structure increased as one went up "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from"
                        },
                        {
                            "style": "NONE",
                            "text": " the lowest "
                        },
                        {
                            "style": "ITALIC",
                            "text": "story"
                        },
                        {
                            "style": "NONE",
                            "text": " to the highest by way of the middle one. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I also saw an elevation all around the temple; it was the foundation of the side chambers, a full rod, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " six cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "high."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The thickness of the outer wall of the side chambers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits, and so also the remaining terrace by the place of the side chambers of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And between "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it and"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "wall"
                        },
                        {
                            "style": "NONE",
                            "text": " chambers was a width of twenty cubits all around the temple on every side. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The doors of the side chambers opened on the terrace, one door toward the north and another toward the south; and the width of the terrace "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits all around."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Building at the Western End"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The building that faced the separating courtyard at its western end "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " seventy cubits wide; the wall of the building "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " five cubits thick all around, and its length ninety cubits."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Dimensions and Design of the Temple Area"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So he measured the temple, one hundred cubits long; and the separating courtyard with the building and its walls "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred cubits long; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also the width of the eastern face of the temple, including the separating courtyard, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred cubits. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured the length of the building behind it, facing the separating courtyard, with its galleries on the one side and on the other side, one hundred cubits, as well as the inner "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or sanctuary"
                        },
                        {
                            "style": "NONE",
                            "text": "temple and the porches of the court, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "their doorposts and the beveled window frames. And the galleries all around their three stories opposite the threshold were paneled with wood from the ground to the windows—the windows were covered— "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from the space above the door, even to the inner "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house; the Most Holy Place"
                        },
                        {
                            "style": "NONE",
                            "text": "room, as well as outside, and on every wall all around, inside and outside, by measure."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it was"
                        },
                        {
                            "style": "NONE",
                            "text": " made with cherubim and palm trees, a palm tree between cherub and cherub. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Each"
                        },
                        {
                            "style": "NONE",
                            "text": " cherub had two faces, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that the face of a man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " toward a palm tree on one side, and the face of a young lion toward a palm tree on the other side; thus "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it was"
                        },
                        {
                            "style": "NONE",
                            "text": " made throughout the temple all around. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "From the floor to the space above the door, and on the wall of the sanctuary, cherubim and palm trees "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " carved."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The doorposts of the temple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " square, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as was"
                        },
                        {
                            "style": "NONE",
                            "text": " the front of the sanctuary; their appearance was similar. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The altar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " of wood, three cubits high, and its length two cubits. Its corners, its length, and its sides "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " of wood; and he said to me, “This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the table that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The temple and the sanctuary had two doors. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The doors had two panels "
                        },
                        {
                            "style": "ITALIC",
                            "text": "apiece,"
                        },
                        {
                            "style": "NONE",
                            "text": " two folding panels: two "
                        },
                        {
                            "style": "ITALIC",
                            "text": "panels"
                        },
                        {
                            "style": "NONE",
                            "text": " for one door and two panels for the other "
                        },
                        {
                            "style": "ITALIC",
                            "text": "door."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Cherubim and palm trees "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " carved on the doors of the temple just as they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " carved on the walls. A wooden canopy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on the front of the vestibule outside. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There were"
                        },
                        {
                            "style": "NONE",
                            "text": " beveled window "
                        },
                        {
                            "style": "ITALIC",
                            "text": "frames"
                        },
                        {
                            "style": "NONE",
                            "text": " and palm trees on one side and on the other, on the sides of the vestibule—also on the side chambers of the temple and on the canopies."
                        }
                    ]
                }
            ]
        }
    ]
}