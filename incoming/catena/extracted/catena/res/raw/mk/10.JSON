{
    "chapter_num": 10,
    "verses_count": 52,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Marriage and Divorce"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He arose from there and came to the region of Judea by the other side of the Jordan. And multitudes gathered to Him again, and as He was accustomed, He taught them again."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Pharisees came and asked Him, “Is it lawful for a man to divorce "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " wife?” testing Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He answered and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“What did Moses command you?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said, “Moses permitted "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a man"
                        },
                        {
                            "style": "NONE",
                            "text": " to write a certificate of divorce, and to dismiss "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her."
                        },
                        {
                            "style": "NONE",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus answered and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Because of the hardness of your heart he wrote you this"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "command"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "precept."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But from the beginning of the creation, God"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘made them male and female.’"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘For this reason a man shall leave his father and mother and be joined to his wife,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "and the two shall become one flesh’; so then they are no longer two, but one flesh."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore what God has joined together, let not man separate.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the house His disciples also asked Him again about the same "
                        },
                        {
                            "style": "ITALIC",
                            "text": "matter."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Whoever divorces his wife and marries another commits adultery against her."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And if a woman divorces her husband and marries another, she commits adultery.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Blesses Little Children"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they brought little children to Him, that He might touch them; but the disciples rebuked those who brought "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when Jesus saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " He was greatly displeased and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Let the little children come to Me, and do not forbid them; for"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "of such is the kingdom of God."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Assuredly, I say to you,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "whoever does not receive the kingdom of God as a little child will"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "by no means enter it.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He took them up in His arms, laid "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " hands on them, and blessed them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Counsels the Rich Young Ruler"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now as He was going out on the road, one came running, knelt before Him, and asked Him, “Good Teacher, what shall I do that I may inherit eternal life?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Why do you call Me good? No one is good but One, that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "God."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "You know the commandments:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘Do not commit adultery,’ ‘Do not murder,’ ‘Do not steal,’ ‘Do not bear false witness,’ ‘Do not defraud,’ ‘Honor your father and your mother.’"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he answered and said to Him, “Teacher, all these things I have kept from my youth.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus, looking at him, loved him, and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“One thing you lack: Go your way,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "sell whatever you have and give to the poor, and you will have"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "treasure in heaven; and come,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "take up the cross, and follow Me.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he was sad at this word, and went away sorrowful, for he had great possessions."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "With God All Things Are Possible"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus looked around and said to His disciples, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“How hard it is for those who have riches to enter the kingdom of God!”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the disciples were astonished at His words. But Jesus answered again and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Children, how hard it is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits for those who trust in riches"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "for those"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "who trust in riches to enter the kingdom of God!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "It is easier for a camel to go through the eye of a needle than for a"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "rich man to enter the kingdom of God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were greatly astonished, saying among themselves, “Who then can be saved?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus looked at them and said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“With men it is impossible, but not"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "with God; for with God all things are possible.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Peter began to say to Him, “See, we have left all and followed You.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus answered and said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Assuredly, I say to you, there is no one who has left house or brothers or sisters or father or mother"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits or wife"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "or wife or children or"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. fields"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "lands, for My sake and the gospel’s,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "who shall not receive a hundredfold now in this time—houses and brothers and sisters and mothers and children and lands, with"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "persecutions—and in the age to come, eternal life."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "But many who are first will be last, and the last first.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus a Third Time Predicts His Death and Resurrection"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now they were on the road, going up to Jerusalem, and Jesus was going before them; and they were amazed. And as they followed they were afraid. Then He took the twelve aside again and began to tell them the things that would happen to Him: "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Behold, we are going up to Jerusalem, and the Son of Man will be betrayed to the chief priests and to the scribes; and they will condemn Him to death and deliver Him to the Gentiles;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "and they will mock Him, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "flog Him with a Roman scourge"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "scourge Him, and spit on Him, and kill Him. And the third day He will rise again.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Greatness Is Serving"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then James and John, the sons of Zebedee, came to Him, saying, “Teacher, we want You to do for us whatever we ask.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“What do you want Me to do for you?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said to Him, “Grant us that we may sit, one on Your right hand and the other on Your left, in Your glory.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“You do not know what you ask. Are you able to drink the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "cup that I drink, and be baptized with the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "baptism that I am baptized with?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said to Him, “We are able.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So Jesus said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“You will indeed drink the cup that I drink, and with the baptism I am baptized with you will be baptized;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "but to sit on My right hand and on My left is not Mine to give, but it is for those"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "for whom it is prepared.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when the ten heard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " they began to be greatly displeased with James and John. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus called them to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Himself"
                        },
                        {
                            "style": "NONE",
                            "text": " and said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“You know that those who are considered rulers over the Gentiles lord it over them, and their great ones exercise authority over them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Yet it shall not be so among you; but whoever desires to become great among you shall be your servant."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And whoever of you desires to be first shall be slave of all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "For even"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Son of Man did not come to be served, but to serve, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "to give His life a ransom for many.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Heals Blind Bartimaeus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now they came to Jericho. As He went out of Jericho with His disciples and a great multitude, blind Bartimaeus, the son of Timaeus, sat by the road begging. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when he heard that it was Jesus of Nazareth, he began to cry out and say, “Jesus, Son of David, have mercy on me!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then many warned him to be quiet; but he cried out all the more, “Son of David, have mercy on me!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus stood still and commanded him to be called."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Then they called the blind man, saying to him, “Be of good cheer. Rise, He is calling you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And throwing aside his garment, he rose and came to Jesus."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus answered and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“What do you want Me to do for you?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The blind man said to Him, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. My Great One"
                        },
                        {
                            "style": "NONE",
                            "text": "“Rabboni, that I may receive my sight.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Go your way;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "your faith has"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. saved you"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "made you well.”"
                        },
                        {
                            "style": "NONE",
                            "text": " And immediately he received his sight and followed Jesus on the road."
                        }
                    ]
                }
            ]
        }
    ]
}