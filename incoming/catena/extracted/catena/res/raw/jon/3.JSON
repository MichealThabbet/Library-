{
    "chapter_num": 3,
    "verses_count": 10,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Jonah Preaches at Nineveh"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to Jonah the second time, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Arise, go to Nineveh, that great city, and preach to it the message that I tell you.” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jonah arose and went to Nineveh, according to the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Now Nineveh was an exceedingly great city, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Exact meaning unknown"
                        },
                        {
                            "style": "NONE",
                            "text": "a three-day journey "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in extent."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jonah began to enter the city on the first day’s walk. Then he cried out and said, “Yet forty days, and Nineveh shall be overthrown!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The People of Nineveh Believe"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the people of Nineveh believed God, proclaimed a fast, and put on sackcloth, from the greatest to the least of them. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then word came to the king of Nineveh; and he arose from his throne and laid aside his robe, covered "
                        },
                        {
                            "style": "ITALIC",
                            "text": "himself"
                        },
                        {
                            "style": "NONE",
                            "text": " with sackcloth and sat in ashes. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he caused "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " to be proclaimed and published throughout Nineveh by the decree of the king and his "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. great ones"
                        },
                        {
                            "style": "NONE",
                            "text": "nobles, saying,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Let neither man nor beast, herd nor flock, taste anything; do not let them eat, or drink water. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But let man and beast be covered with sackcloth, and cry mightily to God; yes, let every one turn from his evil way and from the violence that is in his hands. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Who can tell "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if"
                        },
                        {
                            "style": "NONE",
                            "text": " God will turn and relent, and turn away from His fierce anger, so that we may not perish?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then God saw their works, that they turned from their evil way; and God relented from the disaster that He had said He would bring upon them, and He did not do it."
                        }
                    ]
                }
            ]
        }
    ]
}