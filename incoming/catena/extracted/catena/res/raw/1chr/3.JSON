{
    "chapter_num": 3,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Family of David"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these were the sons of David who were born to him in Hebron: The firstborn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Amnon, by Ahinoam the Jezreelitess; the second, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Chileab, 2 Sam. 3:3"
                        },
                        {
                            "style": "NONE",
                            "text": "Daniel, by Abigail the Carmelitess; "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the third, Absalom the son of Maacah, the daughter of Talmai, king of Geshur; the fourth, Adonijah the son of Haggith; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the fifth, Shephatiah, by Abital; the sixth, Ithream, by his wife Eglah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "These"
                        },
                        {
                            "style": "NONE",
                            "text": " six were born to him in Hebron. There he reigned seven years and six months, and in Jerusalem he reigned thirty-three years. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these were born to him in Jerusalem: "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shammua, 1 Chr. 14:4; 2 Sam. 5:14"
                        },
                        {
                            "style": "NONE",
                            "text": "Shimea, Shobab, Nathan, and Solomon—four by "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Bathsheba, 2 Sam. 11:3"
                        },
                        {
                            "style": "NONE",
                            "text": "Bathshua the daughter of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Eliam, 2 Sam. 11:3"
                        },
                        {
                            "style": "NONE",
                            "text": "Ammiel. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there"
                        },
                        {
                            "style": "NONE",
                            "text": " were Ibhar, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Elishua, 1 Chr. 14:5; 2 Sam. 5:15"
                        },
                        {
                            "style": "NONE",
                            "text": "Elishama, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Elpelet, 1 Chr. 14:5"
                        },
                        {
                            "style": "NONE",
                            "text": "Eliphelet, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nogah, Nepheg, Japhia, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elishama, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Beeliada, 1 Chr. 14:7"
                        },
                        {
                            "style": "NONE",
                            "text": "Eliada, and Eliphelet—nine "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "These were"
                        },
                        {
                            "style": "NONE",
                            "text": " all the sons of David, besides the sons of the concubines, and Tamar their sister."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Solomon"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Solomon’s son "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Rehoboam; "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Abijam, 1 Kin. 15:1"
                        },
                        {
                            "style": "NONE",
                            "text": "Abijah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " his son, Asa his son, Jehoshaphat his son, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoram, 2 Kin. 1:17; 8:16"
                        },
                        {
                            "style": "NONE",
                            "text": "Joram his son, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Azariah or Jehoahaz"
                        },
                        {
                            "style": "NONE",
                            "text": "Ahaziah his son, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoash, 2 Kin. 12:1"
                        },
                        {
                            "style": "NONE",
                            "text": "Joash his son, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Amaziah his son, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Uzziah, Is. 6:1"
                        },
                        {
                            "style": "NONE",
                            "text": "Azariah his son, Jotham his son, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahaz his son, Hezekiah his son, Manasseh his son, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Amon his son, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Josiah his son. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Josiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Johanan the firstborn, the second "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Eliakim, 2 Kin. 23:34"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehoiakim, the third Zedekiah, and the fourth "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoahaz, 2 Kin. 23:31"
                        },
                        {
                            "style": "NONE",
                            "text": "Shallum. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Jehoiakim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoiachin, 2 Kin. 24:8, or Coniah, Jer. 22:24"
                        },
                        {
                            "style": "NONE",
                            "text": "Jeconiah his son "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Mattaniah, 2 Kin. 24:17"
                        },
                        {
                            "style": "NONE",
                            "text": "Zedekiah his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Jeconiah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoiachin, 2 Kin. 24:8, or Coniah, Jer. 22:24"
                        },
                        {
                            "style": "NONE",
                            "text": "Jeconiah "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or the captive were Shealtiel"
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Assir, Shealtiel his son, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Malchiram, Pedaiah, Shenazzar, Jecamiah, Hoshama, and Nedabiah. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Pedaiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Zerubbabel and Shimei. The sons of Zerubbabel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Meshullam, Hananiah, Shelomith their sister, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Hashubah, Ohel, Berechiah, Hasadiah, and Jushab-Hesed—five "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Hananiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Pelatiah and Jeshaiah, the sons of Rephaiah, the sons of Arnan, the sons of Obadiah, and the sons of Shechaniah. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son of Shechaniah was Shemaiah. The sons of Shemaiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Hattush, Igal, Bariah, Neariah, and Shaphat—six "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Neariah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Elioenai, Hezekiah, and Azrikam—three "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Elioenai "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Hodaviah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah, and Anani—seven "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        }
                    ]
                }
            ]
        }
    ]
}