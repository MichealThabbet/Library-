{
    "chapter_num": 29,
    "verses_count": 30,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Offerings for Building the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Furthermore King David said to all the assembly: “My son Solomon, whom alone God has chosen, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " young and inexperienced; and the work "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " great, because the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. palace"
                        },
                        {
                            "style": "NONE",
                            "text": "temple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not for man but for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now for the house of my God I have prepared with all my might: gold for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things to be made of"
                        },
                        {
                            "style": "NONE",
                            "text": " gold, silver for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " silver, bronze for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " bronze, iron for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " iron, wood for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " wood, onyx stones, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "stones"
                        },
                        {
                            "style": "NONE",
                            "text": " to be set, glistening stones of various colors, all kinds of precious stones, and marble slabs in abundance. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover, because I have set my affection on the house of my God, I have given to the house of my God, over and above all that I have prepared for the holy house, my own special treasure of gold and silver: "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "three thousand talents of gold, of the gold of Ophir, and seven thousand talents of refined silver, to overlay the walls of the houses; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the gold for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " gold and the silver for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things of"
                        },
                        {
                            "style": "NONE",
                            "text": " silver, and for all kinds of work "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be done"
                        },
                        {
                            "style": "NONE",
                            "text": " by the hands of craftsmen. Who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "then"
                        },
                        {
                            "style": "NONE",
                            "text": " is willing to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. fill his hand"
                        },
                        {
                            "style": "NONE",
                            "text": "consecrate himself this day to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the leaders of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " leaders of the tribes of Israel, the captains of thousands and of hundreds, with the officers over the king’s work, offered willingly. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They gave for the work of the house of God five thousand talents and ten thousand darics of gold, ten thousand talents of silver, eighteen thousand talents of bronze, and one hundred thousand talents of iron. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever had "
                        },
                        {
                            "style": "ITALIC",
                            "text": "precious"
                        },
                        {
                            "style": "NONE",
                            "text": " stones gave "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to the treasury of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", into the hand of Jehiel"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Possibly the same as Jehieli, 1 Chr. 26:21, 22"
                        },
                        {
                            "style": "NONE",
                            "text": " the Gershonite. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the people rejoiced, for they had offered willingly, because with a loyal heart they had offered willingly to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and King David also rejoiced greatly."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "David’s Praise to God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore David blessed the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " before all the assembly; and David said:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Blessed are You, "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel, our Father, forever and ever."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yours, O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the greatness,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The power and the glory,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The victory and the majesty;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is"
                        },
                        {
                            "style": "NONE",
                            "text": " in heaven and in earth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is Yours;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Yours "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the kingdom, O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ","
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And You are exalted as head over all."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Both riches and honor "
                        },
                        {
                            "style": "ITALIC",
                            "text": "come"
                        },
                        {
                            "style": "NONE",
                            "text": " from You,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And You reign over all."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "In Your hand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " power and might;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "In Your hand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " to make great"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And to give strength to all."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now therefore, our God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "We thank You"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And praise Your glorious name."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " I, and who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " my people,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "That we should be able to offer so willingly as this?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For all things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "come"
                        },
                        {
                            "style": "NONE",
                            "text": " from You,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. of Your hand"
                        },
                        {
                            "style": "NONE",
                            "text": "of Your own we have given You."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sojourners, temporary residents"
                        },
                        {
                            "style": "NONE",
                            "text": "aliens and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "transients, temporary residents in an even more temporary sense"
                        },
                        {
                            "style": "NONE",
                            "text": "pilgrims before You,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "As "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " all our fathers;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Our days on earth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " as a shadow,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And without hope."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God, all this abundance that we have prepared to build You a house for Your holy name is from Your hand, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " all Your own. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I know also, my God, that You test the heart and have pleasure in uprightness. As for me, in the uprightness of my heart I have willingly offered all these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things;"
                        },
                        {
                            "style": "NONE",
                            "text": " and now with joy I have seen Your people, who are present here to offer willingly to You. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Abraham, Isaac, and Israel, our fathers, keep this forever in the intent of the thoughts of the heart of Your people, and fix their heart toward You. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And give my son Solomon a loyal heart to keep Your commandments and Your testimonies and Your statutes, to do all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these things,"
                        },
                        {
                            "style": "NONE",
                            "text": " and to build the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. palace"
                        },
                        {
                            "style": "NONE",
                            "text": "temple for which I have made provision.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then David said to all the assembly, “Now bless the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God.” So all the assembly blessed the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of their fathers, and bowed their heads and prostrated themselves before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and the king."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Solomon Anointed King"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they made sacrifices to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and offered burnt offerings to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " on the next day: a thousand bulls, a thousand rams, a thousand lambs, with their drink offerings, and sacrifices in abundance for all Israel. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they ate and drank before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " with great gladness on that day. And they made Solomon the son of David king the second time, and anointed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "him"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " the leader, and Zadok "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " priest. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon sat on the throne of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " as king instead of David his father, and prospered; and all Israel obeyed him. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the leaders and the mighty men, and also all the sons of King David, submitted"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. gave the hand"
                        },
                        {
                            "style": "NONE",
                            "text": " themselves to King Solomon. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " exalted Solomon exceedingly in the sight of all Israel, and bestowed on him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "such"
                        },
                        {
                            "style": "NONE",
                            "text": " royal majesty as had not been on any king before him in Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Close of David’s Reign"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus David the son of Jesse reigned over all Israel. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the period that he reigned over Israel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " forty years; seven years he reigned in Hebron, and thirty-three "
                        },
                        {
                            "style": "ITALIC",
                            "text": "years"
                        },
                        {
                            "style": "NONE",
                            "text": " he reigned in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
