{
    "chapter_num": 26,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Gatekeepers"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Concerning the divisions of the gatekeepers: of the Korahites, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shelemiah, v. 14"
                        },
                        {
                            "style": "NONE",
                            "text": "Meshelemiah the son of Kore, of the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ebiasaph, 1 Chr. 6:37; 9:19"
                        },
                        {
                            "style": "NONE",
                            "text": "Asaph. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of Meshelemiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Zechariah the firstborn, Jediael the second, Zebadiah the third, Jathniel the fourth, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elam the fifth, Jehohanan the sixth, Eliehoenai the seventh."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover the sons of Obed-Edom "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Shemaiah the firstborn, Jehozabad the second, Joah the third, Sacar the fourth, Nethanel the fifth, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ammiel the sixth, Issachar the seventh, Peulthai the eighth; for God blessed him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also to Shemaiah his son were sons born who governed their fathers’ houses, because they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " men of great ability. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Shemaiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Othni, Rephael, Obed, and Elzabad, whose brothers Elihu and Semachiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " able men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " of the sons of Obed-Edom, they and their sons and their brethren, able men with strength for the work: sixty-two of Obed-Edom."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Meshelemiah had sons and brethren, eighteen able men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also Hosah, of the children of Merari, had sons: Shimri the first (for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "though"
                        },
                        {
                            "style": "NONE",
                            "text": " he was not the firstborn, his father made him the first), "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hilkiah the second, Tebaliah the third, Zechariah the fourth; all the sons and brethren of Hosah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " thirteen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Among these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the divisions of the gatekeepers, among the chief men, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "having"
                        },
                        {
                            "style": "NONE",
                            "text": " duties just like their brethren, to serve in the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they cast lots for each gate, the small as well as the great, according to their father’s house. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The lot for the East "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Gate"
                        },
                        {
                            "style": "NONE",
                            "text": " fell to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Meshelemiah, v. 1"
                        },
                        {
                            "style": "NONE",
                            "text": "Shelemiah. Then they cast lots "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " his son Zechariah, a wise counselor, and his lot came out for the North Gate; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to Obed-Edom the South Gate, and to his sons the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. asuppim"
                        },
                        {
                            "style": "NONE",
                            "text": "storehouse. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To Shuppim and Hosah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the lot came out"
                        },
                        {
                            "style": "NONE",
                            "text": " for the West Gate, with the Shallecheth Gate on the ascending highway—watchman opposite watchman. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the east "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " six Levites, on the north four each day, on the south four each day, and for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. asuppim"
                        },
                        {
                            "style": "NONE",
                            "text": "storehouse two by two. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Probably a court or colonnade extending west of the temple"
                        },
                        {
                            "style": "NONE",
                            "text": "Parbar on the west, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there were"
                        },
                        {
                            "style": "NONE",
                            "text": " four on the highway "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " two at the Parbar. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These were the divisions of the gatekeepers among the sons of Korah and among the sons of Merari."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Treasuries and Other Duties"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the Levites, Ahijah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the treasuries of the house of God and over the treasuries of the dedicated"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "holy things"
                        },
                        {
                            "style": "NONE",
                            "text": " things. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Libni, 1 Chr. 6:17"
                        },
                        {
                            "style": "NONE",
                            "text": "Laadan, the descendants of the Gershonites of Laadan, heads of their fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " of Laadan the Gershonite: "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehiel, 1 Chr. 23:8; 29:8"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehieli. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Jehieli, Zetham and Joel his brother, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " over the treasuries of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the Amramites, the Izharites, the Hebronites, and the Uzzielites: "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shebuel the son of Gershom, the son of Moses, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " overseer of the treasuries. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And his brethren by Eliezer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Rehabiah his son, Jeshaiah his son, Joram his son, Zichri his son, and Shelomith his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This Shelomith and his brethren "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " over all the treasuries of the dedicated things which King David and the heads of fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " the captains over thousands and hundreds, and the captains of the army, had dedicated. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Some of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "plunder"
                        },
                        {
                            "style": "NONE",
                            "text": "spoils won in battles they dedicated to maintain the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all that Samuel the seer, Saul the son of Kish, Abner the son of Ner, and Joab the son of Zeruiah had dedicated, every dedicated "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thing,"
                        },
                        {
                            "style": "NONE",
                            "text": " was under the hand of Shelomith and his brethren."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the Izharites, Chenaniah and his sons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "performed"
                        },
                        {
                            "style": "NONE",
                            "text": " duties as officials and judges over Israel outside Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the Hebronites, Hashabiah and his brethren, one thousand seven hundred able men, had the oversight of Israel on the west side of the Jordan for all the business of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and in the service of the king. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Among the Hebronites, Jerijah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " head of the Hebronites according to his genealogy of the fathers. In the fortieth year of the reign of David they were sought, and there were found among them capable men at Jazer of Gilead. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And his brethren "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " two thousand seven hundred able men, heads of fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " whom King David made officials over the Reubenites, the Gadites, and the half-tribe of Manasseh, for every matter pertaining to God and the affairs of the king."
                        }
                    ]
                }
            ]
        }
    ]
}