{
    "chapter_num": 2,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Not Philosophy but Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I want you to know what a great conflict"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "struggle"
                        },
                        {
                            "style": "NONE",
                            "text": " I have for you and those in Laodicea, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " as many as have not seen my face in the flesh, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that their hearts may be encouraged, being knit together in love, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "attaining"
                        },
                        {
                            "style": "NONE",
                            "text": " to all riches of the full assurance of understanding, to the knowledge of the mystery of God, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits both of the Father and"
                        },
                        {
                            "style": "NONE",
                            "text": "both of the Father and of Christ, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in whom are hidden all the treasures of wisdom and knowledge."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now this I say lest anyone should deceive you with persuasive words. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For though I am absent in the flesh, yet I am with you in spirit, rejoicing "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. and seeing"
                        },
                        {
                            "style": "NONE",
                            "text": "to see your "
                        },
                        {
                            "style": "ITALIC",
                            "text": "good"
                        },
                        {
                            "style": "NONE",
                            "text": " order and the steadfastness of your faith in Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As you therefore have received Christ Jesus the Lord, so walk in Him, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "rooted and built up in Him and established in the faith, as you have been taught, abounding "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits in it"
                        },
                        {
                            "style": "NONE",
                            "text": "in it with thanksgiving."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beware lest anyone "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. plunder you or take you captive"
                        },
                        {
                            "style": "NONE",
                            "text": "cheat you through philosophy and empty deceit, according to the tradition of men, according to the basic principles of the world, and not according to Christ. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in Him dwells all the fullness of the Godhead "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "in bodily form"
                        },
                        {
                            "style": "NONE",
                            "text": "bodily; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you are complete in Him, who is the head of all "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "rule and authority"
                        },
                        {
                            "style": "NONE",
                            "text": "principality and power."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Not Legalism but Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In Him you were also circumcised with the circumcision made without hands, by putting off the body "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits of the sins"
                        },
                        {
                            "style": "NONE",
                            "text": "of the sins of the flesh, by the circumcision of Christ, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "buried with Him in baptism, in which you also were raised with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him"
                        },
                        {
                            "style": "NONE",
                            "text": " through faith in the working of God, who raised Him from the dead. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, being dead in your trespasses and the uncircumcision of your flesh, He has made alive together with Him, having forgiven you all trespasses, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having wiped out the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "certificate of debt with its"
                        },
                        {
                            "style": "NONE",
                            "text": "handwriting of requirements that was against us, which was contrary to us. And He has taken it out of the way, having nailed it to the cross. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Having disarmed principalities and powers, He made a public spectacle of them, triumphing over them in it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So let no one judge you in food or in drink, or regarding a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "feast day"
                        },
                        {
                            "style": "NONE",
                            "text": "festival or a new moon or sabbaths, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which are a shadow of things to come, but the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. body"
                        },
                        {
                            "style": "NONE",
                            "text": "substance is of Christ. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let no one cheat you of your reward, taking delight in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "false"
                        },
                        {
                            "style": "NONE",
                            "text": " humility and worship of angels, intruding into those things which he has "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits not"
                        },
                        {
                            "style": "NONE",
                            "text": "not seen, vainly puffed up by his fleshly mind, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and not holding fast to the Head, from whom all the body, nourished and knit together by joints and ligaments, grows with the increase "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is"
                        },
                        {
                            "style": "NONE",
                            "text": " from God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit Therefore"
                        },
                        {
                            "style": "NONE",
                            "text": "Therefore, if you died with Christ from the basic principles of the world, why, as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "though"
                        },
                        {
                            "style": "NONE",
                            "text": " living in the world, do you subject yourselves to regulations— "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Do not touch, do not taste, do not handle,” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which all concern things which perish with the using—according to the commandments and doctrines of men? "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These things indeed have an appearance of wisdom in self-imposed religion, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "false"
                        },
                        {
                            "style": "NONE",
                            "text": " humility, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "severe treatment, asceticism"
                        },
                        {
                            "style": "NONE",
                            "text": "neglect of the body, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "but are"
                        },
                        {
                            "style": "NONE",
                            "text": " of no value against the indulgence of the flesh."
                        }
                    ]
                }
            ]
        }
    ]
}