{
    "chapter_num": 3,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Dead Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And to the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or messenger"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "angel of the church in Sardis write,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘These things says He who"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "has the seven Spirits of God and the seven stars: “I know your works, that you have a name that you are alive, but you are dead."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Be watchful, and strengthen the things which remain, that are ready to die, for I have not found your works perfect before"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M My God"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "God."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Remember therefore how you have received and heard; hold fast and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "repent."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore if you will not watch, I will come upon you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "as a thief, and you will not know what hour I will come upon you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M Nevertheless you"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "You have"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "a few names"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit even"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "even in Sardis who have not"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "defiled their garments; and they shall walk with Me"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "in white, for they are worthy."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who overcomes"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "shall be clothed in white garments, and I will not"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "blot out his name from the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Book of Life; but"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I will confess his name before My Father and before His angels."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“He who has an ear, let him hear what the Spirit says to the churches.” ’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Faithful Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And to the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or messenger"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "angel of the church in Philadelphia write,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘These things says"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who is holy,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who is true,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“He who has the key of David,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who opens and no one shuts, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "shuts and no one opens”:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I know your works. See, I have set before you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "an open door,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M which no one can shut"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "and no one can shut it; for you have a little strength, have kept My word, and have not denied My name."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Indeed I will make"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "those of the synagogue of Satan, who say they are Jews and are not, but lie—indeed"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I will make them come and worship before your feet, and to know that I have loved you."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Because you have kept"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the word of My patience"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "My command to persevere,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I also will keep you from the hour of trial which shall come upon"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the whole world, to test those who dwell"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "on the earth."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit Behold"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Behold,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I am coming quickly!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Hold fast what you have, that no one may take"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "your crown."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "He who overcomes, I will make him"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "a pillar in the temple of My God, and he shall"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "go out no more."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I will write on him the name of My God and the name of the city of My God, the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "New Jerusalem, which"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "comes down out of heaven from My God."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "And I will write on him My new name."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“He who has an ear, let him hear what the Spirit says to the churches.” ’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Lukewarm Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And to the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or messenger"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "angel of the church"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M in Laodicea"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "of the Laodiceans write,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘These things says the Amen,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Faithful and True Witness,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Beginning of the creation of God:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I know your works, that you are neither cold nor hot. I could wish you were cold or hot."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "So then, because you are lukewarm, and neither"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M hot nor cold"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "cold nor hot, I will vomit you out of My mouth."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Because you say,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘I am rich, have become wealthy, and have need of nothing’—and do not know that you are wretched, miserable, poor, blind, and naked—"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I counsel you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "to buy from Me gold refined in the fire, that you may be rich; and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "white garments, that you may be clothed, that the shame of your nakedness may not be revealed; and anoint your eyes with eye salve, that you may see."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "As many as I love, I rebuke and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "chasten."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "discipline"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Therefore be"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "eager"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "zealous and repent."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Behold,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I stand at the door and knock."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "If anyone hears My voice and opens the door,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I will come in to him and dine with him, and he with Me."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "To him who overcomes"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I will grant to sit with Me on My throne, as I also overcame and sat down with My Father on His throne."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“He who has an ear, let him hear what the Spirit says to the churches.” ’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}