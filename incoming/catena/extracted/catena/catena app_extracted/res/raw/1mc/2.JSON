{
    "chapter_num": 2,
    "verses_count": 70,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Mattathias and His Sons"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In those days Mattathi′as the son of John, son of Sim′eon, a priest of the sons of Jo′arib, moved from Jerusalem and settled in Mo′de-in. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He had five sons, John surnamed Gaddi, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Simon called Thassi, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Judas called Maccabe′us, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elea′zar called Av′aran, and Jonathan called Apphus. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He saw the blasphemies being committed in Judah and Jerusalem, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Alas! Why was I born to see this,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tthe ruin of my people, the ruin of the holy city,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "and to dwell there when it was given over to the enemy,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tthe sanctuary given over to aliens?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Her temple has become like a man without honor;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The text of this verse is uncertain"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\ther glorious vessels have been carried into captivity."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Her babes have been killed in her streets,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\ther youths by the sword of the foe."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What nation has not inherited her palaces"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other authorities read has not had a part in her kingdom"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tand has not seized her spoils?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All her adornment has been taken away;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tno longer free, she has become a slave."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, our holy place, our beauty,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tand our glory have been laid waste;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "the Gentiles have profaned it."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tWhy should we live any longer?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Mattathi′as and his sons rent their clothes, put on sackcloth, and mourned greatly."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Pagan Worship Refused"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the king’s officers who were enforcing the apostasy came to the city of Mo′de-in to make them offer sacrifice. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Many from Israel came to them; and Mattathi′as and his sons were assembled. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the king’s officers spoke to Mattathi′as as follows: “You are a leader, honored and great in this city, and supported by sons and brothers. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now be the first to come and do what the king commands, as all the Gentiles and the men of Judah and those that are left in Jerusalem have done. Then you and your sons will be numbered among the friends of the king, and you and your sons will be honored with silver and gold and many gifts.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Mattathi′as answered and said in a loud voice: “Even if all the nations that live under the rule of the king obey him, and have chosen to do his commandments, departing each one from the religion of his fathers, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "yet I and my sons and my brothers will live by the covenant of our fathers. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Far be it from us to desert the law and the ordinances. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We will not obey the king’s words by turning aside from our religion to the right hand or to the left.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When he had finished speaking these words, a Jew came forward in the sight of all to offer sacrifice upon the altar in Mo′de-in, according to the king’s command. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Mattathi′as saw it, be burned with zeal and his heart was stirred. He gave vent to righteous anger; he ran and killed him upon the altar. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At the same time he killed the king’s officer who was forcing them to sacrifice, and he tore down the altar. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus he burned with zeal for the law, as Phin′ehas did against Zimri the son of Salu."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Mattathi′as cried out in the city with a loud voice, saying: “Let every one who is zealous for the law and supports the covenant come out with me!” "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he and his sons fled to the hills and left all that they had in the city."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then many who were seeking righteousness and justice went down to the wilderness to dwell there, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "they, their sons, their wives, and their cattle, because evils pressed heavily upon them. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it was reported to the king’s officers, and to the troops in Jerusalem the city of David, that men who had rejected the king’s command had gone down to the hiding places in the wilderness. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Many pursued them, and overtook them; they encamped opposite them and prepared for battle against them on the sabbath day. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they said to them, “Enough of this! Come out and do what the king commands, and you will live.” "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they said, “We will not come out, nor will we do what the king commands and so profane the sabbath day.” "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the enemy"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk they"
                        },
                        {
                            "style": "NONE",
                            "text": " hastened to attack them. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they did not answer them or hurl a stone at them or block up their hiding places, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for they said, “Let us all die in our innocence; heaven and earth testify for us that you are killing us unjustly.” "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they attacked them on the sabbath, and they died, with their wives and children and cattle, to the number of a thousand persons."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Mattathi′as and his friends learned of it, they mourned for them deeply. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And each said to his neighbor: “If we all do as our brethren have done and refuse to fight with the Gentiles for our lives and our ordinances, they will quickly destroy us from the earth.” "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they made this decision that day: “Let us fight against every man who comes to attack us on the sabbath day; let us not all die as our brethren died in their hiding places.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Counter-Attack"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then there united with them a company of Haside′ans, mighty warriors of Israel, every one who offered himself willingly for the law. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all who became fugitives to escape their troubles joined them and reinforced them. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They organized an army, and struck down sinners in their anger and lawless men in their wrath; the survivors fled to the Gentiles for safety. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Mattathi′as and his friends went about and tore down the altars; "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "they forcibly circumcised all the uncircumcised boys that they found within the borders of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They hunted down the arrogant men, and the work prospered in their hands. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They rescued the law out of the hands of the Gentiles and kings, and they never let the sinner gain the upper hand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Last Words of Mattathias"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the days drew near for Mattathi′as to die, and he said to his sons: “Arrogance and reproach have now become strong; it is a time of ruin and furious anger. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now, my children, show zeal for the law, and give your lives for the covenant of our fathers."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Remember the deeds of the fathers, which they did in their generations; and receive great honor and an everlasting name. "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Was not Abraham found faithful when tested, and it was reckoned to him as righteousness? "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joseph in the time of his distress kept the commandment, and became lord of Egypt. "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Phin′ehas our father, because he was deeply zealous, received the covenant of everlasting priesthood. "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joshua, because he fulfilled the command, became a judge in Israel. "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Caleb, because he testified in the assembly, received an inheritance in the land. "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David, because he was merciful, inherited the throne of the kingdom for ever. "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eli′jah because of great zeal for the law was taken up into heaven. "
                        }
                    ]
                },
                {
                    "num_int": 59,
                    "num_str": "59",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hanani′ah, Azari′ah, and Mish′a-el believed and were saved from the flame. "
                        }
                    ]
                },
                {
                    "num_int": 60,
                    "num_str": "60",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Daniel because of his innocence was delivered from the mouth of the lions."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 61,
                    "num_str": "61",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And so observe, from generation to generation, that none who put their trust in him will lack strength. "
                        }
                    ]
                },
                {
                    "num_int": 62,
                    "num_str": "62",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not fear the words of a sinner, for his splendor will turn into dung and worms. "
                        }
                    ]
                },
                {
                    "num_int": 63,
                    "num_str": "63",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Today he will be exalted, but tomorrow he will not be found, because he has returned to the dust, and his plans will perish. "
                        }
                    ]
                },
                {
                    "num_int": 64,
                    "num_str": "64",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "My children, be courageous and grow strong in the law, for by it you will gain honor."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 65,
                    "num_str": "65",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now behold, I know that Sim′eon your brother is wise in counsel; always listen to him; he shall be your father. "
                        }
                    ]
                },
                {
                    "num_int": 66,
                    "num_str": "66",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Judas Maccabe′us has been a mighty warrior from his youth; he shall command the army for you and fight the battle against the peoples."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or of the people"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 67,
                    "num_str": "67",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall rally about you all who observe the law, and avenge the wrong done to your people. "
                        }
                    ]
                },
                {
                    "num_int": 68,
                    "num_str": "68",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Pay back the Gentiles in full, and heed what the law commands.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 69,
                    "num_str": "69",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he blessed them, and was gathered to his fathers. "
                        }
                    ]
                },
                {
                    "num_int": 70,
                    "num_str": "70",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He died in the one hundred and forty-sixth year"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "166 b.c."
                        },
                        {
                            "style": "NONE",
                            "text": " and was buried in the tomb of his fathers at Mo′de-in. And all Israel mourned for him with great lamentation."
                        }
                    ]
                }
            ]
        }
    ]
}