{
    "chapter_num": 28,
    "verses_count": 43,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Garments for the Priesthood"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now take Aaron your brother, and his sons with him, from among the children of Israel, that he may minister to Me as priest, Aaron "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Aaron’s sons: Nadab, Abihu, Eleazar, and Ithamar. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": "holy garments for Aaron your brother, for glory and for beauty. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So you shall speak to all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who are"
                        },
                        {
                            "style": "NONE",
                            "text": " gifted artisans, whom I have filled with the spirit of wisdom, that they may make Aaron’s garments, to consecrate him, that he may minister to Me as priest. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the garments which they shall make: a breastplate, an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ornamented vest"
                        },
                        {
                            "style": "NONE",
                            "text": "ephod, a robe, a skillfully woven tunic, a turban, and a sash. So they shall make holy garments for Aaron your brother and his sons, that he may minister to Me as priest."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ephod"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“They shall take the gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and the fine linen, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they shall make the ephod of gold, blue, purple, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen, artistically worked. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall have two shoulder straps joined at its two edges, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "so"
                        },
                        {
                            "style": "NONE",
                            "text": " it shall be joined together. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ingenious work of"
                        },
                        {
                            "style": "NONE",
                            "text": "intricately woven band of the ephod, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on it, shall be of the same workmanship, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "made of"
                        },
                        {
                            "style": "NONE",
                            "text": " gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then you shall take two onyx stones and engrave on them the names of the sons of Israel: "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "six of their names on one stone and six names on the other stone, in order of their birth. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "With the work of an engraver in stone, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " the engravings of a signet, you shall engrave the two stones with the names of the sons of Israel. You shall set them in settings of gold. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put the two stones on the shoulders of the ephod "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " memorial stones for the sons of Israel. So Aaron shall bear their names before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " on his two shoulders as a memorial. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall also make settings of gold, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall make two chains of pure gold like braided cords, and fasten the braided chains to the settings."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Breastplate"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make the breastplate of judgment. Artistically woven according to the workmanship of the ephod you shall make it: of gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen, you shall make it. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be doubled into a square: a span "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its length, and a span "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " its width. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put settings of stones in it, four rows of stones: "
                        },
                        {
                            "style": "ITALIC",
                            "text": "The first"
                        },
                        {
                            "style": "NONE",
                            "text": " row "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or ruby"
                        },
                        {
                            "style": "NONE",
                            "text": "sardius, a topaz, and an emerald; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " the first row; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the second row "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a turquoise, a sapphire, and a diamond; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the third row, a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or amber"
                        },
                        {
                            "style": "NONE",
                            "text": "jacinth, an agate, and an amethyst; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the fourth row, a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or yellow jasper"
                        },
                        {
                            "style": "NONE",
                            "text": "beryl, an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or carnelian"
                        },
                        {
                            "style": "NONE",
                            "text": "onyx, and a jasper. They shall be set in gold settings. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the stones shall have the names of the sons of Israel, twelve according to their names, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " the engravings of a signet, each one with its own name; they shall be according to the twelve tribes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make chains for the breastplate at the end, like braided cords of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make two rings of gold for the breastplate, and put the two rings on the two ends of the breastplate. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you shall put the two braided "
                        },
                        {
                            "style": "ITALIC",
                            "text": "chains"
                        },
                        {
                            "style": "NONE",
                            "text": " of gold in the two rings which are on the ends of the breastplate; "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " two ends of the two braided "
                        },
                        {
                            "style": "ITALIC",
                            "text": "chains"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall fasten to the two settings, and put them on the shoulder straps of the ephod in the front."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make two rings of gold, and put them on the two ends of the breastplate, on the edge of it, which is on the inner side of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And two "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " rings of gold you shall make, and put them on the two shoulder straps, underneath the ephod toward its front, right at the seam above the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ingenious work of"
                        },
                        {
                            "style": "NONE",
                            "text": "intricately woven band of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall bind the breastplate by means of its rings to the rings of the ephod, using a blue cord, so that it is above the intricately woven band of the ephod, and so that the breastplate does not come loose from the ephod."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“So Aaron shall bear the names of the sons of Israel on the breastplate of judgment over his heart, when he goes into the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place,"
                        },
                        {
                            "style": "NONE",
                            "text": " as a memorial before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put in the breastplate of judgment the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Lights and the Perfections"
                        },
                        {
                            "style": "NONE",
                            "text": "Urim and the Thummim, and they shall be over Aaron’s heart when he goes in before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". So Aaron shall bear the judgment of the children of Israel over his heart before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Other Priestly Garments"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make the robe of the ephod all of blue. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There shall be an opening for his head in the middle of it; it shall have a woven binding all around its opening, like the opening in a coat of mail, so that it does not tear. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And upon its hem you shall make pomegranates of blue, purple, and scarlet, all around its hem, and bells of gold between them all around: "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a golden bell and a pomegranate, a golden bell and a pomegranate, upon the hem of the robe all around. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be upon Aaron when he ministers, and its sound will be heard when he goes into the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and when he comes out, that he may not die."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make a plate of pure gold and engrave on it, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " the engraving of a signet:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "HOLINESS TO THE LORD."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put it on a blue cord, that it may be on the turban; it shall be on the front of the turban. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it shall be on Aaron’s forehead, that Aaron may bear the iniquity of the holy things which the children of Israel hallow in all their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": "holy gifts; and it shall always be on his forehead, that they may be accepted before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall skillfully weave the tunic of fine linen "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall make the turban of fine linen, and you shall make the sash of woven work."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For Aaron’s sons you shall make tunics, and you shall make sashes for them. And you shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "headpieces or turbans"
                        },
                        {
                            "style": "NONE",
                            "text": "hats for them, for glory and beauty. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So you shall put them on Aaron your brother and on his sons with him. You shall anoint them, consecrate them, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set them apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctify them, that they may minister to Me as priests. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make for them linen trousers to cover their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "bare flesh"
                        },
                        {
                            "style": "NONE",
                            "text": "nakedness; they shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. be"
                        },
                        {
                            "style": "NONE",
                            "text": "reach from the waist to the thighs. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be on Aaron and on his sons when they come into the tabernacle of meeting, or when they come near the altar to minister in the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place,"
                        },
                        {
                            "style": "NONE",
                            "text": " that they do not incur "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "guilt"
                        },
                        {
                            "style": "NONE",
                            "text": "iniquity and die. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever to him and his descendants after him."
                        }
                    ]
                }
            ]
        }
    ]
}