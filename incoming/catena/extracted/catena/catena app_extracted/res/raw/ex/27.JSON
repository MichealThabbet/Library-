{
    "chapter_num": 27,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Altar of Burnt Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make an altar of acacia wood, five cubits long and five cubits wide—the altar shall be square—and its height "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " three cubits. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make its horns on its four corners; its horns shall be of one piece with it. And you shall overlay it with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also you shall make its pans to receive its ashes, and its shovels and its basins and its forks and its firepans; you shall make all its utensils of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make a grate for it, a network of bronze; and on the network you shall make four bronze rings at its four corners. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall put it under the rim of the altar beneath, that the network may be midway up the altar. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make poles for the altar, poles of acacia wood, and overlay them with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The poles shall be put in the rings, and the poles shall be on the two sides of the altar to bear it. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make it hollow with boards; as it was shown you on the mountain, so shall they make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Court of the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall also make the court of the tabernacle. For the south side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " hangings for the court "
                        },
                        {
                            "style": "ITALIC",
                            "text": "made of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine woven linen, one hundred cubits long for one side. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And its twenty pillars and their twenty sockets "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " bronze. The hooks of the pillars and their bands "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " silver. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise along the length of the north side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " hangings one hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " long, with its twenty pillars and their twenty sockets of bronze, and the hooks of the pillars and their bands of silver."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And along the width of the court on the west side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " hangings of fifty cubits, with their ten pillars and their ten sockets. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The width of the court on the east side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " fifty cubits. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hangings on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the gate shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " fifteen cubits, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " their three pillars and their three sockets. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the other side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " hangings of fifteen "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits, with"
                        },
                        {
                            "style": "NONE",
                            "text": " their three pillars and their three sockets."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For the gate of the court "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a screen twenty cubits long, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "woven of"
                        },
                        {
                            "style": "NONE",
                            "text": " blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine woven linen, made by a weaver. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " four pillars and four sockets. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the pillars around the court shall have bands of silver; their hooks "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver and their sockets of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The length of the court "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred cubits, the width fifty throughout, and the height five cubits, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "made of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine woven linen, and its sockets of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the utensils of the tabernacle for all its service, all its pegs, and all the pegs of the court, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " of bronze."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Care of the Lampstand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall command the children of Israel that they bring you pure oil of pressed olives for the light, to cause the lamp to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. ascend"
                        },
                        {
                            "style": "NONE",
                            "text": "burn continually. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the tabernacle of meeting, outside the veil which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the Testimony, Aaron and his sons shall tend it from evening until morning before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever to their generations on behalf of the children of Israel."
                        }
                    ]
                }
            ]
        }
    ]
}