{
    "chapter_num": 2,
    "verses_count": 16,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Grain Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘When anyone offers a grain offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", his offering shall be "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine flour. And he shall pour oil on it, and put frankincense on it. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall bring it to Aaron’s sons, the priests, one of whom shall take from it his handful of fine flour and oil with all the frankincense. And the priest shall burn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it as"
                        },
                        {
                            "style": "NONE",
                            "text": " a memorial on the altar, an offering made by fire, a sweet aroma to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rest of the grain offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " Aaron’s and his sons’. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy of the offerings to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made by fire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘And if you bring as an offering a grain offering baked in the oven, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " unleavened cakes of fine flour mixed with oil, or unleavened wafers anointed"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "spread"
                        },
                        {
                            "style": "NONE",
                            "text": " with oil. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if your offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a grain offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "baked"
                        },
                        {
                            "style": "NONE",
                            "text": " in a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "flat plate or griddle"
                        },
                        {
                            "style": "NONE",
                            "text": "pan, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it shall be of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine flour, unleavened, mixed with oil. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall break it in pieces and pour oil on it; it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a grain offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If your offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a grain offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "baked"
                        },
                        {
                            "style": "NONE",
                            "text": " in a covered pan, it shall be made "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine flour with oil. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall bring the grain offering that is made of these things to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". And when it is presented to the priest, he shall bring it to the altar. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall take from the grain offering a memorial portion, and burn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the altar. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It is"
                        },
                        {
                            "style": "NONE",
                            "text": " an offering made by fire, a sweet aroma to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And what is left of the grain offering "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " Aaron’s and his sons’. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy of the offerings to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made by fire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘No grain offering which you bring to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be made with leaven, for you shall burn no leaven nor any honey in any offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made by fire. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the offering of the firstfruits, you shall offer them to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", but they shall not be burned on the altar for a sweet aroma. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And every offering of your grain offering you shall season with salt; you shall not allow the salt of the covenant of your God to be lacking from your grain offering. With all your offerings you shall offer salt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If you offer a grain offering of your firstfruits to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", you shall offer for the grain offering of your firstfruits green heads of grain roasted on the fire, grain beaten from full heads. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put oil on it, and lay frankincense on it. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a grain offering. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall burn the memorial portion: "
                        },
                        {
                            "style": "ITALIC",
                            "text": "part"
                        },
                        {
                            "style": "NONE",
                            "text": " of its beaten grain and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "part"
                        },
                        {
                            "style": "NONE",
                            "text": " of its oil, with all the frankincense, as an offering made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        }
    ]
}