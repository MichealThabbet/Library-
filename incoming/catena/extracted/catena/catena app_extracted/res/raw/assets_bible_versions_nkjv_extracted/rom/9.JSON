{
    "chapter_num": 9,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Israel’s Rejection of Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I tell the truth in Christ, I am not lying, my conscience also bearing me witness in the Holy Spirit, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that I have great sorrow and continual grief in my heart. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I could wish that I myself were accursed from Christ for my brethren, my "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or relatives"
                        },
                        {
                            "style": "NONE",
                            "text": "countrymen according to the flesh, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who are Israelites, to whom "
                        },
                        {
                            "style": "ITALIC",
                            "text": "pertain"
                        },
                        {
                            "style": "NONE",
                            "text": " the adoption, the glory, the covenants, the giving of the law, the service "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of God,"
                        },
                        {
                            "style": "NONE",
                            "text": " and the promises; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of whom "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the fathers and from whom, according to the flesh, Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "came,"
                        },
                        {
                            "style": "NONE",
                            "text": " who is over all, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " eternally blessed God. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Israel’s Rejection and God’s Purpose"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But it is not that the word of God has taken no effect. For they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " not all Israel who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " of Israel, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are they"
                        },
                        {
                            "style": "NONE",
                            "text": " all children because they are the seed of Abraham; but, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“In Isaac your seed shall be called.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That is, those who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the children of the flesh, these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " not the children of God; but the children of the promise are counted as the seed. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the word of promise: "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“At this time I will come and Sarah shall have a son.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And not only "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this,"
                        },
                        {
                            "style": "NONE",
                            "text": " but when Rebecca also had conceived by one man, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "even"
                        },
                        {
                            "style": "NONE",
                            "text": " by our father Isaac "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the children"
                        },
                        {
                            "style": "NONE",
                            "text": " not yet being born, nor having done any good or evil, that the purpose of God according to election might stand, not of works but of Him who calls), "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "it was said to her, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“The older shall serve the younger.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Jacob I have loved, but Esau I have hated.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Israel’s Rejection and God’s Justice"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What shall we say then? "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Is there"
                        },
                        {
                            "style": "NONE",
                            "text": " unrighteousness with God? Certainly not! "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For He says to Moses, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“I will have mercy on whomever I will have mercy, and I will have compassion on whomever I will have compassion.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So then "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " not of him who wills, nor of him who runs, but of God who shows mercy. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the Scripture says to the Pharaoh, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“For this very purpose I have raised you up, that I may show My power in you, and that My name may be declared in all the earth.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore He has mercy on whom He wills, and whom He wills He hardens."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You will say to me then, “Why does He still find fault? For who has resisted His will?” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But indeed, O man, who are you to reply against God? Will the thing formed say to him who formed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": ", “Why have you made me like this?” "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Does not the potter have power over the clay, from the same lump to make one vessel for honor and another for dishonor?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "What"
                        },
                        {
                            "style": "NONE",
                            "text": " if God, wanting to show "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " wrath and to make His power known, endured with much longsuffering the vessels of wrath prepared for destruction, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and that He might make known the riches of His glory on the vessels of mercy, which He had prepared beforehand for glory, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "even us whom He called, not of the Jews only, but also of the Gentiles?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As He says also in Hosea:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“I will call them My people, who were not My people,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And her beloved, who was not beloved.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“And"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "it shall come to pass in the place where it was said to them,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "‘You"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "not My people,’"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "There they shall be called sons of the living God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Isaiah also cries out concerning Israel:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Though the number of the children of Israel be as the sand of the sea,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "The remnant will be saved."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "For"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU the Lord will finish the work and cut it short upon the earth"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "He will finish the work and cut"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "short in righteousness,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Because the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "will make a short work upon the earth.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as Isaiah said before:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Unless the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit., in Heb., Hosts"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Sabaoth had left us a seed,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "We would have become like Sodom,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And we would have been made like Gomorrah.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Present Condition of Israel"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What shall we say then? That Gentiles, who did not pursue righteousness, have attained to righteousness, even the righteousness of faith; "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but Israel, pursuing the law of righteousness, has not attained to the law "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits of righteousness"
                        },
                        {
                            "style": "NONE",
                            "text": "of righteousness. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Why? Because "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they did"
                        },
                        {
                            "style": "NONE",
                            "text": " not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "seek it"
                        },
                        {
                            "style": "NONE",
                            "text": " by faith, but as it were, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU by works, omitting of the law"
                        },
                        {
                            "style": "NONE",
                            "text": "by the works of the law. For they stumbled at that stumbling stone. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As it is written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Behold, I lay in Zion a stumbling stone and rock of offense,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "whoever believes on Him will not be put to shame.”"
                        }
                    ]
                }
            ]
        }
    ]
}