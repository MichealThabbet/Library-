{
    "chapter_num": 20,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Penalties for Breaking the Law"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Again, you shall say to the children of Israel: ‘Whoever of the children of Israel, or of the strangers who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "As resident aliens"
                        },
                        {
                            "style": "NONE",
                            "text": "dwell in Israel, who gives "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " of his descendants to Molech, he shall surely be put to death. The people of the land shall stone him with stones. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will set My face against that man, and will "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Put him to death"
                        },
                        {
                            "style": "NONE",
                            "text": "cut him off from his people, because he has given "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of his descendants to Molech, to defile My sanctuary and profane My holy name. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if the people of the land should in any way "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "disregard"
                        },
                        {
                            "style": "NONE",
                            "text": "hide their eyes from the man, when he gives "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of his descendants to Molech, and they do not kill him, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I will set My face against that man and against his family; and I will cut him off from his people, and all who prostitute themselves with him to commit harlotry with Molech."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘And the person who turns to mediums and familiar spirits, to prostitute himself with them, I will set My face against that person and cut him off from his people. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Consecrate"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Set yourselves apart for the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " yourselves therefore, and be holy, for I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall keep My statutes, and perform them: I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sets you apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctifies you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘For everyone who curses his father or his mother shall surely be put to death. He has cursed his father or his mother. His blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " upon him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘The man who commits adultery with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "another"
                        },
                        {
                            "style": "NONE",
                            "text": " man’s wife, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he"
                        },
                        {
                            "style": "NONE",
                            "text": " who commits adultery with his neighbor’s wife, the adulterer and the adulteress, shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The man who lies with his father’s wife has uncovered his father’s nakedness; both of them shall surely be put to death. Their blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with his daughter-in-law, both of them shall surely be put to death. They have committed perversion. Their blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with a male as he lies with a woman, both of them have committed an abomination. They shall surely be put to death. Their blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man marries a woman and her mother, it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " wickedness. They shall be burned with fire, both he and they, that there may be no wickedness among you. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man mates with an animal, he shall surely be put to death, and you shall kill the animal. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a woman approaches any animal and mates with it, you shall kill the woman and the animal. They shall surely be put to death. Their blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If a man takes his sister, his father’s daughter or his mother’s daughter, and sees her nakedness and she sees his nakedness, it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a wicked thing. And they shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Put to death"
                        },
                        {
                            "style": "NONE",
                            "text": "cut off in the sight of their people. He has uncovered his sister’s nakedness. He shall bear his "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "iniquity"
                        },
                        {
                            "style": "NONE",
                            "text": "guilt. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with a woman during her "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or customary impurity"
                        },
                        {
                            "style": "NONE",
                            "text": "sickness and uncovers her nakedness, he has "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. made bare"
                        },
                        {
                            "style": "NONE",
                            "text": "exposed her flow, and she has uncovered the flow of her blood. Both of them shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Put to death"
                        },
                        {
                            "style": "NONE",
                            "text": "cut off from their people."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘You shall not uncover the nakedness of your mother’s sister nor of your father’s sister, for that would uncover his near of kin. They shall bear their guilt. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man lies with his uncle’s wife, he has uncovered his uncle’s nakedness. They shall bear their sin; they shall die childless. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man takes his brother’s wife, it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "indecent, impure"
                        },
                        {
                            "style": "NONE",
                            "text": "unclean thing. He has uncovered his brother’s nakedness. They shall be childless."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘You shall therefore keep all My statutes and all My judgments, and perform them, that the land where I am bringing you to dwell may not vomit you out. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall not walk in the statutes of the nation which I am casting out before you; for they commit all these things, and therefore I abhor them. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I have said to you, “You shall inherit their land, and I will give it to you to possess, a land flowing with milk and honey.” I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, who has separated you from the peoples. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall therefore distinguish between clean animals and unclean, between unclean birds and clean, and you shall not make yourselves "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable or loathsome"
                        },
                        {
                            "style": "NONE",
                            "text": "abominable by beast or by bird, or by any kind of living thing that creeps on the ground, which I have separated from you as "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "defiled"
                        },
                        {
                            "style": "NONE",
                            "text": "unclean. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall be holy to Me, for I the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " holy, and have separated you from the peoples, that you should be Mine."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘A man or a woman who is a medium, or who has familiar spirits, shall surely be put to death; they shall stone them with stones. Their blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}