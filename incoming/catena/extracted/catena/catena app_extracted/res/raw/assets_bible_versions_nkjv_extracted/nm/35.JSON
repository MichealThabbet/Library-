{
    "chapter_num": 35,
    "verses_count": 34,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Cities for the Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses in the plains of Moab by the Jordan "
                        },
                        {
                            "style": "ITALIC",
                            "text": "across from"
                        },
                        {
                            "style": "NONE",
                            "text": " Jericho, saying: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Command the children of Israel that they give the Levites cities to dwell in from the inheritance of their possession, and you shall "
                        },
                        {
                            "style": "ITALIC",
                            "text": "also"
                        },
                        {
                            "style": "NONE",
                            "text": " give the Levites common-land around the cities. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall have the cities to dwell in; and their common-land shall be for their cattle, for their herds, and for all their animals. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The common-land of the cities which you will give the Levites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall extend"
                        },
                        {
                            "style": "NONE",
                            "text": " from the wall of the city outward a thousand cubits all around. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall measure outside the city on the east side two thousand cubits, on the south side two thousand cubits, on the west side two thousand cubits, and on the north side two thousand cubits. The city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " in the middle. This shall belong to them as common-land for the cities."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now among the cities which you will give to the Levites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you shall appoint"
                        },
                        {
                            "style": "NONE",
                            "text": " six cities of refuge, to which a manslayer may flee. And to these you shall add forty-two cities. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all the cities you will give to the Levites "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " forty-eight; these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you shall give"
                        },
                        {
                            "style": "NONE",
                            "text": " with their common-land. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the cities which you will give "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " from the possession of the children of Israel; from the larger "
                        },
                        {
                            "style": "ITALIC",
                            "text": "tribe"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall give many, from the smaller you shall give few. Each shall give some of its cities to the Levites, in proportion to the inheritance that each receives.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Cities of Refuge"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, and say to them: ‘When you cross the Jordan into the land of Canaan, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall appoint cities to be cities of refuge for you, that the manslayer who kills any person accidentally may flee there. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be cities of refuge for you from the avenger, that the manslayer may not die until he stands before the congregation in judgment. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And of the cities which you give, you shall have six cities of refuge. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall appoint three cities on this side of the Jordan, and three cities you shall appoint in the land of Canaan, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which"
                        },
                        {
                            "style": "NONE",
                            "text": " will be cities of refuge. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These six cities shall be for refuge for the children of Israel, for the stranger, and for the sojourner among them, that anyone who kills a person accidentally may flee there."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘But if he strikes him with an iron implement, so that he dies, he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a murderer; the murderer shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if he strikes him with a stone in the hand, by which one could die, and he does die, he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a murderer; the murderer shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if"
                        },
                        {
                            "style": "NONE",
                            "text": " he strikes him with a wooden hand weapon, by which one could die, and he does die, he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a murderer; the murderer shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "A family member who is to avenge the victim"
                        },
                        {
                            "style": "NONE",
                            "text": " avenger of blood himself shall put the murderer to death; when he meets him, he shall put him to death. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he pushes him out of hatred or, while lying in wait, hurls something at him so that he dies, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or in enmity he strikes him with his hand so that he dies, the one who struck "
                        },
                        {
                            "style": "ITALIC",
                            "text": "him"
                        },
                        {
                            "style": "NONE",
                            "text": " shall surely be put to death. He "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a murderer. The avenger of blood shall put the murderer to death when he meets him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘However, if he pushes him suddenly without enmity, or throws anything at him without lying in wait, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or uses a stone, by which a man could die, throwing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " at him without seeing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "him,"
                        },
                        {
                            "style": "NONE",
                            "text": " so that he dies, while he was not his enemy or seeking his harm, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the congregation shall judge between the manslayer and the avenger of blood according to these judgments. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the congregation shall deliver the manslayer from the hand of the avenger of blood, and the congregation shall return him to the city of refuge where he had fled, and he shall remain there until the death of the high priest who was anointed with the holy oil. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the manslayer at any time goes outside the limits of the city of refuge where he fled, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the avenger of blood finds him outside the limits of his city of refuge, and the avenger of blood kills the manslayer, he shall not be guilty of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Murder"
                        },
                        {
                            "style": "NONE",
                            "text": "blood, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because he should have remained in his city of refuge until the death of the high priest. But after the death of the high priest the manslayer may return to the land of his possession."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘And these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be a statute of judgment to you throughout your generations in all your dwellings. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever kills a person, the murderer shall be put to death on the testimony of witnesses; but one witness is not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sufficient"
                        },
                        {
                            "style": "NONE",
                            "text": " testimony against a person for the death "
                        },
                        {
                            "style": "ITALIC",
                            "text": "penalty."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover you shall take no ransom for the life of a murderer who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " guilty of death, but he shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take no ransom for him who has fled to his city of refuge, that he may return to dwell in the land before the death of the priest. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So you shall not pollute the land where you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are;"
                        },
                        {
                            "style": "NONE",
                            "text": " for blood defiles the land, and no "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement can be made for the land, for the blood that is shed on it, except by the blood of him who shed it. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore do not defile the land which you inhabit, in the midst of which I dwell; for I the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " dwell among the children of Israel.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}