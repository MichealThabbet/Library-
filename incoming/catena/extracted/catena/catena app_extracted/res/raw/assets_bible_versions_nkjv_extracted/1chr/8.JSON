{
    "chapter_num": 8,
    "verses_count": 40,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Family Tree of King Saul of Benjamin"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Benjamin begot Bela his firstborn, Ashbel the second, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ahiram, Num. 26:38"
                        },
                        {
                            "style": "NONE",
                            "text": "Aharah the third, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nohah the fourth, and Rapha the fifth. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Bela "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ard, Num. 26:40"
                        },
                        {
                            "style": "NONE",
                            "text": "Addar, Gera, Abihud, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abishua, Naaman, Ahoah, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Gera, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shupham, Num. 26:39, or Shuppim, 1 Chr. 7:12"
                        },
                        {
                            "style": "NONE",
                            "text": "Shephuphan, and Huram."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Ehud, who were the heads of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses"
                        },
                        {
                            "style": "NONE",
                            "text": " of the inhabitants of Geba, and who forced them to move to Manahath: "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Naaman, Ahijah, and Gera who forced them to move. He begot Uzza and Ahihud."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also Shaharaim had children in the country of Moab, after he had sent away Hushim and Baara his wives. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "By Hodesh his wife he begot Jobab, Zibia, Mesha, Malcam, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jeuz, Sachiah, and Mirmah. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " his sons, heads of their fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And by Hushim he begot Abitub and Elpaal. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Elpaal "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Eber, Misham, and Shemed, who built Ono and Lod with its towns; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Beriah and Shema, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " heads of their fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses"
                        },
                        {
                            "style": "NONE",
                            "text": " of the inhabitants of Aijalon, who drove out the inhabitants of Gath. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahio, Shashak, Jeremoth, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zebadiah, Arad, Eder, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Michael, Ispah, and Joha "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Beriah. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zebadiah, Meshullam, Hizki, Heber, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ishmerai, Jizliah, and Jobab "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Elpaal. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jakim, Zichri, Zabdi, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elienai, Zillethai, Eliel, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adaiah, Beraiah, and Shimrath "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shema, 1 Chr. 7:13"
                        },
                        {
                            "style": "NONE",
                            "text": "Shimei. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ishpan, Eber, Eliel, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abdon, Zichri, Hanan, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hananiah, Elam, Antothijah, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Iphdeiah, and Penuel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Shashak. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shamsherai, Shehariah, Athaliah, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jaareshiah, Elijah, and Zichri "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Jeroham."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " heads of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses"
                        },
                        {
                            "style": "NONE",
                            "text": " by their generations, chief men. These dwelt in Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jeiel, 1 Chr. 9:35"
                        },
                        {
                            "style": "NONE",
                            "text": "the father of Gibeon, whose wife’s name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Maacah, dwelt at Gibeon. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And his firstborn son "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Abdon, then Zur, Kish, Baal, Nadab, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Gedor, Ahio, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Zechariah, 1 Chr. 9:37"
                        },
                        {
                            "style": "NONE",
                            "text": "Zecher, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Mikloth, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " begot "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shimeam, 1 Chr. 9:38"
                        },
                        {
                            "style": "NONE",
                            "text": "Shimeah. They also dwelt "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. opposite"
                        },
                        {
                            "style": "NONE",
                            "text": "alongside their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "brethren"
                        },
                        {
                            "style": "NONE",
                            "text": "relatives in Jerusalem, with their brethren. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ner"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Also the son of Gibeon, 1 Chr. 9:36, 39"
                        },
                        {
                            "style": "NONE",
                            "text": " begot Kish, Kish begot Saul, and Saul begot Jonathan, Malchishua, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jishui, 1 Sam. 14:49"
                        },
                        {
                            "style": "NONE",
                            "text": "Abinadab, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ishbosheth, 2 Sam. 2:8"
                        },
                        {
                            "style": "NONE",
                            "text": "Esh-Baal. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son of Jonathan "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Mephibosheth, 2 Sam. 4:4"
                        },
                        {
                            "style": "NONE",
                            "text": "Merib-Baal, and Merib-Baal begot Micah. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Micah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Pithon, Melech, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Tahrea, 1 Chr. 9:41"
                        },
                        {
                            "style": "NONE",
                            "text": "Tarea, and Ahaz. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Ahaz begot "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jarah, 1 Chr. 9:42"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehoaddah; Jehoaddah begot Alemeth, Azmaveth, and Zimri; and Zimri begot Moza. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moza begot Binea, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Raphaiah, 1 Chr. 9:43"
                        },
                        {
                            "style": "NONE",
                            "text": "Raphah his son, Eleasah his son, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Azel his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Azel had six sons whose names "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " these: Azrikam, Bocheru, Ishmael, Sheariah, Obadiah, and Hanan. All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Azel. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of Eshek his brother "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Ulam his firstborn, Jeush the second, and Eliphelet the third."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ulam were mighty men of valor—archers. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "They"
                        },
                        {
                            "style": "NONE",
                            "text": " had many sons and grandsons, one hundred and fifty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " all sons of Benjamin."
                        }
                    ]
                }
            ]
        }
    ]
}