{
    "chapter_num": 1,
    "verses_count": 16,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, a bondservant of God and an apostle of Jesus Christ, according to the faith of God’s elect and the acknowledgment of the truth which accords with godliness, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in hope of eternal life which God, who cannot lie, promised before time began, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but has in due time manifested His word through preaching, which was committed to me according to the commandment of God our Savior;"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To Titus, a true son in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " common faith:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Grace, mercy, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " peace from God the Father and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Christ Jesus"
                        },
                        {
                            "style": "NONE",
                            "text": "the Lord Jesus Christ our Savior."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Qualified Elders"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason I left you in Crete, that you should set in order the things that are lacking, and appoint elders in every city as I commanded you— "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "if a man is blameless, the husband of one wife, having faithful children not accused of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "debauchery, lit. incorrigibility"
                        },
                        {
                            "style": "NONE",
                            "text": "dissipation or insubordination. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. overseer"
                        },
                        {
                            "style": "NONE",
                            "text": "bishop must be blameless, as a steward of God, not self-willed, not quick-tempered, not given to wine, not violent, not greedy for money, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but hospitable, a lover of what is good, sober-minded, just, holy, self-controlled, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "holding fast the faithful word as he has been taught, that he may be able, by sound doctrine, both to exhort and convict those who contradict."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Elders’ Task"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For there are many insubordinate, both idle talkers and deceivers, especially those of the circumcision, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whose mouths must be stopped, who subvert whole households, teaching things which they ought not, for the sake of dishonest gain. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "One of them, a prophet of their own, said, “Cretans "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " always liars, evil beasts, lazy gluttons.” "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This testimony is true. Therefore rebuke them sharply, that they may be sound in the faith, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not giving heed to Jewish fables and commandments of men who turn from the truth. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the pure all things are pure, but to those who are defiled and unbelieving nothing is pure; but even their mind and conscience are defiled. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They profess to know God, but in works they deny "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him,"
                        },
                        {
                            "style": "NONE",
                            "text": " being "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable"
                        },
                        {
                            "style": "NONE",
                            "text": "abominable, disobedient, and disqualified for every good work."
                        }
                    ]
                }
            ]
        }
    ]
}