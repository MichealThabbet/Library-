{
    "chapter_num": 13,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Punishment of Apostates"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If there arises among you a prophet or a dreamer of dreams, and he gives you a sign or a wonder, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the sign or the wonder comes to pass, of which he spoke to you, saying, ‘Let us go after other gods’—which you have not known—‘and let us serve them,’ "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall not listen to the words of that prophet or that dreamer of dreams, for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is testing you to know whether you love the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God with all your heart and with all your soul. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall walk"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "follow the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " after the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God and fear Him, and keep His commandments and obey His voice; you shall serve Him and hold fast to Him. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But that prophet or that dreamer of dreams shall be put to death, because he has spoken in order to turn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " away from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, who brought you out of the land of Egypt and redeemed you from the house of bondage, to entice you from the way in which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God commanded you to walk. So you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "exterminate"
                        },
                        {
                            "style": "NONE",
                            "text": "put away the evil from your midst."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If your brother, the son of your mother, your son or your daughter, the wife "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Whom you cherish"
                        },
                        {
                            "style": "NONE",
                            "text": "of your bosom, or your friend who is as your own soul, secretly entices you, saying, ‘Let us go and serve other gods,’ which you have not known, neither you nor your fathers, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the gods of the people which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " all around you, near to you or far off from you, from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " end of the earth to the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " end of the earth, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "yield"
                        },
                        {
                            "style": "NONE",
                            "text": "consent to him or listen to him, nor shall your eye pity him, nor shall you spare him or conceal him; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but you shall surely kill him; your hand shall be first against him to put him to death, and afterward the hand of all the people. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall stone him with stones until he dies, because he sought to entice you away from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, who brought you out of the land of Egypt, from the house of bondage. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all Israel shall hear and fear, and not again do such wickedness as this among you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you hear someone in one of your cities, which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you to dwell in, saying, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Sons of Belial"
                        },
                        {
                            "style": "NONE",
                            "text": "‘Corrupt men have gone out from among you and enticed the inhabitants of their city, saying, “Let us go and serve other gods” ’—which you have not known— "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall inquire, search out, and ask diligently. And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if it is"
                        },
                        {
                            "style": "NONE",
                            "text": " indeed true "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " certain "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " such an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable action"
                        },
                        {
                            "style": "NONE",
                            "text": "abomination was committed among you, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall surely strike the inhabitants of that city with the edge of the sword, utterly destroying it, all that is in it and its livestock—with the edge of the sword. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall gather all its plunder into the middle of the street, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or as a whole-offering"
                        },
                        {
                            "style": "NONE",
                            "text": "completely burn with fire the city and all its plunder, for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. It shall be a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. mound or ruin"
                        },
                        {
                            "style": "NONE",
                            "text": "heap forever; it shall not be built again. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So none of the accursed things shall remain in your hand, that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " may turn from the fierceness of His anger and show you mercy, have compassion on you and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "increase"
                        },
                        {
                            "style": "NONE",
                            "text": "multiply you, just as He swore to your fathers, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because you have listened to the voice of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, to keep all His commandments which I command you today, to do "
                        },
                        {
                            "style": "ITALIC",
                            "text": "what is"
                        },
                        {
                            "style": "NONE",
                            "text": " right in the eyes of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        }
                    ]
                }
            ]
        }
    ]
}