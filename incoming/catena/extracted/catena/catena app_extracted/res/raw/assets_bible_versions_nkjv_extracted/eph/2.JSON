{
    "chapter_num": 2,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "By Grace Through Faith"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "He made alive,"
                        },
                        {
                            "style": "NONE",
                            "text": " who were dead in trespasses and sins, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in which you once walked according to the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gr. aion, aeon"
                        },
                        {
                            "style": "NONE",
                            "text": "course of this world, according to the prince of the power of the air, the spirit who now works in the sons of disobedience, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "among whom also we all once conducted ourselves in the lusts of our flesh, fulfilling the desires of the flesh and of the mind, and were by nature children of wrath, just as the others."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But God, who is rich in mercy, because of His great love with which He loved us, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "even when we were dead in trespasses, made us alive together with Christ (by grace you have been saved), "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and raised "
                        },
                        {
                            "style": "ITALIC",
                            "text": "us"
                        },
                        {
                            "style": "NONE",
                            "text": " up together, and made "
                        },
                        {
                            "style": "ITALIC",
                            "text": "us"
                        },
                        {
                            "style": "NONE",
                            "text": " sit together in the heavenly "
                        },
                        {
                            "style": "ITALIC",
                            "text": "places"
                        },
                        {
                            "style": "NONE",
                            "text": " in Christ Jesus, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that in the ages to come He might show the exceeding riches of His grace in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " kindness toward us in Christ Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For by grace you have been saved through faith, and that not of yourselves; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " the gift of God, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not of works, lest anyone should boast. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we are His workmanship, created in Christ Jesus for good works, which God prepared beforehand that we should walk in them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Brought Near by His Blood"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore remember that you, once Gentiles in the flesh—who are called Uncircumcision by what is called the Circumcision made in the flesh by hands— "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that at that time you were without Christ, being aliens from the commonwealth of Israel and strangers from the covenants of promise, having no hope and without God in the world. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now in Christ Jesus you who once were far off have been brought near by the blood of Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Christ Our Peace"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For He Himself is our peace, who has made both one, and has broken down the middle wall of separation, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having abolished in His flesh the enmity, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is,"
                        },
                        {
                            "style": "NONE",
                            "text": " the law of commandments "
                        },
                        {
                            "style": "ITALIC",
                            "text": "contained"
                        },
                        {
                            "style": "NONE",
                            "text": " in ordinances, so as to create in Himself one new man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from"
                        },
                        {
                            "style": "NONE",
                            "text": " the two, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thus"
                        },
                        {
                            "style": "NONE",
                            "text": " making peace, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and that He might reconcile them both to God in one body through the cross, thereby putting to death the enmity. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He came and preached peace to you who were afar off and to those who were near. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For through Him we both have access by one Spirit to the Father."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Christ Our Cornerstone"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now, therefore, you are no longer strangers and foreigners, but fellow citizens with the saints and members of the household of God, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having been built on the foundation of the apostles and prophets, Jesus Christ Himself being the chief corner"
                        },
                        {
                            "style": "ITALIC",
                            "text": "stone,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in whom the whole building, being fitted together, grows into a holy temple in the Lord, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in whom you also are being built together for a dwelling place of God in the Spirit."
                        }
                    ]
                }
            ]
        }
    ]
}