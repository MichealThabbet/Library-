{
    "chapter_num": 2,
    "verses_count": 15,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Qualities of a Sound Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But as for you, speak the things which are proper for sound doctrine: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that the older men be sober, reverent, temperate, sound in faith, in love, in patience; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the older women likewise, that they be reverent in behavior, not slanderers, not given to much wine, teachers of good things— "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that they admonish the young women to love their husbands, to love their children, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " discreet, chaste, homemakers, good, obedient to their own husbands, that the word of God may not be blasphemed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise, exhort the young men to be sober-minded, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in all things showing yourself "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " a pattern of good works; in doctrine "
                        },
                        {
                            "style": "ITALIC",
                            "text": "showing"
                        },
                        {
                            "style": "NONE",
                            "text": " integrity, reverence, incorruptibility,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits incorruptibility"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "sound speech that cannot be condemned, that one who is an opponent may be ashamed, having nothing evil to say of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M us"
                        },
                        {
                            "style": "NONE",
                            "text": "you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Exhort"
                        },
                        {
                            "style": "NONE",
                            "text": " bondservants to be obedient to their own masters, to be well pleasing in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things,"
                        },
                        {
                            "style": "NONE",
                            "text": " not answering back, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "thieving"
                        },
                        {
                            "style": "NONE",
                            "text": "pilfering, but showing all good "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "honesty"
                        },
                        {
                            "style": "NONE",
                            "text": "fidelity, that they may adorn the doctrine of God our Savior in all things."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Trained by Saving Grace"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the grace of God that brings salvation has appeared to all men, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "teaching us that, denying ungodliness and worldly lusts, we should live soberly, righteously, and godly in the present age, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "looking for the blessed hope and glorious appearing of our great God and Savior Jesus Christ, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who gave Himself for us, that He might redeem us from every lawless deed and purify for Himself "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " own special people, zealous for good works."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Speak these things, exhort, and rebuke with all authority. Let no one despise you."
                        }
                    ]
                }
            ]
        }
    ]
}