{
    "chapter_num": 22,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Responsibility for Property"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man steals an ox or a sheep, and slaughters it or sells it, he shall restore five oxen for an ox and four sheep for a sheep. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the thief is found breaking in, and he is struck so that he dies, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " no guilt for his bloodshed. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the sun has risen on him, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " guilt for his bloodshed. He should make full restitution; if he has nothing, then he shall be sold"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Sold as a slave"
                        },
                        {
                            "style": "NONE",
                            "text": " for his theft. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the theft is certainly found alive in his hand, whether it is an ox or donkey or sheep, he shall restore double."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man causes a field or vineyard to be grazed, and lets loose his animal, and it feeds in another man’s field, he shall make restitution from the best of his own field and the best of his own vineyard."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If fire breaks out and catches in thorns, so that stacked grain, standing grain, or the field is consumed, he who kindled the fire shall surely make restitution."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man delivers to his neighbor money or articles to keep, and it is stolen out of the man’s house, if the thief is found, he shall pay double. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the thief is not found, then the master of the house shall be brought to the judges "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to see"
                        },
                        {
                            "style": "NONE",
                            "text": " whether he has put his hand into his neighbor’s goods."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For any kind of trespass, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whether it concerns"
                        },
                        {
                            "style": "NONE",
                            "text": " an ox, a donkey, a sheep, or clothing, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or"
                        },
                        {
                            "style": "NONE",
                            "text": " for any kind of lost thing which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "another"
                        },
                        {
                            "style": "NONE",
                            "text": " claims to be his, the cause of both parties shall come before the judges; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " whomever the judges condemn shall pay double to his neighbor. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a man delivers to his neighbor a donkey, an ox, a sheep, or any animal to keep, and it dies, is hurt, or driven away, no one seeing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "then"
                        },
                        {
                            "style": "NONE",
                            "text": " an oath of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be between them both, that he has not put his hand into his neighbor’s goods; and the owner of it shall accept "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that,"
                        },
                        {
                            "style": "NONE",
                            "text": " and he shall not make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " good. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if, in fact, it is stolen from him, he shall make restitution to the owner of it. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If it is torn to pieces "
                        },
                        {
                            "style": "ITALIC",
                            "text": "by a beast, then"
                        },
                        {
                            "style": "NONE",
                            "text": " he shall bring it as evidence, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " he shall not make good what was torn."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And if a man borrows "
                        },
                        {
                            "style": "ITALIC",
                            "text": "anything"
                        },
                        {
                            "style": "NONE",
                            "text": " from his neighbor, and it becomes injured or dies, the owner of it not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "being"
                        },
                        {
                            "style": "NONE",
                            "text": " with it, he shall surely make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " good. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If its owner "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " with it, he shall not make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " good; if it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " hired, it came for its hire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Moral and Ceremonial Principles"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man entices a virgin who is not betrothed, and lies with her, he shall surely pay the bride-price for her "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " his wife. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If her father utterly refuses to give her to him, he shall pay money according to the bride-price of virgins."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not permit a sorceress to live."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Whoever lies with an animal shall surely be put to death."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“He who sacrifices to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any"
                        },
                        {
                            "style": "NONE",
                            "text": " god, except to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " only, he shall be utterly destroyed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall neither mistreat a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sojourner"
                        },
                        {
                            "style": "NONE",
                            "text": "stranger nor oppress him, for you were strangers in the land of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not afflict any widow or fatherless child. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you afflict them in any way, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " they cry at all to Me, I will surely hear their cry; "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and My wrath will become hot, and I will kill you with the sword; your wives shall be widows, and your children fatherless."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you lend money to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any of"
                        },
                        {
                            "style": "NONE",
                            "text": " My people "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who are"
                        },
                        {
                            "style": "NONE",
                            "text": " poor among you, you shall not be like a moneylender to him; you shall not charge him interest. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you ever take your neighbor’s garment as a pledge, you shall return it to him before the sun goes down. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " his only covering, it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " his garment for his skin. What will he sleep in? And it will be that when he cries to Me, I will hear, for I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " gracious."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not revile God, nor curse a ruler of your people."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not delay "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to offer"
                        },
                        {
                            "style": "NONE",
                            "text": " the first of your ripe produce and your juices. The firstborn of your sons you shall give to Me. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise you shall do with your oxen "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " your sheep. It shall be with its mother seven days; on the eighth day you shall give it to Me."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall be holy men to Me: you shall not eat meat torn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "by beasts"
                        },
                        {
                            "style": "NONE",
                            "text": " in the field; you shall throw it to the dogs."
                        }
                    ]
                }
            ]
        }
    ]
}