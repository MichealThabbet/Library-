{
    "chapter_num": 12,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Spiritual Gifts: Unity in Diversity"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now concerning spiritual "
                        },
                        {
                            "style": "ITALIC",
                            "text": "gifts,"
                        },
                        {
                            "style": "NONE",
                            "text": " brethren, I do not want you to be ignorant: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You know that"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M that when"
                        },
                        {
                            "style": "NONE",
                            "text": " you were Gentiles, carried away to these dumb"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "mute, silent"
                        },
                        {
                            "style": "NONE",
                            "text": " idols, however you were led. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I make known to you that no one speaking by the Spirit of God calls Jesus "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gr. anathema"
                        },
                        {
                            "style": "NONE",
                            "text": "accursed, and no one can say that Jesus is Lord except by the Holy Spirit."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "allotments or various kinds"
                        },
                        {
                            "style": "NONE",
                            "text": "diversities of gifts, but the same Spirit. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There are differences of ministries, but the same Lord. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there are diversities of activities, but it is the same God who works "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "all things in"
                        },
                        {
                            "style": "NONE",
                            "text": "all in all. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the manifestation of the Spirit is given to each one for the profit "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of all:"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for to one is given the word of wisdom through the Spirit, to another the word of knowledge through the same Spirit, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to another faith by the same Spirit, to another gifts of healings by "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU one"
                        },
                        {
                            "style": "NONE",
                            "text": "the same Spirit, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to another the working of miracles, to another prophecy, to another discerning of spirits, to another "
                        },
                        {
                            "style": "ITALIC",
                            "text": "different"
                        },
                        {
                            "style": "NONE",
                            "text": " kinds of tongues, to another the interpretation of tongues. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But one and the same Spirit works all these things, distributing to each one individually as He wills."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Unity and Diversity in One Body"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as the body is one and has many members, but all the members of that one body, being many, are one body, so also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Christ. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For by one Spirit we were all baptized into one body—whether Jews or Greeks, whether slaves or free—and have all been made to drink "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits into"
                        },
                        {
                            "style": "NONE",
                            "text": "into one Spirit. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in fact the body is not one member but many."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the foot should say, “Because I am not a hand, I am not of the body,” is it therefore not of the body? "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if the ear should say, “Because I am not an eye, I am not of the body,” is it therefore not of the body? "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the whole body "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " an eye, where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "would be"
                        },
                        {
                            "style": "NONE",
                            "text": " the hearing? If the whole "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " hearing, where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "would be"
                        },
                        {
                            "style": "NONE",
                            "text": " the smelling? "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now God has set the members, each one of them, in the body just as He pleased. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if they were all one member, where "
                        },
                        {
                            "style": "ITALIC",
                            "text": "would"
                        },
                        {
                            "style": "NONE",
                            "text": " the body "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now indeed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there are"
                        },
                        {
                            "style": "NONE",
                            "text": " many members, yet one body. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the eye cannot say to the hand, “I have no need of you”; nor again the head to the feet, “I have no need of you.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No, much rather, those members of the body which seem to be weaker are necessary. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those "
                        },
                        {
                            "style": "ITALIC",
                            "text": "members"
                        },
                        {
                            "style": "NONE",
                            "text": " of the body which we think to be less honorable, on these we bestow greater honor; and our unpresentable "
                        },
                        {
                            "style": "ITALIC",
                            "text": "parts"
                        },
                        {
                            "style": "NONE",
                            "text": " have greater modesty, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but our presentable "
                        },
                        {
                            "style": "ITALIC",
                            "text": "parts"
                        },
                        {
                            "style": "NONE",
                            "text": " have no need. But God composed the body, having given greater honor to that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "part"
                        },
                        {
                            "style": "NONE",
                            "text": " which lacks it, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that there should be no "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "division"
                        },
                        {
                            "style": "NONE",
                            "text": "schism in the body, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " the members should have the same care for one another. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if one member suffers, all the members suffer with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it;"
                        },
                        {
                            "style": "NONE",
                            "text": " or if one member is honored, all the members rejoice with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now you are the body of Christ, and members individually. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And God has appointed these in the church: first apostles, second prophets, third teachers, after that miracles, then gifts of healings, helps, administrations, varieties of tongues. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Are"
                        },
                        {
                            "style": "NONE",
                            "text": " all apostles? "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Are"
                        },
                        {
                            "style": "NONE",
                            "text": " all prophets? "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Are"
                        },
                        {
                            "style": "NONE",
                            "text": " all teachers? "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Are"
                        },
                        {
                            "style": "NONE",
                            "text": " all workers of miracles? "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do all have gifts of healings? Do all speak with tongues? Do all interpret? "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But earnestly desire the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU greater"
                        },
                        {
                            "style": "NONE",
                            "text": "best gifts. And yet I show you a more excellent way."
                        }
                    ]
                }
            ]
        }
    ]
}