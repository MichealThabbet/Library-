{
    "chapter_num": 26,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Uzziah Reigns in Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now all the people of Judah took "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Azariah, 2 Kin. 14:21ff."
                        },
                        {
                            "style": "NONE",
                            "text": "Uzziah, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " sixteen years old, and made him king instead of his father Amaziah. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He built "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Eloth"
                        },
                        {
                            "style": "NONE",
                            "text": "Elath and restored it to Judah, after the king rested with his fathers."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Uzziah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " sixteen years old when he became king, and he reigned fifty-two years in Jerusalem. His mother’s name was Jecholiah of Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he did "
                        },
                        {
                            "style": "ITALIC",
                            "text": "what was"
                        },
                        {
                            "style": "NONE",
                            "text": " right in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", according to all that his father Amaziah had done. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He sought God in the days of Zechariah, who had understanding in the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. mss., LXX, Syr., Tg., Arab. fear"
                        },
                        {
                            "style": "NONE",
                            "text": "visions of God; and as long as he sought the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", God made him prosper."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now he went out and made war against the Philistines, and broke down the wall of Gath, the wall of Jabneh, and the wall of Ashdod; and he built cities "
                        },
                        {
                            "style": "ITALIC",
                            "text": "around"
                        },
                        {
                            "style": "NONE",
                            "text": " Ashdod and among the Philistines. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "God helped him against the Philistines, against the Arabians who lived in Gur Baal, and against the Meunites. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also the Ammonites brought tribute to Uzziah. His fame spread as far as the entrance of Egypt, for he became exceedingly strong."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Uzziah built towers in Jerusalem at the Corner Gate, at the Valley Gate, and at the corner buttress of the wall; then he fortified them. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also he built towers in the desert. He dug many wells, for he had much livestock, both in the lowlands and in the plains; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he also had"
                        },
                        {
                            "style": "NONE",
                            "text": " farmers and vinedressers in the mountains and in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or the fertile fields"
                        },
                        {
                            "style": "NONE",
                            "text": "Carmel, for he loved the soil."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover Uzziah had an army of fighting men who went out to war by companies, according to the number on their roll as prepared by Jeiel the scribe and Maaseiah the officer, under the hand of Hananiah, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " of the king’s captains. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The total number of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. chief fathers"
                        },
                        {
                            "style": "NONE",
                            "text": "chief officers of the mighty men of valor "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " two thousand six hundred. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And under their authority "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " an army of three hundred and seven thousand five hundred, that made war with mighty power, to help the king against the enemy. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Uzziah prepared for them, for the entire army, shields, spears, helmets, body armor, bows, and slings "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to cast"
                        },
                        {
                            "style": "NONE",
                            "text": " stones. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made devices in Jerusalem, invented by skillful men, to be on the towers and the corners, to shoot arrows and large stones. So his fame spread far and wide, for he was marvelously helped till he became strong."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Penalty for Uzziah’s Pride"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when he was strong his heart was lifted up, to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " destruction, for he transgressed against the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God by entering the temple of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to burn incense on the altar of incense. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Azariah the priest went in after him, and with him were eighty priests of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "—valiant men. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they withstood King Uzziah, and said to him, “"
                        },
                        {
                            "style": "ITALIC",
                            "text": "It"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not for you, Uzziah, to burn incense to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", but for the priests, the sons of Aaron, who are consecrated to burn incense. Get out of the sanctuary, for you have trespassed! You "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall have"
                        },
                        {
                            "style": "NONE",
                            "text": " no honor from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Uzziah became furious; and he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "had"
                        },
                        {
                            "style": "NONE",
                            "text": " a censer in his hand to burn incense. And while he was angry with the priests, leprosy broke out on his forehead, before the priests in the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", beside the incense altar. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Azariah the chief priest and all the priests looked at him, and there, on his forehead, he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " leprous; so they thrust him out of that place. Indeed he also hurried to get out, because the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had struck him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "King Uzziah was a leper until the day of his death. He dwelt in an isolated house, because he was a leper; for he was cut off from the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Then Jotham his son "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over the king’s house, judging the people of the land."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the rest of the acts of Uzziah, from first to last, the prophet Isaiah the son of Amoz wrote. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Uzziah "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Died and joined his ancestors"
                        },
                        {
                            "style": "NONE",
                            "text": "rested with his fathers, and they buried him with his fathers in the field of burial which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belonged"
                        },
                        {
                            "style": "NONE",
                            "text": " to the kings, for they said, “He is a leper.” Then Jotham his son reigned in his place."
                        }
                    ]
                }
            ]
        }
    ]
}