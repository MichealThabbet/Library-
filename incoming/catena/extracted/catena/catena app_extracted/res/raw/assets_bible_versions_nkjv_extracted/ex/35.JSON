{
    "chapter_num": 35,
    "verses_count": 35,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Sabbath Regulations"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses gathered all the congregation of the children of Israel together, and said to them, “These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the words which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has commanded "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " to do: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Work shall be done for six days, but the seventh day shall be a holy day for you, a Sabbath of rest to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Whoever does any work on it shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall kindle no fire throughout your dwellings on the Sabbath day.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Offerings for the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Moses spoke to all the congregation of the children of Israel, saying, “This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the thing which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded, saying: "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Take from among you an offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Whoever "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " of a willing heart, let him bring it as an offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": gold, silver, and bronze; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " fine linen, and goats’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hair;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "ram skins dyed red, badger skins, and acacia wood; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "oil for the light, and spices for the anointing oil and for the sweet incense; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "onyx stones, and stones to be set in the ephod and in the breastplate."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Articles of the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘All "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who are"
                        },
                        {
                            "style": "NONE",
                            "text": " gifted artisans among you shall come and make all that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has commanded: "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the tabernacle, its tent, its covering, its clasps, its boards, its bars, its pillars, and its sockets; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the ark and its poles, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " the mercy seat, and the veil of the covering; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the table and its poles, all its utensils, and the showbread; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also the lampstand for the light, its utensils, its lamps, and the oil for the light; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the incense altar, its poles, the anointing oil, the sweet incense, and the screen for the door at the entrance of the tabernacle; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the altar of burnt offering with its bronze grating, its poles, all its utensils, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the laver and its base; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the hangings of the court, its pillars, their sockets, and the screen for the gate of the court; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the pegs of the tabernacle, the pegs of the court, and their cords; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or woven garments"
                        },
                        {
                            "style": "NONE",
                            "text": "garments of ministry, for ministering in the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place"
                        },
                        {
                            "style": "NONE",
                            "text": "—the holy garments for Aaron the priest and the garments of his sons, to minister as priests.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Tabernacle Offerings Presented"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the congregation of the children of Israel departed from the presence of Moses. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then everyone came whose heart "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. lifted him up"
                        },
                        {
                            "style": "NONE",
                            "text": "was stirred, and everyone whose spirit was willing, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " they brought the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s offering for the work of the tabernacle of meeting, for all its service, and for the holy garments. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They came, both men and women, as many as had a willing heart, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " brought earrings and nose rings, rings and necklaces, all jewelry of gold, that is, every man who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "made"
                        },
                        {
                            "style": "NONE",
                            "text": " an offering of gold to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And every man, with whom was found blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " fine linen, and goats’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hair,"
                        },
                        {
                            "style": "NONE",
                            "text": " red skins of rams, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or dolphin"
                        },
                        {
                            "style": "NONE",
                            "text": "badger skins, brought "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Everyone who offered an offering of silver or bronze brought the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s offering. And everyone with whom was found acacia wood for any work of the service, brought "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the women "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who were"
                        },
                        {
                            "style": "NONE",
                            "text": " gifted artisans spun yarn with their hands, and brought what they had spun, of blue, purple, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " scarlet, and fine linen. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the women whose hearts "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. lifted them up"
                        },
                        {
                            "style": "NONE",
                            "text": "stirred with wisdom spun yarn of goats’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "hair."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rulers brought onyx stones, and the stones to be set in the ephod and in the breastplate, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and spices and oil for the light, for the anointing oil, and for the sweet incense. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The children of Israel brought a freewill offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", all the men and women whose hearts were willing to bring "
                        },
                        {
                            "style": "ITALIC",
                            "text": "material"
                        },
                        {
                            "style": "NONE",
                            "text": " for all kinds of work which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", by the hand of Moses, had commanded to be done."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Artisans Called by God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Moses said to the children of Israel, “See, the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has called by name Bezalel the son of Uri, the son of Hur, of the tribe of Judah; "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and He has filled him with the Spirit of God, in wisdom and understanding, in knowledge and all manner of workmanship, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to design artistic works, to work in gold and silver and bronze, "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in cutting jewels for setting, in carving wood, and to work in all manner of artistic workmanship."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And He has put in his heart the ability to teach, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " him and Aholiab the son of Ahisamach, of the tribe of Dan. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He has filled them with skill to do all manner of work of the engraver and the designer and the tapestry maker, in blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and fine linen, and of the weaver—those who do every work and those who design artistic works."
                        }
                    ]
                }
            ]
        }
    ]
}