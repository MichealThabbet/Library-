{
    "chapter_num": 1,
    "verses_count": 25,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting to the Elect Pilgrims"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Peter, an apostle of Jesus Christ,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sojourners, temporary residents"
                        },
                        {
                            "style": "NONE",
                            "text": "pilgrims of the Dispersion in Pontus, Galatia, Cappadocia, Asia, and Bithynia, "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "elect according to the foreknowledge of God the Father, in sanctification of the Spirit, for obedience and sprinkling of the blood of Jesus Christ:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace be multiplied."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Heavenly Inheritance"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the God and Father of our Lord Jesus Christ, who according to His abundant mercy has begotten us again to a living hope through the resurrection of Jesus Christ from the dead, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to an inheritance "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "imperishable"
                        },
                        {
                            "style": "NONE",
                            "text": "incorruptible and undefiled and that does not fade away, reserved in heaven for you, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who are kept by the power of God through faith for salvation ready to be revealed in the last time."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In this you greatly rejoice, though now for a little while, if need be, you have been "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "distressed"
                        },
                        {
                            "style": "NONE",
                            "text": "grieved by various trials, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that the genuineness of your faith, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "being"
                        },
                        {
                            "style": "NONE",
                            "text": " much more precious than gold that perishes, though it is tested by fire, may be found to praise, honor, and glory at the revelation of Jesus Christ, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whom having not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M known"
                        },
                        {
                            "style": "NONE",
                            "text": "seen you love. Though now you do not see "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him,"
                        },
                        {
                            "style": "NONE",
                            "text": " yet believing, you rejoice with joy inexpressible and full of glory, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "receiving the end of your faith—the salvation of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " souls."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of this salvation the prophets have inquired and searched carefully, who prophesied of the grace "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that would come"
                        },
                        {
                            "style": "NONE",
                            "text": " to you, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "searching what, or what manner of time, the Spirit of Christ who was in them was indicating when He testified beforehand the sufferings of Christ and the glories that would follow. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To them it was revealed that, not to themselves, but to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M you"
                        },
                        {
                            "style": "NONE",
                            "text": "us they were ministering the things which now have been reported to you through those who have preached the gospel to you by the Holy Spirit sent from heaven—things which angels desire to look into."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Living Before God Our Father"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore gird up the loins of your mind, be sober, and rest "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " hope fully upon the grace that is to be brought to you at the revelation of Jesus Christ; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as obedient children, not conforming yourselves to the former lusts, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " in your ignorance; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but as He who called you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " holy, you also be holy in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " conduct, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Be holy, for I am holy.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if you call on the Father, who without partiality judges according to each one’s work, conduct yourselves throughout the time of your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sojourning, dwelling as resident aliens"
                        },
                        {
                            "style": "NONE",
                            "text": "stay "
                        },
                        {
                            "style": "ITALIC",
                            "text": "here"
                        },
                        {
                            "style": "NONE",
                            "text": " in fear; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "knowing that you were not redeemed with "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perishable"
                        },
                        {
                            "style": "NONE",
                            "text": "corruptible things, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " silver or gold, from your aimless conduct "
                        },
                        {
                            "style": "ITALIC",
                            "text": "received"
                        },
                        {
                            "style": "NONE",
                            "text": " by tradition from your fathers, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but with the precious blood of Christ, as of a lamb without blemish and without spot. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He indeed was foreordained before the foundation of the world, but was "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "revealed"
                        },
                        {
                            "style": "NONE",
                            "text": "manifest in these last times for you "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who through Him believe in God, who raised Him from the dead and gave Him glory, so that your faith and hope are in God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Enduring Word"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Since you have purified your souls in obeying the truth "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits through the Spirit"
                        },
                        {
                            "style": "NONE",
                            "text": "through the Spirit in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. unhypocritical"
                        },
                        {
                            "style": "NONE",
                            "text": "sincere love of the brethren, love one another fervently with a pure heart, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having been born again, not of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perishable"
                        },
                        {
                            "style": "NONE",
                            "text": "corruptible seed but "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "imperishable"
                        },
                        {
                            "style": "NONE",
                            "text": "incorruptible, through the word of God which lives and abides "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits forever"
                        },
                        {
                            "style": "NONE",
                            "text": "forever, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“All flesh"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "as grass,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And all"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU its glory as"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "the glory of man as the flower of the grass."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "The grass withers,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And its flower falls away,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "But the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "spoken word"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "word of the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "endures forever.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Now this is the word which by the gospel was preached to you."
                        }
                    ]
                }
            ]
        }
    ]
}