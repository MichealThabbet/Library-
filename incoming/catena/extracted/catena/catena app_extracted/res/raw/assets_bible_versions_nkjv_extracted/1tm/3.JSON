{
    "chapter_num": 3,
    "verses_count": 16,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Qualifications of Overseers"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a faithful saying: If a man desires the position of a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. overseer"
                        },
                        {
                            "style": "NONE",
                            "text": "bishop, he desires a good work. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A bishop then must be blameless, the husband of one wife, temperate, sober-minded, of good behavior, hospitable, able to teach; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "addicted"
                        },
                        {
                            "style": "NONE",
                            "text": "given to wine, not violent, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits not greedy for money"
                        },
                        {
                            "style": "NONE",
                            "text": "not greedy for money, but gentle, not quarrelsome, not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "loving money"
                        },
                        {
                            "style": "NONE",
                            "text": "covetous; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one who rules his own house well, having "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " children in submission with all reverence "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(for if a man does not know how to rule his own house, how will he take care of the church of God?); "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "new convert"
                        },
                        {
                            "style": "NONE",
                            "text": "novice, lest being puffed up with pride he fall into the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "same"
                        },
                        {
                            "style": "NONE",
                            "text": " condemnation as the devil. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover he must have a good testimony among those who are outside, lest he fall into reproach and the snare of the devil."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Qualifications of Deacons"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise deacons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "must be"
                        },
                        {
                            "style": "NONE",
                            "text": " reverent, not double-tongued, not given to much wine, not greedy for money, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "holding the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "hidden truth"
                        },
                        {
                            "style": "NONE",
                            "text": "mystery of the faith with a pure conscience. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But let these also first be tested; then let them serve as deacons, being "
                        },
                        {
                            "style": "ITALIC",
                            "text": "found"
                        },
                        {
                            "style": "NONE",
                            "text": " blameless. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " wives "
                        },
                        {
                            "style": "ITALIC",
                            "text": "must be"
                        },
                        {
                            "style": "NONE",
                            "text": " reverent, not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "malicious gossips"
                        },
                        {
                            "style": "NONE",
                            "text": "slanderers, temperate, faithful in all things. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let deacons be the husbands of one wife, ruling "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " children and their own houses well. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For those who have served well as deacons obtain for themselves a good standing and great boldness in the faith which is in Christ Jesus."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Great Mystery"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These things I write to you, though I hope to come to you shortly; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but if I am delayed, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "I write"
                        },
                        {
                            "style": "NONE",
                            "text": " so that you may know how you ought to conduct yourself in the house of God, which is the church of the living God, the pillar and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "foundation, mainstay"
                        },
                        {
                            "style": "NONE",
                            "text": "ground of the truth. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And without controversy great is the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "hidden truth"
                        },
                        {
                            "style": "NONE",
                            "text": "mystery of godliness:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "God"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Who"
                        },
                        {
                            "style": "NONE",
                            "text": " was manifested in the flesh,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Justified in the Spirit,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Seen by angels,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Preached among the Gentiles,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Believed on in the world,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Received up in glory."
                        }
                    ]
                }
            ]
        }
    ]
}