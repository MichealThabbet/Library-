{
    "chapter_num": 25,
    "verses_count": 6,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Bildad: How Can Man Be Righteous?"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Bildad the Shuhite answered and said:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Dominion and fear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "belong"
                        },
                        {
                            "style": "NONE",
                            "text": " to Him;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He makes peace in His high places."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Can His armies be counted?"
                        },
                        {
                            "style": "NONE",
                            "text": "Is there any number to His armies?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Upon whom does His light not rise?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "How then can man be righteous before God?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Or how can he be pure "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " born of a woman?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If even the moon does not shine,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And the stars are not pure in His sight,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "How much less man, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " a maggot,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And a son of man, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " a worm?”"
                        }
                    ]
                }
            ]
        }
    ]
}