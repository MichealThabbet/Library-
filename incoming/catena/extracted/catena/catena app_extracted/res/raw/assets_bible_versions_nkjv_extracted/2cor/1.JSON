{
    "chapter_num": 1,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, an apostle of Jesus Christ by the will of God, and Timothy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "our"
                        },
                        {
                            "style": "NONE",
                            "text": " brother,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To the church of God which is at Corinth, with all the saints who are in all Achaia:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Comfort in Suffering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the God and Father of our Lord Jesus Christ, the Father of mercies and God of all comfort, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who comforts us in all our tribulation, that we may be able to comfort those who are in any "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "tribulation"
                        },
                        {
                            "style": "NONE",
                            "text": "trouble, with the comfort with which we ourselves are comforted by God. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as the sufferings of Christ abound in us, so our "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "comfort"
                        },
                        {
                            "style": "NONE",
                            "text": "consolation also abounds through Christ. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now if we are afflicted, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " for your consolation and salvation, which is effective for enduring the same sufferings which we also suffer. Or if we are comforted, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " for your consolation and salvation. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And our hope for you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " steadfast, because we know that as you are partakers of the sufferings, so also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you will partake"
                        },
                        {
                            "style": "NONE",
                            "text": " of the consolation."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Delivered from Suffering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we do not want you to be ignorant, brethren, of our "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "tribulation"
                        },
                        {
                            "style": "NONE",
                            "text": "trouble which came to us in Asia: that we were burdened beyond measure, above strength, so that we despaired even of life. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yes, we had the sentence of death in ourselves, that we should not trust in ourselves but in God who raises the dead, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who delivered us from so great a death, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU shall"
                        },
                        {
                            "style": "NONE",
                            "text": "does deliver us; in whom we trust that He will still deliver "
                        },
                        {
                            "style": "ITALIC",
                            "text": "us,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you also helping together in prayer for us, that thanks may be given by many persons on "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M your behalf"
                        },
                        {
                            "style": "NONE",
                            "text": "our behalf for the gift "
                        },
                        {
                            "style": "ITALIC",
                            "text": "granted"
                        },
                        {
                            "style": "NONE",
                            "text": " to us through many."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul’s Sincerity"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For our boasting is this: the testimony of our conscience that we conducted ourselves in the world in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The opposite of duplicity"
                        },
                        {
                            "style": "NONE",
                            "text": "simplicity and godly sincerity, not with fleshly wisdom but by the grace of God, and more abundantly toward you. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we are not writing any other things to you than what you read or understand. Now I trust you will understand, even to the end "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(as also you have understood us in part), that we are your boast as you also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " ours, in the day of the Lord Jesus."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sparing the Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in this confidence I intended to come to you before, that you might have a second benefit— "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to pass by way of you to Macedonia, to come again from Macedonia to you, and be helped by you on my way to Judea. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore, when I was planning this, did I do it lightly? Or the things I plan, do I plan according to the flesh, that with me there should be Yes, Yes, and No, No? "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " faithful, our "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "message"
                        },
                        {
                            "style": "NONE",
                            "text": "word to you was not Yes and No. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the Son of God, Jesus Christ, who was preached among you by us—by me, Silvanus, and Timothy—was not Yes and No, but in Him was Yes. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For all the promises of God in Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " Yes, and in Him Amen, to the glory of God through us. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now He who establishes us with you in Christ and has anointed us "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " God, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who also has sealed us and given us the Spirit in our hearts as a guarantee."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover I call God as witness against my soul, that to spare you I came no more to Corinth. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Not that we "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "rule"
                        },
                        {
                            "style": "NONE",
                            "text": "have dominion over your faith, but are fellow workers for your joy; for by faith you stand."
                        }
                    ]
                }
            ]
        }
    ]
}