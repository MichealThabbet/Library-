{
    "chapter_num": 39,
    "verses_count": 43,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Making the Garments of the Priesthood"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread"
                        },
                        {
                            "style": "NONE",
                            "text": " they made garments"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or woven garments"
                        },
                        {
                            "style": "NONE",
                            "text": " of ministry, for ministering in the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "sanctuary"
                        },
                        {
                            "style": "NONE",
                            "text": "holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place,"
                        },
                        {
                            "style": "NONE",
                            "text": " and made the holy garments for Aaron, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Ephod"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the ephod of gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and of fine woven linen. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they beat the gold into thin sheets and cut "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it into"
                        },
                        {
                            "style": "NONE",
                            "text": " threads, to work "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " the blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and the fine linen, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "into"
                        },
                        {
                            "style": "NONE",
                            "text": " artistic designs. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They made shoulder straps for it to couple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " together; it was coupled together at its two edges. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the intricately woven band of his ephod that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " of the same workmanship, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "woven of"
                        },
                        {
                            "style": "NONE",
                            "text": " gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " fine woven linen, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they set onyx stones, enclosed in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "plaited work"
                        },
                        {
                            "style": "NONE",
                            "text": "settings of gold; they were engraved, as signets are engraved, with the names of the sons of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He put them on the shoulders of the ephod "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " memorial stones for the sons of Israel, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Breastplate"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the breastplate, artistically woven like the workmanship of the ephod, of gold, blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " and of fine woven linen. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They made the breastplate square by doubling it; a span "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " its length and a span its width when doubled. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they set in it four rows of stones: a row with a sardius, a topaz, and an emerald was the first row; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the second row, a turquoise, a sapphire, and a diamond; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the third row, a jacinth, an agate, and an amethyst; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the fourth row, a beryl, an onyx, and a jasper. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "They were"
                        },
                        {
                            "style": "NONE",
                            "text": " enclosed in settings of gold in their mountings. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There were"
                        },
                        {
                            "style": "NONE",
                            "text": " twelve stones according to the names of the sons of Israel: according to their names, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "engraved like"
                        },
                        {
                            "style": "NONE",
                            "text": " a signet, each one with its own name according to the twelve tribes. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they made chains for the breastplate at the ends, like braided cords of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They also made two settings of gold and two gold rings, and put the two rings on the two ends of the breastplate. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they put the two braided "
                        },
                        {
                            "style": "ITALIC",
                            "text": "chains"
                        },
                        {
                            "style": "NONE",
                            "text": " of gold in the two rings on the ends of the breastplate. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The two ends of the two braided "
                        },
                        {
                            "style": "ITALIC",
                            "text": "chains"
                        },
                        {
                            "style": "NONE",
                            "text": " they fastened in the two settings, and put them on the shoulder straps of the ephod in the front. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they made two rings of gold and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " on the two ends of the breastplate, on the edge of it, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on the inward side of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They made two "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " gold rings and put them on the two shoulder straps, underneath the ephod toward its front, right at the seam above the intricately woven band of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they bound the breastplate by means of its rings to the rings of the ephod with a blue cord, so that it would be above the intricately woven band of the ephod, and that the breastplate would not come loose from the ephod, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Other Priestly Garments"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the robe of the ephod of woven work, all of blue. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " an opening in the middle of the robe, like the opening in a coat of mail, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " a woven binding all around the opening, so that it would not tear. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They made on the hem of the robe pomegranates of blue, purple, and scarlet, and of fine woven "
                        },
                        {
                            "style": "ITALIC",
                            "text": "linen."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they made bells of pure gold, and put the bells between the pomegranates on the hem of the robe all around between the pomegranates: "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a bell and a pomegranate, a bell and a pomegranate, all around the hem of the robe to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "serve"
                        },
                        {
                            "style": "NONE",
                            "text": "minister in, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They made tunics, artistically woven of fine linen, for Aaron and his sons, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a turban of fine linen, exquisite hats of fine linen, short trousers of fine woven linen, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and a sash of fine woven linen with blue, purple, and scarlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thread,"
                        },
                        {
                            "style": "NONE",
                            "text": " made by a weaver, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they made the plate of the holy crown of pure gold, and wrote on it an inscription "
                        },
                        {
                            "style": "ITALIC",
                            "text": "like"
                        },
                        {
                            "style": "NONE",
                            "text": " the engraving of a signet:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "HOLINESS TO THE LORD."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they tied to it a blue cord, to fasten "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " above on the turban, as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Work Completed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus all the work of the tabernacle of the tent of meeting was finished. And the children of Israel did according to all that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses; so they did. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they brought the tabernacle to Moses, the tent and all its furnishings: its clasps, its boards, its bars, its pillars, and its sockets; "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the covering of ram skins dyed red, the covering of badger skins, and the veil of the covering; "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the ark of the Testimony with its poles, and the mercy seat; "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the table, all its utensils, and the showbread; "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the pure "
                        },
                        {
                            "style": "ITALIC",
                            "text": "gold"
                        },
                        {
                            "style": "NONE",
                            "text": " lampstand with its lamps (the lamps set in order), all its utensils, and the oil for light; "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the gold altar, the anointing oil, and the sweet incense; the screen for the tabernacle door; "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the bronze altar, its grate of bronze, its poles, and all its utensils; the laver with its base; "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the hangings of the court, its pillars and its sockets, the screen for the court gate, its cords, and its pegs; all the utensils for the service of the tabernacle, for the tent of meeting; "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or woven garments"
                        },
                        {
                            "style": "NONE",
                            "text": "garments of ministry, to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "serve"
                        },
                        {
                            "style": "NONE",
                            "text": "minister in the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "place:"
                        },
                        {
                            "style": "NONE",
                            "text": " the holy garments for Aaron the priest, and his sons’ garments, to minister as priests."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "According to all that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded Moses, so the children of Israel did all the work. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses looked over all the work, and indeed they had done it; as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had commanded, just so they had done it. And Moses blessed them."
                        }
                    ]
                }
            ]
        }
    ]
}