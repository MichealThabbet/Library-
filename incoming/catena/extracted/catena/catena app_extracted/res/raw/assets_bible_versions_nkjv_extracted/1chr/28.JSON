{
    "chapter_num": 28,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Solomon Instructed to Build the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now David assembled at Jerusalem all the leaders of Israel: the officers of the tribes and the captains of the divisions who served the king, the captains over thousands and captains over hundreds, and the stewards over all the substance and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or livestock"
                        },
                        {
                            "style": "NONE",
                            "text": "possessions of the king and of his sons, with the officials, the valiant men, and all the mighty men of valor."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then King David rose to his feet and said, “Hear me, my brethren and my people: I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "had"
                        },
                        {
                            "style": "NONE",
                            "text": " it in my heart to build a house of rest for the ark of the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and for the footstool of our God, and had made preparations to build it. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But God said to me, ‘You shall not build a house for My name, because you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "have been"
                        },
                        {
                            "style": "NONE",
                            "text": " a man of war and have shed blood.’ "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "However the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel chose me above all the house of my father to be king over Israel forever, for He has chosen Judah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " the ruler. And of the house of Judah, the house of my father, and among the sons of my father, He was pleased with me to make "
                        },
                        {
                            "style": "ITALIC",
                            "text": "me"
                        },
                        {
                            "style": "NONE",
                            "text": " king over all Israel. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And of all my sons (for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has given me many sons) He has chosen my son Solomon to sit on the throne of the kingdom of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " over Israel. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now He said to me, ‘It is your son Solomon "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " shall build My house and My courts; for I have chosen him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be"
                        },
                        {
                            "style": "NONE",
                            "text": " My son, and I will be his Father. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover I will establish his kingdom forever, if he is steadfast to observe My commandments and My judgments, as it is this day.’ "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now therefore, in the sight of all Israel, the assembly of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and in the hearing of our God, be careful to seek out all the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, that you may possess this good land, and leave "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " as an inheritance for your children after you forever."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“As for you, my son Solomon, know the God of your father, and serve Him with a loyal heart and with a willing mind; for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " searches all hearts and understands all the intent of the thoughts. If you seek Him, He will be found by you; but if you forsake Him, He will cast you off forever. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Consider now, for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has chosen you to build a house for the sanctuary; be strong, and do it.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then David gave his son Solomon the plans for the vestibule, its houses, its treasuries, its upper chambers, its inner chambers, and the place of the mercy seat; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the plans for all that he had by the Spirit, of the courts of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", of all the chambers all around, of the treasuries of the house of God, and of the treasuries for the dedicated things; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also for the division of the priests and the Levites, for all the work of the service of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and for all the articles of service in the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "He gave"
                        },
                        {
                            "style": "NONE",
                            "text": " gold by weight for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " of gold, for all articles used in every kind of service; also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "silver"
                        },
                        {
                            "style": "NONE",
                            "text": " for all articles of silver by weight, for all articles used in every kind of service; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the weight for the lampstands of gold, and their lamps of gold, by weight for each lampstand and its lamps; for the lampstands of silver by weight, for the lampstand and its lamps, according to the use of each lampstand. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And by weight "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he gave"
                        },
                        {
                            "style": "NONE",
                            "text": " gold for the tables of the showbread, for each table, and silver for the tables of silver; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also pure gold for the forks, the basins, the pitchers of pure gold, and the golden bowls—"
                        },
                        {
                            "style": "ITALIC",
                            "text": "he gave gold"
                        },
                        {
                            "style": "NONE",
                            "text": " by weight for every bowl; and for the silver bowls, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "silver"
                        },
                        {
                            "style": "NONE",
                            "text": " by weight for every bowl; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and refined gold by weight for the altar of incense, and for the construction of the chariot, that is, the gold cherubim that spread "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their wings"
                        },
                        {
                            "style": "NONE",
                            "text": " and overshadowed the ark of the covenant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“All "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this,"
                        },
                        {
                            "style": "NONE",
                            "text": "” "
                        },
                        {
                            "style": "ITALIC",
                            "text": "said David,"
                        },
                        {
                            "style": "NONE",
                            "text": " “the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made me understand in writing, by "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " hand upon me, all the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "details"
                        },
                        {
                            "style": "NONE",
                            "text": "works of these plans.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David said to his son Solomon, “Be strong and of good courage, and do "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it;"
                        },
                        {
                            "style": "NONE",
                            "text": " do not fear nor be dismayed, for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God—my God—"
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you. He will not leave you nor forsake you, until you have finished all the work for the service of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Here are"
                        },
                        {
                            "style": "NONE",
                            "text": " the divisions of the priests and the Levites for all the service of the house of God; and every willing craftsman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you for all manner of workmanship, for every kind of service; also the leaders and all the people "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be"
                        },
                        {
                            "style": "NONE",
                            "text": " completely at your command.”"
                        }
                    ]
                }
            ]
        }
    ]
}