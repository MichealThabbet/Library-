{
    "chapter_num": 36,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Reign and Captivity of Jehoahaz"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the people of the land took Jehoahaz the son of Josiah, and made him king in his father’s place in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "MT Joahaz"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehoahaz "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-three years old when he became king, and he reigned three months in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the king of Egypt deposed him at Jerusalem; and he imposed on the land a tribute of one hundred talents of silver and a talent of gold. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the king of Egypt made "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. his"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Jehoahaz’s"
                        },
                        {
                            "style": "NONE",
                            "text": " brother Eliakim king over Judah and Jerusalem, and changed his name to Jehoiakim. And Necho took "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "MT Joahaz"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehoahaz his brother and carried him off to Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Reign and Captivity of Jehoiakim"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoiakim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five years old when he became king, and he reigned eleven years in Jerusalem. And he did evil in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nebuchadnezzar king of Babylon came up against him, and bound him in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "chains"
                        },
                        {
                            "style": "NONE",
                            "text": "bronze "
                        },
                        {
                            "style": "ITALIC",
                            "text": "fetters"
                        },
                        {
                            "style": "NONE",
                            "text": " to carry him off to Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nebuchadnezzar also carried off "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the articles from the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to Babylon, and put them in his temple at Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the rest of the acts of Jehoiakim, the abominations which he did, and what was found against him, indeed they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the book of the kings of Israel and Judah. Then "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Jeconiah"
                        },
                        {
                            "style": "NONE",
                            "text": "Jehoiachin his son reigned in his place."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Reign and Captivity of Jehoiachin"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoiachin "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. mss., LXX, Syr. eighteen and 2 Kin. 24:8"
                        },
                        {
                            "style": "NONE",
                            "text": "eight years old when he became king, and he reigned in Jerusalem three months and ten days. And he did evil in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At the turn of the year King Nebuchadnezzar summoned "
                        },
                        {
                            "style": "ITALIC",
                            "text": "him"
                        },
                        {
                            "style": "NONE",
                            "text": " and took him to Babylon, with the costly articles from the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and made Zedekiah,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Mattaniah"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. his brother, 2 Kin. 24:17"
                        },
                        {
                            "style": "ITALIC",
                            "text": "Jehoiakim’s"
                        },
                        {
                            "style": "NONE",
                            "text": " brother, king over Judah and Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Zedekiah Reigns in Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zedekiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-one years old when he became king, and he reigned eleven years in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He did evil in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " did not humble himself before Jeremiah the prophet, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who spoke"
                        },
                        {
                            "style": "NONE",
                            "text": " from the mouth of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he also rebelled against King Nebuchadnezzar, who had made him swear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "an oath"
                        },
                        {
                            "style": "NONE",
                            "text": " by God; but he stiffened his neck and hardened his heart against turning to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover all the leaders of the priests and the people transgressed more and more, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "according"
                        },
                        {
                            "style": "NONE",
                            "text": " to all the abominations of the nations, and defiled the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " which He had consecrated in Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Fall of Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of their fathers sent "
                        },
                        {
                            "style": "ITALIC",
                            "text": "warnings"
                        },
                        {
                            "style": "NONE",
                            "text": " to them by His messengers, rising up early and sending "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them,"
                        },
                        {
                            "style": "NONE",
                            "text": " because He had compassion on His people and on His dwelling place. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they mocked the messengers of God, despised His words, and scoffed at His prophets, until the wrath of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " arose against His people, till "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " no remedy."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore He brought against them the king of the Chaldeans, who killed their young men with the sword in the house of their sanctuary, and had no compassion on young man or virgin, on the aged or the weak; He gave "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " all into his hand. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the articles from the house of God, great and small, the treasures of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and the treasures of the king and of his leaders, all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " he took to Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they burned the house of God, broke down the wall of Jerusalem, burned all its palaces with fire, and destroyed all its precious possessions. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those who escaped from the sword he carried away to Babylon, where they became servants to him and his sons until the rule of the kingdom of Persia, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to fulfill the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " by the mouth of Jeremiah, until the land had enjoyed her Sabbaths. As long as she lay desolate she kept Sabbath, to fulfill seventy years."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Proclamation of Cyrus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in the first year of Cyrus king of Persia, that the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " by the mouth of Jeremiah might be fulfilled, the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " stirred up the spirit of Cyrus king of Persia, so that he made a proclamation throughout all his kingdom, and also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "put it"
                        },
                        {
                            "style": "NONE",
                            "text": " in writing, saying,"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus says Cyrus king of Persia:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "All the kingdoms of the earth the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of heaven has given me. And He has commanded me to build Him a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Temple"
                        },
                        {
                            "style": "NONE",
                            "text": "house at Jerusalem which is in Judah. Who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " among you of all His people? May the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with him, and let him go up!"
                        }
                    ]
                }
            ]
        }
    ]
}