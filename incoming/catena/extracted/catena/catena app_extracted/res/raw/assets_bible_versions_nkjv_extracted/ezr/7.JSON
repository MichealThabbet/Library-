{
    "chapter_num": 7,
    "verses_count": 28,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Arrival of Ezra"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now after these things, in the reign of Artaxerxes king of Persia, Ezra the son of Seraiah, the son of Azariah, the son of Hilkiah, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Shallum, the son of Zadok, the son of Ahitub, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Amariah, the son of Azariah, the son of Meraioth, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Zerahiah, the son of Uzzi, the son of Bukki, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the son of Abishua, the son of Phinehas, the son of Eleazar, the son of Aaron the chief priest— "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "this Ezra came up from Babylon; and he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a skilled scribe in the Law of Moses, which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel had given. The king granted him all his request, according to the hand of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God upon him. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "Some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the children of Israel, the priests, the Levites, the singers, the gatekeepers, and the Nethinim came up to Jerusalem in the seventh year of King Artaxerxes. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Ezra came to Jerusalem in the fifth month, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in the seventh year of the king. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the first month he began "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " journey from Babylon, and on the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the fifth month he came to Jerusalem, according to the good hand of his God upon him. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Ezra had prepared his heart to seek"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Study"
                        },
                        {
                            "style": "NONE",
                            "text": " the Law of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and to do "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " and to teach statutes and ordinances in Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Letter of Artaxerxes to Ezra"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a copy of the letter that King Artaxerxes gave Ezra the priest, the scribe, expert in the words of the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and of His statutes to Israel:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "The original language of Ezra 7:12–26 is Aramaic."
                        },
                        {
                            "style": "NONE",
                            "text": "Artaxerxes, king of kings,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To Ezra the priest, a scribe of the Law of the God of heaven:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Perfect "
                        },
                        {
                            "style": "ITALIC",
                            "text": "peace,"
                        },
                        {
                            "style": "NONE",
                            "text": " and"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. and now"
                        },
                        {
                            "style": "NONE",
                            "text": " so forth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I issue a decree that all those of the people of Israel and the priests and Levites in my realm, who volunteer to go up to Jerusalem, may go with you. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whereas you are being sent "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "from before"
                        },
                        {
                            "style": "NONE",
                            "text": "by the king and his seven counselors to inquire concerning Judah and Jerusalem, with regard to the Law of your God which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in your hand; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whereas you are"
                        },
                        {
                            "style": "NONE",
                            "text": " to carry the silver and gold which the king and his counselors have freely offered to the God of Israel, whose dwelling "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in Jerusalem; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whereas"
                        },
                        {
                            "style": "NONE",
                            "text": " all the silver and gold that you may find in all the province of Babylon, along with the freewill offering of the people and the priests, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are to be"
                        },
                        {
                            "style": "NONE",
                            "text": " freely offered for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Temple"
                        },
                        {
                            "style": "NONE",
                            "text": "house of their God in Jerusalem— "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "now therefore, be careful to buy with this money bulls, rams, and lambs, with their grain offerings and their drink offerings, and offer them on the altar of the house of your God in Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whatever seems good to you and your brethren to do with the rest of the silver and the gold, do it according to the will of your God. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also the articles that are given to you for the service of the house of your God, deliver in full before the God of Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whatever more may be needed for the house of your God, which you may have occasion to provide, pay "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for it"
                        },
                        {
                            "style": "NONE",
                            "text": " from the king’s treasury."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "even"
                        },
                        {
                            "style": "NONE",
                            "text": " I, Artaxerxes the king, issue a decree to all the treasurers who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are in the region"
                        },
                        {
                            "style": "NONE",
                            "text": " beyond the River, that whatever Ezra the priest, the scribe of the Law of the God of heaven, may require of you, let it be done diligently, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "up to one hundred talents of silver, one hundred kors of wheat, one hundred baths of wine, one hundred baths of oil, and salt without prescribed limit. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whatever "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. is from the decree"
                        },
                        {
                            "style": "NONE",
                            "text": "is commanded by the God of heaven, let it diligently be done for the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Temple"
                        },
                        {
                            "style": "NONE",
                            "text": "house of the God of heaven. For why should there be wrath against the realm of the king and his sons?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also we inform you that it shall not be lawful to impose tax, tribute, or custom on any of the priests, Levites, singers, gatekeepers, Nethinim, or servants of this house of God. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, Ezra, according to your God-given wisdom, set magistrates and judges who may judge all the people who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are in the region"
                        },
                        {
                            "style": "NONE",
                            "text": " beyond the River, all such as know the laws of your God; and teach those who do not know "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever will not observe the law of your God and the law of the king, let judgment be executed speedily on him, whether "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it be"
                        },
                        {
                            "style": "NONE",
                            "text": " death, or "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. rooting out"
                        },
                        {
                            "style": "NONE",
                            "text": "banishment, or confiscation of goods, or imprisonment."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Blessed"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Hebrew language resumes in Ezra 7:27."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of our fathers, who has put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "such a thing"
                        },
                        {
                            "style": "NONE",
                            "text": " as this in the king’s heart, to beautify the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in Jerusalem, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and has extended mercy to me before the king and his counselors, and before all the king’s mighty princes."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So I was encouraged, as the hand of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " my God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " upon me; and I gathered leading men of Israel to go up with me."
                        }
                    ]
                }
            ]
        }
    ]
}