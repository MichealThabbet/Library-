{
    "chapter_num": 34,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Zedekiah Warned by God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The word which came to Jeremiah from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", when Nebuchadnezzar king of Babylon and all his army, all the kingdoms of the earth under his dominion, and all the people, fought against Jerusalem and all its cities, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the God of Israel: ‘Go and speak to Zedekiah king of Judah and tell him, “Thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": ‘Behold, I will give this city into the hand of the king of Babylon, and he shall burn it with fire. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall not escape from his hand, but shall surely be taken and delivered into his hand; your eyes shall see the eyes of the king of Babylon, he shall speak with you face"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. mouth to mouth"
                        },
                        {
                            "style": "NONE",
                            "text": " to face, and you shall go to Babylon.’ ” ’ "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet hear the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", O Zedekiah king of Judah! Thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " concerning you: ‘You shall not die by the sword. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall die in peace; as in the ceremonies of your fathers, the former kings who were before you, so they shall burn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "incense"
                        },
                        {
                            "style": "NONE",
                            "text": " for you and lament for you, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "saying,"
                        },
                        {
                            "style": "NONE",
                            "text": " “Alas, lord!” For I have pronounced the word, says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jeremiah the prophet spoke all these words to Zedekiah king of Judah in Jerusalem, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "when the king of Babylon’s army fought against Jerusalem and all the cities of Judah that were left, against Lachish and Azekah; for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "only"
                        },
                        {
                            "style": "NONE",
                            "text": " these fortified cities remained of the cities of Judah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Treacherous Treatment of Slaves"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "This is"
                        },
                        {
                            "style": "NONE",
                            "text": " the word that came to Jeremiah from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", after King Zedekiah had made a covenant with all the people who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " at Jerusalem to proclaim liberty to them: "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that every man should set free his male and female slave—a Hebrew man or woman—that no one should keep a Jewish brother in bondage. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when all the princes and all the people, who had entered into the covenant, heard that everyone should set free his male and female slaves, that no one should keep them in bondage anymore, they obeyed and let "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " go. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But afterward they changed their minds and made the male and female slaves return, whom they had set free, and brought them into subjection as male and female slaves."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to Jeremiah from the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", saying, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the God of Israel: ‘I made a covenant with your fathers in the day that I brought them out of the land of Egypt, out of the house of bondage, saying, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“At the end of seven years let every man set free his Hebrew brother, who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or sold himself"
                        },
                        {
                            "style": "NONE",
                            "text": "has been sold to him; and when he has served you six years, you shall let him go free from you.” But your fathers did not obey Me nor incline their ear. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. today"
                        },
                        {
                            "style": "NONE",
                            "text": "recently turned and did what was right in My sight—every man proclaiming liberty to his neighbor; and you made a covenant before Me in the house which is called by My name. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then you turned around and profaned My name, and every one of you brought back his male and female slaves, whom you had set at liberty, at their pleasure, and brought them back into subjection, to be your male and female slaves.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Therefore thus says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": ‘You have not obeyed Me in proclaiming liberty, every one to his brother and every one to his neighbor. Behold, I proclaim liberty to you,’ says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "—‘to the sword, to pestilence, and to famine! And I will deliver you to trouble among all the kingdoms of the earth. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will give the men who have transgressed My covenant, who have not performed the words of the covenant which they made before Me, when they cut the calf in two and passed between the parts of it— "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the princes of Judah, the princes of Jerusalem, the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or officers"
                        },
                        {
                            "style": "NONE",
                            "text": "eunuchs, the priests, and all the people of the land who passed between the parts of the calf— "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will give them into the hand of their enemies and into the hand of those who seek their life. Their dead bodies shall be for meat for the birds of the heaven and the beasts of the earth. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will give Zedekiah king of Judah and his princes into the hand of their enemies, into the hand of those who seek their life, and into the hand of the king of Babylon’s army which has gone back from you. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, I will command,’ says the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", ‘and cause them to return to this city. They will fight against it and take it and burn it with fire; and I will make the cities of Judah a desolation without inhabitant.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}