{
    "chapter_num": 6,
    "verses_count": 18,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Marks of the Ministry"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We then, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " workers together "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with Him"
                        },
                        {
                            "style": "NONE",
                            "text": " also plead with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " not to receive the grace of God in vain. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For He says:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“In an acceptable time I have heard you,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And in the day of salvation I have helped you.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Behold, now "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the accepted time; behold, now "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the day of salvation."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We give no offense in anything, that our ministry may not be blamed. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But in all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " we commend ourselves as ministers of God: in much "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "endurance"
                        },
                        {
                            "style": "NONE",
                            "text": "patience, in tribulations, in needs, in distresses, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in stripes, in imprisonments, in tumults, in labors, in sleeplessness, in fastings; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by purity, by knowledge, by longsuffering, by kindness, by the Holy Spirit, by "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. unhypocritical"
                        },
                        {
                            "style": "NONE",
                            "text": "sincere love, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by the word of truth, by the power of God, by the armor of righteousness on the right hand and on the left, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "by honor and dishonor, by evil report and good report; as deceivers, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yet"
                        },
                        {
                            "style": "NONE",
                            "text": " true; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as unknown, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yet"
                        },
                        {
                            "style": "NONE",
                            "text": " well known; as dying, and behold we live; as chastened, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yet"
                        },
                        {
                            "style": "NONE",
                            "text": " not killed; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as sorrowful, yet always rejoicing; as poor, yet making many rich; as having nothing, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yet"
                        },
                        {
                            "style": "NONE",
                            "text": " possessing all things."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Be Holy"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "O Corinthians! "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Our mouth is open"
                        },
                        {
                            "style": "NONE",
                            "text": "We have spoken openly to you, our heart is wide open. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You are not restricted by us, but you are restricted by your "
                        },
                        {
                            "style": "ITALIC",
                            "text": "own"
                        },
                        {
                            "style": "NONE",
                            "text": " affections. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in return for the same (I speak as to children), you also be open."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not be unequally yoked together with unbelievers. For what "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "in common"
                        },
                        {
                            "style": "NONE",
                            "text": "fellowship has righteousness with lawlessness? And what "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "fellowship"
                        },
                        {
                            "style": "NONE",
                            "text": "communion has light with darkness? "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And what accord has Christ with Belial? Or what part has a believer with an unbeliever? "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And what agreement has the temple of God with idols? For you"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU we"
                        },
                        {
                            "style": "NONE",
                            "text": " are the temple of the living God. As God has said:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“I will dwell in them"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And walk among"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "I will be their God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And they shall be My people.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Come out from among them"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And be separate, says the Lord."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Do not touch what is unclean,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And I will receive you.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "OBLIQUE",
                            "text": "“I"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "will be a Father to you,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And you shall be My"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "sons and daughters,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Says the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Almighty.”"
                        }
                    ]
                }
            ]
        }
    ]
}