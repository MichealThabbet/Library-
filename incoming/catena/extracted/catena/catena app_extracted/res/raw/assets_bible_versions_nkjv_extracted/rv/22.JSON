{
    "chapter_num": 22,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The River of Life"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he showed me a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit pure"
                        },
                        {
                            "style": "NONE",
                            "text": "pure river of water of life, clear as crystal, proceeding from the throne of God and of the Lamb. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the middle of its street, and on either side of the river, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the tree of life, which bore twelve fruits, each "
                        },
                        {
                            "style": "ITALIC",
                            "text": "tree"
                        },
                        {
                            "style": "NONE",
                            "text": " yielding its fruit every month. The leaves of the tree "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " for the healing of the nations. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there shall be no more curse, but the throne of God and of the Lamb shall be in it, and His servants shall serve Him. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall see His face, and His name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " on their foreheads. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There shall be no night there: They need no lamp nor light of the sun, for the Lord God gives them light. And they shall reign forever and ever."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Time Is Near"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to me, “These words "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " faithful and true.” And the Lord God of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M spirits of the prophets"
                        },
                        {
                            "style": "NONE",
                            "text": "holy prophets sent His angel to show His servants the things which must shortly take place."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Behold, I am coming quickly!"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Blessed is he who keeps the words of the prophecy of this book.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I, John, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M am the one who heard and saw"
                        },
                        {
                            "style": "NONE",
                            "text": "saw and heard these things. And when I heard and saw, I fell down to worship before the feet of the angel who showed me these things."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to me, “See "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that you do"
                        },
                        {
                            "style": "NONE",
                            "text": " not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "do that."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit For"
                        },
                        {
                            "style": "NONE",
                            "text": "For I am your fellow servant, and of your brethren the prophets, and of those who keep the words of this book. Worship God.” "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to me, “Do not seal the words of the prophecy of this book, for the time is at hand. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who is unjust, let him be unjust still; he who is filthy, let him be filthy still; he who is righteous, let him "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M do right"
                        },
                        {
                            "style": "NONE",
                            "text": "be righteous still; he who is holy, let him be holy still.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Testifies to the Churches"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“And behold, I am coming quickly, and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "My reward is with Me,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "to give to every one according to his work."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I am the Alpha and the Omega, the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M First and the Last, the Beginning and the End."
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Beginning and the End, the First and the Last.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Blessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " those who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU wash their robes,"
                        },
                        {
                            "style": "NONE",
                            "text": "do His commandments, that they may have the right to the tree of life, and may enter through the gates into the city. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit But"
                        },
                        {
                            "style": "NONE",
                            "text": "But outside "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " dogs and sorcerers and sexually immoral and murderers and idolaters, and whoever loves and practices a lie."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“I, Jesus, have sent My angel to testify to you these things in the churches."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I am the Root and the Offspring of David,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Bright and Morning Star.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Spirit and the bride say, “Come!” And let him who hears say, “Come!” And let him who thirsts come. Whoever desires, let him take the water of life freely."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Warning"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit For"
                        },
                        {
                            "style": "NONE",
                            "text": "For I testify to everyone who hears the words of the prophecy of this book: If anyone adds to these things, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M may God add"
                        },
                        {
                            "style": "NONE",
                            "text": "God will add to him the plagues that are written in this book; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and if anyone takes away from the words of the book of this prophecy, God"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M may God take away"
                        },
                        {
                            "style": "NONE",
                            "text": " shall take away his part from the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M tree of life"
                        },
                        {
                            "style": "NONE",
                            "text": "Book of Life, from the holy city, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from"
                        },
                        {
                            "style": "NONE",
                            "text": " the things which are written in this book."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "I Am Coming Quickly"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who testifies to these things says, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Surely I am coming quickly.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Amen. Even so, come, Lord Jesus!"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The grace of our Lord Jesus Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU with all; M with all the saints"
                        },
                        {
                            "style": "NONE",
                            "text": "with you all. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}