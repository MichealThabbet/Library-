    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Musicians"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover David and the captains of the army separated for the service "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the sons of Asaph, of Heman, and of Jeduthun, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "should"
                        },
                        {
                            "style": "NONE",
                            "text": " prophesy with harps, stringed instruments, and cymbals. And the number of the skilled men performing their service was: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the sons of Asaph: Zaccur, Joseph, Nethaniah, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jesharelah, v. 14"
                        },
                        {
                            "style": "NONE",
                            "text": "Asharelah; the sons of Asaph "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. at the hands of"
                        },
                        {
                            "style": "NONE",
                            "text": "under the direction of Asaph, who prophesied according to the order of the king. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of Jeduthun, the sons of Jeduthun: Gedaliah, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jizri, v. 11"
                        },
                        {
                            "style": "NONE",
                            "text": "Zeri, Jeshaiah, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with one Heb. ms., LXX mss."
                        },
                        {
                            "style": "ITALIC",
                            "text": "Shimei"
                        },
                        {
                            "style": "NONE",
                            "text": ", Hashabiah, and Mattithiah, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shimei is the sixth, v. 17"
                        },
                        {
                            "style": "NONE",
                            "text": "six, under the direction of their father Jeduthun, who prophesied with a harp to give thanks and to praise the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of Heman, the sons of Heman: Bukkiah, Mattaniah, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Azarel, v. 18"
                        },
                        {
                            "style": "NONE",
                            "text": "Uzziel, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shubael, v. 20"
                        },
                        {
                            "style": "NONE",
                            "text": "Shebuel, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jeremoth, v. 22"
                        },
                        {
                            "style": "NONE",
                            "text": "Jerimoth, Hananiah, Hanani, Eliathah, Giddalti, Romamti-Ezer, Joshbekashah, Mallothi, Hothir, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Mahazioth. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Heman the king’s seer in the words of God, to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Increase his power or influence"
                        },
                        {
                            "style": "NONE",
                            "text": "exalt his horn. For God gave Heman fourteen sons and three daughters."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " under the direction of their father for the music "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in"
                        },
                        {
                            "style": "NONE",
                            "text": " the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", with cymbals, stringed instruments, and harps, for the service of the house of God. Asaph, Jeduthun, and Heman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " under the authority of the king. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the number of them, with their brethren who were instructed in the songs of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", all who were skillful, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " two hundred and eighty-eight."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they cast lots for their duty, the small as well as the great, the teacher with the student."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
