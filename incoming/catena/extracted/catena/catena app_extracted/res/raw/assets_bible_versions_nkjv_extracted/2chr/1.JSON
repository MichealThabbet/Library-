{
    "chapter_num": 1,
    "verses_count": 17,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Solomon Requests Wisdom"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Solomon the son of David was strengthened in his kingdom, and the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " with him and exalted him exceedingly."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon spoke to all Israel, to the captains of thousands and of hundreds, to the judges, and to every leader in all Israel, the heads of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Solomon, and all the assembly with him, went to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Place for worship"
                        },
                        {
                            "style": "NONE",
                            "text": "the high place that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " at Gibeon; for the tabernacle of meeting with God was there, which Moses the servant of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had made in the wilderness. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But David had brought up the ark of God from Kirjath Jearim to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the place"
                        },
                        {
                            "style": "NONE",
                            "text": " David had prepared for it, for he had pitched a tent for it at Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the bronze altar that Bezalel the son of Uri, the son of Hur, had made, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Some authorities it was there"
                        },
                        {
                            "style": "NONE",
                            "text": "he put before the tabernacle of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; Solomon and the assembly sought Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon went up there to the bronze altar before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " at the tabernacle of meeting, and offered a thousand burnt offerings on it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On that night God appeared to Solomon, and said to him, “Ask! What shall I give you?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon said to God: “You have shown great mercy to David my father, and have made me king in his place. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now, O "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God, let Your promise to David my father be established, for You have made me king over a people like the dust of the earth in multitude. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now give me wisdom and knowledge, that I may go out and come in before this people; for who can judge this great people of Yours?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then God said to Solomon: “Because this was in your heart, and you have not asked riches or wealth or honor or the life of your enemies, nor have you asked long life—but have asked wisdom and knowledge for yourself, that you may judge My people over whom I have made you king— "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "wisdom and knowledge "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " granted to you; and I will give you riches and wealth and honor, such as none of the kings have had who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " before you, nor shall any after you have the like.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Solomon’s Military and Economic Power"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Solomon came to Jerusalem from "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Place for worship"
                        },
                        {
                            "style": "NONE",
                            "text": "the high place that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " at Gibeon, from before the tabernacle of meeting, and reigned over Israel. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon gathered chariots and horsemen; he had one thousand four hundred chariots and twelve thousand horsemen, whom he stationed in the chariot cities and with the king in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also the king made silver and gold as common in Jerusalem as stones, and he made cedars as abundant as the sycamores which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " in the lowland. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Solomon had horses imported from Egypt and Keveh; the king’s merchants bought them in Keveh at the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "current"
                        },
                        {
                            "style": "NONE",
                            "text": " price. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They also acquired and imported from Egypt a chariot for six hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver, and a horse for one hundred and fifty; thus, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. by their hands"
                        },
                        {
                            "style": "NONE",
                            "text": "through their agents, they exported them to all the kings of the Hittites and the kings of Syria."
                        }
                    ]
                }
            ]
        }
    ]
}