{
    "chapter_num": 2,
    "verses_count": 26,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Be Strong in Grace"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You therefore, my son, be strong in the grace that is in Christ Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the things that you have heard from me among many witnesses, commit these to faithful men who will be able to teach others also. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You therefore must endure"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU You must share"
                        },
                        {
                            "style": "NONE",
                            "text": " hardship as a good soldier of Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No one engaged in warfare entangles himself with the affairs of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this"
                        },
                        {
                            "style": "NONE",
                            "text": " life, that he may please him who enlisted him as a soldier. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And also if anyone competes in athletics, he is not crowned unless he competes according to the rules. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hardworking farmer must be first to partake of the crops. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Consider what I say, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU the Lord will give you"
                        },
                        {
                            "style": "NONE",
                            "text": "may the Lord give you understanding in all things."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Remember that Jesus Christ, of the seed of David, was raised from the dead according to my gospel, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for which I suffer trouble as an evildoer, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "even"
                        },
                        {
                            "style": "NONE",
                            "text": " to the point of chains; but the word of God is not chained. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I endure all things for the sake of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "chosen ones"
                        },
                        {
                            "style": "NONE",
                            "text": "elect, that they also may obtain the salvation which is in Christ Jesus with eternal glory."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "This is"
                        },
                        {
                            "style": "NONE",
                            "text": " a faithful saying:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For if we died with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "We shall also live with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we endure,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "We shall also reign with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "If we deny "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He also will deny us."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we are faithless,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He remains faithful;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He cannot deny Himself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Approved and Disapproved Workers"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Remind "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " of these things, charging "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " before the Lord not to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "battle"
                        },
                        {
                            "style": "NONE",
                            "text": "strive about words to no profit, to the ruin of the hearers. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Be diligent to present yourself approved to God, a worker who does not need to be ashamed, rightly dividing the word of truth. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But shun profane "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "empty chatter"
                        },
                        {
                            "style": "NONE",
                            "text": "idle babblings, for they will "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "lead"
                        },
                        {
                            "style": "NONE",
                            "text": "increase to more ungodliness. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their message will spread like cancer. Hymenaeus and Philetus are of this sort, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who have strayed concerning the truth, saying that the resurrection is already past; and they overthrow the faith of some. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless the solid foundation of God stands, having this seal: “The Lord knows those who are His,” and, “Let everyone who names the name of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "Christ depart from iniquity.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But in a great house there are not only vessels of gold and silver, but also of wood and clay, some for honor and some for dishonor. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore if anyone cleanses himself from the latter, he will be a vessel for honor, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctified and useful for the Master, prepared for every good work. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Flee also youthful lusts; but pursue righteousness, faith, love, peace with those who call on the Lord out of a pure heart. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But avoid foolish and ignorant disputes, knowing that they generate strife. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And a servant of the Lord must not quarrel but be gentle to all, able to teach, patient, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in humility correcting those who are in opposition, if God perhaps will grant them repentance, so that they may know the truth, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " they may come to their senses "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "escape"
                        },
                        {
                            "style": "NONE",
                            "text": " the snare of the devil, having been taken captive by him to "
                        },
                        {
                            "style": "ITALIC",
                            "text": "do"
                        },
                        {
                            "style": "NONE",
                            "text": " his will."
                        }
                    ]
                }
            ]
        }
    ]
}