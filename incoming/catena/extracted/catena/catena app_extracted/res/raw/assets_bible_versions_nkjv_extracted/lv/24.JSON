{
    "chapter_num": 24,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Care of the Tabernacle Lamps"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Command the children of Israel that they bring to you pure oil of pressed olives for the light, to make the lamps burn continually. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Outside the veil of the Testimony, in the tabernacle of meeting, Aaron shall be in charge of it from evening until morning before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever in your generations. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "arrange or set in order"
                        },
                        {
                            "style": "NONE",
                            "text": "be in charge of the lamps on the pure "
                        },
                        {
                            "style": "ITALIC",
                            "text": "gold"
                        },
                        {
                            "style": "NONE",
                            "text": " lampstand before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Bread of the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall take fine flour and bake twelve cakes with it. Two-tenths "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of an ephah"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be in each cake. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall set them in two rows, six in a row, on the pure "
                        },
                        {
                            "style": "ITALIC",
                            "text": "gold"
                        },
                        {
                            "style": "NONE",
                            "text": " table before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put pure frankincense on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "each"
                        },
                        {
                            "style": "NONE",
                            "text": " row, that it may be on the bread for a memorial, an offering made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every Sabbath he shall set it in order before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "being taken"
                        },
                        {
                            "style": "NONE",
                            "text": " from the children of Israel by an everlasting covenant. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be for Aaron and his sons, and they shall eat it in a holy place; for it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " most holy to him from the offerings of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made by fire, by a perpetual statute.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Penalty for Blasphemy"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the son of an Israelite woman, whose father "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " an Egyptian, went out among the children of Israel; and this Israelite "
                        },
                        {
                            "style": "ITALIC",
                            "text": "woman’s"
                        },
                        {
                            "style": "NONE",
                            "text": " son and a man of Israel fought each other in the camp. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Israelite woman’s son blasphemed the name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and cursed; and so they brought him to Moses. (His mother’s name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Shelomith the daughter of Dibri, of the tribe of Dan.) "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they put him "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "under guard"
                        },
                        {
                            "style": "NONE",
                            "text": "in custody, that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. it might be declared to them from the mouth of the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "the mind of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " might be shown to them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Take outside the camp him who has cursed; then let all who heard "
                        },
                        {
                            "style": "ITALIC",
                            "text": "him"
                        },
                        {
                            "style": "NONE",
                            "text": " lay their hands on his head, and let all the congregation stone him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then you shall speak to the children of Israel, saying: ‘Whoever curses his God shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "be responsible for"
                        },
                        {
                            "style": "NONE",
                            "text": "bear his sin. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever blasphemes the name of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall surely be put to death. All the congregation shall certainly stone him, the stranger as well as him who is born in the land. When he blasphemes the name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", he shall be put to death."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Whoever kills any man shall surely be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever kills an animal shall make it good, animal for animal."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If a man causes disfigurement of his neighbor, as he has done, so shall it be done to him— "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "fracture for fracture, eye for eye, tooth for tooth; as he has caused disfigurement of a man, so shall it be done to him. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever kills an animal shall restore it; but whoever kills a man shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall have the"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "one standard of judgment"
                        },
                        {
                            "style": "NONE",
                            "text": " same law for the stranger and for one from your own country; for I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses spoke to the children of Israel; and they took outside the camp him who had cursed, and stoned him with stones. So the children of Israel did as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses."
                        }
                    ]
                }
            ]
        }
    ]
}