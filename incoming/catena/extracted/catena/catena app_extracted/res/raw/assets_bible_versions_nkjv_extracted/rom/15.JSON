{
    "chapter_num": 15,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Bearing Others’ Burdens"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We then who are strong ought to bear with the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "weaknesses"
                        },
                        {
                            "style": "NONE",
                            "text": "scruples of the weak, and not to please ourselves. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let each of us please "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " neighbor for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " good, leading to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "building up"
                        },
                        {
                            "style": "NONE",
                            "text": "edification. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For even Christ did not please Himself; but as it is written, "
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“The reproaches of those who reproached You fell on Me.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For whatever things were written before were written for our learning, that we through the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "perseverance"
                        },
                        {
                            "style": "NONE",
                            "text": "patience and comfort of the Scriptures might have hope. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now may the God of patience and comfort grant you to be like-minded toward one another, according to Christ Jesus, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that you may with one mind "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " one mouth glorify the God and Father of our Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Glorify God Together"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore receive one another, just as Christ also received "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M you"
                        },
                        {
                            "style": "NONE",
                            "text": "us, to the glory of God. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I say that Jesus Christ has become a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "minister"
                        },
                        {
                            "style": "NONE",
                            "text": "servant to the circumcision for the truth of God, to confirm the promises "
                        },
                        {
                            "style": "ITALIC",
                            "text": "made"
                        },
                        {
                            "style": "NONE",
                            "text": " to the fathers, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and that the Gentiles might glorify God for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " mercy, as it is written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“For this reason I will confess to You among the Gentiles,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And sing to Your name.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And again he says:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Rejoice, O Gentiles, with His people!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And again:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Praise the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": ", all you Gentiles!"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "Laud Him, all you peoples!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And again, Isaiah says:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“There shall be a root of Jesse;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And He who shall rise to reign over the Gentiles,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "In Him the Gentiles shall hope.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now may the God of hope fill you with all joy and peace in believing, that you may abound in hope by the power of the Holy Spirit."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "From Jerusalem to Illyricum"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I myself am confident concerning you, my brethren, that you also are full of goodness, filled with all knowledge, able also to admonish "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M others"
                        },
                        {
                            "style": "NONE",
                            "text": "one another. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless, brethren, I have written more boldly to you on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " points, as reminding you, because of the grace given to me by God, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that I might be a minister of Jesus Christ to the Gentiles, ministering the gospel of God, that the offering "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Consisting of"
                        },
                        {
                            "style": "NONE",
                            "text": "of the Gentiles might be acceptable, sanctified by the Holy Spirit. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I have reason to glory in Christ Jesus in the things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which pertain"
                        },
                        {
                            "style": "NONE",
                            "text": " to God. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I will not dare to speak of any of those things which Christ has not accomplished through me, in word and deed, to make the Gentiles obedient— "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in mighty signs and wonders, by the power of the Spirit of God, so that from Jerusalem and round about to Illyricum I have fully preached the gospel of Christ. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And so I have made it my aim to preach the gospel, not where Christ was named, lest I should build on another man’s foundation, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but as it is written:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“To whom He was not announced, they shall see;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "And those who have not heard shall understand.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Plan to Visit Rome"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason I also have been much hindered from coming to you. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now no longer having a place in these parts, and having a great desire these many years to come to you, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "whenever I journey to Spain, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits I shall come to you and joins Spain with the next sentence."
                        },
                        {
                            "style": "NONE",
                            "text": "I shall come to you. For I hope to see you on my journey, and to be helped on my way there by you, if first I may enjoy your "
                        },
                        {
                            "style": "ITALIC",
                            "text": "company"
                        },
                        {
                            "style": "NONE",
                            "text": " for a while. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But now I am going to Jerusalem to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "serve"
                        },
                        {
                            "style": "NONE",
                            "text": "minister to the saints. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For it pleased those from Macedonia and Achaia to make a certain contribution for the poor among the saints who are in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It pleased them indeed, and they are their debtors. For if the Gentiles have been partakers of their spiritual things, their duty is also to minister to them in material things. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore, when I have performed this and have sealed to them this fruit, I shall go by way of you to Spain. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I know that when I come to you, I shall come in the fullness of the blessing "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits of the gospel"
                        },
                        {
                            "style": "NONE",
                            "text": "of the gospel of Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I beg you, brethren, through the Lord Jesus Christ, and through the love of the Spirit, that you strive together with me in prayers to God for me, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that I may be delivered from those in Judea who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "are disobedient"
                        },
                        {
                            "style": "NONE",
                            "text": "do not believe, and that my service for Jerusalem may be acceptable to the saints, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that I may come to you with joy by the will of God, and may be refreshed together with you. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the God of peace "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you all. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}