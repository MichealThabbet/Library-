{
    "chapter_num": 22,
    "verses_count": 30,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Various Laws of Morality"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not see your brother’s ox or his sheep going astray, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ignore them"
                        },
                        {
                            "style": "NONE",
                            "text": "hide yourself from them; you shall certainly bring them back to your brother. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if your brother "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not near you, or if you do not know him, then you shall bring it to your own house, and it shall remain with you until your brother seeks it; then you shall restore it to him. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall do the same with his donkey, and so shall you do with his garment; with any lost thing of your brother’s, which he has lost and you have found, you shall do likewise; you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "may not avoid responsibility"
                        },
                        {
                            "style": "NONE",
                            "text": "must not hide yourself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not see your brother’s donkey or his ox fall down along the road, and hide yourself from them; you shall surely help him lift "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " up again."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A woman shall not wear anything that pertains to a man, nor shall a man put on a woman’s garment, for all who do so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable"
                        },
                        {
                            "style": "NONE",
                            "text": "an abomination to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a bird’s nest happens to be before you along the way, in any tree or on the ground, with young ones or eggs, with the mother sitting on the young or on the eggs, you shall not take the mother with the young; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall surely let the mother go, and take the young for yourself, that it may be well with you and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " you may prolong "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When you build a new house, then you shall make a parapet for your roof, that you may not bring guilt of bloodshed on your household if anyone falls from it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not sow your vineyard with different kinds of seed, lest the yield of the seed which you have sown and the fruit of your vineyard be defiled."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not plow with an ox and a donkey together."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not wear a garment of different sorts, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "such as"
                        },
                        {
                            "style": "NONE",
                            "text": " wool and linen mixed together."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make tassels on the four corners of the clothing with which you cover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "yourself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Laws of Sexual Morality"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If any man takes a wife, and goes in to her, and detests her, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and charges her with shameful conduct, and brings a bad name on her, and says, ‘I took this woman, and when I came to her I found she "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " not a virgin,’ "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the father and mother of the young woman shall take and bring out "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the evidence of"
                        },
                        {
                            "style": "NONE",
                            "text": " the young woman’s virginity to the elders of the city at the gate. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the young woman’s father shall say to the elders, ‘I gave my daughter to this man as wife, and he detests her. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now he has charged her with shameful conduct, saying, “I found your daughter "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " not a virgin,” and yet these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are the evidences of"
                        },
                        {
                            "style": "NONE",
                            "text": " my daughter’s virginity.’ And they shall spread the cloth before the elders of the city. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the elders of that city shall take that man and punish him; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they shall fine him one hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver and give "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to the father of the young woman, because he has brought a bad name on a virgin of Israel. And she shall be his wife; he cannot divorce her all his days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if the thing is true, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and evidences of"
                        },
                        {
                            "style": "NONE",
                            "text": " virginity are not found for the young woman, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then they shall bring out the young woman to the door of her father’s house, and the men of her city shall stone her to death with stones, because she has done a disgraceful thing in Israel, to play the harlot in her father’s house. So you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "purge the evil person"
                        },
                        {
                            "style": "NONE",
                            "text": "put away the evil from among you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man is found lying with a woman married to a husband, then both of them shall die—the man that lay with the woman, and the woman; so you shall put away the evil from Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a young woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " a virgin is betrothed to a husband, and a man finds her in the city and lies with her, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall bring them both out to the gate of that city, and you shall stone them to death with stones, the young woman because she did not cry out in the city, and the man because he humbled his neighbor’s wife; so you shall put away the evil from among you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if a man finds a betrothed young woman in the countryside, and the man forces her and lies with her, then only the man who lay with her shall die. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But you shall do nothing to the young woman; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " in the young woman no sin "
                        },
                        {
                            "style": "ITALIC",
                            "text": "deserving"
                        },
                        {
                            "style": "NONE",
                            "text": " of death, for just as when a man rises against his neighbor and kills him, even so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " this matter. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For he found her in the countryside, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the betrothed young woman cried out, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " no one to save her."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a man finds a young woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " a virgin, who is not betrothed, and he seizes her and lies with her, and they are found out, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the man who lay with her shall give to the young woman’s father fifty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver, and she shall be his wife because he has humbled her; he shall not be permitted to divorce her all his days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A man shall not take his father’s wife, nor uncover his father’s bed."
                        }
                    ]
                }
            ]
        }
    ]
}