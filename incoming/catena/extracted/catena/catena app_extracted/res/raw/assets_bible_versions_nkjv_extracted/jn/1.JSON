{
    "chapter_num": 1,
    "verses_count": 51,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Eternal Word"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the beginning was the Word, and the Word was with God, and the Word was God. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was in the beginning with God. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All things were made through Him, and without Him nothing was made that was made. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In Him was life, and the life was the light of men. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the light shines in the darkness, and the darkness did not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or overcome"
                        },
                        {
                            "style": "NONE",
                            "text": "comprehend it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "John’s Witness: The True Light"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There was a man sent from God, whose name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " John. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This man came for a witness, to bear witness of the Light, that all through him might believe. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was not that Light, but "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was sent"
                        },
                        {
                            "style": "NONE",
                            "text": " to bear witness of that Light. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or That was the true Light which, coming into the world, gives light to every man."
                        },
                        {
                            "style": "NONE",
                            "text": " was the true Light which gives light to every man coming into the world."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was in the world, and the world was made through Him, and the world did not know Him. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He came to His "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "His own things or domain"
                        },
                        {
                            "style": "NONE",
                            "text": "own, and His "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "His own people"
                        },
                        {
                            "style": "NONE",
                            "text": "own did not receive Him. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But as many as received Him, to them He gave the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "authority"
                        },
                        {
                            "style": "NONE",
                            "text": "right to become children of God, to those who believe in His name: "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who were born, not of blood, nor of the will of the flesh, nor of the will of man, but of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Word Becomes Flesh"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Word became flesh and dwelt among us, and we beheld His glory, the glory as of the only begotten of the Father, full of grace and truth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John bore witness of Him and cried out, saying, “This was He of whom I said, ‘He who comes after me "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ranks higher than I"
                        },
                        {
                            "style": "NONE",
                            "text": "is preferred before me, for He was before me.’ ”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU For"
                        },
                        {
                            "style": "NONE",
                            "text": "And of His fullness we have all received, and grace for grace. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the law was given through Moses, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "but"
                        },
                        {
                            "style": "NONE",
                            "text": " grace and truth came through Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No one has seen God at any time. The only begotten "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU God"
                        },
                        {
                            "style": "NONE",
                            "text": "Son, who is in the bosom of the Father, He has declared "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Voice in the Wilderness"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now this is the testimony of John, when the Jews sent priests and Levites from Jerusalem to ask him, “Who are you?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He confessed, and did not deny, but confessed, “I am not the Christ.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they asked him, “What then? Are you Elijah?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He said, “I am not.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Are you the Prophet?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And he answered, “No.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they said to him, “Who are you, that we may give an answer to those who sent us? What do you say about yourself?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said: “I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "am"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "‘The voice of one crying in the wilderness:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": "“Make straight the way of the"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "OBLIQUE",
                            "text": ",” ’"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "as the prophet Isaiah said.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now those who were sent were from the Pharisees. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they asked him, saying, “Why then do you baptize if you are not the Christ, nor Elijah, nor the Prophet?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John answered them, saying, “I baptize with water, but there stands One among you whom you do not know. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It is He who, coming after me, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ranks higher than I"
                        },
                        {
                            "style": "NONE",
                            "text": "is preferred before me, whose sandal strap I am not worthy to loose.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These things were done in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M Bethany"
                        },
                        {
                            "style": "NONE",
                            "text": "Bethabara beyond the Jordan, where John was baptizing."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Lamb of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The next day John saw Jesus coming toward him, and said, “Behold! The Lamb of God who takes away the sin of the world! "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is He of whom I said, ‘After me comes a Man who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ranks higher than I"
                        },
                        {
                            "style": "NONE",
                            "text": "is preferred before me, for He was before me.’ "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I did not know Him; but that He should be revealed to Israel, therefore I came baptizing with water.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And John bore witness, saying, “I saw the Spirit descending from heaven like a dove, and He remained upon Him. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I did not know Him, but He who sent me to baptize with water said to me, ‘Upon whom you see the Spirit descending, and remaining on Him, this is He who baptizes with the Holy Spirit.’ "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I have seen and testified that this is the Son of God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The First Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Again, the next day, John stood with two of his disciples. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And looking at Jesus as He walked, he said, “Behold the Lamb of God!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The two disciples heard him speak, and they followed Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus turned, and seeing them following, said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“What do you seek?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "They said to Him, “Rabbi” (which is to say, when translated, Teacher), “where are You staying?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Come and see.”"
                        },
                        {
                            "style": "NONE",
                            "text": " They came and saw where He was staying, and remained with Him that day (now it was about the tenth hour)."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "One of the two who heard John "
                        },
                        {
                            "style": "ITALIC",
                            "text": "speak,"
                        },
                        {
                            "style": "NONE",
                            "text": " and followed Him, was Andrew, Simon Peter’s brother. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He first found his own brother Simon, and said to him, “We have found the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. Anointed One"
                        },
                        {
                            "style": "NONE",
                            "text": "Messiah” (which is translated, the Christ). "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he brought him to Jesus."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Now when Jesus looked at him, He said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“You are Simon the son of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU John"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Jonah."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "You shall be called Cephas”"
                        },
                        {
                            "style": "NONE",
                            "text": " (which is translated, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gr. Petros, usually translated Peter"
                        },
                        {
                            "style": "NONE",
                            "text": "A Stone)."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Philip and Nathanael"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The following day Jesus wanted to go to Galilee, and He found Philip and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Follow Me.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Philip was from Bethsaida, the city of Andrew and Peter. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Philip found Nathanael and said to him, “We have found Him of whom Moses in the law, and also the prophets, wrote—Jesus of Nazareth, the son of Joseph.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Nathanael said to him, “Can anything good come out of Nazareth?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Philip said to him, “Come and see.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus saw Nathanael coming toward Him, and said of him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Behold,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "an Israelite indeed, in whom is no deceit!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nathanael said to Him, “How do You know me?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Jesus answered and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Before Philip called you, when you were under the fig tree, I saw you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nathanael answered and said to Him, “Rabbi, You are the Son of God! You are the King of Israel!”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered and said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Because I said to you, ‘I saw you under the fig tree,’ do you believe? You will see greater things than these.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Most assuredly, I say to you,"
                        },
                        {
