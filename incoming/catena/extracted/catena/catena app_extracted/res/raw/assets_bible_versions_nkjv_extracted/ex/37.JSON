{
    "chapter_num": 37,
    "verses_count": 29,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Making the Ark of the Testimony"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Bezalel made the ark of acacia wood; two and a half cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " its length, a cubit and a half its width, and a cubit and a half its height. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He overlaid it with pure gold inside and outside, and made a molding of gold all around it. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he cast for it four rings of gold "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to be set"
                        },
                        {
                            "style": "NONE",
                            "text": " in its four corners: two rings on one side, and two rings on the other side of it. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made poles of acacia wood, and overlaid them with gold. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he put the poles into the rings at the sides of the ark, to bear the ark. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made the mercy seat of pure gold; two and a half cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " its length and a cubit and a half its width. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made two cherubim of beaten gold; he made them of one piece at the two ends of the mercy seat: "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one cherub at one end on this side, and the other cherub at the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " end on that side. He made the cherubim at the two ends "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of one piece"
                        },
                        {
                            "style": "NONE",
                            "text": " with the mercy seat. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The cherubim spread out "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " wings above, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " covered the mercy seat with their wings. They faced one another; the faces of the cherubim were toward the mercy seat."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Table for the Showbread"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the table of acacia wood; two cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " its length, a cubit its width, and a cubit and a half its height. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he overlaid it with pure gold, and made a molding of gold all around it. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also he made a frame of a handbreadth all around it, and made a molding of gold for the frame all around it. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he cast for it four rings of gold, and put the rings on the four corners that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " at its four legs. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The rings were close to the frame, as holders for the poles to bear the table. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the poles of acacia wood to bear the table, and overlaid them with gold. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made of pure gold the utensils which were on the table: its dishes, its cups, its bowls, and its pitchers for pouring."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Gold Lampstand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made the lampstand of pure gold; of hammered work he made the lampstand. Its shaft, its branches, its bowls, its "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knobs, and its flowers were of the same piece. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And six branches came out of its sides: three branches of the lampstand out of one side, and three branches of the lampstand out of the other side. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There were three bowls made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms"
                        },
                        {
                            "style": "NONE",
                            "text": " on one branch, with an "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and a flower, and three bowls made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms"
                        },
                        {
                            "style": "NONE",
                            "text": " on the other branch, with an "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and a flower—and so for the six branches coming out of the lampstand. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the lampstand itself "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " four bowls made like almond "
                        },
                        {
                            "style": "ITALIC",
                            "text": "blossoms, each with"
                        },
                        {
                            "style": "NONE",
                            "text": " its "
                        },
                        {
                            "style": "ITALIC",
                            "text": "ornamental"
                        },
                        {
                            "style": "NONE",
                            "text": " knob and flower. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There was"
                        },
                        {
                            "style": "NONE",
                            "text": " a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "first"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "second"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, and a knob under the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "third"
                        },
                        {
                            "style": "NONE",
                            "text": " two branches of the same, according to the six branches extending from it. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their knobs and their branches were of one piece; all of it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hammered piece of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made its seven lamps, its wick-trimmers, and its trays of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of a talent of pure gold he made it, with all its utensils."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Altar of Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the incense altar of acacia wood. Its length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a cubit and its width a cubit—"
                        },
                        {
                            "style": "ITALIC",
                            "text": "it was"
                        },
                        {
                            "style": "NONE",
                            "text": " square—and two cubits "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " its height. Its horns were "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of one piece"
                        },
                        {
                            "style": "NONE",
                            "text": " with it. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he overlaid it with pure gold: its top, its sides all around, and its horns. He also made for it a molding of gold all around it. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made two rings of gold for it under its molding, by its two corners on both sides, as holders for the poles with which to bear it. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the poles of acacia wood, and overlaid them with gold."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Anointing Oil and the Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made the holy anointing oil and the pure incense of sweet spices, according to the work of the perfumer."
                        }
                    ]
                }
            ]
        }
    ]
}