{
    "chapter_num": 16,
    "verses_count": 34,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Day of Atonement"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses after the death of the two sons of Aaron, when they offered "
                        },
                        {
                            "style": "ITALIC",
                            "text": "profane fire"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and died; "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses: “Tell Aaron your brother not to come at "
                        },
                        {
                            "style": "ITALIC",
                            "text": "just"
                        },
                        {
                            "style": "NONE",
                            "text": " any time into the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": " inside the veil, before the mercy seat which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the ark, lest he die; for I will appear in the cloud above the mercy seat."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. With this"
                        },
                        {
                            "style": "NONE",
                            "text": "“Thus Aaron shall come into the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place:"
                        },
                        {
                            "style": "NONE",
                            "text": " with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the blood of"
                        },
                        {
                            "style": "NONE",
                            "text": " a young bull as a sin offering, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of"
                        },
                        {
                            "style": "NONE",
                            "text": " a ram as a burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall put the holy linen tunic and the linen trousers on his body; he shall be girded with a linen sash, and with the linen turban he shall be attired. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy garments. Therefore he shall wash his body in water, and put them on. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall take from the congregation of the children of Israel two kids of the goats as a sin offering, and one ram as a burnt offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Aaron shall offer the bull as a sin offering, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " for himself, and make atonement for himself and for his house. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall take the two goats and present them before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "at"
                        },
                        {
                            "style": "NONE",
                            "text": " the door of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Aaron shall cast lots for the two goats: one lot for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and the other lot for the scapegoat. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Aaron shall bring the goat on which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s lot fell, and offer it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the goat on which the lot fell to be the scapegoat shall be presented alive before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to make atonement upon it, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " to let it go as the scapegoat into the wilderness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And Aaron shall bring the bull of the sin offering, which is for himself, and make atonement for himself and for his house, and shall kill the bull as the sin offering which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " for himself. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he shall take a censer full of burning coals of fire from the altar before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", with his hands full of sweet incense beaten fine, and bring "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " inside the veil. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall put the incense on the fire before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", that the cloud of incense may cover the mercy seat that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the Testimony, lest he die. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall take some of the blood of the bull and sprinkle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " with his finger on the mercy seat on the east "
                        },
                        {
                            "style": "ITALIC",
                            "text": "side;"
                        },
                        {
                            "style": "NONE",
                            "text": " and before the mercy seat he shall sprinkle some of the blood with his finger seven times."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then he shall kill the goat of the sin offering, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " for the people, bring its blood inside the veil, do with that blood as he did with the blood of the bull, and sprinkle it on the mercy seat and before the mercy seat. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So he shall make atonement for the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": ", because of the uncleanness of the children of Israel, and because of their transgressions, for all their sins; and so he shall do for the tabernacle of meeting which remains among them in the midst of their uncleanness. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There shall be no man in the tabernacle of meeting when he goes in to make atonement in the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": ", until he comes out, that he may make atonement for himself, for his household, and for all the assembly of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall go out to the altar that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and make atonement for it, and shall take some of the blood of the bull and some of the blood of the goat, and put it on the horns of the altar all around. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he shall sprinkle some of the blood on it with his finger seven times, cleanse it, and consecrate"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set it apart"
                        },
                        {
                            "style": "NONE",
                            "text": " it from the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "impurity"
                        },
                        {
                            "style": "NONE",
                            "text": "uncleanness of the children of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And when he has made an end of atoning for the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": ", the tabernacle of meeting, and the altar, he shall bring the live goat. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Aaron shall lay both his hands on the head of the live goat, confess over it all the iniquities of the children of Israel, and all their transgressions, concerning all their sins, putting them on the head of the goat, and shall send "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " away into the wilderness by the hand of a suitable man. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The goat "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "shall carry"
                        },
                        {
                            "style": "NONE",
                            "text": "shall bear on itself all their iniquities to an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "solitary land"
                        },
                        {
                            "style": "NONE",
                            "text": "uninhabited land; and he shall release the goat in the wilderness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then Aaron shall come into the tabernacle of meeting, shall take off the linen garments which he put on when he went into the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": ", and shall leave them there. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall wash his body with water in a holy place, put on his garments, come out and offer his burnt offering and the burnt offering of the people, and make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for himself and for the people. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fat of the sin offering he shall burn on the altar. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he who released the goat as the scapegoat shall wash his clothes and bathe his body in water, and afterward he may come into the camp. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The bull "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " the sin offering and the goat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " the sin offering, whose blood was brought in to make atonement in the Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place"
                        },
                        {
                            "style": "NONE",
                            "text": ", shall be carried outside the camp. And they shall burn in the fire their skins, their flesh, and their offal. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he who burns them shall wash his clothes and bathe his body in water, and afterward he may come into the camp."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“"
                        },
                        {
                            "style": "ITALIC",
                            "text": "This"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be a statute forever for you: In the seventh month, on the tenth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the month, you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "humble yourselves"
                        },
                        {
                            "style": "NONE",
                            "text": "afflict your souls, and do no work at all, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whether"
                        },
                        {
                            "style": "NONE",
                            "text": " a native of your own country or a stranger who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "As a resident alien"
                        },
                        {
                            "style": "NONE",
                            "text": "dwells among you. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For on that day "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the priest"
                        },
                        {
                            "style": "NONE",
                            "text": " shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for you, to cleanse you, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " you may be clean from all your sins before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a sabbath of solemn rest for you, and you shall afflict your souls. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "It is"
                        },
                        {
                            "style": "NONE",
                            "text": " a statute forever. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the priest, who is anointed and consecrated to minister as priest in his father’s place, shall make atonement, and put on the linen clothes, the holy garments; "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then he shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Most Holy Place"
                        },
                        {
                            "style": "NONE",
                            "text": "the Holy Sanctuary, and he shall make atonement for the tabernacle of meeting and for the altar, and he shall make atonement for the priests and for all the people of the assembly. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This shall be an everlasting statute for you, to make atonement for the children of Israel, for all their sins, once a year.” And he did as the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses."
                        }
                    ]
                }
            ]
        }
    ]
}