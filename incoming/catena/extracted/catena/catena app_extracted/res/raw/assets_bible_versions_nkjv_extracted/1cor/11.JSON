{
    "chapter_num": 11,
    "verses_count": 34,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Worship and the Lord’s Supper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Imitate me, just as I also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "imitate"
                        },
                        {
                            "style": "NONE",
                            "text": " Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Head Coverings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I praise you, brethren, that you remember me in all things and keep the traditions just as I delivered "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to you. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I want you to know that the head of every man is Christ, the head of woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " man, and the head of Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " God. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every man praying or prophesying, having "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " head covered, dishonors his head. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But every woman who prays or prophesies with "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " head uncovered dishonors her head, for that is one and the same as if her head were shaved. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For if a woman is not covered, let her also be shorn. But if it is shameful for a woman to be shorn or shaved, let her be covered. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For a man indeed ought not to cover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " head, since he is the image and glory of God; but woman is the glory of man. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For man is not from woman, but woman from man. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nor was man created for the woman, but woman for the man. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason the woman ought to have "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a symbol of"
                        },
                        {
                            "style": "NONE",
                            "text": " authority on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " head, because of the angels. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless, neither "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " man independent of woman, nor woman independent of man, in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "came"
                        },
                        {
                            "style": "NONE",
                            "text": " from man, even so man also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "comes"
                        },
                        {
                            "style": "NONE",
                            "text": " through woman; but all things are from God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Judge among yourselves. Is it proper for a woman to pray to God with her head uncovered? "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Does not even nature itself teach you that if a man has long hair, it is a dishonor to him? "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if a woman has long hair, it is a glory to her; for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " hair is given "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M omits to her"
                        },
                        {
                            "style": "NONE",
                            "text": "to her for a covering. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if anyone seems to be contentious, we have no such custom, nor "
                        },
                        {
                            "style": "ITALIC",
                            "text": "do"
                        },
                        {
                            "style": "NONE",
                            "text": " the churches of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Conduct at the Lord’s Supper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in giving these instructions I do not praise "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you,"
                        },
                        {
                            "style": "NONE",
                            "text": " since you come together not for the better but for the worse. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For first of all, when you come together as a church, I hear that there are divisions among you, and in part I believe it. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For there must also be factions among you, that those who are approved may be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. manifest, evident"
                        },
                        {
                            "style": "NONE",
                            "text": "recognized among you. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore when you come together in one place, it is not to eat the Lord’s Supper. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in eating, each one takes his own supper ahead of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "others;"
                        },
                        {
                            "style": "NONE",
                            "text": " and one is hungry and another is drunk. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What! Do you not have houses to eat and drink in? Or do you despise the church of God and shame "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The poor"
                        },
                        {
                            "style": "NONE",
                            "text": "those who have nothing? What shall I say to you? Shall I praise you in this? I do not praise "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Institution of the Lord’s Supper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I received from the Lord that which I also delivered to you: that the Lord Jesus on the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "same"
                        },
                        {
                            "style": "NONE",
                            "text": " night in which He was betrayed took bread; "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and when He had given thanks, He broke "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " and said, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits Take, eat"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Take, eat; this is My body which is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits broken"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "broken for you; do this in remembrance of Me.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the same manner "
                        },
                        {
                            "style": "ITALIC",
                            "text": "He"
                        },
                        {
                            "style": "NONE",
                            "text": " also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "took"
                        },
                        {
                            "style": "NONE",
                            "text": " the cup after supper, saying, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“This cup is the new covenant in My blood. This do, as often as you drink it, in remembrance of Me.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For as often as you eat this bread and drink this cup, you proclaim the Lord’s death till He comes."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Examine Yourself"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore whoever eats this bread or drinks "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this"
                        },
                        {
                            "style": "NONE",
                            "text": " cup of the Lord in an unworthy manner will be guilty of the body and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M the blood"
                        },
                        {
                            "style": "NONE",
                            "text": "blood of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But let a man examine himself, and so let him eat of the bread and drink of the cup. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For he who eats and drinks "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits in an unworthy manner"
                        },
                        {
                            "style": "NONE",
                            "text": "in an unworthy manner eats and drinks judgment to himself, not discerning the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits Lord’s"
                        },
                        {
                            "style": "NONE",
                            "text": "Lord’s body. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason many "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " weak and sick among you, and many "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Are dead"
                        },
                        {
                            "style": "NONE",
                            "text": "sleep. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For if we would judge ourselves, we would not be judged. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when we are judged, we are chastened by the Lord, that we may not be condemned with the world."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore, my brethren, when you come together to eat, wait for one another. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if anyone is hungry, let him eat at home, lest you come together for judgment. And the rest I will set in order when I come."
                        }
                    ]
                }
            ]
        }
    ]
}