{
    "chapter_num": 15,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Debts Canceled Every Seven Years"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“At the end of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "every"
                        },
                        {
                            "style": "NONE",
                            "text": " seven years you shall grant a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "remission"
                        },
                        {
                            "style": "NONE",
                            "text": "release "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of debts."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the form of the release: Every creditor who has lent "
                        },
                        {
                            "style": "ITALIC",
                            "text": "anything"
                        },
                        {
                            "style": "NONE",
                            "text": " to his neighbor shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "cancel the debt"
                        },
                        {
                            "style": "NONE",
                            "text": "release "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it;"
                        },
                        {
                            "style": "NONE",
                            "text": " he shall not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "exact it"
                        },
                        {
                            "style": "NONE",
                            "text": "require "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " of his neighbor or his brother, because it is called the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s release. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of a foreigner you may require "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it;"
                        },
                        {
                            "style": "NONE",
                            "text": " but you shall give up your claim to what is owed by your brother, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "except when there may be no poor among you; for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " will greatly bless you in the land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you to possess "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " an inheritance— "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "only if you carefully obey the voice of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, to observe with care all these commandments which I command you today. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will bless you just as He promised you; you shall lend to many nations, but you shall not borrow; you shall reign over many nations, but they shall not reign over you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Generosity to the Poor"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If there is among you a poor man of your brethren, within any of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "towns"
                        },
                        {
                            "style": "NONE",
                            "text": "gates in your land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you, you shall not harden your heart nor shut your hand from your poor brother, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "freely open"
                        },
                        {
                            "style": "NONE",
                            "text": "open your hand wide to him and willingly lend him sufficient for his need, whatever he needs. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beware lest there be a wicked thought in your heart, saying, ‘The seventh year, the year of release, is at hand,’ and your eye be evil against your poor brother and you give him nothing, and he cry out to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " against you, and it become sin among you. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall surely give to him, and your heart should not be grieved when you give to him, because for this thing the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will bless you in all your works and in all to which you put your hand. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the poor will never cease from the land; therefore I command you, saying, ‘You shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "freely open"
                        },
                        {
                            "style": "NONE",
                            "text": "open your hand wide to your brother, to your poor and your needy, in your land.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law Concerning Bondservants"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If your brother, a Hebrew man, or a Hebrew woman, is sold to you and serves you six years, then in the seventh year you shall let him go free from you. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when you "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set him free"
                        },
                        {
                            "style": "NONE",
                            "text": "send him away free from you, you shall not let him go away empty-handed; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall supply him liberally from your flock, from your threshing floor, and from your winepress. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "From what"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has blessed you with, you shall give to him. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall remember that you were a slave in the land of Egypt, and the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God redeemed you; therefore I command you this thing today. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if it happens that he says to you, ‘I will not go away from you,’ because he loves you and your house, since he prospers with you, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall take an awl and thrust "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " through his ear to the door, and he shall be your servant forever. Also to your female servant you shall do likewise. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall not seem hard to you when you send him away free from you; for he has been worth a double hired servant in serving you six years. Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will bless you in all that you do."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law Concerning Firstborn Animals"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“All the firstborn males that come from your herd and your flock you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set apart or consecrate"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctify to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God; you shall do no work with the firstborn of your herd, nor shear the firstborn of your flock. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You and your household shall eat "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God year by year in the place which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " chooses. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if there is a defect in it, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if it is"
                        },
                        {
                            "style": "NONE",
                            "text": " lame or blind "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or has"
                        },
                        {
                            "style": "NONE",
                            "text": " any serious defect, you shall not sacrifice it to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You may eat it within your gates; the unclean and the clean "
                        },
                        {
                            "style": "ITALIC",
                            "text": "person"
                        },
                        {
                            "style": "NONE",
                            "text": " alike "
                        },
                        {
                            "style": "ITALIC",
                            "text": "may eat it,"
                        },
                        {
                            "style": "NONE",
                            "text": " as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if it were"
                        },
                        {
                            "style": "NONE",
                            "text": " a gazelle or a deer. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Only you shall not eat its blood; you shall pour it on the ground like water."
                        }
                    ]
                }
            ]
        }
    ]
}