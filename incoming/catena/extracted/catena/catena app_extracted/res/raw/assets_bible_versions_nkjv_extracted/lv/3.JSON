                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall lay his hand on the head of his offering, and kill it before the tabernacle of meeting; and Aaron’s sons shall sprinkle its blood all around on the altar."
                        }
                    ]
                }
            ]
        },
