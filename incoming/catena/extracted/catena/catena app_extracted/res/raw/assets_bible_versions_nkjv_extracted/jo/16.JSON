{
    "chapter_num": 16,
    "verses_count": 10,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Ephraim and West Manasseh"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The lot "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. went out"
                        },
                        {
                            "style": "NONE",
                            "text": "fell to the children of Joseph from the Jordan, by Jericho, to the waters of Jericho on the east, to the wilderness that goes up from Jericho through the mountains to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "LXX Bethel Luz"
                        },
                        {
                            "style": "NONE",
                            "text": "Bethel, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then went out "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "LXX to Bethel,"
                        },
                        {
                            "style": "NONE",
                            "text": "from Bethel to Luz, passed along to the border of the Archites at Ataroth, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and went down westward to the boundary of the Japhletites, as far as the boundary of Lower Beth Horon to Gezer; and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the goings out of it were at the sea"
                        },
                        {
                            "style": "NONE",
                            "text": "it ended at the sea."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the children of Joseph, Manasseh and Ephraim, took their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "possession"
                        },
                        {
                            "style": "NONE",
                            "text": "inheritance."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Ephraim"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The border of the children of Ephraim, according to their families, was "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thus:"
                        },
                        {
                            "style": "NONE",
                            "text": " The border of their inheritance on the east side was Ataroth Addar as far as Upper Beth Horon."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border went out toward the sea on the north side of Michmethath; then the border went around eastward to Taanath Shiloh, and passed by it on the east of Janohah. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then it went down from Janohah to Ataroth and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Naaran, 1 Chr. 7:28"
                        },
                        {
                            "style": "NONE",
                            "text": "Naarah, reached to Jericho, and came out at the Jordan."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The border went out from Tappuah westward to the Brook Kanah, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the goings out of it were at the sea"
                        },
                        {
                            "style": "NONE",
                            "text": "it ended at the sea. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Ephraim according to their families. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The separate cities for the children of Ephraim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " among the inheritance of the children of Manasseh, all the cities with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they did not drive out the Canaanites who dwelt in Gezer; but the Canaanites dwell among the Ephraimites to this day and have become forced laborers."
                        }
                    ]
                }
            ]
        }
    ]
}