{
    "chapter_num": 8,
    "verses_count": 20,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Remember the Lord Your God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Every commandment which I command you today you must "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "observe to do"
                        },
                        {
                            "style": "NONE",
                            "text": "be careful to observe, that you may live and multiply,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "increase in number"
                        },
                        {
                            "style": "NONE",
                            "text": " and go in and possess the land of which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "promised"
                        },
                        {
                            "style": "NONE",
                            "text": "swore to your fathers. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall remember that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God led you all the way these forty years in the wilderness, to humble you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " test you, to know what "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in your heart, whether you would keep His commandments or not. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So He humbled you, allowed you to hunger, and fed you with manna which you did not know nor did your fathers know, that He might make you know that man shall not live by bread alone; but man lives by every "
                        },
                        {
                            "style": "ITALIC",
                            "text": "word"
                        },
                        {
                            "style": "NONE",
                            "text": " that proceeds from the mouth of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your garments did not wear out on you, nor did your foot swell these forty years. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You should "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consider"
                        },
                        {
                            "style": "NONE",
                            "text": "know in your heart that as a man chastens his son, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "so"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chastens you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Therefore you shall keep the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, to walk in His ways and to fear Him. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is bringing you into a good land, a land of brooks of water, of fountains and springs, that flow out of valleys and hills; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a land of wheat and barley, of vines and fig trees and pomegranates, a land of olive oil and honey; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a land in which you will eat bread without scarcity, in which you will lack nothing; a land whose stones "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " iron and out of whose hills you can dig copper. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When you have eaten and are full, then you shall bless the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God for the good land which He has given you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Beware that you do not forget the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God by not keeping His commandments, His judgments, and His statutes which I command you today, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest—"
                        },
                        {
                            "style": "ITALIC",
                            "text": "when"
                        },
                        {
                            "style": "NONE",
                            "text": " you have eaten and are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "satisfied"
                        },
                        {
                            "style": "NONE",
                            "text": "full, and have built beautiful houses and dwell "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in them;"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "when"
                        },
                        {
                            "style": "NONE",
                            "text": " your herds and your flocks multiply, and your silver and your gold are "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "increased"
                        },
                        {
                            "style": "NONE",
                            "text": "multiplied, and all that you have is multiplied; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "when your heart "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "becomes proud"
                        },
                        {
                            "style": "NONE",
                            "text": "is lifted up, and you forget the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God who brought you out of the land of Egypt, from the house of bondage; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who led you through that great and terrible wilderness, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in which were"
                        },
                        {
                            "style": "NONE",
                            "text": " fiery serpents and scorpions and thirsty land where there was no water; who brought water for you out of the flinty rock; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who fed you in the wilderness with manna, which your fathers did not know, that He might humble you and that He might test you, to do you good in the end— "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you say in your heart, ‘My power and the might of my hand have gained me this wealth.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall remember the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " He who gives you power to get wealth, that He may "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "confirm"
                        },
                        {
                            "style": "NONE",
                            "text": "establish His covenant which He swore to your fathers, as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " this day. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then it shall be, if you by any means forget the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, and follow other gods, and serve them and worship them, I testify against you this day that you shall surely perish. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As the nations which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " destroys before you, so you shall perish, because you would not be obedient to the voice of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        }
                    ]
                }
            ]
        }
    ]
}