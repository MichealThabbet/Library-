{
    "chapter_num": 1,
    "verses_count": 20,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, an apostle of Jesus Christ, by the commandment of God our Savior and the Lord Jesus Christ, our hope,"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To Timothy, a true son in the faith:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Grace, mercy, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " peace from God our Father and Jesus Christ our Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "No Other Doctrine"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As I urged you when I went into Macedonia—remain in Ephesus that you may "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "command"
                        },
                        {
                            "style": "NONE",
                            "text": "charge some that they teach no other doctrine, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor give heed to fables and endless genealogies, which cause disputes rather than godly edification which is in faith. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the purpose of the commandment is love from a pure heart, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from"
                        },
                        {
                            "style": "NONE",
                            "text": " a good conscience, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "from"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. unhypocritical"
                        },
                        {
                            "style": "NONE",
                            "text": "sincere faith, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from which some, having strayed, have turned aside to idle talk, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "desiring to be teachers of the law, understanding neither what they say nor the things which they affirm."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But we know that the law "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " good if one uses it lawfully, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "knowing this: that the law is not made for a righteous person, but for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " lawless and insubordinate, for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " ungodly and for sinners, for "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " unholy and profane, for murderers of fathers and murderers of mothers, for manslayers, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for fornicators, for sodomites, for kidnappers, for liars, for perjurers, and if there is any other thing that is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "opposed"
                        },
                        {
                            "style": "NONE",
                            "text": "contrary to sound doctrine, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "according to the glorious gospel of the blessed God which was committed to my trust."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Glory to God for His Grace"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I thank Christ Jesus our Lord who has enabled me, because He counted me faithful, putting "
                        },
                        {
                            "style": "ITALIC",
                            "text": "me"
                        },
                        {
                            "style": "NONE",
                            "text": " into the ministry, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "although I was formerly a blasphemer, a persecutor, and an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "violently arrogant"
                        },
                        {
                            "style": "NONE",
                            "text": "insolent man; but I obtained mercy because I did "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " ignorantly in unbelief. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the grace of our Lord was exceedingly abundant, with faith and love which are in Christ Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a faithful saying and worthy of all acceptance, that Christ Jesus came into the world to save sinners, of whom I am chief. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "However, for this reason I obtained mercy, that in me first Jesus Christ might show all longsuffering, as a pattern to those who are going to believe on Him for everlasting life. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now to the King eternal, immortal, invisible, to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU the only God,"
                        },
                        {
                            "style": "NONE",
                            "text": "God who alone is wise, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " honor and glory forever and ever. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Fight the Good Fight"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "command"
                        },
                        {
                            "style": "NONE",
                            "text": "charge I commit to you, son Timothy, according to the prophecies previously made concerning you, that by them you may wage the good warfare, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having faith and a good conscience, which some having rejected, concerning the faith have suffered shipwreck, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of whom are Hymenaeus and Alexander, whom I delivered to Satan that they may learn not to blaspheme."
                        }
                    ]
                }
            ]
        }
    ]
}