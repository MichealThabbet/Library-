                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " chosen"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "called"
                        },
                        {
                            "style": "NONE",
                            "text": " from the congregation, leaders of their fathers’ tribes, heads of the divisions in Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses and Aaron took these men who had been "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "designated"
                        },
                        {
                            "style": "NONE",
                            "text": "mentioned by name, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they assembled all the congregation together on the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the second month; and they recited their ancestry by families, by their fathers’ houses, according to the number of names, from twenty years old and above, each one individually. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses, so he numbered them in the Wilderness of Sinai."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the children of Reuben, Israel’s oldest son, their genealogies by their families, by their fathers’ house, according to the number of names, every male individually, from twenty years old and above, all who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were able to"
                        },
                        {
                            "style": "NONE",
                            "text": " go to war: "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "those who were numbered of the tribe of Reuben "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " forty-six thousand five hundred."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
