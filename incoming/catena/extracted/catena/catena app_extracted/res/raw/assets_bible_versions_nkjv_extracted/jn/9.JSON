{
    "chapter_num": 9,
    "verses_count": 41,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "A Man Born Blind Receives Sight"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Jesus"
                        },
                        {
                            "style": "NONE",
                            "text": " passed by, He saw a man who was blind from birth. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And His disciples asked Him, saying, “Rabbi, who sinned, this man or his parents, that he was born blind?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Neither this man nor his parents sinned,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "but that the works of God should be revealed in him."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU We"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "must work the works of Him who sent Me while it is"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "day; the night is coming when no one can work."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "As long as I am in the world,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "I am the light of the world.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When He had said these things, He spat on the ground and made clay with the saliva; and He anointed the eyes of the blind man with the clay. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Go, wash"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "in the pool of Siloam”"
                        },
                        {
                            "style": "NONE",
                            "text": " (which is translated, Sent). So he went and washed, and came back seeing."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore the neighbors and those who previously had seen that he was "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU a beggar"
                        },
                        {
                            "style": "NONE",
                            "text": "blind said, “Is not this he who sat and begged?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Some said, “This is he.” Others "
                        },
                        {
                            "style": "ITALIC",
                            "text": "said,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU “No, but he is like him.”"
                        },
                        {
                            "style": "NONE",
                            "text": "“He is like him.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He said, “I am "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he."
                        },
                        {
                            "style": "NONE",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore they said to him, “How were your eyes opened?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He answered and said, “A Man called Jesus made clay and anointed my eyes and said to me, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "‘Go to"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits the pool of"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the pool of Siloam and wash.’"
                        },
                        {
                            "style": "NONE",
                            "text": " So I went and washed, and I received sight.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they said to him, “Where is He?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He said, “I do not know.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Pharisees Excommunicate the Healed Man"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They brought him who formerly was blind to the Pharisees. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it was a Sabbath when Jesus made the clay and opened his eyes. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the Pharisees also asked him again how he had received his sight. He said to them, “He put clay on my eyes, and I washed, and I see.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore some of the Pharisees said, “This Man is not from God, because He does not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "observe"
                        },
                        {
                            "style": "NONE",
                            "text": "keep the Sabbath.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Others said, “How can a man who is a sinner do such signs?” And there was a division among them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said to the blind man again, “What do you say about Him because He opened your eyes?”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "He said, “He is a prophet.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the Jews did not believe concerning him, that he had been blind and received his sight, until they called the parents of him who had received his sight. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they asked them, saying, “Is this your son, who you say was born blind? How then does he now see?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His parents answered them and said, “We know that this is our son, and that he was born blind; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but by what means he now sees we do not know, or who opened his eyes we do not know. He is of age; ask him. He will speak for himself.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His parents said these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "things"
                        },
                        {
                            "style": "NONE",
                            "text": " because they feared the Jews, for the Jews had agreed already that if anyone confessed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " He "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Christ, he would be put out of the synagogue. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore his parents said, “He is of age; ask him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they again called the man who was blind, and said to him, “Give God the glory! We know that this Man is a sinner.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He answered and said, “Whether He is a sinner "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or not"
                        },
                        {
                            "style": "NONE",
                            "text": " I do not know. One thing I know: that though I was blind, now I see.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they said to him again, “What did He do to you? How did He open your eyes?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He answered them, “I told you already, and you did not listen. Why do you want to hear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " again? Do you also want to become His disciples?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they reviled him and said, “You are His disciple, but we are Moses’ disciples. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We know that God spoke to Moses; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as for"
                        },
                        {
                            "style": "NONE",
                            "text": " this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "fellow,"
                        },
                        {
                            "style": "NONE",
                            "text": " we do not know where He is from.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The man answered and said to them, “Why, this is a marvelous thing, that you do not know where He is from; yet He has opened my eyes! "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now we know that God does not hear sinners; but if anyone is a worshiper of God and does His will, He hears him. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Since the world began it has been unheard of that anyone opened the eyes of one who was born blind. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If this Man were not from God, He could do nothing.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They answered and said to him, “You were completely born in sins, and are you teaching us?” And they "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Excommunicated him"
                        },
                        {
                            "style": "NONE",
                            "text": "cast him out."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "True Vision and True Blindness"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus heard that they had cast him out; and when He had found him, He said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Do you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "believe in"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "the Son of"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Man"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "God?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He answered and said, “Who is He, Lord, that I may believe in Him?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to him, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“You have both seen Him and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "it is He who is talking with you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said, “Lord, I believe!” And he worshiped Him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“For judgment I have come into this world,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "that those who do not see may see, and that those who see may be made blind.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the Pharisees who were with Him heard these words, and said to Him, “Are we blind also?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“If you were blind, you would have no sin; but now you say, ‘We see.’ Therefore your sin remains."
                        }
                    ]
                }
            ]
        }
    ]
}