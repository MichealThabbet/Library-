{
    "chapter_num": 17,
    "verses_count": 20,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Various Instructions"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not sacrifice to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God a bull or sheep which has any "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. evil thing"
                        },
                        {
                            "style": "NONE",
                            "text": "blemish "
                        },
                        {
                            "style": "ITALIC",
                            "text": "or"
                        },
                        {
                            "style": "NONE",
                            "text": " defect, for that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable thing"
                        },
                        {
                            "style": "NONE",
                            "text": "abomination to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If there is found among you, within any of your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "towns"
                        },
                        {
                            "style": "NONE",
                            "text": "gates which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you, a man or a woman who has been wicked in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, in transgressing His covenant, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who has gone and served other gods and worshiped them, either the sun or moon or any of the host of heaven, which I have not commanded, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and it is told you, and you hear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of it,"
                        },
                        {
                            "style": "NONE",
                            "text": " then you shall inquire diligently. And if "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " indeed true "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " certain that such an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "detestable thing"
                        },
                        {
                            "style": "NONE",
                            "text": "abomination has been committed in Israel, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall bring out to your gates that man or woman who has committed that wicked thing, and shall stone to death that man or woman with stones. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever is deserving of death shall be put to death on the testimony of two or three witnesses; he shall not be put to death on the testimony of one witness. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hands of the witnesses shall be the first against him to put him to death, and afterward the hands of all the people. So you shall put away the evil from among you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If a matter arises which is too hard for you to judge, between degrees of guilt for bloodshed, between one judgment or another, or between one punishment or another, matters of controversy within your gates, then you shall arise and go up to the place which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chooses. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall come to the priests, the Levites, and to the judge "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there"
                        },
                        {
                            "style": "NONE",
                            "text": " in those days, and inquire "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of them;"
                        },
                        {
                            "style": "NONE",
                            "text": " they shall pronounce upon you the sentence of judgment. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall do according to the sentence which they pronounce upon you in that place which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " chooses. And you shall be careful to do according to all that they order you. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "According to the sentence of the law in which they instruct you, according to the judgment which they tell you, you shall do; you shall not turn aside "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the right hand or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the left from the sentence which they pronounce upon you. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the man who acts presumptuously and will not heed the priest who stands to minister there before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, or the judge, that man shall die. So you shall put away the evil from Israel. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the people shall hear and fear, and no longer act presumptuously."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Principles Governing Kings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When you come to the land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you, and possess it and dwell in it, and say, ‘I will set a king over me like all the nations that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " around me,’ "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall surely set a king over you whom the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God chooses; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "one"
                        },
                        {
                            "style": "NONE",
                            "text": " from among your brethren you shall set as king over you; you may not set a foreigner over you, who "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " not your brother. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he shall not multiply horses for himself, nor cause the people to return to Egypt to multiply horses, for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has said to you, ‘You shall not return that way again.’ "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Neither shall he multiply wives for himself, lest his heart turn away; nor shall he greatly multiply silver and gold for himself."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Also it shall be, when he sits on the throne of his kingdom, that he shall write for himself a copy of this law in a book, from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the one"
                        },
                        {
                            "style": "NONE",
                            "text": " before the priests, the Levites. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be with him, and he shall read it all the days of his life, that he may learn to fear the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God and be careful to observe all the words of this law and these statutes, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that his heart may not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "become proud"
                        },
                        {
                            "style": "NONE",
                            "text": "be lifted above his brethren, that he may not turn aside from the commandment "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the right hand or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to"
                        },
                        {
                            "style": "NONE",
                            "text": " the left, and that he may "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "continue long in his kingdom"
                        },
                        {
                            "style": "NONE",
                            "text": "prolong "
                        },
                        {
                            "style": "ITALIC",
                            "text": "his"
                        },
                        {
                            "style": "NONE",
                            "text": " days in his kingdom, he and his children in the midst of Israel."
                        }
                    ]
                }
            ]
        }
    ]
}