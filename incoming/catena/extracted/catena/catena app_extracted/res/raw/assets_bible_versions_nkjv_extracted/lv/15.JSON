{
    "chapter_num": 15,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Law Concerning Bodily Discharges"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses and Aaron, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, and say to them: ‘When any man has a discharge from his body, his discharge "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " unclean. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this shall be his uncleanness in regard to his discharge—whether his body runs with his discharge, or his body is stopped up by his discharge, it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " his uncleanness. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every bed is "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "defiled"
                        },
                        {
                            "style": "NONE",
                            "text": "unclean on which he who has the discharge lies, and everything on which he sits shall be unclean. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever touches his bed shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who sits on anything on which he who has the discharge sat shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he who touches the body of him who has the discharge shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he who has the discharge spits on him who is clean, then he shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Any saddle on which he who has the discharge rides shall be unclean. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever touches anything that was under him shall be unclean until evening. He who carries "
                        },
                        {
                            "style": "ITALIC",
                            "text": "any of"
                        },
                        {
                            "style": "NONE",
                            "text": " those things shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whomever the one who has the discharge touches, and has not rinsed his hands in water, he shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The vessel of earth that he who has the discharge touches shall be broken, and every vessel of wood shall be rinsed in water."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘And when he who has a discharge is cleansed of his discharge, then he shall count for himself seven days for his cleansing, wash his clothes, and bathe his body in running water; then he shall be clean. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the eighth day he shall take for himself two turtledoves or two young pigeons, and come before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", to the door of the tabernacle of meeting, and give them to the priest. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall offer them, the one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering and the other "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a burnt offering. So the priest shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for him before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " because of his discharge."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If any man has an emission of semen, then he shall wash all his body in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And any garment and any leather on which there is semen, it shall be washed with water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also, when a woman lies with a man, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " an emission of semen, they shall bathe in water, and be unclean until evening."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If a woman has a discharge, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the discharge from her body is blood, she shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. in her impurity"
                        },
                        {
                            "style": "NONE",
                            "text": "set apart seven days; and whoever touches her shall be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Everything that she lies on during her impurity shall be unclean; also everything that she sits on shall be unclean. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever touches her bed shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And whoever touches anything that she sat on shall wash his clothes and bathe in water, and be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If "
                        },
                        {
                            "style": "ITALIC",
                            "text": "anything"
                        },
                        {
                            "style": "NONE",
                            "text": " is on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " bed or on anything on which she sits, when he touches it, he shall be unclean until evening. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if any man lies with her at all, so that her impurity is on him, he shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "defiled"
                        },
                        {
                            "style": "NONE",
                            "text": "unclean seven days; and every bed on which he lies shall be unclean."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If a woman has a discharge of blood for many days, other than at the time of her "
                        },
                        {
                            "style": "ITALIC",
                            "text": "customary"
                        },
                        {
                            "style": "NONE",
                            "text": " impurity, or if it runs beyond her "
                        },
                        {
                            "style": "ITALIC",
                            "text": "usual time of"
                        },
                        {
                            "style": "NONE",
                            "text": " impurity, all the days of her unclean discharge shall be as the days of her "
                        },
                        {
                            "style": "ITALIC",
                            "text": "customary"
                        },
                        {
                            "style": "NONE",
                            "text": " impurity. She "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " unclean. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every bed on which she lies all the days of her discharge shall be to her as the bed of her impurity; and whatever she sits on shall be unclean, as the uncleanness of her impurity. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Whoever touches those things shall be unclean; he shall wash his clothes and bathe in water, and be unclean until evening."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘But if she is cleansed of her discharge, then she shall count for herself seven days, and after that she shall be clean. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the eighth day she shall take for herself two turtledoves or two young pigeons, and bring them to the priest, to the door of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall offer the one "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering and the other "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " a burnt offering, and the priest shall make atonement for her before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " for the discharge of her uncleanness."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Thus you shall separate the children of Israel from their uncleanness, lest they die in their uncleanness when they defile My tabernacle that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " among them. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law for one who has a discharge, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for him"
                        },
                        {
                            "style": "NONE",
                            "text": " who emits semen and is unclean thereby, "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and for her who is indisposed because of her "
                        },
                        {
                            "style": "ITALIC",
                            "text": "customary"
                        },
                        {
                            "style": "NONE",
                            "text": " impurity, and for one who has a discharge, either man or woman, and for him who lies with her who is unclean.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}