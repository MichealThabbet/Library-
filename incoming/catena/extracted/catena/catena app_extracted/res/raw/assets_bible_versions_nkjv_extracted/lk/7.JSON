                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "You did not anoint My head with oil, but this woman has anointed My feet with fragrant oil."
