        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then He turned to the woman and said to Simon, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Do you see this woman? I entered your house; you gave Me no"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "water for My feet, but she has washed My feet with her tears and wiped them with the hair of her head."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
