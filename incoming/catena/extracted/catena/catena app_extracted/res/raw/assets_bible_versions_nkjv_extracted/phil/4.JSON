{
    "chapter_num": 4,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Be Anxious for Nothing; Think These Thoughts"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore, my beloved and longed-for brethren, my joy and crown, so stand fast in the Lord, beloved."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Be United, Joyful, and in Prayer"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I implore Euodia and I implore Syntyche to be of the same mind in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M Yes"
                        },
                        {
                            "style": "NONE",
                            "text": "And I urge you also, true companion, help these women who labored with me in the gospel, with Clement also, and the rest of my fellow workers, whose names "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " in the Book of Life."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Rejoice in the Lord always. Again I will say, rejoice!"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let your "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "graciousness or forbearance"
                        },
                        {
                            "style": "NONE",
                            "text": "gentleness be known to all men. The Lord "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " at hand."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Be anxious for nothing, but in everything by prayer and supplication, with thanksgiving, let your requests be made known to God; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the peace of God, which surpasses all understanding, will guard your hearts and minds through Christ Jesus."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Meditate on These Things"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Finally, brethren, whatever things are true, whatever things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " noble, whatever things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " just, whatever things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " pure, whatever things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " lovely, whatever things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " of good report, if "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " any virtue and if "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " anything praiseworthy—meditate on these things. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The things which you learned and received and heard and saw in me, these do, and the God of peace will be with you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Philippian Generosity"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I rejoiced in the Lord greatly that now at last your"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "you have revived your care"
                        },
                        {
                            "style": "NONE",
                            "text": " care for me has flourished again; though you surely did care, but you lacked opportunity. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Not that I speak in regard to need, for I have learned in whatever state I am, to be content: "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I know how to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "live humbly"
                        },
                        {
                            "style": "NONE",
                            "text": "be abased, and I know how to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "live in prosperity"
                        },
                        {
                            "style": "NONE",
                            "text": "abound. Everywhere and in all things I have learned both to be full and to be hungry, both to abound and to suffer need. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I can do all things through "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Him who"
                        },
                        {
                            "style": "NONE",
                            "text": "Christ who strengthens me."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless you have done well that you shared in my distress. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now you Philippians know also that in the beginning of the gospel, when I departed from Macedonia, no church shared with me concerning giving and receiving but you only. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For even in Thessalonica you sent "
                        },
                        {
                            "style": "ITALIC",
                            "text": "aid"
                        },
                        {
                            "style": "NONE",
                            "text": " once and again for my necessities. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Not that I seek the gift, but I seek the fruit that abounds to your account. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Indeed I "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or have received all"
                        },
                        {
                            "style": "NONE",
                            "text": "have all and abound. I am full, having received from Epaphroditus the things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sent"
                        },
                        {
                            "style": "NONE",
                            "text": " from you, a sweet-smelling aroma, an acceptable sacrifice, well pleasing to God. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And my God shall supply all your need according to His riches in glory by Christ Jesus. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now to our God and Father "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " glory forever and ever. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Greeting and Blessing"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet every saint in Christ Jesus. The brethren who are with me greet you. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the saints greet you, but especially those who are of Caesar’s household."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The grace of our Lord Jesus Christ be with "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU your spirit"
                        },
                        {
                            "style": "NONE",
                            "text": "you all. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}