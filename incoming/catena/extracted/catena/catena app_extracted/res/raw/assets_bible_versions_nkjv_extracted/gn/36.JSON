                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the chiefs "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who descended"
                        },
                        {
                            "style": "NONE",
                            "text": " from Aholibamah, Esau’s wife, the daughter of Anah. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Esau, who is Edom, and these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " their chiefs."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Sons of Seir"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Seir the Horite who inhabited the land: Lotan, Shobal, Zibeon, Anah, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Dishon, Ezer, and Dishan. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the chiefs of the Horites, the sons of Seir, in the land of Edom."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of Lotan were Hori and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Homam, 1 Chr. 1:39"
                        },
                        {
                            "style": "NONE",
                            "text": "Hemam. Lotan’s sister "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Timna."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Shobal: "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Alian, 1 Chr. 1:40"
                        },
                        {
                            "style": "NONE",
                            "text": "Alvan, Manahath, Ebal, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shephi, 1 Chr. 1:40"
                        },
                        {
                            "style": "NONE",
                            "text": "Shepho, and Onam."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Zibeon: both Ajah and Anah. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was the"
                        },
                        {
                            "style": "NONE",
                            "text": " Anah who found the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Vg. (hot springs); LXX Jamin; Tg. mighty men; Talmud mules"
                        },
                        {
                            "style": "NONE",
                            "text": "water in the wilderness as he pastured the donkeys of his father Zibeon. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the children of Anah: Dishon and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Oholibamah"
                        },
                        {
                            "style": "NONE",
                            "text": "Aholibamah the daughter of Anah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Dishan"
                        },
                        {
                            "style": "NONE",
                            "text": "Dishon: "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Hamran, 1 Chr. 1:41"
                        },
                        {
                            "style": "NONE",
                            "text": "Hemdan, Eshban, Ithran, and Cheran. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Ezer: Bilhan, Zaavan, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jaakan, 1 Chr. 1:42"
                        },
                        {
                            "style": "NONE",
