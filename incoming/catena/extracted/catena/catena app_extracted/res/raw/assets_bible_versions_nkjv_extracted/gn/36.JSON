                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Dishan: Uz and Aran."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the chiefs of the Horites: Chief Lotan, Chief Shobal, Chief Zibeon, Chief Anah, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Chief Dishon, Chief Ezer, and Chief Dishan. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the chiefs of the Horites, according to their chiefs in the land of Seir."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Kings of Edom"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the kings who reigned in the land of Edom before any king reigned over the children of Israel: "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bela the son of Beor reigned in Edom, and the name of his city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Dinhabah. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Bela died, Jobab the son of Zerah of Bozrah reigned in his place. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Jobab died, Husham of the land of the Temanites reigned in his place. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Husham died, Hadad the son of Bedad, who attacked Midian in the field of Moab, reigned in his place. And the name of his city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Avith. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Hadad died, Samlah of Masrekah reigned in his place. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Samlah died, Saul of Rehoboth-"
                        },
                        {
                            "style": "ITALIC",
                            "text": "by"
                        },
                        {
                            "style": "NONE",
                            "text": "-the-River reigned in his place. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Saul died, Baal-Hanan the son of Achbor reigned in his place. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when Baal-Hanan the son of Achbor died, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Sam., Syr. Hadad and 1 Chr. 1:50"
                        },
                        {
                            "style": "NONE",
                            "text": "Hadar reigned in his place; and the name of his city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Pai, 1 Chr. 1:50"
                        },
                        {
                            "style": "NONE",
                            "text": "Pau. His wife’s name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Mehetabel, the daughter of Matred, the daughter of Mezahab."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Chiefs of Esau"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the names of the chiefs of Esau, according to their families and their places, by their names: Chief Timnah, Chief "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Aliah, 1 Chr. 1:51"
                        },
                        {
                            "style": "NONE",
                            "text": "Alvah, Chief Jetheth, "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Chief "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Oholibamah"
                        },
                        {
                            "style": "NONE",
                            "text": "Aholibamah, Chief Elah, Chief Pinon, "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
