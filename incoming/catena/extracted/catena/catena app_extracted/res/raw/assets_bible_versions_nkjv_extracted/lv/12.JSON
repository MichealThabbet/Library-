{
    "chapter_num": 12,
    "verses_count": 8,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Ritual After Childbirth"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, saying: ‘If a woman has conceived, and borne a male child, then she shall be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "impure"
                        },
                        {
                            "style": "NONE",
                            "text": "unclean seven days; as in the days of her customary impurity she shall be unclean. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the eighth day the flesh of his foreskin shall be circumcised. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "She shall then continue in the blood of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " purification thirty-three days. She shall not touch any "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": "hallowed thing, nor come into the sanctuary until the days of her purification are fulfilled."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘But if she bears a female child, then she shall be unclean two weeks, as in her customary impurity, and she shall continue in the blood of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "her"
                        },
                        {
                            "style": "NONE",
                            "text": " purification sixty-six days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘When the days of her purification are fulfilled, whether for a son or a daughter, she shall bring to the priest a lamb "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. a son of his year"
                        },
                        {
                            "style": "NONE",
                            "text": "of the first year as a burnt offering, and a young pigeon or a turtledove as a sin offering, to the door of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he shall offer it before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for her. And she shall be clean from the flow of her blood. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the law for her who has borne a male or a female."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘And if she is not able to bring a lamb, then she may bring two turtledoves or two young pigeons—one as a burnt offering and the other as a sin offering. So the priest shall make atonement for her, and she will be "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "pure"
                        },
                        {
                            "style": "NONE",
                            "text": "clean.’ ”"
                        }
                    ]
                }
            ]
        }
    ]
}