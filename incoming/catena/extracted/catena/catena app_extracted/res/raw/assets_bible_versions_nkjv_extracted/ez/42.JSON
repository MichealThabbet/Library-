{
    "chapter_num": 42,
    "verses_count": 20,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Chambers for the Priests"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he brought me out into the outer court, by the way toward the north; and he brought me into the chamber which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " opposite the separating courtyard, and which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " opposite the building toward the north. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Facing the length, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred cubits (the width was fifty cubits), was the north door. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Opposite the inner court of twenty "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " and opposite the pavement of the outer court, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " gallery against gallery in three "
                        },
                        {
                            "style": "ITALIC",
                            "text": "stories."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In front of the chambers, toward the inside, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a walk ten cubits wide, at a distance of one cubit; and their doors faced north. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the upper chambers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " shorter, because the galleries took away "
                        },
                        {
                            "style": "ITALIC",
                            "text": "space"
                        },
                        {
                            "style": "NONE",
                            "text": " from them more than from the lower and middle stories of the building. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in three "
                        },
                        {
                            "style": "ITALIC",
                            "text": "stories"
                        },
                        {
                            "style": "NONE",
                            "text": " and did not have pillars like the pillars of the courts; therefore "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the upper level"
                        },
                        {
                            "style": "NONE",
                            "text": " was "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or narrowed"
                        },
                        {
                            "style": "NONE",
                            "text": "shortened more than the lower and middle levels from the ground up. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And a wall which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " outside ran parallel to the chambers, at the front of the chambers, toward the outer court; its length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " fifty cubits. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The length of the chambers toward the outer court "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " fifty cubits, whereas that facing the temple "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " one hundred cubits. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At the lower chambers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the entrance on the east side, as one goes into them from the outer court."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there were"
                        },
                        {
                            "style": "NONE",
                            "text": " chambers in the thickness of the wall of the court toward the east, opposite the separating courtyard and opposite the building. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "There was"
                        },
                        {
                            "style": "NONE",
                            "text": " a walk in front of them also, and their appearance "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like the chambers which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " toward the north; they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " as long and as wide as the others, and all their exits and entrances "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " according to plan. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And corresponding to the doors of the chambers that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " facing south, as one enters them, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " a door in front of the walk, the way directly in front of the wall toward the east."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to me, “The north chambers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " the south chambers, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " opposite the separating courtyard, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the holy chambers where the priests who approach the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall eat the most holy offerings. There they shall lay the most holy offerings—the grain offering, the sin offering, and the trespass offering—for the place "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " holy. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the priests enter them, they shall not go out of the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "chamber"
                        },
                        {
                            "style": "NONE",
                            "text": " into the outer court; but there they shall leave their garments in which they minister, for they "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " holy. They shall put on other garments; then they may approach "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " for the people.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Outer Dimensions of the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now when he had finished measuring the inner "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple, he brought me out through the gateway that faces toward the east, and measured it all around. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured the east side with the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "About 10.5 feet, Ezek. 40:5"
                        },
                        {
                            "style": "NONE",
                            "text": "measuring rod, five hundred rods by the measuring rod all around. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured the north side, five hundred rods by the measuring rod all around. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured the south side, five hundred rods by the measuring rod. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He came around to the west side "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " measured five hundred rods by the measuring rod. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He measured it on the four sides; it had a wall all around, five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " long and five hundred wide, to separate the holy areas from the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or profane"
                        },
                        {
                            "style": "NONE",
                            "text": "common."
                        }
                    ]
                }
            ]
        }
    ]
}