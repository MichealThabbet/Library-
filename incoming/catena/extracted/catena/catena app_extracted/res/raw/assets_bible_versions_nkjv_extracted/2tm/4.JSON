{
    "chapter_num": 4,
    "verses_count": 22,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Preach the Word"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I charge "
                        },
                        {
                            "style": "ITALIC",
                            "text": "you"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits therefore"
                        },
                        {
                            "style": "NONE",
                            "text": "therefore before God and the Lord Jesus Christ, who will judge the living and the dead "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU and by"
                        },
                        {
                            "style": "NONE",
                            "text": "at His appearing and His kingdom: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Preach the word! Be ready in season "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " out of season. Convince, rebuke, exhort, with all longsuffering and teaching. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the time will come when they will not endure sound doctrine, but according to their own desires, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "because"
                        },
                        {
                            "style": "NONE",
                            "text": " they have itching ears, they will heap up for themselves teachers; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they will turn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " ears away from the truth, and be turned aside to fables. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But you be watchful in all things, endure afflictions, do the work of an evangelist, fulfill your ministry."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul’s Valedictory"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I am already being poured out as a drink offering, and the time of my departure is at hand. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have fought the good fight, I have finished the race, I have kept the faith. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Finally, there is laid up for me the crown of righteousness, which the Lord, the righteous Judge, will give to me on that Day, and not to me only but also to all who have loved His appearing."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Abandoned Apostle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Be diligent to come to me quickly; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for Demas has forsaken me, having loved this present world, and has departed for Thessalonica—Crescens for Galatia, Titus for Dalmatia. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Only Luke is with me. Get Mark and bring him with you, for he is useful to me for ministry. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Tychicus I have sent to Ephesus. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bring the cloak that I left with Carpus at Troas when you come—and the books, especially the parchments."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Alexander the coppersmith did me much harm. May the Lord repay him according to his works. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You also must beware of him, for he has greatly resisted our words."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At my first defense no one stood with me, but all forsook me. May it not be charged against them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Lord Is Faithful"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the Lord stood with me and strengthened me, so that the message might be preached fully through me, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " all the Gentiles might hear. Also I was delivered out of the mouth of the lion. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Lord will deliver me from every evil work and preserve "
                        },
                        {
                            "style": "ITALIC",
                            "text": "me"
                        },
                        {
                            "style": "NONE",
                            "text": " for His heavenly kingdom. To Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " glory forever and ever. Amen!"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Come Before Winter"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Prisca and Aquila, and the household of Onesiphorus. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Erastus stayed in Corinth, but Trophimus I have left in Miletus sick."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do your utmost to come before winter."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Eubulus greets you, as well as Pudens, Linus, Claudia, and all the brethren."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Farewell"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Lord "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits Jesus Christ"
                        },
                        {
                            "style": "NONE",
                            "text": "Jesus Christ be with your spirit. Grace be with you. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}