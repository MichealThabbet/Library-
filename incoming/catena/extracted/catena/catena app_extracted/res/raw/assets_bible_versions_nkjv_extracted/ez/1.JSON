{
    "chapter_num": 1,
    "verses_count": 28,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Ezekiel’s Vision of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it came to pass in the thirtieth year, in the fourth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "month,"
                        },
                        {
                            "style": "NONE",
                            "text": " on the fifth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the month, as I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " among the captives by the River Chebar, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " the heavens were opened and I saw visions"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, LXX, Vg.; Syr., Tg. a vision"
                        },
                        {
                            "style": "NONE",
                            "text": " of God. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the fifth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the month, which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in the fifth year of King Jehoiachin’s captivity, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came expressly to Ezekiel the priest, the son of Buzi, in the land of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Babylonians, and so elsewhere in the book"
                        },
                        {
                            "style": "NONE",
                            "text": "Chaldeans by the River Chebar; and the hand of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was upon him there."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then I looked, and behold, a whirlwind was coming out of the north, a great cloud with raging fire engulfing itself; and brightness "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " all around it and radiating out of its midst like the color of amber, out of the midst of the fire. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also from within it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "came"
                        },
                        {
                            "style": "NONE",
                            "text": " the likeness of four living creatures. And this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " their appearance: they had the likeness of a man. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Each one had four faces, and each one had four wings. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. feet"
                        },
                        {
                            "style": "NONE",
                            "text": "legs "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " straight, and the soles of their feet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " like the soles of calves’ feet. They sparkled like the color of burnished bronze. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hands of a man "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " under their wings on their four sides; and each of the four had faces and wings. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their wings touched one another. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "The creatures"
                        },
                        {
                            "style": "NONE",
                            "text": " did not turn when they went, but each one went straight forward."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the likeness of their faces, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "each"
                        },
                        {
                            "style": "NONE",
                            "text": " had the face of a man; each of the four had the face of a lion on the right side, each of the four had the face of an ox on the left side, and each of the four had the face of an eagle. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " their faces. Their wings stretched upward; two "
                        },
                        {
                            "style": "ITALIC",
                            "text": "wings"
                        },
                        {
                            "style": "NONE",
                            "text": " of each one touched one another, and two covered their bodies. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And each one went straight forward; they went wherever the spirit wanted to go, and they did not turn when they went."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the likeness of the living creatures, their appearance "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like burning coals of fire, like the appearance of torches going back and forth among the living creatures. The fire was bright, and out of the fire went lightning. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the living creatures ran back and forth, in appearance like a flash of lightning."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now as I looked at the living creatures, behold, a wheel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " on the earth beside each living creature with its four faces. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The appearance of the wheels and their workings "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like the color of beryl, and all four had the same likeness. The appearance of their workings "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was,"
                        },
                        {
                            "style": "NONE",
                            "text": " as it were, a wheel in the middle of a wheel. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they moved, they went toward any one of four directions; they did not turn aside when they went. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for their rims, they were so high they were awesome; and their rims "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " full of eyes, all around the four of them. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the living creatures went, the wheels went beside them; and when the living creatures were lifted up from the earth, the wheels were lifted up. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Wherever the spirit wanted to go, they went, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "because"
                        },
                        {
                            "style": "NONE",
                            "text": " there the spirit went; and the wheels were lifted together with them, for the spirit of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. living creature; LXX, Vg. spirit of life; Tg. creatures"
                        },
                        {
                            "style": "NONE",
                            "text": "living creatures "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in the wheels. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When those went, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " went; when those stood, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "these"
                        },
                        {
                            "style": "NONE",
                            "text": " stood; and when those were lifted up from the earth, the wheels were lifted up together with them, for the spirit of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "See note at v. 20"
                        },
                        {
                            "style": "NONE",
                            "text": "living creatures "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " in the wheels."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The likeness of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or expanse"
                        },
                        {
                            "style": "NONE",
                            "text": "firmament above the heads of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with LXX, Tg., Vg.; MT living creature"
                        },
                        {
                            "style": "NONE",
                            "text": "living creatures "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " like the color of an awesome crystal, stretched out over their heads. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And under the firmament their wings "
                        },
                        {
                            "style": "ITALIC",
                            "text": "spread out"
                        },
                        {
                            "style": "NONE",
                            "text": " straight, one toward another. Each one had two which covered one side, and each one had two which covered the other side of the body. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they went, I heard the noise of their wings, like the noise of many waters, like the voice of the Almighty, a tumult like the noise of an army; and when they stood still, they let down their wings. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A voice came from above the firmament that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " over their heads; whenever they stood, they let down their wings."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And above the firmament over their heads "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the likeness of a throne, in appearance like a sapphire stone; on the likeness of the throne "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " a likeness with the appearance of a man high above it. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also from the appearance of His waist and upward I saw, as it were, the color of amber with the appearance of fire all around within it; and from the appearance of His waist and downward I saw, as it were, the appearance of fire with brightness all around. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Like the appearance of a rainbow in a cloud on a rainy day, so "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the appearance of the brightness all around it. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the appearance of the likeness of the glory of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "So when I saw "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it,"
                        },
                        {
                            "style": "NONE",
                            "text": " I fell on my face, and I heard a voice of One speaking."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Ezekiel Sent to Rebellious Israel"
        }
    ]
}