{
    "chapter_num": 2,
    "verses_count": 15,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Pray for All Men"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "encourage"
                        },
                        {
                            "style": "NONE",
                            "text": "exhort first of all that supplications, prayers, intercessions, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " giving of thanks be made for all men, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for kings and all who are in "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "a prominent place"
                        },
                        {
                            "style": "NONE",
                            "text": "authority, that we may lead a quiet and peaceable life in all godliness and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "dignity"
                        },
                        {
                            "style": "NONE",
                            "text": "reverence. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " good and acceptable in the sight of God our Savior, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who desires all men to be saved and to come to the knowledge of the truth. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there is"
                        },
                        {
                            "style": "NONE",
                            "text": " one God and one Mediator between God and men, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " Man Christ Jesus, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who gave Himself a ransom for all, to be testified in due time, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for which I was appointed a preacher and an apostle—I am speaking the truth "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits in Christ"
                        },
                        {
                            "style": "NONE",
                            "text": "in Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " not lying—a teacher of the Gentiles in faith and truth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Men and Women in the Church"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I desire therefore that the men pray everywhere, lifting up holy hands, without wrath and doubting; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in like manner also, that the women adorn themselves in modest apparel, with propriety and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "discretion"
                        },
                        {
                            "style": "NONE",
                            "text": "moderation, not with braided hair or gold or pearls or costly clothing, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but, which is proper for women professing godliness, with good works. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let a woman learn in silence with all submission. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I do not permit a woman to teach or to have authority over a man, but to be in silence. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Adam was formed first, then Eve. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Adam was not deceived, but the woman being deceived, fell into transgression. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless she will be saved in childbearing if they continue in faith, love, and holiness, with self-control."
                        }
                    ]
                }
            ]
        }
    ]
}