{
    "chapter_num": 7,
    "verses_count": 40,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Family of Issachar"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Issachar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Tola, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Puvah, Gen. 46:13"
                        },
                        {
                            "style": "NONE",
                            "text": "Puah, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Job, Gen. 46:13"
                        },
                        {
                            "style": "NONE",
                            "text": "Jashub, and Shimron—four "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Tola "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Uzzi, Rephaiah, Jeriel, Jahmai, Jibsam, and Shemuel, heads of their father’s house. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "The sons"
                        },
                        {
                            "style": "NONE",
                            "text": " of Tola "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " mighty men of valor in their generations; their number in the days of David "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-two thousand six hundred. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son of Uzzi "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Izrahiah, and the sons of Izrahiah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Michael, Obadiah, Joel, and Ishiah. All five of them "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " chief men. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And with them, by their generations, according to their fathers’ houses, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " thirty-six thousand troops ready for war; for they had many wives and sons."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now their brethren among all the families of Issachar "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " mighty men of valor, listed by their genealogies, eighty-seven thousand in all."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Benjamin"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "The sons"
                        },
                        {
                            "style": "NONE",
                            "text": " of Benjamin "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Bela, Becher, and Jediael—three "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Bela were Ezbon, Uzzi, Uzziel, Jerimoth, and Iri—five "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in all."
                        },
                        {
                            "style": "NONE",
                            "text": " They "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " heads of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " fathers’ houses, and they were listed by their genealogies, twenty-two thousand and thirty-four mighty men of valor."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Becher "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Zemirah, Joash, Eliezer, Elioenai, Omri, Jerimoth, Abijah, Anathoth, and Alemeth. All these "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of Becher. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were recorded by genealogy according to their generations, heads of their fathers’ houses, twenty thousand two hundred mighty men of valor. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son of Jediael "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Bilhan, and the sons of Bilhan "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Jeush, Benjamin, Ehud, Chenaanah, Zethan, Tharshish, and Ahishahar."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these sons of Jediael "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " heads of their fathers’ houses; "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there were"
                        },
                        {
                            "style": "NONE",
                            "text": " seventeen thousand two hundred mighty men of valor fit to go out for war "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " battle. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Shupham, Num. 26:39"
                        },
                        {
                            "style": "NONE",
                            "text": "Shuppim and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Hupham, Num. 26:39"
                        },
                        {
                            "style": "NONE",
                            "text": "Huppim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Iri, v. 7"
                        },
                        {
                            "style": "NONE",
                            "text": "Ir, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " Hushim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the son of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Ahiram, Num. 26:38"
                        },
                        {
                            "style": "NONE",
                            "text": "Aher."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Naphtali"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Naphtali "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jahzeel, Gen. 46:24"
                        },
                        {
                            "style": "NONE",
                            "text": "Jahziel, Guni, Jezer, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shillem, Gen. 46:24"
                        },
                        {
                            "style": "NONE",
                            "text": "Shallum, the sons of Bilhah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Manasseh (West)"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The descendants of Manasseh: his Syrian concubine bore him Machir the father of Gilead, the father of Asriel. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Machir took as his wife "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the sister"
                        },
                        {
                            "style": "NONE",
                            "text": " of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Hupham, v. 12; Num. 26:39"
                        },
                        {
                            "style": "NONE",
                            "text": "Huppim and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shupham, v. 12; Num. 26:39"
                        },
                        {
                            "style": "NONE",
                            "text": "Shuppim, whose name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Maachah. The name of "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Gilead’s"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the second"
                        },
                        {
                            "style": "NONE",
                            "text": "grandson "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Zelophehad, but Zelophehad begot only daughters. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "(Maachah the wife of Machir bore a son, and she called his name Peresh. The name of his brother "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Sheresh, and his sons "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Ulam and Rakem. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The son of Ulam "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Bedan.) These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the descendants of Gilead the son of Machir, the son of Manasseh."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His sister Hammoleketh bore Ishhod, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jeezer, Num. 26:30"
                        },
                        {
                            "style": "NONE",
                            "text": "Abiezer, and Mahlah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of Shemida were Ahian, Shechem, Likhi, and Aniam."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Ephraim"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ephraim "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Shuthelah, Bered his son, Tahath his son, Eladah his son, Tahath his son, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zabad his son, Shuthelah his son, and Ezer and Elead. The men of Gath who were born in "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " land killed "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " because they came down to take away their cattle. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Ephraim their father mourned many days, and his brethren came to comfort him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when he went in to his wife, she conceived and bore a son; and he called his name "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. In Tragedy"
                        },
                        {
                            "style": "NONE",
                            "text": "Beriah, because tragedy had come upon his house. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now his daughter "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Sheerah, who built Lower and Upper Beth Horon and Uzzen Sheerah; "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Rephah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " his son, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as well"
                        },
                        {
                            "style": "NONE",
                            "text": " as Resheph, and Telah his son, Tahan his son, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Laadan his son, Ammihud his son, Elishama his son, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Non"
                        },
                        {
                            "style": "NONE",
                            "text": "Nun his son, and Joshua his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now their possessions and dwelling places "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Bethel and its towns: to the east "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Naarath, Josh. 16:7"
                        },
                        {
                            "style": "NONE",
                            "text": "Naaran, to the west Gezer and its towns, and Shechem and its towns, as far as "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Many Heb. mss., Bg., LXX, Tg., Vg. Gazza"
                        },
                        {
                            "style": "NONE",
                            "text": "Ayyah and its towns; "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and by the borders of the children of Manasseh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Beth Shean and its towns, Taanach and its towns, Megiddo and its towns, Dor and its towns. In these dwelt the children of Joseph, the son of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Family of Asher"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Asher "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Imnah, Ishvah, Ishvi, Beriah, and their sister Serah. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Beriah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Heber and Malchiel, who was the father of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Birzavith or Birzoth"
                        },
                        {
                            "style": "NONE",
                            "text": "Birzaith. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Heber begot Japhlet, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shemer, 1 Chr. 7:34"
                        },
                        {
                            "style": "NONE",
                            "text": "Shomer, "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Helem, 1 Chr. 7:35"
                        },
                        {
                            "style": "NONE",
                            "text": "Hotham, and their sister Shua. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Japhlet "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Pasach, Bimhal, and Ashvath. These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the children of Japhlet. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Shemer "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Ahi, Rohgah, Jehubbah, and Aram. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the sons of his brother Helem "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " Zophah, Imna, Shelesh, and Amal. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Zophah "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
