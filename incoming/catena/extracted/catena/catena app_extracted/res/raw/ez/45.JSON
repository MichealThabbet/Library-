{
    "chapter_num": 45,
    "verses_count": 25,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Holy District"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Moreover, when you divide the land by lot into inheritance, you shall set apart a district for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", a holy section of the land; its length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits,"
                        },
                        {
                            "style": "NONE",
                            "text": " and the width ten thousand. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " holy throughout its territory all around. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of this there shall be a square plot for the sanctuary, five hundred by five hundred "
                        },
                        {
                            "style": "ITALIC",
                            "text": "rods,"
                        },
                        {
                            "style": "NONE",
                            "text": " with fifty cubits around it for an open space. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So this is the district you shall measure: twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " long and ten thousand wide; in it shall be the sanctuary, the Most Holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "Place."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be a holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section"
                        },
                        {
                            "style": "NONE",
                            "text": " of the land, belonging to the priests, the ministers of the sanctuary, who come near to minister to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; it shall be a place for their houses and a holy place for the sanctuary. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "An area"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " long and ten thousand wide shall belong to the Levites, the ministers of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple; they shall have twenty"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; LXX a possession, cities of dwelling"
                        },
                        {
                            "style": "NONE",
                            "text": " chambers as a possession."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Properties of the City and the Prince"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall appoint as the property of the city "
                        },
                        {
                            "style": "ITALIC",
                            "text": "an area"
                        },
                        {
                            "style": "NONE",
                            "text": " five thousand "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cubits"
                        },
                        {
                            "style": "NONE",
                            "text": " wide and twenty-five thousand long, adjacent to the district of the holy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "section;"
                        },
                        {
                            "style": "NONE",
                            "text": " it shall belong to the whole house of Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The prince shall have "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a section"
                        },
                        {
                            "style": "NONE",
                            "text": " on one side and the other of the holy district and the city’s property; and bordering on the holy district and the city’s property, extending westward on the west side and eastward on the east side, the length "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " side by side with one of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "tribal"
                        },
                        {
                            "style": "NONE",
                            "text": " portions, from the west border to the east border. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The land shall be his possession in Israel; and My princes shall no more oppress My people, but they shall give "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the rest of"
                        },
                        {
                            "style": "NONE",
                            "text": " the land to the house of Israel, according to their tribes.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Laws Governing the Prince"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Thus says the Lord "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ": “Enough, O princes of Israel! Remove violence and plundering, execute justice and righteousness, and stop dispossessing My people,” says the Lord "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall have honest scales, an honest ephah, and an honest bath. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The ephah and the bath shall be of the same measure, so that the bath contains one-tenth of a homer, and the ephah one-tenth of a homer; their measure shall be according to the homer. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The shekel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty gerahs; twenty shekels, twenty-five shekels, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " fifteen shekels shall be your mina."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the offering which you shall offer: you shall give one-sixth of an ephah from a homer of wheat, and one-sixth of an ephah from a homer of barley. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The ordinance concerning oil, the bath of oil, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " one-tenth of a bath from a kor. "
                        },
                        {
                            "style": "ITALIC",
                            "text": "A kor is"
                        },
                        {
                            "style": "NONE",
                            "text": " a homer or ten baths, for ten baths "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " a homer. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And one lamb shall be given from a flock of two hundred, from the rich pastures of Israel. These shall be for grain offerings, burnt offerings, and peace offerings, to make atonement for them,” says the Lord "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“All the people of the land shall give this offering for the prince in Israel. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then it shall be the prince’s part "
                        },
                        {
                            "style": "ITALIC",
                            "text": "to give"
                        },
                        {
                            "style": "NONE",
                            "text": " burnt offerings, grain offerings, and drink offerings, at the feasts, the New Moons, the Sabbaths, and at all the appointed seasons of the house of Israel. He shall prepare the sin offering, the grain offering, the burnt offering, and the peace offerings to make atonement for the house of Israel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Keeping the Feasts"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Thus says the Lord "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ": “In the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "month,"
                        },
                        {
                            "style": "NONE",
                            "text": " on the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the month, you shall take a young bull without blemish and cleanse the sanctuary. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The priest shall take some of the blood of the sin offering and put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the doorposts of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. house"
                        },
                        {
                            "style": "NONE",
                            "text": "temple, on the four corners of the ledge of the altar, and on the gateposts of the gate of the inner court. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And so you shall do on the seventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the month for everyone who has sinned unintentionally or in ignorance. Thus you shall make atonement for the temple."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“In the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "month,"
                        },
                        {
                            "style": "NONE",
                            "text": " on the fourteenth day of the month, you shall observe the Passover, a feast of seven days; unleavened bread shall be eaten. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on that day the prince shall prepare for himself and for all the people of the land a bull "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the seven days of the feast he shall prepare a burnt offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", seven bulls and seven rams without blemish, daily for seven days, and a kid of the goats daily "
                        },
                        {
                            "style": "ITALIC",
                            "text": "for"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall prepare a grain offering of one ephah for each bull and one ephah for each ram, together with a hin of oil for each ephah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“In the seventh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "month,"
                        },
                        {
                            "style": "NONE",
                            "text": " on the fifteenth day of the month, at the feast, he shall do likewise for seven days, according to the sin offering, the burnt offering, the grain offering, and the oil.”"
                        }
                    ]
                }
            ]
        }
    ]
}