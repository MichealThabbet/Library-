{
    "chapter_num": 28,
    "verses_count": 20,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "He Is Risen"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now after the Sabbath, as the first "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the week began to dawn, Mary Magdalene and the other Mary came to see the tomb. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And behold, there was a great earthquake; for an angel of the Lord descended from heaven, and came and rolled back the stone "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits from the door"
                        },
                        {
                            "style": "NONE",
                            "text": "from the door, and sat on it. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "His countenance was like lightning, and his clothing as white as snow. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the guards shook for fear of him, and became like dead "
                        },
                        {
                            "style": "ITALIC",
                            "text": "men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the angel answered and said to the women, “Do not be afraid, for I know that you seek Jesus who was crucified. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He is not here; for He is risen, as He said. Come, see the place where the Lord lay. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And go quickly and tell His disciples that He is risen from the dead, and indeed He is going before you into Galilee; there you will see Him. Behold, I have told you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they went out quickly from the tomb with fear and great joy, and ran to bring His disciples word."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Women Worship the Risen Lord"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits as they went to tell His disciples"
                        },
                        {
                            "style": "NONE",
                            "text": "as they went to tell His disciples, behold, Jesus met them, saying, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Rejoice!”"
                        },
                        {
                            "style": "NONE",
                            "text": " So they came and held Him by the feet and worshiped Him. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jesus said to them, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“Do not be afraid. Go and tell"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "My brethren to go to Galilee, and there they will see Me.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Soldiers Are Bribed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now while they were going, behold, some of the guard came into the city and reported to the chief priests all the things that had happened. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they had assembled with the elders and consulted together, they gave a large sum of money to the soldiers, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "saying, “Tell them, ‘His disciples came at night and stole Him "
                        },
                        {
                            "style": "ITALIC",
                            "text": "away"
                        },
                        {
                            "style": "NONE",
                            "text": " while we slept.’ "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if this comes to the governor’s ears, we will appease him and make you secure.” "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they took the money and did as they were instructed; and this saying is commonly reported among the Jews until this day."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Great Commission"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the eleven disciples went away into Galilee, to the mountain which Jesus had appointed for them. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they saw Him, they worshiped Him; but some doubted."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus came and spoke to them, saying, "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "“All authority has been given to Me in heaven and on earth."
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "Go"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "M omits therefore"
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "therefore and"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "make disciples of all the nations, baptizing them in the name of the Father and of the Son and of the Holy Spirit,"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "teaching them to observe all things that I have commanded you; and lo, I am"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "WORDS_OF_JESUS",
                            "text": "with you always, even to the end of the age.”"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits Amen."
                        },
                        {
                            "style": "NONE",
                            "text": "Amen."
                        }
                    ]
                }
            ]
        }
    ]
}