            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "While He was still talking to the multitudes, behold, His mother and brothers stood outside, seeking to speak with Him. "
