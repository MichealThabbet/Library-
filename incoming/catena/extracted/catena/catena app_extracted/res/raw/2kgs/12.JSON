{
    "chapter_num": 12,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Jehoash Repairs the Temple"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the seventh year of Jehu, Jehoash"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Joash, 2 Kin. 11:2ff."
                        },
                        {
                            "style": "NONE",
                            "text": " became king, and he reigned forty years in Jerusalem. His mother’s name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Zibiah of Beersheba. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoash did "
                        },
                        {
                            "style": "ITALIC",
                            "text": "what was"
                        },
                        {
                            "style": "NONE",
                            "text": " right in the sight of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " all the days in which Jehoiada the priest instructed him. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Places for pagan worship"
                        },
                        {
                            "style": "NONE",
                            "text": "high places were not taken away; the people still sacrificed and burned incense on the high places."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jehoash said to the priests, “All the money of the dedicated gifts that are brought into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "—each man’s census"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the money coming over"
                        },
                        {
                            "style": "NONE",
                            "text": " money, each man’s assessment money—"
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " all the money that "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "any man’s heart prompts him to bring"
                        },
                        {
                            "style": "NONE",
                            "text": "a man purposes in his heart to bring into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "let the priests take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " themselves, each from his constituency; and let them repair the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. breaches"
                        },
                        {
                            "style": "NONE",
                            "text": "damages of the temple, wherever any dilapidation is found.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now it was so, by the twenty-third year of King Jehoash, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " the priests had not repaired the damages of the temple. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So King Jehoash called Jehoiada the priest and the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "other"
                        },
                        {
                            "style": "NONE",
                            "text": " priests, and said to them, “Why have you not repaired the damages of the temple? Now therefore, do not take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "more"
                        },
                        {
                            "style": "NONE",
                            "text": " money from your constituency, but deliver it for repairing the damages of the temple.” "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the priests agreed that they would neither receive "
                        },
                        {
                            "style": "ITALIC",
                            "text": "more"
                        },
                        {
                            "style": "NONE",
                            "text": " money from the people, nor repair the damages of the temple."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jehoiada the priest took a chest, bored a hole in its lid, and set it beside the altar, on the right side as one comes into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and the priests who "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "guarded at the door"
                        },
                        {
                            "style": "NONE",
                            "text": "kept the door put there all the money brought into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So it was, whenever they saw that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there was"
                        },
                        {
                            "style": "NONE",
                            "text": " much money in the chest, that the king’s scribe"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "secretary"
                        },
                        {
                            "style": "NONE",
                            "text": " and the high priest came up and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "tied it up"
                        },
                        {
                            "style": "NONE",
                            "text": "put it in bags, and counted the money that was found in the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they gave the money, which had been apportioned, into the hands of those who did the work, who had the oversight of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and they "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. weighed"
                        },
                        {
                            "style": "NONE",
                            "text": "paid it out to the carpenters and builders who worked on the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and to masons and stonecutters, and for buying timber and hewn stone, to repair the damage of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and for all that was paid out to repair the temple. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "However there were not made for the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " basins of silver, trimmers, sprinkling-bowls, trumpets, any articles of gold or articles of silver, from the money brought into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they gave that to the workmen, and they repaired the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " with it. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover they did not require an account from the men into whose hand they delivered the money to be paid to workmen, for they dealt faithfully. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The money from the trespass offerings and the money from the sin offerings was not brought into the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". It belonged to the priests."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Hazael Threatens Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hazael king of Syria went up and fought against Gath, and took it; then Hazael set his face to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Advance upon"
                        },
                        {
                            "style": "NONE",
                            "text": "go up to Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jehoash king of Judah took all the sacred things that his fathers, Jehoshaphat and Jehoram and Ahaziah, kings of Judah, had dedicated, and his own sacred things, and all the gold found in the treasuries of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and in the king’s house, and sent "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to Hazael king of Syria. Then he went away from Jerusalem."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Death of Joash"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the rest of the acts of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehoash, vv. 1–18"
                        },
                        {
                            "style": "NONE",
                            "text": "Joash, and all that he did, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " they not written in the book of the chronicles of the kings of Judah?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And his servants arose and formed a conspiracy, and killed Joash in the house of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. The Landfill"
                        },
                        {
                            "style": "NONE",
                            "text": "the Millo, which goes down to Silla. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Zabad, 2 Chr. 24:26"
                        },
                        {
                            "style": "NONE",
                            "text": "Jozachar the son of Shimeath and Jehozabad the son of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Shimrith, 2 Chr. 24:26"
                        },
                        {
                            "style": "NONE",
                            "text": "Shomer, his servants, struck him. So he died, and they buried him with his fathers in the City of David. Then Amaziah his son reigned in his place."
                        }
                    ]
                }
            ]
        }
    ]
}