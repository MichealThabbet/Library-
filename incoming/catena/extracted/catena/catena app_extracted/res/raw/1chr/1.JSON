                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hadoram, Uzal, Diklah, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Obal, Gen. 10:28"
                        },
                        {
                            "style": "NONE",
                            "text": "Ebal, Abimael, Sheba, "
                        }
                    ]
                },
