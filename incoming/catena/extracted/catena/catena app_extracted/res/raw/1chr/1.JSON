                        },
                        {
                            "style": "NONE",
                            "text": "Peleg, for in his days the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or land"
                        },
                        {
                            "style": "NONE",
                            "text": "earth was divided; and his brother’s name "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " Joktan. "
                        }
