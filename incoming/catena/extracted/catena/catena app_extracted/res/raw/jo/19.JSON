{
    "chapter_num": 19,
    "verses_count": 51,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Simeon’s Inheritance with Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The second lot came out for Simeon, for the tribe of the children of Simeon according to their families. And their inheritance was within the inheritance of the children of Judah. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They had in their inheritance Beersheba (Sheba), Moladah, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hazar Shual, Balah, Ezem, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eltolad, Bethul, Hormah, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ziklag, Beth Marcaboth, Hazar Susah, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Beth Lebaoth, and Sharuhen: thirteen cities and their villages; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ain, Rimmon, Ether, and Ashan: four cities and their villages; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and all the villages that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " all around these cities as far as Baalath Beer, Ramah of the South. This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Simeon according to their families."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The inheritance of the children of Simeon "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was included"
                        },
                        {
                            "style": "NONE",
                            "text": " in the share of the children of Judah, for the share of the children of Judah was "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "too large"
                        },
                        {
                            "style": "NONE",
                            "text": "too much for them. Therefore the children of Simeon had "
                        },
                        {
                            "style": "ITALIC",
                            "text": "their"
                        },
                        {
                            "style": "NONE",
                            "text": " inheritance within the inheritance of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. them"
                        },
                        {
                            "style": "NONE",
                            "text": "that people."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Zebulun"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The third lot came out for the children of Zebulun according to their families, and the border of their inheritance was as far as Sarid. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their border went toward the west and to Maralah, went to Dabbasheth, and extended along the brook that is east of Jokneam. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then from Sarid it went eastward toward the sunrise along the border of Chisloth Tabor, and went out toward Daberath, bypassing Japhia. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And from there it passed along on the east of Gath Hepher, toward Eth Kazin, and extended to Rimmon, which borders on Neah. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the border went around it on the north side of Hannathon, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. the goings out of it were"
                        },
                        {
                            "style": "NONE",
                            "text": "it ended in the Valley of Jiphthah El. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Included were Kattath, Nahallal, Shimron, Idalah, and Bethlehem: twelve cities with their villages. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the children of Zebulun according to their families, these cities with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Issachar"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fourth lot came out to Issachar, for the children of Issachar according to their families. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their territory went to Jezreel, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "included"
                        },
                        {
                            "style": "NONE",
                            "text": " Chesulloth, Shunem, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Haphraim, Shion, Anaharath, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Rabbith, Kishion, Abez, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Remeth, En Gannim, En Haddah, and Beth Pazzez. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border reached to Tabor, Shahazimah, and Beth Shemesh; their border ended at the Jordan: sixteen cities with their villages. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Issachar according to their families, the cities and their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Asher"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fifth lot came out for the tribe of the children of Asher according to their families. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their territory included Helkath, Hali, Beten, Achshaph, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Alammelech, Amad, and Mishal; it reached to Mount Carmel westward, along "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the Brook"
                        },
                        {
                            "style": "NONE",
                            "text": " Shihor Libnath. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It turned toward the sunrise to Beth Dagon; and it reached to Zebulun and to the Valley of Jiphthah El, then northward beyond Beth Emek and Neiel, bypassing Cabul "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which was"
                        },
                        {
                            "style": "NONE",
                            "text": " on the left, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "including "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with MT, Tg., Vg.; a few Heb. mss. Abdon (cf. 21:30 and 1 Chr. 6:74)"
                        },
                        {
                            "style": "NONE",
                            "text": "Ebron, Rehob, Hammon, and Kanah, as far as Greater Sidon. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border turned to Ramah and to the fortified city of Tyre; then the border turned to Hosah, and ended at the sea by the region of Achzib. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also Ummah, Aphek, and Rehob "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were included:"
                        },
                        {
                            "style": "NONE",
                            "text": " twenty-two cities with their villages. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Asher according to their families, these cities with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Naphtali"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sixth lot came out to the children of Naphtali, for the children of Naphtali according to their families. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their border began at Heleph, enclosing the territory from the terebinth tree in Zaanannim, Adami Nekeb, and Jabneel, as far as Lakkum; "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. its goings out were"
                        },
                        {
                            "style": "NONE",
                            "text": "it ended at the Jordan. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "From Heleph the border extended westward to Aznoth Tabor, and went out from there toward Hukkok; it adjoined Zebulun on the south side and Asher on the west side, and ended at Judah by the Jordan toward the sunrise. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the fortified cities "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " Ziddim, Zer, Hammath, Rakkath, Chinnereth, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adamah, Ramah, Hazor, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kedesh, Edrei, En Hazor, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Iron, Migdal El, Horem, Beth Anath, and Beth Shemesh: nineteen cities with their villages. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Naphtali according to their families, the cities and their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Land of Dan"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The seventh lot came out for the tribe of the children of Dan according to their families. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the territory of their inheritance was Zorah, Eshtaol, Ir Shemesh, "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shaalabbin, Aijalon, Jethlah, "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elon, Timnah, Ekron, "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eltekeh, Gibbethon, Baalath, "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehud, Bene Berak, Gath Rimmon, "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Me Jarkon, and Rakkon, with the region "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "over against"
                        },
                        {
                            "style": "NONE",
                            "text": "near "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Japho"
                        },
                        {
                            "style": "NONE",
                            "text": "Joppa. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the border of the children of Dan went beyond these, because the children of Dan went up to fight against Leshem and took it; and they struck it with the edge of the sword, took possession of it, and dwelt in it. They called Leshem, Dan, after the name of Dan their father. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritance of the tribe of the children of Dan according to their families, these cities with their villages."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Joshua’s Inheritance"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they had "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "finished"
                        },
                        {
                            "style": "NONE",
                            "text": "made an end of dividing the land as an inheritance according to their borders, the children of Israel gave an inheritance among them to Joshua the son of Nun. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "According to the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " they gave him the city which he asked for, Timnath Serah in the mountains of Ephraim; and he built the city and dwelt in it."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " the inheritances which Eleazar the priest, Joshua the son of Nun, and the heads of the fathers of the tribes of the children of Israel divided as an inheritance by lot in Shiloh before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", at the door of the tabernacle of meeting. So they made an end of dividing the country."
                        }
                    ]
                }
            ]
        }
    ]
}