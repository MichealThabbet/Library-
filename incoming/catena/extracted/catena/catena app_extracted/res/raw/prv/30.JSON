                        {
                            "style": "ITALIC",
                            "text": "which is"
                        },
                        {
                            "style": "NONE",
                            "text": " mighty among beasts"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And does not turn away from any;"
