            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you have been foolish in exalting yourself,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Or if you have devised evil, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "put your"
                        },
                        {
                            "style": "NONE",
                            "text": " hand on "
                        },
                        {
                            "style": "ITALIC",
                            "text": "your"
                        },
                        {
                            "style": "NONE",
                            "text": " mouth."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
