                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or perhaps strutting rooster, lit. girded of waist"
                        },
                        {
                            "style": "NONE",
                            "text": "greyhound,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "A male goat also,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "A Jewish tradition a king against whom there is no uprising"
                        },
                        {
                            "style": "NONE",
                            "text": "a king "
                        },
                        {
                            "style": "ITALIC",
                            "text": "whose"
                        },
                        {
                            "style": "NONE",
                            "text": " troops "
                        },
                        {
                            "style": "ITALIC",
