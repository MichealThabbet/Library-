{
    "chapter_num": 30,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Hezekiah Keeps the Passover"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hezekiah sent to all Israel and Judah, and also wrote letters to Ephraim and Manasseh, that they should come to the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " at Jerusalem, to keep the Passover to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the king and his leaders and all the assembly in Jerusalem had agreed to keep the Passover in the second month. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For they could not keep it at "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The first month, Lev. 23:5; lit. that time"
                        },
                        {
                            "style": "NONE",
                            "text": "the regular time, because a sufficient number of priests had not consecrated themselves, nor had the people gathered together at Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the matter pleased the king and all the assembly. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "established a decree to"
                        },
                        {
                            "style": "NONE",
                            "text": "resolved to make a proclamation throughout all Israel, from Beersheba to Dan, that they should come to keep the Passover to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Israel at Jerusalem, since they had not done "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " for a long "
                        },
                        {
                            "style": "ITALIC",
                            "text": "time"
                        },
                        {
                            "style": "NONE",
                            "text": " in the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "prescribed"
                        },
                        {
                            "style": "NONE",
                            "text": " manner."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the runners went throughout all Israel and Judah with the letters from the king and his leaders, and spoke according to the command of the king: “Children of Israel, return to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of Abraham, Isaac, and Israel; then He will return to the remnant of you who have escaped from the hand of the kings of Assyria. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And do not be like your fathers and your brethren, who trespassed against the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of their fathers, so that He gave them up to desolation, as you see. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now do not be stiff-necked,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Rebellious"
                        },
                        {
                            "style": "NONE",
                            "text": " as your fathers "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were, but"
                        },
                        {
                            "style": "NONE",
                            "text": " yield yourselves to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and enter His sanctuary, which He has sanctified forever, and serve the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, that the fierceness of His wrath may turn away from you. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For if you return to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", your brethren and your children "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will be treated"
                        },
                        {
                            "style": "NONE",
                            "text": " with compassion by those who lead them captive, so that they may come back to this land; for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " gracious and merciful, and will not turn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "His"
                        },
                        {
                            "style": "NONE",
                            "text": " face from you if you return to Him.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the runners passed from city to city through the country of Ephraim and Manasseh, as far as Zebulun; but they laughed at them and mocked them. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless some from Asher, Manasseh, and Zebulun humbled themselves and came to Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also the hand of God was on Judah to give them singleness of heart to obey the command of the king and the leaders, at the word of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now many people, a very great assembly, gathered at Jerusalem to keep the Feast of Unleavened Bread in the second month. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They arose and took away the altars that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in Jerusalem, and they took away all the incense altars and cast "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " into the Brook Kidron. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then they slaughtered the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lambs"
                        },
                        {
                            "style": "NONE",
                            "text": " on the fourteenth "
                        },
                        {
                            "style": "ITALIC",
                            "text": "day"
                        },
                        {
                            "style": "NONE",
                            "text": " of the second month. The priests and the Levites "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "humbled themselves"
                        },
                        {
                            "style": "NONE",
                            "text": "were ashamed, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set themselves apart"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctified themselves, and brought the burnt offerings to the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They stood in their place "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or in their proper order"
                        },
                        {
                            "style": "NONE",
                            "text": "according to their custom, according to the Law of Moses the man of God; the priests sprinkled the blood "
                        },
                        {
                            "style": "ITALIC",
                            "text": "received"
                        },
                        {
                            "style": "NONE",
                            "text": " from the hand of the Levites. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there were"
                        },
                        {
                            "style": "NONE",
                            "text": " many in the assembly who had not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": "sanctified themselves; therefore the Levites had charge of the slaughter of the Passover "
                        },
                        {
                            "style": "ITALIC",
                            "text": "lambs"
                        },
                        {
                            "style": "NONE",
                            "text": " for everyone "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who was"
                        },
                        {
                            "style": "NONE",
                            "text": " not clean, to sanctify "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For a multitude of the people, many from Ephraim, Manasseh, Issachar, and Zebulun, had not cleansed themselves, yet they ate the Passover contrary to what was written. But Hezekiah prayed for them, saying, “May the good "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " provide atonement for everyone "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "ITALIC",
                            "text": "who"
                        },
                        {
                            "style": "NONE",
                            "text": " prepares his heart to seek God, the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of his fathers, though "
                        },
                        {
                            "style": "ITALIC",
                            "text": "he is"
                        },
                        {
                            "style": "NONE",
                            "text": " not "
                        },
                        {
                            "style": "ITALIC",
                            "text": "cleansed"
                        },
                        {
                            "style": "NONE",
                            "text": " according to the purification of the sanctuary.” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " listened to Hezekiah and healed the people."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the children of Israel who were present at Jerusalem kept the Feast of Unleavened Bread seven days with great gladness; and the Levites and the priests praised the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " day by day, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "singing"
                        },
                        {
                            "style": "NONE",
                            "text": " to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", accompanied by loud instruments. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hezekiah gave encouragement to all the Levites who taught the good knowledge of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; and they ate throughout the feast seven days, offering peace offerings and making confession to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " God of their fathers."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the whole assembly agreed to keep "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the feast"
                        },
                        {
                            "style": "NONE",
                            "text": " another seven days, and they kept it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "another"
                        },
                        {
                            "style": "NONE",
                            "text": " seven days with gladness. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Hezekiah king of Judah gave to the assembly a thousand bulls and seven thousand sheep, and the leaders gave to the assembly a thousand bulls and ten thousand sheep; and a great number of priests sanctified"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consecrated"
                        },
                        {
                            "style": "NONE",
                            "text": " themselves. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The whole assembly of Judah rejoiced, also the priests and Levites, all the assembly that came from Israel, the sojourners who came from the land of Israel, and those who dwelt in Judah. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So there was great joy in Jerusalem, for since the time of Solomon the son of David, king of Israel, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "there had"
                        },
                        {
                            "style": "NONE",
                            "text": " been nothing like this in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priests, the Levites, arose and blessed the people, and their voice was heard; and their prayer came "
                        },
                        {
                            "style": "ITALIC",
                            "text": "up"
                        },
                        {
                            "style": "NONE",
                            "text": " to His holy dwelling place, to heaven."
                        }
                    ]
                }
            ]
        }
    ]
}