{
    "chapter_num": 16,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Sister Phoebe Commended"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I commend to you Phoebe our sister, who is a servant of the church in Cenchrea, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that you may receive her in the Lord in a manner worthy of the saints, and assist her in whatever business she has need of you; for indeed she has been a helper of many and of myself also."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Greeting Roman Saints"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Priscilla and Aquila, my fellow workers in Christ Jesus, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who risked their own necks for my life, to whom not only I give thanks, but also all the churches of the Gentiles. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Likewise "
                        },
                        {
                            "style": "ITALIC",
                            "text": "greet"
                        },
                        {
                            "style": "NONE",
                            "text": " the church that is in their house."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Greet my beloved Epaenetus, who is the firstfruits of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU Asia"
                        },
                        {
                            "style": "NONE",
                            "text": "Achaia to Christ. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Mary, who labored much for us. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Andronicus and Junia, my countrymen and my fellow prisoners, who are of note among the apostles, who also were in Christ before me."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Amplias, my beloved in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Urbanus, our fellow worker in Christ, and Stachys, my beloved. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Apelles, approved in Christ. Greet those who are of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "household"
                        },
                        {
                            "style": "NONE",
                            "text": " of Aristobulus. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Herodion, my "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or relative"
                        },
                        {
                            "style": "NONE",
                            "text": "countryman. Greet those who are of the "
                        },
                        {
                            "style": "ITALIC",
                            "text": "household"
                        },
                        {
                            "style": "NONE",
                            "text": " of Narcissus who are in the Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Tryphena and Tryphosa, who have labored in the Lord. Greet the beloved Persis, who labored much in the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Rufus, chosen in the Lord, and his mother and mine. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Asyncritus, Phlegon, Hermas, Patrobas, Hermes, and the brethren who are with them. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet Philologus and Julia, Nereus and his sister, and Olympas, and all the saints who are with them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Greet one another with a holy kiss. "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU All the churches"
                        },
                        {
                            "style": "NONE",
                            "text": "The churches of Christ greet you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Avoid Divisive Persons"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I urge you, brethren, note those who cause divisions and offenses, contrary to the doctrine which you learned, and avoid them. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For those who are such do not serve our Lord "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M omit Jesus"
                        },
                        {
                            "style": "NONE",
                            "text": "Jesus Christ, but their own belly, and by smooth words and flattering speech deceive the hearts of the simple. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For your obedience has become known to all. Therefore I am glad on your behalf; but I want you to be wise in what is good, and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "innocent"
                        },
                        {
                            "style": "NONE",
                            "text": "simple concerning evil. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the God of peace will crush Satan under your feet shortly."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The grace of our Lord Jesus Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Greetings from Paul’s Friends"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Timothy, my fellow worker, and Lucius, Jason, and Sosipater, my countrymen, greet you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I, Tertius, who wrote "
                        },
                        {
                            "style": "ITALIC",
                            "text": "this"
                        },
                        {
                            "style": "NONE",
                            "text": " epistle, greet you in the Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Gaius, my host and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the host"
                        },
                        {
                            "style": "NONE",
                            "text": " of the whole church, greets you. Erastus, the treasurer of the city, greets you, and Quartus, a brother. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU omits v. 24."
                        },
                        {
                            "style": "NONE",
                            "text": " grace of our Lord Jesus Christ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " with you all. Amen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Benediction"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "M puts Rom. 16:25–27 after Rom. 14:23."
                        },
                        {
                            "style": "NONE",
                            "text": "Now to Him who is able to establish you according to my gospel and the preaching of Jesus Christ, according to the revelation of the mystery kept secret since the world began "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but now made manifest, and by the prophetic Scriptures made known to all nations, according to the commandment of the everlasting God, for obedience to the faith— "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to God, alone wise, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " glory through Jesus Christ forever. Amen."
                        }
                    ]
                }
            ]
        }
    ]
}