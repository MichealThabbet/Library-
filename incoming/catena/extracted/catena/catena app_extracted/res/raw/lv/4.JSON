{
    "chapter_num": 4,
    "verses_count": 35,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Sin Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " spoke to Moses, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Speak to the children of Israel, saying: ‘If a person sins "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "through error"
                        },
                        {
                            "style": "NONE",
                            "text": "unintentionally against any of the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in anything"
                        },
                        {
                            "style": "NONE",
                            "text": " which ought not to be done, and does any of them, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "if the anointed priest sins, bringing guilt on the people, then let him offer to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " for his sin which he has sinned a young bull without blemish as a sin offering. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall bring the bull to the door of the tabernacle of meeting before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", lay his hand on the bull’s head, and kill the bull before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the anointed priest shall take some of the bull’s blood and bring it to the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The priest shall dip his finger in the blood and sprinkle some of the blood seven times before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", in front of the veil of the sanctuary. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the priest shall put some of the blood on the horns of the altar of sweet incense before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", which is in the tabernacle of meeting; and he shall pour the remaining blood of the bull at the base of the altar of the burnt offering, which is at the door of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall take from it all the fat of the bull as the sin offering. The fat that covers the entrails and all the fat which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on the entrails, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the two kidneys and the fat that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " on them by the flanks, and the fatty lobe "
                        },
                        {
                            "style": "ITALIC",
                            "text": "attached"
                        },
                        {
                            "style": "NONE",
                            "text": " to the liver above the kidneys, he shall remove, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as it was taken from the bull of the sacrifice of the peace offering; and the priest shall burn them on the altar of the burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the bull’s hide and all its flesh, with its head and legs, its entrails and offal— "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the whole bull he shall carry outside the camp to a clean place, where the ashes are poured out, and burn it on wood with fire; where the ashes are poured out it shall be burned."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘Now if the whole congregation of Israel sins unintentionally, and the thing is hidden from the eyes of the assembly, and they have done "
                        },
                        {
                            "style": "ITALIC",
                            "text": "something against"
                        },
                        {
                            "style": "NONE",
                            "text": " any of the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in anything"
                        },
                        {
                            "style": "NONE",
                            "text": " which should not be done, and are guilty; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "when the sin which they have committed becomes known, then the assembly shall offer a young bull for the sin, and bring it before the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the elders of the congregation shall lay their hands on the head of the bull before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". Then the bull shall be killed before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The anointed priest shall bring some of the bull’s blood to the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall dip his finger in the blood and sprinkle "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " seven times before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", in front of the veil. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the blood on the horns of the altar which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in the tabernacle of meeting; and he shall pour the remaining blood at the base of the altar of burnt offering, which is at the door of the tabernacle of meeting. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall take all the fat from it and burn "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the altar. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall do with the bull as he did with the bull as a sin offering; thus he shall do with it. So the priest shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for them, and it shall be forgiven them. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he shall carry the bull outside the camp, and burn it as he burned the first bull. It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering for the assembly."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘When a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "leader"
                        },
                        {
                            "style": "NONE",
                            "text": "ruler has sinned, and done "
                        },
                        {
                            "style": "ITALIC",
                            "text": "something"
                        },
                        {
                            "style": "NONE",
                            "text": " unintentionally "
                        },
                        {
                            "style": "ITALIC",
                            "text": "against"
                        },
                        {
                            "style": "NONE",
                            "text": " any of the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " his God "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in anything"
                        },
                        {
                            "style": "NONE",
                            "text": " which should not be done, and is guilty, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or if his sin which he has committed "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "is made known to him"
                        },
                        {
                            "style": "NONE",
                            "text": "comes to his knowledge, he shall bring as his offering a kid of the goats, a male without blemish. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall lay his hand on the head of the goat, and kill it at the place where they kill the burnt offering before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". It "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a sin offering. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The priest shall take some of the blood of the sin offering with his finger, put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the horns of the altar of burnt offering, and pour its blood at the base of the altar of burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall burn all its fat on the altar, like the fat of the sacrifice of the peace offering. So the priest shall make "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. covering"
                        },
                        {
                            "style": "NONE",
                            "text": "atonement for him concerning his sin, and it shall be forgiven him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. any soul"
                        },
                        {
                            "style": "NONE",
                            "text": "anyone of the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. people of the land"
                        },
                        {
                            "style": "NONE",
                            "text": "common people sins unintentionally by doing "
                        },
                        {
                            "style": "ITALIC",
                            "text": "something against"
                        },
                        {
                            "style": "NONE",
                            "text": " any of the commandments of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "in anything"
                        },
                        {
                            "style": "NONE",
                            "text": " which ought not to be done, and is guilty, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or if his sin which he has committed comes to his knowledge, then he shall bring as his offering a kid of the goats, a female without blemish, for his sin which he has committed. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall lay his hand on the head of the sin offering, and kill the sin offering at the place of the burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the priest shall take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of its blood with his finger, put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the horns of the altar of burnt offering, and pour all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the remaining"
                        },
                        {
                            "style": "NONE",
                            "text": " blood at the base of the altar. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall remove all its fat, as fat is removed from the sacrifice of the peace offering; and the priest shall burn it on the altar for a sweet aroma to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". So the priest shall make atonement for him, and it shall be forgiven him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "‘If he brings a lamb as his sin offering, he shall bring a female without blemish. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he shall lay his hand on the head of the sin offering, and kill it as a sin offering at the place where they kill the burnt offering. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The priest shall take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "some"
                        },
                        {
                            "style": "NONE",
                            "text": " of the blood of the sin offering with his finger, put "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " on the horns of the altar of burnt offering, and pour all "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the remaining"
                        },
                        {
                            "style": "NONE",
                            "text": " blood at the base of the altar. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall remove all its fat, as the fat of the lamb is removed from the sacrifice of the peace offering. Then the priest shall burn it on the altar, according to the offerings made by fire to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". So the priest shall make atonement for his sin that he has committed, and it shall be forgiven him."
                        }
                    ]
                }
            ]
        }
    ]
}