{
    "chapter_num": 7,
    "verses_count": 26,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "A Chosen People"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God brings you into the land which you go to possess, and has cast out many nations before you, the Hittites and the Girgashites and the Amorites and the Canaanites and the Perizzites and the Hivites and the Jebusites, seven nations greater and mightier than you, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and when the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God delivers them over to you, you shall conquer them "
                        },
                        {
                            "style": "ITALIC",
                            "text": "and"
                        },
                        {
                            "style": "NONE",
                            "text": " utterly destroy them. You shall make no covenant with them nor show mercy to them. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nor shall you make marriages with them. You shall not give your daughter to their son, nor take their daughter for your son. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For they will turn your sons away from following Me, to serve other gods; so the anger of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " will be aroused against you and destroy you suddenly. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But thus you shall deal with them: you shall destroy their altars, and break down their "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": " pillars, and cut down their "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb. Asherim, Canaanite deities"
                        },
                        {
                            "style": "NONE",
                            "text": "wooden images, and burn their carved images with fire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " a "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "set-apart"
                        },
                        {
                            "style": "NONE",
                            "text": "holy people to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God; the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has chosen you to be a people for Himself, a special treasure above all the peoples on the face of the earth. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " did not set His love on you nor choose you because you were more in number than any other people, for you were the least of all peoples; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but because the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " loves you, and because He would keep the oath which He swore to your fathers, the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has brought you out with a mighty hand, and redeemed you from the house of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "slavery"
                        },
                        {
                            "style": "NONE",
                            "text": "bondage, from the hand of Pharaoh king of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Therefore know that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, He "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " God, the faithful God who keeps covenant and mercy for a thousand generations with those who love Him and keep His commandments; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and He repays those who hate Him to their face, to destroy them. He will not "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "delay"
                        },
                        {
                            "style": "NONE",
                            "text": "be slack with him who hates Him; He will repay him to his face. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore you shall keep the commandment, the statutes, and the judgments which I command you today, to observe them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Blessings of Obedience"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then it shall come to pass, because you listen to these judgments, and keep and do them, that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will keep with you the covenant and the mercy which He swore to your fathers. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He will love you and bless you and "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "cause you to increase"
                        },
                        {
                            "style": "NONE",
                            "text": "multiply you; He will also bless the fruit of your womb and the fruit of your land, your grain and your new wine and your oil, the increase of your cattle and the offspring of your flock, in the land of which He "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "promised"
                        },
                        {
                            "style": "NONE",
                            "text": "swore to your fathers to give you. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall be blessed above all peoples; there shall not be a male or female barren among you or among your livestock. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " will take away from you all sickness, and will afflict you with none of the terrible diseases of Egypt which you have known, but will lay "
                        },
                        {
                            "style": "ITALIC",
                            "text": "them"
                        },
                        {
                            "style": "NONE",
                            "text": " on all those who hate you. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Also you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consume"
                        },
                        {
                            "style": "NONE",
                            "text": "destroy all the peoples whom the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God delivers over to you; your eye shall have no pity on them; nor shall you serve their gods, for that "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " a snare to you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you should say in your heart, ‘These nations are greater than I; how can I dispossess them?’— "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall not be afraid of them, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "but"
                        },
                        {
                            "style": "NONE",
                            "text": " you shall remember well what the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God did to Pharaoh and to all Egypt: "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the great trials which your eyes saw, the signs and the wonders, the mighty hand and the outstretched arm, by which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God brought you out. So shall the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God do to all the peoples of whom you are afraid. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will send the hornet among them until those who are left, who hide themselves from you, are destroyed. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not be terrified of them; for the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, the great and awesome God, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " among you. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will drive out those nations before you little by little; you will be unable to "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "consume"
                        },
                        {
                            "style": "NONE",
                            "text": "destroy them at once, lest the beasts of the field become "
                        },
                        {
                            "style": "ITALIC",
                            "text": "too"
                        },
                        {
                            "style": "NONE",
                            "text": " numerous for you. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God will deliver them over to you, and will inflict defeat upon them until they are destroyed. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And He will deliver their kings into your hand, and you will destroy their name from under heaven; no one shall be able to stand "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "before"
                        },
                        {
                            "style": "NONE",
                            "text": "against you until you have destroyed them. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall burn the carved images of their gods with fire; you shall not covet"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "desire"
                        },
                        {
                            "style": "NONE",
                            "text": " the silver or gold "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that is"
                        },
                        {
                            "style": "NONE",
                            "text": " on them, nor take "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " for yourselves, lest you be snared by it; for it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " an abomination to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nor shall you bring an abomination into your house, lest you be doomed to destruction like it. You shall utterly detest it and utterly abhor it, for it "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " an "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "devoted or banned"
                        },
                        {
                            "style": "NONE",
                            "text": "accursed thing."
                        }
                    ]
                }
            ]
        }
    ]
}