{
    "chapter_num": 19,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Three Cities of Refuge"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God has cut off the nations whose land the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you, and you dispossess them and dwell in their cities and in their houses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall separate three cities for yourself in the midst of your land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you to possess. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall prepare roads for yourself, and divide into three parts the territory of your land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you to inherit, that any manslayer may flee there."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " the case of the manslayer who flees there, that he may live: Whoever kills his neighbor "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "ignorantly, lit. without knowledge"
                        },
                        {
                            "style": "NONE",
                            "text": "unintentionally, not having hated him in time past— "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as when "
                        },
                        {
                            "style": "ITALIC",
                            "text": "a man"
                        },
                        {
                            "style": "NONE",
                            "text": " goes to the woods with his neighbor to cut timber, and his hand swings a stroke with the ax to cut down the tree, and the head slips from the handle and strikes his neighbor so that he dies—he shall flee to one of these cities and live; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest the avenger of blood, while his anger is hot, pursue the manslayer and overtake him, because the way is long, and kill him, though he "
                        },
                        {
                            "style": "ITALIC",
                            "text": "was"
                        },
                        {
                            "style": "NONE",
                            "text": " not deserving of death, since he had not hated the victim in time past. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I command you, saying, ‘You shall separate three cities for yourself.’"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now if the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God enlarges your territory, as He swore to your fathers, and gives you the land which He promised to give to your fathers, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and if you keep all these commandments and do them, which I command you today, to love the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God and to walk always in His ways, then you shall add three more cities for yourself besides these three, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest innocent blood be shed in the midst of your land which the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you "
                        },
                        {
                            "style": "ITALIC",
                            "text": "as"
                        },
                        {
                            "style": "NONE",
                            "text": " an inheritance, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "thus"
                        },
                        {
                            "style": "NONE",
                            "text": " guilt of bloodshed be upon you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if anyone hates his neighbor, lies in wait for him, rises against him and strikes him mortally, so that he dies, and he flees to one of these cities, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the elders of his city shall send and bring him from there, and deliver him over to the hand of the avenger of blood, that he may die. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your eye shall not pity him, but you shall "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "purge the blood of the innocent"
                        },
                        {
                            "style": "NONE",
                            "text": "put away "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the guilt of"
                        },
                        {
                            "style": "NONE",
                            "text": " innocent blood from Israel, that it may go well with you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Property Boundaries"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not remove your neighbor’s landmark, which the men of old have set, in your inheritance which you will inherit in the land that the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God is giving you to possess."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law Concerning Witnesses"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“One witness shall not rise against a man concerning any iniquity or any sin that he commits; by the mouth of two or three witnesses the matter shall be established. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a false witness rises against any man to testify against him of wrongdoing, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then both men in the controversy shall stand before the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", before the priests and the judges who serve in those days. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the judges shall make careful inquiry, and indeed, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "if"
                        },
                        {
                            "style": "NONE",
                            "text": " the witness "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " a false witness, who has testified falsely against his brother, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall do to him as he thought to have done to his brother; so you shall put away the evil from among you. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those who remain shall hear and fear, and hereafter they shall not again commit such evil among you. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your eye shall not pity: life "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shall be"
                        },
                        {
                            "style": "NONE",
                            "text": " for life, eye for eye, tooth for tooth, hand for hand, foot for foot."
                        }
                    ]
                }
            ]
        }
    ]
}