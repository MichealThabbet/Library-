{
    "chapter_num": 1,
    "verses_count": 30,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Greeting"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul and Timothy, bondservants of Jesus Christ,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To all the saints in Christ Jesus who are in Philippi, with the "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. overseers"
                        },
                        {
                            "style": "NONE",
                            "text": "bishops and deacons:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Thankfulness and Prayer"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I thank my God upon every remembrance of you, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "always in every prayer of mine making request for you all with joy, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for your fellowship in the gospel from the first day until now, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "being confident of this very thing, that He who has begun a good work in you will complete "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it"
                        },
                        {
                            "style": "NONE",
                            "text": " until the day of Jesus Christ; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "just as it is right for me to think this of you all, because I have you in my heart, inasmuch as both in my chains and in the defense and confirmation of the gospel, you all are partakers with me of grace. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For God is my witness, how greatly I long for you all with the affection of Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this I pray, that your love may abound still more and more in knowledge and all discernment, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that you may approve the things that are excellent, that you may be sincere and without offense till the day of Christ, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "being filled with the fruits of righteousness which "
                        },
                        {
                            "style": "ITALIC",
                            "text": "are"
                        },
                        {
                            "style": "NONE",
                            "text": " by Jesus Christ, to the glory and praise of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Christ Is Preached"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But I want you to know, brethren, that the things "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which happened"
                        },
                        {
                            "style": "NONE",
                            "text": " to me have actually turned out for the furtherance of the gospel, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that it has become evident to the whole "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Praetorium"
                        },
                        {
                            "style": "NONE",
                            "text": "palace guard, and to all the rest, that my chains are in Christ; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and most of the brethren in the Lord, having become confident by my chains, are much more bold to speak the word without fear."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Some indeed preach Christ even from envy and strife, and some also from goodwill: "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU reverses vv. 16 and 17."
                        },
                        {
                            "style": "NONE",
                            "text": "The former preach Christ from selfish ambition, not sincerely, supposing to add affliction to my chains; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but the latter out of love, knowing that I am appointed for the defense of the gospel. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What then? Only "
                        },
                        {
                            "style": "ITALIC",
                            "text": "that"
                        },
                        {
                            "style": "NONE",
                            "text": " in every way, whether in pretense or in truth, Christ is preached; and in this I rejoice, yes, and will rejoice."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "To Live Is Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For I know that this will turn out for my deliverance through your prayer and the supply of the Spirit of Jesus Christ, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "according to my earnest expectation and hope that in nothing I shall be ashamed, but with all boldness, as always, so now also Christ will be magnified in my body, whether by life or by death. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For to me, to live "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " Christ, and to die "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " gain. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if "
                        },
                        {
                            "style": "ITALIC",
                            "text": "I"
                        },
                        {
                            "style": "NONE",
                            "text": " live on in the flesh, this "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will mean"
                        },
                        {
                            "style": "NONE",
                            "text": " fruit from "
                        },
                        {
                            "style": "ITALIC",
                            "text": "my"
                        },
                        {
                            "style": "NONE",
                            "text": " labor; yet what I shall choose I "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "do not know"
                        },
                        {
                            "style": "NONE",
                            "text": "cannot tell. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "NU, M But"
                        },
                        {
                            "style": "NONE",
                            "text": "For I am hard-pressed between the two, having a desire to depart and be with Christ, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "which is"
                        },
                        {
                            "style": "NONE",
                            "text": " far better. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless to remain in the flesh "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " more needful for you. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And being confident of this, I know that I shall remain and continue with you all for your progress and joy of faith, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that your rejoicing for me may be more abundant in Jesus Christ by my coming to you again."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Striving and Suffering for Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Only let your conduct be worthy of the gospel of Christ, so that whether I come and see you or am absent, I may hear of your affairs, that you stand fast in one spirit, with one mind striving together for the faith of the gospel, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and not in any way terrified by your adversaries, which is to them a proof of perdition, but "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "NU of your salvation"
                        },
                        {
                            "style": "NONE",
                            "text": "to you of salvation, and that from God. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For to you it has been granted on behalf of Christ, not only to believe in Him, but also to suffer for His sake, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having the same conflict which you saw in me and now hear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "is"
                        },
                        {
                            "style": "NONE",
                            "text": " in me."
                        }
                    ]
                }
            ]
        }
    ]
}