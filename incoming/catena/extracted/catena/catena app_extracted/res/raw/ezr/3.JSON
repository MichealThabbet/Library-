{
    "chapter_num": 3,
    "verses_count": 13,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Worship Restored at Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when the seventh month had come, and the children of Israel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "were"
                        },
                        {
                            "style": "NONE",
                            "text": " in the cities, the people gathered together as one man to Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Joshua"
                        },
                        {
                            "style": "NONE",
                            "text": "Jeshua the son of Jozadak"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehozadak, 1 Chr. 6:14"
                        },
                        {
                            "style": "NONE",
                            "text": " and his brethren the priests, and Zerubbabel the son of Shealtiel and his brethren, arose and built the altar of the God of Israel, to offer burnt offerings on it, as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " written in the Law of Moses the man of God. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Though fear "
                        },
                        {
                            "style": "ITALIC",
                            "text": "had come"
                        },
                        {
                            "style": "NONE",
                            "text": " upon them because of the people of those countries, they set the altar on its "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "foundations"
                        },
                        {
                            "style": "NONE",
                            "text": "bases; and they offered burnt offerings on it to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        },
                        {
                            "style": "ITALIC",
                            "text": "both"
                        },
                        {
                            "style": "NONE",
                            "text": " the morning and evening burnt offerings. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They also kept the Feast of Tabernacles, as "
                        },
                        {
                            "style": "ITALIC",
                            "text": "it is"
                        },
                        {
                            "style": "NONE",
                            "text": " written, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "offered"
                        },
                        {
                            "style": "NONE",
                            "text": " the daily burnt offerings in the number required by ordinance for each day. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Afterwards "
                        },
                        {
                            "style": "ITALIC",
                            "text": "they offered"
                        },
                        {
                            "style": "NONE",
                            "text": " the regular burnt offering, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "those"
                        },
                        {
                            "style": "NONE",
                            "text": " for New Moons and for all the appointed feasts of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " that were consecrated, and "
                        },
                        {
                            "style": "ITALIC",
                            "text": "those"
                        },
                        {
                            "style": "NONE",
                            "text": " of everyone who willingly offered a freewill offering to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "From the first day of the seventh month they began to offer burnt offerings to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", although the foundation of the temple of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had not been laid. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They also gave money to the masons and the carpenters, and food, drink, and oil to the people of Sidon and Tyre to bring cedar logs from Lebanon to the sea, to Joppa, according to the permission which they had from Cyrus king of Persia."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Restoration of the Temple Begins"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in the second month of the second year of their coming to the house of God at Jerusalem, Zerubbabel the son of Shealtiel, Jeshua the son of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Jehozadak, 1 Chr. 6:14"
                        },
                        {
                            "style": "NONE",
                            "text": "Jozadak, and the rest of their brethren the priests and the Levites, and all those who had come out of the captivity to Jerusalem, began "
                        },
                        {
                            "style": "ITALIC",
                            "text": "work"
                        },
                        {
                            "style": "NONE",
                            "text": " and appointed the Levites from twenty years old and above to oversee the work of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Jeshua "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " his sons and brothers, Kadmiel "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " his sons, and the sons of "
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Hodaviah, Ezra 2:40"
                        },
                        {
                            "style": "NONE",
                            "text": "Judah, arose as one to oversee those working on the house of God: the sons of Henadad "
                        },
                        {
                            "style": "ITALIC",
                            "text": "with"
                        },
                        {
                            "style": "NONE",
                            "text": " their sons and their brethren the Levites."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the builders laid the foundation of the temple of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "So with LXX, Syr., Vg.; MT they stationed the priests"
                        },
                        {
                            "style": "NONE",
                            "text": " priests stood in their apparel with trumpets, and the Levites, the sons of Asaph, with cymbals, to praise the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", according to the ordinance"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. hands"
                        },
                        {
                            "style": "NONE",
                            "text": " of David king of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they sang responsively, praising and giving thanks to the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ":"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“For "
                        },
                        {
                            "style": "ITALIC",
                            "text": "He is"
                        },
                        {
                            "style": "NONE",
                            "text": " good,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For His mercy "
                        },
                        {
                            "style": "ITALIC",
                            "text": "endures"
                        },
                        {
                            "style": "NONE",
                            "text": " forever toward Israel.”"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Then all the people shouted with a great shout, when they praised the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", because the foundation of the house of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was laid."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But many of the priests and Levites and heads of the fathers’ "
                        },
                        {
                            "style": "ITALIC",
                            "text": "houses,"
                        },
                        {
                            "style": "NONE",
                            "text": " old men who had seen the first temple, wept with a loud voice when the foundation of this temple was laid before their eyes. Yet many shouted aloud for joy, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that the people could not discern the noise of the shout of joy from the noise of the weeping of the people, for the people shouted with a loud shout, and the sound was heard afar off."
                        }
                    ]
                }
            ]
        }
    ]
}