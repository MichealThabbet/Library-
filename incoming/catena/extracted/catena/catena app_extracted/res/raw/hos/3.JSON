{
    "chapter_num": 3,
    "verses_count": 5,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Israel Will Return to God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to me, “Go again, love a woman "
                        },
                        {
                            "style": "ITALIC",
                            "text": "who is"
                        },
                        {
                            "style": "NONE",
                            "text": " loved by a lover"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Lit. friend or husband"
                        },
                        {
                            "style": "NONE",
                            "text": " and is committing adultery, just like the love of the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " for the children of Israel, who look to other gods and love "
                        },
                        {
                            "style": "ITALIC",
                            "text": "the"
                        },
                        {
                            "style": "NONE",
                            "text": " raisin cakes "
                        },
                        {
                            "style": "ITALIC",
                            "text": "of the pagans."
                        },
                        {
                            "style": "NONE",
                            "text": "”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So I bought her for myself for fifteen "
                        },
                        {
                            "style": "ITALIC",
                            "text": "shekels"
                        },
                        {
                            "style": "NONE",
                            "text": " of silver, and one and one-half homers of barley. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I said to her, “You shall stay with me many days; you shall not play the harlot, nor shall you have a man—so, too, "
                        },
                        {
                            "style": "ITALIC",
                            "text": "will"
                        },
                        {
                            "style": "NONE",
                            "text": " I "
                        },
                        {
                            "style": "ITALIC",
                            "text": "be"
                        },
                        {
                            "style": "NONE",
                            "text": " toward you.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the children of Israel shall abide many days without king or prince, without sacrifice or "
                        },
                        {
                            "style": "ITALIC",
                            "text": "sacred"
                        },
                        {
                            "style": "NONE",
                            "text": " pillar, without ephod or teraphim. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Afterward the children of Israel shall return and seek the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God and David their king. They shall fear the "
                        },
                        {
                            "style": "DIVINE_NAME",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and His goodness in the latter days."
                        }
                    ]
                }
            ]
        }
    ]
}