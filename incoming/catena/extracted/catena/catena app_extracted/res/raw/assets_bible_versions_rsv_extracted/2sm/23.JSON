{
    "chapter_num": 23,
    "verses_count": 39,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Last Words of David"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these are the last words of David:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The oracle of David, the son of Jesse,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tthe oracle of the man who was raised on high,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "the anointed of the God of Jacob,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tthe sweet psalmist of Israel:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The Spirit of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " speaks by me,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\this word is upon my tongue."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The God of Israel has spoken,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tthe Rock of Israel has said to me:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "When one rules justly over men,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\truling in the fear of God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he dawns on them like the morning light,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tlike the sun shining forth upon a cloudless morning,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tlike rain that makes grass to sprout from the earth."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yea, does not my house stand so with God?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tFor he has made with me an everlasting covenant,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tordered in all things and secure."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "For will he not cause to prosper"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tall my help and my desire?"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But godless men"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb worthlessness"
                        },
                        {
                            "style": "NONE",
                            "text": " are all like thorns that are thrown away;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tfor they cannot be taken with the hand;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but the man who touches them"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tarms himself with iron and the shaft of a spear,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "\tand they are utterly consumed with fire.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "David’s Mighty Men"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the names of the mighty men whom David had: Josheb-basshe′beth a Tah-che′monite; he was chief of the three;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or captains"
                        },
                        {
                            "style": "NONE",
                            "text": " he wielded his spear"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "1 Chr 11.11: Heb obscure"
                        },
                        {
                            "style": "NONE",
                            "text": " against eight hundred whom he slew at one time."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And next to him among the three mighty men was Elea′zar the son of Dodo, son of Aho′hi. He was with David when they defied the Philistines who were gathered there for battle, and the men of Israel withdrew. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He rose and struck down the Philistines until his hand was weary, and his hand cleaved to the sword; and the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " wrought a great victory that day; and the men returned after him only to strip the slain."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And next to him was Shammah, the son of Agee the Har′arite. The Philistines gathered together at Lehi, where there was a plot of ground full of lentils; and the men fled from the Philistines. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he took his stand in the midst of the plot, and defended it, and slew the Philistines; and the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " wrought a great victory."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And three of the thirty chief men went down, and came about harvest time to David at the cave of Adullam, when a band of Philistines was encamped in the valley of Reph′aim. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David was then in the stronghold; and the garrison of the Philistines was then at Bethlehem. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David said longingly, “O that some one would give me water to drink from the well of Bethlehem which is by the gate!” "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the three mighty men broke through the camp of the Philistines, and drew water out of the well of Bethlehem which was by the gate, and took and brought it to David. But he would not drink of it; he poured it out to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said, “Far be it from me, O "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", that I should do this. Shall I drink the blood of the men who went at the risk of their lives?” Therefore he would not drink it. These things did the three mighty men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Abi′shai, the brother of Jo′ab, the son of Zeru′iah, was chief of the thirty."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Two Hebrew Mss Syr: MT three"
                        },
                        {
                            "style": "NONE",
                            "text": " And he wielded his spear against three hundred men and slew them, and won a name beside the three. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was the most renowned of the thirty,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "1 Chr 11.25: Heb Was he the most renowned of the three?"
                        },
                        {
                            "style": "NONE",
                            "text": " and became their commander; but he did not attain to the three."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Benai′ah the son of Jehoi′ada was a valiant man"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Another reading is the son of Ish-hai"
                        },
                        {
                            "style": "NONE",
                            "text": " of Kabzeel, a doer of great deeds; he smote two ariels"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The meaning of the word ariel is unknown"
                        },
                        {
                            "style": "NONE",
                            "text": " of Moab. He also went down and slew a lion in a pit on a day when snow had fallen. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he slew an Egyptian, a handsome man. The Egyptian had a spear in his hand; but Benai′ah went down to him with a staff, and snatched the spear out of the Egyptian’s hand, and slew him with his own spear. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These things did Benai′ah the son of Jehoi′ada, and won a name beside the three mighty men. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He was renowned among the thirty, but he did not attain to the three. And David set him over his bodyguard."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As′ahel the brother of Jo′ab was one of the thirty; Elha′nan the son of Dodo of Bethlehem, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shammah of Harod, Eli′ka of Harod, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Helez the Paltite, Ira the son of Ikkesh of Teko′a, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abie′zer, of An′athoth, Mebun′nai the Hu′shathite, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zalmon the Aho′hite, Ma′harai of Netoph′ah, "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Heleb the son of Ba′anah of Netoph′ah, It′tai the son of Ri′bai of Gib′e-ah of the Benjaminites, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Benai′ah of Pira′thon, Hid′dai of the brooks of Ga′ash, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abi-al′bon the Ar′bathite, Az′maveth of Bahu′rim, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eli′ahba of Sha-al′bon, the sons of Jashen, Jonathan, "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shammah the Har′arite, Ahi′am the son of Sharar the Har′arite, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eliph′elet the son of Ahas′bai of Ma′acah, Eli′am the son of Ahith′ophel of Gilo, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hezro"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Another reading is Hezrai"
                        },
                        {
                            "style": "NONE",
                            "text": " of Carmel, Pa′arai the Arbite, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Igal the son of Nathan of Zobah, Bani the Gadite, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zelek the Ammonite, Na′harai of Be-er′oth, the armor-bearer of Jo′ab the son of Zeru′iah, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ira the Ithrite, Gareb the Ithrite, "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Uri′ah the Hittite: thirty-seven in all."
                        }
                    ]
                }
            ]
        }
    ]
}