{
    "chapter_num": 4,
    "verses_count": 6,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Great Day of the Lord"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 4.1–6 are Ch 3.19–24 in the Hebrew"
                        },
                        {
                            "style": "NONE",
                            "text": " “For behold, the day comes, burning like an oven, when all the arrogant and all evildoers will be stubble; the day that comes shall burn them up, says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " of hosts, so that it will leave them neither root nor branch. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But for you who fear my name the sun of righteousness shall rise, with healing in its wings. You shall go forth leaping like calves from the stall. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall tread down the wicked, for they will be ashes under the soles of your feet, on the day when I act, says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " of hosts."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Remember the law of my servant Moses, the statutes and ordinances that I commanded him at Horeb for all Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Behold, I will send you Eli′jah the prophet before the great and terrible day of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " comes. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he will turn the hearts of fathers to their children and the hearts of children to their fathers, lest I come and smite the land with a curse.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or ban of utter destruction"
                        }
                    ]
                }
            ]
        }
    ]
}