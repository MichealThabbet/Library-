    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Further Assurances of God’s Redeeming Love"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to me, “Go again, love a woman who is beloved of a paramour and is an adulteress; even as the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " loves the people of Israel, though they turn to other gods and love cakes of raisins.” "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So I bought her for fifteen shekels of silver and a homer and a lethech of barley. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I said to her, “You must dwell as mine for many days; you shall not play the harlot, or belong to another man; so will I also be to you.” "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the children of Israel shall dwell many days without king or prince, without sacrifice or pillar, without ephod or teraphim. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Afterward the children of Israel shall return and seek the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God, and David their king; and they shall come in fear to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and to his goodness in the latter days."
                        }
                    ]
                }
            ]
        }
    ]
}