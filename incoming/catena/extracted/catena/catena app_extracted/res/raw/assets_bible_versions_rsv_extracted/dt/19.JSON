{
    "chapter_num": 19,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Laws concerning the Cities of Refuge"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God cuts off the nations whose land the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you, and you dispossess them and dwell in their cities and in their houses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall set apart three cities for you in the land which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you to possess. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall prepare the roads, and divide into three parts the area of the land which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you as a possession, so that any manslayer can flee to them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This is the provision for the manslayer, who by fleeing there may save his life. If any one kills his neighbor unintentionally without having been at enmity with him in time past— "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as when a man goes into the forest with his neighbor to cut wood, and his hand swings the axe to cut down a tree, and the head slips from the handle and strikes his neighbor so that he dies—he may flee to one of these cities and save his life; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest the avenger of blood in hot anger pursue the manslayer and overtake him, because the way is long, and wound him mortally, though the man did not deserve to die, since he was not at enmity with his neighbor in time past. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore I command you, You shall set apart three cities. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God enlarges your border, as he has sworn to your fathers, and gives you all the land which he promised to give to your fathers— "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "provided you are careful to keep all this commandment, which I command you this day, by loving the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God and by walking ever in his ways—then you shall add three other cities to these three, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "lest innocent blood be shed in your land which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you for an inheritance, and so the guilt of bloodshed be upon you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if any man hates his neighbor, and lies in wait for him, and attacks him, and wounds him mortally so that he dies, and the man flees into one of these cities, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the elders of his city shall send and fetch him from there, and hand him over to the avenger of blood, so that he may die. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your eye shall not pity him, but you shall purge the guilt of innocent blood"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or the blood of the innocent"
                        },
                        {
                            "style": "NONE",
                            "text": " from Israel, so that it may be well with you."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Property Boundaries"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“In the inheritance which you will hold in the land that the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God gives you to possess, you shall not remove your neighbor’s landmark, which the men of old have set."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Law concerning Witnesses"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“A single witness shall not prevail against a man for any crime or for any wrong in connection with any offense that he has committed; only on the evidence of two witnesses, or of three witnesses, shall a charge be sustained. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a malicious witness rises against any man to accuse him of wrongdoing, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then both parties to the dispute shall appear before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", before the priests and the judges who are in office in those days; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the judges shall inquire diligently, and if the witness is a false witness and has accused his brother falsely, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then you shall do to him as he had meant to do to his brother; so you shall purge the evil from the midst of you. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the rest shall hear, and fear, and shall never again commit any such evil among you. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your eye shall not pity; it shall be life for life, eye for eye, tooth for tooth, hand for hand, foot for foot."
                        }
                    ]
                }
            ]
        }
    ]
}