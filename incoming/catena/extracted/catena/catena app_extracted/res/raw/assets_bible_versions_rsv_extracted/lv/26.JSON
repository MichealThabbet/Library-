{
    "chapter_num": 26,
    "verses_count": 46,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Rewards for Obedience"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make for yourselves no idols and erect no graven image or pillar, and you shall not set up a figured stone in your land, to bow down to them; for I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep my sabbaths and reverence my sanctuary: I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you walk in my statutes and observe my commandments and do them, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I will give you your rains in their season, and the land shall yield its increase, and the trees of the field shall yield their fruit. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And your threshing shall last to the time of vintage, and the vintage shall last to the time for sowing; and you shall eat your bread to the full, and dwell in your land securely. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will give peace in the land, and you shall lie down, and none shall make you afraid; and I will remove evil beasts from the land, and the sword shall not go through your land. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall chase your enemies, and they shall fall before you by the sword. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Five of you shall chase a hundred, and a hundred of you shall chase ten thousand; and your enemies shall fall before you by the sword. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will have regard for you and make you fruitful and multiply you, and will confirm my covenant with you. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall eat old store long kept, and you shall clear out the old to make way for the new. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will make my abode among you, and my soul shall not abhor you. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will walk among you, and will be your God, and you shall be my people. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, who brought you forth out of the land of Egypt, that you should not be their slaves; and I have broken the bars of your yoke and made you walk erect."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Penalties for Disobedience"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if you will not hearken to me, and will not do all these commandments, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "if you spurn my statutes, and if your soul abhors my ordinances, so that you will not do all my commandments, but break my covenant, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will do this to you: I will appoint over you sudden terror, consumption and fever that waste the eyes and cause life to pine away. And you shall sow your seed in vain, for your enemies shall eat it; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will set my face against you, and you shall be smitten before your enemies; those who hate you shall rule over you, and you shall flee when none pursues you. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if in spite of this you will not hearken to me, then I will chastise you again sevenfold for your sins, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and I will break the pride of your power, and I will make your heavens like iron and your earth like brass; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and your strength shall be spent in vain, for your land shall not yield its increase, and the trees of the land shall not yield their fruit."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then if you walk contrary to me, and will not hearken to me, I will bring more plagues upon you, sevenfold as many as your sins. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will let loose the wild beasts among you, which shall rob you of your children, and destroy your cattle, and make you few in number, so that your ways shall become desolate."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And if by this discipline you are not turned to me, but walk contrary to me, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I also will walk contrary to you, and I myself will smite you sevenfold for your sins. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will bring a sword upon you, that shall execute vengeance for the covenant; and if you gather within your cities I will send pestilence among you, and you shall be delivered into the hand of the enemy. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When I break your staff of bread, ten women shall bake your bread in one oven, and shall deliver your bread again by weight; and you shall eat, and not be satisfied."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And if in spite of this you will not hearken to me, but walk contrary to me, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I will walk contrary to you in fury, and chastise you myself sevenfold for your sins. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall eat the flesh of your sons, and you shall eat the flesh of your daughters. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will destroy your high places, and cut down your incense altars, and cast your dead bodies upon the dead bodies of your idols; and my soul will abhor you. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will lay your cities waste, and will make your sanctuaries desolate, and I will not smell your pleasing odors. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will devastate the land, so that your enemies who settle in it shall be astonished at it. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will scatter you among the nations, and I will unsheathe the sword after you; and your land shall be a desolation, and your cities shall be a waste."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then the land shall enjoy"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or pay for"
                        },
                        {
                            "style": "NONE",
                            "text": " its sabbaths as long as it lies desolate, while you are in your enemies’ land; then the land shall rest, and enjoy"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or pay for"
                        },
                        {
                            "style": "NONE",
                            "text": " its sabbaths. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As long as it lies desolate it shall have rest, the rest which it had not in your sabbaths when you dwelt upon it. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as for those of you that are left, I will send faintness into their hearts in the lands of their enemies; the sound of a driven leaf shall put them to flight, and they shall flee as one flees from the sword, and they shall fall when none pursues. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall stumble over one another, as if to escape a sword, though none pursues; and you shall have no power to stand before your enemies. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall perish among the nations, and the land of your enemies shall eat you up. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those of you that are left shall pine away in your enemies’ lands because of their iniquity; and also because of the iniquities of their fathers they shall pine away like them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if they confess their iniquity and the iniquity of their fathers in their treachery which they committed against me, and also in walking contrary to me, "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so that I walked contrary to them and brought them into the land of their enemies; if then their uncircumcised heart is humbled and they make amends for their iniquity; "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then I will remember my covenant with Jacob, and I will remember my covenant with Isaac and my covenant with Abraham, and I will remember the land. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the land shall be left by them, and enjoy"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or pay for"
                        },
                        {
                            "style": "NONE",
                            "text": " its sabbaths while it lies desolate without them; and they shall make amends for their iniquity, because they spurned my ordinances, and their soul abhorred my statutes. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet for all that, when they are in the land of their enemies, I will not spurn them, neither will I abhor them so as to destroy them utterly and break my covenant with them; for I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " their God; "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but I will for their sake remember the covenant with their forefathers, whom I brought forth out of the land of Egypt in the sight of the nations, that I might be their God: I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the statutes and ordinances and laws which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " made between him and the people of Israel on Mount Sinai by Moses."
                        }
                    ]
                }
            ]
        }
    ]
}