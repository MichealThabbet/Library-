{
    "chapter_num": 8,
    "verses_count": 59,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but Jesus went to the Mount of Olives. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Early in the morning he came again to the temple; all the people came to him, and he sat down and taught them. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The scribes and the Pharisees brought a woman who had been caught in adultery, and placing her in the midst "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "they said to him, “Teacher, this woman has been caught in the act of adultery. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now in the law Moses commanded us to stone such. What do you say about her?” "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This they said to test him, that they might have some charge to bring against him. Jesus bent down and wrote with his finger on the ground. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as they continued to ask him, he stood up and said to them, “Let him who is without sin among you be the first to throw a stone at her.” "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And once more he bent down and wrote with his finger on the ground. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when they heard it, they went away, one by one, beginning with the eldest, and Jesus was left alone with the woman standing before him. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus looked up and said to her, “Woman, where are they? Has no one condemned you?” "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "She said, “No one, Lord.” And Jesus said, “Neither do I condemn you; go, and do not sin again.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The most ancient authorities omit 7.53–8.11; other authorities add the passage here or after 7.36 or after 21.25 or after Luke 21.38, with variations of text"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus the Light of the World"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Again Jesus spoke to them, saying, “I am the light of the world; he who follows me will not walk in darkness, but will have the light of life.” "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Pharisees then said to him, “You are bearing witness to yourself; your testimony is not true.” "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered, “Even if I do bear witness to myself, my testimony is true, for I know whence I have come and whither I am going, but you do not know whence I come or whither I am going. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You judge according to the flesh, I judge no one. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet even if I do judge, my judgment is true, for it is not I alone that judge, but I and he"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read the Father"
                        },
                        {
                            "style": "NONE",
                            "text": " who sent me. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In your law it is written that the testimony of two men is true; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I bear witness to myself, and the Father who sent me bears witness to me.” "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said to him therefore, “Where is your Father?” Jesus answered, “You know neither me nor my Father; if you knew me, you would know my Father also.” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These words he spoke in the treasury, as he taught in the temple; but no one arrested him, because his hour had not yet come."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Foretells His Death"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Again he said to them, “I go away, and you will seek me and die in your sin; where I am going, you cannot come.” "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then said the Jews, “Will he kill himself, since he says, ‘Where I am going, you cannot come’?” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said to them, “You are from below, I am from above; you are of this world, I am not of this world. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I told you that you would die in your sins, for you will die in your sins unless you believe that I am he.” "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They said to him, “Who are you?” Jesus said to them, “Even what I have told you from the beginning."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or Why do I talk to you at all?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have much to say about you and much to judge; but he who sent me is true, and I declare to the world what I have heard from him.” "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They did not understand that he spoke to them of the Father. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Jesus said, “When you have lifted up the Son of man, then you will know that I am he, and that I do nothing on my own authority but speak thus as the Father taught me. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he who sent me is with me; he has not left me alone, for I always do what is pleasing to him.” "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As he spoke thus, many believed in him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "True Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus then said to the Jews who had believed in him, “If you continue in my word, you are truly my disciples, "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you will know the truth, and the truth will make you free.” "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They answered him, “We are descendants of Abraham, and have never been in bondage to any one. How is it that you say, ‘You will be made free’?”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered them, “Truly, truly, I say to you, every one who commits sin is a slave to sin. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The slave does not continue in the house for ever; the son continues for ever. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So if the Son makes you free, you will be free indeed. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I know that you are descendants of Abraham; yet you seek to kill me, because my word finds no place in you. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I speak of what I have seen with my Father, and you do what you have heard from your father.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus and Abraham"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They answered him, “Abraham is our father.” Jesus said to them, “If you were Abraham’s children, you would do what Abraham did, "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but now you seek to kill me, a man who has told you the truth which I heard from God; this is not what Abraham did. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You do what your father did.” They said to him, “We were not born of fornication; we have one Father, even God.” "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to them, “If God were your Father, you would love me, for I proceeded and came forth from God; I came not of my own accord, but he sent me. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Why do you not understand what I say? It is because you cannot bear to hear my word. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You are of your father the devil, and your will is to do your father’s desires. He was a murderer from the beginning, and has nothing to do with the truth, because there is no truth in him. When he lies, he speaks according to his own nature, for he is a liar and the father of lies. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But, because I tell the truth, you do not believe me. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Which of you convicts me of sin? If I tell the truth, why do you not believe me? "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who is of God hears the words of God; the reason why you do not hear them is that you are not of God.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Jews answered him, “Are we not right in saying that you are a Samaritan and have a demon?” "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered, “I have not a demon; but I honor my Father, and you dishonor me. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet I do not seek my own glory; there is One who seeks it and he will be the judge. "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Truly, truly, I say to you, if any one keeps my word, he will never see death.” "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Jews said to him, “Now we know that you have a demon. Abraham died, as did the prophets; and you say, ‘If any one keeps my word, he will never taste death.’ "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Are you greater than our father Abraham, who died? And the prophets died! Who do you claim to be?” "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered, “If I glorify myself, my glory is nothing; it is my Father who glorifies me, of whom you say that he is your God. "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But you have not known him; I know him. If I said, I do not know him, I should be a liar like you; but I do know him and I keep his word. "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Your father Abraham rejoiced that he was to see my day; he saw it and was glad.” "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Jews then said to him, “You are not yet fifty years old, and have you seen Abraham?”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read has Abraham seen you?"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus said to them, “Truly, truly, I say to you, before Abraham was, I am.” "
                        }
                    ]
                },
                {
                    "num_int": 59,
                    "num_str": "59",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they took up stones to throw at him; but Jesus hid himself, and went out of the temple."
                        }
                    ]
                }
            ]
        }
    ]
}