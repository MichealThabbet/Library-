                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a tenth for each of the seven lambs: "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also one male goat for a sin offering, besides the sin offering of atonement, and the continual burnt offering and its cereal offering, and their drink offerings."
                        }
                    ]
                }
            ]
        },
        {
