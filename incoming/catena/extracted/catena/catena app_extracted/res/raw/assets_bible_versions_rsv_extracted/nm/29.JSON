    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Offerings at the Festival of Trumpets"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the first day of the seventh month you shall have a holy convocation; you shall do no laborious work. It is a day for you to blow the trumpets, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall offer a burnt offering, a pleasing odor to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": one young bull, one ram, seven male lambs a year old without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "also their cereal offering of fine flour mixed with oil, three tenths of an ephah for the bull, two tenths for the ram, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and one tenth for each of the seven lambs; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with one male goat for a sin offering, to make atonement for you; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "besides the burnt offering of the new moon, and its cereal offering, and the continual burnt offering and its cereal offering, and their drink offering, according to the ordinance for them, a pleasing odor, an offering by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Offerings on the Day of Atonement"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“On the tenth day of this seventh month you shall have a holy convocation, and afflict yourselves; you shall do no work, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but you shall offer a burnt offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", a pleasing odor: one young bull, one ram, seven male lambs a year old; they shall be to you without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and their cereal offering of fine flour mixed with oil, three tenths of an ephah for the bull, two tenths for the one ram, "
                        }
