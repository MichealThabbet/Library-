{
    "chapter_num": 3,
    "verses_count": 36,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Nicodemus Visits Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now there was a man of the Pharisees, named Nicode′mus, a ruler of the Jews. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This man came to Jesus"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek him"
                        },
                        {
                            "style": "NONE",
                            "text": " by night and said to him, “Rabbi, we know that you are a teacher come from God; for no one can do these signs that you do, unless God is with him.” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered him, “Truly, truly, I say to you, unless one is born anew,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or from above"
                        },
                        {
                            "style": "NONE",
                            "text": " he cannot see the kingdom of God.” "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nicode′mus said to him, “How can a man be born when he is old? Can he enter a second time into his mother’s womb and be born?” "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered, “Truly, truly, I say to you, unless one is born of water and the Spirit, he cannot enter the kingdom of God. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That which is born of the flesh is flesh, and that which is born of the Spirit is spirit."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The same Greek word means both wind and spirit"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not marvel that I said to you, ‘You must be born anew.’"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or from above"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The wind"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The same Greek word means both wind and spirit"
                        },
                        {
                            "style": "NONE",
                            "text": " blows where it wills, and you hear the sound of it, but you do not know whence it comes or whither it goes; so it is with every one who is born of the Spirit.” "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nicode′mus said to him, “How can this be?” "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jesus answered him, “Are you a teacher of Israel, and yet you do not understand this? "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Truly, truly, I say to you, we speak of what we know, and bear witness to what we have seen; but you do not receive our testimony. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If I have told you earthly things and you do not believe, how can you believe if I tell you heavenly things? "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No one has ascended into heaven but he who descended from heaven, the Son of man."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities add who is in heaven"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as Moses lifted up the serpent in the wilderness, so must the Son of man be lifted up, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that whoever believes in him may have eternal life.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Some interpreters hold that the quotation continues through verse 21"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For God so loved the world that he gave his only Son, that whoever believes in him should not perish but have eternal life. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For God sent the Son into the world, not to condemn the world, but that the world might be saved through him. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who believes in him is not condemned; he who does not believe is condemned already, because he has not believed in the name of the only Son of God. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this is the judgment, that the light has come into the world, and men loved darkness rather than light, because their deeds were evil. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For every one who does evil hates the light, and does not come to the light, lest his deeds should be exposed. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he who does what is true comes to the light, that it may be clearly seen that his deeds have been wrought in God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus and John the Baptist"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After this Jesus and his disciples went into the land of Judea; there he remained with them and baptized. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John also was baptizing at Ae′non near Salim, because there was much water there; and people came and were baptized. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For John had not yet been put in prison."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now a discussion arose between John’s disciples and a Jew over purifying. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they came to John, and said to him, “Rabbi, he who was with you beyond the Jordan, to whom you bore witness, here he is, baptizing, and all are going to him.” "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John answered, “No one can receive anything except what is given him from heaven. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You yourselves bear me witness, that I said, I am not the Christ, but I have been sent before him. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who has the bride is the bridegroom; the friend of the bridegroom, who stands and hears him, rejoices greatly at the bridegroom’s voice; therefore this joy of mine is now full. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He must increase, but I must decrease.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Some interpreters hold that the quotation continues through verse 36"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The One Who Comes from Heaven"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who comes from above is above all; he who is of the earth belongs to the earth, and of the earth he speaks; he who comes from heaven is above all. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He bears witness to what he has seen and heard, yet no one receives his testimony; "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he who receives his testimony sets his seal to this, that God is true. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For he whom God has sent utters the words of God, for it is not by measure that he gives the Spirit; "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the Father loves the Son, and has given all things into his hand. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who believes in the Son has eternal life; he who does not obey the Son shall not see life, but the wrath of God rests upon him."
                        }
                    ]
                }
            ]
        }
    ]
}