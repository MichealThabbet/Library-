{
    "chapter_num": 21,
    "verses_count": 36,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Law concerning Slaves"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Now these are the ordinances which you shall set before them. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When you buy a Hebrew slave, he shall serve six years, and in the seventh he shall go out free, for nothing. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he comes in single, he shall go out single; if he comes in married, then his wife shall go out with him. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If his master gives him a wife and she bears him sons or daughters, the wife and her children shall be her master’s and he shall go out alone. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the slave plainly says, ‘I love my master, my wife, and my children; I will not go out free,’ "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then his master shall bring him to God, and he shall bring him to the door or the doorpost; and his master shall bore his ear through with an awl; and he shall serve him for life."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When a man sells his daughter as a slave, she shall not go out as the male slaves do. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If she does not please her master, who has designated her"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Another reading is so that he has not designated her"
                        },
                        {
                            "style": "NONE",
                            "text": " for himself, then he shall let her be redeemed; he shall have no right to sell her to a foreign people, since he has dealt faithlessly with her. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he designates her for his son, he shall deal with her as with a daughter. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he takes another wife to himself, he shall not diminish her food, her clothing, or her marital rights. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if he does not do these three things for her, she shall go out for nothing, without payment of money."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Law concerning Violence"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Whoever strikes a man so that he dies shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if he did not lie in wait for him, but God let him fall into his hand, then I will appoint for you a place to which he may flee. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if a man willfully attacks another to kill him treacherously, you shall take him from my altar, that he may die."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Whoever strikes his father or his mother shall be put to death."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Whoever steals a man, whether he sells him or is found in possession of him, shall be put to death."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Whoever curses his father or his mother shall be put to death."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When men quarrel and one strikes the other with a stone or with his fist and the man does not die but keeps his bed, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then if the man rises again and walks abroad with his staff, he that struck him shall be clear; only he shall pay for the loss of his time, and shall have him thoroughly healed."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When a man strikes his slave, male or female, with a rod and the slave dies under his hand, he shall be punished. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the slave survives a day or two, he is not to be punished; for the slave is his money."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When men strive together, and hurt a woman with child, so that there is a miscarriage, and yet no harm follows, the one who hurt her shall"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb he shall"
                        },
                        {
                            "style": "NONE",
                            "text": " be fined, according as the woman’s husband shall lay upon him; and he shall pay as the judges determine. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If any harm follows, then you shall give life for life, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "eye for eye, tooth for tooth, hand for hand, foot for foot, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "burn for burn, wound for wound, stripe for stripe."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When a man strikes the eye of his slave, male or female, and destroys it, he shall let the slave go free for the eye’s sake. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If he knocks out the tooth of his slave, male or female, he shall let the slave go free for the tooth’s sake."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Laws concerning Property"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When an ox gores a man or a woman to death, the ox shall be stoned, and its flesh shall not be eaten; but the owner of the ox shall be clear. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if the ox has been accustomed to gore in the past, and its owner has been warned but has not kept it in, and it kills a man or a woman, the ox shall be stoned, and its owner also shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If a ransom is laid on him, then he shall give for the redemption of his life whatever is laid upon him. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If it gores a man’s son or daughter, he shall be dealt with according to this same rule. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If the ox gores a slave, male or female, the owner shall give to their master thirty shekels of silver, and the ox shall be stoned."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When a man leaves a pit open, or when a man digs a pit and does not cover it, and an ox or an ass falls into it, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the owner of the pit shall make it good; he shall give money to its owner, and the dead beast shall be his."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When one man’s ox hurts another’s, so that it dies, then they shall sell the live ox and divide the price of it; and the dead beast also they shall divide. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Or if it is known that the ox has been accustomed to gore in the past, and its owner has not kept it in, he shall pay ox for ox, and the dead beast shall be his."
                        }
                    ]
                }
            ]
        }
    ]
}