{
    "chapter_num": 28,
    "verses_count": 43,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Vestments for the Priesthood"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Then bring near to you Aaron your brother, and his sons with him, from among the people of Israel, to serve me as priests—Aaron and Aaron’s sons, Nadab and Abi′hu, Elea′zar and Ith′amar. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make holy garments for Aaron your brother, for glory and for beauty. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall speak to all who have ability, whom I have endowed with an able mind, that they make Aaron’s garments to consecrate him for my priesthood. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the garments which they shall make: a breastpiece, an ephod, a robe, a coat of checker work, a turban, and a girdle; they shall make holy garments for Aaron your brother and his sons to serve me as priests."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Ephod"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“They shall receive gold, blue and purple and scarlet stuff, and fine twined linen. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they shall make the ephod of gold, of blue and purple and scarlet stuff, and of fine twined linen, skilfully worked. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall have two shoulder-pieces attached to its two edges, that it may be joined together. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the skilfully woven band upon it, to gird it on, shall be of the same workmanship and materials, of gold, blue and purple and scarlet stuff, and fine twined linen. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take two onyx stones, and engrave on them the names of the sons of Israel, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "six of their names on the one stone, and the names of the remaining six on the other stone, in the order of their birth. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As a jeweler engraves signets, so shall you engrave the two stones with the names of the sons of Israel; you shall enclose them in settings of gold filigree. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall set the two stones upon the shoulder-pieces of the ephod, as stones of remembrance for the sons of Israel; and Aaron shall bear their names before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " upon his two shoulders for remembrance. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make settings of gold filigree, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and two chains of pure gold, twisted like cords; and you shall attach the corded chains to the settings."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Breastplate"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall make a breastpiece of judgment, in skilled work; like the work of the ephod you shall make it; of gold, blue and purple and scarlet stuff, and fine twined linen shall you make it. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be square and double, a span its length and a span its breadth. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall set in it four rows of stones. A row of sardius, topaz, and carbuncle shall be the first row; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the second row an emerald, a sapphire, and a diamond; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the third row a jacinth, an agate, and an amethyst; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the fourth row a beryl, an onyx, and a jasper; they shall be set in gold filigree. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There shall be twelve stones with their names according to the names of the sons of Israel; they shall be like signets, each engraved with its name, for the twelve tribes. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make for the breastpiece twisted chains like cords, of pure gold; "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and you shall make for the breastpiece two rings of gold, and put the two rings on the two edges of the breastpiece. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put the two cords of gold in the two rings at the edges of the breastpiece; "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the two ends of the two cords you shall attach to the two settings of filigree, and so attach it in front to the shoulder-pieces of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make two rings of gold, and put them at the two ends of the breastpiece, on its inside edge next to the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make two rings of gold, and attach them in front to the lower part of the two shoulder-pieces of the ephod, at its joining above the skilfully woven band of the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they shall bind the breastpiece by its rings to the rings of the ephod with a lace of blue, that it may lie upon the skilfully woven band of the ephod, and that the breastpiece shall not come loose from the ephod. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Aaron shall bear the names of the sons of Israel in the breastpiece of judgment upon his heart, when he goes into the holy place, to bring them to continual remembrance before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in the breastpiece of judgment you shall put the Urim and the Thummim, and they shall be upon Aaron’s heart, when he goes in before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; thus Aaron shall bear the judgment of the people of Israel upon his heart before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Other Priestly Vestments"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall make the robe of the ephod all of blue. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall have in it an opening for the head, with a woven binding around the opening, like the opening in a garment,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Hebrew word is of uncertain meaning"
                        },
                        {
                            "style": "NONE",
                            "text": " that it may not be torn. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On its skirts you shall make pomegranates of blue and purple and scarlet stuff, around its skirts, with bells of gold between them, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a golden bell and a pomegranate, a golden bell and a pomegranate, round about on the skirts of the robe. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be upon Aaron when he ministers, and its sound shall be heard when he goes into the holy place before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and when he comes out, lest he die."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall make a plate of pure gold, and engrave on it, like the engraving of a signet, ‘Holy to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".’ "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall fasten it on the turban by a lace of blue; it shall be on the front of the turban. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It shall be upon Aaron’s forehead, and Aaron shall take upon himself any guilt incurred in the holy offering which the people of Israel hallow as their holy gifts; it shall always be upon his forehead, that they may be accepted before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall weave the coat in checker work of fine linen, and you shall make a turban of fine linen, and you shall make a girdle embroidered with needlework."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And for Aaron’s sons you shall make coats and girdles and caps; you shall make them for glory and beauty. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put them upon Aaron your brother, and upon his sons with him, and shall anoint them and ordain them and consecrate them, that they may serve me as priests. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make for them linen breeches to cover their naked flesh; from the loins to the thighs they shall reach; "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they shall be upon Aaron, and upon his sons, when they go into the tent of meeting, or when they come near the altar to minister in the holy place; lest they bring guilt upon themselves and die. This shall be a perpetual statute for him and for his descendants after him."
                        }
                    ]
                }
            ]
        }
    ]
}