    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Envoys from Babylon Welcomed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At that time Mero′dach-bal′adan the son of Bal′adan, king of Babylon, sent envoys with letters and a present to Hezeki′ah, for he heard that he had been sick and had recovered. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hezeki′ah welcomed them; and he showed them his treasure house, the silver, the gold, the spices, the precious oil, his whole armory, all that was found in his storehouses. There was nothing in his house or in all his realm that Hezeki′ah did not show them. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Isaiah the prophet came to King Hezeki′ah, and said to him, “What did these men say? And whence did they come to you?” Hezeki′ah said, “They have come to me from a far country, from Babylon.” "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said, “What have they seen in your house?” Hezeki′ah answered, “They have seen all that is in my house; there is nothing in my storehouses that I did not show them.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Isaiah said to Hezeki′ah, “Hear the word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " of hosts: "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, the days are coming, when all that is in your house, and that which your fathers have stored up till this day, shall be carried to Babylon; nothing shall be left, says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And some of your own sons, who are born to you, shall be taken away; and they shall be eunuchs in the palace of the king of Babylon.” "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then said Hezeki′ah to Isaiah, “The word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " which you have spoken is good.” For he thought, “There will be peace and security in my days.”"
                        }
                    ]
                }
            ]
        }
    ]
}