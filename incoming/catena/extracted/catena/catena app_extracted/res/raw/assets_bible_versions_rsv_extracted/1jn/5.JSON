{
    "chapter_num": 5,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Faith Conquers the World"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every one who believes that Jesus is the Christ is a child of God, and every one who loves the parent loves the child. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "By this we know that we love the children of God, when we love God and obey his commandments. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this is the love of God, that we keep his commandments. And his commandments are not burdensome. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For whatever is born of God overcomes the world; and this is the victory that overcomes the world, our faith. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Who is it that overcomes the world but he who believes that Jesus is the Son of God?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Testimony concerning the Son of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is he who came by water and blood, Jesus Christ, not with the water only but with the water and the blood. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Spirit is the witness, because the Spirit is the truth. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "There are three witnesses, the Spirit, the water, and the blood; and these three agree. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If we receive the testimony of men, the testimony of God is greater; for this is the testimony of God that he has borne witness to his Son. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who believes in the Son of God has the testimony in himself. He who does not believe God has made him a liar, because he has not believed in the testimony that God has borne to his Son. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this is the testimony, that God gave us eternal life, and this life is in his Son. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who has the Son has life; he who has not the Son of God has not life."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Epilogue"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I write this to you who believe in the name of the Son of God, that you may know that you have eternal life. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this is the confidence which we have in him, that if we ask anything according to his will he hears us. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if we know that he hears us in whatever we ask, we know that we have obtained the requests made of him. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If any one sees his brother committing what is not a mortal sin, he will ask, and God"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek he"
                        },
                        {
                            "style": "NONE",
                            "text": " will give him life for those whose sin is not mortal. There is sin which is mortal; I do not say that one is to pray for that. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All wrongdoing is sin, but there is sin which is not mortal."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We know that any one born of God does not sin, but He who was born of God keeps him, and the evil one does not touch him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We know that we are of God, and the whole world is in the power of the evil one."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And we know that the Son of God has come and has given us understanding, to know him who is true; and we are in him who is true, in his Son Jesus Christ. This is the true God and eternal life. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Little children, keep yourselves from idols."
                        }
                    ]
                }
            ]
        }
    ]
}