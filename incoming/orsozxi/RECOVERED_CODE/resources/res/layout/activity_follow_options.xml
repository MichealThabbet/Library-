<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp">
    <ImageView
        android:id="@+id/relative_title"
        android:background="@drawable/sub_follow"
        android:layout_width="wrap_content"
        android:layout_height="100dp"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/facebook"
                android:background="@drawable/sub_fo_face_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginRight="50dp"
                android:contentDescription="الفيسبوك"/>
            <ImageView
                android:id="@+id/twitter"
                android:background="@drawable/sub_fo_twitter_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="تويتر"/>
            <ImageView
                android:id="@+id/web"
                android:background="@drawable/sub_fo_web_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="موقعنا"/>
            <ImageView
                android:id="@+id/raslna"
                android:background="@drawable/sub_fo_raslna_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="راسلنا"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
