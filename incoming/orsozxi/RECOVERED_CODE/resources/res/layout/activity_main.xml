<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/v_header"
        layout="@layout/app_header"/>
    <RelativeLayout
        android:id="@+id/Relative_home_main"
        android:background="@drawable/home_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/v_header">
        <com.app.piapostolos.Views.CircleLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/main_circle_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            fab:firstChildPosition="South"
            fab:isRotating="true"
            fab:rotateToCenter="true"
            fab:speed="75">
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_biblee"
                android:background="@drawable/btn_home_bible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/biblee"/>
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_mangalyaa"
                android:background="@drawable/btn_home_mangalyaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/mangalyaa"/>
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_gwhara"
                android:background="@drawable/btn_home_gwharaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/gwharaa"/>
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_messagess"
                android:background="@drawable/btn_home_messages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/messagess"/>
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_note_book"
                android:background="@drawable/btn_note_book"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/notes_book"/>
            <com.app.piapostolos.Views.CircleImageView
                android:id="@+id/main_media"
                android:background="@drawable/btn_home_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                fab:name="@string/media"/>
        </com.app.piapostolos.Views.CircleLayout>
        <ImageView
            android:id="@+id/ImageView_Balll"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/center"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_iceman"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="100dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/iceman2"
            android:layout_toLeftOf="@+id/main_selected_textView"
            android:layout_alignParentLeft="true"/>
        <ImageView
            android:id="@+id/iv_santa"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/santa_clause"
            android:layout_toRightOf="@+id/main_selected_textView"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="25dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/main_selected_textView"
            android:background="@drawable/selected_home"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffffff"
            android:id="@+id/tv_cop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffffff"
            android:id="@+id/tv_melady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_above="@+id/tv_cop"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_help"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/help"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <com.github.clans.fab.FloatingActionMenu
        android:layout_gravity="bottom|right"
        android:id="@+id/menu_options"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fab:menu_animationDelayPerItem="0"
        fab:menu_backgroundColor="#9033479f"
        fab:menu_colorNormal="@color/colorAccent"
        fab:menu_colorPressed="@color/colorPrimary"
        fab:menu_colorRipple="@color/colorAccent"
        fab:menu_icon="@drawable/ic_floating"
        fab:menu_labels_colorNormal="@color/colorAccent"
        fab:menu_labels_colorPressed="@color/colorPrimary"
        fab:menu_labels_colorRipple="@color/colorAccent"
        fab:menu_labels_ellipsize="end"
        fab:menu_labels_position="right"
        fab:menu_labels_singleLine="true"
        fab:menu_labels_textSize="20sp">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fl_follow"
            fab:fab_label="@string/followw"
            style="@style/MenuButtonsStyle"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_intro"
            fab:fab_label="@string/fb_about"
            style="@style/MenuButtonsStyle"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fb_share"
            fab:fab_label="@string/fb_app_share"
            style="@style/MenuButtonsStyle"/>
    </com.github.clans.fab.FloatingActionMenu>
    <com.app.piapostolos.Views.SnowFlakesLayout
        android:id="@+id/snowflakelayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/v_header"/>
    <include
        android:id="@+id/progress"
        android:visibility="gone"
        layout="@layout/progress"/>
</RelativeLayout>
