<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/button_black"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:layout_margin="15dp">
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:gravity="right"
                android:id="@+id/radioGroup1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">
                <RadioButton
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/rb_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/all_txt"
                    android:drawableRight="@android:drawable/btn_radio"
                    android:drawablePadding="5dp"/>
                <RadioButton
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/rb_old"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/t_old_bible"
                    android:drawableRight="@android:drawable/btn_radio"
                    android:drawablePadding="5dp"/>
                <RadioButton
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/rb_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/t_new_bible"
                    android:drawableRight="@android:drawable/btn_radio"
                    android:drawablePadding="5dp"/>
                <RadioButton
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/rb_private"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/search_by_safr"
                    android:drawableRight="@android:drawable/btn_radio"
                    android:drawablePadding="5dp"/>
            </RadioGroup>
            <Spinner
                android:textColor="#ffffff"
                android:id="@+id/spinner11"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="7dp"
                android:contentDescription="أسفار الكتاب المقدس"
                android:textDirection="anyRtl"/>
            <EditText
                android:textColor="#ffffff"
                android:textColorHint="@color/white"
                android:gravity="top|right"
                android:id="@+id/et_search"
                android:background="@drawable/button_black_edittext"
                android:padding="5dp"
                android:paddingLeft="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:minHeight="30dp"
                android:hint="@string/search_"
                android:minLines="3"
                android:inputType="textMultiLine"
                android:textDirection="anyRtl"/>
            <Button
                android:id="@+id/btn_search"
                android:background="@drawable/button_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/search_"
                android:contentDescription="بحث"
                style="@style/button_text"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
