<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="128dp">
    <RelativeLayout
        android:layout_width="128dp"
        android:layout_height="128dp">
        <ImageView
            android:id="@+id/player_album_art"
            android:background="#ffc0c0c0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <ProgressBar
            android:id="@+id/player_progress_bar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateDrawable="@drawable/loading_animation"
            android:indeterminateDuration="1500"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="44dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="start|top"
                android:id="@+id/player_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:text=""
                android:lines="2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="start"
                android:id="@+id/player_author_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="1dp"
                android:text=""
                android:singleLine="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/player_albumname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="1dp"
                android:text=""
                android:singleLine="true"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/player_close"
            android:background="@drawable/bar_selector_white"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close_white"
            android:scaleType="center"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="48dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/player_previous"
                android:visibility="invisible"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:scaleType="center"/>
            <ImageView
                android:id="@+id/player_pause"
                android:background="@drawable/bar_selector_white"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_action_pause"
                android:scaleType="center"/>
            <ImageView
                android:id="@+id/player_play"
                android:background="@drawable/bar_selector_white"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_action_play"
                android:scaleType="center"/>
            <ImageView
                android:id="@+id/player_next"
                android:visibility="invisible"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:scaleType="center"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
