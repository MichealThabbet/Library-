<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/app_header"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:enabled="false"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_ashaya"
                android:background="@drawable/bg_kolagybtn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عشية"/>
            <Button
                android:enabled="false"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_baker"
                android:background="@drawable/bg_kolagybtn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="باكر"
                android:layout_below="@+id/btn_basely"
                android:layout_centerHorizontal="true"/>
            <Button
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_hamal"
                android:background="@drawable/bg_kolagybtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الحمل"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <Button
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_basely"
                android:background="@drawable/bg_kolagybtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القداس الباسيلى"
                android:layout_below="@+id/btn_basely"
                android:layout_centerHorizontal="true"/>
            <Button
                android:enabled="true"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_gergory"
                android:background="@drawable/bg_kolagybtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القداس الغوريغورى"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <Button
                android:enabled="false"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_kirollosy"
                android:background="@drawable/bg_kolagybtn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القداس الكيرلسى"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <Button
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_sign_langauge"
                android:background="@drawable/bg_kolagybtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_language"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <Button
                android:enabled="true"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffff00"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_all"
                android:background="@drawable/bg_kolagybtn"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ألحان المناسبات و الأعياد"
                android:layout_below="@+id/btn_basely"
                android:layout_centerHorizontal="true"/>
            <Spinner
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/spinner11"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:contentDescription="ألحان المناسبات و الأعياد"
                android:textDirection="anyRtl"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
