<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/linearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/app_header"/>
    <RadioGroup
        android:gravity="right"
        android:layout_gravity="right"
        android:id="@+id/radioGroup1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp">
        <RadioButton
            android:textColor="#ffffff"
            android:id="@+id/r_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="مشكلة فنية"/>
        <RadioButton
            android:textColor="#ffffff"
            android:id="@+id/r_suggest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="طلبات ومقترحات"/>
        <RadioButton
            android:textColor="#ffffff"
            android:id="@+id/r_ask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أسئلة روحية وعقائدية"/>
        <RadioButton
            android:textColor="#ffffff"
            android:id="@+id/r_orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="طلبات صلاة"/>
    </RadioGroup>
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="#ffffff"
                android:layout_gravity="right"
                android:id="@+id/textViewSubject"
                android:background="@drawable/buttonraduishigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text=" العنوان: "
                style="@style/button_text"/>
            <EditText
                android:textColor="#ffffff"
                android:id="@+id/editTextSubject"
                android:background="@drawable/button_black_edittext"
                android:padding="5dp"
                android:paddingLeft="7dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="#ffffff"
                android:layout_gravity="right"
                android:id="@+id/textViewMessage"
                android:background="@drawable/buttonraduishigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text=" نص الرسالة: "
                style="@style/button_text"/>
            <EditText
                android:textColor="#ffffff"
                android:gravity="top"
                android:id="@+id/editTextMessage"
                android:background="@drawable/button_black_edittext"
                android:padding="5dp"
                android:paddingLeft="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_marginBottom="20dp"
                android:minHeight="40dp"
                android:minLines="3"
                android:inputType="textMultiLine"/>
            <Button
                android:id="@+id/buttonSend"
                android:background="@drawable/button_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="ارسال"
                style="@style/button_text"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
