<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/app_header"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <DatePicker
                android:id="@+id/daat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/header"
                android:layout_centerHorizontal="true"/>
            <TimePicker
                android:id="@+id/tiat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/daat"
                android:layout_centerHorizontal="true"/>
            <RadioGroup
                android:id="@+id/radat"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/save3"
                android:layout_alignParentRight="true">
                <RadioButton
                    android:id="@+id/radio2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/empty"/>
                <RadioButton
                    android:id="@+id/radio3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/non"/>
            </RadioGroup>
            <Button
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/save3"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/act"
                android:layout_below="@+id/tiat"
                android:layout_alignLeft="@+id/tiat"
                android:layout_alignRight="@+id/tiat"
                android:contentDescription="@string/act"
                style="@style/button_text"/>
            <Button
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/update22"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"
                android:text="@string/cancel"
                android:layout_below="@+id/save3"
                android:layout_alignLeft="@+id/save3"
                android:layout_alignRight="@+id/tiat"
                android:contentDescription="@string/updatekod"
                style="@style/button_text"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
