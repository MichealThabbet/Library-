<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linear_splash"
    android:background="@drawable/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_footer_splash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="90dp"
            android:layout_height="20dp"
            android:layout_marginBottom="5dp"
            android:weightSum="5">
            <ImageView
                android:id="@+id/iv_nav1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/m_splash_nav_black"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_nav2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/m_splash_nav_black"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_nav3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/m_splash_nav_black"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_nav4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/m_splash_nav_black"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_nav5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/m_splash_nav_black"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
