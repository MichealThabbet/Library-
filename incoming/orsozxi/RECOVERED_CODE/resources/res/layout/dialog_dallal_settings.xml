<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/button_black"
    android:padding="10dp"
    android:layout_width="250dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/coptic_font"
            android:textDirection="rtl"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="2">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/font_size"
                android:layout_weight="1"
                android:textDirection="rtl"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/font_color"
                android:layout_weight="1"
                android:textDirection="rtl"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="2">
            <Spinner
                android:id="@+id/sp_coptic_font_size"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/sp_coptic_font_color"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/arabic_font"
            android:textDirection="rtl"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="2">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/font_size"
                android:layout_weight="1"
                android:textDirection="rtl"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/font_color"
                android:layout_weight="1"
                android:textDirection="rtl"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="2">
            <Spinner
                android:id="@+id/sp_arabic_font_size"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/sp_arabic_font_color"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp">
            <Button
                android:textSize="20dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_Send"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/save"
                android:onClick="saveButtonAction"/>
            <Button
                android:textSize="20dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/cancel"
                android:onClick="cancelButtonAction"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
