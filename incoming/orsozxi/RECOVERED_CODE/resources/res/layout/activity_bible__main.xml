<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/main.appbar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:collapsedTitleGravity="center"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="exitUntilCollapsed|scroll">
            <ImageView
                android:id="@+id/iv_banner"
                android:background="@drawable/thumb"
                android:visibility="gone"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"/>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/main.toolbar"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="parallax"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_header_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t_sanksar"
                    android:lines="1"/>
                <Button
                    android:id="@+id/btn_slide"
                    android:background="@drawable/ic_drawer"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_toLeftOf="@+id/btn_listen_bible"
                    android:layout_centerVertical="true"
                    android:contentDescription="موسيقى"
                    app:layout_collapseMode="parallax"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.hieupt.android.standalonescrollbar.view.NestedScrollView2
        android:id="@+id/v_nested"
        android:paddingBottom="64dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="right"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textColor="#ffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/radio_shawahed"
                    android:paddingRight="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/shawahed"
                    app:buttonTint="@color/colorAccent"/>
                <Button
                    android:enabled="true"
                    android:textColor="#000000"
                    android:id="@+id/btn_goto"
                    android:background="@drawable/button_enabled"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/t_new_bible_sig"
                    android:layout_toRightOf="@+id/btn_slide_left"/>
                <Spinner
                    android:id="@+id/sp_asks"
                    android:visibility="invisible"
                    android:clickable="false"
                    android:layout_width="2dp"
                    android:layout_height="2dp"
                    android:layout_alignParentLeft="true"/>
                <Spinner
                    android:id="@+id/sp_intro"
                    android:visibility="invisible"
                    android:clickable="false"
                    android:layout_width="2dp"
                    android:layout_height="2dp"
                    android:layout_alignParentRight="true"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:weightSum="4">
                <Spinner
                    android:textColor="#000000"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/spinner2"
                    android:background="@drawable/left_spinner"
                    android:paddingLeft="20dp"
                    android:paddingRight="5dp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1.5"
                    android:contentDescription="الأضحاحات"
                    android:textDirection="anyRtl"/>
                <Spinner
                    android:textColor="#ffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/spinner1"
                    android:background="@drawable/left_spinner"
                    android:paddingLeft="20dp"
                    android:paddingRight="5dp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="2.5"
                    android:contentDescription="الأسفار"
                    android:textDirection="anyRtl"/>
            </LinearLayout>
            <com.app.piapostolos.Views.NonScrollListView
                android:id="@+id/liss1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </LinearLayout>
    </com.hieupt.android.standalonescrollbar.view.NestedScrollView2>
    <com.hieupt.android.standalonescrollbar.StandaloneScrollBar
        android:id="@+id/scrollbar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.github.clans.fab.FloatingActionMenu
            android:id="@+id/menu_options"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:menu_animationDelayPerItem="0"
            app:menu_backgroundColor="#9033479f"
            app:menu_colorNormal="@color/colorAccent"
            app:menu_colorPressed="@color/colorPrimary"
            app:menu_colorRipple="@color/colorAccent"
            app:menu_icon="@drawable/ic_floating"
            app:menu_labels_colorNormal="@color/colorAccent"
            app:menu_labels_colorPressed="@color/colorPrimary"
            app:menu_labels_colorRipple="@color/colorAccent"
            app:menu_labels_ellipsize="end"
            app:menu_labels_singleLine="true"
            app:menu_labels_textSize="20sp">
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_search"
                app:fab_label="@string/fb_search"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_tafser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_tafser"
                app:fab_label="@string/fb_tafser"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_language"
                app:fab_label="@string/fb_english"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_save_last_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_save"
                app:fab_label="@string/fb_save_last"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_intro"
                app:fab_label="@string/fb_intro"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_ask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_ask"
                app:fab_label="@string/fb_ask"
                style="@style/MenuButtonsStyle"/>
        </com.github.clans.fab.FloatingActionMenu>
        <com.github.clans.fab.FloatingActionMenu
            android:id="@+id/menu_options2"
            android:paddingLeft="10dp"
            android:paddingRight="80dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:menu_animationDelayPerItem="0"
            app:menu_backgroundColor="#9033479f"
            app:menu_colorNormal="@color/colorAccent"
            app:menu_colorPressed="@color/colorPrimary"
            app:menu_colorRipple="@color/colorAccent"
            app:menu_icon="@drawable/ic_floating"
            app:menu_labels_colorNormal="@color/colorAccent"
            app:menu_labels_colorPressed="@color/colorPrimary"
            app:menu_labels_colorRipple="@color/colorAccent"
            app:menu_labels_ellipsize="end"
            app:menu_labels_singleLine="true"
            app:menu_labels_textSize="20sp">
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_fb_copy"
                app:fab_label="@string/fb_copy"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_highlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_highlight"
                app:fab_label="@string/fb_highlight"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_fb_share"
                app:fab_label="@string/fb_share"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_copy_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_fb_copy"
                app:fab_label="@string/fb_copy_all"
                style="@style/MenuButtonsStyle"/>
            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fb_show_colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_highlight"
                app:fab_label="@string/fb_show_colored"
                style="@style/MenuButtonsStyle"/>
        </com.github.clans.fab.FloatingActionMenu>
    </RelativeLayout>
    <Button
        android:layout_gravity="bottom|left"
        android:id="@+id/btn_play_music"
        android:background="@drawable/btn_play"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        android:contentDescription="موسيقى"/>
    <Button
        android:layout_gravity="bottom|left"
        android:id="@+id/btn_listen"
        android:background="@drawable/btn_playheader"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="74dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="أستمع"/>
    <include
        android:id="@+id/progress"
        android:visibility="gone"
        layout="@layout/v_progress"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
