<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/linearLayoutMusicList"
    android:background="@drawable/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/wv_radio"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linearLayoutPlayingSong"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/linearLayoutPlayingSong"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageViewAlbumArt"
                android:background="@drawable/radioooo"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="@dimen/small_image_art_width"
                android:layout_height="@dimen/small_image_art_width"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/colorAccent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/textNowPlaying"
                    android:paddingLeft="8dp"
                    android:paddingRight="84dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lines="2"
                    android:marqueeRepeatLimit="marquee_forever"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnPrevious"
                        android:background="@drawable/ic_action_previous"
                        android:visibility="gone"
                        android:layout_width="@dimen/small_button_width"
                        android:layout_height="@dimen/small_button_width"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnPlay"
                        android:background="@drawable/ic_action_play"
                        android:visibility="gone"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnPause"
                        android:background="@drawable/ic_action_pause"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnStop"
                        android:background="@drawable/ic_action_stop"
                        android:visibility="gone"
                        android:layout_width="@dimen/small_button_width"
                        android:layout_height="@dimen/small_button_width"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnNext"
                        android:background="@drawable/ic_action_next"
                        android:visibility="gone"
                        android:layout_width="@dimen/small_button_width"
                        android:layout_height="@dimen/small_button_width"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btnMusicPlayer"
                        android:background="@mipmap/ic_launcher"
                        android:visibility="gone"
                        android:layout_width="@dimen/small_button_width"
                        android:layout_height="@dimen/small_button_width"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp">
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/textBufferDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="@color/white"
                        android:layout_gravity="right"
                        android:id="@+id/textDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="1dp"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <com.github.clans.fab.FloatingActionMenu
        android:layout_gravity="bottom|right"
        android:id="@+id/menu_options"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:menu_animationDelayPerItem="0"
        app:menu_backgroundColor="#9033479f"
        app:menu_colorNormal="@color/colorAccent"
        app:menu_colorPressed="@color/colorPrimary"
        app:menu_colorRipple="@color/colorAccent"
        app:menu_icon="@drawable/ic_floating"
        app:menu_labels_colorNormal="@color/colorAccent"
        app:menu_labels_colorPressed="@color/colorPrimary"
        app:menu_labels_colorRipple="@color/colorAccent"
        app:menu_labels_ellipsize="end"
        app:menu_labels_singleLine="true"
        app:menu_labels_textSize="20sp">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_action_quality"
            app:fab_label="@string/fb_quality"
            style="@style/MenuButtonsStyle"/>
    </com.github.clans.fab.FloatingActionMenu>
    <ProgressBar
        android:id="@+id/animation_listener"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        style="?android:attr/progressBarStyleHorizontal"/>
</RelativeLayout>
