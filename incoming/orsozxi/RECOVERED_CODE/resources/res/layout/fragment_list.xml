<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:pixlui="http://schemas.android.com/apk/com.neopixl.pixlui" xmlns:wheel="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/activity_additional_margin"
    android:layout_marginRight="@dimen/activity_additional_margin">
    <it.piapostolos.android.pinotes.models.views.InterceptorLinearLayout
        android:orientation="vertical"
        android:id="@+id/list_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_layout"
            android:paddingLeft="@dimen/horizontal_margin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/horizontal_margin">
            <TextView
                android:textAppearance="@style/Text.Small"
                android:id="@+id/search_query"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/search_cancel"
                android:paddingTop="10dp"
                android:paddingRight="@dimen/horizontal_margin"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_cancel_black_18dp"
                android:paddingEnd="@dimen/horizontal_margin"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.nhaarman.listviewanimations.itemmanipulation.DynamicListView
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/scroll_bar"
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/list"
                android:paddingLeft="8dp"
                android:paddingTop="@dimen/padding_half"
                android:paddingRight="8dp"
                android:clipToPadding="false"
                android:animationCache="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@drawable/icon_selector"
                android:drawSelectorOnTop="true"
                android:scrollingCache="false"
                android:divider="@null"
                android:dividerHeight="8dp"
                android:fastScrollEnabled="true"
                android:smoothScrollbar="true"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.neopixl.pixlui.components.textview.TextView
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/empty_list"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_items_in_list"
                    android:drawableTop="@drawable/jingles_animation"
                    android:drawablePadding="10dp"
                    pixlui:typeface="Roboto-Regular.ttf"/>
            </LinearLayout>
            <com.pnikosis.materialishprogress.ProgressWheel
                android:layout_gravity="center"
                android:id="@+id/progress_wheel"
                android:layout_width="100dp"
                android:layout_height="100dp"
                wheel:matProg_barColor="@color/colorPrimary"
                wheel:matProg_progressIndeterminate="true"/>
        </FrameLayout>
    </it.piapostolos.android.pinotes.models.views.InterceptorLinearLayout>
    <include
        android:id="@+id/undobar"
        layout="@layout/undobar"/>
    <include
        android:id="@+id/fab"
        layout="@layout/fab"/>
    <ImageView
        android:id="@+id/expanded_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_gravity="bottom"
        android:id="@+id/snackbar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
</FrameLayout>
