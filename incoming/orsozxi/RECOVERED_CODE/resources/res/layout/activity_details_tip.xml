<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/app_header"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.05"
        android:layout_below="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:paddingBottom="64dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/imageView11"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_centerHorizontal="true"
                    app:civ_border_color="#df9d2a"
                    app:civ_border_width="3dp"/>
                <ImageView
                    android:id="@+id/iv_orso"
                    android:visibility="visible"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="-24dp"
                    android:src="@drawable/chathead"
                    android:layout_below="@+id/imageView11"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="23dp"
                android:textColor="#df9d2a"
                android:gravity="center"
                android:id="@+id/contentrow2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:textDirection="anyRtl"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="27dp"
                android:textStyle="bold"
                android:textColor="#92b64a"
                android:gravity="center"
                android:id="@+id/titlerow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Medium Text"
                android:textDirection="anyRtl"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/slidepanel_time_total"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00.00"
                    android:singleLine="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/slidepanel_time_progress"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00.00"
                    android:singleLine="true"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
            <com.app.piapostolos.Others.SliderAudio
                android:id="@+id/audio_progress_control"
                android:background="@color/md_black_1000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:max="100"
                app:min="0"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="120dp">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/btn_backward"
                    android:background="@drawable/bar_selector_white"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_rew_dark"
                    android:layout_weight="1"/>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.app.piapostolos.Others.PlayPauseView
                            android:id="@+id/btn_play"
                            android:clickable="true"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_centerInParent="true"
                            android:stateListAnimator="@drawable/button_elevation"
                            app:isCircleDraw="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/pgPlayPauseLayout"
                        android:visibility="invisible"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ProgressBar
                            android:id="@+id/pgPlayPause"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </RelativeLayout>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/btn_forward"
                    android:background="@drawable/bar_selector_white"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_fwd_dark"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="23dp"
                android:textColor="#df9d2a"
                android:gravity="center"
                android:id="@+id/TextView01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="TextView"
                android:textDirection="anyRtl"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="right"
                android:id="@+id/daterow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="TextView"
                android:textDirection="anyRtl"/>
        </LinearLayout>
    </ScrollView>
    <com.github.clans.fab.FloatingActionMenu
        android:layout_gravity="bottom|right"
        android:id="@+id/menu_options"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:menu_animationDelayPerItem="0"
        app:menu_backgroundColor="#9033479f"
        app:menu_colorNormal="@color/colorAccent"
        app:menu_colorPressed="@color/colorPrimary"
        app:menu_colorRipple="@color/colorAccent"
        app:menu_icon="@drawable/ic_floating"
        app:menu_labels_colorNormal="@color/colorAccent"
        app:menu_labels_colorPressed="@color/colorPrimary"
        app:menu_labels_colorRipple="@color/colorAccent"
        app:menu_labels_ellipsize="end"
        app:menu_labels_singleLine="true"
        app:menu_labels_textSize="20sp">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fb_copy"
            app:fab_label="@string/fb_copy"
            style="@style/MenuButtonsStyle"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fb_share"
            app:fab_label="@string/fb_share"
            style="@style/MenuButtonsStyle"/>
    </com.github.clans.fab.FloatingActionMenu>
</RelativeLayout>
