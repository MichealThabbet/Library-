<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp">
    <ImageView
        android:id="@+id/relative_title"
        android:background="@drawable/sub_mangalyaa"
        android:layout_width="wrap_content"
        android:layout_height="100dp"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/kolagy"
                android:background="@drawable/sub_man_kolagy_selector"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginRight="50dp"
                android:contentDescription="الخولاجى المقدس"/>
            <ImageView
                android:id="@+id/agpya"
                android:background="@drawable/sub_man_agpya_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="الأجبية"/>
            <ImageView
                android:id="@+id/katamras"
                android:background="@drawable/sub_man_katamars_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="القطمارس"/>
            <ImageView
                android:id="@+id/sanksar"
                android:background="@drawable/sub_man_sanksar_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="السنكسار"/>
            <ImageView
                android:id="@+id/psalmody_sanawy"
                android:background="@drawable/sub_psamlmody_sanwy_selector"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="الإبصلمودية السنوية"/>
            <ImageView
                android:id="@+id/psalmody"
                android:background="@drawable/sub_psalomdy_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription=" الإبصلمودية الكيهكية"/>
            <ImageView
                android:id="@+id/dallal"
                android:background="@drawable/sub_man_dallal_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="أسبوع الآلام"/>
            <ImageView
                android:id="@+id/kandil"
                android:background="@drawable/sub_kandil_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="صلاة مسحة المرضى"/>
            <ImageView
                android:id="@+id/lakan"
                android:background="@drawable/sub_lakan_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="صلاة اللقان المقدس"/>
            <ImageView
                android:id="@+id/sagda"
                android:background="@drawable/sub_sagda_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="صلاة السجدة المقدسة"/>
            <ImageView
                android:id="@+id/kism"
                android:background="@drawable/sub_kism_selector"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="-3dp"
                android:layout_marginTop="-14dp"
                android:layout_marginRight="50dp"
                android:contentDescription="صلوات القسم"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
