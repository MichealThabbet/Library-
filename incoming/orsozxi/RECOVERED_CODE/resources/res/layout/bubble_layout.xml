<?xml version="1.0" encoding="utf-8"?>
<com.app.piapostolos.Alarm.Bubbles.BubbleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/chathead"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:layout_gravity="right"
        android:id="@+id/tv_counter"
        android:background="@drawable/bubble_counter_bkg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="10dp"
        android:text="1"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:background="@drawable/bubble_rounded"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="54dp"
        android:layout_marginRight="5dp"
        android:minHeight="200dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tv_message"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"
                android:text=""/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/btn_share"
                android:background="@drawable/ic_share_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"/>
        </LinearLayout>
    </ScrollView>
</com.app.piapostolos.Alarm.Bubbles.BubbleLayout>
