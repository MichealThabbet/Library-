<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img12"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginLeft="8dp"
        android:layout_alignParentRight="true"
        app:civ_border_color="#df9d2a"
        app:civ_border_width="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/img12"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="#92b64a"
            android:gravity="right"
            android:id="@+id/site_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/img12"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:textDirection="anyRtl"/>
        <TextView
            android:textColor="#df9d2a"
            android:gravity="right"
            android:id="@+id/desc10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/img12"
            android:layout_below="@+id/site_title"
            android:layout_alignLeft="@+id/site_title"
            android:layout_alignParentLeft="true"
            android:textDirection="anyRtl"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="right"
            android:id="@+id/datee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/img12"
            android:layout_below="@+id/desc10"
            android:layout_alignLeft="@+id/site_title"
            android:layout_alignParentLeft="true"
            android:textDirection="anyRtl"/>
    </LinearLayout>
</RelativeLayout>
