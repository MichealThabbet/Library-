<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/button_black"
    android:padding="10dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="أختر التاريخ القبطى"
            android:textDirection="rtl"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="4">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="سنة"
                android:layout_weight="1"
                android:textDirection="rtl"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="يوم"
                android:layout_weight="1"
                android:textDirection="rtl"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="شهر"
                android:layout_weight="2"
                android:textDirection="rtl"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:weightSum="4">
            <EditText
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/ed_coptic_year"
                android:background="@drawable/button_black_edittext"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:text="1734"
                android:numeric="integer"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/sp_coptic_day"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/sp_coptic_month"
                android:background="@drawable/left_spinner"
                android:paddingLeft="20dp"
                android:paddingRight="5dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp">
            <Button
                android:textSize="20dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_Send"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="موافق"
                android:onClick="saveButtonAction"/>
            <Button
                android:textSize="20dp"
                android:textColor="#ffffff"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="إلغاء"
                android:onClick="cancelButtonAction"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
