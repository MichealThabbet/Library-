<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/app_header"/>
    <ScrollView
        android:id="@+id/scrollView1"
        android:paddingBottom="64dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="22dp"
                android:textColor="#92b64a"
                android:gravity="right"
                android:id="@+id/titlerow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="Medium Text"
                android:textDirection="anyRtl"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#df9d2a"
                android:gravity="right"
                android:id="@+id/contentrow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="TextView"
                android:textDirection="anyRtl"/>
            <TextView
                android:textSize="23dp"
                android:textColor="#df9d2a"
                android:gravity="right"
                android:id="@+id/TextView01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="TextView"
                android:textDirection="anyRtl"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="right"
                android:id="@+id/daterow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="TextView"
                android:layout_weight="0.64"
                android:textDirection="anyRtl"/>
        </LinearLayout>
    </ScrollView>
    <com.github.clans.fab.FloatingActionMenu
        android:layout_gravity="bottom|right"
        android:id="@+id/menu_options"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:menu_animationDelayPerItem="0"
        app:menu_backgroundColor="#9033479f"
        app:menu_colorNormal="@color/colorAccent"
        app:menu_colorPressed="@color/colorPrimary"
        app:menu_colorRipple="@color/colorAccent"
        app:menu_icon="@drawable/ic_floating"
        app:menu_labels_colorNormal="@color/colorAccent"
        app:menu_labels_colorPressed="@color/colorPrimary"
        app:menu_labels_colorRipple="@color/colorAccent"
        app:menu_labels_ellipsize="end"
        app:menu_labels_singleLine="true"
        app:menu_labels_textSize="20sp">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fb_copy"
            app:fab_label="@string/fb_copy"
            style="@style/MenuButtonsStyle"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/fb_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fb_share"
            app:fab_label="@string/fb_share"
            style="@style/MenuButtonsStyle"/>
    </com.github.clans.fab.FloatingActionMenu>
</RelativeLayout>
