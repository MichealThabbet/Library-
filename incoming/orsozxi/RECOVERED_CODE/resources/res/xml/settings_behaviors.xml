<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:fitsSystemWindows="true">
    <SwitchPreference
        android:title="@string/settings_instant_search"
        android:key="settings_instant_search"
        android:defaultValue="false"
        app:iconSpaceReserved="false"/>
    <SwitchPreference
        android:title="@string/settings_enable_swipe"
        android:key="settings_enable_swipe"
        android:summary="@string/settings_enable_swipe_summary"
        android:defaultValue="true"
        app:iconSpaceReserved="false"/>
    <SwitchPreference
        android:title="@string/settings_swipe_to_trash"
        android:key="settings_swipe_to_trash"
        android:dependency="settings_enable_swipe"
        android:defaultValue="false"
        app:iconSpaceReserved="false"/>
    <EditTextPreference
        android:title="@string/settings_max_video_size"
        android:key="settings_max_video_size"
        android:summary="@string/settings_max_video_size_summary"
        android:inputType="number"
        app:iconSpaceReserved="false"/>
</PreferenceScreen>
