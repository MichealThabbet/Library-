{
    "chapter_num": 15,
    "verses_count": 29,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Ark Brought to Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David built houses for himself in the city of David; and he prepared a place for the ark of God, and pitched a tent for it. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then David said, “No one but the Levites may carry the ark of God, for the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " chose them to carry the ark of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " and to minister to him for ever.” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David assembled all Israel at Jerusalem, to bring up the ark of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to its place, which he had prepared for it. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David gathered together the sons of Aaron and the Levites: "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Kohath, U′riel the chief, with a hundred and twenty of his brethren; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Merar′i, Asai′ah the chief, with two hundred and twenty of his brethren; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Gershom, Jo′el the chief, with a hundred and thirty of his brethren; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Eli-za′phan, Shemai′ah the chief, with two hundred of his brethren; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Hebron, Eli′el the chief, with eighty of his brethren; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of the sons of Uz′ziel, Ammin′adab the chief, with a hundred and twelve of his brethren. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then David summoned the priests Zadok and Abi′athar, and the Levites U′riel, Asai′ah, Jo′el, Shemai′ah, Eli′el, and Ammin′adab, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said to them, “You are the heads of the fathers’ houses of the Levites; sanctify yourselves, you and your brethren, so that you may bring up the ark of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the God of Israel, to the place that I have prepared for it. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because you did not carry it the first time,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The meaning of the Hebrew word is uncertain"
                        },
                        {
                            "style": "NONE",
                            "text": " the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God broke forth upon us, because we did not care for it in the way that is ordained.” "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the priests and the Levites sanctified themselves to bring up the ark of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the God of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Levites carried the ark of God upon their shoulders with the poles, as Moses had commanded according to the word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David also commanded the chiefs of the Levites to appoint their brethren as the singers who should play loudly on musical instruments, on harps and lyres and cymbals, to raise sounds of joy. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the Levites appointed Heman the son of Jo′el; and of his brethren Asaph the son of Berechi′ah; and of the sons of Merar′i, their brethren, Ethan the son of Kusha′iah; "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and with them their brethren of the second order, Zechari′ah, Ja-a′ziel, Shemi′ramoth, Jehi′el, Unni, Eli′ab, Benai′ah, Ma-asei′ah, Mattithi′ah, Eliph′elehu, and Mikne′iah, and the gatekeepers O′bed-e′dom and Je-i′el. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The singers, Heman, Asaph, and Ethan, were to sound bronze cymbals; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zechari′ah, A′zi-el, Shemi′ramoth, Jehi′el, Unni, Eli′ab, Ma-asei′ah, and Benai′ah were to play harps according to Al′amoth; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but Mattithi′ah, Eliph′elehu, Mikne′iah, O′bed-e′dom, Je-i′el, and Azazi′ah were to lead with lyres according to the Shem′inith. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Chenani′ah, leader of the Levites in music, should direct the music, for he understood it. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Berechi′ah and Elka′nah were to be gatekeepers for the ark. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shebani′ah, Josh′aphat, Nethan′el, Ama′sai, Zechari′ah, Benai′ah, and Elie′zer, the priests, should blow the trumpets before the ark of God. O′bed-e′dom and Jehi′ah also were to be gatekeepers for the ark."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So David and the elders of Israel, and the commanders of thousands, went to bring up the ark of the covenant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " from the house of O′bed-e′dom with rejoicing. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And because God helped the Levites who were carrying the ark of the covenant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", they sacrificed seven bulls and seven rams. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David was clothed with a robe of fine linen, as also were all the Levites who were carrying the ark, and the singers, and Chenani′ah the leader of the music of the singers; and David wore a linen ephod. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all Israel brought up the ark of the covenant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " with shouting, to the sound of the horn, trumpets, and cymbals, and made loud music on harps and lyres."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And as the ark of the covenant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to the city of David, Michal the daughter of Saul looked out of the window, and saw King David dancing and making merry; and she despised him in her heart."
                        }
                    ]
                }
            ]
        }
    ]
}