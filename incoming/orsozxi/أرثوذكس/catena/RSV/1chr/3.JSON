    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Descendants of David and Solomon"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the sons of David that were born to him in Hebron: the first-born Amnon, by Ahin′o-am the Jez′reelitess; the second Daniel, by Ab′igail the Car′melitess, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the third Ab′salom, whose mother was Ma′acah, the daughter of Talmai, king of Geshur; the fourth Adoni′jah, whose mother was Haggith; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the fifth Shephati′ah, by Abi′tal; the sixth Ith′re-am, by his wife Eglah; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "six were born to him in Hebron, where he reigned for seven years and six months. And he reigned thirty-three years in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These were born to him in Jerusalem: Shim′e-a, Shobab, Nathan, and Solomon, four by Bath-shu′a, the daughter of Am′miel; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then Ibhar, Elish′ama, Eliph′elet, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nogah, Nepheg, Japhi′a, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elish′ama, Eli′ada, and Eliph′elet, nine. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these were David’s sons, besides the sons of the concubines; and Tamar was their sister."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The descendants of Solomon: Rehobo′am, Abi′jah his son, Asa his son, Jehosh′aphat his son, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joram his son, Ahazi′ah his son, Jo′ash his son, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Amazi′ah his son, Azari′ah his son, Jotham his son, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahaz his son, Hezeki′ah his son, Manas′seh his son, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Amon his son, Josi′ah his son. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Josi′ah: Joha′nan the first-born, the second Jehoi′akim, the third Zedeki′ah, the fourth Shallum. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The descendants of Jehoi′akim: Jeconi′ah his son, Zedeki′ah his son; "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the sons of Jeconi′ah, the captive: She-al′ti-el his son, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Malchi′ram, Peda′iah, Shenaz′zar, Jekami′ah, Hosh′ama, and Nedabi′ah; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the sons of Peda′iah: Zerub′babel and Shim′e-i; and the sons of Zerub′babel: Meshul′lam and Hanani′ah, and Shelo′mith was their sister; "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Hashu′bah, Ohel, Berechi′ah, Hasadi′ah, and Ju′shab-he′sed, five. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Hanani′ah: Pelati′ah and Jeshai′ah, his son"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Compare Syr Vg: Heb sons of"
                        },
                        {
                            "style": "NONE",
                            "text": " Repha′iah, his son"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Compare Syr Vg: Heb sons of"
                        },
                        {
                            "style": "NONE",
                            "text": " Arnan, his son"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Compare Syr Vg: Heb sons of"
                        },
                        {
                            "style": "NONE",
                            "text": " Obadi′ah, his son"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Compare Syr Vg: Heb sons of"
                        },
                        {
                            "style": "NONE",
                            "text": " Shecani′ah. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Shecani′ah: Shemai′ah. And the sons of Shemai′ah: Hattush, Igal, Bari′ah, Ne-ari′ah, and Shaphat, six. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ne-ari′ah: Eli-o-e′nai, Hizki′ah, and Azri′kam, three. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Eli-o-e′nai: Hodavi′ah, Eli′ashib, Pela′iah, Akkub, Joha′nan, Delai′ah, and Ana′ni, seven."
                        }
                    ]
                }
            ]
