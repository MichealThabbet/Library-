{
    "chapter_num": 1,
    "verses_count": 54,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "From Adam to Abraham"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Adam, Seth, Enosh; "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kenan, Mahal′alel, Jared; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Enoch, Methu′selah, Lamech; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Noah, Shem, Ham, and Japheth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Japheth: Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Gomer: Ash′kenaz, Diphath, and Togar′mah. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Javan: Eli′shah, Tarshish, Kittim, and Ro′danim."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ham: Cush, Egypt, Put, and Canaan. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Cush: Seba, Hav′ilah, Sabta, Ra′ama, and Sab′teca. The sons of Ra′amah: Sheba and Dedan. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Cush was the father of Nimrod; he began to be a mighty one in the earth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Egypt was the father of Ludim, An′amim, Leha′bim, Naph-tu′him, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Pathru′sim, Caslu′him (whence came the Philistines), and Caph′torim."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Canaan was the father of Sidon his first-born, and Heth, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Jeb′usites, the Amorites, the Gir′gashites, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the Hivites, the Arkites, the Sinites, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the Ar′vadites, the Zem′arites, and the Ha′mathites."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Shem: Elam, Asshur, Arpach′shad, Lud, Aram, Uz, Hul, Gether, and Meshech. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Arpach′shad was the father of Shelah; and Shelah was the father of Eber. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To Eber were born two sons: the name of the one was Peleg (for in his days the earth was divided), and the name of his brother Joktan. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Joktan was the father of Almo′dad, Sheleph, Hazarma′veth, Jerah, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hador′am, Uzal, Diklah, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ebal, Abim′a-el, Sheba, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ophir, Hav′ilah, and Jobab; all these were the sons of Joktan."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shem, Arpach′shad, Shelah; "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eber, Peleg, Re′u; "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Serug, Nahor, Terah; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abram, that is, Abraham."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "From Abraham to Jacob"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Abraham: Isaac and Ish′mael. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are their genealogies: the first-born of Ish′mael, Neba′ioth; and Kedar, Adbeel, Mibsam, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Mishma, Dumah, Massa, Hadad, Tema, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jetur, Naphish, and Ked′emah. These are the sons of Ish′mael. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ketu′rah, Abraham’s concubine: she bore Zimran, Jokshan, Medan, Mid′ian, Ishbak, and Shuah. The sons of Jokshan: Sheba and Dedan. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Mid′ian: Ephah, Epher, Hanoch, Abi′da, and Elda′ah. All these were the descendants of Ketu′rah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abraham was the father of Isaac. The sons of Isaac: Esau and Israel. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Esau: Eli′phaz, Reu′el, Je′ush, Jalam, and Korah. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Eli′phaz: Teman, Omar, Zephi, Gatam, Kenaz, Timna, and Am′alek. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Reu′el: Nahath, Zerah, Shammah, and Mizzah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Se′ir: Lotan, Shobal, Zib′eon, Anah, Dishon, Ezer, and Dishan. "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Lotan: Hori and Homam; and Lotan’s sister was Timna. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Shobal: Al′ian, Man′ahath, Ebal, Shephi, and Onam. The sons of Zib′eon: A′iah and Anah. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Anah: Dishon. The sons of Dishon: Hamran, Eshban, Ithran, and Cheran. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Ezer: Bilhan, Za′avan, and Ja′akan. The sons of Dishan: Uz and Aran."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the kings who reigned in the land of Edom before any king reigned over the Israelites: Bela the son of Be′or, the name of whose city was Din′habah. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Bela died, Jobab the son of Zerah of Bozrah reigned in his stead. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Jobab died, Husham of the land of the Te′manites reigned in his stead. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Husham died, Hadad the son of Bedad, who defeated Mid′ian in the country of Moab, reigned in his stead; and the name of his city was Avith. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Hadad died, Samlah of Masre′kah reigned in his stead. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Samlah died, Shaul of Reho′both on the Euphra′tes reigned in his stead. "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Shaul died, Ba′al-ha′nan, the son of Achbor, reigned in his stead. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When Ba′al-ha′nan died, Hadad reigned in his stead; and the name of his city was Pa′i, and his wife’s name Mehet′abel the daughter of Matred, the daughter of Me′zahab. "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hadad died."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The chiefs of Edom were: chiefs Timna, Al′iah, Jetheth, "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Oholiba′mah, Elah, Pinon, "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Kenaz, Teman, Mibzar, "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Mag′diel, and Iram; these are the chiefs of Edom."
                        }
                    ]
                }
            ]
        }
    ]
}