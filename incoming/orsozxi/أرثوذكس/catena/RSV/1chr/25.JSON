    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Temple Musicians"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David and the chiefs of the service also set apart for the service certain of the sons of Asaph, and of Heman, and of Jedu′thun, who should prophesy with lyres, with harps, and with cymbals. The list of those who did the work and of their duties was: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the sons of Asaph: Zaccur, Joseph, Nethani′ah, and Ashare′lah, sons of Asaph, under the direction of Asaph, who prophesied under the direction of the king. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of Jedu′thun, the sons of Jedu′thun: Gedali′ah, Zeri, Jeshai′ah, Shim′e-i,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "One Ms: Gk: Heb lacks Shimei"
                        },
                        {
                            "style": "NONE",
                            "text": " Hashabi′ah, and Mattithi′ah, six, under the direction of their father Jedu′thun, who prophesied with the lyre in thanksgiving and praise to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of Heman, the sons of Heman: Bukki′ah, Mattani′ah, Uz′ziel, Shebu′el, and Jer′imoth, Hanani′ah, Hana′ni, Eli′athah, Giddal′ti, and Romam′ti-e′zer, Joshbekash′ah, Mallo′thi, Hothir, Maha′zi-oth. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All these were the sons of Heman the king’s seer, according to the promise of God to exalt him; for God had given Heman fourteen sons and three daughters. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They were all under the direction of their father in the music in the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " with cymbals, harps, and lyres for the service of the house of God. Asaph, Jedu′thun, and Heman were under the order of the king. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The number of them along with their brethren, who were trained in singing to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", all who were skilful, was two hundred and eighty-eight. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they cast lots for their duties, small and great, teacher and pupil alike."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
