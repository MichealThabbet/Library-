    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Descendants of Levi"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 5.27 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": " The sons of Levi: Gershom, Kohath, and Merar′i. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Kohath: Amram, Izhar, Hebron, and Uz′ziel. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The children of Amram: Aaron, Moses, and Miriam. The sons of Aaron: Nadab, Abi′hu, Elea′zar, and Ith′amar. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elea′zar was the father of Phin′ehas, Phin′ehas of Abishu′a, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Abishu′a of Bukki, Bukki of Uzzi, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Uzzi of Zerahi′ah, Zerahi′ah of Merai′oth, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Merai′oth of Amari′ah, Amari′ah of Ahi′tub, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahi′tub of Zadok, Zadok of Ahim′a-az, "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahim′a-az of Azari′ah, Azari′ah of Joha′nan, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Joha′nan of Azari′ah (it was he who served as priest in the house that Solomon built in Jerusalem). "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Azari′ah was the father of Amari′ah, Amari′ah of Ahi′tub, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ahi′tub of Zadok, Zadok of Shallum, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shallum of Hilki′ah, Hilki′ah of Azari′ah, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Azari′ah of Serai′ah, Serai′ah of Jehoz′adak; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Jehoz′adak went into exile when the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " sent Judah and Jerusalem into exile by the hand of Nebuchadnez′zar."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 6.1 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": " The sons of Levi: Gershom, Kohath, and Merar′i. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these are the names of the sons of Gershom: Libni and Shim′e-i. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Kohath: Amram, Izhar, Hebron, and Uz′ziel. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Merar′i: Mahli and Mushi. These are the families of the Levites according to their fathers. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of Gershom: Libni his son, Jahath his son, Zimmah his son, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jo′ah his son, Iddo his son, Zerah his son, Je-ath′erai his son. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Kohath: Ammin′adab his son, Korah his son, Assir his son, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elka′nah his son, Ebi′asaph his son, Assir his son, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Tahath his son, U′riel his son, Uzzi′ah his son, and Shaul his son. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Elka′nah: Ama′sai and Ahi′moth, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elka′nah his son, Zophai his son, Nahath his son, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Eli′ab his son, Jero′ham his son, Elka′nah his son. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Samuel: Jo′el"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Syr Compare verse 33 and 1 Sam 8.2: Heb lacks Joel"
                        },
                        {
                            "style": "NONE",
                            "text": " his first-born, the second Abi′jah."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb and Abijah"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sons of Merar′i: Mahli, Libni his son, Shim′e-i his son, Uzzah his son, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Shim′e-a his son, Haggi′ah his son, and Asai′ah his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Musicians Appointed by David"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the men whom David put in charge of the service of song in the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", after the ark rested there. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They ministered with song before the tabernacle of the tent of meeting, until Solomon had built the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " in Jerusalem; and they performed their service in due order. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the men who served and their sons. Of the sons of the Ko′hathites: Heman the singer the son of Jo′el, son of Samuel, "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Elka′nah, son of Jero′ham, son of Eli′el, son of To′ah, "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Zuph, son of Elka′nah, son of Mahath, son of Ama′sai, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Elka′nah, son of Jo′el, son of Azari′ah, son of Zephani′ah, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Tahath, son of Assir, son of Ebi′asaph, son of Korah, "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Izhar, son of Kohath, son of Levi, son of Israel; "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and his brother Asaph, who stood on his right hand, namely, Asaph the son of Berechi′ah, son of Shim′e-a, "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Michael, son of Ba-ase′iah, son of Malchi′jah, "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Ethni, son of Zerah, son of Adai′ah, "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Ethan, son of Zimmah, son of Shim′e-i, "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Jahath, son of Gershom, son of Levi. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the left hand were their brethren the sons of Merar′i: Ethan the son of Kishi, son of Abdi, son of Malluch, "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Hashabi′ah, son of Amazi′ah, son of Hilki′ah, "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Amzi, son of Bani, son of Shemer, "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "son of Mahli, son of Mushi, son of Merar′i, son of Levi; "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and their brethren the Levites were appointed for all the service of the tabernacle of the house of God."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Aaron and his sons made offerings upon the altar of burnt offering and upon the altar of incense for all the work of the most holy place, and to make atonement for Israel, according to all that Moses the servant of God had commanded. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the sons of Aaron: Elea′zar his son, Phin′ehas his son, Abishu′a his son, "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bukki his son, Uzzi his son, Zerahi′ah his son, "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Merai′oth his son, Amari′ah his son, Ahi′tub his son, "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Zadok his son, Ahim′a-az his son."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Settlements of the Levites"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are their dwelling places according to their settlements within their borders: to the sons of Aaron of the families of Ko′hathites, for theirs was the lot, "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to them they gave Hebron in the land of Judah and its surrounding pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but the fields of the city and its villages they gave to Caleb the son of Jephun′neh. "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the sons of Aaron they gave the cities of refuge: Hebron, Libnah with its pasture lands, Jattir, Eshtemo′a with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hilen with its pasture lands, Debir with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 59,
                    "num_str": "59",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ashan with its pasture lands, and Beth-she′mesh with its pasture lands; "
                        }
                    ]
                },
                {
                    "num_int": 60,
                    "num_str": "60",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and from the tribe of Benjamin, Geba with its pasture lands, Al′emeth with its pasture lands, and An′athoth with its pasture lands. All their cities throughout their families were thirteen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 61,
                    "num_str": "61",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the rest of the Ko′hathites were given by lot out of the family of the tribe, out of the half-tribe, the half of Manas′seh, ten cities. "
                        }
                    ]
                },
                {
                    "num_int": 62,
                    "num_str": "62",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the Gershomites according to their families were allotted thirteen cities out of the tribes of Is′sachar, Asher, Naph′tali, and Manas′seh in Bashan. "
                        }
                    ]
                },
                {
                    "num_int": 63,
                    "num_str": "63",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the Merar′ites according to their families were allotted twelve cities out of the tribes of Reuben, Gad, and Zeb′ulun. "
                        }
                    ]
                },
                {
                    "num_int": 64,
                    "num_str": "64",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the people of Israel gave the Levites the cities with their pasture lands. "
                        }
                    ]
                },
                {
                    "num_int": 65,
                    "num_str": "65",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They also gave them by lot out of the tribes of Judah, Simeon, and Benjamin these cities which are mentioned by name."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 66,
                    "num_str": "66",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And some of the families of the sons of Kohath had cities of their territory out of the tribe of E′phraim. "
                        }
                    ]
                },
                {
                    "num_int": 67,
                    "num_str": "67",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They were given the cities of refuge: Shechem with its pasture lands in the hill country of E′phraim, Gezer with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 68,
                    "num_str": "68",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jok′me-am with its pasture lands, Beth-hor′on with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 69,
                    "num_str": "69",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ai′jalon with its pasture lands, Gath-rim′mon with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 70,
                    "num_str": "70",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and out of the half-tribe of Manas′seh, Aner with its pasture lands, and Bil′e-am with its pasture lands, for the rest of the families of the Ko′hathites."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 71,
                    "num_str": "71",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the Gershomites were given out of the half-tribe of Manas′seh: Golan in Bashan with its pasture lands and Ash′taroth with its pasture lands; "
                        }
                    ]
                },
                {
                    "num_int": 72,
                    "num_str": "72",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and out of the tribe of Is′sachar: Kedesh with its pasture lands, Dab′erath with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 73,
                    "num_str": "73",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ramoth with its pasture lands, and Anem with its pasture lands; "
                        }
                    ]
                },
                {
                    "num_int": 74,
                    "num_str": "74",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "out of the tribe of Asher: Mashal with its pasture lands, Abdon with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 75,
                    "num_str": "75",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Hukok with its pasture lands, and Rehob with its pasture lands; "
                        }
                    ]
                },
                {
                    "num_int": 76,
                    "num_str": "76",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and out of the tribe of Naph′tali: Kedesh in Galilee with its pasture lands, Ham′mon with its pasture lands, and Kiriatha′im with its pasture lands. "
                        }
                    ]
                },
                {
                    "num_int": 77,
                    "num_str": "77",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the rest of the Merar′ites were allotted out of the tribe of Zeb′ulun: Rim′mono with its pasture lands, Tabor with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 78,
                    "num_str": "78",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and beyond the Jordan at Jericho, on the east side of the Jordan, out of the tribe of Reuben: Bezer in the steppe with its pasture lands, Jahzah with its pasture lands, "
                        }
                    ]
                },
                {
                    "num_int": 79,
                    "num_str": "79",
