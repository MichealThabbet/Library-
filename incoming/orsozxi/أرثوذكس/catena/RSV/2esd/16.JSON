{
    "chapter_num": 16,
    "verses_count": 78,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Further Denunciations"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Woe to you, Babylon and Asia! Woe to you, Egypt and Syria! "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Gird yourselves with sackcloth and haircloth, and wail for your children, and lament for them; for your destruction is at hand. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The sword has been sent upon you, and who is there to turn it back? "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "A fire has been sent upon you, and who is there to quench it? "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Calamities have been sent upon you, and who is there to drive them away? "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Can one drive off a hungry lion in the forest, or quench a fire in the stubble, when once it has begun to burn? "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Can one turn back an arrow shot by a strong archer? "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Lord God sends calamities, and who will drive them away? "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Fire will go forth from his wrath, and who is there to quench it? "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He will flash lightning, and who will not be afraid? He will thunder, and who will not be terrified? "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Lord will threaten, and who will not be utterly shattered at his presence? "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The earth and its foundations quake, the sea is churned up from the depths, and its waves and the fish also shall be troubled at the presence of the Lord and before the glory of his power. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For his right hand that bends the bow is strong, and his arrows that he shoots are sharp and will not miss when they begin to be shot to the ends of the world. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, calamities are sent forth and shall not return until they come over the earth. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The fire is kindled, and shall not be put out until it consumes the foundations of the earth. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Just as an arrow shot by a mighty archer does not return, so the calamities that are sent upon the earth shall not return. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Alas for me! Alas for me! Who will deliver me in those days?"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Horror of the Last Days"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The beginning of sorrows, when there shall be much lamentation; the beginning of famine, when many shall perish; the beginning of wars, when the powers shall be terrified; the beginning of calamities, when all shall tremble. What shall they do in these circumstances, when the calamities come? "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, famine and plague, tribulation and anguish are sent as scourges for the correction of men. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet for all this they will not turn from their iniquities, nor be always mindful of the scourges. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, provision will be so cheap upon earth that men will imagine that peace is assured for them, and then the calamities shall spring up on the earth—the sword, famine, and great confusion. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For many of those who live on the earth shall perish by famine; and those who survive the famine shall die by the sword. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the dead shall be cast out like dung, and there shall be no one to console them; for the earth shall be left desolate, and its cities shall be demolished. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No one shall be left to cultivate the earth or to sow it. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The trees shall bear fruit, and who will gather it? "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The grapes shall ripen, and who will tread them? For in all places there shall be great solitude; "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one man will long to see another, or even to hear his voice. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For out of a city, ten shall be left; and out of the field, two who have hidden themselves in thick groves and clefts in the rocks. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As in an olive orchard three or four olives may be left on every tree, "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "or as when a vineyard is gathered some clusters may be left by those who search carefully through the vineyard, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so in those days three or four shall be left by those who search their houses with the sword. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the earth shall be left desolate, and its fields shall be for briers, and its roads and all its paths shall bring forth thorns, because no sheep will go along them. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Virgins shall mourn because they have no bridegrooms; women shall mourn because they have no husbands; their daughters shall mourn, because they have no helpers. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their bridegrooms shall be killed in war, and their husbands shall perish of famine."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "God’s People Must Prepare for the End"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Listen now to these things, and understand them, O servants of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold the word of the Lord, receive it; do not disbelieve what the Lord says."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Cn: Lat do not believe the gods of whom the Lord speaks"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, the calamities draw near, and are not delayed. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Just as a woman with child, in the ninth month, when the time of her delivery draws near, has great pains about her womb for two or three hours beforehand, and when the child comes forth from the womb, there will not be a moment’s delay, "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so the calamities will not delay in coming forth upon the earth, and the world will groan, and pains will seize it on every side."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Hear my words, O my people; prepare for battle, and in the midst of the calamities be like strangers on the earth. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let him that sells be like one who will flee; let him that buys be like one who will lose; "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "let him that does business be like one who will not make a profit; and let him that builds a house be like one who will not live in it; "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "let him that sows be like one who will not reap; so also him that prunes the vines, like one who will not gather the grapes; "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "them that marry, like those who will have no children; and them that do not marry, like those who are widowed. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because those who labor, labor in vain; "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for strangers shall gather their fruits, and plunder their goods, and overthrow their houses, and take their children captive; for in captivity and famine they will beget their children. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Those who conduct business, do it only to be plundered; the more they adorn their cities, their houses and possessions, and their persons, "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the more angry I will be with them for their sins,” says the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Just as a respectable and virtuous woman abhors a harlot, "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "so righteousness shall abhor iniquity, when she decks herself out, and shall accuse her to her face, when he comes who will defend him who searches out every sin on earth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Power and Wisdom of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore do not be like her or her works. "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For behold, just a little while, and iniquity will be removed from the earth, and righteousness will reign over us. "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Let no sinner say that he has not sinned; for God"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Literally he"
                        },
                        {
                            "style": "NONE",
                            "text": " will burn coals of fire on the head of him who says, “I have not sinned before God and his glory.” "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, the Lord knows all the works of men, their imaginations and their thoughts and their hearts. "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He said, “Let the earth be made,” and it was made; “Let the heaven be made,” and it was made. "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At his word the stars were fixed, and he knows the number of the stars. "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It is he who searches the deep and its treasures, who has measured the sea and its contents; "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who has enclosed the sea in the midst of the waters, and by his word has suspended the earth over the water; "
                        }
                    ]
                },
                {
                    "num_int": 59,
                    "num_str": "59",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who has spread out the heaven like an arch, and founded it upon the waters; "
                        }
                    ]
                },
                {
                    "num_int": 60,
                    "num_str": "60",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who has put springs of water in the desert, and pools on the tops of the mountains, to send rivers from the heights to water the earth; "
                        }
                    ]
                },
                {
                    "num_int": 61,
                    "num_str": "61",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "who formed man, and put a heart in the midst of his body, and gave him breath and life and understanding "
                        }
                    ]
                },
                {
                    "num_int": 62,
                    "num_str": "62",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the spirit of Almighty God; who made all things and searches out hidden things in hidden places. "
                        }
                    ]
                },
                {
                    "num_int": 63,
                    "num_str": "63",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Surely he knows your imaginations and what you think in your hearts! Woe to those who sin and want to hide their sins! "
                        }
                    ]
                },
                {
                    "num_int": 64,
                    "num_str": "64",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Because the Lord will strictly examine all their works, and will make a public spectacle of all of you. "
                        }
                    ]
                },
                {
                    "num_int": 65,
                    "num_str": "65",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when your sins come out before men, you shall be put to shame; and your own iniquities shall stand as your accusers in that day. "
                        }
                    ]
                },
                {
                    "num_int": 66,
                    "num_str": "66",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "What will you do? Or how will you hide your sins before God and his angels? "
                        }
                    ]
                },
                {
                    "num_int": 67,
                    "num_str": "67",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, God is the judge, fear him! Cease from your sins, and forget your iniquities, never to commit them again; so God will lead you forth and deliver you from all tribulation."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Impending Persecution of God’s People"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 68,
                    "num_str": "68",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For behold, the burning wrath of a great multitude is kindled over you, and they shall carry off some of you and shall feed you what was sacrificed to idols. "
                        }
                    ]
                },
                {
                    "num_int": 69,
                    "num_str": "69",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those who consent to eat shall be held in"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Literally consent to them shall be for these in"
                        },
                        {
                            "style": "NONE",
                            "text": " derision and contempt, and be trodden under foot. "
                        }
                    ]
                },
                {
                    "num_int": 70,
                    "num_str": "70",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in many places"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The Latin is uncertain"
                        },
                        {
                            "style": "NONE",
                            "text": " and in neighboring cities there shall be a great insurrection against those who fear the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 71,
                    "num_str": "71",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall be like mad men, sparing no one, but plundering and destroying those who continue to fear the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 72,
                    "num_str": "72",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For they shall destroy and plunder their goods, and drive them out of their houses. "
                        }
                    ]
                },
                {
                    "num_int": 73,
                    "num_str": "73",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the tested quality of my elect shall be manifest, as gold that is tested by fire."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Promise of Divine Deliverance"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 74,
                    "num_str": "74",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Hear, my elect,” says the Lord. “Behold, the days of tribulation are at hand, and I will deliver you from them. "
                        }
                    ]
                },
                {
                    "num_int": 75,
                    "num_str": "75",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Do not fear or doubt, for God is your guide. "
                        }
                    ]
                },
                {
                    "num_int": 76,
                    "num_str": "76",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You who keep my commandments and precepts,” says the Lord God, “do not let your sins pull you down, or your iniquities prevail over you.” "
                        }
                    ]
                },
                {
                    "num_int": 77,
                    "num_str": "77",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Woe to those who are choked by their sins and overwhelmed by their iniquities, as a field is choked with underbrush and its path"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Another reading is seed"
                        },
                        {
                            "style": "NONE",
                            "text": " overwhelmed with thorns, so that no one can pass through! "
                        }
                    ]
                },
                {
                    "num_int": 78,
                    "num_str": "78",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "It is shut off and given up to be consumed by fire."
                        }
                    ]
                }
            ]
        }
    ]
}