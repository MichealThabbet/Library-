            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these are the kings of the land whom Joshua and the people of Israel defeated on the west side of the Jordan, from Ba′al-gad in the valley of Lebanon to Mount Halak, that rises toward Se′ir (and Joshua gave their land to the tribes of Israel as a possession according to their allotments, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in the hill country, in the lowland, in the Arabah, in the slopes, in the wilderness, and in the Negeb, the land of the Hittites, the Amorites, the Canaanites, the Per′izzites, the Hivites, and the Jeb′usites): "
                        }
