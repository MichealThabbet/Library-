        {
            "type": "section_header",
            "text": "The Kings Conquered by Moses"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these are the kings of the land, whom the people of Israel defeated, and took possession of their land beyond the Jordan toward the sunrising, from the valley of the Arnon to Mount Hermon, with all the Arabah eastward: "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Sihon king of the Amorites who dwelt at Heshbon, and ruled from Aro′er, which is on the edge of the valley of the Arnon, and from the middle of the valley as far as the river Jabbok, the boundary of the Ammonites, that is, half of Gilead, "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Arabah to the Sea of Chin′neroth eastward, and in the direction of Beth-jesh′imoth, to the sea of the Arabah, the Salt Sea, southward to the foot of the slopes of Pisgah; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and Og"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb the boundary of Og"
                        },
                        {
                            "style": "NONE",
                            "text": " king of Bashan, one of the remnant of the Reph′aim, who dwelt at Ash′taroth and at Ed′re-i "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and ruled over Mount Hermon and Sal′ecah and all Bashan to the boundary of the Gesh′urites and the Ma-ac′athites, and over half of Gilead to the boundary of Sihon king of Heshbon. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moses, the servant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and the people of Israel defeated them; and Moses the servant of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " gave their land for a possession to the Reubenites and the Gadites and the half-tribe of Manas′seh."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Kings Conquered by Joshua"
        },
