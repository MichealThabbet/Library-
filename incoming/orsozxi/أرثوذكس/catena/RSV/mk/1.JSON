{
    "chapter_num": 1,
    "verses_count": 45,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Proclamation of John the Baptist"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The beginning of the gospel of Jesus Christ, the Son of God."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities omit the Son of God"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As it is written in Isaiah the prophet,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read in the prophets"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“Behold, I send my messenger before thy face,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "who shall prepare thy way;"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the voice of one crying in the wilderness:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Prepare the way of the Lord,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "make his paths straight—”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "John the baptizer appeared"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read John was baptizing"
                        },
                        {
                            "style": "NONE",
                            "text": " in the wilderness, preaching a baptism of repentance for the forgiveness of sins. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there went out to him all the country of Judea, and all the people of Jerusalem; and they were baptized by him in the river Jordan, confessing their sins. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now John was clothed with camel’s hair, and had a leather girdle around his waist, and ate locusts and wild honey. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he preached, saying, “After me comes he who is mightier than I, the thong of whose sandals I am not worthy to stoop down and untie. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have baptized you with water; but he will baptize you with the Holy Spirit.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Baptism of Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In those days Jesus came from Nazareth of Galilee and was baptized by John in the Jordan. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when he came up out of the water, immediately he saw the heavens opened and the Spirit descending upon him like a dove; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and a voice came from heaven, “Thou art my beloved Son;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or my Son, my (or the) Beloved"
                        },
                        {
                            "style": "NONE",
                            "text": " with thee I am well pleased.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Temptation of Jesus"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Spirit immediately drove him out into the wilderness. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he was in the wilderness forty days, tempted by Satan; and he was with the wild beasts; and the angels ministered to him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Beginning of the Galilean Ministry"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now after John was arrested, Jesus came into Galilee, preaching the gospel of God, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and saying, “The time is fulfilled, and the kingdom of God is at hand; repent, and believe in the gospel.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Calls the First Disciples"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And passing along by the Sea of Galilee, he saw Simon and Andrew the brother of Simon casting a net in the sea; for they were fishermen. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to them, “Follow me and I will make you become fishers of men.” "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately they left their nets and followed him. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And going on a little farther, he saw James the son of Zeb′edee and John his brother, who were in their boat mending the nets. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately he called them; and they left their father Zeb′edee in the boat with the hired servants, and followed him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Man with an Unclean Spirit"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they went into Caper′na-um; and immediately on the sabbath he entered the synagogue and taught. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were astonished at his teaching, for he taught them as one who had authority, and not as the scribes. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately there was in their synagogue a man with an unclean spirit; "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he cried out, “What have you to do with us, Jesus of Nazareth? Have you come to destroy us? I know who you are, the Holy One of God.” "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Jesus rebuked him, saying, “Be silent, and come out of him!” "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the unclean spirit, convulsing him and crying with a loud voice, came out of him. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they were all amazed, so that they questioned among themselves, saying, “What is this? A new teaching! With authority he commands even the unclean spirits, and they obey him.” "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And at once his fame spread everywhere throughout all the surrounding region of Galilee."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Heals Many at Simon’s House"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately he"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read they"
                        },
                        {
                            "style": "NONE",
                            "text": " left the synagogue, and entered the house of Simon and Andrew, with James and John. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now Simon’s mother-in-law lay sick with a fever, and immediately they told him of her. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he came and took her by the hand and lifted her up, and the fever left her; and she served them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "That evening, at sundown, they brought to him all who were sick or possessed with demons. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the whole city was gathered together about the door. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he healed many who were sick with various diseases, and cast out many demons; and he would not permit the demons to speak, because they knew him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "A Preaching Tour in Galilee"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in the morning, a great while before day, he rose and went out to a lonely place, and there he prayed. "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Simon and those who were with him pursued him, "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they found him and said to him, “Every one is searching for you.” "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “Let us go on to the next towns, that I may preach there also; for that is why I came out.” "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he went throughout all Galilee, preaching in their synagogues and casting out demons."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Cleanses a Leper"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And a leper came to him beseeching him, and kneeling said to him, “If you will, you can make me clean.” "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moved with pity, he stretched out his hand and touched him, and said to him, “I will; be clean.” "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately the leprosy left him, and he was made clean. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he sternly charged him, and sent him away at once, "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and said to him, “See that you say nothing to any one; but go, show yourself to the priest, and offer for your cleansing what Moses commanded, for a proof to the people.”"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek to them"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he went out and began to talk freely about it, and to spread the news, so that Jesus"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek he"
                        },
                        {
                            "style": "NONE",
                            "text": " could no longer openly enter a town, but was out in the country; and people came to him from every quarter."
                        }
                    ]
                }
            ]
        }
    ]
}