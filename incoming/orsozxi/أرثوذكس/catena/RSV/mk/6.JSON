{
    "chapter_num": 6,
    "verses_count": 56,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Rejection of Jesus at Nazareth"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He went away from there and came to his own country; and his disciples followed him. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the sabbath he began to teach in the synagogue; and many who heard him were astonished, saying, “Where did this man get all this? What is the wisdom given to him? What mighty works are wrought by his hands! "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Is not this the carpenter, the son of Mary and brother of James and Joses and Judas and Simon, and are not his sisters here with us?” And they took offense"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or stumbled"
                        },
                        {
                            "style": "NONE",
                            "text": " at him. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jesus said to them, “A prophet is not without honor, except in his own country, and among his own kin, and in his own house.” "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he could do no mighty work there, except that he laid his hands upon a few sick people and healed them. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he marveled because of their unbelief."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "And he went about among the villages teaching."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Mission of the Twelve"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he called to him the twelve, and began to send them out two by two, and gave them authority over the unclean spirits. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He charged them to take nothing for their journey except a staff; no bread, no bag, no money in their belts; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but to wear sandals and not put on two tunics. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “Where you enter a house, stay there until you leave the place. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And if any place will not receive you and they refuse to hear you, when you leave, shake off the dust that is on your feet for a testimony against them.” "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they went out and preached that men should repent. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they cast out many demons, and anointed with oil many that were sick and healed them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Death of John the Baptist"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "King Herod heard of it; for Jesus’"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Greek his"
                        },
                        {
                            "style": "NONE",
                            "text": " name had become known. Some"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read he"
                        },
                        {
                            "style": "NONE",
                            "text": " said, “John the baptizer has been raised from the dead; that is why these powers are at work in him.” "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But others said, “It is Eli′jah.” And others said, “It is a prophet, like one of the prophets of old.” "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when Herod heard of it he said, “John, whom I beheaded, has been raised.” "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For Herod had sent and seized John, and bound him in prison for the sake of Hero′di-as, his brother Philip’s wife; because he had married her. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For John said to Herod, “It is not lawful for you to have your brother’s wife.” "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hero′di-as had a grudge against him, and wanted to kill him. But she could not, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for Herod feared John, knowing that he was a righteous and holy man, and kept him safe. When he heard him, he was much perplexed; and yet he heard him gladly. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But an opportunity came when Herod on his birthday gave a banquet for his courtiers and officers and the leading men of Galilee. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For when Hero′di-as’ daughter came in and danced, she pleased Herod and his guests; and the king said to the girl, “Ask me for whatever you wish, and I will grant it.” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he vowed to her, “Whatever you ask me, I will give you, even half of my kingdom.” "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And she went out, and said to her mother, “What shall I ask?” And she said, “The head of John the baptizer.” "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And she came in immediately with haste to the king, and asked, saying, “I want you to give me at once the head of John the Baptist on a platter.” "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king was exceedingly sorry; but because of his oaths and his guests he did not want to break his word to her. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And immediately the king sent a soldier of the guard and gave orders to bring his head. He went and beheaded him in the prison, "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and brought his head on a platter, and gave it to the girl; and the girl gave it to her mother. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When his disciples heard of it, they came and took his body, and laid it in a tomb."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Feeding the Five Thousand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The apostles returned to Jesus, and told him all that they had done and taught. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “Come away by yourselves to a lonely place, and rest a while.” For many were coming and going, and they had no leisure even to eat. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they went away in the boat to a lonely place by themselves. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now many saw them going, and knew them, and they ran there on foot from all the towns, and got there ahead of them. "
                        }
                    ]
                },
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As he went ashore he saw a great throng, and he had compassion on them, because they were like sheep without a shepherd; and he began to teach them many things. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when it grew late, his disciples came to him and said, “This is a lonely place, and the hour is now late; "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "send them away, to go into the country and villages round about and buy themselves something to eat.” "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But he answered them, “You give them something to eat.” And they said to him, “Shall we go and buy two hundred denarii"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "The denarius was a day’s wage for a laborer"
                        },
                        {
                            "style": "NONE",
                            "text": " worth of bread, and give it to them to eat?” "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to them, “How many loaves have you? Go and see.” And when they had found out, they said, “Five, and two fish.” "
                        }
                    ]
                },
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he commanded them all to sit down by companies upon the green grass. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So they sat down in groups, by hundreds and by fifties. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And taking the five loaves and the two fish he looked up to heaven, and blessed, and broke the loaves, and gave them to the disciples to set before the people; and he divided the two fish among them all. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they all ate and were satisfied. "
                        }
                    ]
                },
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they took up twelve baskets full of broken pieces and of the fish. "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And those who ate the loaves were five thousand men."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jesus Walks on the Water"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Immediately he made his disciples get into the boat and go before him to the other side, to Beth-sa′ida, while he dismissed the crowd. "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And after he had taken leave of them, he went up on the mountain to pray. "
                        }
                    ]
                },
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when evening came, the boat was out on the sea, and he was alone on the land. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he saw that they were making headway painfully, for the wind was against them. And about the fourth watch of the night he came to them, walking on the sea. He meant to pass by them, "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but when they saw him walking on the sea they thought it was a ghost, and cried out; "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for they all saw him, and were terrified. But immediately he spoke to them and said, “Take heart, it is I; have no fear.” "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he got into the boat with them and the wind ceased. And they were utterly astounded, "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for they did not understand about the loaves, but their hearts were hardened."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Healing the Sick in Gennesaret"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when they had crossed over, they came to land at Gennes′aret, and moored to the shore. "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when they got out of the boat, immediately the people recognized him, "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and ran about the whole neighborhood and began to bring sick people on their pallets to any place where they heard he was. "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And wherever he came, in villages, cities, or country, they laid the sick in the market places, and besought him that they might touch even the fringe of his garment; and as many as touched it were made well."
                        }
                    ]
                }
            ]
        }
    ]
}