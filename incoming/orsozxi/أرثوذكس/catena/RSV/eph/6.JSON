{
    "chapter_num": 6,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Children and Parents"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Children, obey your parents in the Lord, for this is right. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Honor your father and mother” (this is the first commandment with a promise), "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“that it may be well with you and that you may live long on the earth.” "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Fathers, do not provoke your children to anger, but bring them up in the discipline and instruction of the Lord."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Slaves and Masters"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Slaves, be obedient to those who are your earthly masters, with fear and trembling, in singleness of heart, as to Christ; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not in the way of eye-service, as men-pleasers, but as servants"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or slaves"
                        },
                        {
                            "style": "NONE",
                            "text": " of Christ, doing the will of God from the heart, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "rendering service with a good will as to the Lord and not to men, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "knowing that whatever good any one does, he will receive the same again from the Lord, whether he is a slave or free. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Masters, do the same to them, and forbear threatening, knowing that he who is both their Master and yours is in heaven, and that there is no partiality with him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Whole Armor of God"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Finally, be strong in the Lord and in the strength of his might. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Put on the whole armor of God, that you may be able to stand against the wiles of the devil. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For we are not contending against flesh and blood, but against the principalities, against the powers, against the world rulers of this present darkness, against the spiritual hosts of wickedness in the heavenly places. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore take the whole armor of God, that you may be able to withstand in the evil day, and having done all, to stand. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Stand therefore, having girded your loins with truth, and having put on the breastplate of righteousness, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and having shod your feet with the equipment of the gospel of peace; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "besides all these, taking the shield of faith, with which you can quench all the flaming darts of the evil one. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And take the helmet of salvation, and the sword of the Spirit, which is the word of God. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Pray at all times in the Spirit, with all prayer and supplication. To that end keep alert with all perseverance, making supplication for all the saints, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and also for me, that utterance may be given me in opening my mouth boldly to proclaim the mystery of the gospel, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for which I am an ambassador in chains; that I may declare it boldly, as I ought to speak."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Personal Matters and Benediction"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now that you also may know how I am and what I am doing, Tych′icus the beloved brother and faithful minister in the Lord will tell you everything. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I have sent him to you for this very purpose, that you may know how we are, and that he may encourage your hearts."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Peace be to the brethren, and love with faith, from God the Father and the Lord Jesus Christ. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace be with all who love our Lord Jesus Christ with love undying."
                        }
                    ]
                }
            ]
        }
    ]
}