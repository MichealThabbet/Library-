{
    "chapter_num": 1,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Salutation"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, an apostle of Christ Jesus by the will of God,"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "To the saints who are also faithful"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read who are at Ephesus and faithful"
                        },
                        {
                            "style": "NONE",
                            "text": " in Christ Jesus:"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Spiritual Blessings in Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Blessed be the God and Father of our Lord Jesus Christ, who has blessed us in Christ with every spiritual blessing in the heavenly places, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "even as he chose us in him before the foundation of the world, that we should be holy and blameless before him. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He destined us in love"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or before him in love, having destined us"
                        },
                        {
                            "style": "NONE",
                            "text": " to be his sons through Jesus Christ, according to the purpose of his will, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to the praise of his glorious grace which he freely bestowed on us in the Beloved. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In him we have redemption through his blood, the forgiveness of our trespasses, according to the riches of his grace "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which he lavished upon us. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For he has made known to us in all wisdom and insight the mystery of his will, according to his purpose which he set forth in Christ "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as a plan for the fulness of time, to unite all things in him, things in heaven and things on earth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In him, according to the purpose of him who accomplishes all things according to the counsel of his will, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "we who first hoped in Christ have been destined and appointed to live for the praise of his glory. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In him you also, who have heard the word of truth, the gospel of your salvation, and have believed in him, were sealed with the promised Holy Spirit, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which is the guarantee of our inheritance until we acquire possession of it, to the praise of his glory."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul’s Prayer"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this reason, because I have heard of your faith in the Lord Jesus and your love"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities omit your love"
                        },
                        {
                            "style": "NONE",
                            "text": " toward all the saints, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I do not cease to give thanks for you, remembering you in my prayers, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "that the God of our Lord Jesus Christ, the Father of glory, may give you a spirit of wisdom and of revelation in the knowledge of him, "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having the eyes of your hearts enlightened, that you may know what is the hope to which he has called you, what are the riches of his glorious inheritance in the saints, "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and what is the immeasurable greatness of his power in us who believe, according to the working of his great might "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which he accomplished in Christ when he raised him from the dead and made him sit at his right hand in the heavenly places, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "far above all rule and authority and power and dominion, and above every name that is named, not only in this age but also in that which is to come; "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he has put all things under his feet and has made him the head over all things for the church, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which is his body, the fulness of him who fills all in all."
                        }
                    ]
                }
            ]
        }
    ]
}