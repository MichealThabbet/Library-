{
    "chapter_num": 5,
    "verses_count": 25,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "David Anointed King of All Israel"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then all the tribes of Israel came to David at Hebron, and said, “Behold, we are your bone and flesh. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In times past, when Saul was king over us, it was you that led out and brought in Israel; and the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to you, ‘You shall be shepherd of my people Israel, and you shall be prince over Israel.’” "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So all the elders of Israel came to the king at Hebron; and King David made a covenant with them at Hebron before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and they anointed David king over Israel. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "David was thirty years old when he began to reign, and he reigned forty years. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "At Hebron he reigned over Judah seven years and six months; and at Jerusalem he reigned over all Israel and Judah thirty-three years."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Jerusalem Made Capital of the United Kingdom"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king and his men went to Jerusalem against the Jeb′usites, the inhabitants of the land, who said to David, “You will not come in here, but the blind and the lame will ward you off”—thinking, “David cannot come in here.” "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless David took the stronghold of Zion, that is, the city of David. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David said on that day, “Whoever would smite the Jeb′usites, let him get up the water shaft to attack the lame and the blind, who are hated by David’s soul.” Therefore it is said, “The blind and the lame shall not come into the house.” "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David dwelt in the stronghold, and called it the city of David. And David built the city round about from the Millo inward. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David became greater and greater, for the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the God of hosts, was with him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hiram king of Tyre sent messengers to David, and cedar trees, also carpenters and masons who built David a house. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David perceived that the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had established him king over Israel, and that he had exalted his kingdom for the sake of his people Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David took more concubines and wives from Jerusalem, after he came from Hebron; and more sons and daughters were born to David. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And these are the names of those who were born to him in Jerusalem: Sham′mu-a, Shobab, Nathan, Solomon, "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Ibhar, Eli′shu-a, Nepheg, Japhi′a, "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Elish′ama, Eli′ada, and Eliph′elet."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Philistine Attack Repulsed"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the Philistines heard that David had been anointed king over Israel, all the Philistines went up in search of David; but David heard of it and went down to the stronghold. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now the Philistines had come and spread out in the valley of Reph′aim. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David inquired of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", “Shall I go up against the Philistines? Wilt thou give them into my hand?” And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to David, “Go up; for I will certainly give the Philistines into your hand.” "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David came to Ba′al-pera′zim, and David defeated them there; and he said, “The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has broken through"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb paraz"
                        },
                        {
                            "style": "NONE",
                            "text": " my enemies before me, like a bursting flood.” Therefore the name of that place is called Ba′al-pera′zim."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "That is Lord of breaking through"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Philistines left their idols there, and David and his men carried them away."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the Philistines came up yet again, and spread out in the valley of Reph′aim. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when David inquired of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", he said, “You shall not go up; go around to their rear, and come upon them opposite the balsam trees. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And when you hear the sound of marching in the tops of the balsam trees, then bestir yourself; for then the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has gone out before you to smite the army of the Philistines.” "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And David did as the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded him, and smote the Philistines from Geba to Gezer."
                        }
                    ]
                }
            ]
        }
    ]
}