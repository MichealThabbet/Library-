{
    "chapter_num": 46,
    "verses_count": 24,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Miscellaneous Regulations"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus says the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ": The gate of the inner court that faces east shall be shut on the six working days; but on the sabbath day it shall be opened and on the day of the new moon it shall be opened. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The prince shall enter by the vestibule of the gate from without, and shall take his stand by the post of the gate. The priests shall offer his burnt offering and his peace offerings, and he shall worship at the threshold of the gate. Then he shall go out, but the gate shall not be shut until evening. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The people of the land shall worship at the entrance of that gate before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " on the sabbaths and on the new moons. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The burnt offering that the prince offers to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " on the sabbath day shall be six lambs without blemish and a ram without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the cereal offering with the ram shall be an ephah, and the cereal offering with the lambs shall be as much as he is able, together with a hin of oil to each ephah. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the day of the new moon he shall offer a young bull without blemish, and six lambs and a ram, which shall be without blemish; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as a cereal offering he shall provide an ephah with the bull and an ephah with the ram, and with the lambs as much as he is able, together with a hin of oil to each ephah. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the prince enters, he shall go in by the vestibule of the gate, and he shall go out by the same way."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When the people of the land come before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " at the appointed feasts, he who enters by the north gate to worship shall go out by the south gate; and he who enters by the south gate shall go out by the north gate: no one shall return by way of the gate by which he entered, but each shall go out straight ahead. "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When they go in, the prince shall go in with them; and when they go out, he shall go out."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“At the feasts and the appointed seasons the cereal offering with a young bull shall be an ephah, and with a ram an ephah, and with the lambs as much as one is able to give, together with a hin of oil to an ephah. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When the prince provides a freewill offering, either a burnt offering or peace offerings as a freewill offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", the gate facing east shall be opened for him; and he shall offer his burnt offering or his peace offerings as he does on the sabbath day. Then he shall go out, and after he has gone out the gate shall be shut."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“He shall provide a lamb a year old without blemish for a burnt offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " daily; morning by morning he shall provide it. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he shall provide a cereal offering with it morning by morning, one sixth of an ephah, and one third of a hin of oil to moisten the flour, as a cereal offering to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; this is the ordinance for the continual burnt offering."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Cn: Heb perpetual ordinances continually"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus the lamb and the meal offering and the oil shall be provided, morning by morning, for a continual burnt offering."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus says the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": ": If the prince makes a gift to any of his sons out of"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb it is his inheritance"
                        },
                        {
                            "style": "NONE",
                            "text": " his inheritance, it shall belong to his sons, it is their property by inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if he makes a gift out of his inheritance to one of his servants, it shall be his to the year of liberty; then it shall revert to the prince; only his sons may keep a gift from his inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The prince shall not take any of the inheritance of the people, thrusting them out of their property; he shall give his sons their inheritance out of his own property, so that none of my people shall be dispossessed of his property.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he brought me through the entrance, which was at the side of the gate, to the north row of the holy chambers for the priests; and there I saw a place at the extreme western end of them. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to me, “This is the place where the priests shall boil the guilt offering and the sin offering, and where they shall bake the cereal offering, in order not to bring them out into the outer court and so communicate holiness to the people.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he brought me forth to the outer court, and led me to the four corners of the court; and in each corner of the court there was a court— "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in the four corners of the court were small"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Syr Vg: The meaning of the Hebrew word is uncertain"
                        },
                        {
                            "style": "NONE",
                            "text": " courts, forty cubits long and thirty broad; the four were of the same size. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the inside, around each of the four courts was a row of masonry, with hearths made at the bottom of the rows round about. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then he said to me, “These are the kitchens where those who minister at the temple shall boil the sacrifices of the people.”"
                        }
                    ]
                }
            ]
        }
    ]
}