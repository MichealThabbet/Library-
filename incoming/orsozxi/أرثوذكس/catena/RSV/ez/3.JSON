{
    "chapter_num": 3,
    "verses_count": 27,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to me, “Son of man, eat what is offered to you; eat this scroll, and go, speak to the house of Israel.” "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So I opened my mouth, and he gave me the scroll to eat. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to me, “Son of man, eat this scroll that I give you and fill your stomach with it.” Then I ate it; and it was in my mouth as sweet as honey."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said to me, “Son of man, go, get you to the house of Israel, and speak with my words to them. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For you are not sent to a people of foreign speech and a hard language, but to the house of Israel— "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "not to many peoples of foreign speech and a hard language, whose words you cannot understand. Surely, if I sent you to such, they would listen to you. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the house of Israel will not listen to you; for they are not willing to listen to me; because all the house of Israel are of a hard forehead and of a stubborn heart. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Behold, I have made your face hard against their faces, and your forehead hard against their foreheads. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Like adamant harder than flint have I made your forehead; fear them not, nor be dismayed at their looks, for they are a rebellious house.” "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moreover he said to me, “Son of man, all my words that I shall speak to you receive in your heart, and hear with your ears. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And go, get you to the exiles, to your people, and say to them, ‘Thus says the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "’; whether they hear or refuse to hear.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Ezekiel at the River Chebar"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the Spirit lifted me up, and as the glory of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " arose"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Cn: Heb blessed be the glory of the Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " from its place, I heard behind me the sound of a great earthquake; "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "it was the sound of the wings of the living creatures as they touched one another, and the sound of the wheels beside them, that sounded like a great earthquake. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The Spirit lifted me up and took me away, and I went in bitterness in the heat of my spirit, the hand of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " being strong upon me; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and I came to the exiles at Tel-abib, who dwelt by the river Chebar."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Heb Chebar, and to where they dwelt. Another reading is Chebar, and I sat where they sat"
                        },
                        {
                            "style": "NONE",
                            "text": " And I sat there overwhelmed among them seven days."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And at the end of seven days, the word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to me: "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Son of man, I have made you a watchman for the house of Israel; whenever you hear a word from my mouth, you shall give them warning from me. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If I say to the wicked, ‘You shall surely die,’ and you give him no warning, nor speak to warn the wicked from his wicked way, in order to save his life, that wicked man shall die in his iniquity; but his blood I will require at your hand. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if you warn the wicked, and he does not turn from his wickedness, or from his wicked way, he shall die in his iniquity; but you will have saved your life. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Again, if a righteous man turns from his righteousness and commits iniquity, and I lay a stumbling block before him, he shall die; because you have not warned him, he shall die for his sin, and his righteous deeds which he has done shall not be remembered; but his blood I will require at your hand. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nevertheless if you warn the righteous man not to sin, and he does not sin, he shall surely live, because he took warning; and you will have saved your life.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Ezekiel Isolated and Silenced"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the hand of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " was there upon me; and he said to me, “Arise, go forth into the plain,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or valley"
                        },
                        {
                            "style": "NONE",
                            "text": " and there I will speak with you.” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So I arose and went forth into the plain;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or valley"
                        },
                        {
                            "style": "NONE",
                            "text": " and lo, the glory of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " stood there, like the glory which I had seen by the river Chebar; and I fell on my face. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the Spirit entered into me, and set me upon my feet; and he spoke with me and said to me, “Go, shut yourself within your house. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, O son of man, behold, cords will be placed upon you, and you shall be bound with them, so that you cannot go out among the people; "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and I will make your tongue cleave to the roof of your mouth, so that you shall be dumb and unable to reprove them; for they are a rebellious house. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when I speak with you, I will open your mouth, and you shall say to them, ‘Thus says the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "’; he that will hear, let him hear; and he that will refuse to hear, let him refuse; for they are a rebellious house."
                        }
                    ]
                }
            ]
        }
    ]
}