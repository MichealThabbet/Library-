{
    "chapter_num": 8,
    "verses_count": 32,
    "paragraphs_list": [
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 7.26 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Go in to Pharaoh and say to him, ‘Thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", “Let my people go, that they may serve me. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But if you refuse to let them go, behold, I will plague all your country with frogs; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the Nile shall swarm with frogs which shall come up into your house, and into your bedchamber and on your bed, and into the houses of your servants and of your people,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb upon your people"
                        },
                        {
                            "style": "NONE",
                            "text": " and into your ovens and your kneading bowls; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the frogs shall come up on you and on your people and on all your servants.”’” "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "FOOTNOTE",
                            "text": "Ch 8.1 in Heb"
                        },
                        {
                            "style": "NONE",
                            "text": " And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Say to Aaron, ‘Stretch out your hand with your rod over the rivers, over the canals, and over the pools, and cause frogs to come upon the land of Egypt!’” "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Aaron stretched out his hand over the waters of Egypt; and the frogs came up and covered the land of Egypt. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the magicians did the same by their secret arts, and brought frogs upon the land of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Pharaoh called Moses and Aaron, and said, “Entreat the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " to take away the frogs from me and from my people; and I will let the people go to sacrifice to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".” "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moses said to Pharaoh, “Be pleased to command me when I am to entreat, for you and for your servants and for your people, that the frogs be destroyed from you and your houses and be left only in the Nile.” "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he said, “Tomorrow.” Moses said, “Be it as you say, that you may know that there is no one like the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The frogs shall depart from you and your houses and your servants and your people; they shall be left only in the Nile.” "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Moses and Aaron went out from Pharaoh; and Moses cried to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " concerning the frogs, as he had agreed with Pharaoh."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or which he had brought upon Pharaoh"
                        },
                        {
                            "style": "NONE",
                            "text": " "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " did according to the word of Moses; the frogs died out of the houses and courtyards and out of the fields. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they gathered them together in heaps, and the land stank. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But when Pharaoh saw that there was a respite, he hardened his heart, and would not listen to them; as the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had said."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Third Plague: Gnats"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Say to Aaron, ‘Stretch out your rod and strike the dust of the earth, that it may become gnats throughout all the land of Egypt.’” "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they did so; Aaron stretched out his hand with his rod, and struck the dust of the earth, and there came gnats on man and beast; all the dust of the earth became gnats throughout all the land of Egypt. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The magicians tried by their secret arts to bring forth gnats, but they could not. So there were gnats on man and beast. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the magicians said to Pharaoh, “This is the finger of God.” But Pharaoh’s heart was hardened, and he would not listen to them; as the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " had said."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Fourth Plague: Flies"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, “Rise up early in the morning and wait for Pharaoh, as he goes out to the water, and say to him, ‘Thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", “Let my people go, that they may serve me. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Else, if you will not let my people go, behold, I will send swarms of flies on you and your servants and your people, and into your houses; and the houses of the Egyptians shall be filled with swarms of flies, and also the ground on which they stand. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But on that day I will set apart the land of Goshen, where my people dwell, so that no swarms of flies shall be there; that you may know that I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " in the midst of the earth. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Thus I will put a division"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Vg: Heb set redemption"
                        },
                        {
                            "style": "NONE",
                            "text": " between my people and your people. By tomorrow shall this sign be.”’” "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " did so; there came great swarms of flies into the house of Pharaoh and into his servants’ houses, and in all the land of Egypt the land was ruined by reason of the flies."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Pharaoh called Moses and Aaron, and said, “Go, sacrifice to your God within the land.” "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Moses said, “It would not be right to do so; for we shall sacrifice to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God offerings abominable to the Egyptians. If we sacrifice offerings abominable to the Egyptians before their eyes, will they not stone us? "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We must go three days’ journey into the wilderness and sacrifice to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " our God as he will command us.” "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Pharaoh said, “I will let you go, to sacrifice to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God in the wilderness; only you shall not go very far away. Make entreaty for me.” "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then Moses said, “Behold, I am going out from you and I will pray to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " that the swarms of flies may depart from Pharaoh, from his servants, and from his people, tomorrow; only let not Pharaoh deal falsely again by not letting the people go to sacrifice to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".” "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Moses went out from Pharaoh and prayed to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " did as Moses asked, and removed the swarms of flies from Pharaoh, from his servants, and from his people; not one remained. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Pharaoh hardened his heart this time also, and did not let the people go."
                        }
                    ]
                }
            ]
        }
    ]
}