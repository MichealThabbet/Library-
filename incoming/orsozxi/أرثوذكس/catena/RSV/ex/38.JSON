{
    "chapter_num": 38,
    "verses_count": 31,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Making the Altar of Burnt Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the altar of burnt offering also of acacia wood; five cubits was its length, and five cubits its breadth; it was square, and three cubits was its height. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made horns for it on its four corners; its horns were of one piece with it, and he overlaid it with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made all the utensils of the altar, the pots, the shovels, the basins, the forks, and the firepans; all its utensils he made of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made for the altar a grating, a network of bronze, under its ledge, extending halfway down. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He cast four rings on the four corners of the bronze grating as holders for the poles; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he made the poles of acacia wood, and overlaid them with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he put the poles through the rings on the sides of the altar, to carry it with them; he made it hollow, with boards."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the laver of bronze and its base of bronze, from the mirrors of the ministering women who ministered at the door of the tent of meeting."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Court of the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the court; for the south side the hangings of the court were of fine twined linen, a hundred cubits; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "their pillars were twenty and their bases twenty, of bronze, but the hooks of the pillars and their fillets were of silver. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And for the north side a hundred cubits, their pillars twenty, their bases twenty, of bronze, but the hooks of the pillars and their fillets were of silver. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And for the west side were hangings of fifty cubits, their pillars ten, and their sockets ten; the hooks of the pillars and their fillets were of silver. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And for the front to the east, fifty cubits. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hangings for one side of the gate were fifteen cubits, with three pillars and three bases. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And so for the other side; on this hand and that hand by the gate of the court were hangings of fifteen cubits, with three pillars and three bases. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the hangings round about the court were of fine twined linen. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the bases for the pillars were of bronze, but the hooks of the pillars and their fillets were of silver; the overlaying of their capitals was also of silver, and all the pillars of the court were filleted with silver. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the screen for the gate of the court was embroidered with needlework in blue and purple and scarlet stuff and fine twined linen; it was twenty cubits long and five cubits high in its breadth, corresponding to the hangings of the court. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And their pillars were four; their four bases were of bronze, their hooks of silver, and the overlaying of their capitals and their fillets of silver. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the pegs for the tabernacle and for the court round about were of bronze."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Materials of the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "This is the sum of the things for the tabernacle, the tabernacle of the testimony, as they were counted at the commandment of Moses, for the work of the Levites under the direction of Ith′amar the son of Aaron the priest. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bez′alel the son of Uri, son of Hur, of the tribe of Judah, made all that the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses; "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and with him was Oho′liab the son of Ahis′amach, of the tribe of Dan, a craftsman and designer and embroiderer in blue and purple and scarlet stuff and fine twined linen."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the gold that was used for the work, in all the construction of the sanctuary, the gold from the offering, was twenty-nine talents and seven hundred and thirty shekels, by the shekel of the sanctuary. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the silver from those of the congregation who were numbered was a hundred talents and a thousand seven hundred and seventy-five shekels, by the shekel of the sanctuary: "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "a beka a head (that is, half a shekel, by the shekel of the sanctuary), for every one who was numbered in the census, from twenty years old and upward, for six hundred and three thousand, five hundred and fifty men. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hundred talents of silver were for casting the bases of the sanctuary, and the bases of the veil; a hundred bases for the hundred talents, a talent for a base. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And of the thousand seven hundred and seventy-five shekels he made hooks for the pillars, and overlaid their capitals and made fillets for them. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the bronze that was contributed was seventy talents, and two thousand and four hundred shekels; "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "with it he made the bases for the door of the tent of meeting, the bronze altar and the bronze grating for it and all the utensils of the altar, "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the bases round about the court, and the bases of the gate of the court, all the pegs of the tabernacle, and all the pegs round about the court."
                        }
                    ]
                }
            ]
        }
    ]
}