{
    "chapter_num": 23,
    "verses_count": 33,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Justice for All"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not utter a false report. You shall not join hands with a wicked man, to be a malicious witness. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall not follow a multitude to do evil; nor shall you bear witness in a suit, turning aside after a multitude, so as to pervert justice; "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "nor shall you be partial to a poor man in his suit."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“If you meet your enemy’s ox or his ass going astray, you shall bring it back to him. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "If you see the ass of one who hates you lying under its burden, you shall refrain from leaving him with it, you shall help him to lift it up."
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb obscure"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not pervert the justice due to your poor in his suit. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Keep far from a false charge, and do not slay the innocent and righteous, for I will not acquit the wicked. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall take no bribe, for a bribe blinds the officials, and subverts the cause of those who are in the right."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not oppress a stranger; you know the heart of a stranger, for you were strangers in the land of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Sabbatical Year and Sabbath"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For six years you shall sow your land and gather in its yield; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "but the seventh year you shall let it rest and lie fallow, that the poor of your people may eat; and what they leave the wild beasts may eat. You shall do likewise with your vineyard, and with your olive orchard."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Six days you shall do your work, but on the seventh day you shall rest; that your ox and your ass may have rest, and the son of your bondmaid, and the alien, may be refreshed. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Take heed to all that I have said to you; and make no mention of the names of other gods, nor let such be heard out of your mouth."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Annual Festivals"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Three times in the year you shall keep a feast to me. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep the feast of unleavened bread; as I commanded you, you shall eat unleavened bread for seven days at the appointed time in the month of Abib, for in it you came out of Egypt. None shall appear before me empty-handed. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall keep the feast of harvest, of the first fruits of your labor, of what you sow in the field. You shall keep the feast of ingathering at the end of the year, when you gather in from the field the fruit of your labor. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Three times in the year shall all your males appear before the Lord "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "God"
                        },
                        {
                            "style": "NONE",
                            "text": "."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall not offer the blood of my sacrifice with leavened bread, or let the fat of my feast remain until the morning."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“The first of the first fruits of your ground you shall bring into the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "“You shall not boil a kid in its mother’s milk."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Conquest of Canaan Promised"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Behold, I send an angel before you, to guard you on the way and to bring you to the place which I have prepared. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Give heed to him and hearken to his voice, do not rebel against him, for he will not pardon your transgression; for my name is in him."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“But if you hearken attentively to his voice and do all that I say, then I will be an enemy to your enemies and an adversary to your adversaries."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“When my angel goes before you, and brings you in to the Amorites, and the Hittites, and the Per′izzites, and the Canaanites, the Hivites, and the Jeb′usites, and I blot them out, "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "you shall not bow down to their gods, nor serve them, nor do according to their works, but you shall utterly overthrow them and break their pillars in pieces. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall serve the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God, and I"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Vg: Heb he"
                        },
                        {
                            "style": "NONE",
                            "text": " will bless your bread and your water; and I will take sickness away from the midst of you. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "None shall cast her young or be barren in your land; I will fulfil the number of your days. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will send my terror before you, and will throw into confusion all the people against whom you shall come, and I will make all your enemies turn their backs to you. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will send hornets before you, which shall drive out Hivite, Canaanite, and Hittite from before you. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will not drive them out from before you in one year, lest the land become desolate and the wild beasts multiply against you. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Little by little I will drive them out from before you, until you are increased and possess the land. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And I will set your bounds from the Red Sea to the sea of the Philistines, and from the wilderness to the Euphra′tes; for I will deliver the inhabitants of the land into your hand, and you shall drive them out before you. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make no covenant with them or with their gods. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They shall not dwell in your land, lest they make you sin against me; for if you serve their gods, it will surely be a snare to you.”"
                        }
                    ]
                }
            ]
        }
    ]
}