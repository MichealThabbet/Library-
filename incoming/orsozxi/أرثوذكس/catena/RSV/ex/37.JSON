{
    "chapter_num": 37,
    "verses_count": 29,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Making the Ark of the Covenant"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Bez′alel made the ark of acacia wood; two cubits and a half was its length, a cubit and a half its breadth, and a cubit and a half its height. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he overlaid it with pure gold within and without, and made a molding of gold around it. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he cast for it four rings of gold for its four corners, two rings on its one side and two rings on its other side. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made poles of acacia wood, and overlaid them with gold, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and put the poles into the rings on the sides of the ark, to carry the ark. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made a mercy seat of pure gold; two cubits and a half was its length, and a cubit and a half its breadth. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made two cherubim of hammered gold; on the two ends of the mercy seat he made them, "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "one cherub on the one end, and one cherub on the other end; of one piece with the mercy seat he made the cherubim on its two ends. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The cherubim spread out their wings above, overshadowing the mercy seat with their wings, with their faces one to another; toward the mercy seat were the faces of the cherubim."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Table for the Bread of the Presence"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made the table of acacia wood; two cubits was its length, a cubit its breadth, and a cubit and a half its height; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he overlaid it with pure gold, and made a molding of gold around it. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made around it a frame a handbreadth wide, and made a molding of gold around the frame. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He cast for it four rings of gold, and fastened the rings to the four corners at its four legs. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Close to the frame were the rings, as holders for the poles to carry the table. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the poles of acacia wood to carry the table, and overlaid them with gold. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the vessels of pure gold which were to be upon the table, its plates and dishes for incense, and its bowls and flagons with which to pour libations."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Lampstand"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also made the lampstand of pure gold. The base and the shaft of the lampstand were made of hammered work; its cups, its capitals, and its flowers were of one piece with it. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And there were six branches going out of its sides, three branches of the lampstand out of one side of it and three branches of the lampstand out of the other side of it; "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "three cups made like almonds, each with capital and flower, on one branch, and three cups made like almonds, each with capital and flower, on the other branch—so for the six branches going out of the lampstand. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And on the lampstand itself were four cups made like almonds, with their capitals and flowers, "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and a capital of one piece with it under each pair of the six branches going out of it. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Their capitals and their branches were of one piece with it; the whole of it was one piece of hammered work of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made its seven lamps and its snuffers and its trays of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made it and all its utensils of a talent of pure gold."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Altar of Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the altar of incense of acacia wood; its length was a cubit, and its breadth was a cubit; it was square, and two cubits was its height; its horns were of one piece with it. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He overlaid it with pure gold, its top, and its sides round about, and its horns; and he made a molding of gold round about it, "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and made two rings of gold on it under its molding, on two opposite sides of it, as holders for the poles with which to carry it. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he made the poles of acacia wood, and overlaid them with gold."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Making the Anointing Oil and the Incense"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He made the holy anointing oil also, and the pure fragrant incense, blended as by the perfumer."
                        }
                    ]
                }
            ]
        }
    ]
}