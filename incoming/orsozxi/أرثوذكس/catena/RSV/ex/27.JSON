{
    "chapter_num": 27,
    "verses_count": 21,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Altar of Burnt Offering"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make the altar of acacia wood, five cubits long and five cubits broad; the altar shall be square, and its height shall be three cubits. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make horns for it on its four corners; it horns shall be of one piece with it, and you shall overlay it with bronze. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make pots for it to receive its ashes, and shovels and basins and forks and firepans; all its utensils you shall make of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall also make for it a grating, a network of bronze; and upon the net you shall make four bronze rings at its four corners. "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall set it under the ledge of the altar so that the net shall extend halfway down the altar. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall make poles for the altar, poles of acacia wood, and overlay them with bronze; "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the poles shall be put through the rings, so that the poles shall be upon the two sides of the altar, when it is carried. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall make it hollow, with boards; as it has been shown you on the mountain, so shall it be made."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Court and Its Hangings"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall make the court of the tabernacle. On the south side the court shall have hangings of fine twined linen a hundred cubits long for one side; "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "their pillars shall be twenty and their bases twenty, of bronze, but the hooks of the pillars and their fillets shall be of silver. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And likewise for its length on the north side there shall be hangings a hundred cubits long, their pillars twenty and their bases twenty, of bronze, but the hooks of the pillars and their fillets shall be of silver. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And for the breadth of the court on the west side there shall be hangings for fifty cubits, with ten pillars and ten bases. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The breadth of the court on the front to the east shall be fifty cubits. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The hangings for the one side of the gate shall be fifteen cubits, with three pillars and three bases. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "On the other side the hangings shall be fifteen cubits, with three pillars and three bases. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For the gate of the court there shall be a screen twenty cubits long, of blue and purple and scarlet stuff and fine twined linen, embroidered with needlework; it shall have four pillars and with them four bases. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the pillars around the court shall be filleted with silver; their hooks shall be of silver, and their bases of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The length of the court shall be a hundred cubits, the breadth fifty, and the height five cubits, with hangings of fine twined linen and bases of bronze. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "All the utensils of the tabernacle for every use, and all its pegs and all the pegs of the court, shall be of bronze."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Oil for the Lamp"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall command the people of Israel that they bring to you pure beaten olive oil for the light, that a lamp may be set up to burn continually. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the tent of meeting, outside the veil which is before the testimony, Aaron and his sons shall tend it from evening to morning before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". It shall be a statute for ever to be observed throughout their generations by the people of Israel."
                        }
                    ]
                }
            ]
        }
    ]
}