{
    "chapter_num": 1,
    "verses_count": 29,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Salutation"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Paul, an apostle of Christ Jesus by the will of God, and Timothy our brother,"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To the saints and faithful brethren in Christ at Colos′sae:"
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Grace to you and peace from God our Father."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul Thanks God for the Colossians"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "We always thank God, the Father of our Lord Jesus Christ, when we pray for you, "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because we have heard of your faith in Christ Jesus and of the love which you have for all the saints, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because of the hope laid up for you in heaven. Of this you have heard before in the word of the truth, the gospel "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "which has come to you, as indeed in the whole world it is bearing fruit and growing—so among yourselves, from the day you heard and understood the grace of God in truth, "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "as you learned it from Ep′aphras our beloved fellow servant. He is a faithful minister of Christ on our"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read your"
                        },
                        {
                            "style": "NONE",
                            "text": " behalf "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and has made known to us your love in the Spirit."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And so, from the day we heard of it, we have not ceased to pray for you, asking that you may be filled with the knowledge of his will in all spiritual wisdom and understanding, "
                        }
                    ]
                },
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "to lead a life worthy of the Lord, fully pleasing to him, bearing fruit in every good work and increasing in the knowledge of God. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "May you be strengthened with all power, according to his glorious might, for all endurance and patience with joy, "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "giving thanks to the Father, who has qualified us"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Other ancient authorities read you"
                        },
                        {
                            "style": "NONE",
                            "text": " to share in the inheritance of the saints in light. "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He has delivered us from the dominion of darkness and transferred us to the kingdom of his beloved Son, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in whom we have redemption, the forgiveness of sins."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Supremacy of Christ"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He is the image of the invisible God, the first-born of all creation; "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for in him all things were created, in heaven and on earth, visible and invisible, whether thrones or dominions or principalities or authorities—all things were created through him and for him. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He is before all things, and in him all things hold together. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He is the head of the body, the church; he is the beginning, the first-born from the dead, that in everything he might be pre-eminent. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For in him all the fulness of God was pleased to dwell, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and through him to reconcile to himself all things, whether on earth or in heaven, making peace by the blood of his cross."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you, who once were estranged and hostile in mind, doing evil deeds, "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "he has now reconciled in his body of flesh by his death, in order to present you holy and blameless and irreproachable before him, "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "provided that you continue in the faith, stable and steadfast, not shifting from the hope of the gospel which you heard, which has been preached to every creature under heaven, and of which I, Paul, became a minister."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Paul’s Interest in the Colossians"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now I rejoice in my sufferings for your sake, and in my flesh I complete what is lacking in Christ’s afflictions for the sake of his body, that is, the church, "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "of which I became a minister according to the divine office which was given to me for you, to make the word of God fully known, "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the mystery hidden for ages and generations"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or from angels and men"
                        },
                        {
                            "style": "NONE",
                            "text": " but now made manifest to his saints. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "To them God chose to make known how great among the Gentiles are the riches of the glory of this mystery, which is Christ in you, the hope of glory. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Him we proclaim, warning every man and teaching every man in all wisdom, that we may present every man mature in Christ. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For this I toil, striving with all the energy which he mightily inspires within me."
                        }
                    ]
                }
            ]
        }
    ]
}