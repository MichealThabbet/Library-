{
    "chapter_num": 34,
    "verses_count": 29,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Boundaries of the Land"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Command the people of Israel, and say to them, When you enter the land of Canaan (this is the land that shall fall to you for an inheritance, the land of Canaan in its full extent), "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "your south side shall be from the wilderness of Zin along the side of Edom, and your southern boundary shall be from the end of the Salt Sea on the east; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and your boundary shall turn south of the ascent of Akrab′bim, and cross to Zin, and its end shall be south of Ka′desh-bar′nea; then it shall go on to Ha′zar-ad′dar, and pass along to Azmon; "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the boundary shall turn from Azmon to the Brook of Egypt, and its termination shall be at the sea."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“For the western boundary, you shall have the Great Sea and its"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Syr: Heb lacks its"
                        },
                        {
                            "style": "NONE",
                            "text": " coast; this shall be your western boundary."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“This shall be your northern boundary: from the Great Sea you shall mark out your line to Mount Hor; "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "from Mount Hor you shall mark it out to the entrance of Hamath, and the end of the boundary shall be at Zedad; "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "then the boundary shall extend to Ziphron, and its end shall be at Hazar-enan; this shall be your northern boundary."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“You shall mark out your eastern boundary from Hazar-enan to Shepham; "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the boundary shall go down from Shepham to Riblah on the east side of A′in; and the boundary shall go down, and reach to the shoulder of the sea of Chin′nereth on the east; "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the boundary shall go down to the Jordan, and its end shall be at the Salt Sea. This shall be your land with its boundaries all round.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Moses commanded the people of Israel, saying, “This is the land which you shall inherit by lot, which the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has commanded to give to the nine tribes and to the half-tribe; "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "for the tribe of the sons of Reuben by fathers’ houses and the tribe of the sons of Gad by their fathers’ houses have received their inheritance, and also the half-tribe of Manas′seh; "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "the two tribes and the half-tribe have received their inheritance beyond the Jordan at Jericho eastward, toward the sunrise.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Tribal Leaders"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“These are the names of the men who shall divide the land to you for inheritance: Elea′zar the priest and Joshua the son of Nun. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall take one leader of every tribe, to divide the land for inheritance. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the names of the men: Of the tribe of Judah, Caleb the son of Jephun′neh. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of the sons of Simeon, Shemu′el the son of Ammi′hud. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of Benjamin, Eli′dad the son of Chislon. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of the sons of Dan a leader, Bukki the son of Jogli. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the sons of Joseph: of the tribe of the sons of Manas′seh a leader, Han′niel the son of Ephod. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And of the tribe of the sons of E′phraim a leader, Kemu′el the son of Shiphtan. "
                        }
                    ]
                },
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of the sons of Zeb′ulun a leader, Eli-za′phan the son of Parnach. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of the sons of Is′sachar a leader, Pal′tiel the son of Azzan. "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And of the tribe of the sons of Asher a leader, Ahi′hud the son of Shelo′mi. "
                        }
                    ]
                },
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Of the tribe of the sons of Naph′tali a leader, Pedah′el the son of Ammi′hud. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These are the men whom the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded to divide the inheritance for the people of Israel in the land of Canaan.”"
                        }
                    ]
                }
            ]
        }
    ]
}