                    "num_str": "65",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "besides their menservants and maidservants, of whom there were seven thouand three hundred and thirty-seven; and they had two hundred male and female singers. "
                        }
                    ]
                },
                {
                    "num_int": 66,
                    "num_str": "66",
                    "verse_parts": [
