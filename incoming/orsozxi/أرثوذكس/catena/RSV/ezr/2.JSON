                            "text": "The priests, the Levites, and some of the people lived in Jerusalem and its vicinity;"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "1 Esdras 5.46: Heb lacks lived in Jerusalem and its vicinity"
                        },
                        {
                            "style": "NONE",
                            "text": " and the singers, the gatekeepers, and the temple servants lived in their towns, and all Israel in their towns."
                        }
                    ]
                }
            ]
        }
    ]
