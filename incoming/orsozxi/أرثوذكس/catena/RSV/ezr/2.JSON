            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now these were the people of the province who came up out of the captivity of those exiles whom Nebuchadnez′zar the king of Babylon had carried captive to Babylonia; they returned to Jerusalem and Judah, each to his own town. "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They came with Zerub′babel, Jeshua, Nehemi′ah, Serai′ah, Reel-ai′ah, Mor′decai, Bilshan, Mispar, Big′vai, Rehum, and Ba′anah."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "The number of the men of the people of Israel: "
                        }
