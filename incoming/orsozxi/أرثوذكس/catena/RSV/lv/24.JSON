{
    "chapter_num": 24,
    "verses_count": 23,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "The Lamp"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Command the people of Israel to bring you pure oil from beaten olives for the lamp, that a light may be kept burning continually. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Outside the veil of the testimony, in the tent of meeting, Aaron shall keep it in order from evening to morning before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually; it shall be a statute for ever throughout your generations. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He shall keep the lamps in order upon the lampstand of pure gold before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Bread for the Tabernacle"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“And you shall take fine flour, and bake twelve cakes of it; two tenths of an ephah shall be in each cake. "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall set them in two rows, six in a row, upon the table of pure gold. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And you shall put pure frankincense with each row, that it may go with the bread as a memorial portion to be offered by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ". "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Every sabbath day Aaron shall set it in order before the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " continually on behalf of the people of Israel as a covenant for ever. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And it shall be for Aaron and his sons, and they shall eat it in a holy place, since it is for him a most holy portion out of the offerings by fire to the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", a perpetual due.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "Blasphemy and Its Punishment"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Now an Israelite woman’s son, whose father was an Egyptian, went out among the people of Israel; and the Israelite woman’s son and a man of Israel quarreled in the camp, "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the Israelite woman’s son blasphemed the Name, and cursed. And they brought him to Moses. His mother’s name was Shelo′mith, the daughter of Dibri, of the tribe of Dan. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they put him in custody, till the will of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " should be declared to them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " said to Moses, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Bring out of the camp him who cursed; and let all who heard him lay their hands upon his head, and let all the congregation stone him. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And say to the people of Israel, Whoever curses his God shall bear his sin. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who blasphemes the name of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " shall be put to death; all the congregation shall stone him; the sojourner as well as the native, when he blasphemes the Name, shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who kills a man shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who kills a beast shall make it good, life for life. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "When a man causes a disfigurement in his neighbor, as he has done it shall be done to him, "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "fracture for fracture, eye for eye, tooth for tooth; as he has disfigured a man, he shall be disfigured. "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He who kills a beast shall make it good; and he who kills a man shall be put to death. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "You shall have one law for the sojourner and for the native; for I am the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " your God.” "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So Moses spoke to the people of Israel; and they brought him who had cursed out of the camp, and stoned him with stones. Thus the people of Israel did as the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " commanded Moses."
                        }
                    ]
                }
            ]
        }
    ]
}