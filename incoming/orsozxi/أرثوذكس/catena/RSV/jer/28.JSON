{
    "chapter_num": 28,
    "verses_count": 17,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Hananiah Opposes Jeremiah and Dies"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In that same year, at the beginning of the reign of Zedeki′ah king of Judah, in the fifth month of the fourth year, Hanani′ah the son of Azzur, the prophet from Gib′eon, spoke to me in the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", in the presence of the priests and all the people, saying, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " of hosts, the God of Israel: I have broken the yoke of the king of Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Within two years I will bring back to this place all the vessels of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "’s house, which Nebuchadnez′zar king of Babylon took away from this place and carried to Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I will also bring back to this place Jeconi′ah the son of Jehoi′akim, king of Judah, and all the exiles from Judah who went to Babylon, says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", for I will break the yoke of the king of Babylon.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the prophet Jeremiah spoke to Hanani′ah the prophet in the presence of the priests and all the people who were standing in the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": "; "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the prophet Jeremiah said, “Amen! May the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " do so; may the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " make the words which you have prophesied come true, and bring back to this place from Babylon the vessels of the house of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ", and all the exiles. "
                        }
                    ]
                },
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Yet hear now this word which I speak in your hearing and in the hearing of all the people. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The prophets who preceded you and me from ancient times prophesied war, famine, and pestilence against many countries and great kingdoms. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "As for the prophet who prophesies peace, when the word of that prophet comes to pass, then it will be known that the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has truly sent the prophet.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Then the prophet Hanani′ah took the yoke-bars from the neck of Jeremiah the prophet, and broke them. "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hanani′ah spoke in the presence of all the people, saying, “Thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": Even so will I break the yoke of Nebuchadnez′zar king of Babylon from the neck of all the nations within two years.” But Jeremiah the prophet went his way."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Sometime after the prophet Hanani′ah had broken the yoke-bars from off the neck of Jeremiah the prophet, the word of the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " came to Jeremiah: "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Go, tell Hanani′ah, ‘Thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": You have broken wooden bars, but I"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk: Heb you"
                        },
                        {
                            "style": "NONE",
                            "text": " will make in their place bars of iron. "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "For thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " of hosts, the God of Israel: I have put upon the neck of all these nations an iron yoke of servitude to Nebuchadnez′zar king of Babylon, and they shall serve him, for I have given to him even the beasts of the field.’” "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jeremiah the prophet said to the prophet Hanani′ah, “Listen, Hanani′ah, the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": " has not sent you, and you have made this people trust in a lie. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Therefore thus says the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ": ‘Behold, I will remove you from the face of the earth. This very year you shall die, because you have uttered rebellion against the "
                        },
                        {
                            "style": "SMALL_CAPS",
                            "text": "Lord"
                        },
                        {
                            "style": "NONE",
                            "text": ".’”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In that same year, in the seventh month, the prophet Hanani′ah died."
                        }
                    ]
                }
            ]
        }
    ]
}