{
    "chapter_num": 1,
    "verses_count": 58,
    "paragraphs_list": [
        {
            "type": "section_header",
            "text": "Josiah Celebrates the Passover"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 1,
                    "num_str": "1",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Josi′ah kept the passover to his Lord in Jerusalem; he killed the passover lamb on the fourteenth day of the first month, "
                        }
                    ]
                },
                {
                    "num_int": 2,
                    "num_str": "2",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "having placed the priests according to their divisions, arrayed in their garments, in the temple of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 3,
                    "num_str": "3",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he told the Levites, the temple servants of Israel, that they should sanctify themselves to the Lord and put the holy ark of the Lord in the house which Solomon the king, the son of David, had built; "
                        }
                    ]
                },
                {
                    "num_int": 4,
                    "num_str": "4",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he said, “You need no longer carry it upon your shoulders. Now worship the Lord your God and serve his people Israel; and prepare yourselves by your families and kindred, "
                        }
                    ]
                },
                {
                    "num_int": 5,
                    "num_str": "5",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "in accordance with the directions of David king of Israel and the magnificence of Solomon his son. Stand in order in the temple according to the groupings of the fathers’ houses of you Levites, who minister before your brethren the people of Israel, "
                        }
                    ]
                },
                {
                    "num_int": 6,
                    "num_str": "6",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and kill the passover lamb and prepare the sacrifices for your brethren, and keep the passover according to the commandment of the Lord which was given to Moses.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 7,
                    "num_str": "7",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Josi′ah gave to the people who were present thirty thousand lambs and kids, and three thousand calves; these were given from the king’s possessions, as he promised, to the people and the priests and Levites. "
                        }
                    ]
                },
                {
                    "num_int": 8,
                    "num_str": "8",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Hilki′ah, Zechari′ah, and Jehi′el,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Esyelus"
                        },
                        {
                            "style": "NONE",
                            "text": " the chief officers of the temple, gave to the priests for the passover two thousand six hundred sheep and three hundred calves. "
                        }
                    ]
                },
                {
                    "num_int": 9,
                    "num_str": "9",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Jeconi′ah and Shemai′ah and Nethan′el his brother, and Hashabi′ah and Ochiel and Joram, captains over thousands, gave the Levites for the passover five thousand sheep and seven hundred calves."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 10,
                    "num_str": "10",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And this is what took place. The priests and the Levites, properly arrayed and having the unleavened bread, stood according to kindred "
                        }
                    ]
                },
                {
                    "num_int": 11,
                    "num_str": "11",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the grouping of the fathers’ houses, before the people, to make the offering to the Lord as it is written in the book of Moses; this they did in the morning. "
                        }
                    ]
                },
                {
                    "num_int": 12,
                    "num_str": "12",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "They roasted the passover lamb with fire, as required; and they boiled the sacrifices in brass pots and caldrons, with a pleasing odor, "
                        }
                    ]
                },
                {
                    "num_int": 13,
                    "num_str": "13",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and carried them to all the people. Afterward they prepared the passover for themselves and for their brethren the priests, the sons of Aaron, "
                        }
                    ]
                },
                {
                    "num_int": 14,
                    "num_str": "14",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "because the priests were offering the fat until night; so the Levites prepared it for themselves and for their brethren the priests, the sons of Aaron. "
                        }
                    ]
                },
                {
                    "num_int": 15,
                    "num_str": "15",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the temple singers, the sons of Asaph, were in their place according to the arrangement made by David, and also Asaph, Zechari′ah, and Eddinus, who represented the king. "
                        }
                    ]
                },
                {
                    "num_int": 16,
                    "num_str": "16",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The gatekeepers were at each gate; no one needed to depart from his duties, for their brethren the Levites prepared the passover for them."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 17,
                    "num_str": "17",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the things that had to do with the sacrifices to the Lord were accomplished that day: the passover was kept "
                        }
                    ]
                },
                {
                    "num_int": 18,
                    "num_str": "18",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and the sacrifices were offered on the altar of the Lord, according to the command of King Josi′ah. "
                        }
                    ]
                },
                {
                    "num_int": 19,
                    "num_str": "19",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the people of Israel who were present at that time kept the passover and the feast of unleavened bread seven days. "
                        }
                    ]
                },
                {
                    "num_int": 20,
                    "num_str": "20",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "No passover like it had been kept in Israel since the times of Samuel the prophet; "
                        }
                    ]
                },
                {
                    "num_int": 21,
                    "num_str": "21",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "none of the kings of Israel had kept such a passover as was kept by Josi′ah and the priests and Levites and the men of Judah and all of Israel who were dwelling in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 22,
                    "num_str": "22",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "In the eighteenth year of the reign of Josi′ah this passover was kept. "
                        }
                    ]
                },
                {
                    "num_int": 23,
                    "num_str": "23",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the deeds of Josi′ah were upright in the sight of the Lord, for his heart was full of godliness. "
                        }
                    ]
                },
                {
                    "num_int": 24,
                    "num_str": "24",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "The events of his reign have been recorded in the past, concerning those who sinned and acted wickedly toward the Lord beyond any other people or kingdom, and how they grieved the Lord"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk him"
                        },
                        {
                            "style": "NONE",
                            "text": " deeply, so that the words of the Lord rose up against Israel."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The End of Josiah’s Reign"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 25,
                    "num_str": "25",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "After all these acts of Josi′ah, it happened that Pharaoh, king of Egypt, went to make war at Car′chemish on the Euphra′tes, and Josi′ah went out against him. "
                        }
                    ]
                },
                {
                    "num_int": 26,
                    "num_str": "26",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king of Egypt sent word to him saying, “What have we to do with each other, king of Judea? "
                        }
                    ]
                },
                {
                    "num_int": 27,
                    "num_str": "27",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "I was not sent against you by the Lord God, for my war is at the Euphra′tes. And now the Lord is with me! The Lord is with me, urging me on! Stand aside, and do not oppose the Lord.”"
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 28,
                    "num_str": "28",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But Josi′ah did not turn back to his chariot, but tried to fight with him, and did not heed the words of Jeremiah the prophet from the mouth of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 29,
                    "num_str": "29",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He joined battle with him in the plain of Megid′do, and the commanders came down against King Josi′ah. "
                        }
                    ]
                },
                {
                    "num_int": 30,
                    "num_str": "30",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king said to his servants, “Take me away from the battle, for I am very weak.” And immediately his servants took him out of the line of battle. "
                        }
                    ]
                },
                {
                    "num_int": 31,
                    "num_str": "31",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he got into his second chariot; and after he was brought back to Jerusalem he died, and was buried in the tomb of his fathers. "
                        }
                    ]
                },
                {
                    "num_int": 32,
                    "num_str": "32",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And in all Judea they mourned for Josi′ah. Jeremiah the prophet lamented for Josi′ah, and the principal men, with the women,"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Or their wives"
                        },
                        {
                            "style": "NONE",
                            "text": " have made lamentation for him to this day; it was ordained that this should always be done throughout the whole nation of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 33,
                    "num_str": "33",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These things are written in the book of the histories of the kings of Judea; and every one of the acts of Josi′ah, and his splendor, and his understanding of the law of the Lord, and the things that he had done before and these that are now told, are recorded in the book of the kings of Israel and Judah."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Last Kings of Judah"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 34,
                    "num_str": "34",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the men of the nation took Jeconi′ah the son of Josi′ah, who was twenty-three years old, and made him king in succession to Josi′ah his father. "
                        }
                    ]
                },
                {
                    "num_int": 35,
                    "num_str": "35",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And he reigned three months in Judah and Jerusalem. Then the king of Egypt deposed him from reigning in Jerusalem, "
                        }
                    ]
                },
                {
                    "num_int": 36,
                    "num_str": "36",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and fined the nation a hundred talents of silver and a talent of gold. "
                        }
                    ]
                },
                {
                    "num_int": 37,
                    "num_str": "37",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And the king of Egypt made Jehoi′akim his brother king of Judea and Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 38,
                    "num_str": "38",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoi′akim put the nobles in prison, and seized his brother Zarius and brought him up out of Egypt."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 39,
                    "num_str": "39",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoi′akim was twenty-five years old when he began to reign in Judea and Jerusalem, and he did what was evil in the sight of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 40,
                    "num_str": "40",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And Nebuchadnez′zar king of Babylon came up against him, and bound him with a chain of brass and took him away to Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 41,
                    "num_str": "41",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Nebuchadnez′zar also took some holy vessels of the Lord, and carried them away, and stored them in his temple in Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 42,
                    "num_str": "42",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But the things that are reported about Jehoi′akim"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk him"
                        },
                        {
                            "style": "NONE",
                            "text": " and his uncleanness and impiety are written in the chronicles of the kings."
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 43,
                    "num_str": "43",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Jehoi′achin"
                        },
                        {
                            "style": "FOOTNOTE",
                            "text": "Gk Jehoiakim"
                        },
                        {
                            "style": "NONE",
                            "text": " his son became king in his stead; when he was made king he was eighteen years old, "
                        }
                    ]
                },
                {
                    "num_int": 44,
                    "num_str": "44",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and he reigned three months and ten days in Jerusalem. He did what was evil in the sight of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 45,
                    "num_str": "45",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So after a year Nebuchadnez′zar sent and removed him to Babylon, with the holy vessels of the Lord, "
                        }
                    ]
                },
                {
                    "num_int": 46,
                    "num_str": "46",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and made Zedeki′ah king of Judea and Jerusalem."
                        },
                        {
                            "style": "LINE_BREAK",
                            "text": "\n"
                        },
                        {
                            "style": "NONE",
                            "text": "Zedeki′ah was twenty-one years old, and he reigned eleven years. "
                        }
                    ]
                }
            ]
        },
        {
            "type": "section_header",
            "text": "The Fall of Jerusalem"
        },
        {
            "type": "section_paragraph",
            "verses_list": [
                {
                    "num_int": 47,
                    "num_str": "47",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "He also did what was evil in the sight of the Lord, and did not heed the words that were spoken by Jeremiah the prophet from the mouth of the Lord. "
                        }
                    ]
                },
                {
                    "num_int": 48,
                    "num_str": "48",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And though King Nebuchadnez′zar had made him swear by the name of the Lord, he broke his oath and rebelled; and he stiffened his neck and hardened his heart and transgressed the laws of the Lord, the God of Israel. "
                        }
                    ]
                },
                {
                    "num_int": 49,
                    "num_str": "49",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "Even the leaders of the people and of the priests committed many acts of sacrilege and lawlessness beyond all the unclean deeds of all the nations, and polluted the temple of the Lord which had been hallowed in Jerusalem. "
                        }
                    ]
                },
                {
                    "num_int": 50,
                    "num_str": "50",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "So the God of their fathers sent by his messenger to call them back, because he would have spared them and his dwelling place. "
                        }
                    ]
                },
                {
                    "num_int": 51,
                    "num_str": "51",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "But they mocked his messengers, and whenever the Lord spoke, they scoffed at his prophets, "
                        }
                    ]
                },
                {
                    "num_int": 52,
                    "num_str": "52",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "until in his anger against his people because of their ungodly acts he gave command to bring against them the kings of the Chalde′ans. "
                        }
                    ]
                },
                {
                    "num_int": 53,
                    "num_str": "53",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "These slew their young men with the sword around their holy temple, and did not spare young man or virgin, old man or child, for he gave them all into their hands. "
                        }
                    ]
                },
                {
                    "num_int": 54,
                    "num_str": "54",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And all the holy vessels of the Lord, great and small, and the treasure chests of the Lord, and the royal stores, they took and carried away to Babylon. "
                        }
                    ]
                },
                {
                    "num_int": 55,
                    "num_str": "55",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "And they burned the house of the Lord and broke down the walls of Jerusalem and burned their towers with fire, "
                        }
                    ]
                },
                {
                    "num_int": 56,
                    "num_str": "56",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and utterly destroyed all its glorious things. The survivors he led away to Babylon with the sword, "
                        }
                    ]
                },
                {
                    "num_int": 57,
                    "num_str": "57",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "and they were servants to him and to his sons until the Persians began to reign, in fulfilment of the word of the Lord by the mouth of Jeremiah: "
                        }
                    ]
                },
                {
                    "num_int": 58,
                    "num_str": "58",
                    "verse_parts": [
                        {
                            "style": "NONE",
                            "text": "“Until the land has enjoyed its sabbaths, it shall keep sabbath all the time of its desolation until the completion of seventy years.”"
                        }
                    ]
                }
            ]
        }
    ]
}