/*
================================
Hymn text Styles
================================
.HymnTitle    { COLOR: navy; text-decoration: none; font-family: ARIAL,verdana; FONT-WEIGHT: bold; background-color: #EFF3FB; margin-top: 7px; margin-bottom: 7px; padding-top: 7px; padding-bottom: 7px; }

*/

.HymnTitle { padding:0px 0px 22px; font-family: "Trajan Pro"; font-weight:700; padding-bottom:10px; }


.CopticFont   { COLOR: BLACK; text-decoration: none; font-family: 'CS Avva Shenouda';line-height:30px;}
.CopticAtha   { COLOR: BLACK; text-decoration: none; font-family: 'Athanasius';line-height:30px;}
.CopticReader   { COLOR: BLACK; text-decoration: none; font-family: 'copticreader';line-height:30px;}
.arabfont   { COLOR: darkblue; text-decoration: none; font-family: 'arabfont'; text-align:right; direction:rtl}
.arabfontblack   { COLOR: black; text-decoration: none; font-family: 'arabfont'; text-align:right; direction:rtl}
.HazzatFont   { COLOR: BLACK; text-decoration: none; font-family: 'Hazzat';}
.HazzatVFont  { COLOR: BLACK; text-decoration: none; font-family: 'Hazzat Vertical';}
.HazzatAFont  { COLOR: BLACK; text-decoration: none; font-family: 'Hazzat Arabic';text-align:right;direction:rtl;}
.HazzatVAFont { COLOR: BLACK; text-decoration: none; font-family: 'Hazzat Vertical Arabic';text-align:right;direction:rtl;}
.EnglishFont  { COLOR: BLACK; text-decoration: none; font-family: ARIAL,verdana;}
.ArabicFont   { COLOR: BLACK; text-decoration: none; font-family: 'Arabic Transparent';text-align:right;direction:rtl;}
.EnglishComment  { COLOR: RED; text-decoration: none; font-family: ARIAL,verdana;font-style:italic;}
.CopticComment   { COLOR: RED; text-decoration: none; font-family: 'CS Avva Shenouda', 'CS New Athanasius'; font-style: italic;}
.ArabicComment   { COLOR: RED; text-decoration: none; font-family: 'Arabic Transparent'; font-style: italic;text-align:right;direction:rtl;}
.HymnList { width: 14px; border: 0px none transparent; }
